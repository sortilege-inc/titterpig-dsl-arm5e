EXTENSION "ARM5e_Bestiary_Faerie" {
    NAME "Ars Magica 5th Edition Definitive - Creatures of Faerie"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Base"

    # Creatures of Faerie
    # - Faeries are essentially bound to stories and their roles in those stories
    # - They are made up of stray matter held together with mystical rules
    # - Physical attacks are NOT blocked by Magic Resistance, including the Parma Magica
    # - Faeries cannot break their roles; they would prefer to die, because death is rarely permanent
    # - Faeries have Pretenses instead of Abilities (glamour-mimicked skills)
    # - A skilled character (score 5+) may detect Pretenses vs. real Abilities
    #   with a Perception + Awareness roll vs. Ease Factor 12
    # - Faeries regenerate damage, retaining only superficial injuries for their role
    # - Faeries never suffer fatigue, although they may pretend to
    # - Equipment and accoutrements are formed from the faerie's glamour

    # ===========================
    # FAERIE HOUNDS
    # ===========================

    #ARM1600xY4zA6bC8dE0fG2hIj ^"Faerie Hounds" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 5
            ^"Might Form" TEXT "Animal"
            ^"Cunning" INTEGER 0
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER -4
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 2
            ^"Size" INTEGER 1
            ^"Soak" INTEGER 2
        }
        RULES {
            # Virtues and Flaws
            #ARM1601aR3bT5cV7dX9eZ1fB: Virtues: Faerie Sight, Improved Characteristics, Sharp Ears, Large
            #ARM1602gD2hF4iH6jK8kM0lO: Flaws: Incognizant, Reckless, Traditional Wards (varies)

            # Personality Traits
            #ARM1603nQ3oS5pU7qW9rY1sA: Personality Traits: Loyal +3, Reckless +3, Brave +2

            # Pretenses (not Abilities)
            #ARM1604tC2uE4vG6wI8xK0yM: Pretenses: Athletics 5 (distance running), Awareness 6 (keeping watch), Brawl 5 (bite), Hunt 6 (track by scent)

            # Combat
            #ARM1605zO3aQ5bS7cU9dW1eY: Bite (small teeth): Init +2, Attack +10, Defense +9, Damage +1
            #ARM1606fA2gC4hE6iG8jI0kK: Note: Some faerie hounds have Damaging Effect power adding +5 to bite damage; usually visually obvious (flaming spittle, icy breath, etc.)

            # Wound Penalties
            #ARM1607lM3nO5pQ7rS9tU1vW: Wound Penalties: -1 (1-6), -3 (7-12), -5 (13-18), Incapacitated (19-24), Dead (25+)

            # Powers (rare for a single hound to have more than two)
            #ARM1608xY2zA4bC6dE8fG0hI: Damaging Effect: 2 points, Init 0, Varies: All faerie weapons take on a more deadly aspect for two minutes; +5 Damage
            #ARM1609jK3lM5nO7pQ9rS1tU: Enthralling Sound: 3 points, Init -2, Mentem: Causes terror and panic with howl; stress roll Personality trait vs Ease Factor 9 to resist
            #ARM160AvW2xY4zA6bC8dE0fG: Enthrallment: 4 points, Init -2, Mentem: Complete control of a single human mind for a day via eye contact
            #ARM160BhI3jK5lM7nO9pQ1rS: Fearful Flaming Eyes: 2 points, Init -2, Corpus: Completely paralyzes a human who makes eye contact
            #ARM160CtU2vW4xY6zA8bC0dE: Hound: 2 points, Init 0, Corpus: Knows direction and distance to its human quarry
            #ARM160DfG3hI5jK7lM9nO1pQ: Flight: 0 points, constant +2, Animal: Capable of flight; Athletics for maneuvers; no combat while flying swiftly; no flight when heavily encumbered or carrying passenger of its Size or more

            # Vis
            #ARM160ErS2tU4vW6xY8zA0bC: Vis: 1 pawn Animal, dog corpse

            # Appearance and Variants
            #ARM160FdE3fG5hI7jK9lM1nO: Faerie hounds are usually chunky hunting breeds; many have shining eyes; almost all have black, white, or green fur
            #ARM1610pQ2rS4tU6vW8xY0zA: Variant (France): Role filled by a terrifying goat
            #ARM1611bC3dE5fG7hI9jK1lM: Variant (Aufhocker, German): Acts as kelpie; clings to foes while goring; adds 6 to combat Load
            #ARM1612nO2pQ4rS6tU8vW0xY: Variant (Kludie, Belgium): Most powerful variant; can take monstrous forms of dog, cat, bat, horse, or frog; walks on back legs; preceded by blue flames
        }
    }

    # ===========================
    # FAERIE KNIGHT
    # ===========================

    #ARM1613zA3bC5dE7fG9hI1jK ^"Faerie Knight" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 10
            ^"Might Form" TEXT "Corpus or Terram"
            ^"Intelligence" INTEGER 0
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER -2
            ^"Strength" INTEGER 3
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 1
            ^"Size" INTEGER 1
            ^"Soak" INTEGER 9
        }
        RULES {
            # Virtues and Flaws
            #ARM1614lM2nO4pQ6rS8tU0vW: Virtues: Faerie Sight, Faerie Speech, Large, Narrowly Cognizant, Observant
            #ARM1615xY3zA5bC7dE9fG1hI: Flaws: Sovereign Ward (varies), Vow (Chivalrous conduct), Oath of Fealty, Overconfident

            # Personality Traits
            #ARM1616jK2lM4nO6pQ8rS0tU: Personality Traits: Arrogant +3, Courteous +3

            # Pretenses (not Abilities; many knights have far higher scores)
            #ARM1617vW3xY5zA7bC9dE1fG: Pretenses: Awareness 1 (enemies), Brawl 3 (knights), Carouse 3 (feasts), Charm 1 (ladies), Etiquette 3 (chivalrous combat), Faerie Speech 5 (boasting), Hunt 2 (humans), Leadership 2 (guards), Ride 3 (horses), Single Weapon 4 (varies)
            #ARM1618hI2jK4lM6nO8pQ0rS: Note: Many knights have far higher Pretense scores; these stats suit faeries that plan to improve by losing to a character then mirroring his experience gain

            # Combat
            #ARM1619tU3vW5xY7zA9bC1dE: Brawl (gauntlet): Init +1, Attack +6, Defense +6, Damage +5
            #ARM161AfG2hI4jK6lM8nO0pQ: Long Sword and Heater Shield: Init +3, Attack +10, Defense +9, Damage +9
            #ARM161BrS3tU5vW7xY9zA1bC: Mace and Heater Shield: Init +2, Attack +9, Defense +8, Damage +11
            #ARM161CdE2fG4hI6jK8lM0nO: Lance and Heater Shield (mounted): Init +3, Attack +10, Defense +8, Damage +8; does not include +3 Attack and Defense for being mounted
            #ARM161DpQ3rS5tU7vW9xY1zA: Soak +9 from faerie metal scale, made of glamour using Shift Human Shapes Power

            # Wound Penalties
            #ARM161EbC2dE4fG6hI8jK0lM: Wound Penalties: -1 (1-6), -3 (7-12), -5 (13-18), Incapacitated (19-25), Dead (26+)

            # Powers
            #ARM161FnO3pQ5rS7tU9vW1xY: Damaging Effect: 1 point, Init -4, as per motif of court: All weapons take on more deadly aspect for two minutes; +5 Damage; not used against worthy foes due to chivalry
            #ARM1620zA2bC4dE6fG8hI0jK: Flight: 2 points, constant, Corpus: Capable of flight; Athletics for maneuvers; no combat while flying swiftly
            #ARM1621lM3nO5pQ7rS9tU1vW: Shift Human Shapes: 1 point, Init 0, Corpus: Allows removal or donning of armor simply by thinking about it

            # Equipment and Vis
            #ARM1622xY2zA4bC6dE8fG0hI: Equipment: Arms and armor; faerie horse constructed from knight's own glamour (flies when knight does, shares knight's Magic Resistance)
            #ARM1623jK3lM5nO7pQ9rS1tU: Vis: 2 pawns, often rusty pieces of armor infused with glamour

            # Appearance and Notes
            #ARM1624vW2xY4zA6bC8dE0fG: A knight clad in silver leaves of metal, astride a fine horse; displays motif of their court on surcoat, shield, and pavilion
            #ARM1625hI3jK5lM7nO9pQ1rS: Often encountered outside courts, on lonely roads, and guarding bridges; seek defeat by humans to gain additional combat Pretenses
        }
    }

    # ===========================
    # POLUDNICA (LADY MIDDAY)
    # ===========================

    #ARM1626tU2vW4xY6zA8bC0dE ^"Poludnica" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 10
            ^"Might Form" TEXT "Auram"
            ^"Intelligence" INTEGER 1
            ^"Perception" INTEGER 0
            ^"Presence" TEXT "+3/-3"
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER 0
            ^"Size" INTEGER 0
            ^"Soak" INTEGER 0
        }
        RULES {
            # Virtues and Flaws
            #ARM1627fG3hI5jK7lM9nO1pQ: Virtues: Faerie Sight, Faerie Speech
            #ARM1628rS2tU4vW6xY8zA0bC: Flaws: Incognizant, Sovereign Ward (running water), Traditional Wards (questions)

            # Personality Traits
            #ARM1629dE3fG5hI7jK9lM1nO: Personality Traits: Curious +3

            # Pretenses (not Abilities)
            #ARM162ApQ2rS4tU6vW8xY0zA: Pretenses: Awareness 3 (laziness), Charm 2 (rural people), Faerie Speech 5 (rural people), Local Farms Lore 6 (stewardship), Profession: Farmer 6 (stewardship), Single Weapon 3 (rural people)

            # Combat
            #ARM162BbC3dE5fG7hI9jK1lM: Scythe: Init +1, Attack +6, Defense +4, Damage +5

            # Wound Penalties
            #ARM162CnO2pQ4rS6tU8vW0xY: Wound Penalties: -1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20), Dead (21+)

            # Powers
            #ARM162DzA3bC5dE7fG9hI1jK: Cause Fatigue: 0 points, Init 0, Ignem: Causes loss of a long-term fatigue level via heatstroke
            #ARM162ElM2nO4pQ6rS8tU0vW: Shift Human Shapes: 1 point, Init -1, Corpus: Changes appearance from beautiful to hideous within Presence range of +3/-3
            #ARM162FxY3zA5bC7dE9fG1hI: Transform Into Whirlwind: 3 points, Init +2, Auram

            # Vis
            #ARM1630jK2lM4nO6pQ8rS0tU: Vis: 2 pawns (scythe, Ignem)

            # Appearance and Behavior
            #ARM1631vW3xY5zA7bC9dE1fG: May appear as beautiful maiden, crone, or adolescent girl; wears white dress and carries scythe or shears; may travel as dust devil
            #ARM1632hI2jK4lM6nO8pQ0rS: Appears around noon on hot days; asks farmhands difficult questions; if farmhand cannot answer or changes topic, gives heatstroke; may drive insane or cause death from hyperthermia
            #ARM1633tU3vW5xY7zA9bC1dE: Cannot spend Might points during winter
        }
    }

    # ===========================
    # MATEOS, THE FAERIE BUTLER
    # ===========================

    #ARM1634fG2hI4jK6lM8nO0pQ ^"Mateos, the Faerie Butler" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 10
            ^"Might Form" TEXT "Herbam"
            ^"Intelligence" INTEGER -1
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER -1
            ^"Communication" INTEGER 3
            ^"Strength" INTEGER -2
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER -3
            ^"Size" INTEGER -2
            ^"Apparent Age" TEXT "n/a (40)"
            ^"Soak" INTEGER 2
            ^"Encumbrance" TEXT "3 (3)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1635rS3tU5vW7xY9zA1bC: Virtues and Flaws: Narrowly Cognizant

            # Personality Traits
            #ARM1636dE2fG4hI6jK8lM0nO: Personality Traits: Convivial +3, Generous +2, Careful -2
            #ARM1637pQ3rS5tU7vW9xY1zA: Reputations: None

            # Pretenses (not Abilities)
            #ARM1638bC2dE4fG6hI8jK0lM: Pretenses: Carouse 9 (drinking), Charm 4 (drunk people), Etiquette 2 (parties), Faerie Lore 3 (drinks), Folk Ken 3 (drunk people), Guile 9 (convincing people to drink more), Living Language 5 (metaphors for drinking and getting drunk), Music 1 (drinking songs), Single Weapon (club) 1

            # Combat
            #ARM1639nO3pQ5rS7tU9vW1xY: Club: Init -2, Attack +4, Defense 0, Damage +1

            # Wound Penalties
            #ARM163AzA2bC4dE6fG8hI0jK: Wound Penalties: -1 (1-3), -3 (4-6), -5 (7-9), Incapacitated (10-12)

            # Powers
            #ARM163BlM3nO5pQ7rS9tU1vW: Heady Brew: 0 points, Init -10, Corpus: Any drink served by Mateos is three times as intoxicating as normal; non-alcoholic drinks become as alcoholic as ale; does not change taste; extra intoxication is magical with Penetration 10 and can be resisted
            #ARM163CxY2zA4bC6dE8fG0hI: Unending Drinks: 1 point, Init -10, Aquam: While serving a particular person, the drink in Mateos's barrel does not run out; if the chosen person leaves, passes out, or stops drinking, the barrel starts to run out

            # Equipment and Vis
            #ARM163DjK3lM5nO7pQ9rS1tU: Equipment: Barrel of alcoholic drink
            #ARM163EvW2xY4zA6bC8dE0fG: Vis: 1 pawn of Herbam in each hand

            # Appearance and Behavior
            #ARM163FhI3jK5lM7nO9pQ1rS: Size of a child, large pot belly, full beard with gray, slightly grubby apron; always smiling; offers everyone a drink from his barrel
            #ARM1640tU2vW4xY6zA8bC0dE: Lives for parties with drunkenness and stupid behavior; tries to start parties wherever he arrives; encourages ridiculous and embarrassing behavior but not lethal acts
            #ARM1641fG3hI5jK7lM9nO1pQ: The Gift makes Mateos feel the Gifted individual is a killjoy opposed to parties
        }
    }

    # ===========================
    # JUMAYL, A JINNI GUIDE
    # ===========================

    #ARM1642rS2tU4vW6xY8zA0bC ^"Jumayl, A Jinni Guide" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 15
            ^"Might Form" TEXT "Vim"
            ^"Intelligence" INTEGER -1
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 2
            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 3
            ^"Size" INTEGER 0
            ^"Apparent Age" TEXT "appears 25"
            ^"Confidence Score" TEXT "1 (3)"
            ^"Soak" INTEGER 3
        }
        RULES {
            # Virtues and Flaws
            #ARM1643dE3fG5hI7jK9lM1nO: Virtues: Jinni; Faerie Speech, Highly Cognizant, Improved Characteristics, Second Sight, Skinchanger, Warrior, Well-Traveled, Wilderness Sense
            #ARM1644pQ2rS4tU6vW8xY0zA: Flaws: Greater Malediction (keep any bargain made); Carefree, Dutybound (Bedouin honor code), Traditional Ward (Bismillah Invocation), Vulnerable to Folk Tradition

            # Personality Traits and Reputation
            #ARM1645bC3dE5fG7hI9jK1lM: Personality Traits: Impulsive +3, Cheerful +3, Impious -1
            #ARM1646nO2pQ4rS6tU8vW0xY: Reputation: Skilled Caravan guard 2 (Mythic Middle East)

            # Pretenses (not Abilities)
            #ARM1647zA3bC5dE7fG9hI1jK: Pretenses: Animal Handling 3 (camels), Athletics 3 (running), Mythic Middle East Lore 4 (trade routes), Awareness 3 (alertness), Brawl 3 (dagger), Bows 5 (short bow), Carouse 2 (power drinking), Faerie Speech 5, al-Mushaqqar Lore 2 (drinking establishments), Faerie Lore 3 (jinn), Folk Ken 4 (mercenaries), Leadership 4 (battle), Ride 3 (camels), Second Sight 3 (jinn), Single Weapon 7 (long sword), Survival 2 (deserts), Theology: Islam 1 (jinn), Wilderness Sense 3 (find water)

            # Combat
            #ARM1648lM2nO4pQ6rS8tU0vW: Long Sword: Init +5, Attack +14, Defense +9, Damage +8

            # Wound Penalties
            #ARM1649xY3zA5bC7dE9fG1hI: Wound Penalties: -1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20), Dead (21+)

            # Powers
            #ARM164AjK2lM4nO6pQ8rS0tU: Cuirass of the Zephyr: 1 point, Init +3, Auram: As Circling Winds of Protection with Duration of Recitation/Qira'a (equivalent to Concentration; Jumayl recites verses of the Qur'an)
            #ARM164BvW3xY5zA7bC9dE1fG: Blinding Light of the Pious: 1 point, Init +3, Ignem: As Flash of the Scarlet Flames
            #ARM164ChI2jK4lM6nO8pQ0rS: Tay al-Ard (Travel): 4 points, Init +1, Corpus: Instantly transports Jumayl and 2 individuals he holds hands with to a location he has visited or has an Arcane Connection to, regardless of distance; as Leap of Homecoming with R: Touch, T: Group

            # Equipment and Vis
            #ARM164DtU3vW5xY7zA9bC1dE: Equipment: Fine damascene steel long sword, leather scale caravan guard armor, flashy jewelry
            #ARM164EfG2hI4jK6lM8nO0pQ: Vis: 3 pawns of Vim vis, camel's tooth

            # Appearance and Behavior
            #ARM164FrS3tU5vW7xY9zA1bC: A comely, lithe man of uncertain oriental appearance, alabaster skin and white hair; one eye iridescent green, the other ocean blue; favors swirling deep blue robes over light leather armor with gold jewelry
            #ARM1650dE2fG4hI6jK8lM0nO: One of the jann; a mercenary guide forced to wander caravan routes of the Levant, Arabia, Persia, Transoxiana for a crime his brother committed
            #ARM1651pQ3rS5tU7vW9xY1zA: Can change into a white wild Bactrian camel using Skinchanger Virtue
            #ARM1652bC2dE4fG6hI8jK0lM: Unusually susceptible to mundane alcohol; Might points recover only with full night's rest and meal in company of fellow travelers within a human community; recovers Might Points equal to prevailing Aura (min 1) per eight hours rest
        }
    }

    # ===========================
    # TARLAN THE WOLF
    # ===========================

    #ARM1653nO3pQ5rS7tU9vW1xY ^"Tarlan the Wolf" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 20
            ^"Might Form" TEXT "Animal"
            ^"Intelligence" INTEGER -2
            ^"Perception" INTEGER 5
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER -3
            ^"Strength" INTEGER 3
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 3
            ^"Size" INTEGER -1
            ^"Apparent Age" TEXT "n/a"
            ^"Confidence Score" TEXT "1 (3)"
            ^"Soak" INTEGER 7
            ^"Encumbrance" TEXT "0 (0)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1654zA2bC4dE6fG8hI0jK: Virtues and Flaws: Incognizant

            # Personality Traits and Reputations
            #ARM1655lM3nO5pQ7rS9tU1vW: Personality Traits: Relentless +3, Cheerful -3
            #ARM1656xY2zA4bC6dE8fG0hI: Reputations: Soul-eating demon (local) 1

            # Pretenses (not Abilities)
            #ARM1657jK3lM5nO7pQ9rS1tU: Pretenses: [Area] Lore 6 (hunting tracks), Athletics 5 (running), Awareness 8 (spotting quarry), Brawl 3 (bite), Hunt 10 (human beings), Living Language 2 (threats), Stealth 9 (hunting), Survival 7 (forests)

            # Combat
            #ARM1658vW2xY4zA6bC8dE0fG: Bite: Init +9, Attack +10, Defense +10, Damage +6

            # Wound Penalties
            #ARM1659hI3jK5lM7nO9pQ1rS: Wound Penalties: -1 (1-4), -3 (5-8), -5 (9-12), Incapacitated (13-16)

            # Powers
            #ARM165AtU2vW4xY6zA8bC0dE: Marked Quarry: 1 point, Init +5, Mentem: Pick a single visible human who can see Tarlan and mark as quarry; inspires strong fear requiring Brave roll vs Ease Factor 9; makes victim likely to run
            #ARM165BfG3hI5jK7lM9nO1pQ: Prey's Vigor: 1 point, Init +8, Corpus: By breathing on a tired person (anyone who has lost Fatigue levels), restores full vigor (all Fatigue levels regained); target also ages one year; must be close enough to feel wolf's breath; only works on adults
            #ARM165CrS2tU4vW6xY8zA0bC: Silent Running: 0 points, constant, Imaginem: Makes no noise unless deliberately choosing to

            # Equipment and Vis
            #ARM165DdE3fG5hI7jK9lM1nO: Equipment: None (he is a wolf)
            #ARM165EpQ2rS4tU6vW8xY0zA: Vis: 2 pawns of Intellego in his nose, 1 pawn of Intellego in each ear

            # Appearance and Behavior
            #ARM165FbC3dE5fG7hI9jK1lM: A large, deep black wolf with eyes that glint even in darkness; moves silently; can stay hidden unless he wants quarry to see him
            #ARM1660nO2pQ4rS6tU8vW0xY: Exists to hunt people; picks lone wilderness individuals, marks them as quarry, harries them to exhaustion; uses Prey's Vigor to restore their energy so the hunt continues; times final attack just before dawn
            #ARM1661zA3bC5dE7fG9hI1jK: Does not always kill victims; leaves some alive to spread fear
            #ARM1662lM2nO4pQ6rS8tU0vW: Cannot enter holy ground (churches, graveyards); tries to herd victims away from such places
            #ARM1663xY3zA5bC7dE9fG1hI: Prey's Vigor cannot affect children, so Tarlan never hunts them and feels protective of them
            #ARM1664jK2lM4nO6pQ8rS0tU: The Gift inspires respect; never hunts Gifted individuals; might work with one who lets him hunt people
        }
    }

    # ===========================
    # VALKYRIE
    # ===========================

    #ARM1665vW3xY5zA7bC9dE1fG ^"Valkyrie" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 20
            ^"Might Form" TEXT "Corpus"
            ^"Intelligence" INTEGER 0
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 1
            ^"Size" INTEGER 0
            ^"Soak" INTEGER 9
        }
        RULES {
            # Virtues and Flaws
            #ARM1666hI2jK4lM6nO8pQ0rS: Virtues: Faerie Sight, Faerie Speech
            #ARM1667tU3vW5xY7zA9bC1dE: Flaws: Incognizant, Visions (Valkyries know where and when worthy men are likely to die)

            # Personality Traits
            #ARM1668fG2hI4jK6lM8nO0pQ: Personality Traits: Brave +5, Judgmental +3

            # Pretenses (not Abilities)
            #ARM1669rS3tU5vW7xY9zA1bC: Pretenses: Awareness 9 (battlefields), Brawl 9 (einherjar), Ride 5 (wolf), Single Weapon 9 (giants)

            # Combat
            #ARM166AdE2fG4hI6jK8lM0nO: Axe and Round Shield (unmounted): Init +2, Attack +16, Defense +12, Damage +6
            #ARM166BpQ3rS5tU7vW9xY1zA: Axe and Round Shield (mounted): Init +2, Attack +19, Defense +15, Damage +6

            # Wound Penalties
            #ARM166CbC2dE4fG6hI8jK0lM: Wound Penalties: -1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20), Dead (21+)

            # Powers
            #ARM166DnO3pQ5rS7tU9vW1xY: Fly: 0 points, constant, usually Corpus but sometimes Animal: Capable of flight; Athletics for maneuvers; no combat while flying swiftly; cannot fly when heavily encumbered or with passenger of its Size or more unless assisted

            # Equipment and Vis
            #ARM166EzA2bC4dE6fG8hI0jK: Equipment: Arms, armor, wolf mount, vast quantities of wine
            #ARM166FlM3nO5pQ7rS9tU1vW: Vis: 4 Corpus, a dead vulture

            # Appearance and Notes
            #ARM1670xY2zA4bC6dE8fG0hI: Shield maidens or crones that ride wolves above battlefields and select the worthy dead; excellent equipment and extraordinary training
            #ARM1671jK3lM5nO7pQ9rS1tU: Minor goddesses of the Norse pantheon; no longer worshiped in Mythic Europe; encountered by magi in Elysium and ancient places of power in Scandinavia
            #ARM1672vW2xY4zA6bC8dE0fG: Name means "Chooser of the Slain"; believed to choose who lives and dies during battle; select spirits worthy of transformation into einherjar; also act as serving maids in Valhalla
        }
    }

    # ===========================
    # WOLF MOUNT (VALKYRIE'S)
    # ===========================

    #ARM1673hI3jK5lM7nO9pQ1rS ^"Wolf Mount" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 20
            ^"Might Form" TEXT "Shares Valkyrie's Might pool (made of Valkyrie's glamour)"
            ^"Cunning" INTEGER 2
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 2
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER -4
            ^"Size" INTEGER 3
            ^"Soak" INTEGER 7
        }
        RULES {
            # Virtues and Flaws
            #ARM1674tU2vW4xY6zA8bC0dE: Virtues: Faerie Sight, Ferocity (when hungry), Sharp Ears

            # Personality Traits
            #ARM1675fG3hI5jK7lM9nO1pQ: Personality Traits: Brave +3, Cowardly +3

            # Pretenses (not Abilities)
            #ARM1676rS2tU4vW6xY8zA0bC: Pretenses: Athletics 5 (distance running), Awareness 3 (smell), Brawl 5 (teeth), Hunt 4 (track by smell), Survival 3 (winter)

            # Combat
            #ARM1677dE3fG5hI7jK9lM1nO: Teeth: Init -2, Attack +12, Defense +6, Damage +3

            # Wound Penalties
            #ARM1678pQ2rS4tU6vW8xY0zA: Wound Penalties: -1 (1-8), -3 (8-16), -5 (17-24), Incapacitated (25-32), Dead (33+)

            # Powers
            #ARM1679bC3dE5fG7hI9jK1lM: When the valkyrie uses Fly, the wolf (as part of her glamour) flies too; the valkyrie can carry a passenger with the aid of her wolf

            # Vis
            #ARM167AnO2pQ4rS6tU8vW0xY: Vis: None (the wolf is an extension of the valkyrie)

            # Appearance
            #ARM167BzA3bC5dE7fG9hI1jK: A wolf the size of a horse, with saddle and harness; thick fur gives Protection of 1; wears leather covers acting as partial barding
        }
    }

    # ===========================
    # GREAT LEZI (FOREST LORD)
    # ===========================

    #ARM167ClM2nO4pQ6rS8tU0vW ^"Great Lezi" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 40
            ^"Might Form" TEXT "Herbam"
            ^"Intelligence" INTEGER 3
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER 0
            ^"Strength" TEXT "+6 (at Size 0; +2 per Size increase, -2 per Size decrease)"
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 0
            ^"Quickness" TEXT "0 (at Size 0; -1 per Size increase, +1 per Size decrease)"
            ^"Size" TEXT "varies from -10 to +7 (may change in fractions of an inch)"
            ^"Soak" INTEGER 15
        }
        RULES {
            # Virtues and Flaws
            #ARM167DxY3zA5bC7dE9fG1hI: Virtues: 3x Great Characteristic, Faerie Sight, Faerie Speech, Highly Cognizant, 5x Improved Characteristics
            #ARM167EjK2lM4nO6pQ8rS0tU: Flaws: Sovereign Ward (may not leave forest); some Lezi with backward feet are unable to harm humans who have turned all their clothes backwards

            # Personality Traits
            #ARM167FvW3xY5zA7bC9dE1fG: Personality Traits: Loves Forest +5

            # Pretenses (not Abilities)
            #ARM1680hI2jK4lM6nO8pQ0rS: Pretenses: Animal Handling 9 (woodland creatures), Athletics 3 (striding), Awareness 9 (damage to forest), Bargain 3 (from position of strength), Brawl 6 (human interlopers), Carouse 3 (wine), Charm 2 (forest folk), Faerie Speech 5, Folk Ken 3 (forest folk), Forest Lore 9 (locations), Guile 2 (about woodland dangers), Leadership 9 (woodland creatures), Swim 3 (streams)

            # Combat
            #ARM1681tU3vW5xY7zA9bC1dE: 2x Brawl (club): Init 1-Size, Attack 8, Defense 7-Size, Damage +9+(Size x 2); arms are solid wood and do damage like a club; wielded with Brawl Pretense even if lezi generates clubs

            # Wound Penalties (Size-dependent)
            #ARM1682fG2hI4jK6lM8nO0pQ: Wound Penalties (Size -3 or lower): -1 (1-2), -3 (3-4), -5 (5-6), Incapacitated (7-8), Dead (9+)
            #ARM1683rS3tU5vW7xY9zA1bC: Wound Penalties (Size -1): -1 (1-4), -3 (5-8), -5 (9-12), Incapacitated (13-16), Dead (17+)
            #ARM1684dE2fG4hI6jK8lM0nO: Wound Penalties (Size +1): -1 (1-6), -3 (7-12), -5 (13-18), Incapacitated (19-25), Dead (26+)
            #ARM1685pQ3rS5tU7vW9xY1zA: Wound Penalties (Size +3): -1 (1-8), -3 (9-16), -5 (17-24), Incapacitated (25-32), Dead (33+)
            #ARM1686bC2dE4fG6hI8jK0lM: Wound Penalties (Size +7): -1 (1-12), -3 (13-24), -5 (25-36), Incapacitated (37-48), Dead (49+)

            # Powers
            #ARM1687nO3pQ5rS7tU9vW1xY: Extended Glamour: 0 points, constant, Mentem: Awareness of everything within the forest; faerie is coterminous with the forest and present simultaneously everywhere within its boundaries
            #ARM1688zA2bC4dE6fG8hI0jK: Focus Power (Manifestation): 5 points, Init -5 (add Quickness modifier for Size), Animal or Herbam: Manifests consciousness amongst animal and plant life; simulates any Creo Animal, Rego Animal, Creo Herbam, or Rego Herbam effect of 25 spell levels or less
            #ARM1689lM3nO5pQ7rS9tU1vW: Focus Power (Woodland Change): 5 points, Init -5 (add Quickness modifier), Animal or Herbam: Muto and Intellego effects only in Herbam and Animal
            #ARM168AxY2zA4bC6dE8fG0hI: Focus Power (Size Reduction): 5 points, Init -5, Corpus or Animal: Great Lezi naturally Size +7; use powers to live at smaller Size
            #ARM168BjK3lM5nO7pQ9rS1tU: Transform Into Animal: 3 points, Init -3 (add Quickness modifier), Animal: Transforms into a land animal; retains power of speech in animal form
            #ARM168CvW2xY4zA6bC8dE0fG: Transform Into Bird or Fish: 3 points, Init -3 (add Quickness modifier), Animal: Transforms into a specified bird or fish; retains speech in animal form
            #ARM168DhI3jK5lM7nO9pQ1rS: Transform into Human: Costs whatever it cost to transform away from human shape
            #ARM168EtU2vW4xY6zA8bC0dE: Transform Into Object (Plant): 4 points, Init -4 (add Quickness modifier), Herbam: In plant form, capable of speech and limited movement
            #ARM168FfG3hI5jK7lM9nO1pQ: Note: Lezi are extraordinary; can change into any animal or plant from their woodland without specifying alternative forms as other creatures must

            # Equipment and Vis
            #ARM1690rS2tU4vW6xY8zA0bC: Equipment: Can fabricate endless variety of material from the woodland
            #ARM1691dE3fG5hI7jK9lM1nO: Vis: 8 pawns, external vis, club

            # Appearance and Variants
            #ARM1692pQ2rS4tU6vW8xY0zA: Found in Slavic lands; appears as tall, pale, bearded man with emerald eyes; can take shape of any plant or animal; may change size from blade of grass to tall tree; many have backward feet; many are faunlike
            #ARM1693bC3dE5fG7hI9jK1lM: Commands woodland animals, particularly wolves; "great" distinguishes from the more common lezi (a form of faun)
            #ARM1694nO2pQ4rS6tU8vW0xY: Variant (Basajaun, Basque): Gigantic fauns with striking red fur; became agricultural faeries; use great height for agricultural planning, engineering, and shouting warnings of predators
        }
    }

    # ===========================
    # LORD MARSYNE
    # ===========================

    #ARM1695zA3bC5dE7fG9hI1jK ^"Lord Marsyne" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Faerie"
            ^"Faerie Might" INTEGER 50
            ^"Might Form" TEXT "Aquam"
            ^"Intelligence" INTEGER 2
            ^"Perception" INTEGER 1
            ^"Presence" INTEGER 4
            ^"Communication" INTEGER 1
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER 0
            ^"Size" INTEGER 0
            ^"Apparent Age" TEXT "n/a (40)"
            ^"Confidence Score" TEXT "2 (6)"
            ^"Soak" TEXT "+25 (+5 against iron or steel weapons)"
            ^"Encumbrance" TEXT "0 (0)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1696lM2nO4pQ6rS8tU0vW: Virtues: Great Characteristics, Improved Characteristics x2, Narrowly Cognizant

            # Personality Traits and Reputations
            #ARM1697xY3zA5bC7dE9fG1hI: Personality Traits: Proud +3, Just +1, Forgiving -3
            #ARM1698jK2lM4nO6pQ8rS0tU: Reputations: Grants eternal youth 2 (local)

            # Pretenses (not Abilities)
            #ARM1699vW3xY5zA7bC9dE1fG: Pretenses: [Area] Lore 5 (nobility), Awareness 3 (in his castle), Charm 8 (human women), Etiquette 10 (courtly), Faerie Lore 6 (cold faeries), Folk Ken 5 (people making requests), Guile 5 (pretending to grant requests), Intrigue 4 (court politics), Leadership 7 (servants), Language (All) 5 (commands), Magic Lore 2 (Hermetic magic), Order of Hermes Lore 1 (Merinita)

            # Combat
            #ARM169AhI2jK4lM6nO8pQ0rS: Dodge: Init 0, Attack n/a, Defense 0, Damage n/a

            # Wound Penalties
            #ARM169BtU3vW5xY7zA9bC1dE: Wound Penalties: -1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20)

            # Powers
            #ARM169CfG2hI4jK6lM8nO0pQ: Commanding Presence: 1 point, Init +10, Mentem: Anyone who can see Marsyne becomes awed; gains Personality Trait Respectful to Lord Marsyne +3; disagreeing is Ease Factor 6, contradiction is Ease Factor 9, attacking is Ease Factor 15; does not force obedience but forces subtlety in refusal
            #ARM169DrS3tU5vW7xY9zA1bC: Entomb: 10 points, Init -10, Mentem: Single human target entombed in ice; suspends awareness so target does not need to eat, drink, or breathe, does not think, dream, or remember; Marsyne can break effect at will or it can be dispelled; target still ages and can die of old age
            #ARM169EdE2fG4hI6jK8lM0nO: Gift of Youth: 10 points, Init -10, Corpus: Targets a single woman who stops aging; while in Marsyne's castle she does not age at all; if she leaves, gains Unaging Minor Virtue; once aging restarts it does not stop on return; only works on human women; normally only used on his wives
            #ARM169FpQ3rS5tU7vW9xY1zA: Inner Warmth: 1 point, Init 0, Ignem: Recipient unaffected by mundane cold until entering an aura aligned with a realm other than Faerie; provides no protection against magical cold
            #ARM16A0bC2dE4fG6hI8jK0lM: Lord of Ice: 1 or more points, Init +8, Aquam: Can create any effect involving ice, including effects requiring Hermetic ritual; for every point spent (max 5), the effect has 3 Hermetic magnitudes of power (5 points = 15th magnitude effect)
            #ARM16A1nO3pQ5rS7tU9vW1xY: Lord of the Castle: 0 points, Init +15, Mentem or Corpus: Can command any one servant irresistibly; can control servant's body like puppet or make it fly; limited to one servant at a time; only targets beings who have voluntarily agreed to serve him (most are faeries, but wives also qualify)

            # Equipment and Vis
            #ARM16A2zA2bC4dE6fG8hI0jK: Equipment: Anything he wants, though particularly elaborate items gained quickly will be faerie glamour rather than real
            #ARM16A3lM3nO5pQ7rS9tU1vW: Vis: 10 Aquam, in his blood

            # Appearance and Behavior
            #ARM16A4xY2zA4bC6dE8fG0hI: Tall, well-built, handsome, white skin, pale blond hair, eyes the clear gray of sea ice; wears fine white and blue clothes with a crown of diamonds; literal ice water runs in his veins with small crystals of ice when he bleeds
            #ARM16A5jK3lM5nO7pQ9rS1tU: Ruler of a faerie domain in the far north or high mountains; home is a castle of fantastic beauty made entirely of ice; has an extensive faerie retinue
            #ARM16A6vW2xY4zA6bC8dE0fG: Court acts out elaborate charade of mundane noble life: hunting strange creatures, holding tournaments, passing judgment on criminals
            #ARM16A7hI3jK5lM7nO9pQ1rS: Always has a human wife; chooses beautiful young women with creativity, independence, and spirit; quite taken by The Gift; wooing is utterly sincere as wife must return of own free will
            #ARM16A8tU2vW4xY6zA8bC0dE: Wife plays important political and mystical role; her creativity allows faeries to do new things; she is not a physical wife to Lord Marsyne
            #ARM16A9fG3hI5jK7lM9nO1pQ: If wife breaks rules of the court, Marsyne judges her, entombs her in ice, and seeks new wife; has many entombed wives; some rules are classic traps ("Do not go into this room. Here is the key.")
            #ARM16AArS2tU4vW6xY8zA0bC: A wife can win freedom through successful challenge by external champion or through her own wits; Marsyne remains fond of wives who win freedom fairly; those who simply flee are brought back and entombed
        }
    }

}
