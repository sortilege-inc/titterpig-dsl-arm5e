    #ARM1740sT6uV8wX0yZ2aB4cD ^"The Buran of Yenghissar" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Infernal Creature"
            ^"Infernal Might" INTEGER 25
            ^"Might Form" TEXT "Auram"
            ^"Intelligence" INTEGER -5
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER 3
            ^"Communication" INTEGER -2
            ^"Strength" TEXT "n/a"
            ^"Stamina" TEXT "n/a"
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 6
            ^"Size" INTEGER 4
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Soak" TEXT "Not applicable (insubstantial spirit)"
            ^"Fatigue Levels" TEXT "Not applicable (insubstantial spirit)"
            ^"Wound Penalties" TEXT "Not applicable (insubstantial spirit)"
            # Note: The buran is an insubstantial spirit. It lacks Coagulation
            # and Obsession powers common to most demons. It cannot affect the
            # physical world except through its magic.
        }
        RULES {
            # Virtues and Flaws
            #ARM1741eF7gH9iJ1kL3mN5oP: ^"Virtue/Flaw" TEXT "Jinni"
            #ARM1741qR8sT0uV2wX4yZ6aB: ^"Virtue/Flaw" TEXT "Berserk"
            #ARM1741cD9eF1gH3iJ5kL7mN: ^"Virtue/Flaw" TEXT "Strong-Willed"
            #ARM1741oP0qR2sT4uV6wX8yZ: ^"Virtue/Flaw" TEXT "Wilderness Sense"
            #ARM1741aB1cD3eF5gH7iJ9kL: ^"Virtue/Flaw" TEXT "Fury (Major) (when summoned)"
            #ARM1741mN2oP4qR6sT8uV0wX: ^"Virtue/Flaw" TEXT "Greater Malediction (bound by bargains)"
            #ARM1741yZ3aB5cD7eF9gH1iJ: ^"Virtue/Flaw" TEXT "Mute"

            # Personality Traits
            #ARM1741kL4mN6oP8qR0sT2uV: ^"Personality Trait" TEXT "Untameable +5"

            # Reputations
            #ARM1741wX5yZ7aB9cD1eF3gH: ^"Reputation" TEXT "Scourge of Yenghissar 2 (local)"

            # Abilities
            #ARM1741iJ6kL8mN0oP2qR4sT: ^"Ability" TEXT "Arabic 5 (understanding) -- represents comprehension only, as the spirit is Mute"
            #ARM1741uV7wX9yZ1aB3cD5eF: ^"Ability" TEXT "Folk Ken 3 (travelers)"
            #ARM1741gH8iJ0kL2mN4oP6qR: ^"Ability" TEXT "Theology: Islam 3 (jinn)"
            #ARM1741sT9uV1wX3yZ5aB7cD: ^"Ability" TEXT "Survival 5 (desert)"
            #ARM1741eF0gH2iJ4kL6mN8oP: ^"Ability" TEXT "Taklamakan Lore 5 (legends)"
            #ARM1741qR1sT3uV5wX7yZ9aB: ^"Ability" TEXT "Wilderness Sense 2 (weather)"

            # Combat
            #ARM1742cD2eF4gH6iJ8kL0mN: ^"Combat" TEXT "Not applicable (insubstantial spirit)"

            # Powers
            #ARM1743oP3qR5sT7uV9wX1yZ: ^"Power" TEXT "Delusion of the Desert, 1 or 5 points, Init +3, Imaginem: Creates illusions of companions or oases to lure travelers, or terrifying images of a humanoid sandstorm with fiery eyes. Minor illusion (Individual) costs 1 point; larger illusion (room-sized) costs 5 points. Visions always have a flaw."
            #ARM1743aB4cD6eF8gH0iJ2kL: ^"Power" TEXT "Elemental Control of Wind, variable points, Init +1, Auram: Controls winds of nature. May create any Creo, Muto, or Rego Auram effect at 1 Might Point per magnitude. Cannot exceed Infernal Might in level, nor duplicate Ritual effects."
            #ARM1743mN5oP7qR9sT1uV3wX: ^"Power" TEXT "Recalcitrance, 0 points, Init constant, Vim: Any attempt to control (but not destroy) the buran with Supernatural Power treats its Might as 150% actual, or increases Ease Factor by 50%."
            # Note: Lacks Coagulation and Obsession -- not a typical demon

            # Weakness and Vis
            #ARM1744yZ6aB8cD0eF2gH4iJ: ^"Weakness" TEXT "Protected Group (individuals that invoke the Bismillah invocation)"
            #ARM1744kL7mN9oP1qR3sT5uV: ^"Vis" TEXT "5 pawns of Auram vis prava, left behind as black sand when dispersed"
        }
    }

    #ARM1750wX8yZ0aB2cD4eF6gH ^"Fimus, Warrior Demon" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Infernal Creature"
            ^"Infernal Might" INTEGER 10
            ^"Might Form" TEXT "Terram"
            ^"Intelligence" INTEGER -2
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER 2
            ^"Strength" INTEGER 4
            ^"Stamina" INTEGER 4
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER -4
            ^"Size" INTEGER 2
            ^"Soak" INTEGER 15
            ^"Fatigue Levels" TEXT "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" TEXT "-1 (1-7), -3 (8-14), -5 (15-21), Incapacitated (22-28)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1751iJ9kL1mN3oP5qR7sT: ^"Virtue/Flaw" TEXT "Puissant Great Weapon"
            #ARM1751uV0wX2yZ4aB6cD8eF: ^"Virtue/Flaw" TEXT "Poor Eyesight"
            #ARM1751gH1iJ3kL5mN7oP9qR: ^"Virtue/Flaw" TEXT "Simple-Minded"

            # Personality Traits
            #ARM1751sT2uV4wX6yZ8aB0cD: ^"Personality Trait" TEXT "Untamable +5"
            #ARM1751eF3gH5iJ7kL9mN1oP: ^"Personality Trait" TEXT "Intimidating +3"

            # Reputations
            #ARM1751qR4sT6uV8wX0yZ2aB: ^"Reputation" TEXT "Champion of Hell 1 (Infernal)"

            # Abilities
            #ARM1751cD5eF7gH9iJ1kL3mN: ^"Ability" TEXT "Athletics 3 (pursuit)"
            #ARM1751oP6qR8sT0uV2wX4yZ: ^"Ability" TEXT "Awareness 4 (foes)"
            #ARM1751aB7cD9eF1gH3iJ5kL: ^"Ability" TEXT "Brawl 5 (fist)"
            #ARM1751mN8oP0qR2sT4uV6wX: ^"Ability" TEXT "Great Weapon 6+2 (cudgel)"

