EXTENSION "ARM5e_Bestiary_Infernal" {
    NAME "Ars Magica 5th Edition Definitive - Infernal Creatures"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Base"

    # Infernal creatures are sometimes called demons or devils.
    # These terms refer to the same group of creatures; the choice of which to use
    # is purely a matter of personal preference.
    # Some creatures with Infernal Might are not true demons -- physical beings
    # that have been greatly corrupted by the Infernal. These beings may not have
    # all the powers and features of true demons.
    #
    # All true demons share the following traits:
    # - Can put off physical forms and revert to pure spirits at will
    # - As spirits, they cannot attack or be attacked physically
    # - Can move as quickly as they like as spirits, not hindered by physical barriers
    # - Remain fully aware of their surroundings while in spirit form
    # - Are never noticeably bothered by The Gift
    #
    # All demons have the following powers:
    # - Coagulation: allows manufacturing a solid body from ambient unformed matter
    # - Obsession: imposes a sinful Personality Trait on mortals indulging in venial sin
    # - Envisioning: appear in dreams or create waking visions
    # Many (but not all) demons also have:
    # - Possession: expend Might to enter and control a mortal host
    #
    # Hermetic magic cannot pierce any deception produced by a demon.
    # A demon's Infernal Might is invisible to Hermetic magic.
    # Demons can be warded off by the Form listed next to their Infernal Might.
    # Demons reduced to Infernal Might 0 are destroyed, leaving no corpse and no vis.
    #
    # All demons have at least one additional weakness beyond Divine vulnerability.
    # All demons possess free will but have chosen evil; they always act on selfish
    # and wicked impulses.
    #
    # Corrupt Beasts are mundane animals corrupted by Infernal power. They are not
    # true demons and lack Coagulation and Obsession powers unless specifically noted.

    # ===========================
    # TRUE DEMONS
    # ===========================

    #ARM1700xY4zA6bC8dE0fG2hIj ^"Baal-Peor, Lord of Filth" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Infernal Creature"
            ^"Infernal Might" INTEGER 30
            ^"Might Form" TEXT "Corpus"
            ^"Intelligence" INTEGER 1
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER -5
            ^"Communication" INTEGER 1
            ^"Strength" INTEGER 4
            ^"Stamina" INTEGER 5
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 1
            ^"Size" INTEGER 2
            ^"Confidence Score" INTEGER 3
            ^"Confidence Points" INTEGER 9
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" TEXT "OK, 0/0, -1/-1, -3, -5, Unconscious"
            ^"Wound Penalties" TEXT "-1 (1-7), -3 (8-14), -5 (15-21), Incapacitated (22-28)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1701qR7sT9uV1wX3yZ5aB: ^"Virtue/Flaw" TEXT "Oversensitive (coitus)"
            #ARM1701cD8eF0gH2iJ4kL6mN: ^"Virtue/Flaw" TEXT "Obese"

            # Personality Traits
            #ARM1701oP9qR1sT3uV5wX7yZ: ^"Personality Trait" TEXT "Proud +6"
            #ARM1701aB0cD2eF4gH6iJ8kL: ^"Personality Trait" TEXT "Hungry +3"
            #ARM1701mN1oP3qR5sT7uV9wX: ^"Personality Trait" TEXT "Shame -3"

            # Reputations
            #ARM1701yZ2aB4cD6eF8gH0iJ: ^"Reputation" TEXT "Treasurer of Hell 6 (Infernal)"
            #ARM1701kL3mN5oP7qR9sT1uV: ^"Reputation" TEXT "Demon of Filth 5 (Infernal)"

            # Abilities
            #ARM1701wX4yZ6aB8cD0eF2gH: ^"Ability" TEXT "Artes Liberales 4 (arithmetic)"
            #ARM1701iJ5kL7mN9oP1qR3sT: ^"Ability" TEXT "Brawl 4 (claws)"
            #ARM1701uV6wX8yZ0aB2cD4eF: ^"Ability" TEXT "Civil and Canon Law 4 (trade)"
            #ARM1701gH7iJ9kL1mN3oP5qR: ^"Ability" TEXT "Folk Ken 6 (fornication)"
            #ARM1701sT8uV0wX2yZ4aB6cD: ^"Ability" TEXT "Infernal Lore 5 (wealth)"
            #ARM1701eF9gH1iJ3kL5mN7oP: ^"Ability" TEXT "Intrigue 7 (envy)"
            #ARM1701qR0sT2uV4wX6yZ8aB: ^"Ability" TEXT "Medicine 4 (poisons)"
            #ARM1701cD1eF3gH5iJ7kL9mN: ^"Ability" TEXT "Profession: Merchant 7 (unfair deals)"

            # Combat
            #ARM1702oP2qR4sT6uV8wX0yZ: ^"Combat" TEXT "Noxious Vomit: Init +9, Attack +12, Defense n/a, Damage +12 (see power description)"
            #ARM1702aB3cD5eF7gH9iJ1kL: ^"Combat" TEXT "Claws: Init +4, Attack +5, Defense +6, Damage +6 (coated in excrement; wounds fester and never heal unless Divinely cleansed)"

            # Powers
            #ARM1703mN4oP6qR8sT0uV2wX: ^"Power" TEXT "Form of Woman, 0 points, Init 0, Corpus: Can take the form of a woman (not a specific one), always choosing a form considered beautiful by the target audience."
            #ARM1703yZ5aB7cD9eF1gH3iJ: ^"Power" TEXT "Noxious Vomit, 1 point, Init +9, Corpus: Sprays corrosive vomit doing listed damage. Target must make Str+Size stress roll vs EF 9 or be knocked back. Struck targets suffer +3 damage/round until washed off. Characters with True Faith are immune."
            #ARM1703kL6mN8oP0qR2sT4uV: ^"Power" TEXT "Swallow Assault, 5 points, Init +3, Terram: Avoids injury from mundane objects by opening maw to swallow the attack harmlessly."
            #ARM1703wX7yZ9aB1cD3eF5gH: ^"Power" TEXT "Coagulation, 3 points, Init -1, Corpus"
            #ARM1703iJ8kL0mN2oP4qR6sT: ^"Power" TEXT "Obsession, 1-3 points, Init -5, Vim: Shamelessness, Gluttony"
            #ARM1703uV9wX1yZ3aB5cD7eF: ^"Power" TEXT "Shroud the Stench of the Pit, variable points, Init +3, Vim: Conceals the Infernal nature of a supernatural power, making it appear magical/faerie or wholly mundane. Cost equals the original cost of the concealed power, or magnitude if the power costs no Might."
            #ARM1703gH0iJ2kL4mN6oP8qR: ^"Power" TEXT "The Wealth of Nations, 3 points, Init 0, Terram: Summons riches (up to 1 pound of gold per point of Infernal Might) by teleporting wealth from elsewhere."
            #ARM1703sT1uV3wX5yZ7aB9cD: ^"Power" TEXT "His Master's Voice, variable points, Init +1, Vim: Summons other demons or corrupt beasts. Costs 1 Might point per point of Infernal Might of the summoned being. No control over the summoned demon."

            # Weakness and Vis
            #ARM1704eF2gH4iJ6kL8mN0oP: ^"Weakness" TEXT "Running water"
            #ARM1704qR3sT5uV7wX9yZ1aB: ^"Vis" TEXT "6 pawns of Perdo, in tongue"
        }
    }

    #ARM1710cD4eF6gH8iJ0kL2mN ^"Bartholomew" DEF {
