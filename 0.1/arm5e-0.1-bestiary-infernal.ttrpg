            #ARM1752kL0mN2oP4qR6sT8uV: ^"Combat" TEXT "Fist: Init -4, Attack +6, Defense +2, Damage +4"

            # Powers
            #ARM1753wX1yZ3aB5cD7eF9gH: ^"Power" TEXT "Elemental Control of Earth, variable points, Init +1, Terram: Controls earth. May create any Creo, Muto or Rego Terram effect at 1 Might point per magnitude. Cannot exceed Infernal Might or duplicate Ritual effects. Prefers Wielding the Invisible Sling and Rusted Decay of Ten-Score Years."
            #ARM1753iJ2kL4mN6oP8qR0sT: ^"Power" TEXT "Born of Rock, 0 points, Init 0, Terram: Body is made from solid rock, exceedingly heavy and almost impossible to harm with mundane means."
            #ARM1753uV3wX5yZ7aB9cD1eF: ^"Power" TEXT "Death's Vengeance, 0 points, Init +10, Terram: Upon death, body explodes sending shards up to 20 paces in all directions. Physical attack that can be dodged but not otherwise defended. Attack Bonus +12, Damage +15."
            #ARM1753gH4iJ6kL8mN0oP2qR: ^"Power" TEXT "Coagulation, 1 point, Init -1, Corpus"
            #ARM1753sT5uV7wX9yZ1aB3cD: ^"Power" TEXT "Obsession, 1-3 points, Init -5, Vim: Cowardice"
            #ARM1753eF6gH8iJ0kL2mN4oP: ^"Power" TEXT "Recalcitrance, 0 points, Init constant, Vim: Any attempt to control (but not destroy) the demon with Supernatural Power treats its Might as 150% actual, or increases Ease Factor by 50%. A Circular Ward Against Demons of 30th level is needed."

            # Weakness and Vis
            #ARM1754qR7sT9uV1wX3yZ5aB: ^"Weakness" TEXT "Abhorrent Material (Cinnamon)"
            #ARM1754cD8eF0gH2iJ4kL6mN: ^"Vis" TEXT "2 pawns of Terram, in eye"

            # Note: Fimus is one of many brother-demons (all with the same name).
            # Their mother produces more every time she evacuates her bowels.
            # Popular foot-soldiers used by other demons. Too stupid to rebel.
            # Each brother has a different Abhorrent Material.
        }
    }

    #ARM1760oP9qR1sT3uV5wX7yZ ^"Michael" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Infernal Creature"
            ^"Infernal Might" INTEGER 10
            ^"Might Form" TEXT "Corpus"
            ^"Intelligence" INTEGER 2
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER -2
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 1
            ^"Size" TEXT "-2 to +1 (varies with form)"
            ^"Age" TEXT "n/a (varies)"
            ^"Soak" TEXT "0 (unless wearing armor)"
            ^"Fatigue Levels" TEXT "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" TEXT "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20) -- always takes wounds as Size 0, regardless of current form"
        }
        RULES {
            # Virtues and Flaws
            #ARM1761aB0cD2eF4gH6iJ8kL: ^"Virtue/Flaw" TEXT "None"

            # Personality Traits
            #ARM1761mN1oP3qR5sT7uV9wX: ^"Personality Trait" TEXT "Cruel +3"
            #ARM1761yZ2aB4cD6eF8gH0iJ: ^"Personality Trait" TEXT "Wrathful +3"

            # Abilities
            #ARM1761kL3mN5oP7qR9sT1uV: ^"Ability" TEXT "Athletics 5 (running away)"
            #ARM1761wX4yZ6aB8cD0eF2gH: ^"Ability" TEXT "Awareness 4 (victims)"
            #ARM1761iJ5kL7mN9oP1qR3sT: ^"Ability" TEXT "Craft (practical jokes) 8 (painful and humiliating ones)"
            #ARM1761uV6wX8yZ0aB2cD4eF: ^"Ability" TEXT "Folk Ken 5 (figuring out what will make someone most angry)"
            #ARM1761gH7iJ9kL1mN3oP5qR: ^"Ability" TEXT "Guile 10 (pretending to be someone else)"
            #ARM1761sT8uV0wX2yZ4aB6cD: ^"Ability" TEXT "Intrigue 3 (maneuvering people into his plots)"

            # Combat
            #ARM1762eF9gH1iJ3kL5mN7oP: ^"Combat" TEXT "Michael does not normally fight; if he does, he uses whatever weapons suit his current disguise."

            # Powers
            #ARM1763qR0sT2uV4wX6yZ8aB: ^"Power" TEXT "Change Form, 0 points, Init +0, Corpus: Can change appearance to match any human being, including clothes and equipment as necessary."
            #ARM1763cD1eF3gH5iJ7kL9mN: ^"Power" TEXT "Coagulation, 3 points, Init -1, Corpus"
            #ARM1763oP2qR4sT6uV8wX0yZ: ^"Power" TEXT "Obsession, 1-3 points, Init -5, Vim: Sensitivity to Mockery"
            #ARM1763aB3cD5eF7gH9iJ1kL: ^"Power" TEXT "Working Material, 1 point, Init +0, Terram: Can create whatever he needs to set up a particular practical joke."

            # Equipment, Weakness, and Vis
            #ARM1764mN4oP6qR8sT0uV2wX: ^"Equipment" TEXT "Whatever is appropriate to his current role"
            #ARM1764yZ5aB7cD9eF1gH3iJ: ^"Weakness" TEXT "Abhorrent Material (salt)"
            #ARM1764kL6mN8oP0qR2sT4uV: ^"Vis" TEXT "2 pawns of Muto in his heart (Infernally tainted)"

            # Note: Michael likes taking the name of a famous angel.
            # A minor demon who tempts people to wrath through elaborate, painful,
            # and humiliating practical jokes. He makes sure to be seen in the form
            # of one of the victim's friends while doing so.
            # His jokes are painful and humiliating but almost never fatal --
            # he wants people to sin and damn their souls, not die and possibly go to Heaven.
        }
    }

