            ^"Stamina" INTEGER 0
            ^"Dexterity" INTEGER -1
            ^"Quickness" INTEGER -1
            ^"Size" INTEGER 0
            ^"Age" TEXT "n/a (50)"
            ^"Confidence Score" INTEGER 2
            ^"Confidence Points" INTEGER 9
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" TEXT "OK, 0, -1, -3, -5, Unconscious"
