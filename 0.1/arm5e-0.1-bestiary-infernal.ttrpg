            # Note: Polandrus targets livestock farmers. He dominates wolves, kills
            # livestock, then confronts the farmer offering protection in exchange
            # for escalating sinful acts. Appears as an extremely large, jet black
            # wolf with red eyes.
        }
    }

    # ===========================
    # CORRUPT BEASTS
    # ===========================
    # Corrupt beasts are not true demons. They are mundane beasts corrupted
    # by Infernal power. They may lack Coagulation and Obsession powers.
    # Created through: direct demonic corruption, demonic coupling with beasts,
    # dwelling in Infernal auras, Infernal Warping, or diabolist/Infernalist powers.
    #
    # Corrupt Beast creation rules:
    # - Start with mundane beast statistics
    # - Apply Corrupted Beast Flaw (grants Infernal Might 5, sinful trait at +6,
    #   Presence reduced to -6 but treated as +6 for intimidation, Tainted with Evil)
    # - Balance with Virtues; additional Flaws may grant further Virtues
    # - Lesser Infernal Power (Minor Virtue): adds 2 to Might, costs 0-2 points
    # - Greater Infernal Power (Major Virtue): adds 5 to Might, requires Penetration
    # - Demonic Weakness (Minor Flaw): weakness similar to a demon's
    # - Horrifying Appearance (Major Flaw): hideously deformed, cannot pass for normal

    #ARM1780aB9cD1eF3gH5iJ7kL ^"Demonic Steed" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Corrupt Beast"
            ^"Infernal Might" INTEGER 7
            ^"Might Form" TEXT "Animal"
            ^"Cunning" INTEGER -2
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER -6
            ^"Communication" INTEGER -4
            ^"Strength" INTEGER 4
            ^"Stamina" INTEGER 4
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 1
            ^"Size" INTEGER 3
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" TEXT "OK, 0/0, 0/0, -2, -4, Unconscious"
            ^"Wound Penalties" TEXT "-1 (1-8), -3 (9-16), -5 (17-24), Incapacitated (25-32)"
        }
        RULES {
            # Virtues and Flaws
            #ARM1781mN0oP2qR4sT6uV8wX: ^"Virtue/Flaw" TEXT "Enduring Constitution"
            #ARM1781yZ1aB3cD5eF7gH9iJ: ^"Virtue/Flaw" TEXT "Improved Characteristics"
            #ARM1781kL2mN4oP6qR8sT0uV: ^"Virtue/Flaw" TEXT "Lesser Infernal Power (from corruption)"
            #ARM1781wX3yZ5aB7cD9eF1gH: ^"Virtue/Flaw" TEXT "Long Winded"
            #ARM1781iJ4kL6mN8oP0qR2sT: ^"Virtue/Flaw" TEXT "Proud"
            #ARM1781uV5wX7yZ9aB1cD3eF: ^"Virtue/Flaw" TEXT "Corrupted Beast (from corruption)"

            # Personality Traits
            #ARM1781gH6iJ8kL0mN2oP4qR: ^"Personality Trait" TEXT "Vain +6"
            #ARM1781sT7uV9wX1yZ3aB5cD: ^"Personality Trait" TEXT "Brave +1"

            # Abilities
            #ARM1781eF8gH0iJ2kL4mN6oP: ^"Ability" TEXT "Athletics 5 (long-distance running)"
            #ARM1781qR9sT1uV3wX5yZ7aB: ^"Ability" TEXT "Brawl 3 (hooves)"

            # Combat
            #ARM1782cD0eF2gH4iJ6kL8mN: ^"Combat" TEXT "Kick: Init +3, Attack +7, Defense +7, Damage +5"

            # Powers
            #ARM1783oP1qR3sT5uV7wX9yZ: ^"Power" TEXT "The Unimpeded Traveler, 0 points, Init +1, Animal: Not impeded by poor terrain; moves at maximum speed on the worst roads (30 miles/day). Can cross open water and chasms unsupported, but only at trotting pace."

            # Vis
            #ARM1784aB2cD4eF6gH8iJ0kL: ^"Vis" TEXT "2 pawns of Animal, in hooves"

            # Note: One of three steeds created by an Infernalist magus through
            # repeated applications of a tainted version of Steed of Vengeance
            # (Muto Animal Level 35). Appears as a fearsome black stallion with
            # bloodshot eyes, fangs, and hooves of iron.
        }
    }

