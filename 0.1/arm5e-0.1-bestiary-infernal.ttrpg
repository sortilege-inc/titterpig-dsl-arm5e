            #ARM1733iJ3kL5mN7oP9qR1sT: ^"Power" TEXT "Whispers Behind the Back, 2 points, Init 0, Mentem: As the spell Pains of the Perpetual Worry; gives a nagging, taunting anxiety that secret sins will be uncovered, and suspicion that everyone already knows. Lasts one month."

            # Weakness and Vis
            #ARM1734uV4wX6yZ8aB0cD2eF: ^"Weakness" TEXT "Protected Group (red-haired women)"
            #ARM1734gH5iJ7kL9mN1oP3qR: ^"Vis" TEXT "3 pawns of Mentem, in hair"
        }
