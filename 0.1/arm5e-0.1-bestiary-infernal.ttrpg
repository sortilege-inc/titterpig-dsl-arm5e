            #ARM1721sT0uV2wX4yZ6aB8cD: ^"Ability" TEXT "Guile 6 (boasts)"

            # Combat
            #ARM1722eF1gH3iJ5kL7mN9oP: ^"Combat" TEXT "Dodge: Init +7, Attack n/a, Defense +14, Damage n/a"

            # Powers
            #ARM1723qR2sT4uV6wX8yZ0aB: ^"Power" TEXT "Make a Liar of the Boastful, 5 points, Init 0, Vim: When hearing a boast, expends all Might to grant someone nearby an Ability or Power contradicting the boast, used immediately. Lasts 1-10 rounds (simple die). Physical changes last until boaster and target can no longer see each other."
            #ARM1723cD3eF5gH7iJ9kL1mN: ^"Power" TEXT "Insignificance, 0 points, Init 0, Vim: No Magic, Infernal or Faerie power can force Bomburkhan to use any of his powers."
            #ARM1723oP4qR6sT8uV0wX2yZ: ^"Power" TEXT "Misfortune, 0 points, Init 0, Vim: Presence causes worst luck. In games of chance, odds always favor opponent. In other matters, target receives -2 to rolls where luck matters more than skill. Lasts until demon grows bored or is driven off."
            #ARM1723aB5cD7eF9gH1iJ3kL: ^"Power" TEXT "Coagulation, 1 point, Init -1, Corpus"
            #ARM1723mN6oP8qR0sT2uV4wX: ^"Power" TEXT "Obsession, 1-3 points, Init -5, Vim: Boastful"

            # Weakness and Vis
            #ARM1724yZ7aB9cD1eF3gH5iJ: ^"Weakness" TEXT "Vulnerability (salt)"
            #ARM1724kL8mN0oP2qR4sT6uV: ^"Vis" TEXT "1 pawn of Vim, in wings"
        }
    }

