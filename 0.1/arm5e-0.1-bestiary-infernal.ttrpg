            # Abilities
            #ARM1711wX0yZ2aB4cD6eF8gH: ^"Ability" TEXT "[Area] Lore 6 (trade routes) -- three of these, for local area, larger region, and whole of Europe"
            #ARM1711iJ1kL3mN5oP7qR9sT: ^"Ability" TEXT "Artes Liberales 2 (arithmetic)"
            #ARM1711uV2wX4yZ6aB8cD0eF: ^"Ability" TEXT "Bargain 10 (trade goods)"
            #ARM1711gH3iJ5kL7mN9oP1qR: ^"Ability" TEXT "Charm 5 (merchants)"
            #ARM1711sT4uV6wX8yZ0aB2cD: ^"Ability" TEXT "Etiquette 4 (merchants)"
            #ARM1711eF5gH7iJ9kL1mN3oP: ^"Ability" TEXT "Folk Ken 8 (merchants)"
            #ARM1711qR6sT8uV0wX2yZ4aB: ^"Ability" TEXT "Guile 10 (trading)"
            #ARM1711cD7eF9gH1iJ3kL5mN: ^"Ability" TEXT "Intrigue 5 (market politics)"
            #ARM1711oP8qR0sT2uV4wX6yZ: ^"Ability" TEXT "Language 6 (trade talk)"
            #ARM1711aB9cD1eF3gH5iJ7kL: ^"Ability" TEXT "Latin 6 (ecclesiastical)"
            #ARM1711mN0oP2qR4sT6uV8wX: ^"Ability" TEXT "Profession (merchant) 10 (cloth)"

            # Combat
            #ARM1712yZ1aB3cD5eF7gH9iJ: ^"Combat" TEXT "Fist: Init -1, Attack -1, Defense -1, Damage -1"

            # Powers
            #ARM1713kL2mN4oP6qR8sT0uV: ^"Power" TEXT "Merchant's Blessing, 2 points, Init +0, Mentem: Recipient seems trustworthy, gets +3 bonus on all social rolls related to trading. Lasts one week unless renewed."
            #ARM1713wX3yZ5aB7cD9eF1gH: ^"Power" TEXT "Merchant's Curse, 1 point, Init +0, Mentem: Inverse of Merchant's Blessing; target is treated as dishonest, -3 penalty to trading social rolls. Lasts one week unless renewed."
            #ARM1713iJ4kL6mN8oP0qR2sT: ^"Power" TEXT "Merchant's Knowledge, 0 points, automatic, Mentem: Knows what anyone under his curses or blessings is doing with their business."
            #ARM1713uV5wX7yZ9aB1cD3eF: ^"Power" TEXT "Project Blessing, 2 points, Init +0, Vim: Blesses a commercial venture so chance favors it. Lasts one day, renewable."
            #ARM1713gH6iJ8kL0mN2oP4qR: ^"Power" TEXT "Project Curse, 1 point, Init +0, Vim: Inverse of Project Blessing; makes everything go wrong. Can drive someone to bankruptcy within a month. Lasts one day, renewable."
            #ARM1713sT7uV9wX1yZ3aB5cD: ^"Power" TEXT "Coagulation, 3 points, Init -1, Corpus"
            #ARM1713eF8gH0iJ2kL4mN6oP: ^"Power" TEXT "Obsession, 1-3 points, Init -5, Vim: Avarice"

            # Equipment, Weakness, and Vis
