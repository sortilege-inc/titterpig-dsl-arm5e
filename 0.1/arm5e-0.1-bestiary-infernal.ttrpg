            ^"Soak" INTEGER 1
            ^"Fatigue Levels" TEXT "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" TEXT "-1 (1), -3 (2), -5 (3), Incapacitated (4)"
