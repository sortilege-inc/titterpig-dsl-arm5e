            #ARM1714cD0eF2gH4iJ6kL8mN: ^"Weakness" TEXT "Ordering"
            #ARM1714oP1qR3sT5uV7wX9yZ: ^"Vis" TEXT "10 pawns of Mentem vis, one in each finger. Infernally tainted."
        }
    }

    #ARM1720aB2cD4eF6gH8iJ0kL ^"Bomburkhan" DEF {
