            ^"Presence" INTEGER 0
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER 6
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 1
            ^"Size" INTEGER 2
            ^"Confidence Score" INTEGER 2
            ^"Confidence Points" INTEGER 6
            ^"Soak" INTEGER 8
        }
        RULES {
            #ARM14C1zA6bC8dE0fG2hI4jK: Virtues: Ferocity (self-defense), Improved Characteristics (x2), Puissant Brawl, Self-Confident, Tough; Flaws: Proud, Weakness (submission)
            #ARM14C2lM7nO9pQ1rS3tU5vW: Qualities: Aggressive, Ambush Predator, Crafty, Good Jumper, Hardy, Imposing Appearance, Large Claws, Large Teeth, Tough Hide, Vocal
            #ARM14C3xY8zA0bC2dE4fG6hI: Personality Traits: Brave +5, Fierce +5
            #ARM14C4jK9lM1nO3pQ5rS7tU: Reputations: Fierce (local) 4
            #ARM14C5vW0xY2zA4bC6dE8fG: Claws: Init +1, Attack +15, Defense +12, Damage +10
            #ARM14C6hI1jK3lM5nO7pQ9rS: Bite: Init +1, Attack +13, Defense +9, Damage +9
            #ARM14C7tU2vW4xY6zA8bC0dE: Natural Weapons — Large Claws: Init 0, Atk +5, Def +3, Dam +4; Large Teeth: Init 0, Atk +4, Def +1, Dam +3; Protection +2 (hide)
            #ARM14C8fG3hI5jK7lM9nO1pQ: Fatigue Levels: OK, 0/0, -1, -3, -5, Unconscious
            #ARM14C9rS4tU6vW8xY0zA2bC: Wound Penalties: -1 (1-7), -3 (8-14), -5 (15-21), Incapacitated (22-28), Dead (29+)
            #ARM14CAdE5fG7hI9jK1lM3nO: Abilities: Athletics 5 (pouncing), Awareness 2 (smell), Brawl 5+2 (claws), Hunt 4 (deer), Stealth 4 (stalking), Survival 5 (arid climates)
            #ARM14CBpQ6rS8tU0vW2xY4zA: Impressive leaps — +3 to jump-related rolls; can leap high enough to attack a mounted rider; will not attack a man who lies prostrate
        }
    }

    #ARM14D0bC7dE9fG1hI3jK5lM ^"Stag" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Mundane Beast"
            ^"Latin" TEXT "Cervus"
            ^"Cunning" INTEGER -2
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER -5
            ^"Strength" INTEGER 2
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER 2
            ^"Size" INTEGER 2
            ^"Confidence Score" INTEGER 0
            ^"Soak" INTEGER 2
        }
        RULES {
            #ARM14D1nO8pQ0rS2tU4vW6xY: Virtues: Higher Purpose (protect the herd), Improved Characteristics; Flaws: None listed
            #ARM14D2zA9bC1dE3fG5hI7jK: Qualities: Defensive Fighter, Extra Natural Weapons, Fast Runner, Good Jumper, Large Antlers, Sharp Ears
            #ARM14D3lM0nO2pQ4rS6tU8vW: Personality Traits: Brave +1
            #ARM14D4xY1zA3bC5dE7fG9hI: Reputations: Noble (local) 2
