BASE "ARM5e_Core_Base" {
    NAME "Ars Magica 5th Edition Definitive - Core mechanics, ACTORs, and fundamental game rules"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Ars Magica 5th Edition Definitive (Atlas Games, 2024)
    # Troupe-style play in Mythic Europe, centered on Hermetic wizards
    # Resolution: Characteristic + Ability + Die Roll vs Ease Factor

    # ===========================
    # ACTOR HIERARCHY
    # ===========================

    #ARM001aB2cD4eF6gH8iJ0kL ACTOR "Entity" DEF {
        # The root of all actor types in Ars Magica
        # All ACTORs ultimately extend from Entity

        PROPERTIES {
            ^"Name" STRING REQUIRED
            ^"Description" STRING
        }

        RULES {
            #ARM002mN3oP5qR7sT9uV1wX: WHEN [^"Entity" CREATED] THEN REQUIRE ^"Name"
        }
    }

    #ARM003xY4zA6bC8dE0fG2hIj ACTOR "Magus" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Hermetic wizards, members of the Order of Hermes.
        # The most powerful player character type. Each magus belongs
        # to one of the twelve Houses. Magi have The Gift, which
        # allows them to learn Hermetic magic but causes social
        # difficulties with mundane people.

        PROPERTIES {
            ^"House" STRING REQUIRED
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Perception" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Strength" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Stamina" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Presence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Communication" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Dexterity" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Quickness" INTEGER MIN -5 MAX 5 DEFAULT 0
            }
            ^"Size" INTEGER DEFAULT 0
            ^"Age" INTEGER MIN 0
            ^"Apparent Age" INTEGER MIN 0
            ^"Decrepitude" INTEGER MIN 0 DEFAULT 0
            ^"Warping Score" INTEGER MIN 0 DEFAULT 0
            ^"Confidence Score" INTEGER MIN 0 DEFAULT 1
            ^"Confidence Points" INTEGER MIN 0 DEFAULT 3
            ^"Hermetic Arts" DEF {
                # Techniques
                ^"Creo" INTEGER MIN 0 DEFAULT 0
                ^"Intellego" INTEGER MIN 0 DEFAULT 0
                ^"Muto" INTEGER MIN 0 DEFAULT 0
                ^"Perdo" INTEGER MIN 0 DEFAULT 0
                ^"Rego" INTEGER MIN 0 DEFAULT 0
                # Forms
                ^"Animal" INTEGER MIN 0 DEFAULT 0
                ^"Aquam" INTEGER MIN 0 DEFAULT 0
                ^"Auram" INTEGER MIN 0 DEFAULT 0
                ^"Corpus" INTEGER MIN 0 DEFAULT 0
                ^"Herbam" INTEGER MIN 0 DEFAULT 0
                ^"Ignem" INTEGER MIN 0 DEFAULT 0
                ^"Imaginem" INTEGER MIN 0 DEFAULT 0
                ^"Mentem" INTEGER MIN 0 DEFAULT 0
                ^"Terram" INTEGER MIN 0 DEFAULT 0
                ^"Vim" INTEGER MIN 0 DEFAULT 0
            }
            ^"Abilities" LIST OF ^"Ability"
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Spells" LIST OF ^"Spell"
            ^"Personality Traits" LIST OF ^"Personality Trait"
            ^"Reputations" LIST OF ^"Reputation"
            ^"Equipment" LIST OF STRING
            ^"Sigil" STRING  # Unique magical signature
            ^"Voting Sigil" STRING  # Token for Tribunal voting
            ^"Parma Magica Score" INTEGER MIN 0 DEFAULT 0
        }

        RULES {
            #ARM004jK5lM7nO9pQ1rS3tU: WHEN [^"Magus" CREATED] THEN REQUIRE ^"House"
            #ARM005uV6wX8yZ0aB2cD4eF: ^"Magus" HAS ^"The Gift"
            #ARM006fG7hI9jK1lM3nO5pQ: WHEN [^"Magus" CREATED] THEN REQUIRE at least 1 ^"Ability" with name "Magic Theory"
            #ARM007qR8sT0uV2wX4yZ6aB: WHEN [^"Magus" CREATED] THEN REQUIRE at least 1 ^"Ability" with name "Latin"
            #ARM008bC9dE1fG3hI5jK7lM: WHEN [^"Magus" CREATED] THEN REQUIRE at least 1 ^"Ability" with name "Parma Magica"
        }
    }

    #ARM009mN0oP2qR4sT6uV8wX ACTOR "Companion" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Important non-magus characters. Each player has one companion
        # in addition to their magus. Companions can be knights, friars,
        # nobles, hedge wizards, or other significant individuals.
        # Companions generally do not have The Gift.

        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Perception" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Strength" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Stamina" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Presence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Communication" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Dexterity" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Quickness" INTEGER MIN -5 MAX 5 DEFAULT 0
            }
            ^"Size" INTEGER DEFAULT 0
            ^"Age" INTEGER MIN 0
            ^"Decrepitude" INTEGER MIN 0 DEFAULT 0
            ^"Warping Score" INTEGER MIN 0 DEFAULT 0
            ^"Confidence Score" INTEGER MIN 0 DEFAULT 1
            ^"Confidence Points" INTEGER MIN 0 DEFAULT 3
            ^"Abilities" LIST OF ^"Ability"
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Personality Traits" LIST OF ^"Personality Trait"
            ^"Reputations" LIST OF ^"Reputation"
            ^"Equipment" LIST OF STRING
        }

        RULES {
            #ARM010xY1zA3bC5dE7fG9hI: WHEN [^"Companion" CREATED] THEN MAY NOT HAVE ^"The Gift" unless explicitly granted
        }
    }

    #ARM011iJ2kL4mN6oP8qR0sT ACTOR "Grog" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Minor characters: warriors, servants, specialists.
        # Grogs are often shared between players. Simplified creation:
        # no Major Virtues or Flaws, no more than 3 Minor Flaws,
        # no Story Flaws, cannot have The Gift.

        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Perception" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Strength" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Stamina" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Presence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Communication" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Dexterity" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Quickness" INTEGER MIN -5 MAX 5 DEFAULT 0
            }
            ^"Size" INTEGER DEFAULT 0
            ^"Age" INTEGER MIN 0
            ^"Decrepitude" INTEGER MIN 0 DEFAULT 0
            ^"Abilities" LIST OF ^"Ability"
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Personality Traits" LIST OF ^"Personality Trait"
            ^"Equipment" LIST OF STRING
        }

        RULES {
            #ARM012tU3vW5xY7zA9bC1dE: WHEN [^"Grog" CREATED] THEN LIMIT ^"Flaws" to 3 Minor
            #ARM013eF4gH6iJ8kL0mN2oP: ^"Grog" MAY NOT HAVE Major ^"Virtue" OR Major ^"Flaw"
            #ARM014pQ5rS7tU9vW1xY3zA: ^"Grog" MAY NOT HAVE Story ^"Flaw"
            #ARM015aB6cD8eF0gH2iJ4kL: ^"Grog" MAY NOT HAVE ^"The Gift"
        }
    }

    #ARM016lM7nO9pQ1rS3tU5vW ACTOR "Mythic Companion" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Extra-powerful non-magus characters comparable to magi in
        # power level. Includes non-Hermetic wizards, holy hermits,
        # supernaturally strong warriors. Played as an alternative
        # to a magus character, not in addition to one.

        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Perception" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Strength" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Stamina" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Presence" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Communication" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Dexterity" INTEGER MIN -5 MAX 5 DEFAULT 0
                ^"Quickness" INTEGER MIN -5 MAX 5 DEFAULT 0
            }
            ^"Size" INTEGER DEFAULT 0
            ^"Age" INTEGER MIN 0
            ^"Decrepitude" INTEGER MIN 0 DEFAULT 0
            ^"Warping Score" INTEGER MIN 0 DEFAULT 0
            ^"Confidence Score" INTEGER MIN 0 DEFAULT 1
            ^"Confidence Points" INTEGER MIN 0 DEFAULT 3
            ^"Abilities" LIST OF ^"Ability"
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Personality Traits" LIST OF ^"Personality Trait"
            ^"Reputations" LIST OF ^"Reputation"
            ^"Equipment" LIST OF STRING
        }

        RULES {
            #ARM017xY8zA0bC2dE4fG6hI: ^"Mythic Companion" IS alternative to ^"Magus", not additional
        }
    }

    #ARM018iJ9kL1mN3oP5qR7sT ACTOR "Creature" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # Supernatural beings with Might scores: magical beasts,
        # faeries, demons, angels. Realm alignment determines which
        # realm powers the creature and its Might type.

        PROPERTIES {
            ^"Might" INTEGER MIN 0
            ^"Might Type" ENUM ["Magic", "Faerie", "Infernal", "Divine"]
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Perception" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Strength" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Stamina" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Presence" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Communication" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Dexterity" INTEGER MIN -10 MAX 10 DEFAULT 0
                ^"Quickness" INTEGER MIN -10 MAX 10 DEFAULT 0
            }
            ^"Size" INTEGER
            ^"Abilities" LIST OF ^"Ability"
            ^"Powers" LIST OF ^"Power"
            ^"Vis" STRING  # Vis contained in the creature's body
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Personality Traits" LIST OF ^"Personality Trait"
            ^"Combat" DEF {
                ^"Weapons" LIST OF ^"Weapon Attack"
            }
        }

        RULES {
            #ARM019uV0wX2yZ4aB6cD8eF: WHEN [^"Creature" CREATED] THEN REQUIRE ^"Might" AND ^"Might Type"
            #ARM020gH1iJ3kL5mN7oP9qR: ^"Creature" USES ^"Might" to fuel ^"Powers"
            #ARM021sT2uV4wX6yZ8aB0cD: ^"Creature" HAS magic resistance equal to ^"Might"
        }
    }

    #ARM022eF3gH5iJ7kL9mN1oP ACTOR "Covenant" DEF {
        EXTENDS #ARM001aB2cD4eF6gH8iJ0kL ^"Entity"

        # The shared home of a group of magi. Covenants are
        # quasi-characters with their own resources, seasons, and
        # development. A covenant has an aura, a library, laboratories,
        # grogs, and covenfolk.

        PROPERTIES {
            ^"Season" ENUM ["Spring", "Summer", "Autumn", "Winter"]
            ^"Aura" INTEGER MIN 0 MAX 10
            ^"Aura Type" ENUM ["Magic", "Faerie", "Infernal", "Divine"]
            ^"Members" LIST OF ^"Magus" REQUIRED
            ^"Companions" LIST OF ^"Companion"
            ^"Grogs" LIST OF ^"Grog"
            ^"Library" LIST OF ^"Book"
            ^"Laboratories" LIST OF ^"Laboratory"
            ^"Vis Sources" LIST OF ^"Vis Source"
            ^"Income" INTEGER
            ^"Build Points" INTEGER MIN 0
        }

        RULES {
            #ARM023qR4sT6uV8wX0yZ2aB: WHEN [^"Covenant" CREATED] THEN REQUIRE at least 1 ^"Magus" in ^"Members"
            #ARM024bC5dE7fG9hI1jK3lM: ^"Covenant" ^"Season" reflects its lifecycle stage
        }
    }

    # ===========================
    # METATYPE ANCHORS
    # ===========================

    ^"Game Rules" DEF {
        # Metatype anchor for game rules and errata references
    }

    ^"System" DEF {
        # Metatype anchor for game system and subsystem definitions
    }

    ^"Table" DEF {
        # Metatype anchor for reference table definitions
    }

    ^"NPC" DEF {
        # Metatype anchor for non-player character definitions
    }

    ^"Optional Rule" DEF {
        # Metatype anchor for optional/variant rule definitions
    }

    ^"Mechanic" DEF {
        # Metatype anchor for GM-facing mechanic and design guidance
    }

    ^"Item" DEF {
        # Metatype anchor for equipment and item definitions
    }

    # ===========================
    # DICE SYSTEM
    # ===========================

    ^"Simple Die" DEF {

        # A ten-sided die where each number counts for its value
        # and 0 counts as 10. Used in non-stressful situations.

        PROPERTIES {
            ^"Die Type" STRING "1d10"
            ^"Zero Result" STRING "Counts as 10"
        }

        RULES {
            #ARM025nO5pQ7rS9tU1vW3xY: simple_die_no_botch_possible
            #ARM026yZ6aB8cD0eF2gH4iJ: simple_die_zero_equals_ten
        }
    }

    ^"Stress Die" DEF {

        # A ten-sided die used under stress. Has special behavior
        # on rolls of 0 and 1.
        # Roll of 1: Exploding — re-roll and double the result.
        #   Additional 1s continue doubling (x4, x8, x16...).
        #   On re-rolls, 0 counts as 10.
        # Roll of 0: Check for botch. Roll botch dice.
        #   Any 0 on botch dice = botch (total is 0 or less).
        #   No 0s on botch dice = die result is simply 0.
        # Rolls of 2-9: Face value, as normal.

        PROPERTIES {
            ^"Die Type" STRING "1d10"
            ^"Exploding On" INTEGER 1
            ^"Botch Check On" INTEGER 0
        }

        RULES {
            #ARM027kL7mN9oP1qR3sT5uV: WHEN [stress die shows 1] THEN re-roll and double
            #ARM028wX8yZ0aB2cD4eF6gH: WHEN [stress die re-roll shows 1] THEN re-roll and multiply by next power of 2
            #ARM029iJ9kL1mN3oP5qR7sT: WHEN [stress die shows 0] THEN roll botch dice
            #ARM030uV0wX2yZ4aB6cD8eF: WHEN [stress die shows 0 AND no botch] THEN die result is 0
            #ARM031gH1iJ3kL5mN7oP9qR: WHEN [botch] THEN total is no higher than 0
        }
    }

    ^"Botch Dice" DEF {

        # Rolled when a stress die shows 0. The number of botch dice
        # reflects how risky the situation is. If any botch die shows 0,
        # the action is a botch. Multiple 0s indicate worse botches.
        # Base: 1 botch die in normal conditions.
        # Hazardous conditions add additional botch dice.
        # Some situations have 0 botch dice (no botch possible).

        PROPERTIES {
            ^"Die Type" STRING "d10"
            ^"Base Count" INTEGER 1
            ^"Botch Trigger" STRING "Any die showing 0"
        }

        BOTCH_SEVERITY {
            1 "Single botch — minor disaster"
            2 "Double botch — significant disaster"
            3 "Triple botch — catastrophic disaster, about as bad as it could go"
        }

        RULES {
            #ARM032sT2uV4wX6yZ8aB0cD: botch_dice_count_reflects_risk
            #ARM033eF3gH5iJ7kL9mN1oP: multiple_zeros_indicate_worse_botch
            #ARM034pQ4rS6tU8vW0xY2zA: zero_botch_dice_means_no_botch_possible
        }
    }

    # ===========================
    # CORE RESOLUTION
    # ===========================

    ^"Ability Roll" DEF {

        # The fundamental resolution mechanic for non-magical actions.
        # Total = Characteristic + Ability + Die Roll
        # Compare total to Ease Factor: meet or exceed = success.
        # Amount exceeding EF indicates quality of success.
        # Die type (Simple or Stress) depends on situation.

        FORMULA "Characteristic + Ability + Die Roll >= Ease Factor"

        RULES {
            #ARM035bC5dE7fG9hI1jK3lM: WHEN [non-combat, non-magic action] THEN ROLL ^"Ability Roll"
            #ARM036mN6oP8qR0sT2uV4wX: excess_over_ease_factor_indicates_quality
            #ARM037xY7zA9bC1dE3fG5hI: WHEN [relaxed conditions] THEN USE ^"Simple Die"
            #ARM038iJ8kL0mN2oP4qR6sT: WHEN [stressful conditions] THEN USE ^"Stress Die"
        }
    }

    ^"Ease Factor" DEF {

        INTEGER MIN 0

        # The target number for ability rolls. Set by the storyguide.
        # Higher values indicate more difficult tasks.

        DIFFICULTY_SCALE {
            0 "Trivial — Almost never worth rolling"
            3 "Simple — Untrained average person succeeds ~70%"
            6 "Easy — Trained average person succeeds ~70%"
            9 "Average — Skilled characters succeed ~70%"
            12 "Hard — Only skilled characters have a chance"
            15 "Very Hard — Even skilled characters fail half the time"
            18 "Impressive — Top experts succeed ~50%"
            21 "Remarkable — Even the best only occasionally succeed"
            24 "Almost Impossible — Greatest masters need luck"
        }

        RULES {
            #ARM039uV9wX1yZ3aB5cD7eF: storyguide_sets_ease_factor
            #ARM040gH0iJ2kL4mN6oP8qR: default_characteristic_range_minus3_to_plus3
        }
    }

    # ===========================
    # SIZE
    # ===========================

    ^"Size" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER DEFAULT 0

        # Size 0 = average adult human. Every 3 points of Size
        # represents a tenfold change in mass. Adult humans range
        # from Size -2 to Size +2 with appropriate Virtues/Flaws.
        # Size affects wound ranges, Soak, and encumbrance.

        RULES {
            #ARM041sT1uV3wX5yZ7aB9cD: size_zero_is_average_adult_human
            #ARM042eF2gH4iJ6kL8mN0oP: three_size_points_equals_tenfold_mass
            #ARM043pQ3rS5tU7vW9xY1zA: size_affects_wound_ranges
        }
    }

    # ===========================
    # CONFIDENCE
    # ===========================

    ^"Confidence" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]

        # Important characters have a Confidence Score (usually 1)
        # and Confidence Points (start at 3). Spending a Confidence
        # Point adds +3 to a roll (decided after seeing result).
        # May spend up to Confidence Score points per roll.
        # Cannot spend on botched rolls or seasonal activity rolls.
        # Points are gone once spent and not recovered; new points
        # are awarded by the storyguide at session end.

        PROPERTIES {
            ^"Confidence Score" INTEGER MIN 0 DEFAULT 1
            ^"Confidence Points" INTEGER MIN 0 DEFAULT 3
        }

        RULES {
            #ARM044bC4dE6fG8hI0jK2lM: WHEN [spending ^"Confidence Points"] THEN ADD +3 per point to roll
            #ARM045mN5oP7qR9sT1uV3wX: MAY spend up to ^"Confidence Score" points per roll
            #ARM046xY6zA8bC0dE2fG4hI: MAY NOT spend ^"Confidence Points" on botched roll
            #ARM047iJ7kL9mN1oP3qR5sT: MAY NOT spend ^"Confidence Points" on seasonal activity roll
            #ARM048uV8wX0yZ2aB4cD6eF: storyguide awards 1-5 ^"Confidence Points" per session
        }
    }

    # ===========================
    # PERSONALITY TRAITS
    # ===========================

    ^"Personality Trait" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Short description of a character's personality, with a numeric
        # score. Range: normally -3 to +3. Minor Personality Flaw = +/-3,
        # Major Personality Flaw = +/-6. Personality Trait rolls use
        # the Trait score + stress die against an Ease Factor.
        # Particularly important for grogs, where they serve as
        # concrete guides to playing the shared character.

        PROPERTIES {
            ^"Trait Name" STRING REQUIRED
            ^"Score" INTEGER MIN -6 MAX 6
        }

        RULES {
            #ARM049gH9iJ1kL3mN5oP7qR: personality_trait_roll_equals_score_plus_stress_die
            #ARM050sT0uV2wX4yZ6aB8cD: traits_changed_only_between_sessions_by_controlling_player
        }
    }

    # ===========================
    # REPUTATIONS
    # ===========================

    ^"Reputation" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Whether people have heard of the character. Has a score,
        # a content (what for), and a type (who might know).
        # Recognition roll: stress die + Reputation score >= Ease Factor.

        PROPERTIES {
            ^"Content" STRING REQUIRED  # What the reputation is for
            ^"Score" INTEGER MIN 0
            ^"Type" ENUM ["Local", "Ecclesiastical", "Hermetic"]
        }

        REPUTATION_EASE_FACTORS {
            ^"Local" DEF {
                0 "Same village"
                6 "Same town"
                9 "Same county"
                12 "Same country"
            }
            ^"Ecclesiastical" DEF {
                0 "Same parish/monastery"
                6 "Same diocese"
                9 "Same province"
                12 "Whole Church"
            }
            ^"Hermetic" DEF {
                0 "Same covenant"
                6 "Same Tribunal"
                9 "Entire Order"
            }
        }

        RULES {
            #ARM051eF1gH3iJ5kL7mN9oP: recognition_roll_stress_die_plus_score
        }
    }

    # ===========================
    # SCENE AND TIME STRUCTURE
    # ===========================

    ^"Story" DEF {

        # A story is the Ars Magica equivalent of an adventure or
        # session arc. Stories award experience points and may span
        # one or more play sessions.

        RULES {
            #ARM052qR2sT4uV6wX8yZ0aB: stories_award_experience
        }
    }

    ^"Season" DEF {

        ENUM ["Spring", "Summer", "Autumn", "Winter"]

        # The fundamental unit of long-term time in Ars Magica.
        # Each year has four seasons. Characters perform one major
        # activity per season: laboratory work, study, adventure,
        # teaching, writing, etc. Seasons drive character and
        # covenant advancement.

        RULES {
            #ARM053bC3dE5fG7hI9jK1lM: one_major_activity_per_season
            #ARM054mN4oP6qR8sT0uV2wX: four_seasons_per_year
        }
    }

    ^"Year" DEF {

        # A full year of game time. Contains four seasons.
        # Used for aging rolls (one per year after age 35).
        # The default game year is in the 13th century (Mythic Europe, 1220 AD).

        RULES {
            #ARM055xY5zA7bC9dE1fG3hI: aging_roll_once_per_year_after_35
        }
    }

    # ===========================
    # TROUPE-STYLE PLAY
    # ===========================

    ^"Troupe Style" DEF {

        # Ars Magica's distinctive play structure. Each player has
        # a magus and a companion (and access to grogs). Different
        # sessions feature different combinations of characters.
        # The storyguide role can rotate between players.
        # A player's magus and companion are rarely played together.

        RULES {
            #ARM056iJ6kL8mN0oP2qR4sT: each_player_has_magus_and_companion
            #ARM057uV7wX9yZ1aB3cD5eF: magus_and_companion_rarely_played_together
            #ARM058gH8iJ0kL2mN4oP6qR: storyguide_role_may_rotate
            #ARM059sT9uV1wX3yZ5aB7cD: grogs_shared_between_players
        }
    }

    ^"Storyguide" DEF {

        # The Game Master in Ars Magica. Creates the story framework,
        # portrays NPCs, describes scenes, sets Ease Factors, and
        # arbitrates rules. The storyguide role can rotate between
        # players across different stories.

        RULES {
            #ARM060eF0gH2iJ4kL6mN8oP: storyguide_sets_ease_factors
            #ARM061pQ1rS3tU5vW7xY9zA: storyguide_controls_npcs
            #ARM062aB2cD4eF6gH8iJ0kL: storyguide_role_can_rotate
        }
    }
}
