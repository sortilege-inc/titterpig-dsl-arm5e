BASE "ARM5e_Core_Magic" {
    NAME "Ars Magica 5th Edition Definitive - Hermetic Magic system"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Core Rulebook Chapters VII & VIII: Hermetic Arts, casting totals,
    # spell parameters, Penetration, Magic Resistance, Parma Magica,
    # Lab Total, enchantments, familiars, apprentices, Certamen.

    # ===========================
    # THE HERMETIC ARTS
    # ===========================

    # Arts are divided into 5 Techniques (verbs) and 10 Forms (nouns).
    # Each spell combines one Technique + one Form.
    # Art scores use the pyramid XP scale (same as Abilities but uncapped).
    # Art XP Cost: score x (score+1) / 2 (i.e. 1 XP to score 1, 3 XP to score 2, etc.)

    #ARM300aB2cD4eF6gH8iJ0kL ^"Hermetic Art" DEF {
        APPLIES TO [^"Magus"]

        # All Hermetic Arts share this base structure.
        # Scores start at 0 after Opening the Arts.
        # XP cost: new_score x (new_score + 1) / 2

        PROPERTIES {
            ^"Art Name" STRING REQUIRED
            ^"Abbreviation" STRING
            ^"Art Type" ENUM ["Technique", "Form"]
            ^"Score" INTEGER MIN 0 DEFAULT 0
            ^"Experience Points" INTEGER MIN 0 DEFAULT 0
        }

        RULES {
            #ARM301mN3oP5qR7sT9uV1wX: ART_XP_COST = ^"Score" x (^"Score" + 1) / 2
            #ARM302yZ4aB6cD8eF0gH2iJ: WHEN [^"Experience Points" >= ART_XP_COST for next score] THEN INCREMENT ^"Score"
        }
    }

    # --- TECHNIQUES (5) ---
    # Techniques are the verbs of Hermetic magic.

    #ARM303kL5mN7oP9qR1sT3uV ^"Creo" DEF {
        APPLIES TO [^"Magus"]
        # Cr - "I create"
        # Creates things or makes them better examples of their kind.
        # Includes creation and healing. Natural things created are perfect
        # unless magus intends otherwise. Artificial things require Finesse roll.
        # Magically created things last for spell duration; effects persist.
        PROPERTIES {
            ^"Art Type" ENUM ["Technique"]
            ^"Abbreviation" STRING "Cr"
        }
    }

    #ARM304wX6yZ8aB0cD2eF4gH ^"Intellego" DEF {
        APPLIES TO [^"Magus"]
        # In - "I perceive"
        # Art of perception. Gathers information directly from forms of things.
        # Not deceived by mundane disguises. Provides actual nature, not appearance.
        PROPERTIES {
            ^"Art Type" ENUM ["Technique"]
            ^"Abbreviation" STRING "In"
        }
    }

    #ARM305iJ7kL9mN1oP3qR5sT ^"Muto" DEF {
        APPLIES TO [^"Magus"]
        # Mu - "I transform"
        # Grants or removes properties something cannot naturally have.
        # Changes must be maintained; revert when spell ends.
        # Cannot directly injure or kill, but can kill indirectly.
        PROPERTIES {
            ^"Art Type" ENUM ["Technique"]
            ^"Abbreviation" STRING "Mu"
        }
    }

    #ARM306uV8wX0yZ2aB4cD6eF ^"Perdo" DEF {
        APPLIES TO [^"Magus"]
        # Pe - "I destroy"
        # Makes things worse examples of their kind. Opposite of Creo.
        # Can destroy whole things or aspects of things.
        # Easier if the property can naturally be lost.
        PROPERTIES {
            ^"Art Type" ENUM ["Technique"]
            ^"Abbreviation" STRING "Pe"
        }
    }

    #ARM307gH9iJ1kL3mN5oP7qR ^"Rego" DEF {
        APPLIES TO [^"Magus"]
        # Re - "I control"
        # Changes state of a thing to another state it can naturally have.
        # Includes movement, crafting (with Finesse), natural state changes.
        # Cannot injure directly (that is Perdo).
        PROPERTIES {
            ^"Art Type" ENUM ["Technique"]
            ^"Abbreviation" STRING "Re"
        }
    }

    # --- FORMS (10) ---
    # Forms are the nouns of Hermetic magic.
    # Each Form provides a Form Bonus = Form Score / 5 (rounded up).
    # Form Bonuses do not stack; use only the higher if two apply.

    #ARM308sT0uV2wX4yZ6aB8cD ^"Form Bonus" DEF {
        APPLIES TO [^"Magus"]
        # Form Bonus adds to resistance against related hazards.
        # Calculated as Form Score / 5, rounded up.
        RULES {
            #ARM309eF1gH3iJ5kL7mN9oP: FORM_BONUS = CEILING(^"Form Score" / 5)
            #ARM310pQ2rS4tU6vW8xY0zA: WHEN [multiple Form Bonuses apply] THEN USE highest only
        }
    }

    #ARM311bC3dE5fG7hI9jK1lM ^"Animal" DEF {
        APPLIES TO [^"Magus"]
        # An - "animal"
        # Concerns animals of all kinds. Cannot affect people.
        # Form Bonus: Soak vs animal attacks, rolls to resist animal poisons.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "An"
            ^"Form Bonus Applies" STRING "Soak vs animal attacks; resist animal poisons"
        }
    }

    #ARM312nO4pQ6rS8tU0vW2xY ^"Aquam" DEF {
        APPLIES TO [^"Magus"]
        # Aq - "water"
        # Concerns water and all liquids, and properties of liquidity.
        # Form Bonus: Resist drowning and thirst; soak vs water jets.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Aq"
            ^"Form Bonus Applies" STRING "Resist drowning/thirst; soak vs water jets"
        }
    }

    #ARM313zA5bC7dE9fG1hI3jK ^"Auram" DEF {
        APPLIES TO [^"Magus"]
        # Au - "air"
        # Art of air, wind, and weather. Governs gaseous forms.
        # Form Bonus: Resist suffocation (incl drowning); soak vs weather (lightning).
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Au"
            ^"Form Bonus Applies" STRING "Resist suffocation; soak vs weather phenomena"
        }
    }

    #ARM314lM6nO8pQ0rS2tU4vW ^"Corpus" DEF {
        APPLIES TO [^"Magus"]
        # Co - "body"
        # Art of human bodies, including dead bodies and human-looking
        # magical/faerie creatures. Does not apply to aging rolls.
        # Form Bonus: Soak vs unarmed human attacks; resist disease.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Co"
            ^"Form Bonus Applies" STRING "Soak vs unarmed human attacks; resist disease"
        }
    }

    #ARM315xY7zA9bC1dE3fG5hI ^"Herbam" DEF {
        APPLIES TO [^"Magus"]
        # He - "plant"
        # Concerns plants, trees, and plant matter including dead wood and linen.
        # Form Bonus: Soak vs wooden weapons; resist herbal poisons; resist starvation.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "He"
            ^"Form Bonus Applies" STRING "Soak vs wooden weapons; resist herbal poisons; resist starvation"
        }
    }

    #ARM316jK8lM0nO2pQ4rS6tU ^"Ignem" DEF {
        APPLIES TO [^"Magus"]
        # Ig - "fire"
        # Concerns fire, heat, and light.
        # Form Bonus: Soak vs fire and cold.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Ig"
            ^"Form Bonus Applies" STRING "Soak vs fire and cold"
        }
    }

    #ARM317vW9xY1zA3bC5dE7fG ^"Imaginem" DEF {
        APPLIES TO [^"Magus"]
        # Im - "image"
        # Concerns species (sense impressions). Affects how things appear
        # to the senses. Cannot create actual solidity. Does not change
        # actual effects of objects, only appearance.
        # Form Bonus: Resist confusion/deafening/nausea from senses.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Im"
            ^"Form Bonus Applies" STRING "Resist confusion, deafening, nausea from senses"
        }
    }

    #ARM318hI0jK2lM4nO6pQ8rS ^"Mentem" DEF {
        APPLIES TO [^"Magus"]
        # Me - "mind"
        # Concerns minds, thoughts, and spirits. Can affect "bodies" of
        # noncorporeal beings (ghosts) maintained by spirit's will.
        # Form Bonus: Resist mundane persuasion, deception, temptation.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Me"
            ^"Form Bonus Applies" STRING "Resist mundane persuasion, deception, temptation"
        }
    }

    #ARM319tU1vW3xY5zA7bC9dE ^"Terram" DEF {
        APPLIES TO [^"Magus"]
        # Te - "earth"
        # Concerns solids, especially earth and stone.
        # Form Bonus: Soak vs metal/stone weapons; resist mineral poisons.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Te"
            ^"Form Bonus Applies" STRING "Soak vs metal/stone weapons; resist mineral poisons"
        }
    }

    #ARM320fG2hI4jK6lM8nO0pQ ^"Vim" DEF {
        APPLIES TO [^"Magus"]
        # Vi - "power"
        # Concerns raw magical power. Refines use of magic itself.
        # Also affects magical, infernal, divine, and faerie creatures.
        # Form Bonus: Resist Twilight (not comprehension); soak vs own spell-casting damage.
        PROPERTIES {
            ^"Art Type" ENUM ["Form"]
            ^"Abbreviation" STRING "Vi"
            ^"Form Bonus Applies" STRING "Resist Twilight; soak vs own spell-casting damage"
        }
    }

    # ===========================
    # SPELL PARAMETERS
    # ===========================

    # Every Hermetic spell has a Technique, Form, and Level.
    # Magnitude = Level / 5 (rounded up).
    # Spells also have Range, Duration, and Target.
    # Each step increase in R/D/T adds 1 magnitude (5 levels) to the spell.
    # Below level 5, each magnitude step adds/subtracts only 1 level.

    #ARM321rS3tU5vW7xY9zA1bC ^"Spell Parameters" DEF {
        APPLIES TO [^"Magus"]

        # Range: how far the target can be from the caster
        # Duration: how long the effect lasts
        # Target: what the spell can affect

        PROPERTIES {
            ^"Magnitude" INTEGER  # Level / 5, rounded up
        }

        RULES {
            #ARM322dE4fG6hI8jK0lM2nO: MAGNITUDE = CEILING(^"Spell Level" / 5)
            #ARM323pQ5rS7tU9vW1xY3zA: EACH step increase in Range/Duration/Target ADDS +1 magnitude (+5 levels)
        }
    }

    # --- RANGES ---
    # Additional magnitudes added to base guideline:
    # 0: Personal (caster only, no container targets)
    # +1: Touch / Eye
    # +2: Voice (firm ~15 paces, loud ~50 paces, quiet ~5 paces)
    # +3: Sight (anything the magus can see)
    # +4: Arcane Connection (requires Arcane Connection to target)

    #ARM324bC6dE8fG0hI2jK4lM ^"Range" DEF {
        PROPERTIES {
            ^"Range Level" ENUM ["Personal", "Touch", "Eye", "Voice", "Sight", "Arcane Connection"]
        }
        RULES {
            #ARM325nO7pQ9rS1tU3vW5xY: Personal = +0 mag; Touch/Eye = +1; Voice = +2; Sight = +3; Arcane Connection = +4
        }
    }

    # --- DURATIONS ---
    # 0: Momentary (instant, effects may persist)
    # +1: Concentration / Diameter (2 minutes)
    # +2: Sun (until next sunrise/sunset) / Ring (until ring broken or target leaves)
    # +3: Moon (until new and full moon both set)
    # +4: Year (until 4th equinox/solstice after casting; requires Ritual)

    #ARM326zA8bC0dE2fG4hI6jK ^"Duration" DEF {
        PROPERTIES {
            ^"Duration Level" ENUM ["Momentary", "Concentration", "Diameter", "Sun", "Ring", "Moon", "Year"]
        }
        RULES {
            #ARM327lM9nO1pQ3rS5tU7vW: Momentary = +0; Conc/Diameter = +1; Sun/Ring = +2; Moon = +3; Year = +4
            #ARM328xY0zA2bC4dE6fG8hI: Year duration requires Ritual
            #ARM329jK1lM3nO5pQ7rS9tU: Ritual Creo Momentary creates permanent things (magic gone, cannot be dispelled)
        }
    }

    # --- TARGETS ---
    # Object targets:
    # 0: Individual (one discrete thing; size varies by Form)
    # +1: Part (part of a larger thing)
    # +2: Group (a group of related things, up to 10 Individuals or equivalent mass)
    # Container targets:
    # 0: Circle (everything within a ring drawn at casting; requires Ring duration)
    # +2: Room (everything in a room, up to ~500 sq ft)
    # +3: Structure (everything in a structure)
    # +4: Boundary (everything within a natural or man-made boundary, up to ~100 paces; requires Ritual)

    #ARM330vW2xY4zA6bC8dE0fG ^"Target" DEF {
        PROPERTIES {
            ^"Target Level" ENUM ["Individual", "Part", "Group", "Circle", "Room", "Structure", "Boundary"]
        }
        RULES {
            #ARM331hI3jK5lM7nO9pQ1rS: Individual = +0; Part = +1; Group = +2; Room = +2; Structure = +3; Boundary = +4
            #ARM332tU4vW6xY8zA0bC2dE: Boundary requires Ritual
            #ARM333fG5hI7jK9lM1nO3pQ: Circle target requires Ring duration
            #ARM334rS6tU8vW0xY2zA4bC: Each additional magnitude of size doubles the mass/number affected
        }
    }

    # ===========================
    # CASTING TOTALS
    # ===========================

    #ARM335dE7fG9hI1jK3lM5nO ^"Casting Score" DEF {
        APPLIES TO [^"Magus"]

        # Base Casting Score used for all spell types:
        # Technique + Form + Stamina - Encumbrance + Aura Modifier

        RULES {
            #ARM336pQ8rS0tU2vW4xY6zA: CASTING_SCORE = ^"Technique" + ^"Form" + ^"Stamina" - ^"Encumbrance" + ^"Aura Modifier"
        }
    }

    #ARM337bC9dE1fG3hI5jK7lM ^"Formulaic Casting" DEF {
        APPLIES TO [^"Magus"]

        # Formulaic Casting Total = Casting Score + Die Roll
        # Simple die if relaxed; Stress die if under pressure.
        # Mastered spells: always stress die, but 0 botch dice if relaxed.
        #
        # Result Table (Casting Total - Spell Level):
        #   0 or higher: spell cast, 0 fatigue lost
        #   -1 to -10:   spell cast, 1 fatigue level lost
        #   -11 or lower: spell fails, 1 fatigue level lost

        RULES {
            #ARM338nO0pQ2rS4tU6vW8xY: FORMULAIC_CASTING_TOTAL = CASTING_SCORE + DIE_ROLL
            #ARM339zA1bC3dE5fG7hI9jK: IF (CASTING_TOTAL - SPELL_LEVEL >= 0) THEN cast, 0 fatigue
            #ARM340lM2nO4pQ6rS8tU0vW: IF (CASTING_TOTAL - SPELL_LEVEL >= -10) THEN cast, 1 fatigue
            #ARM341xY3zA5bC7dE9fG1hI: IF (CASTING_TOTAL - SPELL_LEVEL < -10) THEN fail, 1 fatigue
        }
    }

    #ARM342jK4lM6nO8pQ0rS2tU ^"Ritual Casting" DEF {
        APPLIES TO [^"Magus"]

        # Ritual Casting Total = Casting Score + Artes Liberales + Philosophiae + Stress Die
        # Always uses stress die (botch possible). 15 min per magnitude to cast.
        # Requires 1 pawn of vis per magnitude (matching Tech or Form).
        # Max pawns of a given type = magus's score in that Art.
        #
        # Result Table (Casting Total - Spell Level):
        #   0+: cast, 1 fatigue (long-term)
        #   -1 to -5: cast, 2 fatigue
        #   -6 to -10: cast, 3 fatigue
        #   -11 to -15: fail, 4 fatigue
        #   -16 or more: fail, 5 fatigue
        # Excess fatigue beyond remaining levels becomes wounds.

        RULES {
            #ARM343vW5xY7zA9bC1dE3fG: RITUAL_CASTING_TOTAL = CASTING_SCORE + ^"Artes Liberales" + ^"Philosophiae" + STRESS_DIE
            #ARM344hI6jK8lM0nO2pQ4rS: RITUAL_VIS_COST = 1 pawn per magnitude; matching Technique or Form
            #ARM345tU7vW9xY1zA3bC5dE: RITUAL_CASTING_TIME = 15 minutes per magnitude
            #ARM346fG8hI0jK2lM4nO6pQ: MAX_VIS_PER_ART = magus score in that Art
        }
    }

    #ARM347rS9tU1vW3xY5zA7bC ^"Spontaneous Casting" DEF {
        APPLIES TO [^"Magus"]

        # Fatiguing: (Casting Score + Stress Die) / 2
        #   Always stress die, always risk of botch. Loses 1 fatigue level.
        # Non-Fatiguing: Casting Score / 5
        #   No die roll, no fatigue cost.
        # Maga decides effect before casting. If total too low, spell fails.
        # Excess total can be used for higher R/D/T or better Penetration.

        RULES {
            #ARM348dE0fG2hI4jK6lM8nO: FATIGUING_SPONTANEOUS = (CASTING_SCORE + STRESS_DIE) / 2
            #ARM349pQ1rS3tU5vW7xY9zA: NON_FATIGUING_SPONTANEOUS = CASTING_SCORE / 5
            #ARM350bC2dE4fG6hI8jK0lM: Fatiguing spontaneous always uses stress die with botch risk
        }
    }

    # ===========================
    # WORDS AND GESTURES
    # ===========================

    #ARM351nO3pQ5rS7tU9vW1xY ^"Words and Gestures" DEF {
        APPLIES TO [^"Magus"]

        # Modifiers to Casting Score based on voice and gesture used.
        # Words: Loud +1, Firm +0, Quiet -5, None -10
        # Gestures: Exaggerated +1, Bold +0, Subtle -2, None -5
        # Voice Range spells: Loud ~50 paces, Firm ~15, Quiet ~5, None = caster only
        # Ritual and Ceremonial spells require loud voice and exaggerated gestures.

        RULES {
            #ARM352zA4bC6dE8fG0hI2jK: WORDS_MODIFIER: Loud +1, Firm 0, Quiet -5, None -10
            #ARM353lM5nO7pQ9rS1tU3vW: GESTURES_MODIFIER: Exaggerated +1, Bold 0, Subtle -2, None -5
        }
    }

    # ===========================
    # PENETRATION
    # ===========================

    #ARM354xY6zA8bC0dE2fG4hI ^"Penetration" DEF {
        APPLIES TO [^"Magus"]

        # Penetration Total = Casting Total + Penetration Bonus - Spell Level
        # Penetration Bonus = Penetration Ability x Multiplier
        # Base multiplier = 1. Arcane Connection adds to multiplier:
        #   Hours/Days: +1
        #   Weeks/Months: +2
        #   Years/Decades: +3
        #   Indefinite: +4
        # Sympathetic Connections add further to multiplier (max +2 each):
        #   Blood relative: +1, Signature: +1, Nickname/birth name: +1,
        #   Secret name: +1, Today's horoscope: +1, Nativity horoscope: +2,
        #   Symbolic representation: +2
        # If Penetration Total > target's Magic Resistance, spell affects target.
        # Penetration <= 0 means spell cannot affect anyone with MR (even MR 0).

        RULES {
            #ARM355jK7lM9nO1pQ3rS5tU: PENETRATION_TOTAL = CASTING_TOTAL + PENETRATION_BONUS - SPELL_LEVEL
            #ARM356vW8xY0zA2bC4dE6fG: PENETRATION_BONUS = ^"Penetration Ability" x MULTIPLIER
            #ARM357hI9jK1lM3nO5pQ7rS: BASE_MULTIPLIER = 1; add AC bonus and sympathetic bonuses
            #ARM358tU0vW2xY4zA6bC8dE: WHEN [Penetration Total > target MR] THEN spell affects target
        }
    }

    #ARM359fG1hI3jK5lM7nO9pQ ^"Forceless Casting" DEF {
        APPLIES TO [^"Magus"]

        # Maga can deliberately limit Penetration Total to 0.
        # Ensures spell cannot affect anyone with Magic Resistance.
        # Useful in tournaments or when avoiding friendly fire.
        # No special skill required.

        RULES {
            #ARM360rS2tU4vW6xY8zA0bC: WHEN [forceless casting chosen] THEN PENETRATION_TOTAL = 0
        }
    }

    # ===========================
    # MAGIC RESISTANCE
    # ===========================

    #ARM361dE3fG5hI7jK9lM1nO ^"Magic Resistance" DEF {
        APPLIES TO [^"Magus", ^"Creature"]

        # Most humans have no Magic Resistance.
        # Hermetic magi: base MR = Form score most applicable to the spell.
        # Creatures with Might: MR = Might score.
        # MR 0 is substantially better than no MR (requires Penetration >= 1).
        # MR keeps magic away from the maga; it does not dispel magic.
        # Personal Range spells bypass caster's own MR.
        # Other Range spells on self must overcome caster's MR.

        RULES {
            #ARM362pQ4rS6tU8vW0xY2zA: MAGI_BASE_MR = applicable Form score (default Vim)
            #ARM363bC5dE7fG9hI1jK3lM: CREATURE_MR = ^"Might" score
            #ARM364nO6pQ8rS0tU2vW4xY: MR keeps magic away; does not dispel
            #ARM365zA7bC9dE1fG3hI5jK: Personal Range spells bypass own MR
        }
    }

    #ARM366lM8nO0pQ2rS4tU6vW ^"Parma Magica" DEF {
        APPLIES TO [^"Magus"]

        # Parma Magica adds MR = 5 x Parma Magica score, stacking with Form scores.
        # Total Magic Resistance = (Parma Magica x 5) + applicable Form score
        # Takes 2 minutes to perform the ritual; lasts until next sunrise/sunset.
        # Can be suppressed by concentrating (drops ALL resistance incl Form).
        # Unconscious magus cannot suppress Parma; has full MR.
        # Can extend Parma to protect others (1 person per Parma score, requires touch).
        # Sharing reduces effective Parma by 3 (min 0), for all protected characters.
        # Parma blocks effects of The Gift between magi.

        PROPERTIES {
            ^"Parma Magica Score" INTEGER MIN 0 DEFAULT 0
        }

        RULES {
            #ARM367xY9zA1bC3dE5fG7hI: TOTAL_MR = (^"Parma Magica Score" x 5) + ^"Form Score"
            #ARM368jK0lM2nO4pQ6rS8tU: Parma ritual takes 2 minutes; lasts until sunrise/sunset
            #ARM369vW1xY3zA5bC7dE9fG: Can protect 1 other per Parma score (touch, line of sight)
            #ARM370hI2jK4lM6nO8pQ0rS: Sharing Parma: effective score reduced by 3 (min 0)
            #ARM371tU3vW5xY7zA9bC1dE: Parma blocks social effects of The Gift between magi
        }
    }

    # ===========================
    # ARCANE CONNECTIONS
    # ===========================

    #ARM372fG4hI6jK8lM0nO2pQ ^"Arcane Connection" DEF {
        APPLIES TO [^"Magus"]

        # An Arcane Connection allows casting spells on unsensed targets
        # (requires Range: Arcane Connection). Duration of the connection
        # depends on its nature:
        #   Hours: air from a place, shed skin
        #   Days: frequently used tool, excrement
        #   Weeks: lesser enchanted device, personally made item, letter
        #   Months: strand of hair, favorite tool, wood shard, feather
        #   Years: invested device, rock/metal from a place, blood, lock of hair
        #   Decades: body part
        #   Indefinite: Hermetic familiar, talisman, fixed Arcane Connections

        PROPERTIES {
            ^"Connection Duration" ENUM ["Hours", "Days", "Weeks", "Months", "Years", "Decades", "Indefinite"]
        }

        RULES {
            #ARM373rS5tU7vW9xY1zA3bC: Arcane Connections must be stored carefully or they link to different targets
            #ARM374dE6fG8hI0jK2lM4nO: Arcane Connection can be fixed permanently in the laboratory
        }
    }

    # ===========================
    # RAW VIS
    # ===========================

    #ARM375pQ7rS9tU1vW3xY5zA ^"Raw Vis" DEF {
        APPLIES TO [^"Magus", ^"Covenant"]

        # Raw vis = stored magical power in physical substance.
        # Always associated with one Technique or Form.
        # Substance matches the Art (e.g., Animal vis in blood/skins/horns).
        # When used, vis is permanently consumed and substance often degrades.
        # Measured in pawns. 10 pawns = 1 rook, 10 rooks = 1 queen.
        # Uses: boost spells (+2 casting score per pawn), Ritual requirements,
        #   enchantments, study source for Arts.
        # Vis boost adds botch dice (+1 per pawn used, on stress die zero).
        # Max pawns of a type usable = magus's score in that Art.

        PROPERTIES {
            ^"Art Alignment" STRING REQUIRED  # Which Art the vis corresponds to
            ^"Pawns" INTEGER MIN 0
        }

        RULES {
            #ARM376bC8dE0fG2hI4jK6lM: VIS_BOOST = +2 Casting Score per pawn used
            #ARM377nO9pQ1rS3tU5vW7xY: VIS_BOTCH_DICE = +1 per pawn used (on stress die zero)
            #ARM378zA0bC2dE4fG6hI8jK: MAX_VIS_USE = magus score in Art of the vis
        }
    }

    # ===========================
    # SPELL MASTERY
    # ===========================

    #ARM379lM1nO3pQ5rS7tU9vW ^"Spell Mastery" DEF {
        APPLIES TO [^"Magus"]

        # Each Formulaic/Ritual spell has a Mastery Ability.
        # Score >= 1 means the spell is "mastered."
        # Mastery score adds to Casting Score for that spell.
        # Mastery score subtracts from botch dice (can reach 0 botch dice).
        # Mastered spells always use stress die, but 0 botch dice if relaxed
        # (even in non-Magic aura, with vis, or Ritual).
        # Each Mastery level grants one Special Ability:

        PROPERTIES {
            ^"Mastery Score" INTEGER MIN 0 DEFAULT 0
            ^"Special Abilities" LIST  # one chosen per Mastery level
        }

        RULES {
            #ARM380xY2zA4bC6dE8fG0hI: MASTERY adds to Casting Score and subtracts from botch dice
        }
    }

    # Spell Mastery Special Abilities:

    #ARM381jK3lM5nO7pQ9rS1tU ^"Mastery Special Abilities" DEF {
        # Available special abilities (one per Mastery level):
        # - Adaptive Casting: use mastery on similar spells
        # - Ceremonial Casting: apply ceremonial casting rules (not for Rituals)
        # - Fast Casting: fast-cast the mastered Formulaic spell (not for Rituals)
        # - Imperturbable Casting: add Mastery to Concentration rolls for the spell
        # - Magic Resistance: double MR vs this spell and similar spells/powers
        # - Multiple Casting: cast up to (Mastery score) additional copies simultaneously
        # - Obfuscated Casting: opponents must roll to identify Form (+Mastery to EF)
        # - Penetration: add Mastery to Penetration Ability for this spell
        # - Precise Casting: +1 Finesse/aiming rolls; -1 botch die on Finesse
        # - Quick Casting: +1 Initiative when casting this spell; +1 Fast Casting Speed
        # - Quiet Casting: reduce quiet casting penalty by 5 (take twice for silent)
        # - Rebuttal: +3x Mastery to effective Vim spell level (MuVi/ReVi vs foreign magic)
        # - Still Casting: cast without gestures at no penalty
        # - Unravelling: +3x Mastery to effective PeVi spell level for destroying magic

        PROPERTIES {
            ^"Ability Name" STRING REQUIRED
        }
    }

    # ===========================
    # FAST CASTING
    # ===========================

    #ARM382vW4xY6zA8bC0dE2fG ^"Fast Casting" DEF {
        APPLIES TO [^"Magus"]

        # Fast-cast Spontaneous spell as response to attack/surprise.
        # Fast Casting Speed = Quickness + Finesse + Stress Die
        # EF in combat = opponent's Initiative Total.
        # Cumulative -6 per additional fast-cast spell in same round.
        # If speed check fails, can still cast spell but too late for intended effect.
        # Casting Score penalty: -10
        # Extra botch dice: +2
        # Defense: half attacking spell level protects caster; matching level neutralizes.
        # Determining Form of foreign spell: Per + Awareness vs 15 - magnitude.

        RULES {
            #ARM383hI5jK7lM9nO1pQ3rS: FAST_CASTING_SPEED = ^"Quickness" + ^"Finesse" + STRESS_DIE
            #ARM384tU6vW8xY0zA2bC4dE: FAST_CAST_PENALTY = -10 to Casting Score
            #ARM385fG7hI9jK1lM3nO5pQ: FAST_CAST_BOTCH = +2 botch dice
            #ARM386rS8tU0vW2xY4zA6bC: CUMULATIVE_PENALTY = -6 per additional fast-cast spell
        }
    }

    # ===========================
    # CEREMONIAL CASTING
    # ===========================

    #ARM387dE9fG1hI3jK5lM7nO ^"Ceremonial Casting" DEF {
        APPLIES TO [^"Magus"]

        # Adds Artes Liberales + Philosophiae to Casting Score for Spontaneous spells.
        # Takes 15 minutes per magnitude.
        # Max spell level limited by time spent (1 magnitude per 15 minutes).
        # Requires at least 1 XP in one of the two Abilities.
        # Props add bonus: +1 (tiny) to +5 (room-sized immovable).
        # Prepared space reduces casting time (3 min/mag in lab, 1 min/mag in dedicated room).

        RULES {
            #ARM388pQ0rS2tU4vW6xY8zA: CEREMONIAL_BONUS = ^"Artes Liberales" + ^"Philosophiae" added to Casting Score
            #ARM389bC1dE3fG5hI7jK9lM: CEREMONIAL_TIME = 15 minutes per magnitude (base)
        }
    }

    # ===========================
    # CONCENTRATION
    # ===========================

    #ARM390nO2pQ4rS6tU8vW0xY ^"Concentration (Spellcasting)" DEF {
        APPLIES TO [^"Magus"]

        # Concentration Roll = Stamina + Concentration + Stress Die
        # Required when distracted during casting or maintaining a spell.
        # Casting distractions EF: Still 0, Walking 3, Running 9, Dodging 12,
        #   Jostled 9, Sudden noise 9, Knocked down 12, Damaged this round 15.
        # Maintaining spell: EFs reduced by 3.
        # Maintaining while doing other things: Answering question 12,
        #   Conversation 15, Casting another spell 15,
        #   Maintaining another spell 12 (+3 per spell beyond 2nd),
        #   Injured: 3x wound penalty replaces normal penalty.
        # Undistracted maintenance: 15 minutes per Concentration Ability point.

        RULES {
            #ARM391zA3bC5dE7fG9hI1jK: CONCENTRATION_ROLL = ^"Stamina" + ^"Concentration" + STRESS_DIE
        }
    }

    # ===========================
    # AIMING
    # ===========================

    #ARM392lM4nO6pQ8rS0tU2vW ^"Aiming" DEF {
        APPLIES TO [^"Magus"]

        # Used when spell indirectly targets someone (bypasses MR).
        # Aiming Roll = Perception + Finesse + Die (stress if under stress)
        # Treated as attack total; damage = stress die + spell damage bonus vs Soak.
        # +6 aiming bonus per magnitude above base Individual size.

        RULES {
            #ARM393xY5zA7bC9dE1fG3hI: AIMING_ROLL = ^"Perception" + ^"Finesse" + DIE
        }
    }

    # ===========================
    # LIMITS OF MAGIC
    # ===========================

    #ARM394jK6lM8nO0pQ2rS4tU ^"Limits of Magic" DEF {
        APPLIES TO [^"Magus"]

        # Two Fundamental Limits:
        # - Limit of the Divine: Hermetic magic cannot affect the Divine
        # - Limit of Essential Nature: changes violating essential nature must be maintained
        #
        # Lesser Limits (derived from the two above, or possibly flaws in theory):
        # - Limit of Aging: cannot halt/reverse natural aging (can slow)
        # - Limit of Arcane Connections: cannot affect unsensed target without AC
        # - Limit of Creation: Creo cannot create permanently without vis
        # - Limit of Energy: cannot restore Fatigue or Confidence
        # - Limit of Experience: cannot create or transfer Abilities magically
        # - Limit of the Infernal: Intellego useless against Infernal (reveals only what demons want)
        # - Limit of the Lunar Sphere: cannot affect the lunar sphere or above
        # - Limit of the Soul: cannot create immortal soul; no true human creation/resurrection
        # - Limit of Time: cannot alter time, scry past/future
        # - Limit of True Feeling: some loves/friendships/faiths immune to magic
        # - Limit of Vis: cannot change Art attunement of vis
        # - Limit of Warping: cannot affect warping changes once occurred
        # - Limit of Magic Resistance: non-Hermetic magic cannot grant general MR

        RULES {
            #ARM395vW7xY9zA1bC3dE5fG: FUNDAMENTAL: Limit of the Divine and Limit of Essential Nature
            #ARM396hI8jK0lM2nO4pQ6rS: LESSER limits constrain specific uses of Hermetic magic
        }
    }

    # ===========================
    # WIZARD'S SIGIL
    # ===========================

    #ARM397tU9vW1xY3zA5bC7dE ^"Wizard's Sigil" DEF {
        APPLIES TO [^"Magus"]

        # Every magus has a unique casting sigil - a signature in all spells cast.
        # May affect environment, caster, or spell products.
        # Never requires requisites; should not be useful or impose major problems.
        # Can be used by investigators to identify who cast a spell.
        # Voting sigil: separate physical object used at Tribunal.

        PROPERTIES {
            ^"Casting Sigil Description" STRING
        }
    }

    # ===========================
    # CERTAMEN
    # ===========================

    #ARM398fG0hI2jK4lM6nO8pQ ^"Certamen" DEF {
        APPLIES TO [^"Magus"]

        # Formal magical duel between two magi. Non-lethal.
        # Aggressor picks Technique, defender picks Form (each may veto once).
        # Combatants enter trance; no defense vs physical attacks while in certamen.
        #
        # Initiative Total: Quickness + Finesse + Stress Die (rolled once)
        # Attack Total: Presence + (Technique or Form) + Stress Die
        # Defense Total: Perception + (Form or Technique) + Stress Die
        # Attack Advantage: Attack Total - Defense Total (if attack higher)
        # Weakening Total: Intelligence + Penetration + Attack Advantage
        # Resistance Total: Stamina + Parma Magica (score, not x5)
        #
        # Fatigue lost = (Weakening Total - Resistance Total) / 5, rounded up
        # Each magus uses one Art for attack, other for defense (may switch each round).
        # Duel ends when one magus falls unconscious from fatigue loss.
        # Results are binding. Cannot override Tribunal or require Code violations.
        # Bullying with certamen is a Low Crime.

        RULES {
            #ARM399rS1tU3vW5xY7zA9bC: CERTAMEN_INIT = ^"Quickness" + ^"Finesse" + STRESS_DIE
            #ARM3A0dE2fG4hI6jK8lM0nO: CERTAMEN_ATTACK = ^"Presence" + ART_SCORE + STRESS_DIE
            #ARM3A1pQ3rS5tU7vW9xY1zA: CERTAMEN_DEFENSE = ^"Perception" + ART_SCORE + STRESS_DIE
            #ARM3A2bC4dE6fG8hI0jK2lM: WEAKENING = ^"Intelligence" + ^"Penetration" + ATTACK_ADVANTAGE
            #ARM3A3nO5pQ7rS9tU1vW3xY: RESISTANCE = ^"Stamina" + ^"Parma Magica" (score)
            #ARM3A4zA6bC8dE0fG2hI4jK: FATIGUE_LOSS = CEILING((WEAKENING - RESISTANCE) / 5)
        }
    }

    # ===========================
    # LABORATORY TOTAL
    # ===========================

    #ARM3A5lM7nO9pQ1rS3tU5vW ^"Lab Total" DEF {
        APPLIES TO [^"Magus"]

        # Lab Total = Technique + Form + Intelligence + Magic Theory
        #   + Aura Modifier + Similar Spell Bonus + Shape & Material Bonus
        #   + Lab Assistant bonus + Specialization bonuses
        # Lab activities: inventing spells, enchanting items, longevity rituals,
        #   binding familiars, opening Arts, studying vis, etc.
        # Max vis usage per season: Magic Theory x 2 pawns.
        # Similar Spell Bonus = magnitude of highest-level similar spell known.
        # Missing 11+ days: -10 penalty, -2 per extra day (max -30 at 20 days).
        # Missing 20+ days: no lab activity possible that season.

        RULES {
            #ARM3A6xY8zA0bC2dE4fG6hI: LAB_TOTAL = ^"Technique" + ^"Form" + ^"Intelligence" + ^"Magic Theory" + ^"Aura Modifier"
            #ARM3A7jK9lM1nO3pQ5rS7tU: MAX_VIS_PER_SEASON = ^"Magic Theory" x 2
            #ARM3A8vW0xY2zA4bC6dE8fG: SIMILAR_SPELL_BONUS = magnitude of highest similar spell known
        }
    }

    # ===========================
    # INVENTING SPELLS
    # ===========================

    #ARM3A9hI1jK3lM5nO7pQ9rS ^"Inventing Spells" DEF {
        APPLIES TO [^"Magus"]

        # Accumulate points per season = Lab Total - Spell Level.
        # When accumulated points = Spell Level, spell is invented.
        # From Laboratory Text: invented in 1 season if Lab Total >= Spell Level.
        # From a Teacher: max total levels = teacher's highest Lab Total;
        #   max per TeFo = teacher's Lab Total in that combo;
        #   max individual spell level = student's Lab Total in that TeFo.

        RULES {
            #ARM3B0tU2vW4xY6zA8bC0dE: POINTS_PER_SEASON = LAB_TOTAL - SPELL_LEVEL
            #ARM3B1fG3hI5jK7lM9nO1pQ: WHEN [accumulated points >= SPELL_LEVEL] THEN spell is invented
            #ARM3B2rS4tU6vW8xY0zA2bC: FROM_LAB_TEXT: 1 season if Lab Total >= Spell Level
        }
    }

    # ===========================
    # ENCHANTMENTS
    # ===========================

    #ARM3B3dE5fG7hI9jK1lM3nO ^"Enchantment" DEF {
        APPLIES TO [^"Magus"]

        # Three types: Invested Items, Lesser Enchantments, Charged Items.
        #
        # INVESTED ITEMS:
        #   Must be opened first (1 season, Vim vis = Material x Size from table).
        #   Can hold multiple effects. Vis capacity = pawns spent to open.
        #   Points per season toward effect = Lab Total - modified effect level.
        #   Vis cost per effect = 1 pawn per 10 levels (rounded up).
        #
        # LESSER ENCHANTMENTS:
        #   No opening required. One effect only. Must complete in 1 season
        #   (Lab Total >= 2 x effect level). Vis cost = 1 pawn per 10 levels.
        #
        # CHARGED ITEMS:
        #   No vis cost. One season. Charges = (Lab Total - effect level) / 5 + 1.
        #   Run out when charges expended.
        #
        # Effect Modifications:
        #   Penetration: +1 level per +2 Penetration
        #   Concentration (device maintains): +5 levels
        #   Restricted Use: +3 levels
        #   Environmental Trigger: +3 levels
        #   Fast Trigger (+3 Init): +5 levels
        #   Linked Trigger: +3 levels to triggered effect
        #
        # Uses per day: 1/+0, 2/+1, 3/+2, 6/+3, 12/+4, 24/+5, 50/+6, unlimited/+10
        #
        # Constant Effect: Sun duration + 2 uses/day + Environmental Trigger

        PROPERTIES {
            ^"Item Type" ENUM ["Invested", "Lesser Enchantment", "Charged Item"]
        }

        RULES {
            #ARM3B4pQ6rS8tU0vW2xY4zA: INVESTED_OPENING_VIS = Material_Base x Size_Multiplier (Vim vis)
            #ARM3B5bC7dE9fG1hI3jK5lM: INVESTED_EFFECT_PROGRESS = LAB_TOTAL - MODIFIED_EFFECT_LEVEL per season
            #ARM3B6nO8pQ0rS2tU4vW6xY: LESSER_ENCHANT_REQUIRES = Lab Total >= 2 x modified effect level
            #ARM3B7zA9bC1dE3fG5hI7jK: CHARGED_ITEM_CHARGES = (Lab Total - effect level) / 5, minimum 1
        }
    }

    #ARM3B8lM0nO2pQ4rS6tU8vW ^"Material and Size" DEF {
        # Material Base Points:
        #   Cloth/Glass: 1, Wood/Leather: 2, Bone/Soft Stone: 3,
        #   Hard Stone: 4, Base Metal: 5, Silver: 6, Gold: 10,
        #   Semi-Precious Gem: 12, Precious Gem: 15, Priceless Gem: 20
        # Size Multiplier:
        #   Tiny (ring, pendant, gem): x1
        #   Small (wand, dagger, belt, cap): x2
        #   Medium (sword, tunic, boots, skull): x3
        #   Large (staff, shield, cloak, skeleton): x4
        #   Huge (boat, wagon, human body, small room): x5
        # Total = Base x Multiplier = pawns of Vim vis to open

        PROPERTIES {
            ^"Material Base" INTEGER
            ^"Size Multiplier" INTEGER
        }
    }

    # ===========================
    # TALISMAN
    # ===========================

    #ARM3B9xY1zA3bC5dE7fG9hI ^"Talisman" DEF {
        APPLIES TO [^"Magus"]

        # A personal invested device intimately tied to the magus.
        # Must have been opened for enchantment by the magus personally.
        # Attuning takes 1 season (any Lab Total). Only one at a time.
        # Benefits:
        #   - Counts as part of magus when touching (Personal range works both ways)
        #   - Magus always has Arcane Connection to talisman
        #   - Talisman receives Form-based MR even when not touching
        #   - Capacity = highest Technique + highest Form (can be opened incrementally)
        #   - +5 Lab Total bonus when instilling effects
        #   - Only creating magus can instill effects
        # Attunements: one Shape/Material bonus opened per season of work.
        #   Applies to Casting Score (not lab work). Only highest bonus applies.

        RULES {
            #ARM3C0jK2lM4nO6pQ8rS0tU: TALISMAN_CAPACITY = highest Technique + highest Form
            #ARM3C1vW3xY5zA7bC9dE1fG: TALISMAN_LAB_BONUS = +5 to Lab Total for instilling effects
            #ARM3C2hI4jK6lM8nO0pQ2rS: One attunement (Shape/Material bonus) per season of work on talisman
        }
    }

    # ===========================
    # FAMILIARS
    # ===========================

    #ARM3C3tU5vW7xY9zA1bC3dE ^"Familiar" DEF {
        APPLIES TO [^"Magus"]

        # A magical animal befriended and bonded by the magus.
        # Must be a beast with Magic Might. Must be genuinely befriended (no coercion).
        #
        # Bonding Lab Total: any appropriate Technique + Form + Int + Magic Theory + Aura
        # Bonding Level: familiar's Magic Might + 25 + (5 x Size)
        # Lab Total must >= Bonding Level to bond in 1 season.
        # Vis cost: 1 pawn per 5 levels (or fraction) of Lab Total.
        #
        # Three Cords (strength 0-5, bought with Lab Total points):
        #   Cost: 0/free, +1/5pts, +2/15pts, +3/30pts, +4/50pts, +5/75pts
        #   Golden Cord: subtract from botch dice on magical activities
        #   Silver Cord: bonus to Personality Trait rolls and mental resistance
        #   Bronze Cord: bonus to Soak, healing, deprivation resistance, aging rolls
        #
        # Bound familiar benefits:
        #   - Both gain True Friend Virtue (to each other)
        #   - Familiar doesn't age naturally while magus lives
        #   - Gains human intelligence (Int -3 if not already intelligent)
        #   - Learns magus's languages
        #   - Each is Arcane Connection to the other
        #   - Neither needs to overcome other's MR
        #   - Familiar uses better of its MR or magus's Form resistance (no stack with Parma)
        #   - Can learn Abilities (incl Magic Theory, can assist in lab without Gift)
        #
        # Powers can be invested in the bond (lab activity like invested device):
        #   - No limit on number of powers
        #   - +5 Lab Total if effect matches Technique or Form used to bind; +10 if both
        #   - Powers limited to effects targeting magus, familiar, or both
        #   - Powers in bond do not cause Warping as constant effect

        RULES {
            #ARM3C4fG6hI8jK0lM2nO4pQ: FAMILIAR_BONDING_TOTAL = Tech + Form + Int + Magic Theory + Aura
            #ARM3C5rS7tU9vW1xY3zA5bC: FAMILIAR_BONDING_LEVEL = Might + 25 + (5 x Size)
            #ARM3C6dE8fG0hI2jK4lM6nO: FAMILIAR_VIS_COST = 1 pawn per 5 levels of Lab Total (rounded up)
        }
    }

    # ===========================
    # LONGEVITY RITUAL
    # ===========================

    #ARM3C7pQ9rS1tU3vW5xY7zA ^"Longevity Ritual" DEF {
        APPLIES TO [^"Magus"]

        # Created in the laboratory using Creo Corpus Lab Total.
        # Bonus: +1 to aging rolls per 5 points of CrCo Lab Total.
        # Vis cost: 1 pawn per 5 years of age (rounded up). Creo/Corpus/Vim vis normally.
        # Extra vis can boost Lab Total (+1 per extra pawn).
        # Takes 1 season; subject must be present.
        # Causes permanent sterility.
        # Lasts until aging crisis; then must be re-performed (vis only, no extra season).
        # Can be created for others:
        #   CrCo Lab Total >= 30 required for others.
        #   For mundane: -1 per 10 points of Lab Total (instead of per 5).

        RULES {
            #ARM3C8bC0dE2fG4hI6jK8lM: LONGEVITY_BONUS = +1 per 5 points of CrCo Lab Total (rounded up)
            #ARM3C9nO1pQ3rS5tU7vW9xY: LONGEVITY_VIS = 1 pawn per 5 years of current age (rounded up)
            #ARM3D0zA2bC4dE6fG8hI0jK: Causes permanent sterility
            #ARM3D1lM3nO5pQ7rS9tU1vW: Lasts until aging crisis, then re-perform with vis only
        }
    }

    # ===========================
    # APPRENTICES
    # ===========================

    #ARM3D2xY4zA6bC8dE0fG2hI ^"Apprentice" DEF {
        APPLIES TO [^"Magus"]

        # Finding: Per + stress die >= 9 per season searching.
        # Must have The Gift. Typically 7-20 years old.
        # Opening the Arts: 1 season; apprentice gains score 0 in all 15 Arts.
        #   If parens has < 5 in any Art, apprentice gets Deficiency (Low Crime).
        #   If apprentice has Supernatural Abilities: InVi Lab Total >= 5 x ability scores
        #   (min 10 for Minor Virtue, 30 for Major). Double to preserve the ability.
        # Training: at least 1 season/year direct teaching over ~15 year apprenticeship.
        # Apprentice serves as lab assistant when not being taught.
        # Parens must extend Parma to apprentice during training.
        # House Bonisagus may claim any apprentice.

        RULES {
            #ARM3D3jK5lM7nO9pQ1rS3tU: FIND_APPRENTICE = ^"Perception" + STRESS_DIE >= 9
            #ARM3D4vW6xY8zA0bC2dE4fG: OPEN_ARTS_DEFICIENCY = IF parens Art < 5 THEN apprentice gains Deficiency
            #ARM3D5hI7jK9lM1nO3pQ5rS: OPEN_ARTS_SUPERNATURAL = InVi Lab Total >= 5 x total supernatural scores
        }
    }

    # ===========================
    # LABORATORY TEXTS
    # ===========================

    #ARM3D6tU8vW0xY2zA4bC6dE ^"Laboratory Text" DEF {
        APPLIES TO [^"Magus"]

        # Created automatically with each lab activity.
        # Personal abbreviations; must be rewritten for others to use.
        # Writing: Latin x 20 levels per season.
        # Copying (already accessible): Profession Scribe x 60 levels per season.
        # Using: reproduce effect in 1 season if Lab Total >= effect level.
        #   Multiple same-TeFo effects: total levels <= Lab Total.
        # Cannot experiment while using Lab Text.
        # Casting Tablets: variant for spells; can cast without knowing spell.
        #   Only mastered spells can be authored as tablets.
        #   Uses different fatigue/warping table.

        RULES {
            #ARM3D7fG9hI1jK3lM5nO7pQ: WRITING_SPEED = ^"Latin" x 20 levels per season
            #ARM3D8rS0tU2vW4xY6zA8bC: COPYING_SPEED = ^"Profession: Scribe" x 60 levels per season
            #ARM3D9dE1fG3hI5jK7lM9nO: USE_LAB_TEXT = reproduce in 1 season if Lab Total >= level
        }
    }

    # ===========================
    # HELP IN THE LABORATORY
    # ===========================

    #ARM3E0pQ2rS4tU6vW8xY0zA ^"Lab Assistant" DEF {
        APPLIES TO [^"Magus"]

        # Any Gifted character with Magic Theory >= 1 can assist.
        # Adds assistant's Intelligence + Magic Theory to Lab Total.
        # Assistant's relevant Virtues/Flaws also apply.
        # Max assistants = magus's Leadership score (minimum 1).
        # Familiar with Magic Theory can always assist (extra slot if Leadership >= 2).
        # Assistants gain exposure XP (typically Magic Theory).
        # Being an assistant implies the primary researcher is superior.

        RULES {
            #ARM3E1bC3dE5fG7hI9jK1lM: ASSISTANT_BONUS = assistant's ^"Intelligence" + ^"Magic Theory"
            #ARM3E2nO4pQ6rS8tU0vW2xY: MAX_ASSISTANTS = ^"Leadership" (minimum 1)
        }
    }

    # ===========================
    # BOTCHES AND WARPING (MAGIC)
    # ===========================

    #ARM3E3zA5bC7dE9fG1hI3jK ^"Botch Sources (Spellcasting)" DEF {
        APPLIES TO [^"Magus"]

        # Base: 1 botch die (stress situation).
        # Additional sources:
        #   Using vis: +1 per pawn
        #   Non-Magic supernatural aura: +1 per aura level (doubled in regio)
        #   Fast Casting: +2
        # Reductions:
        #   Golden Cord to familiar: -1 per cord level
        #   Spell Mastery: -1 per mastery level
        # Relaxed Formulaic casting: 0 botch dice regardless.
        # Fatiguing Spontaneous: never relaxed (inherently stressful).
        # Ritual: always requires botch dice unless mastered.
        # Each botch zero = 1 Warping Point.
        # 2+ Warping Points from one event triggers Twilight check.

        RULES {
            #ARM3E4lM6nO8pQ0rS2tU4vW: BOTCH_DICE = 1 (base) + vis + aura + fast_casting - golden_cord - mastery
            #ARM3E5xY7zA9bC1dE3fG5hI: WARPING_FROM_BOTCH = 1 per zero on botch dice
        }
    }

    # ===========================
    # WIZARD'S TWILIGHT
    # ===========================

    #ARM3E6jK8lM0nO2pQ4rS6tU ^"Wizard's Twilight" DEF {
        APPLIES TO [^"Magus"]

        # Triggered when maga gains 2+ Warping Points from a single event.
        # Twilight Avoidance: Sta + Concentration + Vim Form Bonus + stress die
        #   vs Warping Score + WP gained + Enigmatic Wisdom + local aura + stress die (no botch)
        # If failed: maga enters Twilight. If botched: enters and cannot comprehend.
        # Maga may choose not to resist (auto-enters).
        #
        # Comprehension: Int + Enigmatic Wisdom + stress die vs Warping Score + stress die
        # Botch dice: 1 + 1 per WP gained to trigger
        #
        # Base time in Twilight by Warping Score:
        #   1: Diameter, 2: 2 hours, 3: Sun, 4: Day, 5: Moon,
        #   6: Season, 7: Year, 8: 7 years, 9: 7+die years, 10+: Final Twilight (eternal)
        #
        # Comprehended: beneficial Twilight Scar + choose one of:
        #   - XP in Art/MT/EW equal to 2x WP gained
        #   - Minor Virtue (7-10 WP) or Major Virtue (10+ WP)
        #   - New spell (magnitude = WP gained)
        # Failed: harmful Twilight Scar + choose one of:
        #   - Lose 2 XP per WP in Art/MT/EW
        #   - Minor Flaw (7-10 WP) or Major Flaw (10+ WP)
        #   - Lose spells (magnitudes = WP gained)
        # Additional Warping Points from Twilight: roll simple die.

        RULES {
            #ARM3E7vW9xY1zA3bC5dE7fG: TWILIGHT_AVOIDANCE = Sta + Concentration + Vim Bonus + stress die
            #ARM3E8hI0jK2lM4nO6pQ8rS: TWILIGHT_COMPREHENSION = Int + Enigmatic Wisdom + stress die vs Warping Score + stress die
            #ARM3E9tU1vW3xY5zA7bC9dE: TWILIGHT_DURATION based on Warping Score (Diameter to Final Twilight)
        }
    }

    # ===========================
    # REQUISITES
    # ===========================

    #ARM3F0fG2hI4jK6lM8nO0pQ ^"Requisites" DEF {
        APPLIES TO [^"Magus"]

        # Some spells require additional Arts beyond primary Technique and Form.
        # Casting Requisites: use lowest applicable Art score in casting total.
        # Lab Requisites: use lowest applicable Art score in lab total.
        # Requisites never make a spell easier; they only restrict.
        # If a spell could have a requisite, the Technique is the one that
        # applies the bonus/penalty. Form requisites add versatility.
        # Free requisites: when the spell inherently requires the extra Form
        # for its basic function (no additional magnitude needed).

        RULES {
            #ARM3F1rS3tU5vW7xY9zA1bC: CASTING with requisite = use lowest of applicable Art scores
        }
    }

    # ===========================
    # AURA MODIFIER
    # ===========================

    #ARM3F2dE4fG6hI8jK0lM2nO ^"Aura Modifier (Magic)" DEF {
        APPLIES TO [^"Magus"]

        # Supernatural auras affect magical activities.
        # Magic aura: adds directly to casting scores and lab totals.
        # Dominion (Divine) aura: subtracts from casting scores and lab totals.
        # Faerie aura: adds to casting scores (half value) but adds botch dice.
        # Infernal aura: subtracts from casting scores and lab totals.
        # Standard covenant laboratory typically has Magic aura 3-5.
        # Aura modifiers affect both casting and lab work.

        RULES {
            #ARM3F3pQ5rS7tU9vW1xY3zA: Magic aura = + aura level to casting and lab
            #ARM3F4bC6dE8fG0hI2jK4lM: Dominion aura = - aura level to casting and lab
        }
    }

    # ===========================
    # SHAPE AND MATERIAL BONUSES (FRAMEWORK)
    # ===========================

    #ARM3F5nO7pQ9rS1tU3vW5xY ^"Shape and Material Bonuses" DEF {
        APPLIES TO [^"Magus"]

        # Certain shapes and materials resonate with certain magical effects.
        # These bonuses apply to Lab Totals when enchanting items.
        # Max total S&M bonus for a single enchantment = Magic Theory score.
        # Multiple materials and shapes stack within that limit.
        # Examples:
        #   Wand: +4 destroy at distance, +2 project bolts
        #   Staff: +3 control things at distance, +4 project bolts
        #   Ring: +2 constant effect
        #   Sword: +3 block single attack, +4 harm human/animal bodies
        #   Ruby: +3 fire-related effects
        #   Iron: +7 harm/repel faeries
        #   Silver: +5 harm lycanthropes, +3 protect spirits
        #   Gold: +4 noble, +2 wealth
        #   Animal bone: +4 destroy/control animals

        RULES {
            #ARM3F6zA8bC0dE2fG4hI6jK: MAX_SM_BONUS_PER_ENCHANTMENT = ^"Magic Theory" score
        }
    }
}
