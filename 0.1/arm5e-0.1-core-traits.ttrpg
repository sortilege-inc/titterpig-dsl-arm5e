BASE "ARM5e_Core_Traits" {
    NAME "Ars Magica 5th Edition Definitive - Characteristics, Abilities, and derived attributes"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Core Rulebook: Characteristics, Ability types, full Ability list,
    # Personality Traits, Reputations, and derived values.
    # Characteristics are inborn (-3 to +3 normal, -5 to +5 extreme).
    # Abilities are learned skills (score 0+, XP pyramid cost).

    # ===========================
    # CHARACTERISTICS
    # ===========================

    ^"Characteristic" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Eight inborn attributes. Score 0 = average. Range normally
        # -3 to +3; extremes of -5 to +5 possible with Virtues/Flaws.
        # Cannot be increased by normal means; only powerful magic
        # or drastic story events can change them.

        RULES {
            #ARM100aB2cD4eF6gH8iJ0kL: characteristics_fixed_after_creation
            #ARM101mN3oP5qR7sT9uV1wX: zero_is_average
        }
    }

    ^"Intelligence" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Power to analyze and synthesize concepts, and memory.
        # Important for thought-based Abilities and paramount for
        # the Hermetic Arts. Low Intelligence does not imply stupidity;
        # common sense, street savvy, and wisdom are separate.

        RULES {
            #ARM102yZ4aB6cD8eF0gH2iJ: intelligence_used_for_lab_totals
            #ARM103kL5mN7oP9qR1sT3uV: intelligence_used_for_study_totals
        }
    }

    ^"Perception" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Ability to notice things and powers of intuition. Often works
        # intuitively. Important for Awareness, Hunt, and Folk Ken.

        RULES {
            #ARM104wX6yZ8aB0cD2eF4gH: perception_used_for_awareness_rolls
        }
    }

    ^"Strength" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Physical power: lifting, pushing, shoving. Important for
        # melee weapon damage and brute physical force.

        RULES {
            #ARM105iJ7kL9mN1oP3qR5sT: strength_added_to_damage
        }
    }

    ^"Stamina" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Limits of exertion, physical punishment tolerance,
        # staying power. Important for spellcasting (added to
        # casting totals), carrying loads, ignoring fatigue, and
        # withstanding wounds (Soak).

        RULES {
            #ARM106uV8wX0yZ2aB4cD6eF: stamina_added_to_casting_totals
            #ARM107gH9iJ1kL3mN5oP7qR: stamina_added_to_soak
        }
    }

    ^"Presence" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Appearance, demeanor, and charisma. Important for making
        # impressions and leading people. Can be imposing or
        # intimidating even without physical attractiveness.

        RULES {
            #ARM108sT0uV2wX4yZ6aB8cD: presence_used_for_leadership
        }
    }

    ^"Communication" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Aptitude for self-expression. Important for influencing
        # others verbally or otherwise. Positive score suggests
        # comfort and confidence in relationships.

        RULES {
            #ARM109eF1gH3iJ5kL7mN9oP: communication_used_for_teaching
            #ARM110pQ2rS4tU6vW8xY0zA: communication_used_for_writing_books
        }
    }

    ^"Dexterity" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Agility, accurate manipulation, hand-eye coordination,
        # fine motor control, bodily grace. Determines how well
        # you swing a sword or throw a knife. Used for Attack totals.

        RULES {
            #ARM111bC3dE5fG7hI9jK1lM: dexterity_added_to_attack_totals
        }
    }

    ^"Quickness" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        INTEGER MIN -5 MAX 5

        # Reaction speed and reflexes. Determines who acts first
        # and how well you do things in a hurry. Used for Initiative
        # and Defense totals. Modified by Encumbrance.

        RULES {
            #ARM112mN4oP6qR8sT0uV2wX: quickness_added_to_initiative
            #ARM113xY5zA7bC9dE1fG3hI: quickness_added_to_defense_totals
        }
    }

    # ===========================
    # ABILITY FRAMEWORK
    # ===========================

    ^"Ability" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Learned skills that increase during play. Used as:
        # Characteristic + Ability + die roll >= Ease Factor.
        # Score 0 with no XP: can use non-asterisked Abilities
        #   with 3 extra botch dice. Cannot use asterisked Abilities.
        # Score 0 with 1+ XP: can use any trained Ability, no penalty.
        # XP cost to advance: Score N costs N*(N+1)/2 total XP.
        #   (Score 1 = 5 XP, Score 2 = 15 XP, Score 3 = 30 XP, etc.)
        # Each Ability has a specialization granting +1 when applicable.

        PROPERTIES {
            ^"Ability Name" STRING REQUIRED
            ^"Score" INTEGER MIN 0 DEFAULT 0
            ^"Experience Points" INTEGER MIN 0 DEFAULT 0
            ^"Specialization" STRING
            ^"Ability Type" ENUM ["General", "Academic", "Arcane", "Martial", "Supernatural", "Spell Mastery"]
            ^"Restricted" BOOLEAN DEFAULT false  # Asterisked abilities require training/Virtue
        }

        ADVANCEMENT_COSTS {
            ^"Score 1" "5 XP total"
            ^"Score 2" "15 XP total"
            ^"Score 3" "30 XP total"
            ^"Score 4" "50 XP total"
            ^"Score 5" "75 XP total"
            ^"Score 6" "105 XP total"
            ^"Score 7" "140 XP total"
            ^"Score 8" "180 XP total"
            ^"Score 9" "225 XP total"
            ^"Score 10" "275 XP total"
        }

        RULES {
            #ARM114iJ6kL8mN0oP2qR4sT: specialization_adds_plus_one
            #ARM115uV7wX9yZ1aB3cD5eF: untrained_non_restricted_adds_3_botch_dice
            #ARM116gH8iJ0kL2mN4oP6qR: untrained_restricted_cannot_use
            #ARM117sT9uV1wX3yZ5aB7cD: one_xp_removes_untrained_penalty
            #ARM118eF0gH2iJ4kL6mN8oP: xp_cost_formula_n_times_n_plus_1_over_2
        }
    }

    # ===========================
    # GENERAL ABILITIES
    # ===========================

    ^"Animal Handling" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Care and use of animals: raising, tending, grooming, healing.
        # Specialties: falconry, specific animals.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Area Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Knowledge of one particular region, covenant, or village.
        # Includes geography, local history, legends, centers of power.
        # Taken multiple times for different areas.
        # Specialties: geography, history, legends, politics, personalities.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Athletics" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # General physical prowess, large-muscle coordination.
        # Specialties: acrobatics, contortions, grace, jumping, running.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Awareness" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Noticing things, alertness, watchfulness.
        # Specialties: bodyguarding, keeping watch, alertness, searching.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Bargain" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Getting the greatest return for a service or product.
        # Specialties: specific types of products, hard sell.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Brawl" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Hand-to-hand fighting without weapons, or with improvised
        # weapons and knives. Also used to dodge if no Martial Abilities.
        # Specialties: punches, grapples, knives, dodging.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Carouse" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Enjoying oneself without adverse effects. Includes
        # alcohol tolerance and acceptable behavior.
        # Specialties: power drinking, drinking songs, games of chance, staying sober.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Charm" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Enticing, fascinating, endearing others on a personal basis.
        # Specialties: courtly love, first impressions, being witty.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Chirurgy" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Medieval surgery: tending wounds, binding, cauterization.
        # Specialties: cauterization, diagnosis, binding wounds, setting bones.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Concentration" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Focusing mental faculties on one task for extended periods.
        # Important for magi maintaining concentration on spells.
        # Specialties: spell concentration, reading, lab work.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Craft" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Handiwork Abilities, distinguished by material or method.
        # Purchased multiple times for different crafts.
        # Specialties: as appropriate to the craft.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Etiquette" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Social graces and proper behavior in different situations.
        # Specialties: nobility, court, peasants, faeries, the Church.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Folk Ken" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Understanding background, personality, and motives of others.
        # Specialties: peasants, townsfolk, nobles, clergy, magi, opposite sex.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Guile" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Lying and deceiving. Opposed by the target's Folk Ken or
        # Awareness. Specialties: lying to authority, fast talk, elaborate lies.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Hunt" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Setting snares, reading tracks, following trails, locating prey.
        # Specialties: tracking, covering tracks, specific prey.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Intrigue" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Plotting, scheming, and manipulating political situations.
        # Specialties: plotting, gossip, alliances, rumormongering.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Leadership" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Getting people to obey and follow you, inspiring loyalty.
        # Specialties: intimidation, in combat, inspiration.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Legerdemain" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Sleight of hand, picking pockets, picking locks, filching.
        # Specialties: filching, picking pockets, picking locks, prestidigitation.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Living Language" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Fluency in a spoken living language. Taken multiple times
        # for different languages. Score 5 = native fluency.
        # Specialties: specific dialects, storytelling, academic usage.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Music" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Singing and playing musical instruments.
        # Specialties: singing, a specific instrument, composing.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Organization Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Knowledge of a specific organization's customs, history,
        # and politics. Taken multiple times for different organizations.
        # Specialties: history, personalities, politics.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Profession" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Knowledge of a specific type of work. Different from Craft
        # in that it covers non-manual occupations.
        # Specialties: as appropriate to the profession.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Ride" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Riding horses and other mounts.
        # Specialties: in combat, speed, tricks, specific mounts.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Stealth" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Sneaking around and avoiding notice.
        # Specialties: hiding, sneaking, shadowing, natural areas, urban areas.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Survival" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Living in and traveling through the wilderness.
        # Specialties: specific terrain types.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Swim" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Swimming in water.
        # Specialties: long distances, underwater, rough water.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    ^"Teaching" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Imparting knowledge to others. Quality of teaching depends
        # on Communication + Teaching. Important for advancement.
        # Specialties: a specific Ability or subject, students of a specific type.
        PROPERTIES { ^"Ability Type" STRING "General" }
    }

    # ===========================
    # ACADEMIC ABILITIES
    # ===========================
    # Require formal training; available at character creation only
    # with appropriate Virtue or to magi (during/after apprenticeship).
    # Normally require Latin 3 (or equivalent scholarly language).

    ^"Art of Memory" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Creation of memory palaces (mnemonic loci). Number of loci
        # = 5 x score. Can memorize complex scenes, images, or writing
        # with Int + Art of Memory + stress die vs EF 9+.
        # Specialties: an area of knowledge.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Artes Liberales" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # The seven liberal arts: Trivium (grammar, logic, rhetoric)
        # and Quadrivium (arithmetic, geometry, astronomy, music).
        # Also covers the ability to read and write (one writing system
        # per point in the Ability).
        # Specialties: grammar, logic, rhetoric, arithmetic, geometry,
        #   astronomy, music, Ritual magic, Ceremonial magic.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Civil and Canon Law" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Civil Law (Roman Empire) and Canon Law (Church).
        # Specialties: laws of a specific area, papal laws.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Common Law" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Laws of England specifically. Only taught in England.
        # Specialties: local laws, exchequer laws.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Dead Language" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Fluency in a dead language (Latin, Hebrew, etc.).
        # Latin is the common language of the Church and Order of Hermes.
        # Taken multiple times for different languages.
        # Specialties: academic usage, Church ceremonies, Hermetic usage.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Islamic Law" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of Sharia and Islamic jurisprudence.
        # Specialties: specific schools of law.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Judaic Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        # Knowledge of Jewish customs, history, and religion.
        # Specialties: history, customs, specific communities.
        PROPERTIES { ^"Ability Type" STRING "General" ^"Restricted" BOOLEAN true }
    }

    ^"Medicine" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Theoretical medical knowledge based on humoral theory.
        # Different from Chirurgy (practical surgery).
        # Specialties: anatomy, apothecary, physician.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Philosophiae" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Natural philosophy (Aristotelian science). Covers the study
        # of the natural world and its principles.
        # Specialties: natural philosophy, moral philosophy, metaphysics.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Rabbinic Law" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of the Talmud and rabbinical rulings.
        # Specialties: specific tractates.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Theology: Christian" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Study of Christian doctrine and scripture.
        # Specialties: biblical knowledge, heresy, history.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Theology: Islam" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Study of Islamic doctrine and scripture.
        # Specialties: Quranic knowledge, hadith.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    ^"Theology: Judaism" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Study of Jewish doctrine and scripture.
        # Specialties: Torah, mysticism.
        PROPERTIES { ^"Ability Type" STRING "Academic" ^"Restricted" BOOLEAN true }
    }

    # ===========================
    # ARCANE ABILITIES
    # ===========================
    # Require appropriate Virtue or magus status.

    ^"Code of Hermes" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Judging events according to the Code and Peripheral Code.
        # Specialties: Wizards' Marches, apprentices, mundane relations,
        #   Tribunal procedures, political intrigue.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Dominion Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of Divine power manifestations.
        # Specialties: angels, saints, Divine creatures.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Enigmatic Wisdom" DEF {
        APPLIES TO [^"Magus"]
        # Understanding of the Enigma, specific to House Criamon.
        # Specialties: Twilight, sensory magic, riddles.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Faerie Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Familiarity with faerie powers, weaknesses, motivations.
        # Specialties: faerie forests, faerie mounds, specific types of faeries.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Faerie Magic" DEF {
        APPLIES TO [^"Magus"]
        # Connection to Faerie realm power, specific to House Merinita.
        # Cannot be learned by non-Merinita characters.
        # Specialties: as described in Hermetic Magic chapter.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Finesse" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Manipulating spells and performing special feats with them.
        # Used to position objects delicately or target spells.
        # Specialties: grace, precision, any one Form.
        PROPERTIES { ^"Ability Type" STRING "Arcane" }
    }

    ^"Heartbeast" DEF {
        APPLIES TO [^"Magus"]
        # Ability to assume animal form, specific to House Bjornaer.
        # Specialties: as described in Hermetic Magic chapter.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Infernal Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of demons, Infernal powers, and corruption.
        # Specialties: demons, undead, curses, the Infernal realm.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Magic Lore" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of magical creatures, traditions, and phenomena.
        # Specialties: magical traditions, creatures, regiones, vis.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }
    }

    ^"Magic Theory" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Knowledge of Hermetic magical theory. Required for
        # laboratory work. Added to Lab Total. Also allows
        # understanding and use of laboratory texts.
        # Specialties: inventing spells, enchanting items, a specific Art.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }

        RULES {
            #ARM119pQ0rS2tU4vW6xY8zA: magic_theory_added_to_lab_total
            #ARM120bC1dE3fG5hI7jK9lM: magic_theory_required_for_lab_work
        }
    }

    ^"Parma Magica" DEF {
        APPLIES TO [^"Magus"]
        # The magical shield that protects magi from hostile magic.
        # All Hermetic magi learn this during apprenticeship.
        # Provides Magic Resistance = Parma Magica score x 5.
        # Can be extended to protect nearby allies.
        # Specialties: protection from a specific Form.
        PROPERTIES { ^"Ability Type" STRING "Arcane" ^"Restricted" BOOLEAN true }

        RULES {
            #ARM121nO2pQ4rS6tU8vW0xY: magic_resistance_equals_parma_times_5
            #ARM122zA3bC5dE7fG9hI1jK: parma_can_protect_nearby_allies
        }
    }

    ^"Penetration" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        # Ability to overcome Magic Resistance with spells.
        # Specialties: a specific Art.
        PROPERTIES { ^"Ability Type" STRING "Arcane" }
    }

    ^"Mystery Cult Lore" DEF {
