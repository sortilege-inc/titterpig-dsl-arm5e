    # ===========================
    # SPELL MASTERY ABILITIES
    # ===========================

    ^"Spell Mastery" DEF {
        APPLIES TO [^"Magus"]

        # Each mastered Formulaic or Ritual spell becomes its own
        # Ability. Score provides: that many extra botch dice removed
        # from casting, and access to special mastery options.
        # Mastery options include: Fast Casting, Multiple Casting,
        # Quiet Casting, Still Casting, and Penetration.

        PROPERTIES {
            ^"Ability Type" STRING "Spell Mastery"
            ^"Spell Name" STRING REQUIRED
        }

        MASTERY_OPTIONS {
            ^"Fast Casting" "Cast spell as a fast-cast response to an event"
            ^"Multiple Casting" "Cast multiple copies of the spell simultaneously"
            ^"Quiet Casting" "Reduce voice requirement penalty"
            ^"Still Casting" "Reduce gestures requirement penalty"
            ^"Penetration" "Add mastery score to Penetration Total"
        }

        RULES {
            #ARM123lM4nO6pQ8rS0tU2vW: mastery_score_reduces_botch_dice
            #ARM124xY5zA7bC9dE1fG3hI: each_mastery_level_grants_one_option
        }
    }
}
