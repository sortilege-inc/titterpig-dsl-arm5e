    # ===========================
    # COVENANT LOYALTY
    # ===========================

    #ARM13C5cD1eF7gH3iJ9kL5mN ^"Prevailing Loyalty" DEF {
        APPLIES TO [^"Covenant"]
        PROPERTIES {
            ^"Base Loyalty" INTEGER
            ^"Situational Modifiers" INTEGER DEFAULT 0
            ^"Familiarity Points" INTEGER DEFAULT 0
            ^"Event Modifiers" INTEGER DEFAULT 0
            ^"Total Loyalty Points" INTEGER
            ^"Prevailing Loyalty Score" INTEGER
        }
        RULES {
            #ARM13C6oP2qR8sT4uV0wX6yZ: Base Loyalty = total of Gift modifiers / number of magi in covenant
            #ARM13C7aB3cD9eF5gH1iJ7kL: The Gentle Gift or No Gift contributes 0 to modifier total
            #ARM13C8mN4oP0qR6sT2uV8wX: The Gift contributes -30 to modifier total per magus with it
            #ARM13C9yZ5aB1cD7eF3gH9iJ: The Blatant Gift contributes -105 to modifier total per magus with it
            #ARM13CAkL6mN2oP8qR4sT0uV: Total loyalty points converted to score using Ability Advancement table
            #ARM13CBwX7yZ3aB9cD5eF1gH: Individual covenfolk vary by up to 3 points from Prevailing Loyalty
        }
    }

    #ARM13CCiJ8kL4mN0oP6qR2sT ^"Loyalty Situational Modifiers" DEF {
        APPLIES TO [^"Covenant"]
        PROPERTIES {
            ^"Living Conditions" INTEGER DEFAULT 0
            ^"Equipment" INTEGER DEFAULT 0
            ^"Money" INTEGER DEFAULT 0
        }
        RULES {
            #ARM13CDuV9wX5yZ1aB7cD3eF: Living Conditions: -2 Aging mod = -20; -1 = -10; 0 = 0; +1 = +10; +2 = +20
            #ARM13CEgH0iJ6kL2mN8oP4qR: Equipment: Inexpensive only = -10; Standard = 0; Std+Expensive = +10; Any = +20
            #ARM13CFsT1uV7wX3yZ9aB5cD: Money: No salary = -20; Half wages = -10; Standard = 0; 1.5x = +10; 2x = +20
            #ARM13D0eF2gH8iJ4kL0mN6oP: Pension upon retirement (+10); Turb Captain adds +Prs+Leadership
            #ARM13D1qR3sT9uV5wX1yZ7aB: Steward adds +Prs+Profession:Steward; Chamberlain adds +Prs+Profession:Chamberlain
        }
    }

    #ARM13D2cD4eF0gH6iJ2kL8mN ^"Loyalty Familiarity" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM13D3oP5qR1sT7uV3wX9yZ: Covenant gains 2 loyalty points per year of existence
            #ARM13D4aB6cD2eF8gH4iJ0kL: Maximum familiarity points equals absolute value of Base Loyalty
        }
    }

    #ARM13D5mN7oP3qR9sT5uV1wX ^"Loyalty Event Modifiers" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM13D6yZ8aB4cD0eF6gH2iJ: Rudeness/Minor Humiliation: -1 point
            #ARM13D7kL9mN5oP1qR7sT3uV: Oblivious/Public Humiliation: -3 points
            #ARM13D8wX0yZ6aB2cD8eF4gH: Malicious/Restraint: -6 points
            #ARM13D9iJ1kL7mN3oP9qR5sT: Callous disregard/Infliction of Pain: -9 points
            #ARM13DAuV2wX8yZ4aB0cD6eF: Deliberate Cruelty/Brutal Punishment: -12 points
            #ARM13DBgH3iJ9kL5mN1oP7qR: Heinous Malfeasance: -15 points
            #ARM13DCsT4uV0wX6yZ2aB8cD: Magi personal actions benefiting covenfolk can add loyalty (use penalty scale)
        }
    }

    # ===========================
    # SAMPLE PREVAILING LOYALTY SCORES
    # ===========================

    #ARM13DDeF5gH1iJ7kL3mN9oP ^"Prevailing Loyalty Scale" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM13DEqR6sT2uV8wX4yZ0aB: Score -6: Covenfolk deeply unhappy, on verge of revolt, productivity halved
            #ARM13DFcD7eF3gH9iJ5kL1mN: Score -4: Not happy but self-interest keeps them in place, no trust in magi
            #ARM13E0oP8qR4sT0uV6wX2yZ: Score -2: Will not betray under most circumstances, still wary of magi
            #ARM13E1aB9cD5eF1gH7iJ3kL: Score 0: Moderately content, treat magi as gentry
            #ARM13E2mN0oP6qR2sT8uV4wX: Score +2: Unusually loyal, close-mouthed around strangers
            #ARM13E3yZ1aB7cD3eF9gH5iJ: Score +4: Treat magi as close family, will not betray except under severe duress
            #ARM13E4kL2mN8oP4qR0sT6uV: Score +6: Extraordinary service, grogs may lay down lives, productivity increased
        }
    }

    # ===========================
    # COVENANT FINANCES
    # ===========================

    #ARM13E5wX3yZ9aB5cD1eF7gH ^"Source of Income" DEF {
        APPLIES TO [^"Covenant"]
        PROPERTIES {
            ^"Category" ENUM ["None", "Lesser", "Typical", "Greater", "Legendary"]
            ^"Annual Income" INTEGER
            ^"Source Type" TEXT
        }
        RULES {
            #ARM13E6iJ4kL0mN6oP2qR8sT: None (Poverty Major Hook): 0 pounds
            #ARM13E7uV5wX1yZ7aB3cD9eF: Lesser (Poverty Minor Hook): ~40 pounds
            #ARM13E8gH6iJ2kL8mN4oP0qR: Typical (no Hook/Boon): ~100 pounds
            #ARM13E9sT7uV3wX9yZ5aB1cD: Greater (Wealth Minor Boon): ~250 pounds
            #ARM13EAeF8gH4iJ0kL6mN2oP: Legendary (Wealth Major Boon): ~1000 pounds
        }
    }

    # ===========================
    # EXPENDITURE
    # ===========================

    #ARM13EBqR9sT5uV1wX7yZ3aB ^"Covenfolk Categories" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM13ECcD0eF6gH2iJ8kL4mN: Craftsmen: Have Craft Ability, produce wares; allow cost savings
            #ARM13EDoP1qR7sT3uV9wX5yZ: Dependents: Residents who do no useful work (children 5+, infirm, retirees)
            #ARM13EEaB2cD8eF4gH0iJ6kL: Grogs: Full-time soldiers for martial defense
            #ARM13EFmN3oP9qR5sT1uV7wX: Laborers: Workers who gather food; allow cost saving on Provisions
            #ARM13F0yZ4aB0cD6eF2gH8iJ: Servants: Prepare food, clean, household tasks
            #ARM13F1kL5mN1oP7qR3sT9uV: Specialists: Important covenant roles (autocrat, steward, turb captain, scribe)
            #ARM13F2wX6yZ2aB8cD4eF0gH: Teamsters: Procure and transport provisions and supplies
        }
    }

    #ARM13F3iJ7kL3mN9oP5qR1sT ^"Points of Inhabitants" DEF {
        APPLIES TO [^"Covenant"]
        # Spring/Winter values; Summer/Autumn are doubled
        PROPERTIES {
            ^"Season Multiplier" ENUM ["Spring/Winter", "Summer/Autumn"]
        }
        RULES {
            #ARM13F4uV8wX4yZ0aB6cD2eF: Magus or Noble: 5 pts (Spring/Winter), 10 pts (Summer/Autumn)
            #ARM13F5gH9iJ5kL1mN7oP3qR: Companion: 3 pts (Spring/Winter), 5 pts (Summer/Autumn)
            #ARM13F6sT0uV6wX2yZ8aB4cD: Specialist or Craftsman: 2 pts (Spring/Winter), 3 pts (Summer/Autumn)
            #ARM13F7eF1gH7iJ3kL9mN5oP: Other Covenfolk: 1 pt (Spring/Winter), 2 pts (Summer/Autumn)
            #ARM13F8qR2sT8uV4wX0yZ6aB: Horse: 1 pt (both); Impoverished magi may reduce to 3 pts
        }
    }

    #ARM13F9cD3eF9gH5iJ1kL7mN ^"Yearly Expenditure" DEF {
        APPLIES TO [^"Covenant"]
        PROPERTIES {
            ^"Buildings Cost" INTEGER
            ^"Consumables Cost" INTEGER
            ^"Provisions Cost" INTEGER
            ^"Wages Cost" INTEGER
            ^"Inflation Cost" INTEGER DEFAULT 0
            ^"Laboratories Cost" INTEGER
            ^"Weapons and Armor Cost" INTEGER
            ^"Writing Materials Cost" INTEGER
            ^"Total Expenditure" INTEGER
        }
        RULES {
            #ARM13FAoP4qR0sT6uV2wX8yZ: Buildings: 1 pound per 10 points of inhabitants; +2 per Minor building Boon, +5 per Major
            #ARM13FBaB5cD1eF7gH3iJ9kL: Consumables: 2 pounds per 10 points of inhabitants
            #ARM13FCmN6oP2qR8sT4uV0wX: Provisions: 5 pounds per 10 points of inhabitants
            #ARM13FDyZ7aB3cD9eF5gH1iJ: Wages: 2 pounds per 10 points of inhabitants; +1 per penny daily to soldiers
            #ARM13FEkL8mN4oP0qR6sT2uV: Inflation: starts at 0, increases ~1 pound per 100 pounds expenditure per year
            #ARM13FFwX9yZ5aB1cD7eF3gH: Laboratories: 1 pound per 10 points of laboratories
            #ARM1400iJ0kL6mN2oP8qR4sT: Weapons and Armor: 1 pound per 320 points of weapons/armor
            #ARM1401uV1wX7yZ3aB9cD5eF: Writing Materials: 1 pound per magus, scribe, bookbinder, or illuminator
        }
    }

    #ARM1402gH2iJ8kL4mN0oP6qR ^"Points of Laboratories" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM1403sT3uV9wX5yZ1aB7cD: Upkeep -5 = 1 pt; -4 = 2; -3 = 3; -2 = 5; -1 = 7; 0 = 10 pts
            #ARM1404eF4gH0iJ6kL2mN8oP: Upkeep +1 = 15; +2 = 30; +3 = 60; +4 = 100; +5 = 150 pts
            #ARM1405qR5sT1uV7wX3yZ9aB: Above +5: each additional level adds (new Upkeep x 10) points
            #ARM1406cD6eF2gH8iJ4kL0mN: Multiplier: Light use (avg 1 season) x0.5; Typical (2 seasons) x1; Heavy (3+) x1.5
        }
    }

    #ARM1407oP7qR3sT9uV5wX1yZ ^"Points of Weapons and Armor" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM1408aB8cD4eF0gH6iJ2kL: Weapon/shield: Inexpensive 1, Standard 4, Expensive 16 pts
            #ARM1409mN9oP5qR1sT7uV3wX: Partial armor: Inexpensive 2, Standard 8, Expensive 32 pts
            #ARM140AyZ0aB6cD2eF8gH4iJ: Full armor: Inexpensive 4, Standard 16, Expensive 64 pts
            #ARM140BkL1mN7oP3qR9sT5uV: Ballista/light catapult: Expensive 16 pts; Heavy catapult/trebuchet: Expensive 32 pts
        }
    }

    # ===========================
    # COST SAVING
    # ===========================

    #ARM140CwX2yZ8aB4cD0eF6gH ^"Cost Saving" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM140DiJ3kL9mN5oP1qR7sT: Each laborer reduces Provisions expenditure by 1 pound
            #ARM140EuV4wX0yZ6aB2cD8eF: Every 5 laborers makes 1 teamster redundant, saving 1 additional pound
            #ARM140FgH5iJ1kL7mN3oP9qR: Max laborer savings = 50% of Provisions total
            #ARM1410sT6uV2wX8yZ4aB0cD: Common craftsman saves 1 + (Craft Ability / 2, rounded down) pounds
            #ARM1411eF7gH3iJ9kL5mN1oP: Rare craftsman saves (Craft Ability) pounds
            #ARM1412qR8sT4uV0wX6yZ2aB: Per-craft cost saving limit: Buildings 50%, Consumables 20%, Labs 50%, Provisions 50%, Weapons 50%, Writing 50%
            #ARM1413cD9eF5gH1iJ7kL3mN: Magic items: save 1 pound per magnitude of effect per year
            #ARM1414oP0qR6sT2uV8wX4yZ: Ritual spells: save ~5 pounds per magnitude per casting
        }
    }

    # ===========================
    # MINIMUM REQUIRED COVENFOLK
    # ===========================

    #ARM1415aB1cD7eF3gH9iJ5kL ^"Minimum Covenfolk Requirements" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM1416mN2oP8qR4sT0uV6wX: Servants required: 2 per 10 points of inhabitants (excluding laborers, servants, teamsters)
            #ARM1417yZ3aB9cD5eF1gH7iJ: Teamsters required: 1 per 10 points of (all except laborers and teamsters, minus 2x laborers)
            #ARM1418kL4mN0oP6qR2sT8uV: If fewer than minimums, storyguide determines consequences (overwork, self-service)
        }
    }

    # ===========================
    # THE MYTHIC POUND
    # ===========================

    #ARM1419wX5yZ1aB7cD3eF9gH ^"Mythic Pound" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM141AiJ6kL2mN8oP4qR0sT: 1 Mythic Pound = 1 pound of silver = annual income of a typical peasant
            #ARM141BuV7wX3yZ9aB5cD1eF: 1 Mythic Pound = enough to maintain an average Hermetic laboratory for 1 year
        }
    }

    # ===========================
    # COVENANT IN PLAY
    # ===========================

    #ARM141CgH8iJ4kL0mN6oP2qR ^"Covenant in Play" DEF {
        APPLIES TO [^"Covenant"]
        RULES {
            #ARM141DsT9uV5wX1yZ7aB3cD: Covenants do not gain Build Points during play
            #ARM141EeF0gH6iJ2kL8mN4oP: Characters create enchanted devices, write books, and trade for resources
            #ARM141FqR1sT7uV3wX9yZ5aB: If a Boon is lost, characters get story opportunities to regain it (becomes a Hook)
            #ARM1420cD2eF8gH4iJ0kL6mN: If a Boon is gained, covenant should gain a corresponding Hook
            #ARM1421oP3qR9sT5uV1wX7yZ: Minor Hooks take ~6 stories to resolve; Major Hooks take ~20 stories
        }
    }
}
