            #ARM13A9eF3gH9iJ5kL1mN7oP: Multiple mural towers protect the curtain wall (as many as the troupe desires)
            #ARM13AAqR4sT0uV6wX2yZ8aB: Includes one minor keep Boon (Shell or Tower)
        }
    }

