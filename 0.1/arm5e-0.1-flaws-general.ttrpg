EXTENSION "ARM5e_Flaws_General" {
    NAME "Ars Magica 5th Edition Definitive - General, Social Status, Story, and Personality Flaws"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Character"

    # All General, Social Status, Story, and Personality Flaws.
    # Organized by category and size (Major/Minor).
    # ID Range: #ARM900 onward.

    # ===========================
    # MAJOR GENERAL FLAWS
    # ===========================

    #ARM900qT4vB8nK2xR6jW ^"Blind" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog"]
        PROPERTIES {
