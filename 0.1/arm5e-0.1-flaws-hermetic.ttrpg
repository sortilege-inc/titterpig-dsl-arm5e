EXTENSION "ARM5e_Flaws_Hermetic" {
    NAME "Ars Magica 5th Edition Definitive - Hermetic Flaws"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Character"

    # All Hermetic Flaws: only available to magi (characters with The Gift
    # and Hermetic training). Organized by Major/Minor.

    # ===========================
    # MAJOR HERMETIC FLAWS
    # ===========================

    #ARM800qT4vB8nK2xR6jW0pF ^"Blatant Gift" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM801dH7mL3sY9cA5gN1eZ: People and animals immediately sense something strange and threatening about you
            #ARM802rJ6wP0tX4bF8kQ2vM: -6 penalty to all social interaction rolls with mundane people and animals (replaces normal Gift penalty of -3)
        }
    }

    #ARM803yC9hU5lE1oS7iW3aG ^"Chaotic Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM804fN2qD8vK4xB0rT6jP: Spontaneous magic is uncontrollable if you miss the target level by more than 1
            #ARM805mZ7gL3cH9eA5sW1yU: Storyguide decides the actual effects of uncontrolled spontaneous spells
        }
    }

    #ARM806pR8tF2kN6wJ0bX4hD ^"The Constant Expression" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM807vM3aQ9sG5lY1cE7oK: Perpetually casting non-fatiguing spontaneous magical effects involuntarily
            #ARM808jW6eB0nT4xH8rF2dP: Lose 1 permanent long-term Fatigue level due to constant magical drain
            #ARM809gL1yU5kS9wA3mC7qZ: Stamina + Concentration stress roll vs EF 3 + (Warping Score) each round to suppress effects
            #ARM80AtN8bJ4hD0fR6pX2vK: Laboratory Safety modifier of -3 due to uncontrolled magical emanations
        }
    }

    #ARM80BcH5oW9eA3sM7lQ1gY ^"Deficient Technique" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM80CxF2rN6kB0jT4wP8dZ: All totals that include a particular Technique are halved (Casting Totals, Lab Totals, etc.)
            #ARM80DqS7mG3vL9aE5hU1cY: Does not affect Advancement Totals for learning the Technique itself
            #ARM80EnK0yJ4bR8fW2tX6pD: XP costs for the Technique are based on the actual (unhalved) score value
        }
    }

    #ARM80FsA5gM9lC3hQ7oW1eB ^"Difficult Longevity Ritual" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM810wT8kN2xJ6rF0vP4bD: The Lab Total for creating a Longevity Ritual for you is halved, regardless of who creates it
        }
    }

    #ARM811dZ3qH7mL1cA5gY9sE ^"Environmental Magic Condition" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM812jW6eB0nT4xR8hF2pK: All Casting Totals and Lab Totals are halved under a commonly occurring environmental condition
            #ARM813vM9aQ3sG7lY1cU5oD: Condition must be common (e.g., indoors, during daylight, when not touching earth)
        }
    }

    #ARM814gL2yN8kS4wA0mC6qZ ^"Magic Addiction" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM815tR5bJ9hD3fP7pX1vK: After casting any spell with a stress die, must make Intelligence + Concentration stress roll vs EF half spell level
            #ARM816cH8oW2eA6sM0lQ4gY: Failure means compulsive urge to cast another spell; each subsequent spell adds +3 to the EF
            #ARM817xF1rN5kB9jT3wP7dZ: On a botch, must continue casting until falling unconscious from Fatigue
        }
    }

    #ARM818qS4mG0vL6aE2hU8cY ^"Monastic Vows (Hermetic)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM819nK7yJ3bR1fW5tX9pD: Cannot personally own vis; may only possess functional magic devices necessary for duties
            #ARM81AsA0gM4lC8hQ2oW6eB: Cannot marry; may be unable to bind a familiar depending on order's rules
            #ARM81BwT3kN7xJ1rF5vP9bD: Must obey a religious superior; disobedience may have supernatural consequences
        }
    }

    #ARM81CdZ6qH0mL4cA8gY2sE ^"Necessary Condition" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM81DjW9eB3nT7xR1hF5pK: Must perform a specific physical action to cast any spell (e.g., singing, spinning, jumping)
            #ARM81EvM2aQ6sG0lY4cU8oD: Cannot cast any spell at all if unable to perform the required action
        }
    }

    #ARM81FgL5yN9kS3wA7mC1qZ ^"Painful Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM820tR8bJ2hD6fP0pX4vK: Each spell cast causes pain equivalent to losing 1 Fatigue level
            #ARM821cH1oW5eA9sM3lQ7gY: Pain penalties are cumulative with each successive spell cast
            #ARM822xF4rN8kB2jT6wP0dZ: Pain recovery follows the same rules as recovering lost Fatigue levels
        }
    }

    #ARM823qS7mG1vL5aE9hU3cY ^"Restriction" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM824nK0yJ4bR8fW2tX6pD: Cannot cast any spell at all under specific uncommon conditions (e.g., touching earth, no beard, target is a bird)
            #ARM825sA3gM7lC1hQ5oW9eB: Restriction also applies to effects from enchanted items you have created
        }
    }

    #ARM826wT6kN0xJ4rF8vP2bD ^"Rigid Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM827dZ9qH3mL7cA1gY5sE: Cannot use vis when casting spells; cannot boost casting rolls with vis
            #ARM828jW2eB6nT0xR4hF8pK: Cannot cast Ritual magic (which requires vis expenditure)
            #ARM829vM5aQ9sG3lY7cU1oD: May still use vis in laboratory activities (enchantment, Longevity Rituals, etc.)
        }
    }

    #ARM82AgL8yN2kS6wA0mC4qZ ^"Short-Ranged Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM82BtR1bJ5hD9fP3pX7vK: Halve Casting Total for any spell when not physically touching the target
            #ARM82CcH4oW8eA2sM6lQ0gY: Halve Lab Total when creating effects with Range greater than Touch
        }
    }

    #ARM82DxF7rN1kB5jT9wP3dZ ^"Study Requirement" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM82EqS0mG4vL8aE2hU6cY: Cannot study Arts from books or vis alone
            #ARM82FnK3yJ7bR1fW5tX9pD: Must be in the presence of something that exemplifies the Art being studied (brook for Aquam, fire for Ignem, etc.)
        }
    }

    #ARM830sA6gM0lC4hQ8oW2eB ^"Suppressed Gift" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic", "Story"]
        }
        RULES {
            #ARM831wT9kN3xJ7rF1vP5bD: Cannot access The Gift; unable to perform any Hermetic magic, improve Arts, or use Parma Magica
            #ARM832dZ2qH6mL0cA4gY8sE: Existing Art scores still provide Magic Resistance (without Parma Magica)
            #ARM833jW5eB9nT3xR7hF1pK: Still suffers the social penalties associated with The Gift
        }
    }

    #ARM834vM8aQ2sG6lY0cU4oD ^"Twilight Prone" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM835gL1yN5kS9wA3mC7qZ: Must check for Twilight on a single botch die result of zero (normally only triggered by double botch)
        }
    }

    #ARM836tR4bJ8hD2fP6pX0vK ^"Unnatural Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM837cH7oW1eA5sM9lQ3gY: Creo rituals have no permanent effect; created things fade when duration expires regardless of ritual use
            #ARM838xF0rN4kB8jT2wP6dZ: Cannot extract vis using Creo techniques
        }
    }

    #ARM839qS3mG7vL1aE5hU9cY ^"Unstructured Caster" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM83AnK6yJ0bR4fW8tX2pD: All Formulaic spells are cast as Ritual spells, requiring vis expenditure
            #ARM83BsA9gM3lC7hQ1oW5eB: Cannot learn Ritual spells (already casting Formulaic as Ritual)
            #ARM83CwT2kN6xJ0rF4vP8bD: Spontaneous magic functions normally
        }
    }

    #ARM83DdZ5qH9mL3cA7gY1sE ^"Vulnerable Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM83EjW8eB2nT6xR0hF4pK: All active spells are automatically dispelled when an uncommon circumstance occurs
            #ARM83FvM1aQ5sG9lY3cU7oD: Circumstances examples: touching iron, exposure to running water, your name spoken three times
            #ARM840gL4yN8kS2wA6mC0qZ: Affects all currently active spells simultaneously; they all end at once
        }
    }

    #ARM841tR7bJ1hD5fP9pX3vK ^"Waster of Vis" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM842cH0oW4eA8sM2lQ6gY: One quarter of all vis used (rounded up) is wasted and has no magical effect
            #ARM843xF3rN7kB1jT5wP9dZ: Must use one third more vis than normally required to compensate for waste
            #ARM844qS6mG0vL4aE8hU2cY: Wasted vis still counts toward botch dice and vis usage maximums
        }
    }

    #ARM845nK9yJ3bR7fW1tX5pD ^"Weak Magic Resistance" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM846sA2gM6lC0hQ4oW8eB: Magic Resistance is much weaker under a commonly occurring condition (e.g., when wet, when facing away from attacker)
            #ARM847wT5kN9xJ3rF7vP1bD: When calculating Penetration against you under this condition, do not subtract spell level before calculating
        }
    }

    #ARM848dZ8qH2mL6cA0gY4sE ^"Weak Spontaneous Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM849jW1eB5nT9xR3hF7pK: Cannot exert yourself when casting spontaneous magic; always divide Casting Total by 5
            #ARM84AvM4aQ8sG2lY6cU0oD: Must still roll a stress die for potential botch even though not exerting
            #ARM84BgL7yN1kS5wA9mC3qZ: May still use Ceremonial Casting rules for spontaneous magic
        }
    }

    # ===========================
    # MINOR HERMETIC FLAWS
    # ===========================

    #ARM84CtR0bJ4hD8fP2pX6vK ^"Bound Casting Tools" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM84DcH3oW7eA1sM5lQ9gY: Verditius only; casting tools become lasting Arcane Connections to you after use
        }
    }

    #ARM84ExF6rN0kB4jT8wP2dZ ^"Bound Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM84FqS9mG3vL7aE1hU5cY: All active spells end immediately when you die
            #ARM850nK2yJ6bR0fW4tX8pD: All magic items you have created cease to function upon your death
        }
    }

    #ARM851sA5gM9lC3hQ7oW1eB ^"Brutal Artist" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM852wT8kN2xJ6rF0vP4bD: Jerbiton only; -3 to social interaction rolls with other Jerbiton magi
            #ARM853dZ1qH5mL9cA3gY7sE: Cannot gain a positive Reputation within House Jerbiton
        }
    }

    #ARM854jW4eB8nT2xR6hF0pK ^"Careless Sorcerer" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM855vM7aQ1sG5lY9cU3oD: Roll two extra botch dice whenever casting spells
            #ARM856gL0yN4kS8wA2mC6qZ: Does not apply if you would normally roll zero botch dice (e.g., relaxed casting with mastery)
        }
    }

    #ARM857tR3bJ7hD1fP5pX9vK ^"Ceremonial Spontaneous Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM858cH6oW0eA4sM8lQ2gY: Can only cast spontaneous magic using the Ceremonial Casting rules; no normal spontaneous casting
        }
    }

    #ARM859xF9rN3kB7jT1wP5dZ ^"Clumsy Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM85AqS2mG6vL0aE4hU8cY: An aiming roll result of 0 is treated as an automatic botch
            #ARM85BnK5yJ9bR3fW7tX1pD: -3 penalty to all Finesse rolls for aimed magic
        }
    }

    #ARM85CsA8gM2lC6hQ0oW4eB ^"Consumed Casting Tools" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM85DwT1kN5xJ9rF3vP7bD: Verditius only; casting tools are magically consumed and destroyed after each use
            #ARM85EdZ4qH8mL2cA6gY0sE: Requires approximately 1 hour to craft a replacement casting tool
        }
    }

    #ARM85FjW7eB1nT5xR9hF3pK ^"Corrupted Arts (Tainted)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM860vM0aQ4sG8lY2cU6oD: One corrupted Art gains +3 bonus when used for selfish or sinful purposes
            #ARM861gL3yN7kS1wA5mC9qZ: Same Art suffers -3 penalty when used for neutral or selfless purposes
            #ARM862tR6bJ0hD4fP8pX2vK: Gain or lose 5 XP in the corrupted Art based on whether bonus was used selfishly; magic is tainted by corruption
        }
    }

    #ARM863cH9oW3eA7sM1lQ5gY ^"Corrupted Spells (Tainted)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM864xF2rN6kB0jT4wP8dZ: Begin with 30+ levels of corrupted formulaic spells
            #ARM865qS5mG9vL3aE7hU1cY: Corrupted spells gain +3 to Casting Total and Penetration when used for sinful purposes
            #ARM866nK8yJ2bR6fW0tX4pD: Corrupted spells suffer -3 to Casting Total and Penetration when used for selfless purposes
            #ARM867sA1gM5lC9hQ3oW7eB: Gain or lose 5 mastery XP based on sinful vs selfless use of corrupted spells
        }
    }

    #ARM868wT4kN8xJ2rF6vP0bD ^"Creative Block" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM869dZ7qH1mL5cA9gY3sE: -3 to all Lab Totals unless working from a Lab Text or being directly taught by another magus
            #ARM86AjW0eB4nT8xR2hF6pK: When using experimentation, roll double the normal number of experimentation dice
        }
    }

    #ARM86BvM3aQ7sG1lY5cU9oD ^"Cyclic Magic (negative)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM86CgL6yN0kS4wA8mC2qZ: -3 to all Casting Scores and Lab Totals during the negative phase of the cycle
            #ARM86DtR9bJ3hD7fP1pX5vK: Cycle must be regular with equal durations of penalty and normal operation
        }
    }

    #ARM86EcH2oW6eA0sM4lQ8gY ^"Deficient Form" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM86FxF5rN9kB3jT7wP1dZ: Almost all totals that include a particular Form are halved (Casting Totals, Lab Totals, etc.)
            #ARM870qS8mG2vL6aE0hU4cY: Does not affect Advancement Totals or Magic Resistance from the deficient Form
            #ARM871nK1yJ5bR9fW3tX7pD: XP costs for the Form are based on the actual (unhalved) score value
        }
    }

    #ARM872sA4gM8lC2hQ6oW0eB ^"Deleterious Circumstances" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM873wT7kN1xJ5rF9vP3bD: All magic totals (excluding Magic Resistance) are halved under uncommon circumstances
            #ARM874dZ0qH4mL8cA2gY6sE: Circumstances examples: sitting down, being wet, in presence of wild animals, within a city
        }
    }

    #ARM875jW3eB7nT1xR5hF9pK ^"Difficult Spontaneous Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM876vM6aQ0sG4lY8cU2oD: Cannot cast non-fatiguing spontaneous magic at all
            #ARM877gL9yN3kS7wA1mC5qZ: Fatiguing spontaneous magic works normally (divide by 2)
            #ARM878tR2bJ6hD0fP4pX8vK: May combine with Weak Spontaneous Magic to lose all spontaneous casting ability
        }
    }

    #ARM879cH5oW9eA3sM7lQ1gY ^"Disjointed Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM87AxF8rN2kB6jT0wP4dZ: No benefit from knowing similar spells when learning or casting new spells
            #ARM87BqS1mG5vL9aE3hU7cY: No enchantment bonuses from Forms or Techniques already invested in an item
        }
    }

    #ARM87CnK4yJ8bR2fW6tX0pD ^"Disorientating Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM87DsA7gM1lC5hQ9oW3eB: Must spend one full round recovering after casting any spell before acting normally again
        }
    }

    #ARM87EwT0kN4xJ8rF2vP6bD ^"Exciting Experimentation" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM87FdZ3qH7mL1cA5gY9sE: Roll two dice on the experimentation results table instead of one
            #ARM880jW6eB0nT4xR8hF2pK: Storyguide selects whichever result is more amusing or dramatic
        }
    }

    #ARM881vM9aQ3sG7lY1cU5oD ^"Fettered Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Hermetic"]
        }
        RULES {
            #ARM882gL2yN6kS0wA4mC8qZ: All spells you cast and all activated effects from your enchanted items serve as Arcane Connections to you
        }
    }

