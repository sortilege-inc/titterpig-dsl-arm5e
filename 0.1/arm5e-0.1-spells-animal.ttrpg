EXTENSION "ARM5e_Spells_Animal" {
    NAME "Ars Magica 5th Edition Definitive - Animal Spells"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Magic"

    # Animal Form spells: affect natural living things that are not plants or humans.
    # Basic Individual: animal of Size +1 or lower (pony-sized).
    # Organized by Technique (Creo, Intellego, Muto, Perdo, Rego), then by Level.
    # Guidelines are summarized first per Technique, then named spells follow.

    # ===========================
    # CREO ANIMAL
    # ===========================

    #ARM000aR7kW3nB9xQ5tL1pF ^"Creo Animal Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
        }
        RULES {
            #ARM001bT4vH8mC2yS6jN0eG: Level 1: Give an animal a +1 bonus to Recovery rolls
            #ARM002cU5wJ9nD3zA7kP1fH: Level 2: Give an animal a +3 bonus to Recovery rolls; preserve a corpse from decay
            #ARM003dV6xK0oE4aB8lQ2gJ: Level 3: Give an animal a +6 bonus to Recovery rolls
            #ARM004eW7yL1pF5bC9mR3hK: Level 4: Give an animal a +9 bonus to Recovery rolls
            #ARM005fX8zM2qG6cD0nS4iL: Level 5: Create an animal product (Individual is one hide/hair/tusk); create an insect; give an animal a +12 bonus to Recovery rolls
            #ARM006gY9aN3rH7dE1oT5jM: Level 10: Create the corpse of an animal; create a bird, reptile, fish, or amphibian; give an animal a +15 bonus to Recovery rolls
            #ARM007hZ0bP4sJ8eF2pU6kN: Level 15: Heal a Light Wound; give an animal a +18 bonus to Recovery rolls; create a mammal; cause an animal to reach full maturity over a single day or night (Sun Duration)
            #ARM008iA1cQ5tK9fG3qV7lP: Level 20: Heal a Medium Wound; give an animal a +21 bonus to Recovery rolls; cause an animal to reach full maturity over about two hours
            #ARM009jB2dR6uL0gH4rW8mQ: Level 25: Stop a disease; heal a Heavy Wound; restore a lost sense; restore a lost limb; cure a disease (Momentary Ritual); cause full maturity over ten Diameters
            #ARM00AkC3eS7vM1hJ5sX9nR: Level 30: Heal an Incapacitating Wound; increase a Characteristic by one point (to no more than average); cause full maturity over a single Diameter
            #ARM00BlD4fT8wN2iK6tY0oS: Level 35: Heal all wounds; increase a Characteristic by one point (to no more than one above average)
            #ARM00CmE5gU9xP3jL7uZ1pT: Level 40: Increase a Characteristic by one point (to no more than two above average); cause full maturity in a moment
            #ARM00DnF6hV0yQ4kM8vA2qU: Level 45: Increase a Characteristic by one point (to no more than three above average)
            #ARM00EoG7iW1zR5lN9wB3rV: Level 50: Create a magical beast (Magic Might cannot exceed spell level, requisites for powers, Vim requisite always required); increase a Characteristic by one point (to no more than four above average)
            #ARM00FpH8jX2aS6mP0xC4sW: Level 55: Increase a Characteristic by one point (to no more than five above average; greater increase not within natural range)
            #ARM00GqJ9kY3bT7nQ1yD5tX: Level 75: Raise an animal from the dead
        }
    }

    # --- Creo Animal Spells ---

    #ARM00HrK0lZ4cU8oR2zE6uY ^"Soothe Pains of the Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base 15, +1 Touch"
        }
        RULES {
            #ARM00JsL1mA5dV9pS3aF7vZ: Cures one Light Wound suffered by the animal
        }
    }

    #ARM00KtM2nB6eW0qT4bG8wA ^"True Rest of the Injured Brute" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Moon"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +3 Moon"
        }
        RULES {
            #ARM00LuN3oC7fX1rU5cH9xB: The injured target gets a +9 bonus to all Recovery rolls made while the spell is in effect
        }
    }

    #ARM00MvP4pD8gY2sV6dJ0yC ^"Weaver's Trap of Webs" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +2 Voice, +2 Sun, +2 Group"
        }
        RULES {
            #ARM00NwQ5qE9hZ3tW7eK1zD: Creates a huge net of spider webs filling 5 paces by 5 paces by 6 feet high; webs are as thick as string and as strong as iron
            #ARM00PxR6rF0iA4uX8fL2aE: Everyone caught in the webs is immobilized; getting free requires a Strength stress roll of 12+, or someone not trapped can use an edged weapon (three rounds)
            #ARM00QyS7sG1jB5vY9gM3bF: Fire is ineffective against these webs; webs may continue to trap victims as long as the spell lasts
        }
    }

    #ARM00RzT8tH2kC6wZ0hN4cG ^"The Wizard's Mount" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +1 Touch, +2 Sun, +1 size"
        }
        RULES {
            #ARM00SaU9uJ3lD7xA1iP5dH: Creates a horse that is normal in every way except that it is not disturbed by The Gift
        }
    }

    #ARM00TbV0vK4mE8yB2jQ6eJ ^"Curse of the Ravenous Swarm" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 50
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Moon"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN true
            ^"Requisite" TEXT "Rego"
            ^"Design" TEXT "Base 5, +1 Touch, +3 Moon, +2 Group, +2 size, +1 Rego requisite"
        }
        RULES {
            #ARM00UcW1wL5nF9zC3kR7fK: Calls a swarm of locusts or other destructive insects upon an area, destroying wild plant life and fields
            #ARM00VdX2xM6oG0aD4lS8gL: When the spell ends, all insects disappear leaving nothing but the damage; the Rego requisite ensures the insects only devastate the area desired by the caster
            #ARM00WeY3yN7pH1bE5mT9hM: The swarm weighs as much as one thousand pigs; ritual because it has a really major effect
        }
    }

    # ===========================
    # INTELLEGO ANIMAL
    # ===========================

    #ARM00XfZ4zP8qJ2cF6nU0iN ^"Intellego Animal Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
        }
        RULES {
            #ARM00YgA5aQ9rK3dG7oV1jP: Level 1: Get a mental image of an animal
            #ARM00ZhB6bR0sL4eH8pW2kQ: Level 3: Sense the state of consciousness of a beast; get general information about an animal's body
            #ARM010iC7cS1tM5fJ9qX3lR: Level 4: Sense the dominant drive of a beast; learn a specific fact about an animal's body
            #ARM011jD8dT2uN6gK0rY4mS: Level 5: Learn the origin, age, and history of something made of animal products
            #ARM012kE9eU3vP7hL1sZ5nT: Level 10: Speak with an animal; read an animal's surface thoughts
            #ARM013lF0fV4wQ8iM2tA6oU: Level 15: Read the recent memories of a beast
            #ARM014mG1gW5xR9jN3uB7pV: Level 20: Thoroughly probe the mind of a beast
        }
    }

    # --- Intellego Animal Spells ---

    #ARM015nH2hX6yS0kP4vC8qW ^"Image of the Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +4 Arcane Connection"
        }
        RULES {
            #ARM016oJ3iY7zT1lQ5wD9rX: Gives you a hazy mental image of an animal you have an Arcane Connection to
            #ARM017pK4jZ8aU2mR6xE0sY: Wounds caused by an animal are an Arcane Connection to that animal with a lifetime of a few hours; this spell can be used to find out what was responsible for an attack
        }
    }

    #ARM018qL5kA9bV3nS7yF1tZ ^"Shiver of the Lycanthrope" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Touch"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Concentration, +1 Touch"
        }
        RULES {
            #ARM019rM6lB0cW4oT8zG2uA: You feel a sudden shiver if you are touching a person or beast that is actually a lycanthrope
            #ARM01AnN7mC1dX5pU9aH3vB: Variants of this spell detect other types of shapechanger, but not Bjornaer with Heartbeasts
        }
    }

    #ARM01BoP8nD2eY6qV0bJ4wC ^"Opening the Tome of the Animal's Mind" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +1 Touch, +1 Concentration"
        }
        RULES {
            #ARM01CpQ9oE3fZ7rW1cK5xD: You touch the head of the animal and read its memories of the past day
            #ARM01DqR0pF4gA8sX2dL6yE: Scanning the beast's memories without looking for anything specific yields what the beast thinks is most important
            #ARM01ErS1qG5hB9tY3eM7zF: Trying to get a specific fact requires a Perception + Finesse stress roll against Ease Factor 6, or 12 if the fact is obscure
            #ARM01FsT2rH6iC0uZ4fN8aG: Normal animals resist your touch and try to shy away both when the spell is cast and while it continues
        }
    }

    #ARM01GtU3sJ7jD1vA5gP9bH ^"Hunter's Sense" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Hearing"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Sun, +3 Hearing, +1 for shape and primary motivation"
        }
        RULES {
            #ARM01HuV4tK8kE2wB6hQ0cJ: You sense the shapes and primary motivations of all animals above a certain size that you can hear, or could hear if they were making a noise
            #ARM01JvW5uL9lF3xC7iR1dK: You decide the size threshold when you cast the spell (e.g. all animals larger than a fox)
            #ARM01KwX6vM0mG4yD8jS2eL: The noise of an animal's shape is louder the larger it is; the noise of its motivations increases with the intensity of the motivation
        }
    }

    # ===========================
    # MUTO ANIMAL
    # ===========================

    #ARM01LxY7wN1nH5zE9kT3fM ^"Muto Animal Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
        }
        RULES {
            #ARM01MyZ8xP2oJ6aF0lU4gN: Level 1: Make a superficial change to something made of animal products (like changing its color)
            #ARM01NzA9yQ3pK7bG1mV5hP: Level 2: Make a major change to something made of animal products that preserves the substance (e.g. leather jerkin into a saddle); make a superficial change to a beast
            #ARM01PaB0zR4qL8cH2nW6iQ: Level 3: Change an animal's limb; change something made of animal products into a different animal product
            #ARM01QbC1aS5rM9dJ3oX7jR: Level 4: Make a major change in a beast while leaving it recognizably the same sort of animal (e.g. make a horse bigger and change its color); change animal products in a minor unnatural way
            #ARM01RcD2bT6sN0eK4pY8kS: Level 5: Change an animal into a different animal; change an animal in a minor unnatural way (e.g. change a horse's coat color to match a coat of arms); change animal products in a major unnatural way
            #ARM01SdE3cU7tP1fL5qZ9lT: Level 10: Change an animal into a human (retains animal mentality, no soul, Corpus requisite); change an animal into a plant (Herbam requisite)
            #ARM01TeF4dV8uQ2gM6rA0mU: Level 15: Change an animal in a major unnatural way (e.g. give a horse claws, fangs, and scaly armored skin); change an animal into a non-living item (appropriate requisite)
            #ARM01UfG5eW9vR3hN7sB1nV: Level 25: Radically change an animal in an unnatural way (e.g. give a horse wings); give an animal a magical ability such as breathing fire (requisite for the ability)
        }
    }

    # --- Muto Animal Spells ---

    #ARM01VgH6fX0wS4iP8tC2oW ^"Beast of Outlandish Size" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun"
        }
        RULES {
            #ARM01WhJ7gY1xT5jQ9uD3pX: Changes the Size of an animal by +1
            #ARM01XiK8hZ2yU6kR0vE4qY: Modifies Strength by +2, the range for each wound level increases by one, and Quickness falls by one
            #ARM01YjL9iA3zV7lS1wF5rZ: The new beast is of huge size and looks much more impressive; townspeople may run in fear
        }
    }

    #ARM01ZkM0jB4aW8mT2xG6sA ^"Doublet of Impenetrable Silk" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun"
        }
        RULES {
            #ARM020lN1kC5bX9nU3yH7tB: Changes an item made of animal material (silk, wool, or leather) so it cannot be cut or penetrated by weapons
            #ARM021mP2lD6cY0oV4zJ8uC: A simple cloth doublet becomes equivalent to armor with no Load and a +3 Soak bonus
            #ARM022nQ3mE7dZ1pW5aK9vD: Armor made of quilted material or any kind of leather improves its Protection by an additional +3; this +3 bonus is the limit without changing the material
            #ARM023oR4nF8eA2qX6bL0wE: At storyguide's option, the bonus may not apply against strictly blunt weapons like clubs and staves
        }
    }

    #ARM024pS5oG9fB3rY7cM1xF ^"Growth of the Creeping Things" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun"
        }
        RULES {
            #ARM025qT6pH0gC4sZ8dN2yG: Causes an insect, mouse, toad, or other small (Size -8 or smaller) creature to grow to four times its normal size
            #ARM026rU7qJ1hD5tA9eP3zH: If it was venomous before, it is even more venomous now; semi-venomous creatures (like most spiders) have poison with Ease Factor 6 that does a Light Wound
            #ARM027sV8rK2iE6uB0fQ4aJ: A person bitten by a formerly venomous creature must make a Stamina stress roll against an Ease Factor of 9 or die from shock
        }
    }

    #ARM028tW9sL3jF7vC1gR5bK ^"Beast of Minuscule Proportions" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Voice, +2 Sun"
        }
        RULES {
            #ARM029uX0tM4kG8wD2hS6cL: Reduces the size of an animal by 2
            #ARM02AvY1uN5lH9xE3iT7dM: Modifies Strength by -4, reduces the range for each wound type by two points, and increases Quickness by +2
            #ARM02BwZ2vP6mJ0yF4jU8eN: The beast appears to be the runt of its litter
        }
    }

    #ARM02CxA3wQ7nK1zG5kV9fP ^"The Beast Remade" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Corpus"
            ^"Design" TEXT "Base 10, +1 Touch, +2 Sun, no addition for requisite"
        }
        RULES {
            #ARM02DyB4xR8oL2aH6lW0gQ: Gives one land beast a human form, though its intellect remains the same
            #ARM02EzC5yS9pM3bJ7mX1hR: Some feature of the animal is retained in the human form (e.g. a former dog might have an exceptionally hairy body, a former cat might let loose an occasional meow)
            #ARM02FaD6zT0qN4cK8nY2iS: Once transformed, the beast is disoriented for a while before it becomes used to its new body
        }
    }

    #ARM02GbE7aU1rP5dL9oZ3jT ^"Transformation of the Ravenous Beast to the Torpid Toad" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +2 Voice, +2 Sun"
        }
        RULES {
            #ARM02HcF8bV2sQ6eM0pA4kU: Turns any animal into a toad
            #ARM02JdG9cW3tR7fN1qB5lV: A newly created toad will hold a certain terror for peasants and serfs, because many believe toads exude a poisonous substance from their skin
        }
    }

    #ARM02KeH0dX4uS8gP2rC6mW ^"Steed of Vengeance" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +1 Touch, +2 Sun, +1 size"
        }
        RULES {
            #ARM02LfJ1eY5vT9hQ3sD7nX: Turns a horse into a ferocious magical mount with deep black coat, fiery red eyes, fangs, razor-sharp hooves, and occasional steam from its mouth
            #ARM02MgK2fZ6wU0iR4tE8oY: All its Attack rolls get a +5 bonus; the horse tolerates a magus rider
            #ARM02NhL3gA7xV1jS5uF9pZ: When the spell wears off, the horse must make a Stamina stress roll against an Ease Factor of 9 or die from shock
        }
    }

    # ===========================
    # PERDO ANIMAL
    # ===========================

    #ARM02PiM4hB8yW2kT6vG0qA ^"Perdo Animal Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
        }
        RULES {
            #ARM02QjN5iC9zX3lU7wH1rB: There is normally no Soak against Perdo Animal; magic does not create something that causes damage, it just causes damage; Magic Resistance is the only defense
            #ARM02RkP6jD0aY4mV8xJ2sC: Level 2: Damage something made of animal products
            #ARM02SlQ7kE1bZ5nW9yK3tD: Level 3: Do superficial damage to a beast (e.g. remove its hair)
            #ARM02TmR8lF2cA6oX0zL4uE: Level 4: Destroy something made of animal products; cause a beast pain but do no real damage; make a beast lose one Fatigue level
            #ARM02UnS9mG3dB7pY1aM5vF: Level 5: Injure an animal so it is hampered but not damaged (e.g. make a horse lame, a bird lose its voice); roughly halves effectiveness; recovery as from a Light Wound; destroy an animal's corpse; inflict a Light Wound
            #ARM02VoT0nH4eC8qZ2bN6wG: Level 10: Inflict a Medium Wound
            #ARM02WpU1oJ5fD9rA3cP7xH: Level 15: Destroy one of a beast's minor senses; inflict a Heavy Wound; cripple a beast's limb (unusable but could heal); age a beast by one-twelfth of its natural lifespan (only affects mature beasts)
            #ARM02XqV2pK6gE0sB4dQ8yJ: Level 20: Inflict an Incapacitating Wound; destroy or sever a beast's limb (cannot naturally regain); destroy one of a beast's major senses
            #ARM02YrW3qL7hF1tC5eR9zK: Level 30: Kill an animal
            #ARM02ZsX4rM8iG2uD6fS0aL: Level 40: Destroy one property of an animal, such as its weight or aggression
        }
    }

    # --- Perdo Animal Spells ---

    #ARM030tY5sN9jH3vE7gT1bM ^"Decay Fur and Hide" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Voice"
        }
        RULES {
            #ARM031uZ6tP0kJ4wF8hU2cN: Destroys an object made of animal fur or hide, including wool and leather
        }
    }

    #ARM032vA7uQ1lK5xG9iV3dP ^"Agony of the Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Voice, +1 Concentration"
        }
        RULES {
            #ARM033wB8vR2mL6yH0jW4eQ: After casting, the beast begins lashing wildly about, upsetting nearby objects, and howling in great pain
            #ARM034xC9wS3nM7zJ1kX5fR: In order to do anything else, the beast must make a Stamina + Size stress roll against an Ease Factor of 9 each round
        }
    }

    #ARM035yD0xT4oN8aK2lY6gS ^"Blunt the Viper's Fangs" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +2 Voice, +1 size"
        }
        RULES {
            #ARM036zE1yU5pP9bL3mZ7hT: Blunts the claws, teeth, talons, or other natural weapons of a beast; only sharp weapons may be affected (does not affect weapons such as a horse's hoof or a giant snake's coils)
            #ARM037aF2zV6qQ0cM4nA8iU: The blunted weapon has its total damage (including Attack Advantage) reduced to half (round up)
            #ARM038bG3aW7rR1dN5oB9jV: The beast may recover from the effect as if it were a Light Wound; affects animals of size up to +4
        }
    }

    #ARM039cH4bX8sS2eP6pC0kW ^"The Falcon's Hood" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 20, +1 Touch"
        }
        RULES {
            #ARM03AdJ5cY9tT3fQ7qD1lX: Destroys an animal's vision; the blindness heals as if it is a Medium Wound
            #ARM03BeK6dZ0uU4gR8rE2mY: The title refers to the hood used to cover a falcon's eyes when it is not hunting
        }
    }

    #ARM03CfL7eA1vV5hS9sF3nZ ^"Cripple the Howling Wolf" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +2 Voice"
        }
        RULES {
            #ARM03DgM8fB2wW6iT0tG4oA: One of the target's legs breaks cleanly; the animal cannot walk on that leg, but the damage heals as a Medium Wound
            #ARM03EhN9gC3xX7jU1uH5pB: The target need not be a wolf, and you cannot choose which leg
        }
    }

    # ===========================
    # REGO ANIMAL
    # ===========================

    #ARM03FiP0hD4yY8kV2vJ6qC ^"Rego Animal Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
        }
        RULES {
            #ARM03GjQ1iE5zZ9lW3wK7rD: General: Ward against beings associated with Animal from one supernatural realm (Divine, Faerie, Infernal, or Magic) with Might less than or equal to spell level (Touch, Ring, Circle)
            #ARM03HkR2jF6aA0mX4xL8sE: General: Create a circle warding against animals from one realm with Might less than or equal to spell level (Touch, Ring, Circle); animals are not necessarily associated with Animal, or vice versa
            #ARM03JlS3kG7bB1nY5yM9tF: Level 1: Manipulate items made from animal products
            #ARM03KmT4lH8cC2oZ6zN0uG: Level 2: Plant a single suggestion in the mind of an animal; protect the target from animal attacks (only affects animals without supernatural abilities); treat items made of animal products
            #ARM03LnU5mJ9dD3pA7aP1vH: Level 3: Treat and process items made of animal products
            #ARM03MoV6nK0eE4qB8bQ2wJ: Level 4: Calm an animal
            #ARM03NpW7oL1fF5rC9cR3xK: Level 5: Manipulate an animal's emotions; paralyze an animal; ward against animals or objects made from animal products (Touch, Ring, Circle); control a disembodied spirit associated with Animal; cause vermin to spontaneously generate in appropriate matter
            #ARM03PqX8pM2gG6sD0dS4yL: Level 10: Make an animal completely passive; transport an animal instantly up to 5 paces (add magnitudes: +1 for 50 paces, +2 for 500 paces, +3 for 1 league, +4 for seven leagues, +5 for Arcane Connection)
            #ARM03QrY9qN3hH7tE1eT5zM: Level 15: Completely control an animal; summon a disembodied spirit associated with Animal
        }
    }

    # --- Rego Animal Spells ---

    #ARM03RsZ0rP4iJ8uF2fU6aN ^"Ward against the Beasts of Legend" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 0
            ^"LevelType" TEXT "General"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "As ward guideline"
        }
        RULES {
            #ARM03StA1sQ5jK9vG3gV7bP: No magical beast whose Magic Might is equal to or less than the level of the spell can affect anyone within the Circle, or if it is within the Circle, affect those outside
            #ARM03TuB2tR6kL0wH4hW8cQ: A common gesture employed when making wards is the Fig Sign: the magus balls the right hand into a fist, placing the thumb between the index and middle fingers
        }
    }

    #ARM03UvC3uS7lM1xJ5iX9dR ^"Disguise of the Putrid Aroma" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Voice, +1 Concentration"
        }
        RULES {
            #ARM03VwD4vT8mN2yK6jY0eS: The target animal takes no interest in you as long as you continue to concentrate and do not threaten it
            #ARM03WxE5wU9nP3zL7kZ1fT: A carnivore treats you as if you were simply something it does not eat; it retains normal interest in anyone else nearby
        }
    }

    #ARM03XyF6xV0oQ4aM8lA2gU ^"Circle of Beast Warding" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +1 Touch, +2 Ring"
        }
        RULES {
            #ARM03YzG7yW1pR5bN9mB3hV: The caster inscribes a circle that no normal beast will cross
        }
    }

    #ARM03ZaH8zX2qS6cP0nC4iW ^"Soothe the Ferocious Bear" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Voice"
        }
        RULES {
            #ARM040bJ9aY3rT7dQ1oD5jX: Calms an animal until it is threatened or aroused again
            #ARM041cK0bZ4sU8eR2pE6kY: You must speak soothingly or musically to the animal; something as simple as approaching it may arouse it again
        }
    }

    #ARM042dL1cA5tV9fS3qF7lZ ^"Panic of the Elephant's Mouse" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +1 Eye, +1 Concentration"
        }
        RULES {
            #ARM043eM2dB6uW0gT4rG8mA: Makes an animal afraid of the target by preying upon its instinctive fears, causing it to attempt escape by the quickest, most feasible means possible
            #ARM044fN3eC7vX1hU5sH9nB: The animal may make a Size stress roll against an Ease Factor of 9 to resist
            #ARM045gP4fD8wY2iV6tJ0oC: The title refers to the elephant's legendary fear of mice, but this spell cannot actually affect elephants as they are too large
        }
    }

    #ARM046hQ5gE9xZ3jW7uK1pD ^"Viper's Gaze" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +1 Eye, +1 Concentration"
        }
        RULES {
            #ARM047iR6hF0yA4kX8vL2qE: Holds an animal rigid as long as you maintain eye contact with it and concentrate on it
        }
    }

    #ARM048jS7iG1zB5lY9wM3rF ^"The Gentle Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 10, +1 Eye, +1 Concentration, +1 size"
        }
        RULES {
            #ARM049kT8jH2aC6mZ0xN4sG: Calms an animal, making it nearly fearless; it does not resist being ridden, shaved, or whatever else you can think of
            #ARM04AlU9kJ3bD7nA1yP5tH: If the animal enters combat, is extremely frightened, or incurs any kind of wound, the spell ends
            #ARM04BmV0lK4cE8oB2zQ6uJ: The animal must be Size +4 or less
        }
    }

    #ARM04CnW1mL5dF9pC3aR7vK ^"Mastering the Unruly Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +1 Touch, +1 Concentration"
        }
        RULES {
            #ARM04DoX2nM6eG0qD4bS8wL: You can make an animal perform any act it is capable of; you can only issue new commands while touching the animal, but it will carry them out without constant contact
            #ARM04EpY3oN7fH1rE5cT9xM: The animal will allow you to touch it throughout the duration of the spell
            #ARM04FqZ4pP8gJ2sF6dU0yN: Difficult to maintain control of particularly stubborn or fierce animals; creatures with appropriate Personality Traits may roll against an Ease Factor of 12 each round
        }
    }

    #ARM04GrA5qQ9hK3tG7eV1zP ^"Commanding the Harnessed Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 15, +1 Touch, +2 Sun"
        }
        RULES {
            #ARM04HsB6rR0iL4uH8fW2aQ: You implant a complicated command into an animal, which it carries out to the best of its abilities
            #ARM04JtC7sS1jM5vJ9gX3bR: The command must involve completing a certain task (such as finding a certain person); vague orders like "protect me" do not work
            #ARM04KuD8tT2kN6wK0hY4cS: If the animal does not complete the task before the end of the spell approaches, it becomes desperately ferocious, especially at night
        }
    }
}
