EXTENSION "ARM5e_Spells_Imaginem" {
    NAME "Ars Magica 5th Edition Definitive - Imaginem Spells"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Magic"

    # Imaginem Form spells: affect images, sounds, and other sensory stimuli.
    # Basic Individual: an image that affects one sense.
    # Organized by Technique (Creo, Intellego, Muto, Perdo, Rego), then by Level.

    # ===========================
    # CREO IMAGINEM GUIDELINES
    # ===========================

    #ARMF00wK3nT8vB2qR6jX4hD ^"Creo Imaginem Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
        }
        RULES {
            #ARMF01pL5mY9cA7gN1eZ0sW: These spells create and restore images. Creo Imaginem spells only create the images of things, not the things themselves.
            #ARMF02rJ6wP0tX4bF8kQ2vM: Increasing the complexity of a sensory perception, such as making a moving visual image or making clear words instead of noise, adds an additional level of magnitude.
            #ARMF03yC9hU5lE1oS7iW3aG: Making an image move or make noise at your direction as you concentrate adds two levels of magnitude.
            #ARMF04fN2qD8vK4xB0rT6jP: Very intricate images are generally one level of magnitude higher as well.
            #ARMF05mZ7gL3cH9eA5sW1yU: Level 1: Create an image that affects a single sense.
            #ARMF06pR8tF2kN6wJ0bX4hD: Level 2: Create an image that affects two senses.
            #ARMF07dH7mL3sY9cA5gN1eZ: Level 3: Create an image that affects three senses.
            #ARMF08rJ6wP0tX4bF8kQ2vM: Level 4: Create an image that affects four senses.
            #ARMF09yC9hU5lE1oS7iW3aG: Level 5: Create an image that affects five senses.
        }
    }

    # ===========================
    # CREO IMAGINEM SPELLS
    # ===========================

    #ARMF0AwK3nT8vB2qR6jX4hD ^"Phantasm of the Talking Head" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Voice, +1 Diam, +1 intelligible speech"
        }
        RULES {
            #ARMF0BpL5mY9cA7gN1eZ0sW: Creates an illusory face on a wall or other flat object. The visage can speak during the spell's duration. Individual wizards' sigils can produce very interesting differences in how the voice sounds, how the face looks, and so on.
        }
    }

    #ARMF0CrJ6wP0tX4bF8kQ2vM ^"Phantasmal Animal" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +1 Diam, +2 move under your command"
        }
        RULES {
            #ARMF0DyC9hU5lE1oS7iW3aG: Creates an image of any animal or beast up to the size of a pony (Size +1). Under your direct mental command, it moves about (within range) and makes appropriate noises.
            #ARMF0EfN2qD8vK4xB0rT6jP: You need to be able to concentrate, and be within range, whenever you wish to direct the illusion to move in some manner. If you move out of range or stop concentrating, the illusion just freezes in place.
            #ARMF0FmZ7gL3cH9eA5sW1yU: The image does smell like an animal, but it has absolutely no effect on the sense of touch. A magus may not use this spell to create the image of an animal he or she does not know exists.
        }
    }

    #ARMF10pR8tF2kN6wJ0bX4hD ^"Phantasmal Fire" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Ignem"
            ^"Design" TEXT "Base 3, +2 Voice, +2 Sun, +1 for light from Ignem requisite"
        }
        RULES {
            #ARMF11dH7mL3sY9cA5gN1eZ: Makes an image of a fire (up to the size of a large campfire) that dances, illuminates, crackles, and (apparently) warms. It does not spread, burn, or protect against cold.
        }
    }

    #ARMF12rJ6wP0tX4bF8kQ2vM ^"Phantasm of the Human Form" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Voice, +2 Sun, +2 move at your command, +1 intricacy"
        }
        RULES {
            #ARMF13yC9hU5lE1oS7iW3aG: Makes an image of a clothed and equipped person that can make noise. Under your direct, unspoken command, the person can move about, speak, and behave as a human does.
        }
    }

    #ARMF14fN2qD8vK4xB0rT6jP ^"Haunt of the Living Ghost" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Intellego"
            ^"Design" TEXT "Base 2, +4 Arc, +1 Conc, +2 move at your command, +1 intricacy, +1 Intellego requisite"
        }
        RULES {
            #ARMF15mZ7gL3cH9eA5sW1yU: You can instantly project your own image and voice to any designated spot that you have an Arcane Connection to. You can see and hear through the image.
            #ARMF16pR8tF2kN6wJ0bX4hD: The image must appear in some medium, such as a fire, mirror, or pool.
            #ARMF17dH7mL3sY9cA5gN1eZ: Some magi use this spell to attend inter-covenant councils without traveling the intervening distance. Because other magi can see you, this spell is not held to constitute scrying by magic.
        }
    }

    #ARMF18rJ6wP0tX4bF8kQ2vM ^"The Shadow of Human Life" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Mentem"
            ^"Design" TEXT "Base 2, +1 Touch, +2 Sun, +1 intricacy, +6 Mentem requisite, for a very elaborate effect"
        }
        RULES {
            #ARMF19yC9hU5lE1oS7iW3aG: The human image created (as in Phantasm of the Human Form) has limited freedom and simulated intellect. It functions as an independent human, albeit a stupid one, capable of interpreting general orders in new situations.
        }
    }

    # ===========================
    # INTELLEGO IMAGINEM GUIDELINES
    # ===========================

    #ARMF1AfN2qD8vK4xB0rT6jP ^"Intellego Imaginem Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
        }
        RULES {
            #ARMF1BmZ7gL3cH9eA5sW1yU: These spells improve upon your senses by bringing in images not normally available. Each additional sense you wish to perceive increases the level of the spell by one magnitude.
            #ARMF1CpR8tF2kN6wJ0bX4hD: General: Discern illusions caused by spells of equal or lower level than the level of this spell (Vision target).
            #ARMF1DdH7mL3sY9cA5gN1eZ: Level 1: Use one sense at a distance. Memorize or perfect your memory about an image you have encountered. Be able to discern your own false images.
            #ARMF1ErJ6wP0tX4bF8kQ2vM: Level 2: Use two senses at a distance.
            #ARMF1FyC9hU5lE1oS7iW3aG: Level 3: Use three senses at a distance. Enhance one of your senses in one way (to see clearly at a distance, to see small things, or to see in the dark, for example).
            #ARMF20fN2qD8vK4xB0rT6jP: Level 4: Use four senses at a distance.
            #ARMF21mZ7gL3cH9eA5sW1yU: Level 5: Use all senses at a distance.
        }
    }

    # ===========================
    # INTELLEGO IMAGINEM SPELLS
    # ===========================

    #ARMF22pR8tF2kN6wJ0bX4hD ^"Discern the Images of Truth and Falsehood" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" TEXT "General"
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Conc"
        }
        RULES {
            #ARMF23dH7mL3sY9cA5gN1eZ: You can tell whether an image has been created or altered through a spell, seeing both the original and alterations. This spell must be at least 1 magnitude higher than an illusion in order to discern it.
            #ARMF24rJ6wP0tX4bF8kQ2vM: If you botch the spell, you mistake illusions for the real thing and reality for illusion.
            #ARMF25yC9hU5lE1oS7iW3aG: Your discernment is not limited to visual illusions, although you can only tell that a sound is illusory if you are looking at the apparent source.
        }
    }

    #ARMF26fN2qD8vK4xB0rT6jP ^"Prying Eyes" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +1 Touch, +1 Conc, +2 Room"
        }
        RULES {
            #ARMF27mZ7gL3cH9eA5sW1yU: You can see inside a room, as long as you can touch one of its walls. If the room is unlit or poorly lit, you can only see as much as you could if you were inside, but magical enhancements of your senses do apply.
            #ARMF28pR8tF2kN6wJ0bX4hD: You may change your viewpoint within the room throughout the duration of the spell.
        }
    }

    #ARMF29dH7mL3sY9cA5gN1eZ ^"Discern Own Illusions" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +2 Sun, +4 Vision"
        }
        RULES {
            #ARMF2ArJ6wP0tX4bF8kQ2vM: This spell makes your own illusions appear largely transparent to you, but still discernible.
        }
    }

    #ARMF2ByC9hU5lE1oS7iW3aG ^"The Ear for Distant Voices" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +4 Arc, +1 Conc, +2 Room"
        }
        RULES {
            #ARMF2CfN2qD8vK4xB0rT6jP: You can hear what is happening in the place you designate. You must have an Arcane Connection with the place or with a person there.
        }
    }

    #ARMF2DmZ7gL3cH9eA5sW1yU ^"Eyes of the Eagle" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Sun, +4 Vision"
        }
        RULES {
            #ARMF2EpR8tF2kN6wJ0bX4hD: You see distant things clearly. No matter how far away something is, you can make out details as if it were only a foot or so from you. Things do not all appear to be a foot away; you can simply make out details as well as if they were.
            #ARMF2FdH7mL3sY9cA5gN1eZ: You can still judge distance accurately; in fact, more accurately than normal, to within an inch or so at a distance of several miles.
        }
    }

    #ARMF30rJ6wP0tX4bF8kQ2vM ^"Summoning the Distant Image" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +4 Arc, +1 Conc, +2 Room"
        }
        RULES {
            #ARMF31yC9hU5lE1oS7iW3aG: You can see and hear what is happening in a distant place if you have some sort of Arcane Connection to either the location or a person there.
        }
    }

    # ===========================
    # MUTO IMAGINEM GUIDELINES
    # ===========================

    #ARMF32fN2qD8vK4xB0rT6jP ^"Muto Imaginem Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
        }
        RULES {
            #ARMF33mZ7gL3cH9eA5sW1yU: These are useful and powerful illusion spells, altering the visual image, noises, smell, or taste of some object or being. The image remains altered without your concentration and adapts itself appropriately to the medium.
            #ARMF34pR8tF2kN6wJ0bX4hD: The accuracy of duplication depends on your knowledge of the subject. Those more familiar with the face, voice, body, or other aspect being mimicked might see through an illusion by mundane means.
            #ARMF35dH7mL3sY9cA5gN1eZ: Muto Imaginem, or indeed other Imaginem magic, cannot overcome the effects of The Gift, although it might offset them a little.
            #ARMF36rJ6wP0tX4bF8kQ2vM: Level 1: Change one sensation of an object (for example, make a leaf look like a coin), but not its type (i.e. not from sight to sound).
            #ARMF37yC9hU5lE1oS7iW3aG: Level 2: Change two sensations of an object.
            #ARMF38fN2qD8vK4xB0rT6jP: Level 3: Transform species that affect one sense into those that affect another (for example, transform audible species into visual species, so that sounds can be seen). Change three sensations of an object.
            #ARMF39mZ7gL3cH9eA5sW1yU: Level 4: Change four sensations of an object.
            #ARMF3ApR8tF2kN6wJ0bX4hD: Level 5: Change the appearance of an object completely, in all things except solidity.
        }
    }

    # ===========================
    # MUTO IMAGINEM SPELLS
    # ===========================

    #ARMF3BdH7mL3sY9cA5gN1eZ ^"Taste of the Spices and Herbs" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF3CrJ6wP0tX4bF8kQ2vM: A setting's worth of food or drink tastes and smells exactly as you designate.
        }
    }

    #ARMF3DyC9hU5lE1oS7iW3aG ^"Aura of Ennobled Presence" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF3EfN2qD8vK4xB0rT6jP: The target appears more forceful, authoritative, and believable. Numerous subtle changes in appearance bring about this change, including a slight supernatural illumination of the face, a more erect posture, and a louder and smoother voice.
            #ARMF3FmZ7gL3cH9eA5sW1yU: The character gets a +3 on rolls to influence, lead, or convince others.
        }
    }

    #ARMF40pR8tF2kN6wJ0bX4hD ^"Notes of a Delightful Sound" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +1 Touch, +2 Sun, +2 Room"
        }
        RULES {
            #ARMF41dH7mL3sY9cA5gN1eZ: Causes all sounds in a room, particularly music, to be especially clear and sonorous. The notes are clearer, sharper, and more distinct.
        }
    }

    #ARMF42rJ6wP0tX4bF8kQ2vM ^"Disguise of the Transformed Image" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF43yC9hU5lE1oS7iW3aG: Makes someone look, sound, feel, and smell different, though at least passably human.
        }
    }

    #ARMF44fN2qD8vK4xB0rT6jP ^"Image Phantom" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF45mZ7gL3cH9eA5sW1yU: Any one thing, including a living thing, can be made to appear as if it were something else of approximately the same shape and size. The illusion cannot be cast on things that have a shape or size improper to the final appearance.
            #ARMF46pR8tF2kN6wJ0bX4hD: If the target moves or is moved in such a way that the illusion is inappropriate, it looks very strange indeed.
        }
    }

    # ===========================
    # PERDO IMAGINEM GUIDELINES
    # ===========================

    #ARMF47dH7mL3sY9cA5gN1eZ ^"Perdo Imaginem Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
        }
        RULES {
            #ARMF48rJ6wP0tX4bF8kQ2vM: These spells dull the sensual properties of things -- making wine tasteless, sneaks silent, and magi invisible. Destroying changing images is more difficult -- add one level of magnitude to spells that do so.
            #ARMF49yC9hU5lE1oS7iW3aG: Images are naturally generated constantly, so a Perdo Imaginem spell with Momentary duration merely makes an object seem to flicker for a moment. Longer durations are required if the image is to stay gone.
            #ARMF4AfN2qD8vK4xB0rT6jP: Shadows are due to the physical body blocking the light. Destroying something's shadow is thus Creo Ignem, or possibly Rego Ignem, not Perdo Imaginem.
            #ARMF4BmZ7gL3cH9eA5sW1yU: Mirror images, however, are caused by the species bouncing off the mirror, so a spell destroying (or changing) the species also changes mirror images.
            #ARMF4CpR8tF2kN6wJ0bX4hD: Level 2: Destroy an object's ability to affect taste or touch.
            #ARMF4DdH7mL3sY9cA5gN1eZ: Level 3: Destroy an object's ability to affect smell or hearing. Destroy an object's ability to affect taste and touch.
            #ARMF4ErJ6wP0tX4bF8kQ2vM: Level 4: Destroy an object's ability to affect sight. Destroy an object's ability to affect any three of taste, touch, smell, or hearing.
            #ARMF4FyC9hU5lE1oS7iW3aG: Level 5: Destroy an object's ability to affect any four senses.
            #ARMF50fN2qD8vK4xB0rT6jP: Level 10: Destroy an object's ability to affect all five senses.
        }
    }

    # ===========================
    # PERDO IMAGINEM SPELLS
    # ===========================

    #ARMF51mZ7gL3cH9eA5sW1yU ^"Dispel the Phantom Image" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" TEXT "General"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARMF52pR8tF2kN6wJ0bX4hD: Destroys the image from any one CrIm spell whose level you match or exceed on a stress die + the level of your spell.
        }
    }

    #ARMF53dH7mL3sY9cA5gN1eZ ^"Taste of the Dulled Tongue" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF54rJ6wP0tX4bF8kQ2vM: Hides the taste of any substance, liquid or solid.
        }
    }

    #ARMF55yC9hU5lE1oS7iW3aG ^"Illusion of Cool Flames" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Voice, +2 Sun"
        }
        RULES {
            #ARMF56fN2qD8vK4xB0rT6jP: A source of heat, such as a fire, seems to lose its heat and drop to the surrounding temperature. It still, however, has its normal beneficial and harmful effects (that is, glowing coals still cook meat or burn a person's hand, though they do not feel hot).
        }
    }

    #ARMF57mZ7gL3cH9eA5sW1yU ^"Invisibility of the Standing Wizard" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun"
        }
        RULES {
            #ARMF58pR8tF2kN6wJ0bX4hD: The target becomes invisible, but the spell is broken if the target moves (aside from breathing and shifting slightly in place). He still casts a shadow.
        }
    }

    #ARMF59dH7mL3sY9cA5gN1eZ ^"Veil of Invisibility" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun, +1 changing image"
        }
        RULES {
            #ARMF5ArJ6wP0tX4bF8kQ2vM: The target becomes completely undetectable to normal sight, regardless of what it does, but still casts a shadow.
        }
    }

    #ARMF5ByC9hU5lE1oS7iW3aG ^"Removal of the Conspicuous Sigil" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Part"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun, +1 Part"
        }
        RULES {
            #ARMF5CfN2qD8vK4xB0rT6jP: Grooves, runes, writings, and similar markings are obscured so that they are not visible, but the overall shape of the medium remains constant. For example, runes carved into a sword blade can be made invisible, making the sword appear normal.
        }
    }

    #ARMF5DmZ7gL3cH9eA5sW1yU ^"Silence of the Smothered Sound" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +2 Sun, +1 changing image"
        }
        RULES {
            #ARMF5EpR8tF2kN6wJ0bX4hD: Makes one being or object incapable of producing sound. Magi who cannot utter their magic words suffer the normal penalties to their spellcasting rolls.
        }
    }

    #ARMF5FdH7mL3sY9cA5gN1eZ ^"Chamber of Invisibility" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Sun, +2 Group"
        }
        RULES {
            #ARMF60rJ6wP0tX4bF8kQ2vM: Causes a Group of creatures to become invisible. Any affected character who moves or is touched makes everyone visible. All members of the Group still cast shadows.
        }
    }

    #ARMF61yC9hU5lE1oS7iW3aG ^"Confusion of the Insane Vibrations" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +1 Touch, +1 Conc, +4 Vision, +1 additional senses"
        }
        RULES {
            #ARMF62fN2qD8vK4xB0rT6jP: The target of the spell sees everything vibrate back and forth at varying high speeds. In addition, sounds are displaced and seem to come from the wrong areas.
            #ARMF63mZ7gL3cH9eA5sW1yU: Anyone trying to fight in these circumstances suffers -3 on Attack and Defense scores, and must roll two extra botch dice. The target is likely to become desperate and terribly confused.
            #ARMF64pR8tF2kN6wJ0bX4hD: Navigation is exceedingly difficult. The visual effects of this spell are negated if the target is in complete darkness or if they close their eyes.
        }
    }

    # ===========================
    # REGO IMAGINEM GUIDELINES
    # ===========================

    #ARMF65dH7mL3sY9cA5gN1eZ ^"Rego Imaginem Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guideline"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
        }
        RULES {
            #ARMF66rJ6wP0tX4bF8kQ2vM: These spells make things appear to be somewhere other than where they actually are. As with CrIm and PeIm, it is slightly harder to affect changing images. Add one level of magnitude to spells that do so.
            #ARMF67yC9hU5lE1oS7iW3aG: Add a further level of magnitude if the image is to change along with the object. Add one level of magnitude to the guidelines for each additional sense to be affected.
            #ARMF68fN2qD8vK4xB0rT6jP: General: Ward against beings associated with Imaginem from one supernatural realm (Divine, Faerie, Infernal, or Magic) with Might less than or equal to the level of the spell (Touch, Ring, Circle).
            #ARMF69mZ7gL3cH9eA5sW1yU: Level 2: Make an object appear (to one sense) to be up to one pace away from its actual position.
            #ARMF6ApR8tF2kN6wJ0bX4hD: Level 3: Make an object appear (to one sense) to be up to five paces away from its actual position. Make objects appear to move rapidly in a disorientating way.
            #ARMF6BdH7mL3sY9cA5gN1eZ: Level 4: Make an object appear (to one sense) to be up to fifteen paces from its actual position. Make an object appear (to one sense) to be contained in or attached to another object defined at the time of casting (for example, make someone's voice appear to come from within a bag).
            #ARMF6CrJ6wP0tX4bF8kQ2vM: Level 5: Make an object appear (to one sense) to be up to one hundred paces from its actual position. Control a disembodied spirit associated with Imaginem.
            #ARMF6DyC9hU5lE1oS7iW3aG: Level 10: Make an object appear (to one sense) to be in Sight of its actual position.
            #ARMF6EfN2qD8vK4xB0rT6jP: Level 15: Make an object appear (to one sense) to be in a location that the caster has an Arcane Connection to. Summon a disembodied spirit associated with Imaginem.
        }
    }

    # ===========================
    # REGO IMAGINEM SPELLS
    # ===========================

    #ARMF6FmZ7gL3cH9eA5sW1yU ^"Restore the Moved Image" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" TEXT "General"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARMF70pR8tF2kN6wJ0bX4hD: Cancels a ReIm spell that moves an image, putting the image back where it belongs, as long as you can match the spell's level on a stress die + the level of your spell. This spell targets the image.
        }
    }

    #ARMF71dH7mL3sY9cA5gN1eZ ^"Illusion of the Shifted Image" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Voice, +2 Sun"
        }
        RULES {
            #ARMF72rJ6wP0tX4bF8kQ2vM: Makes any person or object appear to be a pace away from its actual position. The image cannot be placed in a solid object. As soon as the original or image moves, the spell ends.
        }
    }

    #ARMF73yC9hU5lE1oS7iW3aG ^"Wizard's Sidestep" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +2 Sun, +1 changing image, +1 moved image matches changes"
        }
        RULES {
            #ARMF74fN2qD8vK4xB0rT6jP: Your image appears up to 1 pace from where you actually are, so attacks aimed there are likely to miss you. Whenever the image is successfully struck, it disappears and reappears in another spot.
            #ARMF75mZ7gL3cH9eA5sW1yU: In combat, early attacks are aimed at the image, and so automatically miss you. Once the image has been hit once, you have a +9 bonus to Defense, as attackers must try to find you in a fairly large area.
        }
    }

    #ARMF76pR8tF2kN6wJ0bX4hD ^"The Captive Voice" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Part"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Voice, +2 Sun, +1 Part, +1 changing image"
        }
        RULES {
            #ARMF77dH7mL3sY9cA5gN1eZ: Captures a person's voice and places it in a bag. The person may not speak unless the bag is open, in which case the voice comes from the bag, not the victim's mouth.
            #ARMF78rJ6wP0tX4bF8kQ2vM: If the victim screams while the bag is shut, the bag vibrates visibly.
        }
    }

    #ARMF79yC9hU5lE1oS7iW3aG ^"Image from the Wizard Torn" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Intellego"
            ^"Design" TEXT "Base 15, +1 Conc, +1 additional sense, +1 moving image, +1 Intellego requisite"
        }
        RULES {
            #ARMF7AfN2qD8vK4xB0rT6jP: Your image separates from your body. It can speak whatever you say and do so in your voice, and you can see through its eyes.
            #ARMF7BmZ7gL3cH9eA5sW1yU: You must make an Int + Concentration stress roll for each solid object the image passes through and for each mile it travels. If you wish the image to be able to leave your sight, you must use an Arcane Connection to yourself (for example, a fingernail or a lock of hair).
            #ARMF7CpR8tF2kN6wJ0bX4hD: That connection becomes an integral part of the image, and when the spell ends, it falls to the ground wherever the image was located.
            #ARMF7DdH7mL3sY9cA5gN1eZ: As your image is away from your body, you are invisible and silent at your actual location. The image is your image, so while you may move it in space you may not have it sit down if you are standing. Further, it appears as if illuminated by whatever light is falling on you, no matter what the level of illumination is at the image.
        }
    }

    #ARMF7ErJ6wP0tX4bF8kQ2vM ^"Illusion of the Misplaced Castle" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 50
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Boundary"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base 10, +2 Voice, +2 Sun, +4 Bound"
        }
        RULES {
            #ARMF7FyC9hU5lE1oS7iW3aG: Moves the image of any bounded structure or set of structures the size of a castle or less up to one mile from its actual position.
        }
    }
}
