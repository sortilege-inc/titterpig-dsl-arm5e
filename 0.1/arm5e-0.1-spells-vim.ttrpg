EXTENSION "ARM5e_Spells_Vim" {
    NAME "Ars Magica 5th Edition Definitive - Vim Spells"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Magic"

    # Vim Form spells: affect raw magical power and other supernatural forces.
    # Basic Individual: a single spell or enchantment, or the amount of raw vis in a single pawn.
    # Organized by Technique (Creo, Intellego, Muto, Perdo, Rego), then by Level.
    #
    # Many Vim spells are General level because the magic they affect varies
    # widely in power. The guidelines give the relationship between the Vim
    # spell's level and the level of the target spell, rather than an absolute level.
    # When changing Range, Duration, or Target, the change in level should be
    # accounted for before multiplying or dividing the spell level to get the effect.
    #
    # The Individual target for a Vim spell can refer to either an individual
    # spell, or an individual object or person; similarly for Group.

    # ===========================
    # CREO VIM GUIDELINES
    # ===========================
    # Creo Vim botches often give the caster additional Warping Points.
    #
    # General:
    #   - Create a magical shell which looks real to InVi spells with level
    #     <= twice its level plus one magnitude (generic 'magic' only).
    #   - Create a magical shell which prevents InVi spells with level
    #     <= its level plus one magnitude from learning details about magic on target.
    #   - Create a magical shell giving false information to InVi spells
    #     with level <= half its (level plus one magnitude).
    #   - Refresh all spell traces within target less than magnitude of
    #     guideline -1, in negative magnitude, restoring them to initial strength.
    # Level 3: Taint something with magic.
    # Level 4: Create a temporary Arcane Connection to a target within range
    #          (cannot be fixed in lab, does not itself give Penetration bonus,
    #          but allows other Penetration-boosting methods and spells on target
    #          even if no longer perceived; must Penetrate Magic Resistance).
    # Level 5: Create a burst of magic giving target one Warping Point
    #          (duration cannot exceed Momentary; doing this to a magus is
    #          an attack and against the Code).
    #        - Decrease rate of decay of an Arcane Connection as if one step
    #          higher on the table (p.220); cannot make indefinite without fixing.
    # Level 10: Give target two Warping Points.
    #         - Decrease Arcane Connection decay by two steps.
    # Level 15: Give target three Warping Points.
    #         - Decrease Arcane Connection decay by three steps.

    # ===========================
    # CREO VIM SPELLS
    # ===========================

    # --- GENERAL ---

    #ARM1180aB2cD4eF6gH8iJ0k ^"Shell of False Determinations" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM1181bC3dE5fG7hI9jK1l: Creates a shell of magic on an item, helping to shield it from investigation by other magi
            #ARM1182cD4eF6gH8iJ0kL2m: All attempts to investigate the magic item give false information about its powers unless half of the level of the shell is exceeded by the magus's Investigation roll
        }
    }

    #ARM1183dE5fG7hI9jK1lM3n ^"Shell of Opaque Mysteries" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM1184eF6gH8iJ0kL2mN4o: Similar to Shell of False Determinations, but causes all attempts to investigate the magic item to utterly fail unless the level of the ritual is exceeded by the magus's Investigation roll
            #ARM1185fG7hI9jK1lM3nO5p: Once a magus determines the presence of this shell (by overcoming it), it has no more power against him or her
        }
    }

    #ARM1186gH8iJ0kL2mN4oP6q ^"Restore the Faded Threads" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Circle"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base, +1 Touch, +1 Dia"
        }
        RULES {
            #ARM1187hI9jK1lM3nO5pQ7r: Temporarily restores spell traces to a fresh state (as if they had just expired), making them examinable
            #ARM1188iJ0kL2mN4oP6qR8s: Restores spell traces of negative magnitude up to the magnitude of this spell minus 3; the trace must still be existent (magnitude -9 or greater)
            #ARM1189jK1lM3nO5pQ7rS9t: Versions of this spell also exist for all standard Targets; Diameter duration is normally long enough to conduct Intellego Vim investigations of the trace
        }
    }

    # --- LEVEL 15 ---

    #ARM118AkL2mN4oP6qR8sT0u ^"The Phantom Gift" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +2 Sun"
        }
        RULES {
            #ARM118BlM3nO5pQ7rS9tU1v: The target becomes tainted with magic as most magi are; beasts and people react to the target as though he were a magus
            #ARM118CmN4oP6qR8sT0uV2w: Those who normally associate with the victim do not become hostile, but do give him or her a wider berth
            #ARM118DnO5pQ7rS9tU1vW3x: The spell has no effect on those who already have The Gift, including those blessed with the Gentle Gift
        }
    }

    # --- LEVEL 30 ---

    #ARM118EoP6qR8sT0uV2wX4y ^"The Enigma's Gift" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 20, +2 Voice"
        }
        RULES {
            #ARM118FpQ7rS9tU1vW3xY5z: The target gains four Warping Points (plus the normal one for being affected by a powerful supernatural effect, in most cases)
            #ARM1190qR8sT0uV2wX4yZ6a: If the target is a Hermetic magus, must check to see whether he enters Twilight in the normal way
            #ARM1191rS9tU1vW3xY5zA7b: Although the burst of magic that causes the Warping lasts but a moment, the resulting Warping is permanent
        }
    }

    # ===========================
    # INTELLEGO VIM GUIDELINES
    # ===========================
    # Intellego Vim botches generally give false information.
    # Demons cannot be detected (they are made of the essence of deception).
    # Magic items require laboratory investigation; spells only tell if an item is magical.
    #
    # Base detection also gives a fairly good idea of the strength of the magic (within a magnitude).
    #   +1 magnitude: says whether effect is Hermetic (or other familiar type).
    #   +2 magnitudes: gives Technique and Form information (or nearest equivalent).
    #   +3 magnitudes: gives rough details of the effect, sigil of caster, and whether
    #                  effect was created by a spell or invested device.
    #
    # Different spells may be invented to detect Faerie, Divine, or Infernal effects
    # (each spell only affects one realm).
    #
    # Residue decline: magnitude halves when magic finishes, then drops by one per
    # duration that passes. At zero, non-Ritual Momentary/Conc/Diam residues drop
    # by one per month; others drop by one per year. Negative magnitude -10 = gone.
    #
    # General: Detect traces of magic of negative magnitude up to magnitude of guideline - 2.
    # Level 1: Detect magic of tenth magnitude or higher.
    #        - Detect the presence of a supernatural aura.
    #        - Detect the presence of vis.
    # Level 2: Detect magic of eighth magnitude or higher.
    #        - Determine the power of a supernatural aura.
    # Level 3: Detect magic of sixth magnitude or higher.
    #        - Detect regio boundaries (with Vision target, provides enough info to find a way between levels).
    # Level 4: Detect magic of third magnitude or higher.
    #        - Judge the amount of vis present.
    #        - Discern the Art of vis.
    # Level 5: Detect any active magic.

    # ===========================
    # INTELLEGO VIM SPELLS
    # ===========================

    # --- GENERAL ---

    #ARM1192sT0uV2wX4yZ6aB8c ^"The Invisible Eye Revealed" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Touch"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARM1193tU1vW3xY5zA7bC9d: The caster can feel any magical means currently being used to spy on him; the representation varies depending on the spell (e.g. wet fingers for Enchantment of the Scrying Pool, a finger running over skin for The Inexorable Search)
            #ARM1194uV2wX4yZ6aB8cD0e: Detects the use of Intellego spells of up to double the level of this spell
            #ARM1195vW3xY5zA7bC9dE1f: A special spell is required because most Intellego spells are designed to be subtle, and they are more subtle at higher levels
        }
    }

    # --- LEVEL 2 ---

    #ARM1196wX4yZ6aB8cD0eF2g ^"Sense of Magical Power" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 2
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +1 Touch"
        }
        RULES {
            #ARM1197xY5zA7bC9dE1fG3h: Tells the caster whether he is currently in a Magic aura; does not give any further information
            #ARM1198yZ6aB8cD0eF2gH4i: Other spells do the same for other kinds of aura (Faerie, Divine, Infernal)
        }
    }

    # --- LEVEL 5 ---

    #ARM1199zA7bC9dE1fG3hI5j ^"Scales of the Magical Weight" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch"
        }
        RULES {
            #ARM119AaB8cD0eF2gH4iJ6k: You sense how heavy an unknown amount of vis is in relation to a known amount (typically one pawn of Vim vis in the other hand), determining the number of pawns present
            #ARM119BbC9dE1fG3hI5jK7l: If cast without anything to measure against, you only have a very general idea of how valuable the vis is
            #ARM119CcD0eF2gH4iJ6kL8m: Cannot be used to determine the amount of raw vis invested in an enchanted item
        }
    }

    #ARM119DdE1fG3hI5jK7lM9n ^"Sense the Nature of Vis" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch"
        }
        RULES {
            #ARM119EeF2gH4iJ6kL8mN0o: You can tell what Art a supply of raw vis is connected to; the vis appears to glow with an aura appropriate to the Technique or Form
            #ARM119FfG3hI5jK7lM9nO1p: Aura colors: Creo white, Intellego gold, Muto constantly fluctuating, Perdo black, Rego purple, Animal brown, Aquam blue, Auram violet, Corpus dark red, Herbam green, Imaginem pearly blue, Ignem bright red, Mentem orange, Terram dark brown, Vim silver
        }
    }

    # --- LEVEL 20 ---

    #ARM11A0gH4iJ6kL8mN0oP2q ^"Piercing the Faerie Veil" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +1 Conc, +4 Vision"
        }
        RULES {
            #ARM11A1hI5jK7lM9nO1pQ3r: Allows the caster to see through the boundaries of Faerie regiones, and therefore divine the path to the next level
            #ARM11A2iJ6kL8mN0oP2qR4s: There are separate but related spells for Divine, Magical, and Infernal regiones (Piercing the Divine Veil, Piercing the Magical Veil, Piercing the Infernal Veil)
        }
    }

    # --- LEVEL 30 ---

    #ARM11A3jK7lM9nO1pQ3rS5t ^"Sense of the Lingering Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Hearing"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 10, +1 Conc, +3 Hearing"
        }
        RULES {
            #ARM11A4kL8mN0oP2qR4sT6u: Can detect the presence of many magical residues, even from weak spells, as well as giving the presence and power of active spells
            #ARM11A5lM9nO1pQ3rS5tU7v: Does not grant any information apart from the power; the residue must be of at least zero magnitude
        }
    }

    # --- LEVEL 40 ---

    #ARM11A6mN0oP2qR4sT6uV8w ^"Sight of the Active Magics" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +1 Conc, +4 Vision, +2 Techniques and Forms"
        }
        RULES {
            #ARM11A7nO1pQ3rS5tU7vW9x: You can see spells as auras around things and people; color indicates the Form of the spell (matching the Sense the Nature of Vis color scheme), shape indicates the Technique
            #ARM11A8oP2qR4sT6uV8wX0y: Technique aura shapes: Creo and Rego are very orderly; Muto is constantly shifting; Intellego shifts slowly; Perdo is usually in fragments
            #ARM11A9pQ3rS5tU7vW9xY1z: Imaginem or Vim spells may be used to disguise auras; this spell will also detect the residues of some spells
        }
    }

    # ===========================
    # MUTO VIM GUIDELINES
    # ===========================
    # Special restrictions for all Muto Vim spells:
    #   - Cannot be cast on Spontaneous spells (would cause loss of control).
    #   - If casting both spells yourself, Intelligence + Concentration roll vs EF 9.
    #   - To cast on another magus's spell, must be cooperating or fast-cast the MuVi spell;
    #     Penetration total for MuVi must beat other magus's Penetration (unless cooperating).
    #   - Touch range suffices for own spells; Voice range needed for another magus's casting.
    #   - Can only be used on Hermetic magic.
    #   - MuVi effect in a magical item can only affect other effects in that same item.
    #   - Cannot affect a spell after it has been cast.
    #   - If changed parameters would require a Ritual, at least one of the original spell
    #     or MuVi spell must be a Ritual.
    #   - MuVi spell must have duration at least as long as the casting of the target spell
    #     (Momentary suffices for normally-cast Formulaic; Sun suffices for any Ritual).
    #   - An increase in power or parameters may not raise the level of the target spell
    #     above the level of the MuVi spell.
    #
    # General:
    #   - Superficially change a spell of level <= twice the (level + 1 magnitude) of the
    #     Vim spell. May not change primary effect or power.
    #   - Significantly change a spell of level <= the level + 1 magnitude of the Vim spell.
    #     May not change Technique or Form. +/- 1 magnitude is a significant change.
    #   - Totally change a spell of level <= half the (level + 1 magnitude) of the Vim spell.
    #     May change Technique, Form, or both (no requisites needed). +/- 2 magnitudes
    #     is a total change; greater requires Creo or Perdo.

    # ===========================
    # MUTO VIM SPELLS
    # ===========================

    # --- GENERAL ---

    #ARM11B0qR4sT6uV8wX0yZ2a ^"Mirror of Opposition (Form)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice"
        }
        RULES {
            #ARM11B1rS5tU7vW9xY1zA3b: Cast on another spell while it is being cast; causes the targeted spell to have the exact opposite of its normal effects
            #ARM11B2sT6uV8wX0yZ2aB4c: Works on spells up to half the (level - 5) of the Mirror of Opposition spell; effects of the inversion are up to the storyguide
            #ARM11B3tU7vW9xY1zA3bC5d: The target of the inverted spell usually remains the same as that of the original; the inverted spell cannot overcome any limitations of Hermetic magic
            #ARM11B4uV8wX0yZ2aB4cD6e: There are ten versions of this spell, each affecting spells of one of the Hermetic Forms
        }
    }

    #ARM11B5vW9xY1zA3bC5dE7f ^"Shroud Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM11B6wX0yZ2aB4cD6eF8g: Allows a magus to suppress or alter the sigil in a spell that is currently being cast
            #ARM11B7xY1zA3bC5dE7fG9h: The spell to be shrouded can be up to double the Shroud's level
            #ARM11B8yZ2aB4cD6eF8gH0i: Shroud Magic has the same sigil (or lack of) as that given to the shrouded spell
        }
    }

    #ARM11B9zA3bC5dE7fG9hI1j ^"The Sorcerer's Fork" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM11C0aB4cD6eF8gH0iJ2k: Splits another spell (whose level must be <= the level of this spell) into two or more identical spells of reduced power, which may be cast against separate targets
            #ARM11C1bC5dE7fG9hI1jK3l: Each resulting spell has the same Range and Target (category) as the original, but the power of the effect is divided by the number of split spells
            #ARM11C2cD6eF8gH0iJ2kL4m: One casting die is rolled and the Penetration total is split between the spells; the split spell has a targeting penalty as for multiple casting
            #ARM11C3dE7fG9hI1jK3lM5n: If the casting magus is not cooperating, all the split spells will strike the original target
        }
    }

    #ARM11C4eF8gH0iJ2kL4mN6o ^"Wizard's Boost (Form)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM11C5fG9hI1jK3lM5nO7p: Cast as another spell of a level <= this one is cast; the effect of the other spell increases 5 levels in power, but not past the level of the Wizard's Boost
            #ARM11C6gH0iJ2kL4mN6oP8q: A Wizard's Boost may never affect a single spell more than once
            #ARM11C7hI1jK3lM5nO7pQ9r: There are ten versions of this spell, one for each Hermetic Form
        }
    }

    #ARM11C8iJ2kL4mN6oP8qR0s ^"Wizard's Communion" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARM11C9jK3lM5nO7pQ9rS1t: Lets magi combine their power to cast spells; one extra magus may join for each 5 levels of the specified spell being cast
            #ARM11CAkL4mN6oP8qR0sT2u: One of the magi in the group must also know the specified spell or cast it from a Casting Tablet; only one magus needs to cast the specified spell
            #ARM11CBlM5nO7pQ9rS1tU3v: If more than one magus casts Wizard's Communion, add total levels to get effective level; combined total must be at least twice the level of the specified spell
            #ARM11CCmN6oP8qR0sT2uV4w: Target number for the spellcasting roll is the spell's level divided by the number of magi participating in the Communion
            #ARM11CDnO7pQ9rS1tU3vW5x: This method adds one botch die per magus participating; if botch, all participants gain Warping Points and must check for Twilight if they gain two or more
            #ARM11CEoP8qR0sT2uV4wX6y: Communion is a remnant of Mercurian rituals, so it does not perfectly fit into the guidelines of Hermetic theory
        }
    }

    #ARM11CFpQ9rS1tU3vW5xY7z ^"Wizard's Reach (Form)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice"
        }
        RULES {
            #ARM11D0qR0sT2uV4wX6yZ8a: The range of the targeted spell increases by one category
            #ARM11D1rS1tU3vW5xY7zA9b: You may not affect a single spell more than once with this spell; the targeted spell must be at least one magnitude lower in level than this spell
            #ARM11D2sT2uV4wX6yZ8aB0c: There are ten versions of Wizard's Reach, one for each Form
        }
    }

    #ARM11D3tU3vW5xY7zA9bC1d ^"Wizard's Vigil" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice"
        }
        RULES {
            #ARM11D4uV4wX6yZ8aB0cD2e: Functions as Wizard's Communion, except that the longer duration allows it to be used with Ritual spells
            #ARM11D5vW5xY7zA9bC1dE3f: For purposes of its effect, treat it as a Wizard's Communion of two magnitudes lower
        }
    }

    # ===========================
    # PERDO VIM GUIDELINES
    # ===========================
    # Most Perdo Vim spells are specific to one of the four Supernatural Realms.
    # If casting on a character with Magic Resistance, must overcome it.
    #
    # General:
    #   - Make something (including a magical item) seem non-magical to any InVi
    #     spell of level <= twice the (level + 2 magnitudes) of this spell.
    #   - Dispel effects of a specific type with level <= level + 4 magnitudes of the
    #     Vim spell + a stress die (no botch). (Specific type = e.g. Hermetic Terram magic.)
    #   - Reduce target's Might Score by level + 2 magnitudes (must Penetrate).
    #   - Reduce target's Might Pool by level + 2 magnitudes (must Penetrate).
    #   - Dispel any supernatural effect of one realm with level <= half the (level + 4
    #     magnitudes + stress die (no botch)).
    #   - Reduce casting total for all supernatural powers of one realm by half the
    #     (level + 2 magnitudes); multiple spells do not stack; must Penetrate.
    #   - Reduce casting total for a specific type of supernatural effect by (level + 2
    #     magnitudes); multiple spells do not stack; must Penetrate.
    #   - Age a spell trace to a negative magnitude equal to the guideline used.
    #   - Dispel a Hermetic enchantment with level < guideline level + 1 magnitude
    #     + stress die (no botch). Must be a Ritual.
    #   - Dispel a specific type of enchantment with level < twice the guideline level
    #     + 2 magnitudes + stress die (no botch). Must be Ritual.
    #   - Dispel Hermetic Form Resistance aligned to a given Form with level <=
    #     level of Vim spell + 2 magnitudes + stress die (no botch). Must Penetrate
    #     Vim-based Magic Resistance.
    #   - Dispel Magic Resistance from a Might score aligned to one Realm with level <=
    #     level of Vim spell + 4 magnitudes + stress die (no botch). Must Penetrate.
    #   - Destroy an amount of raw vis equal to the level of the spell.
    # Level 5: Reduce duration of an Arcane Connection by one step (if reduced below
    #          Hours, expires immediately; does not work on naturally Indefinite connections
    #          but can affect fixed connections).
    # Level 10: Reduce Arcane Connection duration by two steps.
    # Level 15: Reduce Arcane Connection duration by three steps.
    # Level 20: Reduce Arcane Connection duration by four steps.
    # Level 25: Reduce Arcane Connection duration by five steps.
    # Level 30: Reduce Arcane Connection duration by six steps (sufficient to make
    #           almost any connection expire instantly).

    # ===========================
    # PERDO VIM SPELLS
    # ===========================

    # --- GENERAL ---

    #ARM11D6wX6yZ8aB0cD2eF4g ^"Demon's Eternal Oblivion" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice"
        }
        RULES {
            #ARM11D7xY7zA9bC1dE3fG5h: Weakens and possibly destroys a creature with Infernal Might
            #ARM11D8yZ8aB0cD2eF4gH6i: If the spell penetrates the creature's Magic Resistance, the creature loses Might Score equal to the spell's level
        }
    }

    #ARM11D9zA9bC1dE3fG5hI7j ^"Disenchant" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base effect, +1 Touch"
        }
        RULES {
            #ARM11DAaB0cD2eF4gH6iJ8k: You make a Hermetic magic item lose all its powers permanently if the level of this spell + a stress die (no botch) equals or exceeds the highest level of the enchantments in the item
            #ARM11DBbC1dE3fG5hI7jK9l: The enchantment is utterly destroyed, as is all of the vis that was used in the magic item
            #ARM11DCcD2eF4gH6iJ8kL0m: The object left is in all ways a mundane item, but could be invested with enchantments again at a later time
        }
    }

    #ARM11DDdE3fG5hI7jK9lM1n ^"Masking the Odor of Magic" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Touch, +2 Sun"
        }
        RULES {
            #ARM11DEeF4gH6iJ8kL0mN2o: Prevents the detection of a magic spell, or of a magic power in an item or being, by Intellego Vim magic
            #ARM11DFfG5hI7jK9lM1nO3p: Detection fails unless the level of the InVi spell exceeds twice the level of this spell minus 5 (e.g. exceeds 20 for a level 15 version)
        }
    }

    #ARM11E0gH6iJ8kL0mN2oP4q ^"Unravelling the Fabric of (Form)" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice"
        }
        RULES {
            #ARM11E1hI7jK9lM1nO3pQ5r: Cancels the effects of any one spell of a specified Form whose level is less than or equal to (spell level + 10 + stress die (no botch))
            #ARM11E2iJ8kL0mN2oP4qR6s: There are 10 variants that cover each Hermetic Form, and a number of much rarer variants for different kinds of non-Hermetic magic
        }
    }

    #ARM11E3jK9lM1nO3pQ5rS7t ^"Wind of Mundane Silence" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +2 Voice, +2 Room"
        }
        RULES {
            #ARM11E4kL0mN2oP4qR6sT8u: You raise a metaphorical breeze that blows the magic away from an area, canceling the effects of any spell there
            #ARM11E5lM1nO3pQ5rS7tU9v: You can cancel the effects of any spell if, with this spell, you can double the level of the spell on a stress die + the level of your spell
            #ARM11E6mN2oP4qR6sT8uV0w: The spell must Penetrate to affect effects on a creature with Magic Resistance, including Parma Magica; if it penetrates and its level + stress die is double Parma Magica x 5, then it dispels the Parma Magica
            #ARM11E7nO3pQ5rS7tU9vW1x: Does not affect spells of Momentary duration; magical things near the area of the Wind wave slightly from the breeze
        }
    }

    # ===========================
    # REGO VIM GUIDELINES
    # ===========================
    # Rego Vim spells repel demons and other supernatural creatures.
    # Conjuring and controlling demons through ReVi is forbidden by the Hermetic Code.
    # Rego Vim would also be the combination for Magic Resistance, but even Bonisagus
    # could not turn Parma Magica into a spell; Aegis of the Hearth is the best managed.
    #
    # General:
    #   - Ward against all supernatural beings from one realm (Divine, Faerie,
    #     Infernal, or Magic) with Might <= level of the spell. (Touch, Ring, Circle)
    #   - Sustain or suppress a spell you have cast whose level <= level + 2 magnitudes
    #     of the Vim spell. Only useful with Concentration Duration among standard Durations.
    #     A suppressed spell still ends when its original duration expires.
    #   - Create a conduit or container for spells with level <= level + 5 magnitudes
    #     of the Vim spell. A conduit puts you in mystical contact (effective Touch range);
    #     a container holds a spell for a specific time before releasing it.
    #   - Sustain or suppress a spell cast by another with level <= half the (level + 5
    #     magnitudes) of the Vim spell. May target the spell itself or the caster.
    #   - Sustain or suppress a spell or spells of a specific type cast by another with
    #     level < level + 2 magnitudes of the Vim spell. May target spell itself or caster.
    # Level 5: Control any disembodied spirit associated with one of the four supernatural
    #          realms (different spell needed for each realm).
    # Level 10: Move raw vis from one physical object to another without a laboratory.
    # Level 15: Summon any disembodied spirit associated with one of the four supernatural
    #           realms (different spell needed for each realm).

    # ===========================
    # REGO VIM SPELLS
    # ===========================

    # --- GENERAL ---

    #ARM11E8oP4qR6sT8uV0wX2y ^"Aegis of the Hearth" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Year"]
            ^"Target" ENUM ["Boundary"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARM11E9pQ5rS7tU9vW1xY3z: Protects a covenant similarly to how Parma Magica protects a magus; provides very strong protection against supernatural effects and creatures originating from outside the boundary
            #ARM11EAqR6sT8uV0wX2yZ4a: No foreign supernatural creature with Might can cross the boundary unless its Might exceeds the level of the Aegis; the Aegis must Penetrate the creature's Magic Resistance for this effect
            #ARM11EBrS7tU9vW1xY3zA5b: Any foreign supernatural effect originating from outside the Aegis must Penetrate a Magic Resistance equal to the level of the Aegis to take effect inside; if it fails, the effect fails completely
            #ARM11ECsT8uV0wX2yZ4aB6c: Any foreign supernatural effect originating within the boundary subtracts half the level of the Aegis from any Casting Total or equivalent; if from an enchanted item, subtract from Penetration instead
            #ARM11EDtU9vW1xY3zA5bC7d: Anyone who participated in the ritual to cast the Aegis is a native and unaffected; participating magi can invite other individuals by giving them a designated token, making them natives
            #ARM11EEuV0wX2yZ4aB6cD8e: Any participating magus can revoke an invitation (whether issued by themselves or someone else) without retrieving the token; invitations and revocations are for specific individuals only
            #ARM11EFvW1xY3zA5bC7dE9f: The Aegis was created by Notatus, the first Primus of House Bonisagus, as a Major Breakthrough incorporating Mercurian rituals; it is more powerful than standard Hermetic theory would allow and has no Perdo requisite
            #ARM11F0wX2yZ4aB6cD8eF0g: Enchanted items within the boundary when Aegis is raised become native; items created within the Aegis by natives are native; items deliberately activated by natives are native; items cannot be invited into the Aegis
            #ARM11F1xY3zA5bC7dE9fG1h: Often cast on the Winter Solstice when the Magic aura may be slightly higher, giving a full year of duration
        }
    }

    #ARM11F2yZ4aB6cD8eF0gH2i ^"Circular Ward Against Demons" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base spell"
        }
        RULES {
            #ARM11F3zA5bC7dE9fG1hI3j: All creatures with Infernal Might equal to or less than the level of the spell are unable to enter the circle or harm those within it
            #ARM11F4aB6cD8eF0gH2iJ4k: If you cast the spell again, the stronger ring dispels the weaker, regardless of the order of casting
            #ARM11F5bC7dE9fG1hI3jK5l: Some magi cast this spell before going to sleep at night; at night, from certain angles, the ring may be seen as a silver-hued dome
        }
    }

    #ARM11F6cD8eF0gH2iJ4kL6m ^"Maintaining the Demanding Spell" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +1 Touch, +1 Diam"
        }
        RULES {
            #ARM11F7dE9fG1hI3jK5lM7n: Cast on a spell you have already cast and are maintaining through concentration; the spell is then automatically maintained for the duration of this spell, whether you concentrate or not
            #ARM11F8eF0gH2iJ4kL6mN8o: You cannot change the effects of the first spell without concentrating on it again (e.g. The Unseen Arm can hold an object without concentrating, but moving it still requires concentration)
            #ARM11F9fG1hI3jK5lM7nO9p: A Stamina + Concentration stress roll against an Ease Factor of 6 must be made to cast this spell while keeping the first one going (lower than normal because this is what the spell is designed for)
            #ARM11FAgH2iJ4kL6mN8oP0q: This spell only works on spells of equal or lower level
        }
    }

    #ARM11FBhI3jK5lM7nO9pQ1r ^"Opening the Intangible Tunnel" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect, +4 Arc, +1 Conc"
        }
        RULES {
            #ARM11FCiJ4kL6mN8oP0qR2s: Opens a magical channel from yourself to some target, allowing you to cast any spell with a range greater than Personal on that target
            #ARM11FDjK5lM7nO9pQ1rS3t: The tunnel does not grant any sense impressions of the target; you must cast appropriate spells through it if you wish to see
            #ARM11FEkL6mN8oP0qR2sT4u: Spells cast through the tunnel cannot be of higher level than that of this spell; you must make standard Concentration rolls to maintain concentration as you cast other spells
            #ARM11FFlM7nO9pQ1rS3tU5v: A magus who magically recognizes the tunnel (through The Invisible Eye Revealed or similar) may cast spells through the tunnel back at you without needing to concentrate on keeping it open
            #ARM11F0mN8oP0qR2sT4uV6w: If the target has Magic Resistance, you must Penetrate that resistance to open the tunnel; spells cast through the tunnel must also Penetrate Magic Resistance normally
        }
    }

    #ARM1200nO9pQ1rS3tU5vW7x ^"Suppressing the Wizard's Handiwork" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base, +1 Touch, +1 Conc"
        }
        RULES {
            #ARM1201oP0qR2sT4uV6wX8y: Cancels one spell that you have cast, but only as long as you concentrate; when concentration is broken the effects of the spell return
            #ARM1202pQ1rS3tU5vW7xY9z: The level of the spell to be suppressed must be less than or equal to the level of this spell
            #ARM1203qR2sT4uV6wX8yZ0a: The effects of the spell being suppressed take about one round to fade out, and then another round to return after concentration is broken
            #ARM1204rS3tU5vW7xY9zA1b: The spell to be affected must be active to be suppressed; it may not be of Momentary duration
            #ARM1205sT4uV6wX8yZ0aB2c: Common uses include providing access through magically blocked passages and avoiding traps such as suppressing a Watching Ward; the magus gets a +3 bonus to all Concentration rolls as the spell is designed to be held while doing something else
        }
    }

    #ARM1206tU5vW7xY9zA1bC3d ^"Watching Ward" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" TEXT "Gen"
            ^"Range" ENUM ["Touch"]
            ^"Duration" TEXT "Special"
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base effect, +1 Touch, Duration is non-standard"
        }
        RULES {
            #ARM1207uV6wX8yZ0aB2cD4e: Puts another spell on a given target on hold until triggered by a simple condition determined when this ritual is cast; the target must be present for the entire casting ritual
            #ARM1208vW7xY9zA1bC3dE5f: Only one Watching Ward can be placed on any one person or object; the level of the Watching Ward must at least equal the level of the spell held in suspension
            #ARM1209wX8yZ0aB2cD4eF6g: You can put multiple spells in the Ward, provided its level at least equals the sum of the levels of the contained spells
            #ARM120AxY9zA1bC3dE5fG7h: If Intellego spells are included, they may be used to trigger the other spells (e.g. Frosty Breath of the Spoken Lie to trigger a spell when someone lies); an InVi spell in the Ward has no effect other than triggering
            #ARM120ByZ0aB2cD4eF6gH8i: If someone tries to dispel the Watching Ward and fails, the suspended spell is cast
            #ARM120CzA1bC3dE5fG7hI9j: The Ritual nature supports the potentially indefinite duration; the Watching Ward is dispelled when it releases its spell
            #ARM120DaB2cD4eF6gH8iJ0k: A version with target Room, known as Waiting Spell, is also well known; it can contain spells up to the level of the Waiting Spell minus 10 and is also a Ritual
        }
    }

    # --- LEVEL 15 ---

    #ARM120EbC3dE5fG7hI9jK1l ^"Gather the Essence of the Beast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 10, +1 Touch"
        }
        RULES {
            #ARM120FcD4eF6gH8iJ0kL2m: Concentrates the raw vis in a corpse into one part of that corpse, which can then be removed
            #ARM1210dE5fG7hI9jK1lM3n: Lets you gather all the raw vis you find without lugging around entire corpses of beasts
            #ARM1211eF6gH8iJ0kL2mN4o: The vis in many magical creatures is already concentrated in a specific organ; this spell will allow you to relocate that vis if you wish
        }
    }
}
