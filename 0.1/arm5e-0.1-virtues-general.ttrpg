EXTENSION "ARM5e_Virtues_General" {
    NAME "Ars Magica 5th Edition Definitive - General, Social Status, and Story Virtues"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Character"

    # General Virtues: available to any character type unless noted.
    # Social Status Virtues: define the character's place in society.
    # Story Virtues: create ongoing narrative hooks.

    # ===========================
    # MAJOR GENERAL VIRTUES
    # ===========================

    #ARM600aB2cD4eF6gH8iJ0kL ^"Death Prophecy" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM601mN3oP5qR7sT9uV1wX: A condition has been placed on your death; until met, you cannot die from wounds or old age
            #ARM602yZ4aB6cD8eF0gH2iJ: You heal normally but cannot die; fate may bring the condition about unexpectedly
            #ARM603kL5mN7oP9qR1sT3uV: Requires storyguide agreement; storyguide must give fair warning of prophecy-related elements
        }
    }

    #ARM604wX6yZ8aB0cD2eF4gH ^"Giant Blood" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM605iJ7kL9mN1oP3qR5sT: Size is +2; wound increments are 7-point instead of 5-point
            #ARM606uV8wX0yZ2aB4cD6eF: +1 to both Strength and Stamina (may raise to +6)
            #ARM607gH9iJ1kL3mN5oP7qR: Up to 8 feet tall, up to 500 lbs; incompatible with Large, Small Frame, or Dwarf
        }
    }

    #ARM608sT0uV2wX4yZ6aB8cD ^"Ghostly Warder" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM609eF1gH3iJ5kL7mN9oP: A ghost watches over you; invisible and silent to all but you and those with Second Sight
            #ARM60AqR2sT4uV6wX8yZ0aB: Ghost can leave your presence once per day for up to half an hour; excellent spy
            #ARM60BcD3eF5gH7iJ9kL1mN: Ghost has 300 experience points in various Abilities for advice; may have quirks
        }
    }

    #ARM60CoP4qR6sT8uV0wX2yZ ^"Guardian Angel" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM60DaB5cD7eF9gH1iJ3kL: A divine watcher gives practical and spiritual advice; hears when you speak aloud
            #ARM60EmN6oP8qR0sT2uV4wX: Can grant +5 to Soak OR Magic Resistance 15 (not both; not compatible with Parma Magica)
            #ARM60FyZ7aB9cD1eF3gH5iJ: Only grants bonuses if acting in accordance with God's will; may leave if you act against its advice
        }
    }

    #ARM610kL8mN0oP2qR4sT6uV ^"License of Absence" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM611wX9yZ1aB3cD5eF7gH: Priest character has license relieving some duties; gains one extra free season per year
            #ARM612iJ0kL2mN4oP6qR8sT: Only for characters with Priest Social Status; may not be taken by Senior Clergy
        }
    }

    #ARM613uV1wX3yZ5aB7cD9eF ^"Magical Warder" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM614gH2iJ4kL6mN8oP0qR: A magical being accompanies you, watches over you, and protects you
            #ARM615sT3uV5wX7yZ9aB1cD: The more powerful the warder, the less available it is; can leave for up to half a day
            #ARM616eF4gH6iJ8kL0mN2oP: Design as a magic character using Chapter 13 guidelines or Realms of Power: Magic
        }
    }

    #ARM617qR5sT7uV9wX1yZ3aB ^"Powerful Relic" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM618cD6eF8gH0iJ2kL4mN: You own a relic with True Faith Score of 3 and one power (agreed with storyguide)
            #ARM619oP7qR9sT1uV3wX5yZ: Ceases to function if you behave impiously; requires suitable penance to restore
        }
    }

    #ARM61AaB8cD0eF2gH4iJ6kL ^"True Faith" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM61BmN9oP1qR3sT5uV7wX: You have a True Faith score of 1 and can gain more
            #ARM61CyZ0aB2cD4eF6gH8iJ: Grants Faith Points and access to Divine powers (see Realms chapter)
        }
    }

    #ARM61DkL1mN3oP5qR7sT9uV ^"Ways of the (Land)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
            ^"Repeatable" BOOLEAN true
        }
        RULES {
            #ARM61EwX2yZ4aB6cD8eF0gH: +3 to all rolls (including combat and Casting Scores) directly involving the chosen terrain and its inhabitants
            #ARM61FiJ3kL5mN7oP9qR1sT: Roll one fewer botch die in rolls pertaining to your terrain (may reduce to zero)
            #ARM620uV4wX6yZ8aB0cD2eF: Not normally molested by animals of the terrain; examples: Forest, Mountain, Steppe, Town
        }
    }

    #ARM621gH5iJ7kL9mN1oP3qR ^"Wealthy" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM622sT6uV8wX0yZ2aB4cD: Three free seasons per year (can pay people to manage your interests)
            #ARM623eF7gH9iJ1kL3mN5oP: Wealth level depends on social class; wealthy enough for goods of a higher class
            #ARM624qR8sT0uV2wX4yZ6aB: Magi may not take this Virtue (supported by covenant)
        }
    }

    #ARM625cD9eF1gH3iJ5kL7mN ^"Magian Lineage (Major)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM626oP0qR2sT4uV6wX8yZ: Includes all Minor Magian Lineage benefits (-1 Aging, +3 disease resistance)
            #ARM627aB1cD3eF5gH7iJ9kL: Choose three Arcane/Supernatural Abilities; gaining XP in one grants half SQ to the other two
        }
    }

    # ===========================
    # MINOR GENERAL VIRTUES
    # ===========================

    #ARM628mN2oP4qR6sT8uV0wX ^"Academic Concentration" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM629yZ3aB5cD7eF9gH1iJ: +3 to Artes Liberales score for one chosen subject
            #ARM62AkL4mN6oP8qR0sT2uV: -1 to Artes Liberales rolls for all other subjects; incompatible with Puissant Artes Liberales
        }
    }

    #ARM62BwX5yZ7aB9cD1eF3gH ^"Affinity with (Ability)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
            ^"Repeatable" BOOLEAN true
        }
        RULES {
            #ARM62CiJ6kL8mN0oP2qR4sT: All Advancement Totals for one Ability increased by half, rounded up
            #ARM62DuV7wX9yZ1aB3cD5eF: Also applies to XP assigned at character creation; may exceed age-based cap by 2
        }
    }

    #ARM62EgH8iJ0kL2mN4oP6qR ^"All According to Plan" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM62FsT9uV1wX3yZ5aB7cD: Once per session, may reroll one botch die
            #ARM630eF0gH2iJ4kL6mN8oP: Must describe the contingency plan that prepared for this exact failure
        }
    }

    #ARM631qR1sT3uV5wX7yZ9aB ^"Apt Student" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM632cD2eF4gH6iJ8kL0mN: When being taught or trained, add +5 to Source Quality
        }
    }

    #ARM633oP3qR5sT7uV9wX1yZ ^"Arcane Lore" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM634aB4cD6eF8gH0iJ2kL: May take Arcane Abilities during character generation
            #ARM635mN5oP7qR9sT1uV3wX: Gain 50 extra experience points for Arcane Abilities
            #ARM636yZ6aB8cD0eF2gH4iJ: Cannot learn Parma Magica without The Gift
        }
    }

    #ARM637kL7mN9oP1qR3sT5uV ^"Berserk" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM638wX8yZ0aB2cD4eF6gH: Automatically gain Personality Trait Angry +2; stress die + Angry vs 9+ triggers berserk
            #ARM639iJ9kL1mN3oP5qR7sT: While berserk: +2 Attack, +2 Soak, -2 Defense; cannot retreat or give quarter
            #ARM63AuV0wX2yZ4aB6cD8eF: Calm down: stress die + Perception - Angry vs EF 6, one attempt per round
            #ARM63BgH1iJ3kL5mN7oP9qR: May learn Martial Abilities at character creation
        }
    }

    #ARM63CsT2uV4wX6yZ8aB0cD ^"Book Learner" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM63DeF3gH5iJ7kL9mN1oP: When studying from books, treat them as 3 Quality levels higher
        }
    }

    #ARM63EqR4sT6uV8wX0yZ2aB ^"Cautious with (Ability)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
            ^"Repeatable" BOOLEAN true
        }
        RULES {
            #ARM63FcD5eF7gH9iJ1kL3mN: Roll two fewer botch dice for the chosen Ability (may reduce to zero)
        }
    }

    #ARM640oP6qR8sT0uV2wX4yZ ^"Clear Thinker" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM641aB7cD9eF1gH3iJ5kL: +3 on all rolls to resist lies, confusion, befuddlement, and subterfuge (magical or mundane)
        }
    }

    #ARM642mN8oP0qR2sT4uV6wX ^"Common Sense" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM643yZ9aB1cD3eF5gH7iJ: Storyguide alerts you whenever you are about to do something contrary to common sense
        }
    }

    #ARM644kL0mN2oP4qR6sT8uV ^"Craft Guild Training" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM645wX1yZ3aB5cD7eF9gH: 50 extra XP for Craft or Profession Abilities, Bargain, or Organization Lore: Guild
        }
    }

    #ARM646iJ2kL4mN6oP8qR0sT ^"Educated" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM647uV3wX5yZ7aB9cD1eF: May purchase Academic Abilities during character generation
            #ARM648gH4iJ6kL8mN0oP2qR: 50 extra XP that must be spent on Latin and Artes Liberales
        }
    }

    #ARM649sT5uV7wX9yZ1aB3cD ^"Enduring Constitution" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM64AeF6gH8iJ0kL2mN4oP: Decrease penalties for reduced Fatigue levels by 1; reduce wound penalty by 1 (min 0)
            #ARM64BqR7sT9uV1wX3yZ5aB: +3 on rolls to resist pain
        }
    }

    #ARM64CcD8eF0gH2iJ4kL6mN ^"Famous" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM64DoP9qR1sT3uV5wX7yZ: Good Reputation of level 4; choose any reputation and one type
        }
    }

    #ARM64EaB0cD2eF4gH6iJ8kL ^"Falls Like a Cat" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM64FmN1oP3qR5sT7uV9wX: Not injured by falls up to 3x height (or 6x if can soften by catching on things)
            #ARM650yZ2aB4cD6eF8gH0iJ: Greater heights: +1 Impact damage per extra foot (hard surface) or per 4 feet (soft surface)
        }
    }

    #ARM651kL3mN5oP7qR9sT1uV ^"Forgettable Face" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM652wX4yZ6aB8cD0eF2gH: Others find it hard to describe or remember you; identification rolls are at -3
            #ARM653iJ5kL7mN9oP1qR3sT: Incompatible with Venus' Blessing, Inspirational, and similar striking Virtues
        }
    }

    #ARM654uV6wX8yZ0aB2cD4eF ^"Free Expression" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM655gH7iJ9kL1mN3oP5qR: +3 bonus on all rolls to create a new work of art
        }
    }

    #ARM656sT8uV0wX2yZ4aB6cD ^"Good Teacher" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM657eF9gH1iJ3kL5mN7oP: Add +3 to Quality of books you write; add +5 to Source Quality for anyone studying with you
        }
    }

    #ARM658qR0sT2uV4wX6yZ8aB ^"Gossip" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM659cD1eF3gH5iJ7kL9mN: Simple roll 6+ to hear interesting news before everyone else
            #ARM65AoP2qR4sT6uV8wX0yZ: Treat all local Reputations as twice their actual level; may bestow new Reputations
        }
    }

    #ARM65BaB3cD5eF7gH9iJ1kL ^"Great (Characteristic)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
            ^"Repeatable" BOOLEAN true
        }
        RULES {
            #ARM65CmN4oP6qR8sT0uV2wX: Raise one Characteristic already at +3 or higher by +1, to max +5
            #ARM65DyZ5aB7cD9eF1gH3iJ: May take twice for same Characteristic, and for multiple Characteristics
        }
    }

    #ARM65EkL6mN8oP0qR2sT4uV ^"Hermetic Experience" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM65FwX7yZ9aB1cD3eF5gH: 50 extra XP for Order of Hermes Lore, Magic Lore, or Latin
        }
    }

    #ARM660iJ8kL0mN2oP4qR6sT ^"Improved Characteristics" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
            ^"Repeatable" BOOLEAN true
        }
        RULES {
            #ARM661uV9wX1yZ3aB5cD7eF: 3 additional points for buying Characteristics (still max +3 without Great Characteristic)
        }
    }

    #ARM662gH0iJ2kL4mN6oP8qR ^"Independent Study" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM663sT1uV3wX5yZ7aB9cD: +2 to Source Quality for Practice; +3 to Source Quality for Adventure XP
        }
    }

    #ARM664eF2gH4iJ6kL8mN0oP ^"Inoffensive to (Beings)" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General", "Hermetic"]
        }
        RULES {
            #ARM665qR3sT5uV7wX9yZ1aB: Your Gift does not bother beings of the chosen type (animals, divine, faeries, demons, or magical)
            #ARM666cD4eF6gH8iJ0kL2mN: May not take more than once; for more than one type, take Gentle Gift instead
            #ARM667oP5qR7sT9uV1wX3yZ: UnGifted characters may only take if they have the Flaw Magical Air
        }
    }

    #ARM668aB6cD8eF0gH2iJ4kL ^"Inspirational" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM669mN7oP9qR1sT3uV5wX: Give targets +3 bonus to rolls for appropriate Personality Traits
        }
    }

    #ARM66AyZ8aB0cD2eF4gH6iJ ^"Intuition" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM66BkL9mN1oP3qR5sT7uV: When luck plays a major role in a choice, storyguide rolls simple die; 6+ means correct choice
        }
    }

    #ARM66CwX0yZ2aB4cD6eF8gH ^"Jack-of-All-Trades" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM66DiJ1kL3mN5oP7qR9sT: No extra botch dice for using Abilities with no score
            #ARM66EuV2wX4yZ6aB8cD0eF: Asterisked Abilities may be attempted at score 0 with 3 extra botch dice (if type is accessible)
        }
    }

    #ARM66FgH3iJ5kL7mN9oP1qR ^"Keen Vision" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM670sT4uV6wX8yZ0aB2cD: +3 bonus to all rolls involving sight (not including missile weapon attacks)
        }
    }

    #ARM671eF5gH7iJ9kL1mN3oP ^"Keen Sense of Smell" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM672qR6sT8uV0wX2yZ4aB: +3 bonus to all rolls involving sense of smell, including tracking with Hunt
        }
    }

    #ARM673cD7eF9gH1iJ3kL5mN ^"Large" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM674oP8qR0sT2uV4wX6yZ: Size is +1; wound increments are 6-point; incompatible with Giant Blood, Small Frame, Dwarf
        }
    }

    #ARM675aB9cD1eF3gH5iJ7kL ^"Light Touch" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM676mN0oP2qR4sT6uV8wX: +1 to all rolls involving subtle manipulation (picking pockets, musical instruments)
            #ARM677yZ1aB3cD5eF7gH9iJ: Roll one fewer botch die in such activities (minimum one)
        }
    }

    #ARM678kL2mN4oP6qR8sT0uV ^"Lightning Reflexes" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["General"]
        }
        RULES {
            #ARM679wX3yZ5aB7cD9eF1gH: When surprised: stress die + Quickness vs 3+; if successful, respond reflexively
            #ARM67AiJ4kL6mN8oP0qR2sT: If attacking in response, +9 to Initiative Total; no choice about whether to react
        }
    }

