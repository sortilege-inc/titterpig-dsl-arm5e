EXTENSION "ARM5e_App_Spells_Aquam" {
    NAME "Apprentices - Aquam Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP006aB2cD4eF6gH8iJ ^"An Evening's Illumination" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Aquam"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +1 Touch, +2 Sun"
        }
        DESCRIPTION "This spells changes water into lamp oil. As earlier, a barrelful amount of water will produce a bucketful of oil."
    }

    #ARM5SP007aB2cD4eF6gH8iJ ^"Hurling the Droplet of Lye" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Aquam"]
            ^"Level" INTEGER 3
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Dia"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Touch, +1 Diameter"
        }
        DESCRIPTION "This spell produces a drop of lye that can burn a coin-sized hole in leather cloth or in parchment. If hurled at a living target, the corrosive substance can cause +1 Damage."
    }

    #ARM5SP008aB2cD4eF6gH8iJ ^"The Laundress' Clothesline" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Aquam"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4"
        }
        DESCRIPTION "This spell immediately dries the caster's clothing, which he must be wearing when this spell is cast."
    }

    #ARM5SP009aB2cD4eF6gH8iJ ^"Mimic the Christ's Miracle" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Aquam"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +1 Touch, +2 Sun"
        }
        DESCRIPTION "This spell changes water into wine. Changing water into a processed liquid reduces its size, and it takes a barrelful of water to produce a cup-sized amount of wine."
    }

}
