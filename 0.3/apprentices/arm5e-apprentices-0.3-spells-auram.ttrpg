EXTENSION "ARM5e_App_Spells_Auram" {
    NAME "Apprentices - Auram Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP010aB2cD4eF6gH8iJ ^"Jupiter's Tears" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Conc, +3 Sight"
        }
        DESCRIPTION "This spell makes a single cloud on an overcast day release its moisture, causing a light drizzle."
    }

    #ARM5SP011aB2cD4eF6gH8iJ ^"The Unruffled Traveler" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +2 Sun"
        }
        DESCRIPTION "This spell wards the caster from light breezes, redirecting them to blow around the caster and leave him untouched. It is ineffective against stronger winds."
    }

}
