EXTENSION "ARM5e_Spells_Auram" {
    NAME "Ars Magica Definitive Edition - Auram Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"

    #ARM5SP056aB2cD4eF6gH8iJ ^"Pull of the Watery Grave" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +3 Sight, +1 Conc, +1 size"
        }
        DESCRIPTION """Creates a strong undertow that pulls any object smaller than a rowboat 25 fathoms (150 feet) into the depths. Each of those caught in the undercurrent must make a Strength + Swim stress roll against an Ease Factor of 9 to avoid being dragged down. A roll is made each round that the spell is maintained.
TOWER OF WHIRLING WATER"""
    }

    #ARM5SP057aB2cD4eF6gH8iJ ^"TOWER OF WHIRLING WATER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 10, +2 Voice, +1 Conc, +2 Group"
        }
        DESCRIPTION "From a large body of water you form a waterspout that moves under your mental direction. It causes a simple die + 15 damage to anyone it hits (no Attack roll necessary). In addition, those struck must make a Quickness stress roll against an Ease Factor of 6 to avoid being sucked up by the waterspout. Those who fail are helplessly pulled into the spout and begin to drown immediately. When the waterspout fails, they fall up to 20 feet to the water's surface. If you direct the waterspout to move across land, you must make an Intelligence + Concentration stress roll against an Ease Factor of 9 each round to maintain it"
    }

    #ARM5SP058aB2cD4eF6gH8iJ ^"NEPTUNE'S WRATH" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 10, +3 Sight, +3 size, ritual for large effect"
        }
        DESCRIPTION "A gigantic wave is created in a very large body of water. The wave, which is only 20 feet high but up to a mile wide, is capable of capsizing ships at sea, smashing and drowning people near shore, and seriously damaging coastline communities. The tidal wave needs 5 miles of water surface to build itself up to proper proportions. The magus cannot control the wave without casting another spell."
    }

    #ARM5SP059aB2cD4eF6gH8iJ ^"Air's Ghostly Form" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +1 Touch, +1 Diam, +1 unnatural (the spell can be cast indoors"
        }
        DESCRIPTION """A thick fog forms around the magus, extending outwards for several paces. A breeze can push the fog around. The fog dissipates at its natural rate, and may be too thin to restrict sight within a minute.
CHAMBER OF SPRING BREEZES"""
    }

    #ARM5SP060aB2cD4eF6gH8iJ ^"CHAMBER OF SPRING BREEZES" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Touch, +2 Sun, +1 unnatural"
        }
        DESCRIPTION "Creates a breeze of fresh air that continually moves throughout a room, keeping the air continuously breathable even if the room is airtight. Rose of Jerbiton's version of this spell always causes the air to smell of roses. The breeze can be created outdoors, but there it has little effect."
    }

    #ARM5SP061aB2cD4eF6gH8iJ ^"JUPITER'S RESOUNDING BLOW" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +2 Voice, +1 unnatural (the spell functions indoors"
        }
        DESCRIPTION """Creates a thunderclap, anyone directly underneath must make a Stamina stress roll against an Ease Factor of 9 or be deafened. If deafened, the target gets another Stamina simple roll each minute against the same Ease Factor and recovers on a success. If the first roll botches, the victim is rendered deaf for a month.
STENCH OF THE TWENTY CORPSES"""
    }

    #ARM5SP062aB2cD4eF6gH8iJ ^"STENCH OF THE TWENTY CORPSES" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +2 Voice, +1 Diam"
        }
        DESCRIPTION """Creates a horrible stench of rotting corpses. All those within fifty paces of the target point must make Stamina stress rolls against an Ease Factor of 6 or act with a -3 penalty on all rolls. Anyone who botches the roll vomits and is incapacitated for (10 - Stamina) rounds.
WREATHS OF FOUL SMOKE"""
    }

    #ARM5SP063aB2cD4eF6gH8iJ ^"WREATHS OF FOUL SMOKE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +2 Voice, +1 Diam"
        }
        DESCRIPTION "Thick, yellow, sulfurous smoke rises up from the spot you designate, spreading and thinning naturally, but thick enough to block sight in a radius of about five paces around the point of origin. For each round anyone breathes the smoke, a Stamina stress roll against an Ease Factor of 3 must be made or a Fatigue level is lost. Once a character is Unconscious, further failed rolls result in the character taking a Light Wound each time. The area where the spell is cast will be damaged: small plants wilt and die, and tree growth is stunted. A faint stench of sulfur clings for days to anything exposed to the smoke."
    }

    #ARM5SP064aB2cD4eF6gH8iJ ^"Broom of the Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +2 Voice, +2 unnatural"
        }
        DESCRIPTION """Whips up violent, swirling winds around the target. The target must make a Size stress roll against an Ease Factor of 9 to remain standing. If the target is braced or holding onto some support, he may also make a Strength stress roll against an Ease Factor of 9.
If both rolls fail, the target is knocked in a random direction. The target may be damaged, depending on whether he strikes anything.
CHARGE OF THE ANGRY WINDS"""
    }

    #ARM5SP065aB2cD4eF6gH8iJ ^"CHARGE OF THE ANGRY WINDS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +2 Voice, +1 Conc, +1 unnatural"
        }
        DESCRIPTION "A wall of wind roars away from you, starting up to 10 paces away and continuing until it dissipates naturally. The wind is confined by any existing barriers, but if unconfined it can be up to a hundred paces wide. All within the area must make a Dexterity + Size stress roll against an Ease Factor of 9 or fall down and be blown along by the winds. The rolls must be made at the start of the gale and each subsequent round that the wind is maintained. You must concentrate on the gale. Missile fire into or out of the gale is futile, and marching against the gale requires a Strength + Size stress roll against an Ease Factor of 15. Failure in this attempt mandates another Dexterity + Size stress roll against an Ease Factor of 12 to keep from falling."
    }

    #ARM5SP066aB2cD4eF6gH8iJ ^"CIRCLING WINDS OF PROTECTION" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +1 Touch, +1 Conc, +2 unnatural, +1 Rego effect"
        }
        DESCRIPTION """Req: Rego
Surrounds you with winds that circle at great speed. Since the wind picks up dust and other small, loose objects, you may be obscured. Anyone standing near enough to attack you with a hand weapon must make a Size stress roll against an Ease Factor of 9 at the beginning of each round or be blown back. Melee Attack rolls against you are at -3, and missile or thrown attacks are at -9."""
    }

    #ARM5SP067aB2cD4eF6gH8iJ ^"CLOUDS OF RAIN AND THUNDER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 2, +3 Sight, +1 Conc, +2 Group, +1 Size"
        }
        DESCRIPTION """Creates a small but severe rainstorm, including lightning and winds. The storm gathers and breaks in a few seconds as the caster concentrates, and dissipates with similar speed when he stops doing so.
Note that reducing the Range for this spell makes the storm increasingly unnatural, so versions of this spell with lower Range still have the same level.
CLOUDS OF SUMMER SNOW
Creates clouds that drop snow over an area about half a mile across. The clouds gather over a few seconds at the beginning of the spell, and dissipate over the same sort of time when the caster stops concentrating. The spell does not affect temperature."""
    }

    #ARM5SP068aB2cD4eF6gH8iJ ^"Pull of the Skybound Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Voice, +1 Conc, +2 unnatural"
        }
        DESCRIPTION """Makes winds rise upward, pulling one object, creature, or person up to 50 feet into the sky before letting that target drop. Even a small building can be torn from its foundation, though such a building can be no larger than 20 feet to a side, and cannot be built out of a material heavier than stout wood. Uprooted objects fall randomly, unless you make a Finesse stress roll against an Ease Factor of 12 to choose where the objects will fall.
WINGS OF THE SOARING WIND"""
    }

    #ARM5SP069aB2cD4eF6gH8iJ ^"WINGS OF THE SOARING WIND" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +1 Touch, +1 Conc, +2, highly unnatural, +1 Rego requisite"
        }
        DESCRIPTION """Req: Rego
Generates a massive gust of air around you that supports and pushes you along through the air at speeds up to 40 miles per hour. Hovering in place is difficult, and requires a Finesse roll against an Ease Factor of 9 per round. It is dangerous for extended travel, because if you lose concentration, you are likely to sustain serious injuries (+15 damage, on average, although it may be more if the magus was very high up)."""
    }

    #ARM5SP070aB2cD4eF6gH8iJ ^"THE INCANTATION OF LIGHTNING" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Voice, +4 unnatural"
        }
        DESCRIPTION "A lightning bolt shoots forth from your outstretched hand in the direction you are pointing, doing +30 damage to a single target it hits. There must be nothing between you and the target. Those near the target must make Size stress rolls against an Ease Factor of 6 to remain standing."
    }

    #ARM5SP071aB2cD4eF6gH8iJ ^"Breath of the Open Sky" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 5, +1 Touch, +1 Conc, +4 size, +1 unnatural, ritual because of spectacular effect"
        }
        DESCRIPTION "You can call up a wind capable of devastating the countryside. You must stand under the open sky to cast this spell. While you cast the spell, a breeze picks up, blowing from you in the direction you are facing. When the ritual is completed, the wind strengthens to a gale roaring over the visible countryside and beyond, strong enough to topple wooden structures and knock down trees. The wind does not weaken while it is within your sight, but loses its force naturally where you cannot see it. If vou turn away from your original facing for more than a few seconds, you have to make a Concentration roll against an Ease Factor of 12 to maintain the spell. If you turn away for a minute or more, the spell ends. The air behind you is still."
    }

    #ARM5SP072aB2cD4eF6gH8iJ ^"Wrath of Whirling Winds and Water" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 65
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 5, +3 Sight, +2 Sun, +2 Group, +5 size"
        }
        DESCRIPTION """This spell creates an immense storm. 40 or more miles wide, of hurricane intensity. The storm builds up while you cast the ritual, and dissipates in a few seconds when the spell's duration ends. The gale-force winds and lashing waves cause immense damage along shorelines, and the winds, rain, and lightning cause extensive damage inland as well. Visibility is reduced to a few paces, missile fire is futile, and travel is nearly suicidal. Weak structures are blown over, and all but the most seaworthy ships are certain to founder unless they can be beached before the storm reaches full intensity.
The storm is not under the caster's control, and moves normally."""
    }

    #ARM5SP073aB2cD4eF6gH8iJ ^"SAILOR'S FORETASTE OF THE MORROW" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 4, +1 Touch, +2 Group"
        }
        DESCRIPTION """You know precisely what tomorrow's weather will be, and you gain a general impression about the weather for the week ahead. This intuition only applies to the place where you cast the spell, and is based on extrapolating current conditions, so it is occasionally wrong (precise, but inaccurate). Still, it would take something like an interfering magical being, or a volcanic eruption, to throw the prediction off.
True Sight of the Air"""
    }

    #ARM5SP074aB2cD4eF6gH8iJ ^"True Sight of the Air" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Vision"]
            ^"Design" STRING "Base 1, +2 Sun, +4 Vision"
        }
        DESCRIPTION """Lets you see clearly through all manner of obfuscation in the air nearby, including smoke, fog, and dust, even if the obfuscation is magical.
WHISPERING WINDS"""
    }

    #ARM5SP075aB2cD4eF6gH8iJ ^"WHISPERING WINDS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
        }
        DESCRIPTION """The winds bear their tidings to your ears, allowing you to hear words spoken by any group of people within your line of sight, provided no solid barrier (including glass) intervenes. This spell is an adaptation of an effect known to Bjornaer the Founder, and fits poorly into the normal framework of Hermetic magic.
(Unique spell)"""
    }

    #ARM5SP076aB2cD4eF6gH8iJ ^"EYES OF THE BAT" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Hearing"]
            ^"Design" STRING "Base 4, +2 Sun, +3 Hearing"
        }
        DESCRIPTION "You can move about confidently in complete darkness by sensing air and its boundaries (for example, where solid objects are). You 'hear' the boundaries of the air, so it does not permit fine discriminations. On the other hand, you can 'hear' boundaries behind you."
    }

    #ARM5SP077aB2cD4eF6gH8iJ ^"RAIN OF STONES" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +2 Voice, +2 Sun"
        }
        DESCRIPTION """Reg: Terram
Turns rain into stones as it falls, causing +0 damage every two rounds (they're small stones), and maybe less if the rain is very light. People under cover are not affected. The stones revert to water when the spell expires. If it stops raining before the spell ends, no more rain is transformed, even if a different rain storm starts.
TALONS OF THE WINDS"""
    }

    #ARM5SP078aB2cD4eF6gH8iJ ^"TALONS OF THE WINDS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +2 Voice, +1 Diam, +1 Rego requisite (additional effect: protect the caster"
        }
        DESCRIPTION """Req: Rego
Transforms a wind into an abrasive medium that tears and claws at everything in its path. Soft materials like leaves and cloth are shredded, and people take +4 damage from innumerable bloody cuts and abrasions. This spell cannot be cast if there is not a breeze of some sort blowing, thus making it difficult to use effectively indoors. The caster is not affected by the spell, even if the wind is blowing directly at him.
In Ossium of Bjornaer's version of this spell a strange keening can be heard in the air as it cuts through targets. Ossium's wizard's sigil manifests by making many of his spells eerie or frightening."""
    }

    #ARM5SP079aB2cD4eF6gH8iJ ^"INFERNAL SMOKE OF DEATH" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 25, +2 Voice, +1 Conc"
        }
        DESCRIPTION """Turns normal smoke from a fire into a thick, corrosive cloud. Anyone immersed in the cloud of smoke takes +25 corrosion damage, against which armor provides only half its normal Protection value. Soft materials like cloth, fur, paper, and leather are charred and ruined by exposure to the noxious vapor. While you
concentrate, any new smoke becomes corrosive. The smoke is heavier than air, so rolls along the ground, pooling in low spots. The damage represents normal exposure to the vapor, and may be modified if characters spend unusually short or long times within it."""
    }

    #ARM5SP080aB2cD4eF6gH8iJ ^"RAIN OF OIL" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 50
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 4, +3 Sight, +2 Sun, +5 size"
        }
        DESCRIPTION """Req: Aquam
Turns rain into droplets of oil. Within the spell's duration, the rain of oil continues as long as the storm does, drenching the landscape with flammable liquid. The oil will evaporate at a natural rate after the rain ceases. A Creo Ignem spell can ignite the storm so that the oil burns as it falls, but this requires a Group target large enough to catch all the raindrops. Lighting the oil after it has landed is much easier."""
    }

    #ARM5SP081aB2cD4eF6gH8iJ ^"ROOM OF STALE AIR" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Room"]
            ^"Design" STRING "Base 3, +2 Voice, +2 Room"
        }
        DESCRIPTION "Makes the air in a room stuffy and uncomfortable. Any creatures that breathe air suffer a -3 penalty on all rolls involving physical exertion. In addition, for each round of exertion a character must make a simple Stamina roll against an Ease Factor of 6 or lose a Fatigue level. This may cause panic in some creatures or people. The speed at which the air refreshes itself depends on how well ventilated the room is."
    }

    #ARM5SP082aB2cD4eF6gH8iJ ^"QUIET THE RAGING WINDS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 5, +1 Touch, +2 Group"
        }
        DESCRIPTION "Stops all wind from blowing, leaving only calm air. This spell is not powerful enough to affect winds caused by Ritual magic, and only affects winds blowing on the caster when it is cast. Under normal circumstances, the winds will not pick up again for at least an hour or so."
    }

    #ARM5SP083aB2cD4eF6gH8iJ ^"THE CLOUDLESS SKY RETURNED" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 45
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 10, +3 Sight, +2 Group, +2 size"
        }
        DESCRIPTION """This spell clears the sky within your vision of any clouds or other meteorological activity short of a hurricane or tornado, either naturally occurring or caused by magic. The clouds take a few seconds to clear, during which time you must concentrate on them. This spell only affects meteorological activity in progress at the moment of casting, and is not powerful enough to dispel a weather condition caused by Ritual magic.
In Ferramentum's version of this spell, the clouds clear from the sky in an orderly manner, as if they were soldiers marching on parade."""
    }

    #ARM5SP084aB2cD4eF6gH8iJ ^"Ward Against Faeries of the A{\scriptsize IR}" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Design" STRING "Base effect"
        }
        DESCRIPTION "As Ward Against Faeries of the Water (ReAq Gen), but for faeries of the air. The faerie cannot directly or indirectly break the magic circle, nor can they use ranged attacks or magic to affect those within it. From some angles at night, the ring may be seen as a violethued dome."
    }

    #ARM5SP085aB2cD4eF6gH8iJ ^"WIND AT THE BACK" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Spec"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +1 Touch, +2 Special (based on Concentration"
        }
        DESCRIPTION "An existing breeze follows you until you stop traveling for more than ten minutes. It causes phenomena you pass through (fog, haze) to follow you."
    }

    #ARM5SP086aB2cD4eF6gH8iJ ^"WARD AGAINST RAIN" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +2 Sun"
        }
        DESCRIPTION "No rain falls on the caster, no matter how bad the weather."
    }

    #ARM5SP087aB2cD4eF6gH8iJ ^"GATHERING OF THE STORMY MIGHT" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
