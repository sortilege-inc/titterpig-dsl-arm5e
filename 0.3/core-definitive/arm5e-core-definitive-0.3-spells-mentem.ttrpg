EXTENSION "ARM5e_Spells_Mentem" {
    NAME "Ars Magica Definitive Edition - Mentem Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"

    #ARM5SP229aB2cD4eF6gH8iJ ^"WORDS OF THE UNBROKEN SILENCE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +3 Sight"
        }
        DESCRIPTION "Lets you say two words directly to the mind of a target. The target can recognize your voice and knows that the message is of supernatural origin."
    }

    #ARM5SP230aB2cD4eF6gH8iJ ^"PANIC OF THE TREMBLING HEART" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Creates an overpowering fear in one person of a specific object, person, or place.
RISING IRE"""
    }

    #ARM5SP231aB2cD4eF6gH8iJ ^"RISING IRE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +2 Sun"
        }
        DESCRIPTION "Makes the target furious at someone or something of your choice. A stress roll against an Ease Factor of 9 using an appropriate Personality Trait (like Calm) can hold the anger in check, but it is felt strongly regardless of the roll."
    }

    #ARM5SP232aB2cD4eF6gH8iJ ^"MEMORY OF THE DISTANT DREAM" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Inserts a full and complete memory into a person's mind. If the target gives the memory some thought and concentration, and makes an Intelligence roll against an Ease Factor of 9, the memory is revealed as false. When the duration expires, the memory vanishes, although the subject may remember remembering it.
Pains of the Perpetual Worry"""
    }

    #ARM5SP233aB2cD4eF6gH8iJ ^"Pains of the Perpetual Worry" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Moon"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +3 Moon"
        }
        DESCRIPTION "Gives someone a nagging, taunting, painful emotion  --  a recurrent sense of anxiety, a fear of something he or she does not know, a fear of everything, and a fear of nothing. To have this spell cast on you is truly a curse."
    }

    #ARM5SP234aB2cD4eF6gH8iJ ^"WEIGHT OF A THOUSAND HELLS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Moon"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +3 Moon, +1 complex effect"
        }
        DESCRIPTION "Causes the victim to feel the despair, anguish, pain, and sorrow of a thousand sinners in Hell. This is a horrible spell, for the victim loses almost all motivation and earthly cares. All he can feel is his own pain - endless, inexorable, and searing. Appropriate Personality Trait rolls suffer a harmful adjustment of -5, and the target suffers -2 on any rolls that require thought or concentration. The target has a strong tendency to do nothing but brood."
    }

    #ARM5SP235aB2cD4eF6gH8iJ ^"GIFT OF REASON" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["IndPermanently increases the target's Intelligence by 1 point, to no higher than 0"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 30, +1 Touch"
        }
    }

    #ARM5SP236aB2cD4eF6gH8iJ ^"SIGHT OF THE TRANSPARENT MOTIVE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +1 Eye"
        }
        DESCRIPTION "Detects the general motive most powerfully influencing the target at the moment. General motives are such things as fear, anger, and greed, not specific things like the desire to look good before one's superiors."
    }

    #ARM5SP237aB2cD4eF6gH8iJ ^"Perception of the Conflicting Motives" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eve"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +1 Eve"
        }
        DESCRIPTION "You can detect the conflicting motives behind one target's actions. Thus you might learn that a guard feels conflict between fear and duty. This spell is often used before application of a Muto or Rego spell, since it is usually easier to change a target's emotions after you've sensed them than it is to create emotions."
    }

    #ARM5SP238aB2cD4eF6gH8iJ ^"Frosty Breath of the Spoken Lie" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +1 Eye, +1 Conc, mist is a purely cosmetic effect and thus is free"
        }
        DESCRIPTION """For as long as you maintain this spell, the target exhales a misty breath with each spoken lie. Small bits of ice form on the person's lips if the lie is particularly severe. In winter, when breath is visible anyway, lies produce a greater than normal amount of mist (the mist actually billows out). A target who makes a Communication + Guile stress roll against an Ease Factor of 15 can
determine whether any given statement will be taken by the spell as a lie. The spell can be defeated through extensive and judicious application of Creo Auram and Perdo Auram spells, and a demon is able to manipulate it in any way it wishes, as demons are the embodiment of deception and are never caught in a lie if they do not wish to be.
House Guernicus brought the Order this spell, and it is a very poor Quaesitor who is without it.
Posing the Silent Question"""
    }

    #ARM5SP239aB2cD4eF6gH8iJ ^"Posing the Silent Question" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 15, +1 Eye"
        }
        DESCRIPTION "You can ask one silent mental question of the target, then detect the answer. The truth of the answer is limited by the knowledge of the target. Questions to the effect of \"What would you do if ...?\" often receive inaccurate replies. You are likely to get what the target thinks he would do, not necessarily what he would really do. The target of this spell does not notice the questioning unless he or she resists the spell, in which case they notice the attempt."
    }

    #ARM5SP240aB2cD4eF6gH8iJ ^"THOUGHTS WITHIN BABBLE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Hearing"]
            ^"Design" STRING "Base 5, +1 Conc, +3 Hearing"
        }
        DESCRIPTION "You can understand the speech of those within the target area. Perception or Communication stress rolls are needed for difficult exchanges. You also understand people who misuse a language that you do speak; you know what they meant to say, as well as hearing what they actually said."
    }

    #ARM5SP241aB2cD4eF6gH8iJ ^"PEERING INTO THE MORTAL MIND" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 25, +1 Eye"
        }
        DESCRIPTION "You can thoroughly probe and understand the contents of the mind of the target, including his or her immediate and long-term motives, personal strengths and weaknesses, and other pertinent information."
    }

    #ARM5SP242aB2cD4eF6gH8iJ ^"NEVER QUITE LIVED" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Eye, +2 Sun"
        }
        DESCRIPTION "Changes the target's memory of a detail into a similar, though different, memory. The target is no more sure of this manufactured memory than of the authentic one, so he may discover strange fabrications to be false."
    }

    #ARM5SP243aB2cD4eF6gH8iJ ^"MIND OF THE BEAST" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 15, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Req: Animal
You turn the mind of the target into that of an animal of your choice. The victim acts and thinks like that animal as much as possible; a person who thinks he is a bird will try to fly, but will not be able to. This can be dangerous for the target."""
    }

    #ARM5SP244aB2cD4eF6gH8iJ ^"PAST OF ANOTHER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Year"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 10, +1 Eye, +4 Year"
        }
        DESCRIPTION "The target's memories are completely rewritten, and he is unable to remember his actual life until the effect is dispelled or expires."
    }

    #ARM5SP245aB2cD4eF6gH8iJ ^"INMOST COMPANION" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 25, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Req: Animal
The target's mind is made physical as a bird. This bird normally stays close to the target's body, but need not. If the target has Magic Resistance, it protects both his body and mind, as normal. No matter how far it travels, the target's mind controls his body, as well as
the bird's, as normal. In particular, it can see through both sets of sense organs. If the bird is killed, the target also dies, as his mind has been killed.
VISION OF THE HAUNTING SPIRITS"""
    }

    #ARM5SP246aB2cD4eF6gH8iJ ^"VISION OF THE HAUNTING SPIRITS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Room"]
            ^"Design" STRING "Base 15, +1 Touch, +2 Sun, +2 Room"
        }
        DESCRIPTION """Req: Imaginem
All spirits within the target area become visible, although they might remain unseen if hiding behind something. This includes the spirits of living people, which appear as the person normally does. If the person is invisible or otherwise changed from his normal shape, his normal appearance is superimposed on his current appearance."""
    }

    #ARM5SP247aB2cD4eF6gH8iJ ^"LAY TO REST THE HAUNTING SPIRIT" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base effect"
        }
        DESCRIPTION "If your spell Penetrates the resistance of a ghost or similar spirit, it loses a number of points from its Might equal to the level of this spell. If this reduces the spirit's Might to zero, it vanishes, apparently destroyed. Philosophers concur that the spirit goes to the afterlife, or is perhaps weakened to helplessness, but is not actually destroyed. Souls, after all, are immortal."
    }

    #ARM5SP248aB2cD4eF6gH8iJ ^"TIP OF THE TONGUE" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +1 Eye, +1 Diam"
        }
        DESCRIPTION "Causes the target to forget one word of your choosing. The target cannot remember that word for the spell's duration, but afterwards he can come up with the word without assistance by making an Intelligence + Concentration stress roll against an Ease Factor of 9. If the target fails he may try again, but each additional roll adds +1 to the difficulty."
    }

    #ARM5SP249aB2cD4eF6gH8iJ ^"Trust of Childlike Faith" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +1 Diam"
        }
        DESCRIPTION "The target loses judgment and believes almost any passable lie for the duration of the spell. An Intelligence stress roll against an Ease Factor of 6 is allowed to resist. Truly incredible lies allow easier resistance rolls."
    }

    #ARM5SP250aB2cD4eF6gH8iJ ^"CALM THE MOTION OF THE HEART" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Voice"
        }
        DESCRIPTION """Removes one emotion from the target until it appears again naturally. An angry person stops being angry, and a curious one stops being inquisitive. Many a magus finds this spell useful for keeping his apprentice's nose out of his immediate business.
ENCHANTMENT OF DETACHMENT"""
    }

    #ARM5SP251aB2cD4eF6gH8iJ ^"ENCHANTMENT OF DETACHMENT" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Calms and greatly lowers the intensity of the target's current emotions.
Loss of But a Moment's Memory"""
    }

    #ARM5SP252aB2cD4eF6gH8iJ ^"Loss of But a Moment's Memory" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +1 Eye"
        }
        DESCRIPTION "Removes up to five continuous minutes from a target's memory, leaving a blank. You target the loss of memory to a specific event or time. With an Intelligence stress roll against an Ease Factor of 9, the target realizes that memories of a certain period are missing. This Ease Factor can change, depending on how important the missing memory is and what sort of circumstances surrounded the event. Careful introspection over a period of time can allow reconstruction of much of the memory, but some details are lost forever."
    }

    #ARM5SP253aB2cD4eF6gH8iJ ^"BLESSING OF CHILDLIKE BLISS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +1 Eye, +2 Sun"
        }
        DESCRIPTION """Reduces an adult mind to a child's level. The target solves problems, reasons, and expresses emotions as would a three-year-old. Magi affected cannot cast spells. At first, anyway, the target is
likely to be happy at having lost a world of cares and troubles that are no longer imaginable.
Passion's Lost Feeling"""
    }

    #ARM5SP254aB2cD4eF6gH8iJ ^"Passion's Lost Feeling" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 15, +1 Eye, +1 Conc"
        }
        DESCRIPTION "The target is unable to feel any sort of emotion and acts listlessly, without motivation or cares."
    }

    #ARM5SP255aB2cD4eF6gH8iJ ^"BLACK WHISPER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Moon"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 15, +1 Touch, +3 Moon, +1 for not needing to gesture"
        }
        DESCRIPTION "You whisper a magic sentence in the target's ear. It takes several seconds to speak the sentence, so an unwilling, able-bodied target can stop you. If you speak the whole sentence, the target must make a Stamina stress roll against an Ease Factor of 15 or go completely insane. You need not use your hands for this spell, but you must be able to speak."
    }

    #ARM5SP256aB2cD4eF6gH8iJ ^"RING OF WARDING AGAINST SPIRITS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Design" STRING "Base effect"
        }
        DESCRIPTION "Only ghosts and spirits with current Magic Might higher than the spell's level can enter the ring you create. At certain angles, the ring may be seen as an orange-hued dome. This spell does not affect ghosts or spirits associated with the other realms."
    }

    #ARM5SP257aB2cD4eF6gH8iJ ^"THE CALL TO SLUMBER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +2 Voice"
        }
        DESCRIPTION """The target becomes sleepy and falls asleep within a few seconds.
SNAP OF AWAKENING"""
    }

    #ARM5SP258aB2cD4eF6gH8iJ ^"SNAP OF AWAKENING" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +2 Voice"
        }
        DESCRIPTION "When you snap your fingers you instantly awaken the target from sleep to alert consciousness. Does not work on someone unconscious from Fatiguelevel loss, wounds, or magic."
    }

    #ARM5SP259aB2cD4eF6gH8iJ ^"CONFUSION OF THE NUMBED WILL" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Eye, +2 Sun"
        }
        DESCRIPTION "Confuses a person, who must make an Intelligence stress roll to take any direct action. A roll of 12+ ends the spell, while a roll of 9+ lets the character take the intended action, but the spell remains in effect. Any lower roll means the character is confused and takes some other type of action. When it is imperative for the victim to take an action, the storyguide should allow an appropriate modifier to the roll. While under this spell, a character always strikes last in combat and gets at least a -1 on all attacking and defending rolls."
    }

    #ARM5SP260aB2cD4eF6gH8iJ ^"Aura of Rightful Authority" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +1 Eve, +2 Sun"
        }
        DESCRIPTION """The target of the spell is strongly inclined to obey you, as if you were his natural superior.
COERCE THE SPIRITS OF THE NIGHT"""
    }

    #ARM5SP261aB2cD4eF6gH8iJ ^"COERCE THE SPIRITS OF THE NIGHT" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Voice, +1 Conc"
        }
        DESCRIPTION """Makes a ghost obey you as long as you can coerce it with threats, such as a threat to defile its grave or to banish it to Hell. The more lurid and dramatic the threat, the more cooperative the ghost is. If the spell penetrates the ghost's Magic Resistance, roll Communication + Leadership to see how effective your threats are. The storyguide should always give a bonus or penalty that depends on the potency of the threat, and any roll other than a botch will compel at least minimal obedience.
SCENT OF PEACEFUL SLUMBER"""
    }

    #ARM5SP262aB2cD4eF6gH8iJ ^"SCENT OF PEACEFUL SLUMBER" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Room"]
            ^"Design" STRING "Base 4, +2 Voice, +2 Room"
        }
        DESCRIPTION "Everyone in the room falls asleep over a few seconds, with the smell of lilacs in their nostrils"
    }

    #ARM5SP263aB2cD4eF6gH8iJ ^"VISIONS OF THE INFERNAL TERRORS" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 10, +2 Voice, +2 Sun"
        }
        DESCRIPTION """Causes everything the target sees to look and sound terrifying. The world looks basically the same, save that everything is hideously transformed somehow. The target must roll a stress die, adding his Stamina and adding or subtracting an appropriate Personality Trait to see what the effects are. The nature of the Personality Trait used determines how it affects the Stamina roll. A Trait like Brave makes you resistant to fear, while one like Cowardly reduces the result of your roll.
| Roll      | Result                                                                          |
| ----------- | --------------------------------------------------------------------------------- |
| 0 or less | Scared to death (literally)                                                     |
| 1-5      | Incapacitated with fear,<br>permanent -1 to Stamina<br>Incapacitated with fear |
| 6-9      | incapacitated with fear                                                         |
| 10-15    | Flee, fight at -6 if cornered or obstructed                                    |
| 16+       | Carry on, -3 on all rolls                                                       |
| (D        | 2 2 V . 2 C .                                                                   |"""
    }

    #ARM5SP264aB2cD4eF6gH8iJ ^"Enslave the Mortal Mind" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Eye"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
        }
        DESCRIPTION """Enables you to completely control the loyalty, emotions, desires, interests, and activities of any person. People revert to normal when the spell ends, and may be extremely angry with the magus. (Base 25. \pm 1 Eye. \pm 2 Sun)
Incantation of Summoning the Dead"""
    }

    #ARM5SP265aB2cD4eF6gH8iJ ^"Incantation of Summoning the Dead" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 3, +1 Touch, +4 Year, +4 Bound"
        }
        DESCRIPTION """Calls up a person's ghost. You must be on the spot where the person died, or must have the corpse (either of these constitutes an Arcane Connection). Alternatively, you can summon any ghost that haunts the area you are in, if you know the ghost's full name, according to the Law of Names. Those buried by Church ceremony and those have who gone straight to heaven (that is, saints and crusaders, as opposed to the normal folk who must wait for a time before going on) are not available for summoning. This spell is a ritual because it can summon those who are beyond the mortal world, as long as they are not in heaven.
If the ghost has Magic Resistance, you must penetrate that resistance in order to summon it.
terrain is unsuitable for this spell. Once a searcher spots the hidden place, the spell does not prevent approach. Those who are present for the ritual are unaffected by the spell. This spell mimics the properties of many faerie forests."""
    }

    #ARM5SP266aB2cD4eF6gH8iJ ^"Exchange of the Two Minds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 55
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Year"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 20, +1 Touch, +4 Year, +2 Group"
        }
        DESCRIPTION "This spell switches the minds (but not the souls) of two creatures. A new body greatly confuses those who are unprepared for the shock, and even those who are ready take a day to adjust completely. Magi who transport their own minds into younger, healthier bodies usually find that having a strong body entails having powerful passions that interfere with the clear thinking needed to pursue the magical Arts. Both people involved must make a Stamina stress roll against an Ease Factor of 3, rolled before the switch is made, to survive the transfer. If only one person fails the roll, that person dies and the spell fails. The other target is unaffected."
    }

}
