        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab either forbids certain activities (one category of lab activity cannot be performed), or otherwise tiresome or expensive rituals or practices are required in order to perform lab work. -1 General Quality or +2 Upkeep as appropriate."
    }

    #ARM5FS015aB2cD4eF6gH8iJ ^"Sacrifices" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "Animal sacrifices are needed in order for the lab to function. +2 Upkeep, -1 Safety, +1 Warping, -1 Health, -3 Aesthetics; 2 points on any Technique or Animal Specialization as appropriate."
    }

    #ARM5FS016aB2cD4eF6gH8iJ ^"Thoroughfare" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Flaw"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
