EXTENSION "ARM5e_Cov_Virtues" {
    NAME "Covenants - Virtues"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Character"
    # Source: Covenants

    #ARM5VS001aB2cD4eF6gH8iJ ^"Greater Guardian" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "A powerful supernatural creature (Might 20 or higher), which is not the familiar of the owner, resides in the lab and acts as its protector, being well-disposed to the owner. Woe betide any who should intrude. +(creature's Intelligence) Safety, +1 Warping, +1 Aesthetics; 3 points on appropriate Art specialization(s)."
    }

    #ARM5VS002aB2cD4eF6gH8iJ ^"Greater Horde" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "A large community of resident minor supernatural creatures are at the owner's command. They are intelligent enough to serve a protective function and assist with simple lab tasks. +2 General Quality, +1 Upkeep, +(creature's Intelligence) Safety, +2 Aesthetics; 2 points on Rego or other appropriate Art specialization(s)."
    }

    #ARM5VS003aB2cD4eF6gH8iJ ^"Familiar" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The owner of the lab has a familiar, and the familiar lives in the lab. Perhaps it even helps with lab work. This Virtue assumes that the familiar takes up a non-trivial amount of space. If not, this can be instead taken as a Free Virtue. +(familiar's Intelligence + Magic Theory) General Quality, +(Golden Cord) Safety. (This is simply a restatement of the existing bonuses given in the Laboratory chapter of ArM5.)"
    }

    #ARM5VS004aB2cD4eF6gH8iJ ^"Gateway" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab is located at a supernatural gateway, for example, an entrance to a regio or a faerie realm, or a Mercere Portal. The owner of the lab usually controls access to the gateway, and might get some tangible benefits, such as receiving a toll from those who use the gateway, or simply the ability to pass through the gateway herself. The gateway may be made into a Portal Feature (purchased as usual) and might also be combined with the Thoroughfare Flaw. -1 Safety, +1 Aesthetics; 1 point on Rego or another appropriate Art Specialization."
    }

    #ARM5VS005aB2cD4eF6gH8iJ ^"Lesser Guardian" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "A supernatural creature (less than Might 20), which is not the familiar of the owner, resides in the lab and acts as its protector, being well-disposed to the owner. +1 Safety; 1 point on an appropriate Art specialization."
    }

    #ARM5VS006aB2cD4eF6gH8iJ ^"Lesser Horde" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "A small group of semiintelligent creatures helps out in the lab. +1 General Quality, +1 Upkeep, +1 Safety, +1 Aesthetics; 1 point on Rego or another appropriate Art specialization."
    }

    #ARM5VS007aB2cD4eF6gH8iJ ^"Vis Source" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION ": A naturally occurring source of vis is located in the lab. -1 Safety, +1 Warping; 2 points on the appropriate Art Specialization.*"
    }

    #ARM5VS008aB2cD4eF6gH8iJ ^"Airborne" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab flies upon the winds or clouds, and rarely lands. Needless to say, only very powerful magics are able to permanently levitate an entire building, or erect a lab upon a cloud. This Virtue is often combined with the Unstable Flaw, since flying is a tricky business. +1 Upkeep, -2 Safety, +2 Warping, +1 Health, +4 Aesthetics; +1 Experimentation, +4 Au."
    }

    #ARM5VS009aB2cD4eF6gH8iJ ^"Boundless" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION """The interior of the lab has an unlimited amount of space, despite the seeming mundane limitations of its structure from the outside. This effect is
118

outside the scope of normal Hermetic magic, but it might have a non-Hermetic or faerie origin. Size may be increased to any desired number. +2 Warping."""
    }

    #ARM5VS010aB2cD4eF6gH8iJ ^"Enchantment" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "*: The lab itself has been enchanted as a magic item. This may grant Virtues or Flaws, alter Characteristics, or add to Specializations (see the guidelines below, under Magic Items for Laboratories )."
    }

    #ARM5VS011aB2cD4eF6gH8iJ ^"Faerie Ingredients" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "Some of the lab's stores are supplied by faeries, and have beneficial (if sometimes unpredictable) properties. For example, faerie silver is used in place of real silver. +1 General Quality, - 1 Upkeep, +1 Warping; +1 Experimentation, 1 point on an appropriate Specialization."
    }

    #ARM5VS012aB2cD4eF6gH8iJ ^"Flawless Equipment" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The outfittings of the lab are flawless, perhaps even too perfect to have been crafted by mortal hands. +2 General Quality, +2 Upkeep (unless the equipment is continuously protected, created, or donated by supernatural means, in which case -1 Upkeep); +2 Vis Extraction."
    }

    #ARM5VS013aB2cD4eF6gH8iJ ^"Flawless Tools" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The craftsman who created such perfect tools as are found in this lab must have been legendary. +1 Upkeep (unless the equipment is continuously protected, created, or donated by supernatural means, in which case -1 Upkeep); +2 Items."
    }

    #ARM5VS014aB2cD4eF6gH8iJ ^"Ice Cavern" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab is located in a structure built of ice that never melts. Either it is located in the extreme north or high up a mountain, or else magic is used to prevent the ice from melting. The owner of such a lab presumably does not mind the cold. +1 Upkeep, +1 Warping, -2 Health (unless immune to the cold), +2 Aesthetics; +2 Re or Te."
    }

    #ARM5VS015aB2cD4eF6gH8iJ ^"Inexhaustible Supplies" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab is blessed with magically replenishing ingredients and consumables, which never run out. -3 Upkeep, +1 Warping."
    }

    #ARM5VS016aB2cD4eF6gH8iJ ^"Invisible" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The interior of the lab, and its outfittings, are invisible. Naturally, this requires the owner of the lab to have some magical means of seeing them, otherwise he is not going to get very far with his lab work. +1 Warping, halve the Aesthetics score after all other modifications ; +2 Im."
    }

    #ARM5VS017aB2cD4eF6gH8iJ ^"Magic Item" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "*: A magic item is installed in the lab. It might be self-made, donated, purchased, or perhaps some kind of artifact which was found in the lab. If the item is very large, taking up a significant amount of space in the lab, then it should be treated as a Minor Virtue instead of a Free Virtue. This may grant Virtues or Flaws, alter Characteristics, or add to Specializations (see the guidelines below)."
    }

    #ARM5VS018aB2cD4eF6gH8iJ ^"Magical Heating" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION """Heating is provided magically. This Virtue functions as either Superior Heating or Excessive
Heating (but without the space and Upkeep cost)."""
    }

    #ARM5VS019aB2cD4eF6gH8iJ ^"Magical Lighting" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "Lighting is provided magically. This Virtue functions as either Superior Lighting or Excessive Lighting (but without the space and Upkeep cost)."
    }

    #ARM5VS020aB2cD4eF6gH8iJ ^"Preserved" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab, or part of its contents, is immune from natural decay. -1 Upkeep, +1 Warping, +2 Health, +1 Aesthetics; +1 Cr."
    }

    #ARM5VS021aB2cD4eF6gH8iJ ^"Regio" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION ": The interior of the lab is in a regio, and there is another regio level, which the owner can navigate easily. If there are further regio levels, this Virtue may be taken more than once. +3 Size, +1 Warping.*"
    }

    #ARM5VS022aB2cD4eF6gH8iJ ^"Relocation" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The location of the lab in the physical world can be magically adjusted. For example, it is enchanted with a powerful Rego Terram effect. This may provide benefits for travel, but it also makes the lab and its occupant hard to find. +1 Warping (if the relocation is in constant effect); +1 Experimentation."
    }

    #ARM5VS023aB2cD4eF6gH8iJ ^"Sentient" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab seems to have developed an independent mind. This is unlikely to have resulted from Hermetic magic (unless a breakthrough), but could be a result of being many decades in a high-level magic or faerie aura. +1 Warping; +1 Experimentation, +1 Me."
    }

    #ARM5VS024aB2cD4eF6gH8iJ ^"Shrouded" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The lab is hidden or protected by a supernatural effect such as The Shrouded Glen. +1 Warping, halve the Aesthetics score after all other modifications ."
    }

    #ARM5VS025aB2cD4eF6gH8iJ ^"Site of Legend" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "Stories are told about this lab, and legends are associated with it. Any adjustments to Characteristics and Specializations as appropriate."
    }

}
