EXTENSION "ARM5e_HP_Spells_Imaginem" {
    NAME "Hermetic Projects - Imaginem Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Hermetic Projects

    #ARM5SP049aB2cD4eF6gH8iJ ^"Fingers for Eyes" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Room"]
            ^"Design" STRING "Base 1, +1 Touch, +1 Diameter, +2 Room"
        }
        DESCRIPTION """The caster can see the Room that the person he touches is in. The spell can be used by a blind magus to "see," by moving around with his hand on the shoulder of a servant. It can also be used to see the location that an Intangible Tunnel-style effect terminates in.

This spell only works if the person touched is actually in a Room. This spell must Penetrate in order to sense creatures with Magic Resistance.

Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."""
    }

    #ARM5SP050aB2cD4eF6gH8iJ ^"Snatched Voice" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +1 Touch, +1 Diameter, +1 changing image"
        }
        DESCRIPTION """The target loses the ability to make sound. If she is a maga and attempts to cast spells, she suffers the penalties for silent casting.

Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."""
    }

}
