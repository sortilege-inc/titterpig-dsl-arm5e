    #ARM5SP131aB2cD4eF6gH8iJ ^"The Evil Eye" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 0
