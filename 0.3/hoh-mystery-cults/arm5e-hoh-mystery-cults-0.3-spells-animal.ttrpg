EXTENSION "ARM5e_HoH_MC_Spells_Animal" {
    NAME "Houses of Hermes: Mystery Cults - Animal Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Houses of Hermes: Mystery Cults

    #ARM5SP001aB2cD4eF6gH8iJ ^"revenge of tHe Bitten toad" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Taste"]
            ^"Design" STRING "Base 15, +1 Diam"
        }
        DESCRIPTION "Any creatures who bite (or otherwise taste) the caster suffer a Heavy Wound. Any successful bite attack against the caster results in the creature tasting him, even if no wound is actually infl icted. The caster still suffers any damage infl icted by the bite, but his opponent is typically deterred from further attacks."
    }

    #ARM5SP002aB2cD4eF6gH8iJ ^"tHe voice of tHe Bjornaer Magus" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Sun"
        }
        DESCRIPTION "This spell allows the caster to speak with a human voice when shapechanged into the form of an animal. The caster must be in animal form to cast this spell because it targets the vocal capacity of that form, and must be able to cast this spell with no words or gestures (usually a -15 penalty), but while under its infl uence, may use his own voice without penalty to spellcasting."
    }

    #ARM5SP003aB2cD4eF6gH8iJ ^"forM of tHe (teMPeraMent) HeartBeast" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +2 Sun; +1 complexity"
        }
        DESCRIPTION """There are four versions of this spell, one for each of the sanguine, choleric, melancholic, and phlegmatic temperaments. These spells must be cast in animal form because they enhance the correspondences to the temperament of that form, whereas humans naturally have a more balanced temperament than animals. A Bjornaer magus may revert to human form after casting this spell and still retain its effects. It is not required that the animal form he takes take matches the temperament listed in the spell's name; however, if the two do match, all bonuses granted by the spell are increased by one. Only one of these spells may be cast on the same character at any one time; they operate by infl uencing the bodily humors, and only one humor at a time may be infl uenced in this way.

Sanguine: +1 Qik; +3 to all rolls to negate the natural fear the caster instills (as a wild animal with The Gift); temporarily acquires the Cheerful Personality Trait at +3 (or increases preexisting trait by 3)

Choleric: +1 Dex; +3 to all rolls to follow a trail or fi nd something deliberately hidden; temporarily acquires the Brave Personality Trait at +3 (or increases preexisting trait by 3)

Melancholic: +1 Sta; +3 to all rolls to communicate across a language barrier, through empathy, via sign language, and so forth; temporarily acquires the Creative Personality Trait at +3 (or increases preexisting trait by 3)

Phlegmatic: +1 Str; +3 to all rolls involving intuition and memory; temporarily acquires the Cool-Headed Personality Trait at +3 (or increases preexisting trait by 3)"""
    }

}
