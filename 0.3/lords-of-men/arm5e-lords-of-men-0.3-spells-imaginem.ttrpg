EXTENSION "ARM5e_LoM_Spells_Imaginem" {
    NAME "Lords of Men - Imaginem Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Lords of Men

    #ARM5SP002aB2cD4eF6gH8iJ ^"Raise the Veronese Flag" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Imaginem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Design" STRING "Base 2, +2 Voice, +2 Sun, +2 Group, +2 movement and complexity"
        }
        DESCRIPTION "This spell creates the illusion of ten Veronese men-at-arms manning the castle walls. Each soldier moves and speaks (though they seem to have Veronese accents, they form no intelligible words) but never strays from its post. Using this spell, the Veronese magi fooled the Milanese force into thinking that all of the castle walls were protected."
    }

}
