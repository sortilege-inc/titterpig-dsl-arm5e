EXTENSION "ARM5e_Myst_Spells_Animal" {
    NAME "The Mysteries Revised - Animal Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: The Mysteries Revised

    #ARM5SP001aB2cD4eF6gH8iJ ^"Numbering the Flock" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Animal"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Sight"]
            ^"Design" STRING "Base 4, +4 Sight Sense"
        }
        DESCRIPTION """The Numerologist instantly knows the number of animals she can see, and how many of each kind.

The pattern of such numbers is considered to be far more significant than the details of the numbers. Numerologists often use this spell in connection with Casual Augury (Numerology) to interpret the numbers."""
    }

}
