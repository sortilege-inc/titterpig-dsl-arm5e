            #ARM1572zC5iK9oQ3sU7wY ^"Honos - Combat: Long Spear" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Long Spear: Init +7, Attack +14, Defense +12, Damage +10. Soak: +14 (silver cuirass)."
            }
            #ARM1573aD8jL2pR6tV0xZ ^"Honos - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
