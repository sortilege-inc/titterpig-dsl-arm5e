            #ARM15F5cF8oQ2uW6yA0dF ^"Sir Giles - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "(Area) Lore 3 (nobles), Animal Handling 3 (horses), Athletics 2 (running), Awareness 3 (in battle), Brawl 2 (fist), Concentration 1 (remaining invisible), Charm 1 (ladies), Etiquette 3 (nobles), Great Weapon 3 (long spear), Hunt 2 (deer), Intrigue 1 (noble courts), Leadership 3 (soldiers), Ride 5 (in battle), Single Weapon 5+2 (heater shield)"
            }
            #ARM15F6dG1pR5vX9zA3eG ^"Sir Giles - Power: Donning the Corporeal Veil" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Donning the Corporeal Veil, 5 points, Init -1, Corpus: Sir Giles can assume material form."
            }
            #ARM15F7eH4qS8wY2bD6fH ^"Sir Giles - Power: Riding the Phantom Steed" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Riding the Phantom Steed, 2 points, Init 0, Animal. R: Touch, D: Sun, T: Ind. When Sir Giles takes physical form, he can also materialize his war horse for an additional Might cost. He can dissolve the horse at will due to the Rego requisite. Use the statistics for a destrier. Cr(Re)An 40 (Base 15, +1 Touch, +2 Sun, +1 Rego requisite, +1 Size)."
            }
            #ARM15F8fI7rT1xZ5cE9gI ^"Sir Giles - Power: Invisibility" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Invisibility, 1 point, Init 0, Imaginem. R: Touch, D: Conc, T: Group. Even in material form, Sir Giles and his horse can become invisible when he wishes (though they can still be seen by Second Sight). PeIm 20 (Base 4, +1 Touch, +1 Conc, +2 Group)."
            }
            #ARM15F9gJ0sU4yA8dF2hJ ^"Sir Giles - Power: Ride in Dreams" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ride in Dreams, 1 point, Init 0, Mentem. R: Touch, D: Sun, T: Ind. When in spirit form, Sir Giles can enter the dreams of a sleeping person whose name he knows, tormenting him with nightmares of a furious, dark knight. The victim must make a Stamina roll against an Ease Factor of Sir Giles' Presence + Leadership or lose a Long-Term Fatigue Level. CrMe 15 (Base 4, +1 Touch, +2 Sun)."
            }
            #ARM15FAhK3tV7zA1eG5iK ^"Sir Giles - Equipment and Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Equipment: Full chain mail, lance, heater, long sword, black destrier. Encumbrance: 2 (4). Vis: 4 Mentem in lance."
            }
        }
    }

    #ARM15B0iL6uW0bD4fH8jM ^"A Magical Wolf" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic"
            ^"Magic Might" INTEGER 20
            ^"Might Form" TEXT "Animal"
            ^"Intelligence" INTEGER 0
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER 1
            ^"Communication" INTEGER 1
            ^"Strength" INTEGER 2
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 2
            ^"Size" INTEGER -1
            ^"Soak" INTEGER 7
        }
        RULES {
            #ARM15FBjM9vX3cE7gI1kN ^"Magical Wolf - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Leader +3, Loyal +2. Reputations: None."
            }
            #ARM15FCkN2wY6dF0hJ4lO ^"Magical Wolf - Combat: Bite" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Bite: Init +12, Attack +10, Defense +14, Damage +9. Fatigue levels: n/a (the magical wolf is tireless)."
            }
            #ARM15FDlO5xZ9eG3iK7mP ^"Magical Wolf - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-4), -3 (5-8), -5 (9-12), Incapacitated (13-16)"
            }
            #ARM15FEmP8yA2fH6jL0nQ ^"Magical Wolf - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "[Area] Lore 6 (game trails), Brawl 6 (biting), Hunt 7 (in a pack), Living Language 5 (hunting terminology), Survival 6 (forests)"
            }
            #ARM15FFnQ1zA5gI9kM3oR ^"Magical Wolf - Power: Pack of One" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Pack of One, 2 points, Init +10, Animal: The wolf can create five duplicates of himself, who can then fight as a trained group. Treat the wolf as having a Leadership score of 5, so that he can get the full +15 group bonus to his attacks. The power lasts until the pack brings down its opponent or disengages from the fight. The group does not need to disengage and reform when the vanguard is killed; it can seamlessly transfer the role to another wolf. The wolf only dies if all the copies are killed. When the duplicates vanish, the least wounded wolf remains."
            }
            #ARM15FGoR4bD8hJ2lN6pS ^"Magical Wolf - Power: Terrifying Howl" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Terrifying Howl, 4 points, Init +0, Mentem: Anyone who hears the wolf's howl is struck with fear. Someone already in a house will merely not want to leave. Overcoming this fear completely requires a Brave roll against an Ease Factor of 12. Acting sensibly while responding to it requires a Brave roll against an Ease Factor of 6. Those who fail the easier roll simply flee in panic."
            }
            #ARM15FHpS7cE1iK5mO9qT ^"Magical Wolf - Power: Wolf Lord" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wolf Lord, 0 points, constant, Animal: Any wolf the magical wolf strikes in deadly combat dies instantly. In addition, the magical wolf can make mundane wolves follow his instructions even when he is not around, as long as the instructions are quite simple."
            }
            #ARM15FIqT0dF4jL8nP2rU ^"Magical Wolf - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 4 pawns of Animal, in head."
            }
        }
    }

    #ARM15A0rU3eG7kM1oQ5sV ^"Adranus, the Spirit of Mount Etna" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Genius Loci)"
            ^"Magic Might" INTEGER 50
            ^"Might Form" TEXT "Ignem"
            ^"Intelligence" INTEGER 3
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER 2
            ^"Communication" INTEGER 2
            ^"Strength" INTEGER 3
            ^"Stamina" INTEGER 2
            ^"Dexterity" INTEGER -1
            ^"Quickness" INTEGER -2
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Soak" TEXT "n/a"
        }
        RULES {
            #ARM15A1sV6fH0lN4pR8tW ^"Adranus - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Ways of the Mountains; Improved Characteristics x5. Flaws: Fury, Wrathful."
            }
            #ARM15A2tW9gI3mO7qS1uX ^"Adranus - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wrathful +6, Slumbering +3. Reputations: Bringer of Death and Destruction 5 (Local)."
            }
            #ARM15A3uX2hJ6nP0rT4vY ^"Adranus - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Sicily Lore 6 (mountains), Magic Lore 8 (underworld)"
            }
            #ARM15A4vY5iK9oQ3sU7wZ ^"Adranus - Power: Crafter of Fire" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Crafter of Fire, variable points, Init -2 minus Might cost, Ignem: Duplicates any non-Ritual Creo Ignem or Rego Ignem spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM15A5wZ8jL2pR6tV0xA ^"Adranus - Power: Crafter of Earth" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Crafter of Earth, variable points, Init -2 minus Might cost, Terram: Duplicates any non-Ritual Creo Terram or Rego Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM15A6xA1kM5qS9uW3yB ^"Adranus - Power: Grant Visions" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Grant Visions, 5 points, Init -12, Vim: The target gains the Visions Flaw. Adranus can grant the Flaw temporarily (does not recover Might Points until it withdraws the Flaw), or permanently (Might Score reduced by 5)."
            }
            #ARM15A7yB4lN8rT2vX6zC ^"Adranus - Power: Grant Simple-Minded" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Grant Simple-Minded, 5 points, Init -12, Vim: The target gains the Simple-Minded Flaw. Adranus can grant the Flaw temporarily (does not recover Might Points until it withdraws the Flaw), or permanently (Might Score reduced by 5)."
            }
            #ARM15A8zC7mO1sU5wY9aD ^"Adranus - Power: Grant Wrathful" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Grant Wrathful, 5 points, Init -12, Vim: The target gains the Wrathful Flaw. Adranus can grant the Flaw temporarily (does not recover Might Points until it withdraws the Flaw), or permanently (Might Score reduced by 5)."
            }
            #ARM15A9aD0nP4tV8xZ2bE ^"Adranus - Power: Hibernation" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Hibernation, 15 points, Init -32, Vim: The spirit remains completely inactive for a year (spending no other Might points); the 15 points spent on this power are saved and added to the Might Pool for the first year out of hibernation. In this fashion, the Might Pool may exceed the permanent Might score (50). Using this power, the volcano can save up Might points over many years in succession and have a great amount to spend in the single year in which it awakens."
            }
            #ARM15AAbE3oQ7uW1yA5cF ^"Adranus - Power: Manifestation" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Manifestation, 4 or more points, Init equal to (Qik minus Might points spent), Animal. R: Touch, D: Conc, T: Ind or Group. Manifests the spirit's consciousness among animals it touches, temporarily granting them a Might score equal to the Might points spent and controlling their actions. For an extra 2 Might points, a group of ten standard creatures can be controlled. For each additional 2 Might points, the mass of creatures controlled is multiplied by 10. Humans and other sentient beings cannot be controlled by this power. Adranus is considered to be touching any animal on the mountain."
            }
            #ARM15ABcF6pR0vX4zA8dG ^"Adranus - Power: Master of Earth" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Master of Earth, variable points, Init -2 minus Might cost, Terram: Duplicates any non-Ritual Muto Terram or Perdo Terram spell no greater than 50th level at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM15ACdG9qS3wY7bD1eH ^"Adranus - Power: Presence" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Presence, 0 points, constant, Imaginem. R: Arc, D: Sun, T: Ind. Grants awareness of everything that happens within the bounds of Mount Etna. The spirit is coterminous with its associated landscape feature, present simultaneously everywhere within its boundaries. The area controlled by the spirit can produce a yearly harvest of 5 pawns of Ignem vis. InIm 30 (Base 2, +4 Arc, +2 Sun, +1 constant effect, +1 non-Hermetic effects)."
            }
            #ARM15ADfH2rT6xZ0cE4fI ^"Adranus - Power: Regio" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Regio, 15 points, Init -32, Vim: By permanently spending Might, the spirit can add levels to the regio around the volcano's crater."
            }
            #ARM15AEgI5sU9yA3dF7gJ ^"Adranus - Power: Ruler of Lava" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ruler of Lava, variable points, Init -2 minus Might cost, Terram: Duplicates any non-Ritual spell pertaining to lava no greater than 50th level, at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM15AFhJ8tV2zA6eG0hK ^"Adranus - Power: Ruler of Smoke" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ruler of Smoke, variable points, Init -2 minus Might cost, Auram: Duplicates any non-Ritual spell pertaining to smoke no greater than 50th level, at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM15B0iK1uW5bD9fH3iL ^"Adranus - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 10 pawns of Ignem vis; 5 pawns per year can also be harvested from the crater at the volcano's summit."
            }
        }
    }

