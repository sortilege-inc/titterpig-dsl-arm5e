        }
        RULES {
            #ARM1591mP4vX8cE2gI6kM ^"Pukis - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Mischievous +3, Loyal +3, Fickle +2"
            }
            #ARM1592nQ7wY1dF5hJ9lN ^"Pukis - Combat: Bite" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Bite: Init +5, Attack +6, Defense +9, Damage +3. Although small, Pukis is long and thin. It can engage 2 opponents without penalty, attacking one with its jaws and the other with its quick tail. It is also burning hot, and can ignite easily flammable materials on touch."
            }
            #ARM1593oR0xZ4eG8iK2mO ^"Pukis - Combat: Lashing Tail" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Lashing tail: Init +6, Attack +10, Defense +13, Damage +0"
            }
            #ARM1594pS3yA7fH1jL5nP ^"Pukis - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-3), -3 (4-6), -5 (7-9), Banished (10+)"
            }
            #ARM1595qT6zA0gI4kM8oQ ^"Pukis - Power: Invisibility" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Invisibility, 3 points, Init +6, Imaginem: Pukis can turn itself completely invisible and inaudible, for as long as it chooses, or until it touches a person or animal."
            }
            #ARM1596rU9bD3hJ7lN1pR ^"Pukis - Power: Mischievous Flame" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Mischievous Flame, 2 points, Init +6, Ignem: With a glance, Pukis can set anything slightly flammable aflame."
            }
            #ARM1597sV2cE6iK0mO4qS ^"Pukis - Power: Sneak Thief" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Sneak Thief, 5 points, Init +6, Terram: By touching any object weighing less than 3 pounds, Pukis can instantly teleport the object to its home so that it appears at the edge of its master's hearth."
            }
            #ARM1598tW5dF9jL3nP7rT ^"Pukis - Power: Sacred Fire" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Sacred Fire, 0 points, Init +6, Ignem: As long as Pukis lives in a particular hearth, and the fire is kept hot year round, the ashes from the fire can be collected for 1 pawn of Ignem per season."
            }
            #ARM1599uX8eG2kM6oQ0sU ^"Pukis - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 2 Ignem, 1 Rego"
            }
        }
    }

    #ARM15A0vY1fH5lN9pR3tV ^"An Earth Elemental" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Elemental)"
            ^"Magic Might" INTEGER 15
            ^"Might Form" TEXT "Terram"
            ^"Cunning" INTEGER 0
            ^"Perception" INTEGER 1
            ^"Presence" INTEGER -2
            ^"Communication" INTEGER -4
            ^"Strength" INTEGER 3
            ^"Stamina" INTEGER 6
            ^"Dexterity" INTEGER 2
            ^"Quickness" INTEGER 0
            ^"Size" INTEGER 0
            ^"Soak" INTEGER 9
        }
        RULES {
            #ARM15A1wZ4gI8mO2qS6uW ^"Earth Elemental - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Berserk, Great Stamina, Tough, Ways of the Cavern. Flaws: Poor Memory, Short Attention Span, Simple Minded."
            }
            #ARM15A2xA7hJ1nP5rT9vX ^"Earth Elemental - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Cave +3* (* = Essential Trait)"
            }
            #ARM15A3yB0iK4oQ8sU2wY ^"Earth Elemental - Combat: Bludgeon" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Bludgeon*: Init +3, Attack +11, Defense +7, Damage +9. Bludgeon when Berserk*: Init +3, Attack +13, Defense -5, Damage +9. (* Includes Ways of the Cavern)"
            }
            #ARM15A4zC3jL7pR1tV5xZ ^"Earth Elemental - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Soak: +9 (additional +2 when Berserk). Wound Penalties: -1 and 1 Might point (1-5), -3 and 3 Might points (6-10), -5 and 5 Might points (11-15), Incapacitated and 5 Might points (16-20), Dead and all Might points (21+)."
            }
            #ARM15A5aD6kM0qS4uW8yA ^"Earth Elemental - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Athletics 3 (pursuit), Awareness 2 (interlopers), Brawl 3 (bludgeon), Penetration 3 (Slake Thirst Power), Stealth 2 (keeping still)"
            }
            #ARM15A6bE9lN3rT7vX1zA ^"Earth Elemental - Power: Crush" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Crush, 0 points, Init -2, Terram: R: Touch, D: Sun, T: Ind. The elemental clubs at an opponent with its heavy limbs, requiring a normal Bludgeon melee attack, which does its own damage as normal. If the elemental is at least equal in Size to its opponent, a successful Crush attack can pin him to the ground, and the elemental adds its (Might/5, rounded up) to its Grapple Strength to prevent its victim escaping. If the elemental successfully grapples, then any equipment carried by its victim is damaged. Re(Pe)Te 30 (Base 3, +1 Touch, +2 Sun, +2 affect stone, +1 requisite, +1 constant effect)."
            }
            #ARM15A7cF2mO6sU0wY4bD ^"Earth Elemental - Power: Slake Thirst" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Slake Thirst, 1 point, Init +4, Aquam: R: Touch, D: Mom, T: Part. Direct contact with the elemental removes water from the target, inflicting a Fatigue level of damage. Once all Fatigue levels are gone, successive strikes inflict a Light Wound, then a Medium Wound, then a Heavy Wound, and so forth. Fatigue levels may be restored by drinking at least two pints of water. PeAq 15 (Base 5, +1 Touch, +1 Part)."
            }
            #ARM15A8dG5nP9tV3xZ7cE ^"Earth Elemental - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 3 pawns of Terram, in body."
            }
        }
    }

