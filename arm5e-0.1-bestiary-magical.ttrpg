            }
            #ARM15B3lN0xZ4eG8iK2lO ^"Corpse Revenant - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vengeful +6"
            }
            #ARM15B4mO3yA7fH1jL5mP ^"Corpse Revenant - Combat: Fist" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fist: Init 0, Attack +7, Defense +4, Damage +5. Note: The revenant's dead, unfeeling fist strikes as if it were a bludgeon."
            }
            #ARM15B5nP6zA0gI4kM8nQ ^"Corpse Revenant - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-5), -3 (6-10), -5 (11-15), -5 (16-20), Destroyed (21+). Note: Revenants cannot be Incapacitated; treat Incapacitating wounds as Heavy wounds instead."
            }
            #ARM15B6oQ9bD3hJ7lN1oR ^"Corpse Revenant - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Brawl 3 (fist)"
            }
            #ARM15B7pR2cE6iK0mO4pS ^"Corpse Revenant - Power: Breath of Corruption" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Breath of Corruption, 1 point, Init +2, Auram. R: Special, D: Mom, T: Ind. The walking corpse can exhale foul humors, infecting a person within 2 paces with a disease (Ease Factor 9, effect as a Medium wound). CrAu 20 (Base 10, +2 Range equivalent to Voice)."
            }
            #ARM15B8qS5dF9jL3nP7qT ^"Corpse Revenant - Power: Rise from the Grave" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Rise from the Grave, 1 point, Init -1, Terram. R: Touch, D: Diameter, T: Part. The revenant can cause the earth over its grave to open for one Diameter so it may enter or leave. The ground then seals, leaving no trace of disturbance. ReTe 5 (Base 2, +1 Touch, +1 Diameter, +1 Part)."
            }
            #ARM15B9rT8eG2kM6oQ0rU ^"Corpse Revenant - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 2 Corpus in eyes (1 per eye)."
            }
        }
    }

