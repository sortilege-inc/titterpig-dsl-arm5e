            }
            #ARM15B6kN6uW0bD4fH8jL ^"Water Elemental - Power: Drown" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Drown, 0 points, Init +0, Aquam: R: Touch, D: Sun, T: Ind. After successful melee attack, the elemental can engulf a target whose Size is smaller than its own and attempt to drown him, necessitating a roll to avoid deprivation. The victim can attempt to escape each round using the Grappling rules. ReAq(Co) 30 (Base 5, +1 Touch, +2 Sun, +1 requisite, +1 constant effect)."
            }
            #ARM15B7lO9vX3cE7gI1kM ^"Water Elemental - Power: Chill Touch" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Chill Touch, 2 points, Init 0, Ignem: R: Touch, D: Mom, T: Ind. The lympha's touch extracts heat from a target, inflicting +10 damage. This damage is Soaked without the benefit of armor, as the watery body of the elemental seeps through all protection. PeIg 15 (Base 10, +1 Touch)."
            }
            #ARM15B8mP2wY6dF0hJ4lN ^"Water Elemental - Power: Crafter of Water" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Crafter of Water, 1-3 points, Init -4 minus Might Cost, Aquam: Duplicate any Creo Aquam or Rego Aquam spell of level 15 or below, at a cost of 1 Might point per magnitude of the spell."
            }
            #ARM15B9nQ5xZ9eG3iK7mO ^"Water Elemental - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 3 pawns of Aquam, in body."
            }
        }
    }

