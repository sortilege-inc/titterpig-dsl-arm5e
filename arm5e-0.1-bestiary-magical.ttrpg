            }
            #ARM15D4eH7rT1xZ5cE9eI ^"Scitalis - Fatigue and Wounds" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fatigue Levels: OK, 0, -1, -3, -5, Unconscious. Wound Penalties: -1 (1-3), -3 (4-6), -5 (7-9), Incapacitated (10-12), Dead (13+)."
            }
            #ARM15D5fI0sU4yA8dF2fJ ^"Scitalis - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Brawl 3 (fangs), Ignem Resistance 3 (cold), Survival 2 (winter)"
            }
            #ARM15D6gJ3tV7zA1eG5gK ^"Scitalis - Power: Dazzling Appearance" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Dazzling Appearance, 0 points, Init -3, Mentem or Animal. R: Per, D: Conc, T: Spectacle. The scitalis can use its wondrous colors and appearance to stupefy those who look at it. Victims stand in slack-jawed amazement, unable to move, speak, or act, for as long as the scitalis concentrates. It uses this power to capture its prey, for it is a slow-moving creature. ReMe(An) 45 (Base 15, +1 Conc, +4 Spectacle, +1 Animal requisite)."
            }
            #ARM15D7hK6uW0bD4fH8hL ^"Scitalis - Power: Venom" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Venom, 0 points, Init n/a, Aquam. R: Touch, D: Sun, T: Ind. The scitalis' fangs drip a venom that causes a Medium Wound (if it penetrates Magic Resistance) unless its victim can make a Stamina roll against an Ease Factor of 9. CrAq 30 (Base 10, +1 Touch, +2 Sun, +1 continuous effect)."
            }
            #ARM15D8iL9vX3cE7gI1iM ^"Scitalis - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 1 Imaginem in skin."
            }
        }
    }

    #ARM15E0jM2wY6dF0hJ4jN ^"Stag of Virtue" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Beast of Virtue)"
            ^"Magic Might" INTEGER 17
            ^"Might Form" TEXT "Animal"
            ^"Cunning" INTEGER -2
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER 2
            ^"Communication" INTEGER -3
            ^"Strength" INTEGER 4
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 2
            ^"Size" INTEGER 2
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Soak" INTEGER 7
        }
        RULES {
            #ARM15E1kN5xZ9eG3iK7kO ^"Stag of Virtue - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Ways of the Forest; Essential Virtue (healthy, minor), Ferocity (when at bay), Great Quickness, Lesser Immunity (fevers), Long-Winded, Puissant Athletics. Flaws: Hatred (of serpents, major); Higher Purpose (protect its herd), Restricted Power (x2)."
            }
            #ARM15E2lO8yA2fH6jL0lP ^"Stag of Virtue - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Stag* +3, Noble +3, Healthy (Stamina) +3, Brave +2. Reputations: Noble 2 (local). (* = Essential Trait)"
            }
            #ARM15E3mP1zA5gI9kM3mQ ^"Stag of Virtue - Combat" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Antlers: Init +4, Attack +10, Defense +10, Damage +7. Hooves: Init +4, Attack +8, Defense +9, Damage +5."
            }
            #ARM15E4nQ4bD8hJ2lN6nR ^"Stag of Virtue - Fatigue and Wounds" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fatigue Levels: OK, 0, -1, -3, -5, Unconscious. Wound Penalties: -1 (1-7), -3 (8-14), -5 (15-21), Incapacitated (22-28), Dead (29+)."
            }
            #ARM15E5oR7cE1iK5mO9oS ^"Stag of Virtue - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Athletics 8+2 (sprinting), Awareness 5 (hunters), Brawl 5 (antlers), Stealth 3 (hiding in undergrowth), Survival 4 (forests)"
            }
            #ARM15E6pS0dF4jL8nP2pT ^"Stag of Virtue - Power: Healing" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Healing, 3 points, Init -8, Animal. R: Per, D: Mom, T: Ind. The stag can heal one of its own Heavy or lesser wounds. This is a Restricted Power: the stag must eat the herb dittany to activate it. CrAn 25 (Base effect)."
            }
            #ARM15E7qT3eG7kM1oQ5qU ^"Stag of Virtue - Power: Delay the Serpent's Venom" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Delay the Serpent's Venom, 0 points, Init n/a, Aquam. R: Per, D: Sun, T: Ind. The Stag of Virtue is magically warded against poison. Any poison introduced into the Stag's body takes no effect until the next sunrise or sunset (whichever comes first). This power activates whenever such a poison is introduced, and thus has an Intellego requisite. Re(In)Aq 20 (Base 5, +2 Sun, +1 Intellego requisite)."
            }
            #ARM15E8rU6fH0lN4pR8rV ^"Stag of Virtue - Power: Alleviate the Serpent's Bite" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Alleviate the Serpent's Bite, 1 point, Init +1, Aquam. R: Per, D: Mom, T: Ind. A Stag of Virtue can permanently neutralize any poison already inside its body. This is a Restricted Power, which the Stag must drink water to activate. PeAq 15 (Base 15)."
            }
            #ARM15E9sV9gI3mO7qS1sW ^"Stag of Virtue - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 3 Creo in right antler."
            }
        }
    }

    #ARM15F0tW2hJ6nP0rT4tX ^"Stellatus, the Dragon" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Dragon)"
            ^"Magic Might" INTEGER 50
            ^"Might Form" TEXT "Ignem"
            ^"Intelligence" INTEGER 4
            ^"Perception" INTEGER 4
            ^"Presence" INTEGER 7
            ^"Communication" INTEGER 2
            ^"Strength" INTEGER 8
            ^"Stamina" INTEGER 8
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 0
            ^"Size" INTEGER 8
            ^"Confidence Score" INTEGER 3
            ^"Confidence Points" INTEGER 12
            ^"Soak" INTEGER 20
        }
        RULES {
            #ARM15F1uX5iK9oQ3sU7uY ^"Stellatus - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Second Sight."
            }
            #ARM15F2vY8jL2pR6tV0vZ ^"Stellatus - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Proud +3. Reputations: The Powerful Dragon who Lives in the Mountains (local) 5."
            }
            #ARM15F3wZ1kM5qS9uW3wA ^"Stellatus - Combat: Claws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Claws: Init +3, Attack +22, Defense +18, Damage +20."
            }
            #ARM15F4xA4lN8rT2vX6xB ^"Stellatus - Fatigue and Wounds" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fatigue levels: OK, 0/0/0/0/0, -1, -3, -5, Unconscious. Wound Penalties: -1 (1-13), -3 (14-26), -5 (27-39), Incapacitated (40-52)."
            }
            #ARM15F5yB7mO1sU5wY9yC ^"Stellatus - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "[Area] Lore 5 (history), Awareness 8 (human beings), Brawl 7 (claws), Divine Lore 1 (saints), Faerie Lore 2 (knights), Folk Ken 2 (scholars), Guile 4 (keeping secrets), Infernal Lore 0 (1) (undead), Magic Lore 8 (dragons), Order of Hermes Lore 1 (Tytalus), Second Sight 8 (magical invisibility)"
            }
            #ARM15F6zC0nP4tV8xZ2zD ^"Stellatus - Power: Human Form" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Human Form, 1 point, Init 0, Corpus: The dragon can assume the form of a human being. This is always the same form, a man with dark hair and eyes, in the prime of life. The transformation lasts until he eats or drinks, or until Stellatus uses the same power again to change back. The dragon has all his powers in human form, and the same Characteristics, but he is much weaker in combat and thus changes back if he needs to fight."
            }
            #ARM15F7aD3oQ7uW1yA5aE ^"Stellatus - Power: Instill Loyalty" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Instill Loyalty, 5 points, Init 0, Mentem: Stellatus can make any individual whom he can see totally loyal. This does not remove free will, but the victim is completely loyal to the dragon, and this loyalty lasts as long as Stellatus is alive."
            }
            #ARM15F8bE6pR0vX4zA8bF ^"Stellatus - Power: Fiery Breath" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fiery Breath, 1 point, Init +5, Ignem: Stellatus can breathe fire. The fire extends in a cone from his mouth, out to a distance of 20 paces, where it is 20 paces across. The fire has an intensity of +15. Dodging it is a Qik + Athletics roll against an Ease Factor of 9. A failure means the character is engulfed in the flames, taking +45 damage; a success by 3 points or less means a limb is covered, for +30 damage; a success by 4 to 6 points means the character is only brushed by the flames, for +15 damage; success by 7 points or more means the character dodges entirely."
            }
            #ARM15F9cF9qS3wY7bD1cG ^"Stellatus - Power: Master of Fire" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Master of Fire, 1 or more Might Points, Init 0, Ignem: Stellatus can control fire. He can duplicate any Hermetic Rego Ignem spell of fourth magnitude or less at the cost of 1 Might point. For every additional Might point he spends, the level of the spell increases by one magnitude."
            }
            #ARM15FAdG2rT6xZ0cE4dH ^"Stellatus - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 5 pawns of Ignem vis in each eye (10 total)."
            }
        }
    }

    #ARM15FBeH5sU9yA3dF7eI ^"Zwergenstimme" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Spirit)"
            ^"Magic Might" INTEGER 15
            ^"Might Form" TEXT "Imaginem"
            ^"Intelligence" INTEGER 0
            ^"Perception" INTEGER 0
            ^"Presence" INTEGER -1
            ^"Communication" INTEGER 4
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER -1
            ^"Dexterity" INTEGER 0
            ^"Quickness" INTEGER 3
            ^"Soak" TEXT "n/a"
        }
        RULES {
            #ARM15FCfI8tV2zA6eG0fJ ^"Zwergenstimme - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Great Communication, Improved Characteristics, Sharp Ears."
            }
            #ARM15FDgJ1uW5bD9fH3gK ^"Zwergenstimme - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Mischievous +3, Echo +3* (* = Essential Trait). Reputations: Murderous 1 (Local)."
            }
            #ARM15FEhK4vX8cE2gI6hL ^"Zwergenstimme - Combat: Thrown Rock" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Thrown Rock: Init +3, Attack +4, Defense n/a, Damage +5"
            }
            #ARM15FFiL7wY1dF5hJ9iM ^"Zwergenstimme - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Awareness 4 (sounds), Folk Ken 1 (fear), Guile 1 (mimicry), Music 2 (echoes), Thrown Weapon 4 (rocks)"
            }
            #ARM15FGjM0xZ4eG8iK2jN ^"Zwergenstimme - Power: Master of Sound" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Master of Sound, variable points, Init +5 minus Might cost, Imaginem: The spirit can duplicate any non-Ritual spell involving sound up to Level 15, at a cost of 1 Might Point per magnitude of effect. (Te)Im 15."
            }
            #ARM15FHkN3yA7fH1jL5kO ^"Zwergenstimme - Power: Bring Down the Roof" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Bring Down the Roof, 2 points, Init +3, Terram: The Zwergenstimme can cause the roof of a cave to collapse, crushing any within it. This causes +20 damage, and seals the exit from the cave. PeTe 20 (base 3, +1 Touch, +2 Room, +2 Size)."
            }
            #ARM15FIlO6zA0gI4kM8lP ^"Zwergenstimme - Power: Presence" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Presence, 0 points, constant, Imaginem: Grants awareness of everything that happens within the bounds of a specific domain chosen by the spirit. The spirit is coterminous with its associated landscape feature, present simultaneously everywhere within its boundaries. The area controlled by the spirit can produce a yearly harvest of 2 pawns of vis of an appropriate Form. The echo spirit can haunt a series of caves (constituting a Structure)."
            }
            #ARM15FJmP9bD3hJ7lN1mQ ^"Zwergenstimme - Power: Ghost Touch" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ghost Touch, variable cost, Init +2, Terram: The spirit can hurl rocks at enemies. It uses the combat scores listed above, but each attack costs 1 Might point."
            }
            #ARM15FKnQ2cE6iK0mO4nR ^"Zwergenstimme - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 3 pawns of Imaginem, as an immaterial echo."
            }
        }
    }
}
