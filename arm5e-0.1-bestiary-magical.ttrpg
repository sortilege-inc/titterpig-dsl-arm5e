                DESCRIPTION "Athletics 4, Great Weapon (long spear) 6, Leadership 6, Teaching (leadership) 3"
            }
            #ARM1575cF4lN8rT2vX6zA ^"Honos - Power: Instill Leadership" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Instill Leadership, 5 points, Init +4, Mentem: With a touch of his long spear, Honos can teach 17 experience points in the ability Leadership, to a maximum of Ability score 6. The Theurgist receives the insights immediately, but must then devote the season to study and reflecting upon them to gain the increase."
            }
            #ARM1576dG7mO1sU5wY9bD ^"Honos - Power: Centurions' Feast" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Centurions' Feast, 30 points, Init +4, Corpus: Produces a magical feast sufficient to feed one hundred people. All who partake of the feast who possess the Flaw Dutybound are instantly cured of any Light and Medium Wounds, and gain +10 on their next recovery checks. The food lasts for one hour, then dissipates, but the effects are permanent."
            }
            #ARM1577eH0nP4tV8xZ2cE ^"Honos - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: Leaves 6 pawns of Corpus in his armor when banished."
            }
        }
    }

