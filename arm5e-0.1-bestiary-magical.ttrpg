            #ARM1582hK9qS3wY7bD1fH ^"Portunes - Combat" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Combat: None. Vanishes if attacked, and can only be harmed by Perdo Vim spells. Wound Penalties: n/a."
