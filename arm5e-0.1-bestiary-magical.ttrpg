EXTENSION "ARM5e_Bestiary_Magical" {
    NAME "Ars Magica 5th Edition Definitive - Creatures of Magic"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Base"

    ############################################################################
    # CREATURES OF MAGIC
    # Magical creatures drawn from the core rulebook bestiary.
    # Includes jinn, beasts of virtue, daimon aspects, elementals, ghosts,
    # revenants, giants, dragons, and spirits.
    ############################################################################

    #ARM1500xY4zA6bC8dE0fG2h ^"Baghl, an Earth Jinni" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic"
            ^"Magic Might" INTEGER 15
            ^"Might Form" TEXT "Terram"
            ^"Intelligence" INTEGER -2
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER 1
            ^"Communication" INTEGER -1
            ^"Strength" INTEGER 3
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER -1
            ^"Size" INTEGER 2
            ^"Confidence Score" INTEGER 1
            ^"Confidence Points" INTEGER 3
            ^"Soak" INTEGER 10
        }
        RULES {
            #ARM1501qR7tW3nM9pX5vB ^"Baghl - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Jinn; Greater Immunity: Fire, Ways of the Mountains; Second Sight, Skinchanger, Strong-Willed, Tough. Flaws: Greater Malediction (honor bargains made), Magical Air, Vulnerable Magic (mua'addhin's call); Reclusive."
            }
            #ARM1502jK4mN8qS2uW6yA ^"Baghl - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Reclusive +5, Immutable +3, Proud +2"
            }
            #ARM1503eF1hJ5lP9rT3vX ^"Baghl - Combat: Maul" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Maul (warhammer): Init -1, Attack +11, Defense +3, Damage +15"
            }
            #ARM1504bD8gI2kO6nR0tV ^"Baghl - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-7), -3 (8-14), -5 (15-21), Incapacitated (22-28), Dead (29+)"
            }
            #ARM1505wA3cE7fH1jL5nP ^"Baghl - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Arabic 5 (stone), Athletics 3 (climbing), Great Weapon 4 (maul), Profession: Miner 3 (gemstones), Second Sight 4 (jinn), Theology: Islam 3 (jinn)"
            }
            #ARM1506zC6eG0iK4mO8qS ^"Baghl - Power: Flesh to Stone" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Flesh to Stone, 2 points, Init -4, Terram: Baghl can change any human he touches into stone until sunrise or until the morning call to prayer (Base 20, +1 Touch, +2 Sun)."
            }
            #ARM1507xB2dF6hJ0lN4pR ^"Baghl - Power: Ruler of Earth" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ruler of Earth, 1-3 points, Init 0, Terram: Duplicates any non-Ritual Perdo Terram or Rego Terram spell less than or equal to 15th level at a cost of 1 Might point per magnitude of the effect."
            }
            #ARM1508yD5gI9kM3oQ7sU ^"Baghl - Power: Incorporeal" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Incorporeal, 0 points, Init Constant, Mentem: Baghl is naturally both invisible and intangible, and cannot be influenced by the physical world. Magic can only directly target him if the caster can sense his existence. In this form he has no physical statistics or combat scores. Without taking a corporeal form, Baghl's physical characteristics are only used when dealing with other incorporeal creatures."
            }
            #ARM1509aE8hK2nP6rT0vX ^"Baghl - Power: Donning the Corporeal Veil" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Donning the Corporeal Veil, 2 points, Init +1, Corpus: Baghl can form the physical body described under Appearance to house his spiritual form; when doing so he acquires the physical characteristics, size, combat statistics, and Wound levels listed. His arms and armor are also created with this power. He cannot become fatigued. This body lasts until he decides he no longer needs it. Killing the body does not kill Baghl."
            }
            #ARM150AbG1jM5oQ9sU3wY ^"Baghl - Power: Presence" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Presence, 0 points, constant, Mentem: Baghl is aware of everything that goes on within his haunt. This power needs to Penetrate to perceive beings with a Magic Resistance."
            }
            #ARM150BcH4kN8pR2tV6xZ ^"Baghl - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 1 pawn of Terram vis can be collected every year from his haunt, in the form of a quartz-encrusted stalactite at the back of his cave. If slain in physical form, his body yields 3 pawns of Terram vis."
            }
        }
    }

    #ARM1510dI7lO1qS5uW9yA ^"Caladrius" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic"
            ^"Magic Might" INTEGER 14
            ^"Might Form" TEXT "Animal"
            ^"Cunning" INTEGER -1
            ^"Perception" INTEGER 2
            ^"Presence" INTEGER 1
            ^"Communication" INTEGER -2
            ^"Strength" INTEGER -4
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 1
            ^"Quickness" INTEGER 2
            ^"Size" INTEGER -2
            ^"Soak" INTEGER 3
        }
        RULES {
            #ARM1511fK0nR4tV8xZ2bD ^"Caladrius - Virtues and Flaws" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Virtues: Lesser Immunity (to non-lethal diseases), Unaffected by the Gift. Flaws: Compassionate (minor), Noncombatant."
            }
            #ARM1512gL3oS7uW1yA5cE ^"Caladrius - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Ibis* +3, Magnificent Appearance (Presence)* +3. (* = Essential Traits)"
            }
            #ARM1513hM6pT0vX4zA8dF ^"Caladrius - Combat: Dodge" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Dodge: Init +2, Attack n/a, Defense +5, Damage n/a"
            }
            #ARM1514iN9qU3wY7bC1eG ^"Caladrius - Fatigue and Wounds" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Fatigue Levels: OK, 0, -1, -3, -5, Unconscious. Wound Penalties: -1 (1-3), -3 (4-6), -5 (7-9), Incapacitated (10-12), Dead (13+)."
            }
            #ARM1515jO2rV6xZ0cE4gI ^"Caladrius - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Athletics 3 (flying), Awareness 4 (food), Brawl 2 (dodging), Ignem Resistance (solar heat) 4, Survival 3 (wetlands)"
            }
            #ARM1516kP5sW9yA3dF7hJ ^"Caladrius - Power: Healing Gaze" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Healing Gaze, 4 points, Init -14, Corpus. R: Eye, D: Mom, T: Ind. By gazing into a person's eyes, the caladrius can draw out any non-fatal disease from a sick person into itself. This removes any disease of up to Incapacitating strength, or resolves a critical or lesser aging crisis. The caladrius must immediately fly up toward the sun or else the disease returns to the patient. CrCo 40 (Base 30, +1 Eye, +1 affect either disease or aging)."
            }
            #ARM1517lQ8tX2zA6eG0iK ^"Caladrius - Power: Perceive the Afflictions" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Perceive the Afflictions of Mortal Flesh, 0 points, Init +1, Corpus. R: Per, D: Mom, T: Sight. By sight, the caladrius can identify any diseases a person has and how serious they are. InCo 25 (Base 5, +4 Sight)."
            }
            #ARM1518mR1uY5bC9fH3jL ^"Caladrius - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 3 Corpus (1 in each eye, 1 in the wings)"
            }
        }
    }

    #ARM1520nS4vZ8cE2gI6kM ^"Aneirin the Bard" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 15
            ^"Might Form" TEXT "Imaginem"
            ^"Intelligence" INTEGER 3
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER 2
            ^"Communication" INTEGER 4
            ^"Strength" TEXT "n/a"
            ^"Stamina" TEXT "n/a"
            ^"Dexterity" TEXT "n/a"
            ^"Quickness" TEXT "n/a"
            ^"Size" TEXT "n/a"
            ^"Soak" TEXT "n/a"
        }
        RULES {
            #ARM1521oT7wA1dF5hJ9lN ^"Aneirin - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Careful +3, Observant +2"
            }
            #ARM1522pU0xB4eG8iK2mO ^"Aneirin - Combat" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Combat: n/a. Wound Penalties: n/a."
            }
            #ARM1523qV3yC7fH1jL5nP ^"Aneirin - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Area Lore Stonehenge Tribunal 10, Magic Lore 8, Music 12, Teaching 5"
            }
            #ARM1524rW6zA0gI4kM8oQ ^"Aneirin - Power: Discorporate" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Discorporate, 0 points, Vim: Aneirin never physically manifests, save as a shadow and a melodic voice. He can only be harmed with magic."
            }
            #ARM1525sX9bD3hJ7lN1pR ^"Aneirin - Power: Names of Power" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Names of Power, 0 points: Aneirin knows many names of minor spirits and can teach them as a result of a Pact."
            }
            #ARM1526tY2cE6iK0mO4qS ^"Aneirin - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: If his spirit is somehow bottled rather than banished, 2 Imaginem Vis remains."
            }
        }
    }

    #ARM1530uZ5dF9jL3nP7rT ^"Chnoubis the Serpent" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 30
            ^"Might Form" TEXT "Mentem"
            ^"Intelligence" INTEGER 3
            ^"Perception" INTEGER 6
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER 2
            ^"Strength" INTEGER 0
            ^"Stamina" INTEGER 3
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 5
            ^"Size" INTEGER -1
            ^"Soak" INTEGER 9
        }
        RULES {
            #ARM1531vA8eG2kM6oQ0sU ^"Chnoubis - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Curious +4, Diplomatic +3, Proud +2, Noble +1"
            }
            #ARM1532wB1fH5lN9pR3tV ^"Chnoubis - Combat: Bite" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Bite: Init +5, Attack +8, Defense +8, Damage +5*. *On being bitten the victim must make a Fatigue test against Ease Factor 9 or lose a Fatigue level each round until he has succeeded for three consecutive rounds or fallen unconscious. While suffering these effects, the victim is unable to tell a lie (Penetration 25, Mentem), and is eager to talk to anyone present about anything on their mind. Once the victim falls unconscious no further Fatigue is lost, but they awaken with a terrible headache and must make a Stamina stress roll (plus Art of Memory if they have that Ability) at Ease Factor 6 to recall what transpired."
            }
            #ARM1533xC4gI8mO2qS6uW ^"Chnoubis - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-4), -3 (5-8), -5 (9-12), Banished (13+)"
            }
            #ARM1534yD7hJ1nP5rT9vX ^"Chnoubis - Power: Augury" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Augury, varies, Init +5, Mentem: By using this power Chnoubis is able to perform auguries as the Virtue Divination and Augury, with each Might Point allowing ten levels of success. This power allows Chnoubis to duplicate the effects of any Hermetic Intellego spell, and costs 1 point for every ten levels of the spell."
            }
            #ARM1535zA0iK4oQ8sU2wY ^"Chnoubis - Power: Aura of Rightful Authority" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Aura of Rightful Authority, 4 points, Init +5, Mentem: Equivalent to the ReMe20 Hermetic spell."
            }
            #ARM1536bE3jL7pR1tV5xZ ^"Chnoubis - Power: Discorporation" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Discorporation, 1 point, Init +7, Mentem: Becomes a discorporate spirit which can move as fast as lightning and is only visible to Intellego Vim magics or Second Sight. He sneaks up on victims invisibly and bites them, then listens to their secrets as the toxin takes effect."
            }
            #ARM1537cF6kM0qS4uW8yA ^"Chnoubis - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: On being banished his scales remain, containing 3 pawns of Intellego and 2 of Mentem vis."
            }
        }
    }

    #ARM1540dG9lN3rT7vX1zA ^"Dietrich von Bern" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 35
            ^"Might Form" TEXT "Corpus"
            ^"Intelligence" INTEGER 2
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER 5
            ^"Communication" INTEGER 3
            ^"Strength" INTEGER 5
            ^"Stamina" INTEGER 5
            ^"Dexterity" INTEGER 5
            ^"Quickness" INTEGER 3
            ^"Size" INTEGER 2
            ^"Soak" INTEGER 22
        }
        RULES {
            #ARM1541eH2mO6sU0wY4bD ^"Dietrich - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Proud +3, Barbarous +2, Crafty +2"
            }
            #ARM1542fI5nP9tV3xZ7cE ^"Dietrich - Combat: Greatsword" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Greatsword: Init +5, Attack +19, Defense +17, Damage +15*. *Dietrich's sword has been dipped in dragon's blood. No magical spell of level 40 or lower can deflect, harm, or control it. After being hit, the dragon's blood burns, causing an extra +5 damage per round (armor does not soak) unless an alchemist, herbalist, or healer can cure the wound."
            }
            #ARM1543gJ8oQ2uW6yA0dF ^"Dietrich - Wound Penalties and Soak" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Soak: +22 (full chain mail drenched in dragon's blood). Wound Penalties: -1 (1-7), -3 (8-14), -5 (15-21), Banished (22+)."
            }
            #ARM1544hK1pR5vX9zA3eG ^"Dietrich - Abilities" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Athletics 6, Great Weapon 10, Intrigue 6, Leadership 8"
            }
            #ARM1545iL4qS8wY2bD6fH ^"Dietrich - Power: Sacred Kingship" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Sacred Kingship, 10 points, Init +3, Vim: By laying hands on another character, Dietrich can permanently increase the character's Perception, Presence, or Communication by 1 point. He can only do this once per person, and can only to a maximum of +3. Increasing Presence this way is a very useful aid to the aspiring Mystagogue."
            }
            #ARM1546jM7rT1xZ5cE9gI ^"Dietrich - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: 7 Rego"
            }
        }
    }

    #ARM1550kN0sU4yA8dF2hJ ^"Gydryty-kom the Giant" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 40
            ^"Might Form" TEXT "Auram"
            ^"Intelligence" INTEGER 0
            ^"Perception" INTEGER 1
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER -2
            ^"Strength" INTEGER 8
            ^"Stamina" INTEGER 6
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 3
            ^"Size" INTEGER 3
            ^"Soak" INTEGER 20
        }
        RULES {
            #ARM1551lO3tV7zA1eG5iK ^"Gydryty-kom - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Hates Being Interrupted +4, Determined +3, Protective +2"
            }
            #ARM1552mP6uW0bD4fH8jL ^"Gydryty-kom - Combat: Brawl" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Brawl: Init +3, Attack +10, Defense +10, Damage +8"
            }
            #ARM1553nQ9vX3cE7gI1kM ^"Gydryty-kom - Wound Penalties" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Wound Penalties: -1 (1-8), -3 (9-16), -5 (17-24), Banished (25+)"
            }
            #ARM1554oR2wY6dF0hJ4lN ^"Gydryty-kom - Power: Auram Magic" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Auram Magic, varies, Init +3, Auram: May perform equivalent effects to any Auram magic at a cost of 1 point per magnitude, or for spells involving hail, 1 point per three magnitudes. Can perform Auram Ritual spells as if they were Formulaic spells; no extra time or vis is required."
            }
            #ARM1555pS5xZ9eG3iK7mO ^"Gydryty-kom - Power: Swallow Spells" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Swallow Spells, 5 points, Init +3, Vim: Can swallow any magical spell or effect with a level of 50 or less, completely dispelling it."
            }
            #ARM1556qT8yA2fH6jL0nP ^"Gydryty-kom - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: When he is banished his tongue remains, and contains 8 pawns of Auram Vis."
            }
        }
    }

    #ARM1560rU1zA5gI9kM3oQ ^"Hipta the Nurse" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 15
            ^"Might Form" TEXT "Animal"
            ^"Intelligence" INTEGER 3
            ^"Perception" INTEGER 1
            ^"Presence" INTEGER 3
            ^"Communication" INTEGER 2
            ^"Strength" TEXT "varies"
            ^"Stamina" TEXT "varies"
            ^"Dexterity" TEXT "varies"
            ^"Quickness" TEXT "varies"
            ^"Size" TEXT "varies from -5 to +2"
            ^"Soak" TEXT "varies"
        }
        RULES {
            #ARM1561sV4bD8hJ2lN6pR ^"Hipta - Personality Traits" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Calm +4, Protective +2"
            }
            #ARM1562tW7cE1iK5mO9qS ^"Hipta - Combat and Wounds" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Combat: Varies with form. Wound Penalties: Varies by form. Substitute Banished for Incapacitated."
            }
            #ARM1563uX0dF4jL8nP2rT ^"Hipta - Power: Shapechange" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Shapechange, 1 point, Init +5, Animal: May change form into any natural or fantastic beast from size -5 to +2. The change is instantaneous, and she can always speak in any form."
            }
            #ARM1564vY3eG7kM1oQ5sU ^"Hipta - Power: Dispel" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Dispel, varies, Init +5, Vim: May perform any Perdo Vim spell at will, for the cost of one Might point per magnitude. Hipta counts as familiar with all styles of magic for this purpose, and has a Penetration Score of 30, making invoking her a common way to end malevolent curses."
            }
            #ARM1565wZ6fH0lN4pR8tV ^"Hipta - Vis" DEF {
                APPLIES TO [^"Creature"]
                DESCRIPTION "Vis: Leaves 3 pawns of Animal Vis in the form of a white feather when banished."
            }
        }
    }

