    #ARM1590lO1uW5bD9fH3jL ^"Pukis, Dragon of the Hearth" DEF {
        APPLIES TO [^"Creature"]
        PROPERTIES {
            ^"Type" TEXT "Creature of Magic (Daimon Aspect)"
            ^"Magic Might" INTEGER 10
            ^"Might Form" TEXT "Ignem"
            ^"Intelligence" INTEGER -1
            ^"Perception" INTEGER 3
            ^"Presence" INTEGER 0
            ^"Communication" INTEGER 0
            ^"Strength" INTEGER -1
            ^"Stamina" INTEGER 4
            ^"Dexterity" INTEGER 3
            ^"Quickness" INTEGER 6
            ^"Size" INTEGER -2
