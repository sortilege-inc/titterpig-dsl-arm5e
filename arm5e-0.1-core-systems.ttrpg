BASE "ARM5e_Core_Systems" {
    NAME "Ars Magica 5th Edition Definitive - Combat, wounds, fatigue, advancement, aging, and warping"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"

    # Core Rulebook Chapters X & XI: Long Term Events (experience, advancement,
    # aging, Warping) and Obstacles (combat, weapons, armor, wounds, fatigue,
    # encumbrance, movement, diseases, poisons).

    # ===========================
    # COMBAT
    # ===========================

    #ARM400aB2cD4eF6gH8iJ0kL ^"Combat System" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Combat in Ars Magica is potentially extremely deadly.
        # A botched Defense roll is often fatal. Initiative determined once
        # for the entire combat; actions proceed in decreasing initiative order.
        # One combat round is approximately six seconds.
        # A Diameter Duration spell lasts twenty rounds.

        PROPERTIES {
            ^"Round Duration" STRING "approximately 6 seconds"
        }

        MECHANICS {
            ^"Initiative Total" FORMULA [^"Quickness" + ^"Weapon Initiative Modifier" - ^"Encumbrance" + STRESS_DIE]
            ^"Attack Total" FORMULA [^"Dexterity" + ^"Combat Ability" + ^"Weapon Attack Modifier" + STRESS_DIE]
            ^"Defense Total" FORMULA [^"Quickness" + ^"Combat Ability" + ^"Weapon Defense Modifier" + STRESS_DIE]
            ^"Attack Advantage" FORMULA [^"Attack Total" - ^"Defense Total"]
            ^"Damage Total" FORMULA [^"Strength" + ^"Weapon Damage Modifier" + ^"Attack Advantage"]
            ^"Soak Total" FORMULA [^"Stamina" + ^"Armor Protection" + ^"Form Bonus"]
        }

        RULES {
            #ARM401mN3oP5qR7sT9uV1wX: WHEN [^"Attack Total" > ^"Defense Total"] THEN CALCULATE ^"Damage Total"
            #ARM402yZ4aB6cD8eF0gH2iJ: WHEN [^"Damage Total" > ^"Soak Total"] THEN APPLY wound based on (^"Damage Total" - ^"Soak Total") and ^"Size"
            #ARM403kL5mN7oP9qR1sT3uV: WHEN [^"Attack Total" <= ^"Defense Total"] THEN NO damage
            #ARM404wX6yZ8aB0cD2eF4gH: INITIATIVE is rolled once for the entire combat and remains the same each round
            #ARM405iJ7kL9mN1oP3qR5sT: WHEN [initiative tie] THEN re-roll tied parties only
            #ARM406uV8wX0yZ2aB4cD6eF: WHEN [botch on Defense] THEN Defense Total = 0 (but negative base totals remain negative)
        }
    }

    # --- COMBAT SEQUENCE ---

    #ARM407gH9iJ1kL3mN5oP7qR ^"Combat Sequence" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # 1. Roll Initiative (once per combat)
        # 2. Act in order of decreasing initiative
        # 3. Attacker rolls Attack Total vs defender's Defense Total
        # 4. If hit, calculate Damage Total - Soak Total
        # 5. Look up wound severity on Damage Table using result and Size
        # 6. Repeat until all parties have acted = one round

        RULES {
            #ARM408sT0uV2wX4yZ6aB8cD: A party with high initiative may delay its action
            #ARM409eF1gH3iJ5kL7mN9oP: A magus casts spells at initiative based on Quickness alone (no weapon modifier)
            #ARM40AqR2sT4uV6wX8yZ0aB: A magus may cast one normal spell per round, plus fast-cast spells
        }
    }

    # --- SPELL DAMAGE ---

    #ARM40BcD3eF5gH7iJ9kL1mN ^"Spell Damage" DEF {
        APPLIES TO [^"Magus", ^"Mythic Companion"]

        # Spells list damage as "+X".
        # Damage Total = stress die + X
        # Target's Soak Total + stress die is subtracted to determine wounds.
        # When a spell is aimed, Attack Advantage is calculated but does
        # not affect damage dealt.

        MECHANICS {
            ^"Spell Damage Total" FORMULA [STRESS_DIE + ^"Spell Damage Bonus"]
        }
    }

    # ===========================
    # DAMAGE TABLE
    # ===========================

    #ARM40CoP4qR6sT8uV0wX2yZ ^"Damage Table" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Wound severity depends on (Damage Total - Soak Total) and target Size.
        # Each wound level spans (Size + 5) points.
        # Damage that exceeds the Soak Total by 0 or less = no wound.

        PROPERTIES {
            ^"Wound Range Formula" STRING "Each wound band spans (Size + 5) points"
        }

        # Damage Table (Damage Total - Soak Total)
        # Size -4 or less: Light 1, Medium 2, Heavy 3, Incap 4, Dead 5+
        # Size -3: Light 1-2, Medium 3-4, Heavy 5-6, Incap 7-8, Dead 9+
        # Size -2: Light 1-3, Medium 4-6, Heavy 7-9, Incap 10-12, Dead 13+
        # Size -1: Light 1-4, Medium 5-8, Heavy 9-12, Incap 13-16, Dead 17+
        # Size  0: Light 1-5, Medium 6-10, Heavy 11-15, Incap 16-20, Dead 21+
        # Size +1: Light 1-6, Medium 7-12, Heavy 13-18, Incap 19-24, Dead 25+
        # Size +2: Light 1-7, Medium 8-14, Heavy 15-21, Incap 22-28, Dead 29+
        # Size +3: Light 1-8, Medium 9-16, Heavy 17-24, Incap 25-32, Dead 33+
        # Each further +1 Size adds +1 to each wound range boundary.

        RULES {
            #ARM40DaB5cD7eF9gH1iJ3kL: WOUND_BAND = ^"Size" + 5
            #ARM40EmN6oP8qR0sT2uV4wX: WOUND_LEVEL = FLOOR((DAMAGE_AFTER_SOAK - 1) / WOUND_BAND) + 1
            # Level 1 = Light, 2 = Medium, 3 = Heavy, 4 = Incapacitated, 5+ = Dead
        }
    }

    # ===========================
    # WOUNDS
    # ===========================

    #ARM410yZ7aB9cD1eF3gH5iJ ^"Wound System" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Characters may have any number of wounds at any combination of levels.
        # Wound Penalties are cumulative across all wounds.
        # Soak is NOT an action and does not take Wound Penalties.
        # Characters cannot die immediately from non-fatal wounds,
        # but wounds can worsen through failed Recovery rolls.

        PROPERTIES {
            ^"Wound Penalties" DEF {
                ^"Light" INTEGER -1
                ^"Medium" INTEGER -3
                ^"Heavy" INTEGER -5
                ^"Incapacitated" STRING "no actions possible"
            }
        }

        RULES {
            #ARM411kL8mN0oP2qR4sT6uV: ^"Total Wound Penalty" = SUM of all wound penalties
            #ARM412wX9yZ1aB3cD5eF7gH: Wound Penalty applies to all actions (rolls and totals), but NOT to Soak
        }
    }

    # --- ACTIVITIES WHILE INJURED ---

    #ARM413iJ0kL2mN4oP6qR8sT ^"Activities While Injured" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Exceeding activity limits forces an immediate Recovery roll
        # for the most serious wound (can worsen but not improve).
        # Combat injuries do not require rolls for continued combat,
        # but excessive action afterward does.

        RULES {
            #ARM414uV1wX3yZ5aB7cD9eF: WHEN [^"Total Wound Penalty" >= -6] THEN can only talk, eat, and move short distances with help; no study/lab/craft
            #ARM415gH2iJ4kL6mN8oP0qR: WHEN [^"Total Wound Penalty" BETWEEN -5 AND -3] THEN can walk slowly; travel rates halved; Advancement Total halved if injured 1+ month; no lab/craft work
            #ARM416sT3uV5wX7yZ9aB1cD: WHEN [^"Total Wound Penalty" BETWEEN -2 AND -1] THEN can travel/study normally; no strenuous activities or fatiguing spells; lab/craft work allowed
        }
    }

    # --- WOUND RECOVERY ---

    #ARM417eF4gH6iJ8kL0mN2oP ^"Wound Recovery" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Recovery rolls are made for each wound individually.
        # Recovery rolls do NOT suffer from the Wound Penalty.

        MECHANICS {
            ^"Recovery Total" FORMULA [^"Stamina" + ^"Medical Ability Score" + ^"Magical Aid" + STRESS_DIE]
        }

        # Recovery Table
        # Wound Level | Interval    | Stable EF | Improvement EF
        # Light       | 1 week      | 4         | 10
        # Medium      | 1 month     | 6         | 12
        # Heavy       | 1 season    | 9         | 15
        # Incapacitated - see special rules

        PROPERTIES {
            ^"Recovery Intervals" DEF {
                ^"Light" STRING "1 week"
                ^"Medium" STRING "1 month"
                ^"Heavy" STRING "1 season"
            }
            ^"Stable Ease Factors" DEF {
                ^"Light" INTEGER 4
                ^"Medium" INTEGER 6
                ^"Heavy" INTEGER 9
            }
            ^"Improvement Ease Factors" DEF {
                ^"Light" INTEGER 10
                ^"Medium" INTEGER 12
                ^"Heavy" INTEGER 15
            }
        }

        RULES {
            #ARM418qR5sT7uV9wX1yZ3aB: WHEN [^"Recovery Total" >= ^"Improvement Ease Factor"] THEN wound improves by one level
            #ARM419cD6eF8gH0iJ2kL4mN: WHEN [^"Recovery Total" >= ^"Stable Ease Factor" AND < ^"Improvement Ease Factor"] THEN wound unchanged; gain +3 cumulative bonus to future Recovery rolls
            #ARM41AoP7qR9sT1uV3wX5yZ: WHEN [^"Recovery Total" < ^"Stable Ease Factor"] THEN wound worsens by one level (infection)
        }
    }

    # --- INCAPACITATION RECOVERY ---

    #ARM41BaB8cD0eF2gH4iJ6kL ^"Incapacitation Recovery" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Two Recovery rolls per day (sunrise and sunset).
        # On 0 or less, the character dies.
        # On 9+, all Incapacitating Wounds improve to Heavy.
        # Any other result = cumulative -1 penalty to subsequent Recovery rolls.
        # Medical attention adds relevant Ability score.

        RULES {
            #ARM41CmN9oP1qR3sT5uV7wX: WHEN [Incapacitation Recovery Total <= 0] THEN character dies
            #ARM41DyZ0aB2cD4eF6gH8iJ: WHEN [Incapacitation Recovery Total >= 9] THEN all Incapacitating Wounds become Heavy
            #ARM41EkL1mN3oP5qR7sT9uV: WHEN [Incapacitation Recovery Total BETWEEN 1 AND 8] THEN cumulative -1 to future Recovery rolls
        }
    }

    # --- MEDICAL ATTENTION ---

    #ARM41FwX2yZ4aB6cD8eF0gH ^"Medical Attention" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Combat wounds require Chirurgy.
        # Diseases and poisons require Medicine.
        # Only one Ability can help with a given wound.
        # No roll required from the attending medic.

        RULES {
            #ARM420iJ3kL5mN7oP9qR1sT: WHEN [wound from combat or injury] THEN use ^"Chirurgy" for medical attention
            #ARM421uV4wX6yZ8aB0cD2eF: WHEN [wound from disease or poison] THEN use ^"Medicine" for medical attention
        }
    }

    # ===========================
    # FATIGUE
    # ===========================

    #ARM422gH5iJ7kL9mN1oP3qR ^"Fatigue System" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Most characters have six Fatigue levels.
        # Short-Term and Long-Term Fatigue share the same track.
        # Fatigue Penalty applies to all rolls (including further Fatigue tests)
        # but NOT to Soak.

        PROPERTIES {
            ^"Fatigue Levels" DEF {
                ^"Fresh" DEF { ^"Penalty" INTEGER 0 }
                ^"Winded" DEF { ^"Penalty" INTEGER 0; ^"Recovery Time" STRING "2 minutes" }
                ^"Weary" DEF { ^"Penalty" INTEGER -1; ^"Recovery Time" STRING "10 minutes" }
                ^"Tired" DEF { ^"Penalty" INTEGER -3; ^"Recovery Time" STRING "30 minutes" }
                ^"Dazed" DEF { ^"Penalty" INTEGER -5; ^"Recovery Time" STRING "60 minutes" }
                ^"Unconscious" DEF { ^"Recovery Time" STRING "2 hours + 1 hour per additional level beyond Unconscious" }
            }
        }

        RULES {
            #ARM423sT6uV8wX0yZ2aB4cD: Fatigue Penalties are cumulative with Wound Penalties
            #ARM424eF7gH9iJ1kL3mN5oP: Recovery from fatigue requires quiet rest; active recovery takes double time
            #ARM425qR8sT0uV2wX4yZ6aB: OPTIONAL: Stamina roll vs EF 9 during recovery halves recovery time
        }
    }

    # --- SHORT-TERM FATIGUE ---

    #ARM426cD9eF1gH3iJ5kL7mN ^"Short-Term Fatigue" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Lost from brief strenuous actions: combat, spontaneous spells, sprinting.

        MECHANICS {
            ^"Fatigue Roll" FORMULA [^"Stamina" - ^"Encumbrance" + STRESS_DIE]
        }

        RULES {
            #ARM427oP0qR2sT4uV6wX8yZ: WHEN [^"Fatigue Roll" < 6] THEN lose 1 Short-Term Fatigue level
            #ARM428aB1cD3eF5gH7iJ9kL: WHEN [^"Fatigue Roll" BOTCH] THEN lose 2 Short-Term Fatigue levels
        }
    }

    # --- LONG-TERM FATIGUE ---

    #ARM429mN2oP4qR6sT8uV0wX ^"Long-Term Fatigue" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Lost from extended tiring activities (hiking, running messages).
        # Number of levels lost at storyguide's discretion.
        # Only recovered after a good night's rest (one level per night).
        # If both Short-Term and Long-Term levels are lost,
        # the more serious (deeper) levels are treated as short-term.

        RULES {
            #ARM42AyZ3aB5cD7eF9gH1iJ: Recovery requires one full night of rest per Long-Term Fatigue level
        }
    }

    # ===========================
    # ENCUMBRANCE
    # ===========================

    #ARM430kL4mN6oP8qR0sT2uV ^"Encumbrance System" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Two-stage calculation:
        # 1. Sum all item Load values -> Total Load
        # 2. Look up Burden from Load table
        # 3. Encumbrance = max(Burden - Strength, 0)
        #
        # Encumbrance penalizes most athletic activities and spell casting,
        # but NOT Attack and Defense (if Encumbrance is due to weapons/armor).
        # Encumbrance DOES subtract from Initiative.

        # Load -> Burden Table
        # Load 0 -> Burden 0
        # Load 1 -> Burden 1
        # Load 3 -> Burden 2
        # Load 6 -> Burden 3
        # Load 10 -> Burden 4
        # Load 15 -> Burden 5
        # Load 21 -> Burden 6
        # Load 28 -> Burden 7
        # Load 36 -> Burden 8
        # Load 45 -> Burden 9
        # Load 55 -> Burden 10
        # Burden increases at Load = Burden x (Burden + 1) / 2

        MECHANICS {
            ^"Total Load" FORMULA [SUM of all carried item ^"Load" values]
            ^"Burden" FORMULA [LOOKUP ^"Total Load" in Burden table]
            ^"Encumbrance" FORMULA [MAX(^"Burden" - ^"Strength", 0)]
        }

        RULES {
            #ARM431wX5yZ7aB9cD1eF3gH: Encumbrance subtracts from Initiative, spell casting, and athletic rolls
            #ARM432iJ6kL8mN0oP2qR4sT: Encumbrance does NOT subtract from Attack or Defense if due to weapons/armor
        }
    }

    # ===========================
    # MOVEMENT IN COMBAT
    # ===========================

    #ARM433uV7wX9yZ1aB3cD5eF ^"Movement" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Three speeds in combat. One pace = 3 feet.
        # Running may require a Fatigue roll.

        PROPERTIES {
            ^"Pace Length" STRING "3 feet"
        }

        MECHANICS {
            ^"Walk" FORMULA [10 + ^"Quickness" - ^"Encumbrance" UNIT "paces per round"]
            ^"Hurry" FORMULA [2 * (10 + ^"Quickness" - ^"Encumbrance") UNIT "paces per round"]
            ^"Run" FORMULA [4 * (10 + ^"Quickness" - ^"Encumbrance") UNIT "paces per round"]
        }
    }

    # ===========================
    # WEAPONS
    # ===========================

    #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Weapons are categorized by Combat Ability required: Brawl, Single Weapon,
        # Great Weapon, Thrown, or Bow.
        # If using weapon + shield, add modifiers of both.

        PROPERTIES {
            ^"Weapon Name" STRING REQUIRED
            ^"Required Ability" ENUM ["Brawl", "Single Weapon", "Great Weapon", "Thrown", "Bow"]
            ^"Initiative Modifier" INTEGER DEFAULT 0
            ^"Attack Modifier" INTEGER DEFAULT 0
            ^"Defense Modifier" INTEGER DEFAULT 0
            ^"Damage Modifier" INTEGER DEFAULT 0
            ^"Strength Requirement" INTEGER
            ^"Load" INTEGER DEFAULT 0
            ^"Range" INTEGER             # Paces, missile weapons only
            ^"Cost" ENUM ["Inexpensive", "Standard", "Expensive"]
        }
    }

    # --- MELEE WEAPONS ---

    # Brawl Weapons
    #ARM435sT9uV1wX3yZ5aB7cD ^"Dodge" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Brawl"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 0; ^"Load" INTEGER 0 }
        # Simply getting out of the way; no attack possible
    }

    #ARM436eF0gH2iJ4kL6mN8oP ^"Fist" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Brawl"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 0; ^"Load" INTEGER 0 }
    }

    #ARM437qR1sT3uV5wX7yZ9aB ^"Kick" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Brawl"]; ^"Initiative Modifier" INTEGER -1; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER -1; ^"Damage Modifier" INTEGER 3; ^"Load" INTEGER 0 }
    }

    #ARM438cD2eF4gH6iJ8kL0mN ^"Dagger" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Brawl"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 2; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 3; ^"Strength Requirement" INTEGER -3; ^"Load" INTEGER 0 }
    }

    # Single Weapons
    #ARM439oP3qR5sT7uV9wX1yZ ^"Axe" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 1; ^"Attack Modifier" INTEGER 4; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 6; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 1 }
    }

    #ARM43AaB4cD6eF8gH0iJ2kL ^"Sword, Long" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 2; ^"Attack Modifier" INTEGER 4; ^"Defense Modifier" INTEGER 1; ^"Damage Modifier" INTEGER 6; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 1 }
    }

    #ARM43BmN5oP7qR9sT1uV3wX ^"Sword, Short" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 1; ^"Attack Modifier" INTEGER 3; ^"Defense Modifier" INTEGER 1; ^"Damage Modifier" INTEGER 5; ^"Strength Requirement" INTEGER -1; ^"Load" INTEGER 1 }
    }

    #ARM43CyZ6aB8cD0eF2gH4iJ ^"Mace" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 1; ^"Attack Modifier" INTEGER 3; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 8; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 2 }
    }

    #ARM43DkL7mN9oP1qR3sT5uV ^"Spear, Short" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 2; ^"Attack Modifier" INTEGER 2; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 5; ^"Strength Requirement" INTEGER -1; ^"Load" INTEGER 1 }
    }

    #ARM43EwX8yZ0aB2cD4eF6gH ^"Lance" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 2; ^"Attack Modifier" INTEGER 4; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 5; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 2 }
        # May only be used from horseback as Single Weapon; dismounted use as Long Spear (Great Weapon)
    }

    # Shields
    #ARM43FiJ9kL1mN3oP5qR7sT ^"Shield, Buckler" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER 1; ^"Damage Modifier" INTEGER 0; ^"Strength Requirement" INTEGER -2; ^"Load" INTEGER 1 }
    }

    #ARM440uV0wX2yZ4aB6cD8eF ^"Shield, Round" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER 2; ^"Damage Modifier" INTEGER 0; ^"Strength Requirement" INTEGER -1; ^"Load" INTEGER 2 }
    }

    #ARM441gH1iJ3kL5mN7oP9qR ^"Shield, Heater" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Single Weapon"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 0; ^"Defense Modifier" INTEGER 3; ^"Damage Modifier" INTEGER 0; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 2 }
    }

    # Great Weapons
    #ARM442sT2uV4wX6yZ8aB0cD ^"Pole Arm" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Great Weapon"]; ^"Initiative Modifier" INTEGER 3; ^"Attack Modifier" INTEGER 4; ^"Defense Modifier" INTEGER 1; ^"Damage Modifier" INTEGER 8; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 2 }
    }

    #ARM443eF3gH5iJ7kL9mN1oP ^"Sword, Great" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Great Weapon"]; ^"Initiative Modifier" INTEGER 2; ^"Attack Modifier" INTEGER 5; ^"Defense Modifier" INTEGER 2; ^"Damage Modifier" INTEGER 9; ^"Strength Requirement" INTEGER 1; ^"Load" INTEGER 2 }
    }

    #ARM444qR4sT6uV8wX0yZ2aB ^"Staff" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Great Weapon"]; ^"Initiative Modifier" INTEGER 2; ^"Attack Modifier" INTEGER 3; ^"Defense Modifier" INTEGER 3; ^"Damage Modifier" INTEGER 2; ^"Strength Requirement" INTEGER -1; ^"Load" INTEGER 2 }
    }

    #ARM445cD5eF7gH9iJ1kL3mN ^"Warhammer" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Great Weapon"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 6; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 12; ^"Strength Requirement" INTEGER 2; ^"Load" INTEGER 3 }
    }

    #ARM446oP6qR8sT0uV2wX4yZ ^"Spear, Long" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Great Weapon"]; ^"Initiative Modifier" INTEGER 3; ^"Attack Modifier" INTEGER 3; ^"Defense Modifier" INTEGER 1; ^"Damage Modifier" INTEGER 7; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 3 }
    }

    # --- MISSILE WEAPONS ---

    #ARM447aB7cD9eF1gH3iJ5kL ^"Bow, Long" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Bow"]; ^"Initiative Modifier" INTEGER -2; ^"Attack Modifier" INTEGER 4; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 8; ^"Range" INTEGER 30; ^"Strength Requirement" INTEGER 2; ^"Load" INTEGER 2 }
    }

    #ARM448mN8oP0qR2sT4uV6wX ^"Bow, Short" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Bow"]; ^"Initiative Modifier" INTEGER -1; ^"Attack Modifier" INTEGER 3; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 6; ^"Range" INTEGER 15; ^"Strength Requirement" INTEGER -1; ^"Load" INTEGER 2 }
    }

    #ARM449yZ9aB1cD3eF5gH7iJ ^"Javelin" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Thrown"]; ^"Initiative Modifier" INTEGER 0; ^"Attack Modifier" INTEGER 2; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 5; ^"Range" INTEGER 10; ^"Strength Requirement" INTEGER 0; ^"Load" INTEGER 1 }
    }

    #ARM44AkL0mN2oP4qR6sT8uV ^"Sling" DEF {
        EXTENDS #ARM434gH8iJ0kL2mN4oP6qR ^"Weapon"
        PROPERTIES { ^"Required Ability" ENUM ["Thrown"]; ^"Initiative Modifier" INTEGER -3; ^"Attack Modifier" INTEGER 1; ^"Defense Modifier" INTEGER 0; ^"Damage Modifier" INTEGER 4; ^"Range" INTEGER 20; ^"Strength Requirement" INTEGER -3; ^"Load" INTEGER 0 }
    }

    # --- MISSILE COMBAT RULES ---

    #ARM44BwX1yZ3aB5cD7eF9gH ^"Missile Combat" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Attack Total suffers -3 per range increment beyond the first.
        # Defense against missiles: only shield Defense Bonus applies (not other weapons).
        # Combat Ability still applies (dodging).

        RULES {
            #ARM44CiJ2kL4mN6oP8qR0sT: WHEN [range > 1 increment] THEN ^"Attack Total" - 3 per increment beyond first
            #ARM44DuV3wX5yZ7aB9cD1eF: WHEN [defending against missiles] THEN only ^"Shield Defense Bonus" + ^"Combat Ability" apply
        }
    }

    # ===========================
    # ARMOR
    # ===========================

    #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        PROPERTIES {
            ^"Material" STRING REQUIRED
            ^"Outfitting" ENUM ["Partial", "Full"]
            ^"Protection" INTEGER DEFAULT 0
            ^"Load" INTEGER DEFAULT 0
        }
    }

    # Armor Table
    # Material          | Partial Prot | Partial Load | Full Prot | Full Load
    # Quilted/Fur       | 1            | 2            | n/a       | n/a
    # Heavy Leather     | 2            | 3            | n/a       | n/a
    # Metal Reinf Lthr  | 2            | 2            | 4         | 4
    # Leather Scale     | 3            | 3            | 5         | 5
    # Metal Scale       | 4            | 4            | 7         | 6
    # Chain Mail        | 6            | 4            | 9         | 7

    #ARM44FsT5uV7wX9yZ1aB3cD ^"Quilted Armor" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Quilted/Fur"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 1; ^"Load" INTEGER 2 }
    }

    #ARM450eF6gH8iJ0kL2mN4oP ^"Heavy Leather" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Heavy Leather"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 2; ^"Load" INTEGER 3 }
    }

    #ARM451qR7sT9uV1wX3yZ5aB ^"Metal Reinforced Leather, Partial" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Metal Reinforced Leather"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 2; ^"Load" INTEGER 2 }
    }

    #ARM452cD8eF0gH2iJ4kL6mN ^"Metal Reinforced Leather, Full" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Metal Reinforced Leather"; ^"Outfitting" ENUM ["Full"]; ^"Protection" INTEGER 4; ^"Load" INTEGER 4 }
    }

    #ARM453oP9qR1sT3uV5wX7yZ ^"Leather Scale, Partial" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Leather Scale"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 3; ^"Load" INTEGER 3 }
    }

    #ARM454aB0cD2eF4gH6iJ8kL ^"Leather Scale, Full" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Leather Scale"; ^"Outfitting" ENUM ["Full"]; ^"Protection" INTEGER 5; ^"Load" INTEGER 5 }
    }

    #ARM455mN1oP3qR5sT7uV9wX ^"Metal Scale, Partial" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Metal Scale"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 4; ^"Load" INTEGER 4 }
    }

    #ARM456yZ2aB4cD6eF8gH0iJ ^"Metal Scale, Full" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Metal Scale"; ^"Outfitting" ENUM ["Full"]; ^"Protection" INTEGER 7; ^"Load" INTEGER 6 }
    }

    #ARM457kL3mN5oP7qR9sT1uV ^"Chain Mail, Partial" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Chain Mail"; ^"Outfitting" ENUM ["Partial"]; ^"Protection" INTEGER 6; ^"Load" INTEGER 4 }
    }

    #ARM458wX4yZ6aB8cD0eF2gH ^"Chain Mail, Full" DEF {
        EXTENDS #ARM44EgH4iJ6kL8mN0oP2qR ^"Armor"
        PROPERTIES { ^"Material" STRING "Chain Mail"; ^"Outfitting" ENUM ["Full"]; ^"Protection" INTEGER 9; ^"Load" INTEGER 7 }
    }

    # ===========================
    # COMBAT OPTIONS
    # ===========================

    #ARM459iJ5kL7mN9oP1qR3sT ^"Disengaging" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Generate Defense Total instead of Attack Total on your turn.
        # If Defense beats all opponents' Attack Totals, you leave combat.
        # Cumulative +3 bonus per attempt after the first.
        # Attacking resets the bonus.
        # If not attacked since last turn, disengage automatically.

        RULES {
            #ARM45AuV6wX8yZ0aB2cD4eF: WHEN [disengaging] THEN generate Defense Total vs all opponents' Attack Totals
            #ARM45BgH7iJ9kL1mN3oP5qR: WHEN [repeated disengage attempts] THEN +3 cumulative bonus per attempt after first
            #ARM45CsT8uV0wX2yZ4aB6cD: WHEN [attack made between disengage attempts] THEN bonus resets to 0
        }
    }

    #ARM45DeF9gH1iJ3kL5mN7oP ^"Exertion" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Spend one Fatigue level to add Combat Ability as a bonus
        # to either Attack (one roll) or Defense (all rolls until next turn) for one round.

        RULES {
            #ARM45EqR0sT2uV4wX6yZ8aB: WHEN [exerting] THEN spend 1 Fatigue level; add ^"Combat Ability" to Attack OR Defense for one round
        }
    }

    #ARM45FcD1eF3gH5iJ7kL9mN ^"Mounted Combat" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Add Ride score (max +3) to Attack and Defense Totals.

        RULES {
            #ARM460oP2qR4sT6uV8wX0yZ: WHEN [mounted] THEN add MIN(^"Ride", 3) to ^"Attack Total" and ^"Defense Total"
        }
    }

    # --- NON-LETHAL COMBAT ---

    #ARM461aB3cD5eF7gH9iJ1kL ^"Non-Lethal Combat" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Scuffles: Convert wound results to fatigue/reduced wounds.
        # -3 Attack Total penalty if using a real weapon (and no weapon Damage bonus).
        # No penalty if unarmed or using a sap.
        #
        # Grapples: Hit with Attack Advantage > 0 to establish grapple.
        # Record Attack Advantage as Grapple Strength.
        # Grappled character attacks to reduce Grapple Strength.
        # Escape when Grapple Strength <= 0 (inflicts Light Wound on grappler).
        # Must use Brawl to grapple; any melee Ability to escape.

        RULES {
            #ARM462mN4oP6qR8sT0uV2wX: WHEN [scuffle with weapon] THEN -3 to Attack Total; no weapon Damage bonus
            #ARM463yZ5aB7cD9eF1gH3iJ: WHEN [grapple attack succeeds] THEN record Attack Advantage as Grapple Strength
            #ARM464kL6mN8oP0qR2sT4uV: WHEN [grappled character's Attack Advantage reduces Grapple Strength <= 0] THEN escape; inflict Light Wound on grappler
        }
    }

    # --- SPECIAL EFFECTS ---

    #ARM465wX7yZ9aB1cD3eF5gH ^"Special Combat Effects" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Set a required Attack Advantage for special maneuvers.
        # Most use Brawl since the attacker is not using a weapon.

        # Required Advantages:
        # Trip: 3
        # Grab worn item: 6
        # Disarm: 9
        # Take opponent's weapon: 12

        PROPERTIES {
            ^"Trip Required Advantage" INTEGER 3
            ^"Grab Item Required Advantage" INTEGER 6
            ^"Disarm Required Advantage" INTEGER 9
            ^"Take Weapon Required Advantage" INTEGER 12
        }
    }

    # --- GROUP COMBAT ---

    #ARM466iJ8kL0mN2oP4qR6sT ^"Group Combat" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Groups of 1-6 characters of roughly comparable ability
        # (all Combat Totals within 5-point range).
        # Have a vanguard (bears brunt of fighting); trained groups also have a leader.
        #
        # Untrained group: combat stats = vanguard's stats.
        # Trained group: same, plus bonus from other members' Combat Abilities
        # (capped at 3 x leader's Leadership score). Bonus applies to Attack OR Defense (choose each round).
        #
        # Damage inflicted = calculated damage x number of group members.
        # Blows spread evenly; vanguard takes at least as many as anyone else.
        # Wound severity based on individual target's Size.
        #
        # If vanguard or leader is incapacitated, group splits into individuals.
        # Max 6 members even with high Leadership.

        RULES {
            #ARM467uV9wX1yZ3aB5cD7eF: TRAINED_GROUP_BONUS = MIN(SUM of non-vanguard ^"Combat Ability" scores, 3 * leader's ^"Leadership")
            #ARM468gH0iJ2kL4mN6oP8qR: Bonus applies to EITHER Attack OR Defense each round (not both)
            #ARM469sT1uV3wX5yZ7aB9cD: WHEN [vanguard or leader incapacitated] THEN group splits; may reform in one non-combat round
        }
    }

    # --- DEFENDERS ---

    #ARM46AeF2gH4iJ6kL8mN0oP ^"Defender" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # One or more characters defend others. Treat defenders as a group.
        # Defended character injured only if defenders botch or are incapacitated.
        # Number defended may not exceed number defending.
        # Common: shield grogs defending a magus.

        RULES {
            #ARM46BqR3sT5uV7wX9yZ1aB: WHEN [all defenders incapacitated or botch] THEN defended character becomes a valid target
        }
    }

    # ===========================
    # OTHER PERILS
    # ===========================

    #ARM46CcD4eF6gH8iJ0kL2mN ^"Debilitation" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Diseases and poisons cause wounds.
        # Stamina check vs Ease Factor; failure inflicts a wound.
        # Wound severity set by the agent.
        # Recovery uses Medicine instead of Chirurgy.

        MECHANICS {
            ^"Resistance Roll" FORMULA [^"Stamina" + STRESS_DIE]
        }

        RULES {
            #ARM46DoP5qR7sT9uV1wX3yZ: WHEN [^"Resistance Roll" < ^"Agent Ease Factor"] THEN take wound of severity set by agent
        }
    }

    #ARM46EaB6cD8eF0gH2iJ4kL ^"Deprivation" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Check intervals: Air = 30 seconds, Water = 1 day, Food = 3 days.
        # Stamina check starts at EF 3, increases by 1 each interval.
        # Failure = lose 1 Fatigue level.
        # After unconsciousness: failure = Light Wound, worsening each time.
        # Air deprivation = Short-Term Fatigue; Food/Water = Long-Term.

        PROPERTIES {
            ^"Check Intervals" DEF {
                ^"Air" STRING "30 seconds"
                ^"Water" STRING "1 day"
                ^"Food" STRING "3 days"
            }
        }
    }

    # ===========================
    # EXPERIENCE AND ADVANCEMENT
    # ===========================

    #ARM470mN7oP9qR1sT3uV5wX ^"Experience System" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Experience points are awarded each season based on activities.
        # XP raises Arts and Abilities. A character gains XP in a subject
        # by spending seasons studying it.
        #
        # Ability XP cost: (new score) x 5 to increase by 1
        # Art XP cost: (new score) to increase by 1
        #
        # ADVANCEMENT TOTAL = Source Quality + Bonus from Virtues - Penalty from Flaws
        # Only one source of XP per season.
        # Seasons not spent gaining XP from other sources earn Exposure.

        MECHANICS {
            ^"Ability XP to Increase" FORMULA [(^"Current Score" + 1) * 5]
            ^"Art XP to Increase" FORMULA [^"Current Score" + 1]
            ^"Advancement Total" FORMULA [^"Source Quality" + ^"Virtue Bonus" - ^"Flaw Penalty"]
        }
    }

    # --- ADVANCEMENT TABLE ---

    #ARM471yZ8aB0cD2eF4gH6iJ ^"Advancement Table" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Score | Art XP (cumulative) | Ability XP (cumulative) | Ability XP to raise
        # 1     | 1                   | 5                       | 5
        # 2     | 3                   | 15                      | 10
        # 3     | 6                   | 30                      | 15
        # 4     | 10                  | 50                      | 20
        # 5     | 15                  | 75                      | 25
        # 6     | 21                  | 105                     | 30
        # 7     | 28                  | 140                     | 35
        # 8     | 36                  | 180                     | 40
        # 9     | 45                  | 225                     | 45
        # 10    | 55                  | 275                     | 50
        # 11    | 66                  | 330                     | 55
        # 12    | 78                  | 390                     | 60
        # 13    | 91                  | 455                     | 65
        # 14    | 105                 | 525                     | 70
        # 15    | 120                 | 600                     | 75
        # 16    | 136                 | 680                     | 80
        # 17    | 153                 | 765                     | 85
        # 18    | 171                 | 855                     | 90
        # 19    | 190                 | 950                     | 95
        # 20    | 210                 | 1050                    | 100

        MECHANICS {
            ^"Art Cumulative XP" FORMULA [^"Score" * (^"Score" + 1) / 2]
            ^"Ability Cumulative XP" FORMULA [^"Score" * (^"Score" + 1) / 2 * 5]
        }
    }

    # --- EXPERIENCE SOURCES ---

    #ARM472kL9mN1oP3qR5sT7uV ^"Exposure" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # The least effective study method; available in any season without other XP gain.
        # Source Quality: 2
        # XP may be split between up to two Abilities or Arts used during the season.
        # If split, calculate separate Advancement Totals based on SQ 1 each.

        PROPERTIES {
            ^"Source Quality" INTEGER 2
            ^"Max Split" INTEGER 2
        }
    }

    #ARM473wX0yZ2aB4cD6eF8gH ^"Adventure" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Source Quality: 5-10, set by storyguide.
        # Takes a whole season even if the adventure is short.
        # XP may be split among any number of Abilities/Arts used in the adventure.
        # Max 5 points from adventure SQ to a single Ability or Art.
        # Arts only gain XP from "on stage" use; Abilities also from "off stage."

        PROPERTIES {
            ^"Source Quality" INTEGER MIN 5 MAX 10
            ^"Max Per Ability" INTEGER 5
        }
    }

    #ARM474iJ1kL3mN5oP7qR9sT ^"Practice" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Full-time activity. Source Quality usually 4.
        # Exceptions:
        #   Language in native community (score < 5): SQ 8
        #   Area Lore by exploring: SQ 5-7
        #   Forced craft practice with feedback: SQ 5
        #   Spell mastery practice: SQ 5
        # Hermetic Arts cannot be increased by practice (use vis study instead).
        # XP may be split; if SQs differ, use lowest.

        PROPERTIES {
            ^"Base Source Quality" INTEGER 4
        }

        RULES {
            #ARM475uV2wX4yZ6aB8cD0eF: Hermetic Arts cannot be increased by Practice
        }
    }

    #ARM476gH3iJ5kL7mN9oP1qR ^"Training" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # One-on-one instruction. Master must have score >= 2 in the Ability.
        # Source Quality: Master's score in taught Ability + 3
        # Gain Limit: Master's score
        # Master must have higher score than student.
        # Master may work while training (student may not).
        # Hermetic Arts cannot be increased by Training.

        MECHANICS {
            ^"Training Source Quality" FORMULA [^"Master Score" + 3]
            ^"Training Gain Limit" FORMULA [^"Master Score"]
        }

        RULES {
            #ARM477sT4uV6wX8yZ0aB2cD: ^"Master Score" must be > ^"Student Score"
            #ARM478eF5gH7iJ9kL1mN3oP: Hermetic Arts cannot be increased by Training
        }
    }

    #ARM479qR6sT8uV0wX2yZ4aB ^"Teaching" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Teacher must have score >= 2 in Ability, or >= 5 in Art.
        # Teacher and students must share a common language.
        # Teacher must have higher score than student.
        # Source Quality: Teacher's Communication + Teaching + 3 + bonus
        #   1 student: +6 bonus
        #   2 students: +3 bonus
        #   3+ students: no bonus
        # Max students: Teaching x 5 (or 1 if Teaching = 0).
        # Gain Limit: Teacher's score in the Art or Ability.
        # Hermetic Arts can be taught but only one-on-one (+6 bonus applies).

        MECHANICS {
            ^"Teaching Source Quality" FORMULA [^"Communication" + ^"Teaching" + 3 + ^"Student Bonus"]
            ^"Teaching Gain Limit" FORMULA [^"Teacher Score"]
            ^"Max Students" FORMULA [MAX(^"Teaching" * 5, 1)]
        }

        RULES {
            #ARM47AcD7eF9gH1iJ3kL5mN: WHEN [1 student] THEN ^"Student Bonus" = 6
            #ARM47BoP8qR0sT2uV4wX6yZ: WHEN [2 students] THEN ^"Student Bonus" = 3
            #ARM47CaB9cD1eF3gH5iJ7kL: WHEN [3+ students] THEN ^"Student Bonus" = 0
            #ARM47DmN0oP2qR4sT6uV8wX: Hermetic Arts may only be taught one-on-one
        }
    }

    # --- BOOKS ---

    #ARM47EyZ1aB3cD5eF7gH9iJ ^"Study from Books" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Requires fluency (score 4+) in the language and Artes Liberales (to read/write).
        # Two types: Summae and Tractatus.

        RULES {
            #ARM47FkL2mN4oP6qR8sT0uV: REQUIRES ^"Language Score" >= 4 AND ^"Artes Liberales" >= 1
        }
    }

    #ARM480wX3yZ5aB7cD9eF1gH ^"Summa" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Organized account from basics to a certain Level.
        # Can be studied as long as student's score < summa Level.
        # Has Level and Source Quality.
        # Source Quality (writing): Communication + 6 + bonus (for lowering Level below half score)
        # Level: up to half author's score.
        # Bonus for lower Level: 1 per level dropped (Art) or 3 per level (Ability), max = base Quality.
        # Writing time: accumulate Communication + Language points per season; complete when total >= Level (Art) or 5 x Level (Ability).

        PROPERTIES {
            ^"Level" INTEGER REQUIRED
            ^"Quality" INTEGER REQUIRED
        }

        MECHANICS {
            ^"Summa Writing Quality" FORMULA [^"Communication" + 6 + ^"Level Bonus"]
            ^"Summa Max Level" FORMULA [FLOOR(^"Author Score" / 2)]
        }

        RULES {
            #ARM481iJ4kL6mN8oP0qR2sT: GAIN_LIMIT: student's score must be < ^"Level" to gain XP
        }
    }

    #ARM482uV5wX7yZ9aB1cD3eF ^"Tractatus" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # In-depth treatment of one aspect. Useful at any level.
        # Takes one season to study; each tractatus only studied once per student.
        # No benefit from studying own tractatus.
        # Quality: Author's Communication + 6
        # Author may write total tractatus = half Ability score or 1/5 Art score (round up).

        PROPERTIES {
            ^"Quality" INTEGER REQUIRED
        }

        MECHANICS {
            ^"Tractatus Writing Quality" FORMULA [^"Communication" + 6]
            ^"Max Tractatus (Ability)" FORMULA [CEIL(^"Author Score" / 2)]
            ^"Max Tractatus (Art)" FORMULA [CEIL(^"Author Score" / 5)]
        }

        RULES {
            #ARM483gH6iJ8kL0mN2oP4qR: Each student may study a given tractatus only once
            #ARM484sT7uV9wX1yZ3aB5cD: A person gains nothing from studying a tractatus they wrote
        }
    }

    # --- VIS STUDY ---

    #ARM485eF8gH0iJ2kL4mN6oP ^"Vis Study" DEF {
        APPLIES TO [^"Magus"]

        # Magi study Hermetic Arts from raw vis (the only way to "practice" Arts).
        # Requires 1 pawn of appropriate Art vis per 5 levels (or part thereof), minimum 1 pawn.
        # All pawns consumed during the season.
        # Source Quality: stress die + Aura Bonus
        # Double botch may trigger Wizard's Twilight; botch dice = pawns used.
        # Does not require a laboratory.

        MECHANICS {
            ^"Vis Pawns Required" FORMULA [MAX(CEIL(^"Art Score" / 5), 1)]
            ^"Vis Study Source Quality" FORMULA [STRESS_DIE + ^"Aura Bonus"]
        }

        RULES {
            #ARM486qR9sT1uV3wX5yZ7aB: WHEN [double botch on vis study] THEN may enter Wizard's Twilight
            #ARM487cD0eF2gH4iJ6kL8mN: BOTCH_DICE = number of pawns used
        }
    }

    # --- COPYING BOOKS ---

    #ARM488oP1qR3sT5uV7wX9yZ ^"Copying Books" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Careful copying: 1 tractatus per season; or accumulate (6 + Profession: Scribe) points toward summa level.
        # Quick copying: 3x rate of careful, but quality is 1 lower.
        # Corrupted copies: must be literate in the language (score 3+);
        # Magic Theory 1+ needed for Hermetic texts; relevant Realm Lore 1+ for supernatural texts.

        MECHANICS {
            ^"Careful Copy Rate (Summa)" FORMULA [6 + ^"Profession Scribe"]
            ^"Quick Copy Rate (Summa)" FORMULA [3 * (6 + ^"Profession Scribe")]
        }

        RULES {
            #ARM489aB2cD4eF6gH8iJ0kL: Quick copies have Quality 1 lower than original
            #ARM48AmN3oP5qR7sT9uV1wX: Copying without required skills produces corrupted (useless) text
        }
    }

    # --- DISTRACTIONS ---

    #ARM48ByZ4aB6cD8eF0gH2iJ ^"Distractions" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Long distractions (> 1 month) reduce Advancement or writing totals.
        # 1 month lost: total reduced to 2/3
        # 2 months lost: total reduced to 1/3
        # 3 months lost: total reduced to 0 (whole season lost)

        RULES {
            #ARM48CkL5mN7oP9qR1sT3uV: WHEN [1 month distraction] THEN total = original * 2/3
            #ARM48DwX6yZ8aB0cD2eF4gH: WHEN [2 months distraction] THEN total = original * 1/3
            #ARM48EiJ7kL9mN1oP3qR5sT: WHEN [3 months distraction] THEN total = 0
        }
    }

    # --- SEASONS ---

    #ARM48FuV8wX0yZ2aB4cD6eF ^"Seasonal Activity" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Normal characters work 2 seasons and get 2 free seasons.
        # Free time is spread over the year (cannot leave job for entire seasons).
        # Working seasons generate Exposure XP.
        # Hermetic magi have 4 genuinely free seasons (lab work requires full actual season).

        RULES {
            #ARM490gH9iJ1kL3mN5oP7qR: Mundane characters: 2 working seasons + 2 free seasons per year
            #ARM491sT0uV2wX4yZ6aB8cD: Hermetic magi: 4 free seasons per year
            #ARM492eF1gH3iJ5kL7mN9oP: Working seasons generate Exposure XP
        }
    }

    # --- WORSHIP ---

    #ARM493qR2sT4uV6wX8yZ0aB ^"Worship" DEF {
        APPLIES TO [^"Companion", ^"Grog", ^"Mythic Companion"]

        # Seasonal study activity for Christians with access to a church.
        # Involves demanding daily routine: fasting, prayer, meditation.
        # Source Quality: Divine aura of the church.
        # XP may be spent on: Church Lore, Concentration, Music,
        # or Divine-aligned Supernatural Abilities the character already has.
        # May be split between several Abilities/Arts.

        MECHANICS {
            ^"Worship Source Quality" FORMULA [^"Divine Aura"]
        }
    }

    # --- LEARNING SUPERNATURAL ABILITIES ---

    #ARM494cD3eF5gH7iJ9kL1mN ^"Learning Supernatural Abilities" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]

        # Only characters with The Gift can learn Magic-realm Supernatural Abilities.
        # Must reach score 1 (5 XP) in the first season.
        # Must subtract total of scores in other Supernatural Abilities from Source Quality.
        # If Hermetic Arts opened: subtract 15 or sum of all Art scores (whichever is higher).
        # Mystery Cults can often avoid the penalty through Initiation rituals.

        MECHANICS {
            ^"Effective Source Quality" FORMULA [^"Normal Source Quality" - ^"Sum Other Supernatural Ability Scores"]
        }

        RULES {
            #ARM495oP4qR6sT8uV0wX2yZ: WHEN [Arts opened] THEN also subtract MAX(15, SUM of all Art Scores) from Source Quality
            #ARM496aB5cD7eF9gH1iJ3kL: Must gain >= 5 XP in first season to learn new Supernatural Ability
        }
    }

    # ===========================
    # AGING AND DECREPITUDE
    # ===========================

    #ARM497mN6oP8qR0sT2uV4wX ^"Aging" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Characters begin aging in Winter after turning 35.
        # One roll per year.
        # Characters under a Longevity Ritual roll every year but treat
        # rolls of 10+ as 9 until age 35.

        MECHANICS {
            ^"Aging Total" FORMULA [STRESS_DIE_NO_BOTCH + CEIL(^"Age" / 10) - ^"Living Conditions Modifier" - ^"Longevity Ritual Modifier"]
        }

        # Living Conditions Modifiers:
        # +2: Wealthy or healthy location; typical Summer/Autumn covenant (magus)
        # +1: Typical Summer/Autumn covenant (mundane); typical Spring/Winter covenant (magus)
        #  0: Average peasant
        # -1: Leper colony; bad air trade; mine (cumulative with each other)
        # -2: Poor or unhealthy location; typical town (cumulative with -1 modifiers)

        # Aging Roll Results:
        # 2 or less: No apparent aging
        # 3 or more: Apparent age increases by one year
        # 10-12: 1 Aging Point in any Characteristic
        # 13: Gain Aging Points to reach next Decrepitude level + Crisis
        # 14: 1 Aging Point in Quickness
        # 15: 1 Aging Point in Stamina
        # 16: 1 Aging Point in Perception
        # 17: 1 Aging Point in Presence
        # 18: 1 Aging Point in Strength and Stamina
        # 19: 1 Aging Point in Dexterity and Quickness
        # 20: 1 Aging Point in Communication and Presence
        # 21: 1 Aging Point in Intelligence and Perception
        # 22+: Gain Aging Points to reach next Decrepitude level + Crisis

        RULES {
            #ARM498yZ7aB9cD1eF3gH5iJ: WHEN [Aging Points in a Characteristic > ABS(Characteristic)] THEN Characteristic drops by 1; all Aging Points in that Characteristic are lost
            #ARM499kL8mN0oP2qR4sT6uV: Every Aging Point also counts as 1 XP toward Decrepitude
        }
    }

    # --- DECREPITUDE ---

    #ARM49AwX9yZ1aB3cD5eF7gH ^"Decrepitude" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Increases like an Ability (XP = Aging Points gained).
        # Score 4: Extremely frail; must roll Crisis for stressful activities (journeys, combat).
        # Score 5: Bedridden; will die within months. Cannot be saved by mortal intervention.

        RULES {
            #ARM49BiJ0kL2mN4oP6qR8sT: WHEN [^"Decrepitude" >= 4] THEN must roll on Crisis Table for stressful activities
            #ARM49CuV1wX3yZ5aB7cD9eF: WHEN [^"Decrepitude" >= 5] THEN bedridden; death within months
        }
    }

    # --- CRISIS ---

    #ARM49DgH2iJ4kL6mN8oP0qR ^"Crisis" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Triggered by aging results of 13 or 22+, or by Decrepitude 4+ in stressful situations.
        # Increase Decrepitude first, then roll on Crisis Table.

        MECHANICS {
            ^"Crisis Total" FORMULA [SIMPLE_DIE + CEIL(^"Age" / 10) + ^"Decrepitude Score"]
        }

        # Crisis Table:
        # 8 or less: Bedridden for a week
        # 9-14: Bedridden for a month
        # 15: Minor illness. Sta stress roll vs EF 3 or CrCo20 to survive.
        # 16: Serious illness. Sta stress roll vs EF 6 or CrCo25 to survive.
        # 17: Major illness. Sta stress roll vs EF 9 or CrCo30 to survive.
        # 18: Critical illness. Sta stress roll vs EF 12 or CrCo35 to survive.
        # 19+: Terminal illness. CrCo40 required to survive.

        RULES {
            #ARM49EsT3uV5wX7yZ9aB1cD: Medical attention: Int + Medicine vs EF 6; success adds Medicine score to survival roll; botch subtracts 3
            #ARM49FeF4gH6iJ8kL0mN2oP: Character who survives a crisis needs rest of season to recover (no other activities)
            #ARM4A0qR5sT7uV9wX1yZ3aB: Virtues affecting aging rolls do NOT affect crisis survival rolls
        }
    }

    # ===========================
    # WARPING
    # ===========================

    #ARM4A1cD6eF8gH0iJ2kL4mN ^"Warping" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Warping Score increases like an Ability using Warping Points.
        # To increase by 1: 5 x (new score) Warping Points needed.
        # Points from all realms stack (not distinguished by source).
        # Creatures with a Might score are immune to warping.

        # Warping Score | Cumulative WP | WP to increase to
        # 1             | 5             | 5
        # 2             | 15            | 10
        # 3             | 30            | 15
        # 4             | 50            | 20
        # 5             | 75            | 25

        RULES {
            #ARM4A2oP7qR9sT1uV3wX5yZ: Creatures with a Might score are immune to Warping
        }
    }

    # --- SOURCES OF WARPING POINTS ---

    #ARM4A3aB8cD0eF2gH4iJ6kL ^"Warping Sources" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Four main sources:
        # 1. Living in a strong (6+) supernatural aura
        # 2. Being affected by a powerful (6th+ magnitude) supernatural effect
        #    (unless you created it or it was designed for you)
        # 3. Being continuously under a supernatural effect (any power level)
        # 4. Botching a roll to use a supernatural ability (1 WP per botch zero)

        # Aura Warping Table:
        # Aura 6:  Always=1/year, Half=None,   Frequent=None
        # Aura 7:  Always=1/year, Half=1/2yr,  Frequent=None
        # Aura 8:  Always=2/year, Half=1/year,  Frequent=None
        # Aura 9:  Always=1/season, Half=2/year, Frequent=1/year
        # Aura 10: Always=1/month, Half=1/season, Frequent=2/year

        # Characters with supernatural abilities from the same realm as the aura
        # do NOT gain Warping Points from living in that aura.

        # Warping from Constant Effects:
        # Brief low-power, cast by/for subject: 0 WP
        # Brief high-power, cast by/for subject: 0 WP
        # Brief high-power, NOT cast by/for: 1 WP when cast
        # Constant low-power: 1 WP/year
        # Constant high-power, cast by/for: 1 WP when cast + 1 WP/year
        # Constant high-power, NOT cast by/for: 1 WP when cast + 1 WP/year + 1 WP/season

        RULES {
            #ARM4A4mN9oP1qR3sT5uV7wX: All sources of Warping Points stack
            #ARM4A5yZ0aB2cD4eF6gH8iJ: Parma Magica and Aegis of the Hearth do NOT cause constant-effect Warping
            #ARM4A6kL1mN3oP5qR7sT9uV: Familiar bond and Talisman bond do NOT cause Warping
            #ARM4A7wX2yZ4aB6cD8eF0gH: WHEN [supernatural botch] THEN gain 1 Warping Point per zero on botch dice
        }
    }

    # --- EFFECTS OF WARPING ---

    #ARM4A8iJ3kL5mN7oP9qR1sT ^"Warping Effects" DEF {
        APPLIES TO [^"Companion", ^"Grog", ^"Mythic Companion"]

        # For mundane characters (not Hermetic magi):
        # Warping 1: Gain a Minor Flaw reflecting predominant warping source
        # Warping 3: Gain a second Minor Flaw
        # Warping 5: Gain a supernatural Minor Virtue (stops further aura warping of same type)
        # Warping 6+: Gain a Major Flaw per point (appropriate to main sources)
        #
        # Hermetic magi instead become more prone to Wizard's Twilight
        # (handled in core-magic Wizard's Twilight section).

        RULES {
            #ARM4A9uV4wX6yZ8aB0cD2eF: WHEN [^"Warping Score" reaches 1] THEN gain Minor Flaw (mundane characters)
            #ARM4AAgH5iJ7kL9mN1oP3qR: WHEN [^"Warping Score" reaches 3] THEN gain second Minor Flaw (mundane characters)
            #ARM4ABsT6uV8wX0yZ2aB4cD: WHEN [^"Warping Score" reaches 5] THEN gain supernatural Minor Virtue (mundane characters)
            #ARM4ACeF7gH9iJ1kL3mN5oP: WHEN [^"Warping Score" >= 6] THEN gain Major Flaw per additional point (mundane characters)
        }
    }

    # ===========================
    # REALM AURAS AND INTERACTIONS
    # ===========================

    #ARM4ADqR8sT0uV2wX4yZ6aB ^"Realm Interactions" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion", ^"Creature"]

        # Four supernatural realms: Magic, Divine, Faerie, Infernal.
        # Each realm generates auras (rated 1-10+).
        # Supernatural powers are modified based on the power's realm and the aura's realm.
        #
        # Realm Interaction Table (Power's Realm -> Aura's Realm):
        #
        # Magic power in:
        #   Magic aura:    + aura
        #   Divine aura:   - (3 x aura)
        #   Faerie aura:   + (half aura, round up)
        #   Infernal aura: - aura
        #
        # Divine power in:
        #   Magic aura:    + aura (no penalty anywhere)
        #   Divine aura:   + aura
        #   Faerie aura:   + aura
        #   Infernal aura: + aura
        #
        # Faerie power in:
        #   Magic aura:    + (half aura, round up)
        #   Divine aura:   - (4 x aura)
        #   Faerie aura:   + aura
        #   Infernal aura: - aura
        #
        # Infernal power in:
        #   Magic aura:    - aura
        #   Divine aura:   - (5 x aura)
        #   Faerie aura:   - (2 x aura)
        #   Infernal aura: + aura

        # Additional botch dice = aura level (when in a hostile/foreign aura).
        # The Divine is never hampered by other auras (no penalty, no extra botch dice).

        RULES {
            #ARM4AEcD9eF1gH3iJ5kL7mN: Aura modifier affects: Casting Score, Lab Total, Supernatural Ability rolls, Magic Resistance
            #ARM4AFoP0qR2sT4uV6wX8yZ: Aura modifier to Penetration: applies through Casting Score modification (not applied twice)
            #ARM4B0aB1cD3eF5gH7iJ9kL: For supernatural creatures, aura modifier applies directly to Penetration
            #ARM4B1mN2oP4qR6sT8uV0wX: Foreign/hostile auras add extra botch dice equal to the aura level
            #ARM4B2yZ3aB5cD7eF9gH1iJ: Divine powers have NO penalty and NO extra botch dice in any aura
        }
    }

    # ===========================
    # CREATURE MIGHT AND PENETRATION
    # ===========================

    #ARM4B3kL4mN6oP8qR0sT2uV ^"Creature Powers" DEF {
        APPLIES TO [^"Creature"]

        # Creatures with a Might Score:
        # Magic Resistance = Might Score + Aura Modifier
        # Penetration = Might Score - (5 x Might Points spent on power) + Penetration Bonus + Aura Modifier
        #
        # Characters with supernatural abilities (not Hermetic):
        # Penetration = Effect Roll - Ease Factor + Penetration Bonus + Aura Modifier

        MECHANICS {
            ^"Creature Magic Resistance" FORMULA [^"Might Score" + ^"Aura Modifier"]
            ^"Creature Penetration" FORMULA [^"Might Score" - (5 * ^"Might Points Spent") + ^"Penetration Bonus" + ^"Aura Modifier"]
            ^"Character Supernatural Penetration" FORMULA [^"Effect Roll" - ^"Ease Factor" + ^"Penetration Bonus" + ^"Aura Modifier"]
        }
    }

    # ===========================
    # MYSTERY INITIATION
    # ===========================

    #ARM4B4wX5yZ7aB9cD1eF3gH ^"Mystery Initiation" DEF {
        APPLIES TO [^"Magus"]

        # Governed by (House) Lore. Initiates not apprenticed to the House need (House) Lore 1+.
        # No die roll; success is automatic if total >= target.

        MECHANICS {
            ^"Initiation Total" FORMULA [^"Presence" + ^"House Lore" + ^"Script Bonus"]
        }

        # Target Levels:
        # Minor Virtue (known by Mystagogue): 15
        # Major Virtue (known by Mystagogue): 21
        # Minor Virtue (new/unknown): 18
        # Major Virtue (new/unknown): 30
        # Minimum target: 9 (regardless of reductions)

        # Past Ordeal reductions (only one past Ordeal counts):
        # 1st Initiation after Ordeal: -3 Minor, -6 Medium, -9 Major
        # 2nd Initiation after Ordeal: -2 Minor, -4 Medium, -6 Major
        # 3rd Initiation after Ordeal: -1 Minor, -2 Medium, -3 Major

        # Script Bonus elements:
        # +3: Special place at special time
        # +3: Complete a specific Quest
        # +1: Sacrifice time (serve another in cult)
        # +1: Sacrifice material goods/wealth
        # +3 to +6: Sacrifice something of great symbolic value (familiar, talisman, invested device)
        # +3: Minor Ordeal (Minor Flaw or lose Minor Virtue)
        # +6: Medium Ordeal (Minor Flaw increased to Major)
        # +9: Major Ordeal (Major Flaw or lose Major Virtue)

        RULES {
            #ARM4B5iJ6kL8mN0oP2qR4sT: WHEN [^"Initiation Total" >= ^"Target Level"] THEN Initiation succeeds automatically
            #ARM4B6uV7wX9yZ1aB3cD5eF: Varying a Script: Int + (House) Lore vs EF 9 (extend) or EF 12 (change component)
        }
    }

    # ===========================
    # REPUTATION CHANGES
    # ===========================

    #ARM4B7gH8iJ0kL2mN4oP6qR ^"Reputation Advancement" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Reputation gained with score 1 by doing something noteworthy in front of witnesses.
        # Each subsequent noteworthy action = 1 "experience point" toward Reputation.
        # Treated like an Ability for advancement.
        # To replace a bad Reputation: earn a new one (score 1), then direct noteworthy
        # actions toward it. When new Reputation exceeds old, general actions raise new one.
        # May choose to reduce old Reputation instead of raising new one.
        # Most characters should have no more than two Reputations.

        RULES {
            #ARM4B8sT9uV1wX3yZ5aB7cD: Each noteworthy action = 1 XP toward Reputation
            #ARM4B9eF0gH2iJ4kL6mN8oP: Reputation increases like an Ability using these XP
        }
    }

    # ===========================
    # TRAINING CREATURES
    # ===========================

    #ARM4BAqR1sT3uV5wX7yZ9aB ^"Training Creatures" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]

        # Any magical beast with Cunning may be tamed.
        # Seasonal activity; points accumulate between consecutive seasons.
        # Required points = Might of creature (minimum 1).
        # Mundane beasts: effective Might = 1 + 2 x Confidence Score.

        # Hermetic Tamer:
        # Points per season = Re(Fo) Lab Total - Creature's Might
        # Produces a Lab Text; may use Lab Text to tame same species.

        # Master of Creatures (Supernatural Virtue):
        # Points per season = Trainer's Might (or Magic Lore) + Animal Handling + Animal Ken - Creature's Might
        # Might doubled if same Form as creature.

        # Mundane Trainer:
        # Points per season = Int + Animal Handling + Animal Ken - Creature's Might

        # Tamed creatures gain Loyal +0 Personality Trait toward tamer.
        # Extra seasons improve Loyal (max +3) or transfer loyalty.
        # Commanding: Pre + Animal Handling + stress die vs EF (auto/6/9/12/15).

        MECHANICS {
            ^"Hermetic Taming Points" FORMULA [^"Re(Fo) Lab Total" - ^"Creature Might"]
            ^"Magical Trainer Points" FORMULA [^"Trainer Might or Magic Lore" + ^"Animal Handling" + ^"Animal Ken" - ^"Creature Might"]
            ^"Mundane Trainer Points" FORMULA [^"Intelligence" + ^"Animal Handling" + ^"Animal Ken" - ^"Creature Might"]
        }
    }
}
