EXTENSION "ARM5e_Spells_Auram" {
    NAME "Ars Magica 5th Edition Definitive - Auram Spells"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Magic"

    # Auram Form spells: affect air, weather, and gaseous phenomena.
    # Basic Individual: a weather phenomenon affecting an area about 100 paces across.
    # Organized by Technique, then by Level.

    # ===========================
    # CREO AURAM GUIDELINES
    # ===========================

    #ARMD00a1B2c3D4e5F6g7 ^"Creo Auram Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guidelines"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
        }
        RULES {
            #ARMD00: Weather phenomena are normally created at Sight range because most naturally begin in the upper air; creating them at ground level is unnatural but the level increase offsets the Range reduction to Touch
            #ARMD01: Sigils in Creo Auram spells commonly give the air specific properties such as special scents or colors
            #ARMD02: Creo Auram botches may create the wrong sort of weather, or create it targeted at the caster or an ally
            #ARMD03: Level 1 -- Create a minor weather phenomenon: a breeze, a mist, a light drizzle
            #ARMD04: Level 2 -- Create a normal weather phenomenon: a cloud, wind, fog, rain from a cloud that already exists
            #ARMD05: Level 3 -- Create a severe weather phenomenon: deafening thunder, monsoon rain, impenetrable fog, gale force wind; or create a debilitating kind of air: noxious stench, mild poison, etc.
            #ARMD06: Level 5 -- Create a very severe weather phenomenon: hurricane force winds, lightning strike, tornado
            #ARMD07: Level 25 -- Create an air elemental from a base amount of elemental material (Ritual)
            #ARMD08: Create a phenomenon in a slightly unnatural fashion: +1 magnitude (for example, indoors)
            #ARMD09: Create a phenomenon in a very unnatural fashion: +2 magnitudes
            #ARMD0A: Create a phenomenon wholly divorced from its normal context (for example, a lightning bolt springing from the caster's hands): +4 magnitudes
        }
    }

    # ===========================
    # CREO AURAM SPELLS
    # ===========================

    #ARMD0Bh8J9k0L1m2N3o4 ^"Air's Ghostly Form" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +1 Touch, +1 Diam, +1 unnatural (the spell can be cast indoors)"
        }
        RULES {
            #ARMD0C: A thick fog forms around the magus, extending outwards for several paces
            #ARMD0D: A breeze can push the fog around; it dissipates at its natural rate and may be too thin to restrict sight within a minute
        }
    }

    #ARMD0Ep5Q6r7S8t9U0v1 ^"Chamber of Spring Breezes" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +1 Touch, +2 Sun, +1 unnatural"
        }
        RULES {
            #ARMD0F: Creates a breeze of fresh air that continually moves throughout a room, keeping the air continuously breathable even if the room is airtight
            #ARMD10: The breeze can be created outdoors, but there it has little effect
        }
    }

    #ARMD11w2X3y4Z5a6B7c8 ^"Jupiter's Resounding Blow" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +1 unnatural (the spell functions indoors)"
        }
        RULES {
            #ARMD12: Creates a thunderclap; anyone directly underneath must make a Stamina stress roll against an Ease Factor of 9 or be deafened
            #ARMD13: If deafened, the target gets another Stamina simple roll each minute against the same Ease Factor and recovers on a success
            #ARMD14: If the first roll botches, the victim is rendered deaf for a month
        }
    }

    #ARMD15d9E0f1G2h3I4j5 ^"Stench of the Twenty Corpses" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +1 Diam"
        }
        RULES {
            #ARMD16: Creates a horrible stench of rotting corpses; all those within fifty paces of the target point must make Stamina stress rolls against an Ease Factor of 6 or act with a -3 penalty on all rolls
            #ARMD17: Anyone who botches the roll vomits and is incapacitated for (10 - Stamina) rounds
        }
    }

    #ARMD18k6L7m8N9o0P1q2 ^"Wreaths of Foul Smoke" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +1 Diam"
        }
        RULES {
            #ARMD19: Thick, yellow, sulfurous smoke rises up from the designated spot, spreading and thinning naturally, thick enough to block sight in a radius of about five paces around the point of origin
            #ARMD1A: For each round anyone breathes the smoke, a Stamina stress roll against an Ease Factor of 3 must be made or a Fatigue level is lost
            #ARMD1B: Once a character is Unconscious, further failed rolls result in the character taking a Light Wound each time
            #ARMD1C: The area where the spell is cast will be damaged: small plants wilt and die, and tree growth is stunted; a faint stench of sulfur clings for days to anything exposed to the smoke
        }
    }

    #ARMD1Dr3S4t5U6v7W8x9 ^"Broom of the Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +2 unnatural"
        }
        RULES {
            #ARMD1E: Whips up violent, swirling winds around the target; the target must make a Size stress roll against an Ease Factor of 9 to remain standing
            #ARMD1F: If the target is braced or holding onto some support, he may also make a Strength stress roll against an Ease Factor of 9
            #ARMD20: If both rolls fail, the target is knocked in a random direction and may be damaged depending on whether he strikes anything
        }
    }

    #ARMD21y0Z1a2B3c4D5e6 ^"Charge of the Angry Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +1 Conc, +1 unnatural"
        }
        RULES {
            #ARMD22: A wall of wind roars away from you, starting up to 10 paces away and continuing until it dissipates naturally; the wind is confined by existing barriers but if unconfined can be up to a hundred paces wide
            #ARMD23: All within the area must make a Dexterity + Size stress roll against an Ease Factor of 9 or fall down and be blown along by the winds; rolls must be made at the start of the gale and each subsequent round the wind is maintained
            #ARMD24: Missile fire into or out of the gale is futile, and marching against the gale requires a Strength + Size stress roll against an Ease Factor of 15
            #ARMD25: Failure in the marching attempt mandates another Dexterity + Size stress roll against an Ease Factor of 12 to keep from falling
        }
    }

    #ARMD26f7G8h9I0j1K2l3 ^"Circling Winds of Protection" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Rego"
            ^"Design" TEXT "Base 3, +1 Touch, +1 Conc, +2 unnatural, +1 Rego effect"
        }
        RULES {
            #ARMD27: Surrounds you with winds that circle at great speed; the wind picks up dust and other small, loose objects, so you may be obscured
            #ARMD28: Anyone standing near enough to attack you with a hand weapon must make a Size stress roll against an Ease Factor of 9 at the beginning of each round or be blown back
            #ARMD29: Melee Attack rolls against you are at -3, and missile or thrown attacks are at -9
        }
    }

    #ARMD2Am4N5o6P7q8R9s0 ^"Clouds of Rain and Thunder" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +3 Sight, +1 Conc, +2 Group"
        }
        RULES {
            #ARMD2B: Creates a small but severe rainstorm, including lightning and winds
            #ARMD2C: The storm gathers and breaks in a few seconds as the caster concentrates, and dissipates with similar speed when he stops doing so
            #ARMD2D: Reducing the Range for this spell makes the storm increasingly unnatural, so versions with lower Range still have the same level
        }
    }

    #ARMD2Et1U2v3W4x5Y6z7 ^"Clouds of Summer Snow" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +3 Sight, +1 Conc, +2 Group, +1 Size"
        }
        RULES {
            #ARMD2F: Creates clouds that drop snow over an area about half a mile across
            #ARMD30: The clouds gather over a few seconds at the beginning of the spell, and dissipate over the same sort of time when the caster stops concentrating
            #ARMD31: The spell does not affect temperature
        }
    }

    #ARMD32a8B9c0D1e2F3g4 ^"Pull of the Skybound Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +2 Voice, +1 Conc, +2 unnatural"
        }
        RULES {
            #ARMD33: Makes winds rise upward, pulling one object, creature, or person up to 50 feet into the sky before letting that target drop
            #ARMD34: Even a small building can be torn from its foundation, though such a building can be no larger than 20 feet to a side, and cannot be built out of a material heavier than stout wood
            #ARMD35: Uprooted objects fall randomly, unless you make a Finesse stress roll against an Ease Factor of 12 to choose where the objects will fall
        }
    }

    #ARMD36h5I6j7K8l9M0n1 ^"Wings of the Soaring Wind" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Rego"
            ^"Design" TEXT "Base 5, +1 Touch, +1 Conc, +2 highly unnatural, +1 Rego requisite"
        }
        RULES {
            #ARMD37: Generates a massive gust of air around you that supports and pushes you along through the air at speeds up to 40 miles per hour
            #ARMD38: Hovering in place is difficult and requires a Finesse roll against an Ease Factor of 9 per round
            #ARMD39: It is dangerous for extended travel, because if you lose concentration, you are likely to sustain serious injuries (+15 damage on average, although it may be more if the magus was very high up)
        }
    }

    #ARMD3Ao2P3q4R5s6T7u8 ^"The Incantation of Lightning" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +2 Voice, +4 unnatural"
        }
        RULES {
            #ARMD3B: A lightning bolt shoots forth from your outstretched hand in the direction you are pointing, doing +30 damage to a single target it hits
            #ARMD3C: There must be nothing between you and the target
            #ARMD3D: Those near the target must make Size stress rolls against an Ease Factor of 6 to remain standing
        }
    }

    #ARMD3Ev9W0x1Y2z3A4b5 ^"Breath of the Open Sky" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base 5, +1 Touch, +1 Conc, +4 size, +1 unnatural, ritual because of spectacular effect"
        }
        RULES {
            #ARMD3F: You can call up a wind capable of devastating the countryside; you must stand under the open sky to cast this spell
            #ARMD40: While you cast the spell, a breeze picks up, blowing from you in the direction you are facing; when the ritual is completed, the wind strengthens to a gale roaring over the visible countryside and beyond, strong enough to topple wooden structures and knock down trees
            #ARMD41: The wind does not weaken while it is within your sight, but loses its force naturally where you cannot see it
            #ARMD42: If you turn away from your original facing for more than a few seconds, you must make a Concentration roll against an Ease Factor of 12 to maintain the spell; if you turn away for a minute or more, the spell ends
        }
    }

    #ARMD43c6D7e8F9g0H1i2 ^"Wrath of Whirling Winds and Water" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 65
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN true
            ^"Design" TEXT "Base 5, +3 Sight, +2 Sun, +2 Group, +5 size"
        }
        RULES {
            #ARMD44: This spell creates an immense storm, 40 or more miles wide, of hurricane intensity
            #ARMD45: The storm builds up while you cast the ritual, and dissipates in a few seconds when the spell's duration ends
            #ARMD46: The gale-force winds and lashing waves cause immense damage along shorelines, and the winds, rain, and lightning cause extensive damage inland as well
            #ARMD47: Visibility is reduced to a few paces, missile fire is futile, and travel is nearly suicidal
            #ARMD48: Weak structures are blown over, and all but the most seaworthy ships are certain to founder unless they can be beached before the storm reaches full intensity
            #ARMD49: The storm is not under the caster's control, and moves normally
        }
    }

    # ===========================
    # INTELLEGO AURAM GUIDELINES
    # ===========================

    #ARMD4Aj3K4l5M6n7O8p9 ^"Intellego Auram Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guidelines"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
        }
        RULES {
            #ARMD4B: Intellego Auram botches normally reveal false information
            #ARMD4C: Level 1 -- Make your senses unhindered by the air (for example, you can hear over a howling wind)
            #ARMD4D: Level 2 -- Sense one property of air (for example, determine if it is safe to breathe)
            #ARMD4E: Level 4 -- Learn all mundane properties of the air; or have an intuition about some fact regarding the air
            #ARMD4F: Level 15 -- Speak with air
        }
    }

    # ===========================
    # INTELLEGO AURAM SPELLS
    # ===========================

    #ARMD50q0R1s2T3u4V5w6 ^"Sailor's Foretaste of the Morrow" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +1 Touch, +2 Group"
        }
        RULES {
            #ARMD51: You know precisely what tomorrow's weather will be, and you gain a general impression about the weather for the week ahead
            #ARMD52: This intuition only applies to the place where you cast the spell, and is based on extrapolating current conditions, so it is occasionally wrong (precise, but inaccurate)
            #ARMD53: It would take something like an interfering magical being, or a volcanic eruption, to throw the prediction off
        }
    }

    #ARMD54x7Y8z9A0b1C2d3 ^"True Sight of the Air" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Vision"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 1, +2 Sun, +4 Vision"
        }
        RULES {
            #ARMD55: Lets you see clearly through all manner of obfuscation in the air nearby, including smoke, fog, and dust, even if the obfuscation is magical
        }
    }

    #ARMD56e4F5g6H7i8J9k0 ^"Whispering Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Unique spell"
        }
        RULES {
            #ARMD57: The winds bear their tidings to your ears, allowing you to hear words spoken by any group of people within your line of sight, provided no solid barrier (including glass) intervenes
            #ARMD58: This spell is an adaptation of an effect known to Bjornaer the Founder, and fits poorly into the normal framework of Hermetic magic
        }
    }

    #ARMD59l1M2n3O4p5Q6r7 ^"Eyes of the Bat" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 25
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Hearing"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Sun, +3 Hearing"
        }
        RULES {
            #ARMD5A: You can move about confidently in complete darkness by sensing air and its boundaries (for example, where solid objects are)
            #ARMD5B: You 'hear' the boundaries of the air, so it does not permit fine discriminations; on the other hand, you can 'hear' boundaries behind you
        }
    }

    # ===========================
    # MUTO AURAM GUIDELINES
    # ===========================

    #ARMD5Cs8T9u0V1w2X3y4 ^"Muto Auram Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guidelines"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
        }
        RULES {
            #ARMD5D: Transforming only one property of air generally lowers the level by one magnitude
            #ARMD5E: Muto Auram botches could change the caster temporarily into air, or change the air in an undesirable way
            #ARMD5F: General -- Transform air into a gas doing +level damage
            #ARMD60: General -- Convert part of an air elemental's body into another type of air (wind to smoke, etc.), reducing the elemental's Might pool by the level of the spell +2 magnitudes; if the elemental is not destroyed, when the duration ends it can restore this Might by re-absorbing the matter
            #ARMD61: Level 3 -- Transform an amount of air into another form of air
            #ARMD62: Level 4 -- Transform an amount of air into another element (fire, earth, or water); or transform a gas into a harmful gas causing a Light Wound (Stamina roll against Ease Factor 6 to resist)
            #ARMD63: Level 5 -- Transform an amount of air into a mixture of elements; or transform an amount of air into something slightly unnatural; or transform a gas into a harmful gas causing a Medium Wound (Stamina roll against Ease Factor 6 to resist)
            #ARMD64: Level 10 -- Transform an amount of air into something wholly unnatural
        }
    }

    # ===========================
    # MUTO AURAM SPELLS
    # ===========================

    #ARMD65z5A6b7C8d9E0f1 ^"Rain of Stones" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Terram"
            ^"Design" TEXT "Base 4, +2 Voice, +2 Sun"
        }
        RULES {
            #ARMD66: Turns rain into stones as it falls, causing +0 damage every two rounds (they're small stones), and maybe less if the rain is very light
            #ARMD67: People under cover are not affected
            #ARMD68: The stones revert to water when the spell expires; if it stops raining before the spell ends, no more rain is transformed, even if a different rain storm starts
        }
    }

    #ARMD69g2H3i4J5k6L7m8 ^"Talons of the Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Diameter"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Requisite" TEXT "Rego"
            ^"Design" TEXT "Base 4, +2 Voice, +1 Diam, +1 Rego requisite (additional effect: protect the caster)"
        }
        RULES {
            #ARMD6A: Transforms a wind into an abrasive medium that tears and claws at everything in its path; soft materials like leaves and cloth are shredded, and people take +4 damage from innumerable bloody cuts and abrasions
            #ARMD6B: This spell cannot be cast if there is not a breeze of some sort blowing, thus making it difficult to use effectively indoors
            #ARMD6C: The caster is not affected by the spell, even if the wind is blowing directly at him
        }
    }

    #ARMD6Dn9O0p1Q2r3S4t5 ^"Infernal Smoke of Death" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 25, +2 Voice, +1 Conc"
        }
        RULES {
            #ARMD6E: Turns normal smoke from a fire into a thick, corrosive cloud; anyone immersed in the cloud of smoke takes +25 corrosion damage, against which armor provides only half its normal Protection value
            #ARMD6F: Soft materials like cloth, fur, paper, and leather are charred and ruined by exposure to the noxious vapor
            #ARMD70: While you concentrate, any new smoke becomes corrosive; the smoke is heavier than air, so rolls along the ground, pooling in low spots
            #ARMD71: The damage represents normal exposure to the vapor, and may be modified if characters spend unusually short or long times within it
        }
    }

    #ARMD72u6V7w8X9y0Z1a2 ^"Fog of Confusion" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 45
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Year"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Requisite" TEXT "Imaginem, Rego"
            ^"Design" TEXT "Base 2, +1 Touch, +4 Year, +4 Size, +1 Imaginem requisite, +1 Rego requisite"
        }
        RULES {
            #ARMD73: Turns a bank of fog up to six miles across into a silvery mist too thick to see through
            #ARMD74: Random screams, thumps, hisses, and other noises harass and confuse anyone within the fog, perhaps even leading them into danger
            #ARMD75: People have extreme difficulty navigating through the fog, especially through unknown territory
            #ARMD76: No more than seven people, who must be present at the ritual, can see normally through the fog
            #ARMD77: The fog does not dissipate until the spell expires
        }
    }

    #ARMD78b3C4d5E6f7G8h9 ^"Rain of Oil" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 50
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Requisite" TEXT "Aquam"
            ^"Design" TEXT "Base 4, +3 Sight, +2 Sun, +5 size"
        }
        RULES {
            #ARMD79: Turns rain into droplets of oil; the rain of oil continues as long as the storm does within the spell's duration, drenching the landscape with flammable liquid
            #ARMD7A: The oil will evaporate at a natural rate after the rain ceases
            #ARMD7B: A Creo Ignem spell can ignite the storm so that the oil burns as it falls, but this requires a Group target large enough to catch all the raindrops
            #ARMD7C: Lighting the oil after it has landed is much easier
        }
    }

    # ===========================
    # PERDO AURAM GUIDELINES
    # ===========================

    #ARMD7Di0J1k2L3m4N5o6 ^"Perdo Auram Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guidelines"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
        }
        RULES {
            #ARMD7E: Causing the destruction of air with great precision raises the magnitude by at least one level
            #ARMD7F: General -- Destroy sufficient matter to reduce an air elemental's Might Score by the level of the spell +2 magnitudes
            #ARMD80: Level 3 -- Make air stuffy and poor for breathing
            #ARMD81: Level 4 -- Destroy still air; or destroy a minor weather phenomenon: a breeze, a mist, a light drizzle; or reduce the intensity of a weather phenomenon by one step (for example, from very severe to severe, or from normal to minor)
            #ARMD82: Level 5 -- Destroy a normal weather phenomenon: a cloud, wind, fog, rain from a cloud that already exists
            #ARMD83: Level 10 -- Destroy a severe weather phenomenon: deafening thunder, monsoon rain, impenetrable fog, gale force wind; or destroy a debilitating kind of air: noxious stench, mild poison, etc.
            #ARMD84: Level 15 -- Destroy a very severe weather phenomenon: hurricane force winds, lightning strike, tornado
        }
    }

    # ===========================
    # PERDO AURAM SPELLS
    # ===========================

    #ARMD85p7Q8r9S0t1U2v3 ^"Room of Stale Air" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 15
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Room"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 3, +2 Voice, +2 Room"
        }
        RULES {
            #ARMD86: Makes the air in a room stuffy and uncomfortable; any creatures that breathe air suffer a -3 penalty on all rolls involving physical exertion
            #ARMD87: For each round of exertion a character must make a simple Stamina roll against an Ease Factor of 6 or lose a Fatigue level
            #ARMD88: This may cause panic in some creatures or people; the speed at which the air refreshes itself depends on how well ventilated the room is
        }
    }

    #ARMD89w4X5y6Z7a8B9c0 ^"Quiet the Raging Winds" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 20
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 5, +1 Touch, +2 Group"
        }
        RULES {
            #ARMD8A: Stops all wind from blowing, leaving only calm air
            #ARMD8B: This spell is not powerful enough to affect winds caused by Ritual magic, and only affects winds blowing on the caster when it is cast
            #ARMD8C: Under normal circumstances, the winds will not pick up again for at least an hour or so
        }
    }

    #ARMD8Dd1E2f3G4h5I6j7 ^"The Cloudless Sky Returned" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 45
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 10, +3 Sight, +2 Group, +2 size"
        }
        RULES {
            #ARMD8E: This spell clears the sky within your vision of any clouds or other meteorological activity short of a hurricane or tornado, either naturally occurring or caused by magic
            #ARMD8F: The clouds take a few seconds to clear, during which time you must concentrate on them
            #ARMD90: This spell only affects meteorological activity in progress at the moment of casting, and is not powerful enough to dispel a weather condition caused by Ritual magic
        }
    }

    # ===========================
    # REGO AURAM GUIDELINES
    # ===========================

    #ARMD91k8L9m0N1o2P3q4 ^"Rego Auram Guidelines" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Guidelines"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
        }
        RULES {
            #ARMD92: Rego Auram allows the maga to control existing weather phenomena; it is not possible to create a breeze with Rego Auram, but it is possible to direct the course of a storm, including starting and stopping the rain at the maga's command
            #ARMD93: Controlling an amount of air with great strength or great precision raises the magnitude of the spell by one level
            #ARMD94: General -- Ward against beings associated with Auram from one supernatural realm (Divine, Faerie, Infernal, or Magic) with Might less than or equal to the level of the spell (Touch, Ring, Circle)
            #ARMD95: Level 2 -- Control a minor weather phenomenon
            #ARMD96: Level 3 -- Control a normal weather phenomenon; or ward someone against a type of minor weather phenomenon
            #ARMD97: Level 4 -- Control a severe weather phenomenon; or ward someone against a type of normal weather phenomenon
            #ARMD98: Level 5 -- Control a very severe weather phenomenon; or control a disembodied spirit associated with Auram; or completely control an air elemental; or ward someone against a type of severe weather phenomenon
            #ARMD99: Level 10 -- Ward someone against a type of very severe weather phenomenon
            #ARMD9A: Level 15 -- Summon a disembodied spirit associated with Auram
        }
    }

    # ===========================
    # REGO AURAM SPELLS
    # ===========================

    #ARMD9Br5S6t7U8v9W0x1 ^"Ward Against Faeries of the Air" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" TEXT "General"
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Ring"]
            ^"Target" ENUM ["Circle"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base effect"
        }
        RULES {
            #ARMD9C: As Ward Against Faeries of the Water (ReAq Gen), but for faeries of the air
            #ARMD9D: The faerie cannot directly or indirectly break the magic circle, nor can they use ranged attacks or magic to affect those within it
            #ARMD9E: From some angles at night, the ring may be seen as a violet-hued dome
        }
    }

    #ARMD9Fy2Z3a4B5c6D7e8 ^"Wind at the Back" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Special"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 2, +1 Touch, +2 Special (based on Concentration)"
        }
        RULES {
            #ARMD9G: An existing breeze follows you until you stop traveling for more than ten minutes
            #ARMD9H: It causes phenomena you pass through (fog, haze) to follow you
        }
    }

    #ARMD9If9G0h1I2j3K4l5 ^"Ward Against Rain" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +2 Sun"
        }
        RULES {
            #ARMD9J: No rain falls on the caster, no matter how bad the weather
        }
    }

    #ARMD9Km6N7o8P9q0R1s2 ^"Clouds of Thunderous Might" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +3 Sight, +1 Conc, +2 Group"
        }
        RULES {
            #ARMD9L: Gathers pre-existing clouds and winds into a small storm; the storm gathers at a normal speed, but is under the caster's control as long as he can see it
            #ARMD9M: The caster may use the control granted by this spell to dissipate small storms as well
            #ARMD9N: If the caster does not dissipate the storm before stopping concentrating, the storm continues as normal
        }
    }

    #ARMD9Ot3U4v5W6x7Y8z9 ^"Gathering of the Stormy Might" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Type" ENUM ["Spell"]
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 40
            ^"Range" ENUM ["Sight"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN false
            ^"Design" TEXT "Base 4, +3 Sight, +1 Conc, +2 Group, +2 size"
        }
        RULES {
            #ARMD9P: As for Clouds of Thunderous Might, but the storm is larger, possibly covering the entire visible sky
            #ARMD9Q: The storm is under the caster's control
        }
    }
}
