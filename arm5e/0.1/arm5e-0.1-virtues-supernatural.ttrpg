EXTENSION "ARM5e_Virtues_Supernatural" {
    NAME "Ars Magica 5th Edition Definitive - Supernatural Virtues"
    VERSION "0.1"
    RELEASE_DATE "2025-06-01"
    DEPENDS_ON "ARM5e_Core_Character"

    # Supernatural Virtues: grant access to supernatural abilities or powers.
    # May be taken by any character type unless noted.
    # Supernatural Virtues cannot normally be lost when trained as a magus
    # (if master cannot preserve the ability, apprentice cannot be trained).

    # ===========================
    # MAJOR SUPERNATURAL VIRTUES
    # ===========================

    #ARM586wX6yZ8aB0cD2eF4gH ^"Blood of the Nephilim" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM587iJ7kL9mN1oP3qR5sT: Size increased to +1 (increases by +1 per century alive)
            #ARM588uV8wX0yZ2aB4cD6eF: Aging roll only once per 10 years after age 150; -5 to Aging rolls
            #ARM589gH9iJ1kL3mN5oP7qR: Must eat 3x normal; falls into hibernation without food for 1 day
            #ARM58AsT0uV2wX4yZ6aB8cD: Cannot take The Gift, True Faith, Hermetic V&F, Giant, Mythic Blood, or Faerie Blood
        }
    }

    #ARM58BeF1gH3iJ5kL7mN9oP ^"Corpse Magic" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM58CqR2sT4uV6wX8yZ0aB: Confers Supernatural Ability Corpse Magic at score 1
        }
    }

    #ARM58DcD3eF5gH7iJ9kL1mN ^"Curse-Throwing" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM58EoP4qR6sT8uV0wX2yZ: Confers Supernatural Ability Curse-Throwing at score 1
            #ARM58FaB5cD7eF9gH1iJ3kL: Can cure diseases and remove curses by transferring them to another person
        }
    }

    #ARM590mN6oP8qR0sT2uV4wX ^"Embitterment" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM591yZ7aB9cD1eF3gH5iJ: Confers Supernatural Ability Embitterment at score 1
            #ARM592kL8mN0oP2qR4sT6uV: Can make someone hostile to a target of your choice
        }
    }

    #ARM593wX9yZ1aB3cD5eF7gH ^"Entrancement" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM594iJ0kL2mN4oP6qR8sT: Confers Supernatural Ability Entrancement at score 1
            #ARM595uV1wX3yZ5aB7cD9eF: Control another's will by eye contact and verbal command
        }
    }

    #ARM596gH2iJ4kL6mN8oP0qR ^"Greater Immunity" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM597sT3uV5wX7yZ9aB1cD: Completely immune to one hazard (e.g., fire, iron weapons, disease)
            #ARM598eF4gH6iJ8kL0mN2oP: The immunity must be broad and significant
        }
    }

    #ARM599qR5sT7uV9wX1yZ3aB ^"Greater Power" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion", ^"Creature"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM59AcD6eF8gH0iJ2kL4mN: Grants a pool of 50 levels to build supernatural powers (using Hermetic spell guidelines)
            #ARM59BoP7qR9sT1uV3wX5yZ: Level cost and Penetration are purchased from the pool
        }
    }

    #ARM59CaB8cD0eF2gH4iJ6kL ^"Greater Purifying Touch" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM59DmN9oP1qR3sT5uV7wX: Can cure a serious disease or affliction through physical touch
        }
    }

    #ARM59EyZ0aB2cD4eF6gH8iJ ^"Strong Faerie Blood" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM59FkL1mN3oP5qR7sT9uV: Stronger faerie blood grants more pronounced abilities from faerie ancestor type
            #ARM5A0wX2yZ4aB6cD8eF0gH: -1 to all aging rolls; learn Faerie Lore at character generation
            #ARM5A1iJ3kL5mN7oP9qR1sT: Second Sight at score 1 (free)
        }
    }

    #ARM5A2uV4wX6yZ8aB0cD2eF ^"Focus Power" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion", ^"Creature"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5A3gH5iJ7kL9mN1oP3qR: Grants a 25-point pool for a narrow supernatural power (smaller than a single Form)
            #ARM5A4sT6uV8wX0yZ2aB4cD: Pool buys max level (2 pts per level) and Penetration (1 pt per point)
            #ARM5A5eF7gH9iJ1kL3mN5oP: Costs 1 Fatigue level per use (2 for level 26-50, 3 for level 51-75)
        }
    }

    #ARM5A6qR8sT0uV2wX4yZ6aB ^"Ritual Power" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion", ^"Creature"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5A7cD9eF1gH3iJ5kL7mN: Grants a powerful supernatural ability that requires extended ritual to activate
        }
    }

    #ARM5A8oP0qR2sT4uV6wX8yZ ^"Bee King" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5A9aB1cD3eF5gH7iJ9kL: Can command bees; never stung by biting insects
            #ARM5AAmN2oP4qR6sT8uV0wX: Does not appear to age after maturity but dies at exactly 100 years
            #ARM5AByZ3aB5cD7eF9gH1iJ: Can communicate complex messages through bees; Penetration 50
        }
    }

    # ===========================
    # MINOR SUPERNATURAL VIRTUES
    # ===========================

    #ARM5ACkL4mN6oP8qR0sT2uV ^"Animal Ken" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5ADwX5yZ7aB9cD1eF3gH: Confers Supernatural Ability Animal Ken at score 1
            #ARM5AEiJ6kL8mN0oP2qR4sT: Can communicate with animals as if they were humans
        }
    }

    #ARM5AFuV7wX9yZ1aB3cD5eF ^"Dowsing" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5B0gH8iJ0kL2mN4oP6qR: Confers Supernatural Ability Dowsing at score 1
            #ARM5B1sT9uV1wX3yZ5aB7cD: Can find things nearby using a dowsing rod and intuitive sense
        }
    }

    #ARM5B2eF0gH2iJ4kL6mN8oP ^"Enchanting (Ability)" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5B3qR1sT3uV5wX7yZ9aB: Confers Supernatural Ability Enchanting (Ability) at score 1
            #ARM5B4cD2eF4gH6iJ8kL0mN: Can magically induce emotions and beliefs through artistic expression
        }
    }

    #ARM5B5oP3qR5sT7uV9wX1yZ ^"Eye of Hephaestus" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5B6aB4cD6eF8gH0iJ2kL: Can tell quality of manufactured items by touch; aware of flaws instantly
            #ARM5B7mN5oP7qR9sT1uV3wX: Supernatural items: Per + Awareness + stress die vs EF 9; Hermetic items: vs EF 12
        }
    }

    #ARM5B8yZ6aB8cD0eF2gH4iJ ^"Faerie Blood" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5B9kL7mN9oP1qR3sT5uV: -1 to all aging rolls; can learn Faerie Lore at character generation
            #ARM5BAwX8yZ0aB2cD4eF6gH: Pick one type of faerie blood: Dwarf (+1 Craft), Goblin (+1 stealth), Satyr (+1 Com/Pre with sexually compatible), Sidhe (+1 Pre, max +3), Undine (+2 underwater), Spinnen (convert fiber to cloth), Bee King (simple bee commands)
        }
    }

    #ARM5BBiJ9kL1mN3oP5qR7sT ^"Font of Knowledge" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5BCuV0wX2yZ4aB6cD8eF: Confers Supernatural Ability Font of Knowledge at score 1
            #ARM5BDgH1iJ3kL5mN7oP9qR: Supernatural access to information never learned
        }
    }

    #ARM5BEsT2uV4wX6yZ8aB0cD ^"Frightful Presence" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5BFeF3gH5iJ7kL9mN1oP: Can instill dread; all witnesses must roll Brave vs EF 3 + ABS(Presence)
            #ARM5C0qR4sT6uV8wX0yZ2aB: Failure: attempt to flee or are cowed; re-attempt every 2 minutes
            #ARM5C1cD5eF7gH9iJ1kL3mN: Once recovered, cannot be affected again; Penetration 0
        }
    }

    #ARM5C2oP6qR8sT0uV2wX4yZ ^"Gender Shift" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5C3aB7cD9eF1gH3iJ5kL: May change gender at midnight; forms are consistent and appear as blood kin
        }
    }

    #ARM5C4mN8oP0qR2sT4uV6wX ^"Crafter's Healing" DEF {
        APPLIES TO [^"Companion", ^"Grog", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5C5yZ9aB1cD3eF5gH7iJ: Confers Crafter's Healing Ability at score 1
            #ARM5C6kL0mN2oP4qR6sT8uV: Can magically heal wounds by touching them with trade tools
        }
    }

    #ARM5C7wX1yZ3aB5cD7eF9gH ^"Folk Magic" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5C8iJ2kL4mN6oP8qR0sT: Minor supernatural acts through knowledge of occult lore
            #ARM5C9uV3wX5yZ7aB9cD1eF: Choose one (Realm) Lore as key Ability; choose one of: Abjuration, Divination, Healing, or Evil Eye
            #ARM5CAgH4iJ6kL8mN0oP2qR: Casting Total = (Sta + (Realm) Lore + Aura + stress die) / 2; requires 15 min preparation and 1 Fatigue
        }
    }

    #ARM5CBsT5uV7wX9yZ1aB3cD ^"Lesser Immunity" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5CCeF6gH8iJ0kL2mN4oP: Immune to one narrow hazard (e.g., snakebite, drowning in freshwater)
        }
    }

    #ARM5CDoP7qR9sT1uV3wX5yZ ^"Lesser Power" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion", ^"Creature"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5CEaB8cD0eF2gH4iJ6kL: Grants a supernatural power with a 25-point pool (like Focus Power but less specialized)
        }
    }

    #ARM5CFmN9oP1qR3sT5uV7wX ^"Lesser Purifying Touch" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5D0yZ0aB2cD4eF6gH8iJ: Can cure a minor disease or affliction through physical touch
        }
    }

    #ARM5D1kL1mN3oP5qR7sT9uV ^"Master of (Form) Creatures" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5D2wX2yZ4aB6cD8eF0gH: Can tame creatures of one Form that have Cunning; uses special taming rules
        }
    }

    #ARM5D3iJ3kL5mN7oP9qR1sT ^"Premonitions" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5D4uV4wX6yZ8aB0cD2eF: Confers Supernatural Ability Premonitions at score 1
            #ARM5D5gH5iJ7kL9mN1oP3qR: Can sense impending danger or important events
        }
    }

    #ARM5D6sT6uV8wX0yZ2aB4cD ^"Second Sight" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Grog", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5D7eF7gH9iJ1kL3mN5oP: Confers Supernatural Ability Second Sight at score 1
            #ARM5D8qR8sT0uV2wX4yZ6aB: Can see through illusions, see invisible things, and perceive supernatural beings
        }
    }

    #ARM5D9cD9eF1gH3iJ5kL7mN ^"Familiarity with the Fae" DEF {
        APPLIES TO [^"Magus", ^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5DAoP0qR2sT4uV6wX8yZ: +2 to all rolls involving social interaction with faeries
            #ARM5DBaB1cD3eF5gH7iJ9kL: Gains Common Sense effect when situation pertains to faeries
            #ARM5DCmN2oP4qR6sT8uV0wX: May purchase Faerie Lore at character generation
        }
    }

    # ===========================
    # FREE SUPERNATURAL VIRTUES
    # ===========================

    #ARM5DDyZ3aB5cD7eF9gH1iJ ^"Commanding Aura" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Free"]
            ^"Category" ENUM ["Supernatural"]
        }
        RULES {
            #ARM5DEkL4mN6oP8qR0sT2uV: Granted by pope or the Divine; equivalent to Aura of Rightful Authority at Voice range
            #ARM5DFwX5yZ7aB9cD1eF3gH: Magic Resistance and Soak bonus depend on Church rank (Pope: MR 25/Soak +5 down to Archbishop: MR 10/Soak +2)
        }
    }

    # ===========================
    # TAINTED SUPERNATURAL VIRTUES
    # ===========================

    #ARM5E0iJ6kL8mN0oP2qR4sT ^"Amorphous" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]      # Can be Major or Minor
            ^"Category" ENUM ["Supernatural"]
            ^"Tainted" BOOLEAN true
        }
        RULES {
            #ARM5E1uV7wX9yZ1aB3cD5eF: Can take on any human form (not a specific person)
            #ARM5E2gH8iJ0kL2mN4oP6qR: Major: select shape at midnight; Minor: change only after performing act linked to sponsor demon's Obsession
        }
    }

    #ARM5E3sT9uV1wX3yZ5aB7cD ^"Command Animals" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
            ^"Tainted" BOOLEAN true
        }
        RULES {
            #ARM5E4eF0gH2iJ4kL6mN8oP: Mentally command up to 12 human-sized mundane animals (or more smaller ones) of species associated with sponsoring demon
        }
    }

    #ARM5E5qR1sT3uV5wX7yZ9aB ^"Demonic Blood" DEF {
        APPLIES TO [^"Companion", ^"Mythic Companion"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Major"]
            ^"Category" ENUM ["Supernatural"]
            ^"Tainted" BOOLEAN true
        }
        RULES {
            #ARM5E6cD2eF4gH6iJ8kL0mN: Infernal Might (Corpus) 5; immune to Warping; cannot reproduce
            #ARM5E7oP3qR5sT7uV9wX1yZ: Up to 30 levels of Infernal Powers
            #ARM5E8aB4cD6eF8gH0iJ2kL: Ages at double rate (effective age increases 2 per year); attended by a minor demon
        }
    }
}
