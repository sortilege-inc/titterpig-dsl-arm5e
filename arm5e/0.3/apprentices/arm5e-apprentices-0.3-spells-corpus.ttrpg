EXTENSION "ARM5e_App_Spells_Corpus" {
    NAME "Apprentices - Corpus Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP012aB2cD4eF6gH8iJ ^"The Cleric's Pate" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Part"]
            ^"Design" STRING "Base 3, +1 Touch, +1 Part"
        }
        DESCRIPTION "This spell causes the target to lose all the hair on his head."
    }

    #ARM5SP013aB2cD4eF6gH8iJ ^"Curse of the Baby's Bladder" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Part"]
            ^"Design" STRING "Base 2, + 2 Voice, +1 Part"
        }
        DESCRIPTION "By manipulating the target's stomach and groin muscles, this spell causes the target to release his water, resulting in a (usually) embarrassing situation. This spell does not target or create urine, so if the target has recently urinated, the spell has no effect. This cantation is unfortunately popular with many apprentices."
    }

    #ARM5SP014aB2cD4eF6gH8iJ ^"Ears of the Hare" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Muto"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 2, +2 Sun, requisite free"
        }
        DESCRIPTION """Requisites: Animal

This spell gives the caster the auditory ability of a hare, granting her +1 on Perception rolls that involve hearing."""
    }

    #ARM5SP015aB2cD4eF6gH8iJ ^"Physician's Sense" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Intellego"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Personal"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4"
        }
        DESCRIPTION """Like The Physician's Eye, this spell determines the general health of

Apprentices

the caster. It is useful in discovering if a common cold or recurring ache is actually something more severe."""
    }

}
