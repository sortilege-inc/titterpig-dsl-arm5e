EXTENSION "ARM5e_App_Spells_Herbam" {
    NAME "Apprentices - Herbam Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP016aB2cD4eF6gH8iJ ^"The Apprentice's Delight" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Herbam"]
            ^"Level" INTEGER 3
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Dia"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, + 1 Touch, + 1 Diameter"
        }
        DESCRIPTION "This spell creates a ripe apple that lasts for two minutes, long enough to be gobbled down. The apple provides no nourishment; its pleasure is in the sweetness of eating it."
    }

    #ARM5SP017aB2cD4eF6gH8iJ ^"The Dancer's Dame" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Herbam"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Concentration"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, + 1 Touch, + 1 Conc"
        }
        DESCRIPTION "This spell animates a linen gown or dress to dance with the caster, who must maintain concentration while dancing (Ease Factor 9)."
    }

}
