EXTENSION "ARM5e_App_Spells_Terram" {
    NAME "Apprentices - Terram Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP025aB2cD4eF6gH8iJ ^"The Poor Performer's Reward" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Terram"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Touch, +2 Sun"
        }
        DESCRIPTION "This spell creates a handful of mud, useful for hurling at a target. Since this mud is magically created, it is resisted by Magic Resistance."
    }

    #ARM5SP026aB2cD4eF6gH8iJ ^"The Reward Delivered" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Terram"]
            ^"Level" INTEGER 4
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, +1 Touch"
        }
        DESCRIPTION "This spell is a counterpart to The Poor Performer's Reward. It hurls the ball of mud at a target."
    }

    #ARM5SP027aB2cD4eF6gH8iJ ^"Shattering Touch" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Perdo"]
            ^"Form" ENUM ["Terram"]
            ^"Level" INTEGER 5
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 4, +1 Touch"
        }
        DESCRIPTION "An object of stone or weaker earthy material up to a pace across breaks apart."
    }

}
