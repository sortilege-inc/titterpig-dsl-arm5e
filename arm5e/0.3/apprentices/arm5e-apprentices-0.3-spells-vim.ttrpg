EXTENSION "ARM5e_App_Spells_Vim" {
    NAME "Apprentices - Vim Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Apprentices

    #ARM5SP028aB2cD4eF6gH8iJ ^"Req: Animal" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 3, + 1 Touch, +1 Requisite"
        }
        DESCRIPTION "This spell spoils a plate of food."
    }

}
