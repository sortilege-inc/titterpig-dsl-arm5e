EXTENSION "ARM5e_Cov_Spells_Auram" {
    NAME "Covenants - Auram Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Covenants

    #ARM5SP016aB2cD4eF6gH8iJ ^"Chamber of Summer Breezes" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Auram"]
            ^"Level" INTEGER 10
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 1, +1 Touch, +2 Sun, +1 unnatural, +1 requisite"
        }
        DESCRIPTION """Req: Ignem

This spell creates a breeze of fresh, dry, warm air that continually moves throughout a room , keeping the air unpolluted and the humidity and temperature constant. This spell is often cast on armarii and book chests."""
    }

}
