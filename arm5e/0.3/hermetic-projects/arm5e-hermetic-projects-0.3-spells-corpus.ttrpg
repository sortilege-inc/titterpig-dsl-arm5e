    #ARM5SP034aB2cD4eF6gH8iJ ^"Conjure the Walking Dead" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 50
            ^"Range" ENUM ["Touch"]
