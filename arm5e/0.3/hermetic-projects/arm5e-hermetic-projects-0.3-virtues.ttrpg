EXTENSION "ARM5e_HP_Virtues" {
    NAME "Hermetic Projects - Virtues"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Character"
    # Source: Hermetic Projects

    #ARM5VS001aB2cD4eF6gH8iJ ^"Volcanic Spirit Forge" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Type" ENUM ["Virtue"]
            ^"Size" ENUM ["Minor"]
            ^"Category" ENUM ["Supernatural"]
        }
        DESCRIPTION "The laboratory contains a forge that is heated by a volcanic spirit. -1 Upkeep, -1 Safety, +1 Experimentation, +1 Re, +1 Ig."
    }

}
