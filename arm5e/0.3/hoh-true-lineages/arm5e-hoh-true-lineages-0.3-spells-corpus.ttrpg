EXTENSION "ARM5e_HoH_TL_Spells_Corpus" {
    NAME "Houses of Hermes: True Lineages - Corpus Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Houses of Hermes: True Lineages

    #ARM5SP005aB2cD4eF6gH8iJ ^"(Physical Characteristic) of the Heroes" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Corpus"]
            ^"Level" INTEGER 60
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Individual"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 55, +1 Touch"
        }
        DESCRIPTION "Each of the four variations of this ritual permanently increases one of the subject's physical Characteristics (Strength, Stamina, Dexterity or Quickness) by one, to no more than +5. During the ceremony, the subject is buried under earth, emerging from the ordeal permanently improved and one step closer to human perfection."
    }

}
