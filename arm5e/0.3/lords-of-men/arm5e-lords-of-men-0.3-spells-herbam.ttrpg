EXTENSION "ARM5e_LoM_Spells_Herbam" {
    NAME "Lords of Men - Herbam Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Lords of Men

    #ARM5SP001aB2cD4eF6gH8iJ ^"Conjuration of Bread" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo"]
            ^"Form" ENUM ["Herbam"]
            ^"Level" INTEGER 35
            ^"Range" ENUM ["Touch"]
            ^"Duration" ENUM ["Momentary"]
            ^"Target" ENUM ["Group"]
            ^"Ritual" BOOLEAN true
            ^"Design" STRING "Base 3, +1 Touch, +2 Group, +5 size"
        }
        DESCRIPTION "This ritual creates enough bread to support a moderately sized covenant for a season. The bread is a long-lived ciabatta which lasts if stored well. The ritual is enough to provide a +7 bonus to all Supply rolls made by a besieged castle in that season."
    }

}
