EXTENSION "ARM5e_LoM_Spells_Mentem" {
    NAME "Lords of Men - Mentem Spells"
    VERSION "0.3"
    RELEASE_DATE "2026-03-05"
    DEPENDS_ON "ARM5e_Core_Magic"
    # Source: Lords of Men

    #ARM5SP003aB2cD4eF6gH8iJ ^"Raise the Siege" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Mentem"]
            ^"Level" INTEGER 30
            ^"Range" ENUM ["Arcane Connection"]
            ^"Duration" ENUM ["Sun"]
            ^"Target" ENUM ["Individual"]
            ^"Design" STRING "Base 5, +4 Arc, +1 Sun"
        }
        DESCRIPTION "Given an arcane connection to the besieging commander, this spell suggests a pessimistic view of any siege assessment. The effect is not sudden, but rather, is reinforced through the day as the commander reviews the siege. On an Intelligence + Leadership simple roll against Ease Factor 12 the commander resists the suggestions made by the spell."
    }

}
