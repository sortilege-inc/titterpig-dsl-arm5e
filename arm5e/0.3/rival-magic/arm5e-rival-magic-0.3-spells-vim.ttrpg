            ^"Design" STRING "Base 5, + 2 for additional bonuses"
        }
        DESCRIPTION """This incantation cancels the penalties incurred from suffering a disease that acts as a Medium Wound. It does not combat the disease itself, providing the target temporary relief only.

Recalling her Ancestors"""
    }

    #ARM5SP014aB2cD4eF6gH8iJ ^"Level 15" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
