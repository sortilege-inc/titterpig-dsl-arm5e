    #ARM5SP024aB2cD4eF6gH8iJ ^"*Perceive the Afflictions of Mortal Flesh*, 0 points, Init +1, Corpus" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
