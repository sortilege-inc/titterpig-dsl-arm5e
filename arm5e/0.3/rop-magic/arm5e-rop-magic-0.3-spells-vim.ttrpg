InCo(An) 25 (Base 3, +4 Arc, +1 Conc, +1 special effect: scent serves as Arcane Connection): Greater Power x2 (25 levels,"""
    }

    #ARM5SP023aB2cD4eF6gH8iJ ^"–2 Might cost, +65 xp in Penetration) *Dominate Canine*, 1 point, Init –3, Animal" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Technique" ENUM ["Rego"]
            ^"Form" ENUM ["Vim"]
            ^"Level" INTEGER 0
            ^"Range" ENUM ["Voice"]
            ^"Duration" ENUM ["Sun"]
