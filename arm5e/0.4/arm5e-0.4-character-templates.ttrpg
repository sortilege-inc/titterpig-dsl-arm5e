            }
            CHOICES {
                "The Tough Guy works well as a defender for a magus, because he can take a lot of punishment before dropping and making the magus vulnerable. The Virtues depend on the concept, but the Flaws can be changed freely, and his Ability scores can be swapped freely between the Abilities he has."
            }
        }

    #tQ04DUJb77KmkXu5oJe3wO0P TEMPLATE "Bjornaer" DEF {
            EXTENDS ^"Magus"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 3
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER -1
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 1
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 25
                ^"Apparent Age" INTEGER 25
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Hermetic Arts" DEF {
                    ^"Creo" INTEGER 0
                    ^"Intellego" INTEGER 1
                    ^"Muto" INTEGER 10
                    ^"Perdo" INTEGER 3
                    ^"Rego" INTEGER 1
                    ^"Animal" INTEGER 8
                    ^"Aquam" INTEGER 0
                    ^"Auram" INTEGER 0
                    ^"Corpus" INTEGER 8
                    ^"Herbam" INTEGER 0
                    ^"Ignem" INTEGER 0
                    ^"Imaginem" INTEGER 0
                    ^"Mentem" INTEGER 0
                    ^"Terram" INTEGER 0
                    ^"Vim" INTEGER 0
                }
                ^"Soak" INTEGER 1
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Twilight Scars" STRING "None"
                ^"Equipment" LIST ["Wizardly robes."]
                ^"Encumbrance" STRING "0 (0)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"The Gift"
                ^"Hermetic Magus"
                ^"Ways of the (Land)" OF "Forest"
                ^"Heartbeast" FREE
                ^"Inoffensive to Animals"
                ^"Quiet Magic" TIMES 2
                ^"Subtle Magic"
            }
            FLAWS {
                ^"Blatant Gift"
                ^"Tormenting Master"
                ^"Deficient Form" OF "Ignem"
            }
            PERSONALITY_TRAITS {
                "Brave" +2
                "Status-seeking" +2
                "Obedient" +1
            }
            COMBAT {
                "Dodging" INIT 1 DEFENSE 4
            }
            ABILITIES {
                "Artes Liberales" SCORE 1 SPECIALTY "grammar"
                "Athletics" SCORE 2 SPECIALTY "endurance"
                "Awareness" SCORE 2 SPECIALTY "people"
                "Brawl" SCORE 2 SPECIALTY "dodge"
                "Finesse" SCORE 1 SPECIALTY "targeting"
                "Folk Ken" SCORE 1 SPECIALTY "hunters"
                "Guile" SCORE 1 SPECIALTY "pretending to know less than you do"
                "Heartbeast" SCORE 2 SPECIALTY "changing into a wolf"
                "Hunt" SCORE 2 SPECIALTY "small animals"
                "Latin" SCORE 4 SPECIALTY "Hermetic terms"
                "Living Language" SCORE 5 SPECIALTY "talking about the wilderness"
                "Local Area Lore" SCORE 1 SPECIALTY "forests"
                "Magic Theory" SCORE 3 SPECIALTY "Animal"
                "Parma Magica" SCORE 1 SPECIALTY "Animal"
                "Penetration" SCORE 1 SPECIALTY "Muto"
                "Order of Hermes Lore" SCORE 1 SPECIALTY "Bjornaer"
                "Second Area Lore" SCORE 1 SPECIALTY "forests"
                "Survival" SCORE 3 SPECIALTY "forests"
            }
            SPELLS_KNOWN {
                ^"Transformation of the Ravenous Beast to the Torpid Toad" TECHNIQUE "Muto" FORM "Animal" LEVEL 25 CASTING_TOTAL 19
                ^"Blunt the Viper’s Fangs" TECHNIQUE "Perdo" FORM "Animal" LEVEL 15 CASTING_TOTAL 12
                ^"Circle of Beast Warding" TECHNIQUE "Rego" FORM "Animal" LEVEL 5 CASTING_TOTAL 10
                ^"Viper’s Gaze" TECHNIQUE "Rego" FORM "Animal" LEVEL 15 CASTING_TOTAL 9
                ^"Eyes of the Cat" TECHNIQUE "Muto" FORM "Corpus" REQUISITE "An" LEVEL 5 CASTING_TOTAL 19
                ^"Gift of the Bear’s Fortitude" TECHNIQUE "Muto" FORM "Corpus" LEVEL 25 CASTING_TOTAL 19
                ^"The Wound that Weeps" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 15 CASTING_TOTAL 12
                ^"Lifting the Dangling Puppet" TECHNIQUE "Rego" FORM "Corpus" LEVEL 15 CASTING_TOTAL 10
            }
            CHOICES {
                "The Bjornaer is much more comfortable with animals than with people, and may think of him or herself as just as much animal as human, thanks to the combination of Blatant Gift and Inoffensive to Animals. Ways of the Forest should be changed to a terrain appropriate to the actual heartbeast; a wolf is assumed for the example. Both Major Flaws can be changed freely, and while Deficient Form (Ignem) is very common in House Bjornaer, there is no particular reason for your character to have it. Note that Quiet and Subtle Magic allow the magus to cast in his heartbeast form without any penalty."
            }
        }

