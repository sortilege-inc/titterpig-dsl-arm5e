EXTENSION "ArM5_Character_Templates" {
    NAME "Ars Magica Fifth Edition - Character Templates"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-24"
    DEPENDS_ON "ArM5_Core_Base"

    #t3YIhBmdSZoTKdV79vGUR3vA TEMPLATE "The Female Scholar" DEF {
            EXTENDS ^"Companion"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 5
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 1
                    ^"Communication" INTEGER 2
                    ^"Strength" INTEGER -1
                    ^"Stamina" INTEGER -1
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 1
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 20
                ^"Apparent Age" INTEGER 20
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Soak" INTEGER -1 NOTE "Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Clothes", "a slate or wax tablet for writing on"]
                ^"Encumbrance" STRING "0 (0)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Clerk"
                ^"Apt Student"
                ^"Book Learner"
                ^"Good Teacher"
                ^"Great (Characteristic)" OF "Intelligence" TIMES 2
                ^"Improved Characteristics"
            }
            FLAWS {
                ^"Black Sheep"
                ^"Driven" NOTE "prove herself a greater scholar than any man"
                ^"Social Handicap" NOTE "outspoken advocate of the abilities of women"
            }
            PERSONALITY_TRAITS {
                "Scholarly" +3
                "Independent" +1
                "Trusting" -2
            }
            REPUTATIONS {
                "Selfish shrew" SCORE 2 TYPE "local"
            }
            COMBAT {
                "Dodging" INIT 1 DEFENSE 1
            }
            ABILITIES {
                "Arabic" SCORE 1 SPECIALTY "medical terms"
                "Artes Liberales" SCORE 3 SPECIALTY "rhetoric"
                "Charm" SCORE 2 SPECIALTY "scholars"
                "Church Lore" SCORE 2 SPECIALTY "scholars"
                "Civil and Canon Law" SCORE 1 SPECIALTY "rights of women"
                "Folk Ken" SCORE 2 SPECIALTY "scholars"
                "Guile" SCORE 2 SPECIALTY "lying to authority figures"
                "Local Area Lore" SCORE 2 SPECIALTY "nunneries"
                "Latin" SCORE 5 SPECIALTY "academic debate"
                "Living Language" SCORE 5 SPECIALTY "debate"
                "Medicine" SCORE 1 SPECIALTY "women’s illnesses"
                "Philosophiae" SCORE 3 SPECIALTY "moral philosophy"
                "Teaching" SCORE 3 SPECIALTY "Artes Liberales"
                "Theology" SCORE 2 SPECIALTY "status of women"
            }
            CHOICES {
                "The female scholar has estranged herself from her family by refusing to marry a suitable man, and instead pursuing her bizarre interest in academia. She has probably come to the covenant because it is the only place where she can study freely, and she wants access to the covenant library if she doesn’t already have it. Her current Virtues are very focused on scholarship, so changing one or two for Virtues that emphasize a different aspect of her life would be fine. Similarly, the emphasis of her studies could be moved to a different subject, as long as she still has a score of at least one in Artes Liberales, so that she is literate."
            }
        }

        #t5OfMgGAld5jmHUPgUaWKkxV TEMPLATE "The Knight" DEF {
            EXTENDS ^"Companion"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 1
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER 1
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 2
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 25
                ^"Apparent Age" INTEGER 25
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Soak" INTEGER 10 NOTE "chain mail, Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Full chain mail", "long sword", "heater shield", "great sword"]
                ^"Encumbrance" STRING "2 (3)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Knight"
                ^"Wealthy"
                ^"Improved Characteristics"
                ^"Puissant Ability" OF "Single Weapon"
                ^"Relic"
            }
            FLAWS {
                ^"Oath of Fealty"
                ^"Proud" SIZE "Major"
                ^"Overconfident" SIZE "Minor"
            }
            PERSONALITY_TRAITS {
                "Brave" +3
                "Chivalrous" +3
                "Proud" +3
            }
            COMBAT {
                "Long sword and shield (mounted)" INIT 2 ATTACK 17 DEFENSE 17 DAMAGE 7
                "Long sword and shield (on foot)" INIT 2 ATTACK 14 DEFENSE 14 DAMAGE 7
                "Great sword (mounted)" INIT 2 ATTACK 16 DEFENSE 13 DAMAGE 10
                "Great sword (on foot)" INIT 2 ATTACK 13 DEFENSE 10 DAMAGE 10
                "Fist" INIT 0 ATTACK 5 DEFENSE 5 DAMAGE 1
            }
            ABILITIES {
                "Animal Handling" SCORE 2 SPECIALTY "falconry"
                "[Area] Lore" SCORE 3 SPECIALTY "nobles"
                "Athletics" SCORE 2 SPECIALTY "running"
                "Awareness" SCORE 3 SPECIALTY "battle"
                "Brawl" SCORE 2 SPECIALTY "punching"
                "Chirurgy" SCORE 1 SPECIALTY "sword wounds"
                "Etiquette" SCORE 3 SPECIALTY "noble"
                "Great Weapon" SCORE 5 SPECIALTY "great sword"
                "Hunt" SCORE 2 SPECIALTY "deer"
                "Intrigue" SCORE 1 SPECIALTY "noble courts"
                "Leadership" SCORE 4 SPECIALTY "soldiers"
                "Music" SCORE 1 SPECIALTY "singing"
                "Native Language" SCORE 5 SPECIALTY "giving orders"
                "Ride" SCORE 5 SPECIALTY "in combat"
                "Single Weapon" SCORE 5 SPECIALTY "heater shield"
                "Survival" SCORE 1 SPECIALTY "forests"
            }
            CHOICES {
                "The Knight’s Wealthy Virtue gives him a lot of experience points, and so cannot be changed without effectively recreating the character from scratch. Oath of Fealty can be swapped for True Love and still be appropriate. In fact, both are so appropriate to a knight that the troupe may allow you to take both, as the character can still take three more points of Flaws. Note that the character regards himself as superior to just about anyone, unless you change the Major Personality Flaw, and doesn’t have the Abilities to interact well with equals."
            }
        }

        #tbedACFYGI6Ty0WG24FAvsHJ TEMPLATE "The Priest" DEF {
            EXTENDS ^"Companion"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 2
                    ^"Presence" INTEGER 1
                    ^"Communication" INTEGER 2
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER -1
                    ^"Quickness" INTEGER 0
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 33
                ^"Apparent Age" INTEGER 33
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Soak" INTEGER 0 NOTE "Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Priest’s clothes", "a missal"]
                ^"Encumbrance" STRING "0 (0)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Priest"
                ^"Inspirational"
                ^"Lesser Immunity" OF "lightning"
                ^"Relic"
                ^"Sense Holiness and Unholiness"
                ^"Social Contacts" OF "minor clergy"
                ^"Student of (Realm)" OF "the Divine"
                ^"Well-Traveled"
            }
            FLAWS {
                ^"Compassionate" SIZE "Major"
                ^"Plagued by Supernatural Entity"
                ^"Clumsy"
                ^"Vow" OF "Celibacy"
            }
            PERSONALITY_TRAITS {
                "Pious" +3
                "Loyal" +2
                "Helpful" +1
            }
            COMBAT {
                "Dodging" INIT 0 DEFENSE 2
            }
            ABILITIES {
                "Artes Liberales" SCORE 2 SPECIALTY "rhetoric"
                "Brawl" SCORE 1 SPECIALTY "dodging"
                "Charm" SCORE 5 SPECIALTY "parishioners"
                "Church Lore" SCORE 3 SPECIALTY "local diocese"
                "Civil and Canon Law" SCORE 1 SPECIALTY "regulations for the clergy"
                "Dominion Lore" SCORE 3 SPECIALTY "angels"
                "Etiquette" SCORE 3 SPECIALTY "Church"
                "Folk Ken" SCORE 6 SPECIALTY "people he knows very well"
                "Intrigue" SCORE 1 SPECIALTY "parishes"
                "Latin" SCORE 4 SPECIALTY "the Bible"
                "Leadership" SCORE 3 SPECIALTY "preaching"
                "Living Language" SCORE 5 SPECIALTY "preaching"
                "Local Area Lore" SCORE 5 SPECIALTY "churches"
                "Sense Holiness and Unholiness" SCORE 4 SPECIALTY "angels"
                "Theology" SCORE 2 SPECIALTY "angelology"
            }
            CHOICES {
                "The Priest could take another two Minor Flaws and corresponding Virtues, if desired. He may be unaware of his immunity, or being struck by lightning and remaining completely unharmed may have been a central event in his past. If it happened, it should be. The nature of his Lesser Immunity can easily be changed, and even boosted to a Greater Immunity if you take two more Minor Flaws."
            }
        }

        #tIrXx3dajHhLnxf2RaZkeUtI TEMPLATE "The Rogue" DEF {
            EXTENDS ^"Companion"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER -1
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 4
                    ^"Quickness" INTEGER 4
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 20
                ^"Apparent Age" INTEGER 20
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Soak" INTEGER 0 NOTE "Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Clothes", "secret stash of money that he never spends"]
                ^"Encumbrance" STRING "0 (0)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Wanderer"
                ^"Great (Characteristic)" OF "Dexterity"
                ^"Great (Characteristic)" OF "Quickness"
                ^"Improved Characteristics" TIMES 2
                ^"Light Touch"
                ^"Perfect Balance"
                ^"Puissant Ability" OF "Legerdemain"
                ^"Puissant Ability" OF "Stealth"
            }
            FLAWS {
                ^"Avaricious" SIZE "Major"
                ^"Dark Secret"
                ^"Ability Block" OF "Illiterate"
                ^"Compulsion"
            }
            PERSONALITY_TRAITS {
                "Avaricious" +3
                "Daring" +2
                "Sociable" +2
            }
            COMBAT {
                "Fist" INIT 4 ATTACK 7 DEFENSE 7 DAMAGE -1
            }
            ABILITIES {
                "Area Lore" SCORE 1 SPECIALTY "rich people’s homes"
                "Athletics" SCORE 3 SPECIALTY "climbing"
                "Awareness" SCORE 3 SPECIALTY "noticing whether he is observed"
                "Brawl" SCORE 3 SPECIALTY "getting away"
                "Charm" SCORE 2 SPECIALTY "people who think he’s exciting"
                "Folk Ken" SCORE 1 SPECIALTY "people in authority"
                "Guile" SCORE 1 SPECIALTY "when caught red-handed"
                "Legerdemain" SCORE 5 SPECIALTY "picking pockets"
                "Native Language" SCORE 5 SPECIALTY "being polite"
                "Stealth" SCORE 5 SPECIALTY "being quiet"
            }
            CHOICES {
                "The Rogue’s Dark Secret can be almost anything, but is most likely to be a particularly vile crime that he committed in the past, and now, probably, feels guilty about. The Compulsion should be to commit some sort of minor criminal act, such as thievery, or to take risks to prove he can. This character is fundamentally fast and stealthy, although he can turn on the charm to a certain extent. By moving the numbers in Characteristics and Abilities, you can turn him into a charmer with some ability in stealth. Don’t forget to change the Great Characteristic and Puissant Ability Virtues if you do this."
            }
        }

        #tr1iU1AXS4S6b5QTS0f5W0iD TEMPLATE "The Witch" DEF {
            EXTENDS ^"Companion"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 2
                    ^"Perception" INTEGER 2
                    ^"Presence" INTEGER 1
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER -1
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 0
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 30
                ^"Apparent Age" INTEGER 30
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Soak" INTEGER 0 NOTE "Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Old but sturdy clothes"]
                ^"Encumbrance" STRING "0 (0)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Wise One"
                ^"Educated"
                ^"Improved Characteristics"
                ^"Premonitions"
                ^"Second Sight"
                ^"Student of (Realm)" OF "Magic"
                ^"Wilderness Sense"
            }
            FLAWS {
                ^"Compassionate" SIZE "Major"
                ^"Enemies"
                ^"Nocturnal"
            }
            PERSONALITY_TRAITS {
                "Compassionate" +3
                "Sociable" -1
                "Trusting" -2
            }
            COMBAT {
                "Dodging" INIT 0 DEFENSE 0
            }
            ABILITIES {
                "[Area] Lore" SCORE 3 SPECIALTY "medicinal herbs"
                "Artes Liberales" SCORE 1 SPECIALTY "astronomy"
                "Athletics" SCORE 1 SPECIALTY "climbing"
                "Awareness" SCORE 1 SPECIALTY "animals"
                "Charm" SCORE 3 SPECIALTY "peasants"
                "Chirurgy" SCORE 4 SPECIALTY "farm accidents"
                "Divine Lore" SCORE 1 SPECIALTY "relics"
                "Faerie Lore" SCORE 2 SPECIALTY "curses"
                "Folk Ken" SCORE 3 SPECIALTY "peasants"
                "Guile" SCORE 3 SPECIALTY "clergy"
                "Infernal Lore" SCORE 1 SPECIALTY "diabolists"
                "Latin" SCORE 4 SPECIALTY "medical terms"
                "Magic Lore" SCORE 3 SPECIALTY "regiones"
                "Medicine" SCORE 5 SPECIALTY "accidental poisonings"
                "Native Language" SCORE 5 SPECIALTY "choosing words carefully"
                "Premonitions" SCORE 3 SPECIALTY "threats to others"
                "Second Sight" SCORE 3 SPECIALTY "ghosts"
                "Survival" SCORE 3 SPECIALTY "near farmland"
                "Wilderness Sense" SCORE 3 SPECIALTY "weather"
            }
            CHOICES {
                "The Witch’s magical powers are far, far weaker than a Hermetic magus’s, but she doesn’t have The Gift. She’s an excellent healer, and people might not believe that her healing abilities are purely mundane. Intolerant clergy make good enemies, as do magical or faerie beings she has annoyed, although in that case you might want to change the Flaw to Plagued by Supernatural Entity or Supernatural Nuisance. She can take another Major Flaw, or three more Minor ones, along with corresponding Virtues."
            }
        }

    #tMhYqJItVJIf5gRLHcsl7p5z TEMPLATE "Darius of Flambeau" DEF {
            EXTENDS ^"Magus"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 3
                    ^"Perception" INTEGER 1
                    ^"Strength" INTEGER 2
                    ^"Stamina" INTEGER 0
                    ^"Presence" INTEGER -3 AGING_POINTS 2
                    ^"Communication" INTEGER -1
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 2
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 87
                ^"Apparent Age" INTEGER 64
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 6
                ^"Warping Points" INTEGER 17
                ^"Confidence Score" INTEGER 1
                ^"Confidence Points" INTEGER 3
                ^"Hermetic Arts" DEF {
                    ^"Creo" INTEGER 10
                    ^"Intellego" INTEGER 6
                    ^"Muto" INTEGER 4
                    ^"Perdo" INTEGER 18
                    ^"Rego" INTEGER 9
                    ^"Animal" INTEGER 5
                    ^"Aquam" INTEGER 6
                    ^"Auram" INTEGER 6
                    ^"Corpus" INTEGER 15
                    ^"Herbam" INTEGER 6
                    ^"Ignem" INTEGER 6
                    ^"Imaginem" INTEGER 5
                    ^"Mentem" INTEGER 6
                    ^"Terram" INTEGER 6
                    ^"Vim" INTEGER 8
                }
                ^"Soak" INTEGER 0
                ^"Fatigue Levels" STRING "OK, 0, 0, –2, –4, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20) (*accumulated wound penalties reduce by 1 for Enduring Constitution)"
                ^"Twilight Scars" STRING "The shadows in Darius’ hood are unusually deep, hiding his face; Nearby, non-magical items decay when Darius uses magic (as the Warped Magic Flaw)."
                ^"Equipment" LIST ["Long Spear with haft enchanted as a talisman, instilled with the effect The Wound that Weeps (PeCo 15, penetration 0, 50 uses per day), attuned to a +4 bonus to spells that destroy at a distance", "Longevity Ritual: Lab Total 35, +7 aging bonus"]
                ^"Encumbrance" STRING "0 (2)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"The Gift"
                ^"Hermetic Magus"
                ^"Puissant Art" OF "Perdo" FREE
                ^"Flawless Magic"
                ^"Affinity with Art" OF "Perdo"
                ^"Enduring Constitution"
                ^"Fast Caster"
                ^"Hermetic Prestige"
                ^"Premonitions"
                ^"Second Sight"
                ^"Strong-Willed"
            }
            FLAWS {
                ^"Blatant Gift"
                ^"Driven" NOTE "Hunt Enemies of the Order"
                ^"Enemies" NOTE "Renounced Magus and his Lackeys"
                ^"Disfigured" NOTE "Facial Burns"
            }
            PERSONALITY_TRAITS {
                "Brave" +3
                "Dedicated to Cause" +3
                "Efficient" +3
            }
            REPUTATIONS {
                "Dedicated Hoplite" SCORE 3 TYPE "Hermetic magi"
            }
            COMBAT {
                "Fist" INIT 2 ATTACK 5 DEFENSE 6 DAMAGE 2
                "Kick" INIT 1 ATTACK 4 DEFENSE 4 DAMAGE 5
                "Long Spear" INIT 5 ATTACK 9 DEFENSE 8 DAMAGE 9
            }
            ABILITIES {
                "Artes Liberales" SCORE 4 SPECIALTY "Grammar"
                "Athletics" SCORE 2 SPECIALTY "Running"
                "Awareness" SCORE 3 SPECIALTY "Alertness"
                "Bargain" SCORE 2 SPECIALTY "Books"
                "Bavaria Lore" SCORE 2 SPECIALTY "Geography"
                "Brawl" SCORE 3 SPECIALTY "Punching"
                "Chirurgy" SCORE 2 SPECIALTY "Bind Wounds"
                "Civil and Canon Law" SCORE 1 SPECIALTY "Local Customs"
                "Code of Hermes" SCORE 3 SPECIALTY "Wizards’ Marches"
                "Concentration" SCORE 3 SPECIALTY "Spells"
                "Dominion Lore" SCORE 2 SPECIALTY "Divine Creatures"
                "Etiquette" SCORE 2 SPECIALTY "Merchants"
                "Faerie Lore" SCORE 2 SPECIALTY "Faerie Forests"
                "Finesse" SCORE 4 SPECIALTY "Precision"
                "Folk Ken" SCORE 2 SPECIALTY "Peasants"
                "German" SCORE 5 SPECIALTY "Merchant Slang"
                "Great Weapon" SCORE 4 SPECIALTY "Long Spear"
                "Guile" SCORE 3 SPECIALTY "Fast talk"
                "Hunt" SCORE 2 SPECIALTY "Tracking"
                "Infernal Lore" SCORE 2 SPECIALTY "Demons"
                "Intrigue" SCORE 3 SPECIALTY "Plotting"
                "Latin" SCORE 4 SPECIALTY "Hermetic"
                "Leadership" SCORE 3 SPECIALTY "Intimidation"
                "(Local Area) Lore" SCORE 3 SPECIALTY "Personalities"
                "Magic Lore" SCORE 2 SPECIALTY "Creatures"
                "Magic Theory" SCORE 5 SPECIALTY "Inventing Spells"
                "Order of Hermes Lore" SCORE 4 SPECIALTY "Criminals"
                "Parma Magica" SCORE 5 SPECIALTY "Corpus"
                "Penetration" SCORE 6 SPECIALTY "Perdo"
                "Philosophiae" SCORE 2 SPECIALTY "Moral Philosophy"
                "Premonitions" SCORE 3 SPECIALTY "Enemy Magi"
                "Profession — Scribe" SCORE 2 SPECIALTY "Speed"
                "Second Sight" SCORE 3 SPECIALTY "Invisibility"
                "Stealth" SCORE 2 SPECIALTY "Shadowing"
                "Survival" SCORE 2 SPECIALTY "Forests"
                "Swim" SCORE 2 SPECIALTY "Rough Water"
            }
            SPELLS_KNOWN {
                ^"Cripple the Howling Wolf" TECHNIQUE "Perdo" FORM "Animal" LEVEL 25 CASTING_TOTAL 27 MASTERY "1 (Fast Casting)"
                ^"Parching Wind" TECHNIQUE "Perdo" FORM "Aquam" LEVEL 20 CASTING_TOTAL 28 MASTERY "1 (Penetration)"
                ^"Curse of the Desert" TECHNIQUE "Perdo" FORM "Aquam" LEVEL 25 CASTING_TOTAL 29 MASTERY "2 (Penetration, Magic Resistance)"
                ^"The Chirurgeon’s Healing Touch" TECHNIQUE "Creo" FORM "Corpus" LEVEL 20 CASTING_TOTAL 26 MASTERY "1 (Penetration)"
                ^"Whispers through the Black Gate" TECHNIQUE "Intellego" FORM "Corpus" REQUISITE "Mentem" LEVEL 15 CASTING_TOTAL 13 MASTERY "1 (Quiet Casting)"
                ^"The Inexorable Search" TECHNIQUE "Intellego" FORM "Corpus" LEVEL 20 CASTING_TOTAL 22 MASTERY "1 (Penetration)"
                ^"Gift of the Bear’s Fortitude" TECHNIQUE "Muto" FORM "Corpus" LEVEL 25 CASTING_TOTAL 20 MASTERY "1 (Fast Casting)"
                ^"Dust to Dust" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 15 CASTING_TOTAL 37 MASTERY "1 (Penetration)"
                ^"The Wound that Weeps" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 15 CASTING_TOTAL 37 MASTERY "1 (Penetration)"
                ^"Incantation of the Milky Eyes" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 30 CASTING_TOTAL 37 MASTERY "1 (Penetration)"
                ^"Twist of the Tongue" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 30 CASTING_TOTAL 37 MASTERY "1 (Fast Casting)"
                ^"Clenching Grasp of the Crushed Heart" TECHNIQUE "Perdo" FORM "Corpus" LEVEL 40 CASTING_TOTAL 38 MASTERY "2 (Penetration, Magic Resistance)"
                ^"Endurance of the Berserkers" TECHNIQUE "Rego" FORM "Corpus" LEVEL 15 CASTING_TOTAL 25 MASTERY "1 (Fast Casting)"
                ^"Lifting the Dangling Puppet" TECHNIQUE "Rego" FORM "Corpus" LEVEL 15 CASTING_TOTAL 25 MASTERY "1 (Penetration)"
                ^"Seven-League Stride" TECHNIQUE "Rego" FORM "Corpus" LEVEL 30 CASTING_TOTAL 25 MASTERY "1 (Fast Casting)"
                ^"The Leap of Homecoming" TECHNIQUE "Rego" FORM "Corpus" LEVEL 35 CASTING_TOTAL 25 MASTERY "1 (Fast Casting)"
                ^"The Great Rot" TECHNIQUE "Perdo" FORM "Herbam" LEVEL 25 CASTING_TOTAL 28 MASTERY "1 (Fast Casting)"
                ^"Soothe the Raging Flames" TECHNIQUE "Perdo" FORM "Ignem" LEVEL 20 CASTING_TOTAL 28 MASTERY "1 (Fast Casting)"
                ^"Ward Against Heat and Flames" TECHNIQUE "Rego" FORM "Ignem" LEVEL 25 CASTING_TOTAL 16 MASTERY "1 (Fast Casting)"
                ^"Veil of Invisibility" TECHNIQUE "Perdo" FORM "Imaginem" LEVEL 20 CASTING_TOTAL 28 MASTERY "2 (Quiet Casting x 2)"
                ^"Tip of the Tongue" TECHNIQUE "Perdo" FORM "Mentem" LEVEL 5 CASTING_TOTAL 29 MASTERY "2 (Fast Casting, Magic Resistance)"
                ^"Calm the Motion of the Heart" TECHNIQUE "Perdo" FORM "Mentem" LEVEL 15 CASTING_TOTAL 28 MASTERY "1 (Quiet Casting)"
                ^"Loss of But a Moment’s Memory" TECHNIQUE "Perdo" FORM "Mentem" LEVEL 15 CASTING_TOTAL 29 MASTERY "3 (Quiet Casting x 2, Still Casting)"
                ^"Blessing of Childlike Bliss" TECHNIQUE "Perdo" FORM "Mentem" LEVEL 25 CASTING_TOTAL 30 MASTERY "3 (Quiet Casting x 2, Still Casting)"
                ^"Rusted Decay of Ten-Score Years" TECHNIQUE "Perdo" FORM "Terram" LEVEL 20 CASTING_TOTAL 28 MASTERY "1 (Fast Casting); Target increased to Group"
                ^"Demon’s Eternal Oblivion" TECHNIQUE "Perdo" FORM "Vim" LEVEL 30 CASTING_TOTAL 30 MASTERY "1 (Fast Casting)"
                ^"Wind of Mundane Silence" TECHNIQUE "Perdo" FORM "Vim" LEVEL 30 CASTING_TOTAL 30 MASTERY "1 (Magic Resistance)"
            }
            DESCRIPTION "Darius is a frightening individual. A bony figure swathed in a black, all-encompassing robe and carrying a black-hafted spear, he is reminiscent of medieval perceptions of the physical embodiment of death. This image is further emphasized if his hood falls away from his face, for Darius is bald, with a mass of scar tissue for a face and no eyes. Darius is content to cultivate his sinister image; he is a hoplite and an expert with Perdo magic, dedicated to the discovery and execution of traitors within the Order. Born Uwe into a Bavarian merchant family, he manifested The Gift at puberty and was taken as apprentice by the hoplite Xerxes. A lab accident burned away his eyes and the flesh of his head; Xerxes restored his sight but not his appearance. Fifteen years later he became the magus Darius and joined the hoplites. He recently fought a powerful Renounced magus and his followers and was nearly killed, escaping into Twilight; the traitor is still at large and Darius intends to kill him, even at the cost of his own life."
            MENTIONS {
                "The Gift" -> ^"The Gift"
            }
        }

    #tbWLGcbmEnmUgbp41vsKOP0Q TEMPLATE "The Berserker" DEF {
            EXTENDS ^"Grog"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER -2
                    ^"Perception" INTEGER -1
                    ^"Presence" INTEGER -1
                    ^"Communication" INTEGER -1
                    ^"Strength" INTEGER 3
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 1
                }
                ^"Size" INTEGER 1
                ^"Age" INTEGER 15
                ^"Apparent Age" INTEGER 15
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Soak" INTEGER 9 NOTE "Stamina, full metal scale armor"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24)"
                ^"Equipment" LIST ["Pole Axe", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling"]
                ^"Encumbrance" STRING "0 (3)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Covenfolk"
                ^"Berserk"
                ^"Large"
            }
            FLAWS {
                ^"Short Attention Span"
                ^"Wrathful" SIZE "Minor"
            }
            PERSONALITY_TRAITS {
                "Angry" +3
                "Brave" +3
                "Loyal" +1
                "Obedient" -2
            }
            COMBAT {
                "Pole Axe" INIT 2 ATTACK 13 DEFENSE 7 DAMAGE 14
                "Kick" INIT 0 ATTACK 6 DEFENSE 4 DAMAGE 6
            }
            ABILITIES {
                "[Area] Lore" SCORE 1 SPECIALTY "streams"
                "Athletics" SCORE 2 SPECIALTY "running"
                "Awareness" SCORE 3 SPECIALTY "attackers"
                "Brawl" SCORE 3 SPECIALTY "kicking"
                "Guile" SCORE 1 SPECIALTY "apologising"
                "Great Weapons" SCORE 5 SPECIALTY "pole axe"
                "Native Language" SCORE 5 SPECIALTY "insults"
                "Single Weapon" SCORE 1 SPECIALTY "heater shield"
                "Survival" SCORE 3 SPECIALTY "hills"
            }
            CHOICES {
                "The Berserker’s Large Virtue could be swapped out for an Affinity or Puissant Ability with Great Weapons. In addition he could have another Flaw, and take one of those Virtues to balance it. Other than that, he is young, so most of his Abilities are dictated by the concept. The Abilities at 1 or 2 can be swapped around, though."
            }
        }

        #tPsrPAlloDU0T4ywAGlCdytt TEMPLATE "The Grizzled Veteran" DEF {
            EXTENDS ^"Grog"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER -1
                    ^"Communication" INTEGER -1
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 1 AGING_POINTS 1
                    ^"Dexterity" INTEGER 2 AGING_POINTS 2
                    ^"Quickness" INTEGER 2 AGING_POINTS 2
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 45
                ^"Apparent Age" INTEGER 45
                ^"Decrepitude" INTEGER 1
                ^"Decrepitude Points" INTEGER 2
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Soak" INTEGER 8 NOTE "full metal scale armor"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Axe", "Heater Shield", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling"]
                ^"Encumbrance" STRING "4 (4)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Covenfolk"
                ^"Warrior"
            }
            FLAWS {
                ^"Weakness" NOTE "talking back to magi"
            }
            PERSONALITY_TRAITS {
                "Loyal" +3
                "Cheeky" +2
                "Brave" +1
            }
            COMBAT {
                "Axe & Heater Shield" INIT -1 ATTACK 15 DEFENSE 14 DAMAGE 6
                "Kick" INIT -3 ATTACK 6 DEFENSE 5 DAMAGE 3
            }
            ABILITIES {
                "[Area A] Lore" SCORE 4 SPECIALTY "monsters"
                "[Area B] Lore" SCORE 2 SPECIALTY "monsters"
                "Awareness" SCORE 5 SPECIALTY "in combat"
                "Bows" SCORE 5 SPECIALTY "longbow"
                "Brawl" SCORE 3 SPECIALTY "kicking"
                "Carouse" SCORE 3 SPECIALTY "with fighting friends"
                "Folk Ken" SCORE 1 SPECIALTY "magi"
                "Great Weapon" SCORE 5 SPECIALTY "pole axe"
                "Guile" SCORE 2 SPECIALTY "getting extra rations"
                "Leadership" SCORE 3 SPECIALTY "in combat"
                "Living Language" SCORE 5 SPECIALTY "military talk"
                "Order of Hermes Lore" SCORE 3 SPECIALTY "grogs"
                "Single Weapon" SCORE 8 SPECIALTY "heater shield"
                "Stealth" SCORE 3 SPECIALTY "when armored"
                "Survival" SCORE 1 SPECIALTY "when in a group"
                "Thrown Weapon" SCORE 4 SPECIALTY "knife"
            }
            CHOICES {
                "The Grizzled Veteran has been around the covenant for years, but has never reached a formal position of leadership, because he has a tendency to talk back to the magi. On the other hand, he makes a good informal leader of the grogs. Age hasn’t really slowed him down yet, but it is about to. He could take another two Flaws and a corresponding number of Virtues if desired, and his Ability scores can be moved around. The high set should probably be kept in combat, but he could specialize in a different sort of combat (you would have to recalculate Combat Totals), and the secondary abilities can be moved around at will."
            }
        }

        #tkHCqvradZD9Npvvmgwfb2lW TEMPLATE "The Hunter" DEF {
            EXTENDS ^"Grog"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 3
                    ^"Presence" INTEGER -2
                    ^"Communication" INTEGER -2
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 2
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 20
                ^"Apparent Age" INTEGER 20
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Soak" INTEGER 3 NOTE "partial leather armor, Stamina"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Partial heavy leather", "short bow", "arrows", "survival kit"]
                ^"Encumbrance" STRING "2 (2)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Covenfolk"
                ^"Warrior"
            }
            FLAWS {
                ^"Pessimistic"
            }
            PERSONALITY_TRAITS {
                "Brave" +3
                "Loyal" +1
                "Sociable" -2
            }
            COMBAT {
                "Short Bow" INIT -1 ATTACK 9 DEFENSE 6 DAMAGE 6
            }
            ABILITIES {
                "[Area] Lore" SCORE 4 SPECIALTY "game trails"
                "Athletics" SCORE 1 SPECIALTY "climbing"
                "Awareness" SCORE 5 SPECIALTY "woodlands"
                "Bows" SCORE 4 SPECIALTY "shooting from cover"
                "Hunt" SCORE 5 SPECIALTY "deer"
                "Native Language" SCORE 5 SPECIALTY "talking about forests"
                "Stealth" SCORE 2 SPECIALTY "hunting"
                "Survival" SCORE 4 SPECIALTY "woodlands"
            }
            CHOICES {
                "The hunter is extremely useful in the wilderness, and can guide the party as well as take part in missile combat. He can also help to support the covenant by bringing in food. He doesn’t work well in social situations, though. Note that the character’s Bows score uses the bonus XP from Warrior, and thus cannot go below 4, but otherwise the values of his Abilities, apart from his Native Language, can be swapped freely."
            }
        }

        #tN0Mp3y3fywtRyllXd0Aqqsw TEMPLATE "The Specialist" DEF {
            EXTENDS ^"Grog"
            PROPERTIES {
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER -1
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER -1
                    ^"Communication" INTEGER -4
                    ^"Strength" INTEGER 2
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER 3
                    ^"Quickness" INTEGER 2
                }
                ^"Size" INTEGER 0
                ^"Age" INTEGER 19
                ^"Apparent Age" INTEGER 19
                ^"Decrepitude" INTEGER 0
                ^"Warping Score" INTEGER 0
                ^"Warping Points" INTEGER 0
                ^"Soak" INTEGER 9 NOTE "full metal scale armor"
                ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
                ^"Equipment" LIST ["Axe", "Heater Shield", "Full metal scale armor", "pack containing gear to care for weapons and armor and establish camps when traveling"]
                ^"Encumbrance" STRING "2 (4)"
                ^"Source" STRING "Core Rules"
            }
            VIRTUES {
                ^"Covenfolk"
                ^"Affinity with Ability" OF "Single Weapon"
                ^"Puissant Ability" OF "Single Weapon"
                ^"Warrior"
            }
            FLAWS {
                ^"Afflicted Tongue" NOTE "stammer"
                ^"Obsessed" NOTE "improving Single Weapon ability"
                ^"Poor (Characteristic)" OF "Communication"
            }
            PERSONALITY_TRAITS {
                "Brave" +3
                "Loyal" +2
                "Quiet" +1
            }
            COMBAT {
                "Axe & Heater Shield" INIT 1 ATTACK 17 DEFENSE 15 DAMAGE 8
                "Fist" INIT 0 ATTACK 8 DEFENSE 7 DAMAGE 2
            }
            ABILITIES {
                "[Area] Lore" SCORE 3 SPECIALTY "warriors"
                "Athletics" SCORE 3 SPECIALTY "running"
                "Awareness" SCORE 4 SPECIALTY "in combat"
                "Bargain" SCORE 2 SPECIALTY "weapons"
                "Bows" SCORE 1 SPECIALTY "short bow"
                "Brawl" SCORE 5 SPECIALTY "dodging"
                "Carouse" SCORE 1 SPECIALTY "drinking"
                "Living Language" SCORE 5 SPECIALTY "talking about fighting"
                "Single Weapon" SCORE 7 SPECIALTY "Heater Shield"
            }
            CHOICES {
                "The Specialist can easily focus on a different Ability, although you might want to swap the Characteristics around as well if he does, and probably change Warrior for one of the other experience-point-granting Virtues, such as Educated or Well-Traveled. You can change Personality Traits freely, and assign the Ability scores to other Abilities. Similarly, the Flaws can be changed without changing the central concept of the character."
            }
        }

