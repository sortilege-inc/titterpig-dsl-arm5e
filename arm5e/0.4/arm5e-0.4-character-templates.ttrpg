                "Artes Liberales" SCORE 1 SPECIALTY "astronomy"
                "Brawl" SCORE 3 SPECIALTY "grappling"
                "Concentration" SCORE 3 SPECIALTY "spellcasting"
                "Finesse" SCORE 2 SPECIALTY "Terram"
                "Latin" SCORE 4 SPECIALTY "Hermetic usage"
                "Magic Theory" SCORE 3 SPECIALTY "Terram"
                "Native Language" SCORE 5 SPECIALTY "being polite"
                "Parma Magica" SCORE 1 SPECIALTY "Ignem"
                "Penetration" SCORE 2 SPECIALTY "Terram"
                "Survival" SCORE 3 SPECIALTY "mountains"
            }
            SPELLS_KNOWN {
                ^"Wall of Protecting Stone" TECHNIQUE "Creo" FORM "Terram" LEVEL 25 CASTING_TOTAL 35
                ^"The Crystal Dart" TECHNIQUE "Muto" FORM "Terram" REQUISITE "Re" LEVEL 10 CASTING_TOTAL 27
                ^"Rock of Viscid Clay" TECHNIQUE "Muto" FORM "Terram" LEVEL 15 CASTING_TOTAL 27
                ^"Earth that Breaks No More" TECHNIQUE "Muto" FORM "Terram" LEVEL 20 CASTING_TOTAL 27
                ^"Obliteration of the Metallic Barrier" TECHNIQUE "Perdo" FORM "Terram" REQUISITE "Re" LEVEL 20 CASTING_TOTAL 22
                ^"The Earth’s Carbuncle" TECHNIQUE "Rego" FORM "Terram" REQUISITE "Mu" LEVEL 15 CASTING_TOTAL 27
                ^"Hands of the Grasping Earth" TECHNIQUE "Rego" FORM "Terram" REQUISITE "Mu" LEVEL 15 CASTING_TOTAL 23
            }
            CHOICES {
                "This Ex Miscellanea tradition grants the Virtues Giant Blood and Affinity with Terram, and the Flaw Necessary Condition: Touching Stone. The stone in question can be a piece of stone worn on a belt, for example, but it must be at least the size of the magus’s hand (the magus has big hands). The magus doesn’t have his full allowance of Flaws, so you can take another Major Flaw, or three more Minor, and corresponding Virtues."
            }
        }

