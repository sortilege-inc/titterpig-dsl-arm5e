                ^"Affinity with Art" OF "Terram" FREE
                ^"Enduring Magic"
                ^"Improved Characteristics"
                ^"Puissant Art" OF "Terram"
                ^"Tough"
            }
            FLAWS {
                ^"Generous" SIZE "Major"
                ^"Necessary Condition" NOTE "touching stone" FREE
                ^"Plagued by Supernatural Entity"
                ^"Deficient Form" OF "Auram"
