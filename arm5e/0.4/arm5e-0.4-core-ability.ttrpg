BASE "ArM5_Core_Ability" {
    NAME "Ars Magica Fifth Edition - Ability (core type)"
    VERSION "0.4.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-24"

    # Base type for Abilities (Chapter Five), so arm5e-0.4-abilities.ttrpg has
    # a shared type to EXTEND.

    #tWPnyoi9rSMWyMo7Njlo9XM2 ^"Ability" DEF {
        APPLIES TO [^"Entity"]
        DESCRIPTION "Abilities are a character’s learned skills. They usually do increase during the course of a saga. Characters in Ars Magica can choose from a wide range of Abilities, listed in the Abilities chapter on page 63, which are divided into five types: General Abilities, which can be learned by anyone, and Academic Abilities, Arcane Abilities, Martial Abilities, and Supernatural Abilities. A character can only learn Academic, Arcane, or Martial Abilities if he has an appropriate Virtue or Flaw, or is a magus. A character cannot learn or use a Supernatural Ability at all unless he has the Virtue granting it, or has The Gift and has learned that Ability."
        REFERENCES {
            "The Gift" -> #tTewiGdZwmTboFEtrtBvqViC ^"The Gift"
        }

        PROPERTIES {
            ^"Ability Type" ENUM ["General", "Academic", "Arcane", "Martial", "Supernatural"] REQUIRED
            # The Ability List's asterisk: an asterisked Ability cannot be
            # used at all without a score. Unasterisked ones can be used at
            # 0 with extra botch dice.
            ^"Cannot Use Untrained" BOOLEAN DEFAULT false
            ^"Specialties" LIST OF STRING
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }
}
