BASE "ArM5_Core_Creature" {
    NAME "Ars Magica Fifth Edition - Creature (core type)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-24"

    # Base type for Chapter Thirteen's creatures (arm5e-0.4-bestiary-*.ttrpg).
    # Individual creatures set concrete inline values; the system sub-blocks
    # (COMBAT / POWERS) carry the typed lists.
    #
    # Creatures have either Intelligence or Cunning, never both: the book gives
    # Cunning to beasts that think as animals do. Might and Might Realm are
    # absent for creatures without a realm.
    #
    # The Creature Format section fixes the order of the Virtues and Flaws line:
    # The Gift first if present, then Major Virtues, Minor Virtues, Major Flaws,
    # Minor Flaws, each alphabetical. Creatures cannot take Status Virtues or
    # Flaws.

    #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature" DEF {

        PROPERTIES {
            ^"Might" INTEGER MIN 0
            ^"Might Realm" ENUM ["Magic", "Faerie", "Infernal", "Divine"]
            ^"Size" INTEGER
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER
                ^"Cunning" INTEGER
                ^"Perception" INTEGER
                ^"Strength" INTEGER
                ^"Stamina" INTEGER
                ^"Presence" INTEGER
                ^"Communication" INTEGER
                ^"Dexterity" INTEGER
                ^"Quickness" INTEGER
            }
            # Held Virtues and Flaws are references, same as a character's.
            # "Virtues and Flaws: None" is the block stating the creature has
            # none, which is not the same as the line being absent.
            ^"Virtues" LIST OF ^"Virtue"
            ^"Flaws" LIST OF ^"Flaw"
            ^"Virtues and Flaws" STRING
            ^"Personality Traits" LIST OF STRING
            ^"Reputations" LIST OF STRING
            ^"Soak" INTEGER
            ^"Fatigue Levels" STRING
            ^"Wound Penalties" STRING
            ^"Abilities" LIST OF STRING
            ^"Vis" STRING
            ^"Appearance" STRING
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }
}
