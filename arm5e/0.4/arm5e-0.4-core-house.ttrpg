BASE "ArM5_Core_House" {
    NAME "Ars Magica Fifth Edition - Hermetic House (core type)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-24"

    # Base type for the twelve Hermetic Houses (arm5e-0.4-houses.ttrpg).
    # The three House Types are the book's own, from the Hermetic Houses
    # Summary table on page 30.

    #tsQODBFlqgBrXCCFvw5mWcDt ^"Hermetic House" DEF {
        APPLIES TO [^"Magus"]

        PROPERTIES {
            ^"House Type" ENUM ["True Lineage", "Mystery Cult", "Societas"] REQUIRED
            ^"Prima" STRING
            ^"Domus Magna" STRING
            ^"Benefit" STRING
            ^"Outer Mystery" STRING
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }
}
