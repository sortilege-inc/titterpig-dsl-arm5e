BASE "ArM5_Core_Magic_Spell" {
    NAME "Ars Magica Fifth Edition - Formulaic Spell and the Hermetic Arts"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-24"

    # Base types for Hermetic magic: the spell type every per-Form bucket
    # EXTENDS (arm5e-0.4-spells-*.ttrpg), the fifteen Arts, the spell
    # guidelines, the Limits of Magic, and the spell mastery abilities.
    # Individual entries set concrete inline values and do not restate these
    # constraints (Definitions vs. Instances, spec S5).
    #
    # General-level spells: the book prints these as "Level: Gen". Such an
    # entry omits ^"Level" and sets ^"General Level" BOOLEAN true; its rules
    # text states how the level is chosen. The MIN 1 on ^"Level" still holds
    # for every spell that has one.

    #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell" DEF {
        APPLIES TO [^"Magus"]

        PROPERTIES {
            ^"Technique" ENUM ["Creo", "Intellego", "Muto", "Perdo", "Rego"] REQUIRED
            ^"Form" ENUM ["Animal", "Aquam", "Auram", "Corpus", "Herbam", "Ignem", "Imaginem", "Mentem", "Terram", "Vim"] REQUIRED
            ^"Level" INTEGER MIN 1
            ^"General Level" BOOLEAN DEFAULT false
            ^"Range" STRING REQUIRED
            ^"Duration" STRING REQUIRED
            ^"Target" STRING REQUIRED
            ^"Requisite" STRING
            ^"Ritual" BOOLEAN DEFAULT false
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tESnMlU09gobLgnXkml1BWdM ^"Art" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Abbreviation" STRING
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tjSDBarW271cweidwnNBzTYF ^"Hermetic Technique" DEF {
        EXTENDS ^"Art"
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Abbreviation" STRING REQUIRED
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tuBxNLXhVvgkHktKCmHwMMMR ^"Hermetic Form" DEF {
        EXTENDS ^"Art"
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Abbreviation" STRING REQUIRED
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" ENUM ["Creo", "Intellego", "Muto", "Perdo", "Rego"]
            ^"Form" ENUM ["Animal", "Aquam", "Auram", "Corpus", "Herbam", "Ignem", "Imaginem", "Mentem", "Terram", "Vim"]
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #tYlWl4fetP7u0D9bjGM1aiFL ^"Limit of Magic" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }

    #t2SvmZqM9oKIjG1FQkzneezM ^"Spell Mastery Ability" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
    }
}
