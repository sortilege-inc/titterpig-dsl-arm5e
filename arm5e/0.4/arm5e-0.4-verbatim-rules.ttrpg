EXTENSION "ArM5_Verbatim_Rules" {
    NAME "Ars Magica Fifth Edition - Additional Rules Sections"
    VERSION "0.4.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-24"
    DEPENDS_ON "ArM5_Core_Magic_Spell"

        #tJz2UIAzSwhy6Sjh5oDlsTVb ^"Magnitudes" DEF {
            APPLIES TO [^"Formulaic Spell"]
            PROPERTIES {
                ^"Source" STRING "Core Rules"
            }
            FORMULAS {
                "SPELL MAGNITUDE" "Level/5 (rounded up)"
            }
            DESCRIPTION "The magnitude of a spell is equal to one fifth of its level, rounded up. This is also the number of pawns of vis needed to cast a ritual spell, and changing the range, duration, or target of a spell generally changes its level by one magnitude (five levels) at a time. Spells of level one to five are all first magnitude, although the rules for changing ranges, durations, and targets work differently for such spells (see page 114). SPELL MAGNITUDE: Level/5 (rounded up)"
        }}
