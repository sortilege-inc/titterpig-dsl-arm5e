                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Supernatural" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The equipment and ingredients of the lab decay and wear unnaturally quickly. +2 Upkeep, –1 Safety, +1 Warping, –2 Health, –1 Aesthetics; +2 Pe."
            }
            #t7KjatEiDMK5GHkXSmKF9ZSa ^"Gremlins" DEF {
