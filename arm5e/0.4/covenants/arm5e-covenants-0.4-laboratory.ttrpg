                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is fitted with an interior gallery or platform, designed to allow someone to view the whole of the lab without disturbing it. +1 Safety, +1 Aesthetics; +1 Teaching."
            }
            #tb7MZJPRD5ZOPdeFtgvXnQ7L ^"Lesser Feature" DEF {
