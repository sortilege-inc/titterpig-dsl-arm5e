EXTENSION "ArM5_Covenants_Laboratory" {
    NAME "Ars Magica Fifth Edition, Covenants - Laboratory Virtues and Flaws"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-25"
    DEPENDS_ON "ArM5_Covenants_Core_Ext"

    #thqzKhxOc1LFjneioWtkrR7b ^"Outfittings Virtues and Flaws" DEF {
                APPLIES TO [^"Covenant"]
                PROPERTIES {
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "These Virtues and Flaws are due to the quality and quantity of the mundane materials and equipment that are in the lab, as well as any other inhabitants of the lab. Gaining or losing these Virtues and Flaws thus usually entails the purchase or acquisition of things to put in the lab, or the lack of (or defects in) such things."
                MENTIONS {
                    "Virtues and Flaws" -> ^"Virtues and Flaws"
                    "Virtues and Flaws" -> ^"Virtues and Flaws"
                }
            }
            #tRZAYuXgNaYSI6upEvWkJwXv ^"Greater Expansion" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Major" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The extent of the lab is greatly increased, with at least double the usual amount of equipment. This allows it to have more areas and equipment dedicated to specialized tasks. +2 General Quality, +4 Upkeep, +1 Aesthetics; 2 points on any Specialization(s)."
            }
            #t9IJfLKb2nTKlVXYMxNopd6A ^"Palatial" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Major" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is lavishly and magnificently outfitted, with the very best of comforts and decoration. +1 General Quality, +3 Upkeep, +2 Health, +4 Aesthetics; +2 Teaching, 1 point on any other Specialization."
            }
            #txBSZbvdGndERqGP1c7POLTu ^"Excessive Heating" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is kept far more warm than is necessary, and has the necessary facilities for it. For example, it has a half-dozen fireplaces. +2 Upkeep, –1 Safety; +2 Ig."
            }
            #tVoGhy8uwnIk6viOij8EHsxC ^"Excessive Lighting" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is lit far more than is necessary. For example, there are several hundred candles or lamps, which take up more space than usual. +2 Upkeep; +2 Im."
            }
            #tGJkJhD5TY8fGN6L8Ii1iupd ^"Lesser Expansion" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The extent of the lab is increased, with some more specialized equipment. +1 General Quality, +2 Upkeep; 1 point on any Specialization."
            }
            #tRxCLXxY2FqjqTsU9WR0oo7q ^"Living Quarters" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab contains suitable furniture, such as a bed, a wardrobe, and so on, that the owner may live and sleep in it. There is a small benefit to lab work if you live in the lab proper, but it is not good for your health, and is considered somewhat obsessive. +1 General Quality, –1 Safety, –2 Health, –2 Aesthetics."
            }
            #tAAFTlCpPLXdfYkPStmaToQa ^"Menagerie" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab contains a collection of live animals. +1 Upkeep, –1 Safety, –1 Aesthetics; +2 An."
            }
            #t8LHw1uuHCplar2YWf21g6NI ^"Opulent" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is comfortable and well furnished. +1 Upkeep, +1 Health, +2 Aesthetics; +1 Teaching."
            }
            #tx3IcLi3oh9cVHXD76Q2rotb ^"Pot Plants" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab contains dozens of potted plants. +1 Upkeep, +1 Aesthetics; +1 He."
            }
            #tsbAv1bHAq53kyWajkR1Q7Vm ^"Slaves" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "Human slaves are employed in the lab, either as manual labor or as experimental subjects. +1 Upkeep, –1 Safety, –1 Aesthetics; +2 Co or Me."
            }
            #tIZdCUYnwSNff38CFfwM3C1i ^"Specimens" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab has a large collection of related things, stored in visible containers such as jars, or otherwise serving as objects of study or decoration. +1 Upkeep, +1 Aesthetics; 1 point on any Form Specialization."
            }
            #tHsaggqHvlB3XUoAURzqvPbZ ^"Superior Decoration" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is luxuriantly or generously decorated. For example, many fine tapestries hang on the walls. +1 Upkeep, +2 Aesthetics; +1 Im."
            }
            #tNdt19G5chwbrroS8ZxPvPCk ^"Superior Heating" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab has superior facilities for heating, and the snug occupant is never chilly. For example, there is under-floor heating, or several fireplaces. +1 Upkeep, +1 Health, +1 Aesthetics; +1 Ig."
            }
            #tLVPyiAxUJZCynnSUXNDGleT ^"Superior Lighting" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is very well lit, so that things are easy to find, and books are easy to read, without eye-strain. +1 Upkeep, +1 Aesthetics; +1 Texts, +1 Im."
            }
            #tgn9fugdedceOKwOlqCCzhD1 ^"Assistant" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "A Gifted assistant (such as an Hermetic apprentice) helps out in the lab, affording a bonus to lab work. +(assistant's Intelligence + Magic Theory) General Quality. (This is simply a restatement of the existing bonus given in ArM5, page 103.)"
                MENTIONS {
                    "Magic Theory" -> ^"Magic Theory"
                }
            }
            #tdoLoiV2Nx8BgUpUl7orHI4c ^"Guard" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "A shield grog is on permanent duty at the lab's entrance, and may dissuade unwanted visitors from pestering the magus or intruding. +1 Aesthetics."
            }
            #teqkMiXWJMQ4VbmD5tZCB9Yw ^"Highly Organized" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab's contents have been optimally arranged. There is a chance to gain this Virtue whenever a season of work is undertaken to improve the Refinement (see Refinement, above). A season of such work (with a roll to gain the Virtue) may still be undertaken, even if no increase to Refinement is possible. This Virtue is lost if a major accident is suffered, if someone else uses the lab, or if someone of lower Intelligence helps in it. +1 General Quality."
            }
            #tNcIIZiRjKbLujeYjcjxvoWR ^"Person" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "There is another person, perhaps a close family member or a maid, who is to be found very frequently (as a rule of thumb, most days, for at least an hour) in the lab. This Virtue may be taken once for each such person who regularly comes in to the lab. Do not count the owner or any full-time lab assistants, such as apprentices. A full-time trained mundane assistant is instead represented by the Servant Virtue. –1 Safety; +1 Co or Me."
            }
            #t7lBvtc5zJ2C9hqL4IcECtuW ^"Precious Ingredients" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is supplied with more expensive ingredients than a typical covenant can afford. +1 General Quality, +2 Upkeep; +1 Longevity Rituals."
                MENTIONS {
                    "Longevity Rituals" -> ^"Longevity Rituals"
                }
            }
            #tvRvcBCRS5ZhwMXbxDmRv07c ^"Priceless Ingredients" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is supplied with the kind of things that most people can only dream of, such as copious quantities of gold and gems. +2 General Quality, +4 Upkeep; +2 Longevity Rituals."
                MENTIONS {
                    "Longevity Rituals" -> ^"Longevity Rituals"
                }
            }
            #tWlZhmG7GuFKX4foRyZ0U77b ^"Servant" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "One of the covenfolk is employed as a full-time lab servant, to perform the most mundane or bothersome tasks in the lab, and cater to the needs of the magus. +(servant's Intelligence / 2, rounding up) Safety, +1 Aesthetics; +1 Me."
            }
            #t4GS95Yqgc4ZqrF0lFyei6ql ^"Spotless" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is impeccably clean. This requires a season of work to gain. Also, there is a chance to gain this Virtue whenever a season of work is undertaken to improve the Refinement (see Refinement, above). This Virtue is lost if cleanliness is not maintained, or after an accident or neglect is suffered. +1 Health, +1 Aesthetics; +1 Cr."
            }
            #tsNrgc2rmdH1myx7yaflqrzH ^"Superior Equipment" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is supplied with higher-quality equipment, for example Venetian glassware. If the equipment was made at the covenant, the craftsman should have a Craft Ability of 6 or more, but do not increase Upkeep. +1 General Quality, +2 Upkeep, +1 Safety; +1 Vis Extraction."
                MENTIONS {
                    "Vis Extraction" -> ^"Vis Extraction"
                }
            }
            #t5soVi9LQ9v0nT9Esp3YU1qw ^"Superior Tools" DEF {
                EXTENDS ^"Laboratory Virtue"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab's tools were produced by master craftsmen. If the tools were made at the covenant, the craftsman should have a Craft Ability of 6 or more, but do not increase Upkeep. +1 Upkeep, +1 Safety; +1 Items."
            }
            #tleOSxdSz5RrWyzMxrcJ6UaL ^"Basic" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab setup is incomplete, and not all the necessary equipment has been installed. This Flaw is acquired after the first season of lab construction (see The Standard Hermetic Laboratory, above). It is removed after the second season of work completes the lab. –3 General Quality."
            }
            #tNasekO4djucjr6MRXIn2g5U ^"Damaged" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is partially damaged, for example as the result of a lab accident. It takes one season to repair the damage and eliminate this Flaw. –2 General Quality, –1 Safety, –1 Aesthetics."
            }
            #t1YMZAU3V11ChflJksXY0oqR ^"Damp" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is waterlogged or moist. Parchment and some ingredients will spoil quickly. +1 Upkeep, –1 Health, –1 Aesthetics; +1 Aq."
            }
            #tn5OIaYncrHU3yQvaRTodpvf ^"Decaying" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The equipment, furnishings, and materials of the lab are neglected (or have been allowed to go bad). –1 General Quality, –1 Upkeep, –1 Safety, –1 Aesthetics; +2 Pe."
            }
            #t48xz4r6HVaTjjd2q0Aq556l ^"Dirty" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is not kept to basic standards of cleanliness. Its owner often emerges from it smelly or dirty, and most visitors find it pretty unbearable. –1 Health, –2 Aesthetics; +1 Pe."
            }
            #tisLBkADWT9PGimCBEmoZn0y ^"Disorganized" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is organized in a rather haphazard or carefree fashion. Some magi prefer it this way. –1 Safety, –1 Aesthetics; +1 Mu or Experimentation."
            }
            #theach2f2QVol5QueTWvsloY ^"Gaudy" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab's decoration is tasteless and excessive. +1 Upkeep, –1 Aesthetics; +1 Im."
            }
            #tSgAFrFl9SlwmM5Du4ZzcK1u ^"Hidden Defect" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "A subtle and potentially dangerous error exists in the lab's configuration. This is usually the fault of the owner, but it may also be caused by a malicious and clever third party. There is a chance to gain (or lose) this Flaw whenever a season of work is undertaken to improve the Refinement (see Refinement, above). Whenever this defect is the cause of a lab botch, make a Perception + Magic Theory roll against an Ease Factor of 12. If this succeeds, the defect is spotted and may be corrected with a few hours of work. –3 Safety."
                MENTIONS {
                    "Magic Theory" -> ^"Magic Theory"
                }
            }
            #tAYPdRxWQZItSmoM7ndQV8nu ^"Inferior Equipment" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is outfitted with shoddy wares. It does not take a season to remove this Flaw, if sufficient funds are available to increase the Upkeep. –1 General Quality, –1 Upkeep."
            }
            #tKqLJyFd24gc6wfORwSmPI9E ^"Inferior Tools" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab's tools are crudely crafted, and are prone to breakage. It does not take a season to remove this Flaw, if sufficient funds are available to increase the Upkeep. –1 Upkeep, –1 Safety."
            }
            #t47QQumojpmU22T23lPOdBPY ^"Infested" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab has an animal or plant infestation, for example a nest of mice, a vine, or fungi. Depending on the nature of the infestation, it may not necessarily take a season to remove this Flaw. –1 Safety, –1 Aesthetics; +1 An or He."
            }
            #tCdnaareeQqwwcHlt5jJCoUF ^"Lousy Ingredients" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is supplied with dirty, impure, or poor-quality ingredients. It does not take a season to remove this Flaw, if sufficient funds are available to increase the Upkeep. –1 General Quality, –1 Upkeep."
            }
            #t3a4mgPy7NqyT99zAAbv8vgv ^"Missing Ingredients" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "Due to a lack of certain ingredients, lab work involving either one specific Technique or two specific Forms is severely hampered — relevant Lab Totals are halved. For example, the lab might contain no silver, in which case Terram and Vim Lab Totals are halved. It does not take a season to remove this Flaw, if sufficient funds are available to increase the Upkeep. –1 Upkeep."
            }
            #tp1KGKXtgwCeuMZOa2oAhxxw ^"Missing Sanctum Marker" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The sanctum marker is not prominently displayed, and is thus easy to miss, or it is missing altogether. Hermetic magi might (unwittingly or knowingly) intrude. It does not take a season to remove this Flaw. –1 Aesthetics."
            }
            #tYvUJPY3PeRatruwqgA6YDRB ^"Wrecked" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is very heavily damaged, for example as the result of a major lab accident. It takes two seasons to repair the damage completely and eliminate this Flaw. (After one season, it may be replaced by the Damaged Flaw.) –5 General Quality, –2 Safety, –2 Aesthetics."
            }
            #tILCrGuMiKn56iJ4gqRockpV ^"Defective Heating" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab has an inadequate or missing heating mechanism, and is rather too cold for comfort in the winter months. –1 General Quality, –1 Upkeep, –1 Health, –1 Aesthetics."
            }
            #tx7T4AG1uMekIwksfEz0xgEV ^"Defective Lighting" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is poorly lit, making it dingy and gloomy. It can be more difficult to read or find things. –1 General Quality, –1 Upkeep, –1 Safety, –1 Aesthetics."
            }
            #tFoA2gOKHPW8euqONnQt8Gb5 ^"Missing Equipment" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "Due to a lack of certain equipment, lab work in one or two types of activity is totally impossible. For example, if there is no desk, parchment, or ink, it is impossible to work with texts. If Items, Spells, or Texts is selected, only that single activity is impossible. Otherwise, you must pick two of the activity categories (see the Specialization section above). This Flaw cannot be taken more than twice. –1 Upkeep."
            }
            #tBp63E2lnMADOZzXayAPgMle ^"Undecorated" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Minor" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab has very spartan decoration, or the decoration is completely lacking, making the place rather uninspiring and unwelcoming. –1 Upkeep, –1 Aesthetics; subtract one point from any Specializations with a score of 2 or more."
            }
            #txMsFG9RSL9hdKtgDWhP2nGZ ^"Elementary" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Major" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "This is a cut-down version of a Hermetic laboratory, with an extremely limited selection of lab equipment installed, so that only one category of lab activity (see the list of possible activity Specializations above) is possible at all. The type of activity is determined at the time of construction, and is fixed thereafter. Still, such a limited lab is cheaper to maintain and takes only one season to build completely. It might be suitable for an extremely confined space, such as in a small cave, or in a wagon. Some covenants build elementary labs in powerful auras for the purposes of vis extraction. –2 General Quality, –3 Upkeep."
            }
            #tj7Iz2MxhQM4D5pBXlm3Lcmk ^"Hovel" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
                    ^"Magnitude" STRING "Major" FIXED
                    ^"Group" STRING "Outfittings" FIXED
                    ^"Repeatable" BOOLEAN false
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is very cramped, neglected, and filthy — it amounts to little more than a stinking dump. Most magi would never even consider setting foot in such a wretched hole. –1 General Quality, –2 Upkeep, –2 Safety, –3 Health, –4 Aesthetics."
            }

    #ta0hZDo6VcS5wt3vWATt6cPY ^"Structure Virtues and Flaws" DEF {
                APPLIES TO [^"Covenant"]
                PROPERTIES {
