                    ^"Magnitude" STRING "Free" FIXED
                    ^"Group" STRING "Structure" FIXED
                    ^"Repeatable" BOOLEAN true
                    ^"Source" STRING "Core Rules"
                }
                DESCRIPTION "The lab is prone to movements, for example it is on a ship, is earthquake-prone, or merely has dodgy foundations, which is the occasional cause of accidents or breakages. This Flaw may be taken more than once for a greater instability. +1 Upkeep, –1 Safety."
            }
            #tcFELcG6OdpJHFrWGKK8oeAr ^"Vile Surroundings" DEF {
                EXTENDS ^"Laboratory Flaw"
                PROPERTIES {
