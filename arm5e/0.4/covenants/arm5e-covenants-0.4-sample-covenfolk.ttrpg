            ^"Virtues and Flaws" STRING "Priest; Good Teacher, Relic; Fragile Constitution, Noncombatant, Vow (celibacy)"
            ^"Personality Traits" STRING "Pious +3, Loyal +2, Brave –1"
            ^"Reputations" STRING "None"
            ^"Combat" STRING "Fist: Init –1, Attack –1, Defense –1, Damage –2"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16+)"
            ^"Abilities" STRING "[Native Language] 5, Artes Liberales 4 (rhetoric), Awareness 3 (alertness), Bargain 2 (parishioners), Carouse 1 (stories), Charm 3 (witty), Church Lore 4 (rites and rituals), Covenant Lore 3 (rites and rituals), Etiquette 2 (magi), Folk Ken 3 (grogs), Intrigue 1 (avoiding plots), Latin 5 (church Latin), Music 4 (church music), Order of Hermes Lore 2 (magi), Philosophiae 3 (metaphysics), Profession: Scribe 1 (copying), Ride 2 (mule), Teaching 5 (small groups), Village Lore 3 (rites and rituals)."
            ^"Equipment" STRING "vestments and traveling clothes, bible, missal"
            ^"Encumbrance" STRING "0 (0)"
