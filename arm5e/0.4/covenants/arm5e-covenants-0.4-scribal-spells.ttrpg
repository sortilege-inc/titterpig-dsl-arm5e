EXTENSION "ArM5_Covenants_Scribal_Spells" {
    NAME "Ars Magica Fifth Edition, Covenants - Scribal Magic Spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-25"
    DEPENDS_ON "ArM5_Core_Magic_Spell"

    #t0q7dZIoUQLvjcteVDO0IUHF ^"Hide to Parchment" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Source" STRING "Covenants"
        }
        DESCRIPTION "This spell stretches, shaves, and dries a stack of animal hides, as if a percamenarius had worked on them. Stretching makes hide flexible instead of leathery, while shaving makes it smooth enough for writing and thin enough for binding. Drying prevents mold from forming on the vellum, but if excessive makes it brittle.\n\nA Perception + Finesse roll is treated as a Craft: Percamenarius roll to determine the quality of the vellum created.\n\n(Base 3,. +1 Touch, +2 Group)"
    }

    #tFnjj66U0NmLs4VHbJPM6C4D ^"Test of Fastness and Fading" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Aquam" FIXED
            ^"Level" INTEGER 5 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 3
            MODIFIERS {
            +1 "Touch"
            +1 "Part"
            }
        }
        DESCRIPTION "This spell confirms the quality of a container of ink, dye, or paint, verifying for the magus that it will not fade quickly, flake off rapidly, or eat through parchment."
    }

    #t8UYtmQs7qYhPLI7akzFy7BG ^"The Plunder of Twenty Geese" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Rego (optional, raises level to 20)"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +1 "Touch"
            +2 "Sun"
            +2 "Group"
            +1 "size"
            +1 "optional requisite"
            }
        }
        DESCRIPTION "This spell transforms up to 100 feathers, usually gained by plucking a chicken, into the wing feathers of geese, which are the preferred source of pens. A version of this spell, with a Rego requisite and level of 20, strips and tempers the pens."
    }

    #ty3rgmFEN8jnQ51atVJtfmLM ^"The Apple That Etches" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +1 "Touch"
            +2 "Group"
            +4 "size"
            }
        }
        DESCRIPTION "This spell creates 100,000 oak galls. Magi, even in inhospitable climates, can usually find an alternative to galls that provides them with ink, but some covenants are so closed off from the mortal world, and have such an abundance of Herbam vis, that their magi find this spell convenient. There are variants of this spell that create far fewer oak galls, but its Ritual nature ensures that their level is no lower, and they cost the same amount of vis."
    }

    #tsWwqQmZbiRpM1GSAVUU5H0b ^"Swift Knives, Invisible" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 40 FIXED
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Rego"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 30
            MODIFIERS {
            +1 "Eye"
            +1 "destruction of alimentary contents"
            +0 "cosmetic requisite"
            }
        }
        DESCRIPTION "This spell reduces an animal to its components. A dead sheep, for example, becomes a pile of unwashed wool, a hide, a collection of boned joins of meat, a stack of organs, and a skeleton. The contents of the alimentary tract vanish."
    }

    #tgUPDnOk6IUjGVDS8HrWP2po ^"The Welcome Addition of False Sunlight" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Ignem" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 4
            MODIFIERS {
            +1 "Touch"
            +2 "Ring"
            }
        }
        DESCRIPTION "This spell creates a steady, cool, smokeless light that does not flicker. Variants of this spell are enchanted into devices in many libraries. Some are handheld, while others float by their user, are embedded in the ceiling, or overlook the work desks of individual scholars."
    }

    #tKxQiem7MylsmuB34g39ODg0 ^"The Scribe’s Touch" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 3 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 2
            MODIFIERS {
            +1 "Touch"
            }
        }
        DESCRIPTION "This spell trims the magus’s quill with the flick of a finger."
    }

    #tYjl60AoAVUucYQuX4MtxnTi ^"Autodictation" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Level" INTEGER 15 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +2 "metal"
            +2 "Voice"
            +2 "Ring"
            }
        }
        DESCRIPTION "This spell allows the magus to write by talking. Before casting this spell, the magus prepares a metal stylus and series of wax boards, which are inscribed as the magus speaks. At the end of each day’s declamation, the wax boards go to notaries, who make temporary copies. These are then sent to scribes. This spell does not allow a magus to write faster than the core rules permit, but does allow impaired magi to write when they would otherwise require a notary. A Finesse roll makes the writing particularly precise and neat, which is usually unimportant."
    }

    #tgPpo67pqNOd8zUuqen2QhKg ^"Thoughts Distinctly Burned" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Aquam" FIXED
            ^"Level" INTEGER 10 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +2 "Voice"
            +2 "Ring"
            +1 "to allow many colors of ink"
            }
        }
        DESCRIPTION "This spell controls ink so that it makes patterns on the pages that correspond to the magus’s words. This spell does not allow a magus to write faster than the core rules permit, but does allow impaired magi to write when they would otherwise require a notary. A Finesse roll makes the writing particularly precise and neat, which is usually unimportant."
    }

    #tJnszdyxwsqavboMgSjejlfX ^"The First Furrow Guides the Second" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 25 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Intellego"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +1 "changes as pages turn"
            +2 "Voice"
            +2 "Sun"
            +2 "Group"
            +1 "requisite"
            }
        }
        DESCRIPTION "This spell lays the image of a book’s page over the top of a blank sheet, so that a scribe can trace the page’s contents. This creates identical copies of books. This is particularly useful when a book has lost a page, but can be made complete with a page copied from one of its sisters in another library. Used repeatedly over the course of a season, it can assist in the creation of copies of Hermetic books, allowing an unskilled magus to avoid the –3 penalty for scribing without Profession: Scribe. This spell is also known as The Principal Aide to the Forger’s Art."
    }

    #tNLmJbICu5qdkE8pChAkdzUE ^"Ink of Noblest Metals" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Dia"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Aquam"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 3
            MODIFIERS {
            +2 "metal"
            +2 "Voice"
            +1 "Dia"
            }
        }
        DESCRIPTION "This spell transforms gold into a liquid that is applied as ink. When the spell expires, it turns back into solid metal, allowing magi to place it on a page without developing skill with gold leaf. By pouring the golden ink into molds, the magi can set it into shapes."
    }

    #t4Stixsp7avTDbKTAVAPqLIP ^"Creating an Empty Book From a Filled One" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 3 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 2
            MODIFIERS {
            +1 "Touch"
            }
        }
        DESCRIPTION "This spell creates a palimpsest (a book that has had its writing scraped away so that it can be reused) from an existing book. It does this by flaking away a thin layer from both sides of each page.\n\nAn Intelligence + Finesse roll determines the skill with which the previous writing has been removed."
    }

    #tHEPAnmC6bW0mQeUyczTpyBP ^"Binding the Mundane Codex" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 5 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Optional, Vary"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +1 "Touch"
            +2 "Group"
            +1 "size"
            }
        }
        DESCRIPTION "This spell binds up to 1,000 prepared bifolds into books. Usually these bifolds have already been written upon, but magi may use this spell to create blank books if they wish. The spell fails if any of the necessary pieces of a codex are missing. Codicies created with this spell are usually flap-books, since they lack wooden boards within their covers. Binding mundane materials into the book which are not derived from animals, like cover boards or registers, requires a spell with the appropriate requisite and an Intelligence + Finesse roll against an Ease Factor of 12. Some magi mold animal bones into plates, to serve instead of wood. This spell allows readers of the book to claim the +1 quality bonus for sound binding."
    }

    #t86Ncy4WTgdoLLfpVAl59K6i ^"Binding the Hermetic Codex" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" INTEGER 20 FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Vary"
            ^"Source" STRING "Covenants"
        }
        LEVEL_CALCULATION {
            BASE 1
            MODIFIERS {
            +1 "Touch"
            +2 "Group"
            +1 "size"
            }
        }
        DESCRIPTION "A variant of Binding the Mundane Codex, this ritual allows magi to incorporate resonant materials into their bindings. Binding a book with resonant materials is extremely difficult and requires an Intelligence + Finesse roll against an Ease Factor of 12 + 3 per resonant material, to a maximum of three materials. This spell allows readers of the book to claim the +1 quality bonus for sound binding."
        REFERENCES {
            "Binding the Mundane Codex" -> #tHEPAnmC6bW0mQeUyczTpyBP ^"Binding the Mundane Codex"
        }
    }
}
