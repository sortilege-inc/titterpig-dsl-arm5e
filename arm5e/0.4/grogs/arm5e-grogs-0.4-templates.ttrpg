                        "Folk Ken" SCORE 2 SPECIALTY "magi"
                        "Infernal Lore" SCORE 3 SPECIALTY "curses"
                        "Latin" SCORE 3 SPECIALTY "Hermetic usage"
                        "Living Language" SCORE 5 SPECIALTY "storytelling"
                        "Magic Lore" SCORE 3 SPECIALTY "regiones"
                        "Magic Sensitivity" SCORE 4 SPECIALTY "auras"
                        "Magic Theory" SCORE 3 SPECIALTY "learning spells"
                        "Order of Hermes Lore" SCORE 2 SPECIALTY "history"
                        "Organization Lore: Covenant" SCORE 2 SPECIALTY "personalities"
