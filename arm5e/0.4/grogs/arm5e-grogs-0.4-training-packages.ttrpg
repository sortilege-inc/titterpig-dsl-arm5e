        #tyiKq7DMZV4Txt8QAMtLzrQS ^"Craftsman" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+10 Bargain, +25 Craft: Type A, +15 Craft: Type B, +15 Organization Lore: Guild, +10 Folk Ken" {
                    "Bargain" XP 10
                    "Craft: Type A" XP 25
                    "Craft: Type B" XP 15
                    "Organization Lore: Guild" XP 15
                    "Folk Ken" XP 10
                }
                "Three Years" YEARS 3 PRINTED "+10 Bargain, +15 Craft: Type A, +10 Craft: Type B, +5 Organization Lore: Guild, +5 Folk Ken" {
                    "Bargain" XP 10
                    "Craft: Type A" XP 15
                    "Craft: Type B" XP 10
                    "Organization Lore: Guild" XP 5
                    "Folk Ken" XP 5
                }
            }
            DESCRIPTION "An apprenticeship in a craft typically takes eight years, at the end of which time the character should have a primary Craft Ability of 3 (see *City & Guild*, page 42). It is assumed that each craftsman learns more than a single Craft Ability during a typical apprenticeship, and picks up several related trades. Journeymen should take a Trader package to account for the other Abilities he will need, and Masters will need the Trainer package."
        }

        #tpQneDJG2RNpObLprUehbKuE ^"Cultist" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Arcane"]
                ^"Printed Name" STRING "Cultist (Arcane)"
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+15 Guile, +50 Infernal Lore, +10 Stealth" {
                    "Guile" XP 15
                    "Infernal Lore" XP 50
                    "Stealth" XP 10
                }
                "Three Years" YEARS 3 PRINTED "+15 Guile, +30 Infernal Lore" {
                    "Guile" XP 15
                    "Infernal Lore" XP 30
                }
            }
            DESCRIPTION "A cultist has spent years worshiping an evil force in secret. If the character has the Ceremony Virtue, he can apply some of his experience points in Infernal Lore to that Ability instead. This package might also represent a pagan (in which case substitute Faerie Lore for Infernal Lore), or a devotee of a mystery cult (substitute Organization Lore: Cult and Magic Lore for Infernal Lore)."
            MENTIONS {
                "Infernal Lore" -> ^"Infernal Lore"
                "Faerie Lore" -> ^"Faerie Lore"
                "Infernal Lore" -> ^"Infernal Lore"
                "Magic Lore" -> ^"Magic Lore"
                "Infernal Lore" -> ^"Infernal Lore"
            }
        }

        #tzNdtC60n3FUnqNJdONEJhhk ^"Cunning Man" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Arcane"]
                ^"Printed Name" STRING "Cunning Man (Arcane)"
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Three Years" YEARS 3 PRINTED "+10 (Area) Lore, +5 Bargain, +30 Faerie Lore" {
                    "(Area) Lore" XP 10
                    "Bargain" XP 5
                    "Faerie Lore" XP 30
                }
            }
            DESCRIPTION "Knows the local legends and the ways of the fae."
        }

        #tQIRPVeYqKpdCylKIBPAVHsE ^"Cutter" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Three Years" YEARS 3 PRINTED "+40 Chirurgy, +5 Folk Ken" {
                    "Chirurgy" XP 40
                    "Folk Ken" XP 5
                }
            }
            DESCRIPTION "A cutter is trained in patching up the wounded and administering first aid; alternatively, he could be an empiricus, a traveling surgeon."
        }

        #tqL63LTFPE3EZnYQXSrMHV7m ^"Failed Apprentice" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+5 Artes Liberales, +5 Code of Hermes, +5 Concentration, +5 Finesse, +10 Latin, +25 Magic Theory, +15 Organization Lore: Order of Hermes, +5 Penetration" {
                    "Artes Liberales" XP 5
                    "Code of Hermes" XP 5
                    "Concentration" XP 5
                    "Finesse" XP 5
                    "Latin" XP 10
                    "Magic Theory" XP 25
                    "Organization Lore: Order of Hermes" XP 15
                    "Penetration" XP 5
                }
                "Three Years" YEARS 3 PRINTED "+5 Concentration, +10 Latin, +20 Magic Theory, +5 Organization Lore: Order of Hermes, +5 Penetration" {
                    "Concentration" XP 5
                    "Latin" XP 10
                    "Magic Theory" XP 20
                    "Organization Lore: Order of Hermes" XP 5
                    "Penetration" XP 5
                }
            }
            DESCRIPTION "The character must have the Failed Apprentice Virtue to take this package, which permits her to take Arcane and Academic Abilities. She probably has several years of Student to account for her Academic Abilities. It is assumed that she has no Art scores; either she has not been Opened to the Arts, or else her ability to work Hermetic magic has been destroyed."
            MENTIONS {
                "Hermetic magic" -> ^"Hermetic magic"
            }
        }

