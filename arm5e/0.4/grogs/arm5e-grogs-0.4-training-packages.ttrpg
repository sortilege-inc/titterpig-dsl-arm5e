                "Five Years" YEARS 5 PRINTED "+20 Awareness, +40 Bows, +15 Concentration" {
                    "Awareness" XP 20
                    "Bows" XP 40
                    "Concentration" XP 15
                }
                "Three Years" YEARS 3 PRINTED "+15 Awareness, +30 Bows" {
                    "Awareness" XP 15
                    "Bows" XP 30
                }
            }
        }

        #tPOYixr3wKK9dKMUWGrZr0D7 ^"Churchman" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Academic"]
                ^"Printed Name" STRING "Churchman (Academic)"
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+10 Artes Liberales, +30 Organization Lore: Church, +5 Latin, +30 Civil & Canon Law" {
                    "Artes Liberales" XP 10
                    "Organization Lore: Church" XP 30
                    "Latin" XP 5
                    "Civil and Canon Law" XP 30 PRINTED "Civil & Canon Law"
                }
                "Three Years" YEARS 3 PRINTED "+5 Artes Liberales, +20 Organization Lore: Church, +20 Civil & Canon Law" {
                    "Artes Liberales" XP 5
                    "Organization Lore: Church" XP 20
                    "Civil and Canon Law" XP 20 PRINTED "Civil & Canon Law"
                }
            }
            DESCRIPTION "Suitable for priests, friars, and nuns who have had some training within the church. Academic churchmen should also take the Theologian package. Parish priests probably have the Public Official or the Leader package, replacing some or all of the experience in Leadership with Profession: Preaching (see *Art & Academe*, page 13)."
            MENTIONS {
                "Public Official" -> ^"Public Official"
            }
        }

        #tXwvbmHL1lSjP5Itne9dUkx9 ^"Conman" DEF {
