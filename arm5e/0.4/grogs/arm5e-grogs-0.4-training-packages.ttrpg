                "Five Years" YEARS 5 PRINTED "+15 Charm, +30 Guile, +30 Intrigue" {
                    "Charm" XP 15
                    "Guile" XP 30
                    "Intrigue" XP 30
                }
                "Three Years" YEARS 3 PRINTED "+15 Charm, +15 Guile, +15 Intrigue" {
                    "Charm" XP 15
                    "Guile" XP 15
                    "Intrigue" XP 15
                }
            }
        }

