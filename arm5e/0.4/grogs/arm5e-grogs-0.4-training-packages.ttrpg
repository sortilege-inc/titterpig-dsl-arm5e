        #tUmx8AhUSO2A69MoFjpUZwNl ^"Natural Philosopher" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Academic"]
                ^"Printed Name" STRING "Natural Philosopher (Academic)"
                ^"Page" INTEGER 70
                ^"Source" STRING "Grogs"
