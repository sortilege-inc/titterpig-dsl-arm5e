        #tAfVggADlCpQg5vRFvkHo4Bw ^"Harlot" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 69
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+30 Charm, +30 Carouse or Etiquette, +15 Organization Lore" {
                    "Charm" XP 30
                    CHOICE [^"Carouse", ^"Etiquette"] XP 30
                    "Organization Lore" XP 15
                }
                "Three Years" YEARS 3 PRINTED "+20 Charm, +20 Carouse or Etiquette, +5 Organization Lore" {
                    "Charm" XP 20
                    CHOICE [^"Carouse", ^"Etiquette"] XP 20
                    "Organization Lore" XP 5
                }
            }
            DESCRIPTION "Carouse is most appropriate for an alehouse strumpet or street-corner\n\nworking girl, whereas Etiquette is more suited to a courtesan or mistress. They typically gain an Organization Lore appropriate to their clientele. The Trader package (taking Profession: Prostitute) is also appropriate."
        }

