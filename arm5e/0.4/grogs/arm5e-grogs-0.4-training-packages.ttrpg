        #t6fMGH2ou3CVz4GJ1Hf5jvVu ^"Student" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Academic"]
                ^"Printed Name" STRING "Student (Academic)"
                ^"Page" INTEGER 71
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years (cathedral school)" YEARS 5 QUALIFIER "cathedral school" PRINTED "+15 Artes Liberales, +30 Latin, +15 Theology, +15 Civil and Canon Law OR Philosophiae" {
                    "Artes Liberales" XP 15
                    "Latin" XP 30
                    "Theology" XP 15
                    CHOICE [^"Civil and Canon Law", ^"Philosophiae"] XP 15
                }
                "Five Years (monastic school)" YEARS 5 QUALIFIER "monastic school" PRINTED "+15 Artes Liberales, +30 Latin, +15 Theology, +15 Medicine OR Philosophiae" {
                    "Artes Liberales" XP 15
                    "Latin" XP 30
                    "Theology" XP 15
                    CHOICE [^"Medicine", ^"Philosophiae"] XP 15
                }
                "Five years (private tutor or university)" YEARS 5 QUALIFIER "private tutor or university" PRINTED "+15 Artes Liberales, +30 Latin, +30 any Academic Ability" {
                    "Artes Liberales" XP 15
                    "Latin" XP 30
                    "any Academic Ability" XP 30
                }
                "Three years (parish school)" YEARS 3 QUALIFIER "parish school" PRINTED "+15 Artes Liberales, +30 Latin" {
                    "Artes Liberales" XP 15
                    "Latin" XP 30
                }
            }
            DESCRIPTION "This package assumes that the character has received academic teaching at a parish school, cathedral school, or monastic school, or from a private tutor. Characters who have attended a university receive additional experience points from their Social Status Virtues (see *Art & Academe*, pages 90–92). Characters attending a parish school can only take the threeyear package, since these schools only teach Artes Liberales and Latin."
            MENTIONS {
                "Artes Liberales" -> ^"Artes Liberales"
            }
        }

