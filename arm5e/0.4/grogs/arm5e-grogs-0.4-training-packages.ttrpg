EXTENSION "ArM5_Grogs_Training_Packages" {
    NAME "Ars Magica Fifth Edition, Grogs - Training Packages"
    VERSION "0.4"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-07-25"
    DEPENDS_ON "ArM5_Grogs_Core_Ext"

        #tQXUN90wFGEBHxi7QlONQIUK ^"Advocate" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Academic", "None"]
                ^"Printed Name" STRING "Advocate (Academic or None)"
                ^"Page" INTEGER 68
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+40 Civil and Canon Law, +5 Leadership, +15 Artes Liberales, +15 Latin" {
                    "Civil and Canon Law" XP 40
                    "Leadership" XP 5
                    "Artes Liberales" XP 15
                    "Latin" XP 15
                }
                "Three Years" YEARS 3 PRINTED "+30 Civil and Canon Law, +5 Leadership, +5 Artes Liberales, +5 Latin" {
                    "Civil and Canon Law" XP 30
                    "Leadership" XP 5
                    "Artes Liberales" XP 5
                    "Latin" XP 5
                }
            }
            DESCRIPTION "An advocate has studied law, either at a university or through private tutors or a cathedral school. If the character has the Jurist Virtue (*Art & Academe*, page 91), then he need not have a Virtue permitting Academic Abilities, since this Virtue permits taking the key Abilities as a layman. If he has attended university, then he should take at least five years of Student and have a Virtue which grants extra experience in Academic Abilities. Characters in England need Common Law rather than Civil and Canon Law."
            MENTIONS {
                "Common Law" -> ^"Common Law"
                "Civil and Canon Law" -> ^"Civil and Canon Law"
            }
        }

        #t2dHqe1p5Xx40AIMDqgaQIHf ^"Animal Trainer" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 68
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+30 Animal Handling, +30 Profession: Animal Trainer, +15 Ride" {
                    "Animal Handling" XP 30
                    "Profession: Animal Trainer" XP 30
                    "Ride" XP 15
                }
                "Three Years" YEARS 3 PRINTED "+30 Animal Handling, +15 Ride" {
                    "Animal Handling" XP 30
                    "Ride" XP 15
                }
            }
            DESCRIPTION "The five-year package is suitable for a professional animal handler, such as a master of hounds or an ostler, and the Profession can vary accordingly. The three-year package is for those who have regular contact with animals but not as their principle job."
        }

        #ta4myQO0sqDkc1JBPbVYrGbz ^"Apothecary" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 68
                ^"Source" STRING "Grogs"
            }
            DURATIONS {
                "Five Years" YEARS 5 PRINTED "+15 (Area) Lore, +20 Chirurgy, +40 Profession: Apothecary" {
                    "(Area) Lore" XP 15
                    "Chirurgy" XP 20
                    "Profession: Apothecary" XP 40
                }
                "Three Years" YEARS 3 PRINTED "+5 (Area) Lore, +10 Chirurgy, +30 Profession: Apothecary" {
                    "(Area) Lore" XP 5
                    "Chirurgy" XP 10
                    "Profession: Apothecary" XP 30
                }
            }
        }

        #tjWbOYxWoyWVbSvXF1WVlvGY ^"Archer" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Ability Types" LIST ["Martial"]
                ^"Printed Name" STRING "Archer (Martial)"
                ^"Page" INTEGER 68
                ^"Source" STRING "Grogs"
            }
