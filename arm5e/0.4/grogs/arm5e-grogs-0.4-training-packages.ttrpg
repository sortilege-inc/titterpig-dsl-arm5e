        #t6bpqocX6udCq7Rvy0NrVSdr ^"Lay Brother" DEF {
            EXTENDS ^"Career Training Package"
            PROPERTIES {
                ^"Page" INTEGER 70
                ^"Source" STRING "Grogs"
            }
