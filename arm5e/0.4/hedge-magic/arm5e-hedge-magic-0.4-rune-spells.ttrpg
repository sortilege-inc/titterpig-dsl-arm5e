EXTENSION "ArM5_Hedge_Magic_Rune_Spells" {
    NAME "Ars Magica Fifth Edition, Hedge Magic [Revised Edition] - Rune Spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ArM5_Hedge_Magic_Core_Ext"

    #tlv2aKOLaPdJltG7JyYVSvRC ^"(The runemaster) curses the wound with blood he spilled." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Berkanan" FIXED
                ^"Secondary Rune" STRING "Mannaz"
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Berkanan (Mannaz) General, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The spell is cast upon a spear that has struck and wounded another, carving the runes to seal in the blood as an Arcane Connection. The target of the spell — the person whose blood is on the spear — receives three times the magnitude of the spell as a penalty to all of his recovery rolls, for as long as the rune lasts."
        }

        #tMwuE2FQrVp0u5EDHLfqnnwk ^"I, (the runemaster), speak with Odin’s voice." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ansuz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Ansuz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki receives a bonus to all Ability rolls associated with good speech and communication equal to the magnitude of this effect. For example, a Level 20 effect would give him a +4 bonus. This lasts for as long as the rune remains intact, though it is not cumulative with other blessings; if two such bonuses apply to a given action, the vitki only receives the bonus with the highest value."
        }

        #tG9EkMvnOQNo8yuyfhmv3Xf2 ^"I, (the runemaster), give understanding of the hollow voices." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ansuz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Ansuz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For as long as the runes last, the target may hear the words spoken by spirits and incorporeal beings and can tell the difference between illusory noises and real noises as if he had a score of this effect’s magnitude in Second Sight. The runes are usually drawn upon an amulet made of wood or stone and worn against the person’s skin, and thus typically last only a short while."
            REFERENCES {
                "Second Sight" -> ^"Second Sight"
            }
        }

        #tlGBTnP1Hcvt6foA4kt02WBa ^"I, (the runemaster), carve runes to close the flesh." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Berkanan" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Berkanan 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell is usually carved onto an amulet and placed inside a piece of the target’s clothing. The target heals a Light Wound, and as long as the runes last for at least a week (the recovery period for a Light Wound) the effect is permanent. If the amulet is removed or damaged during this time, before the wound would have healed naturally, the character must make an immediate recovery roll for that injury. If this equals or exceeds the Improvement Ease Factor, then the wound remains healed. If the roll equals or exceeds the Stable Ease Factor, then the Light Wound reopens. If this roll is less than the Stable Ease Factor then the wound worsens, becoming a Medium Wound."
        }

        #tyFhwj6h9BOAGbppLRTRtYxk ^"I, (the runemaster), carve the runes of giants." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Dagaz" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Dagaz 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki causes himself to grow with the sun, so that in the morning and afternoon he is +1 Size (essentially gaining the Large Virtue), and at noon he is Size +2. However, for the duration he will always return to his normal size by sunset, and remain that way until the sun rises again. During some months of the year in the extreme north, the sun never sets, and in that case the vitki may remain a giant for as long as an entire season."
        }

        #tdOlcaXRV7kvrwexHXuqApsG ^"(The runemaster) curses with years the defilers of the grave." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Dagaz" FIXED
                ^"Secondary Rune" STRING "Mannaz"
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Dagaz (Mannaz) 30, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "These runes ensure that any person who disturbs the ground or sealing stone of a grave or tomb immediately ages five years and must make an Aging roll. It is usually written on a tablet that is buried with the corpse, so that it cannot be seen by would-be defilers. A grave-robber can only be affected by this curse once per casting, though it might be cast multiple times on the same stone."
        }

        #thbs3SMSzyvDOyghsDXI6imx ^"(The runemaster) tames the wild stallion." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ehwaz" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Ehwaz 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki takes three hairs from the horse’s tail and carves them into the runes. For as long as the runes last, the horse will be well-disposed toward the vitki and respond to him as if they had been rider and mount for years."
        }

        #t8LO6bJ5yOILPfJsXuCIJZ1K ^"(The runemaster) speaks of friendship among men." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ehwaz" FIXED
                ^"Secondary Rune" STRING "Ansuz"
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Ehwaz (Ansuz) General, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "All those who hear the target’s words feel trust and goodwill toward him, for as long as the runes endure. Note that if anyone in this audience has Magic Resistance, the spell must still Penetrate and it is treated as either an Imaginem or Mentem effect, whichever is higher. In ancient times, vitkir would inscribe these runes on a baton carried by one of their followers before sending them to negotiate with rival tribes, to ensure that they would receive him as a friend. The effects of this spell are largely swamped by the effects of The Gift, although some vitkir believe it does make things a little bit better."
            REFERENCES {
                "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
                "The Gift" -> ^"The Gift"
            }
        }

        #tBdoIpw3ut0tDz0ktGrQiB0j ^"I, (the runemaster), am thrice blessed." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Gebo" FIXED
                ^"Level" STRING "15" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Gebo 15, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki receives a +3 bonus to his rolls when meeting and influencing others. This is the most common level for this effect, as it offsets some of the negative social effects of The Gift. A vitki always faces initial dislike and hostility from strangers, but with this magical boost he is at least not further hindered in his attempts to convince others that he means well. It is often cast without description, simply inscribing the Gebo rune three times for luck. This confers a –14 penalty to the vitki’s Casting Total, but is very subtle and easy for a vitkir with good knowledge of Gebo to do on a stone or stick before an important event takes place."
            REFERENCES {
                "The Gift" -> ^"The Gift"
            }
        }

        #tYH8w2iGvIANEOmESCCTHi5k ^"(The runemaster) summons a hearty ox." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Fehu" FIXED
                ^"Level" STRING "35" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Fehu 35, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "These runes summon a full-grown ox to the vitki, though the vitki must have a horn, hair, bone, or something else belonging to an ox, which is integrated into the runes and becomes an Arcane Connection to the ox that is summoned. The spell causes the ox to appear nearby, transported from wherever it was before. If the ox is dead, the spell also restores it to life, though it has no memory of any of its previous incarnations (and this does not work on any ox that had an Intelligence score or Might). The ox is strangely biddable, as if it had been raised by the vitki himself, though it loses this quality if the runes are destroyed. Note that the ox does not disappear or die when the spell ends, and that the spell will always summon the same ox if the same Arcane Connection is used."
        }

        #t6adCJTZMkqNAEgBKBOCgqqG ^"(The runemaster) gives the gift of obligation." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Gebo" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Gebo 30, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki inscribes the runes on a piece of jewelry that is given to another as a gift. While wearing it, the target is compelled to do as the vitki says, generally deferring to his judgment in all things that are not obviously dangerous or against its own interests."
        }

        #tZQuH6o79hAyJlZjk4lSxo4o ^"I, (the runemaster), ask for Freya’s blessing." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Fehu" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Fehu General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For as long as the rune endures, you receive a bonus equal to the effect’s magnitude on all rolls that directly involve the vitki’s pursuit of wealth. This might include rolls associated with business, such as Bargain or Folk Ken, or Awareness rolls when searching for treasure. Freya also has associations with fertility, and children might be considered a form of wealth. Thus, this bonus might also boost Stamina rolls associated with a mother giving birth."
            REFERENCES {
                "Folk Ken" -> #tiRSLLY6ibe94vbvYQaIeDsb ^"Folk Ken"
            }
        }

        #tTTt0sEs6OJCqCruvIV4YtXj ^"I, (the runemaster), dedicate helmet-destroying hail." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Hagalaz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Hagalaz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This rune gives the weapon on which it is inscribed a bonus to its Damage equal to the magnitude of the effect. Thor’s great hammer, Mjollnir, which he would throw at his enemies with one hand, is said to bear this rune prominently on the crosspiece."
        }

        #tqSpjQRiopJvfX9VaecuIWYe ^"(The runemaster) summons Thor’s lightning and thunder." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Hagalaz" FIXED
                ^"Level" STRING "15" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Hagalaz 15, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "After inscribing this script, a terrible thunderstorm gathers in the area surrounding the runes, reaching its peak in anywhere from an hour to a day depending on the time of year and the number of clouds in the sky. The storm then rages until it has rained itself out, and after this the vitki has no further control over it."
        }

        #tP2fgJTnDak5pvYYMExqCUUh ^"(The runemaster) binds the beasts in place." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Isa" FIXED
                ^"Secondary Rune" STRING "Fehu"
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Isa (Fehu) 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell holds a herd of domesticated animals completely motionless as long as they are within ten paces of the runes, and preventing them from moving away again."
        }

        #tYajVpS3HQQe6hR1sgoFWANU ^"(The runemaster) carves the ice of the north." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Isa" FIXED
                ^"Level" STRING "25" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Isa 25, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell creates a slippery sheet of ice located on the ground surrounding the runes, which is approximately ten paces across, and and which covers all things within that area with a thin layer of frost. This ice is natural, and will naturally thaw and melt over time, or very quickly in warmer temperatures."
        }

        #t5cqjJYmoQVnwZpqZTXuVv6Z ^"I, (the runemaster) bless the work." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Jera" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Jera General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki typically carves this rune into the floor of his home. After a year has passed, this gives him a bonus equal to the magnitude of the effect on all year-long activities he has undertaken there. For example, if he spends the next year studying, devoting himself to the same subject for all four seasons, at the end of it he will receive additional experience points equal to this effect’s magnitude. Likewise, if he spends the time working diligently in the field, he will receive a bonus to the roll that determines the quality of his harvest. As this is a continuous effect, he will also receive a Warping Point, and an additional one for each season if the effect is powerful."
        }

        #tRP6QFyffYcxVgZqLOVV7TpV ^"I, (the runemaster), see through the darkness." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Kauno" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Kauno General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This rune gives the vitki a bonus to rolls that involve eyesight, for as long as the rune is intact. It is typically inscribed on a wooden wand or staff after dark to improve night vision, and is traditionally burned on a fire the next morning."
        }

        #tUbHL1MmEaA9vXRkd68bVS38 ^"(The runemaster) causes fiery fever to burn bright." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Kauno" FIXED
                ^"Secondary Rune" STRING "Mannaz"
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Kauno (Mannaz) 30, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The target person is afflicted with a serious illness, the equivalent of a Medium Wound. While this spell endures, however, the target cannot recover naturally; his condition can only remain the same or worsen, since the disease is constantly maintained by the runes."
        }

        #tyJbZiqi7l6oB82JdMViqewO ^"I, (the runemaster) bless the fields." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Jera" FIXED
                ^"Level" STRING "5" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Jera 5, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "These runes are carved onto a stone that is buried in a field where grain or other growing seeds have been sown. As long as the runes are undisturbed, the land will yield a healthy and robust harvest that is unusually resistant to disease, drought, and insects."
        }

        #t1UsTj7HrNY11EpQUhRzMHua ^"I, (the runemaster) kiss the treacherous deep." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Laguz" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Laguz 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For the duration of the effect, the vitki can breathe comfortably both in water and on land."
        }

        #twQtyXsfbRQfgxuTR8ywKnlZ ^"I, (the runemaster), tame the wild waves." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Laguz" FIXED
                ^"Level" STRING "25" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Laguz 25, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The runes are carved into a piece of wood mounted on the prow of a ship, which ensures that the craft travels at incredible speeds through the water, doubling its natural movement rate."
        }

        #tWmrNttoKQzMdSWXXY2aRZsO ^"I, (the runemaster), make men sure and steady." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Mannaz" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Mannaz 30, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For the duration of this effect, the target’s Dexterity Characteristic is increased by 1, but no higher than 0."
        }

        #t2i0ERZbHYpv6dfoX0gLALwA ^"(The runemaster) leads men to greatness." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Mannaz" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Mannaz 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "All the people fighting within ten paces of the runes function as a trained group, even if their leader does not have a sufficient Leadership score. The runes are typically woven into a flag or painted on the shield carried by the leader."
        }

        #tw7xMWXjzpA0luFVyGQn2WAy ^"I, (the runemaster), feel my hearth and home." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ingwaz" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Ingwaz 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "After carving these runes, the vitki can sense the approximate direction and distance of his family members, and their general emotional state (i.e. excited or calm)."
        }

        #tfnt3HYsSezbg4Xuy8EAJhR2 ^"(The runemaster) calls his children to his side." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ingwaz" FIXED
                ^"Level" STRING "35" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Ingwaz 35, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "By incorporating an Arcane Connection into the rune spell, the vitki transports a member of his family to the runes, intangibly speeding him or her across the land. Family can include members of the vitki’s household, or blood relatives. This journey typically takes about an hour from anywhere within Scandinavia, though greater distances might increase the time it takes for the person to arrive."
        }

        #tzBbFR6EugwnFVkroLP4kax7 ^"I, (the runemaster), store power for my time of need." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Naudiz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Naudiz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This effect binds another rune spell to the target, delaying its resolution until it is triggered. The caster describes what sort of conditions cause the effect to activate — usually this is when he is Incapacitated or killed — and then he inscribes the rune spell for the bound effect next to the Naudiz runes."
        }

        #tKYr2d3jI3w71uPgSMyPamhL ^"(The runemaster) brings hardship to the enemy and his family." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Naudiz" FIXED
                ^"Secondary Rune" STRING "Ingwaz"
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Naudiz (Ingwaz) 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "All those who live in the target structure begin to feel deep despair and self-loathing, beset by strife. For as long as the runes last, their Confidence Scores are reduced by 1. For most characters, this means that they cannot spend Confidence Points to increase their totals."
        }

        #tzUKDqmkGlBkzeUUuo6604cN ^"I, (the runemaster), sharpen my axe." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Othila" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Othila General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki receives a bonus equal to the magnitude of the effect to his Initiative, Attack, and Damage scores as long as he wields a particular weapon."
        }

        #tvAFUQULuQkiSxvjLR8R1noR ^"(The runemaster) has need of an arrow." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Othila" FIXED
                ^"Secondary Rune" STRING "Hagalaz"
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Othila (Hagalaz) 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell summons an arrow to which the vitki has an Arcane Connection, causing it to appear somewhere nearby — inside his quiver, for example, or perhaps in the ground just outside his tent. A vitki might carve a rune on each of his arrows to create an Arcane Connection to them, so that he can then call them all back to himself with this rune spell."
        }

    #thZ9U9rg7U5V6b7Cc81JatZl ^"(The runemaster) defies his rival and laughs at his misfortune." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Perth" FIXED
                ^"Secondary Rune" STRING "Mannaz"
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Perth (Mannaz) General, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki integrates an Arcane Connection to another rune wizard into his rune script, and for as long as it lasts, whenever his rival must roll for a magical botch he adds a number of additional dice to his pool equal to the magnitude of this effect."
        }

        #t0BbQwK19x8zo7YruGai0xxz ^"I, (the runemaster), sense the sleeping alfar." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Perth" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Perth 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For as long as the rune endures, the vitki can sense vis when he is within about ten paces of it. He may identify it based on its associations with a single rune, and he may also tell approximately how many pawns there are."
        }

        #t9GPzirbhLt5cFu0STgoqzQI ^"I, the runemaster, hear the thunder of the north." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Raido" FIXED
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Raido 20, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki can sense which way is north for as long as the rune remains undamaged."
        }

        #t0D9wOj71rsYSUCwY3Bw2fOu ^"I, the runemaster, give eight legs to my horse." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Raido" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Raido 30, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "With this rune spell, which is usually inscribed directly onto the horse’s saddle or blanket, the vitki causes his horse to travel extremely quickly, covering ten paces with each step."
        }

        #tqxKhhl6hgt0KB2t2swY2EdY ^"I, (the runemaster), step most surely in sunlight." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Sowilo" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Sowilo General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki receives the magnitude of this effect as a bonus to all Perception-based Ability rolls."
        }

        #tMlRKcXDp54pY0DpA9qGno1z ^"I, (the runemaster), summon summer’s brightness." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Sowilo" FIXED
                ^"Level" STRING "25" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Sowilo 25, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For as long as the rune endures, bright sunlight shines out from the target. Those who look directly at the light may be blinded by it, and it is said that creatures of the night and wickedness cannot bear its touch and so must flee its presence."
        }

        #tmGeW6kwL9BUTnKzHIJrf8v8 ^"I, (the runemaster), fight for my companions." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Tiwaz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Tiwaz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki typically casts this spell in battle, scratching the runes into his shield or armor. He receives a bonus equal to the magnitude to all of his Attack rolls for as long as the runes last. (In a pitched melee, this is unlikely to be more than a few rounds.)"
        }

        #tqZPYrjmkCNlQoVvL1j0nRUW ^"I, (the runemaster), can sense the liar’s craft." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Tiwaz" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Tiwaz 30, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For the duration, the vitki can sense if people believe they are telling the truth so long as he is within about ten paces of them. (Note that demons can easily foil this effect.)"
        }

        #t38N3L170HT4p93JR864cYAA ^"(The runemaster) prepares the ogre-slaying spear." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Thurisaz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Thurisaz General, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki prepares the runes on the shaft of a spear, and throws it into a battlefield. If the effect penetrates their Magic Resistance, all supernatural creatures within ten paces of its path have their Might Scores reduced by (the level of this effect – 10). For example, at Level 15 their Might Scores are reduced by 5."
            REFERENCES {
                "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
            }
        }

        #t8uvoN5ZCJLOHw8yfC20fN6c ^"I, (the runemaster), call the serpent from the brambles." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Thurisaz" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Thurisaz 30, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The runes are typically carved onto a twisted branch, with Thurisaz written three times for emphasis. When the inscription is complete, the branch changes into a venomous snake. If it suffers a Heavy Wound, the runes are broken and it becomes a simple branch again."
        }

        #tnE50NVUYhPT0ouhmfCEQs1Q ^"I, (the runemaster), need strength for my trials." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Uruz" FIXED
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Uruz General, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki receives a bonus equal to the magnitude of the effect to all Strength-based Ability rolls, such as when lifting or pushing heavy objects, or when swimming, climbing, or walking through extremely harsh environments."
        }

        #tydCfbSabVXL0n6NJQdQJHb0 ^"I, (the runemaster), summon the aurochs." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Uruz" FIXED
                ^"Level" STRING "45" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Uruz 45, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The rune spell summons an aurochs ­— the wild beast for which the rune is named. It is not under the vitki’s control, and will probably charge like a bull at anyone who appears to threaten it. The vitki must have some part of an aurochs in order to cast the spell, which is worked into the runes. If killed, the animal’s carcass will easily feed a hundred people, who will all feel stronger and healthier after (perhaps represented by a Confidence Point), though this effect is undone if the runes are damaged or if they are destroyed."
        }

        #tz7lxOyCqT8sOVuPknrmCvKA ^"(The runemaster) gives the gift of joy." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Wunjo" FIXED
                ^"Secondary Rune" STRING "Gebo"
                ^"Level" STRING "20" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Wunjo (Gebo) 20, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "By placing these runes on a gift intended for another, the vitki ensures that it will be received with joy and deepest gratitude, easing the cares of the recipient in an almost intoxicating way."
        }

        #tos6urGeoHuKDuKo7xxHRlOB ^"I, (the runemaster), paint the runes of frenzy." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Wunjo" FIXED
                ^"Level" STRING "30" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Wunjo 30, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki draws the Wunjo rune upon a warrior, who does not feel pain or fatigue for as long as the runes remain undamaged. He may ignore all Fatigue and Wound Penalties, though if he expends all of his Fatigue levels he will fall unconscious, and he may still be killed or incapacitated in this state."
        }

        #tjPN8wgV0IwMPhrj02R4k2Fz ^"I, (the runemaster), walk swiftly through the murky wood." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ihwaz" FIXED
                ^"Level" STRING "15" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Ihwaz 15, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki gains an intuitive understanding of the properties of trees within about ten paces, allowing him to travel quickly through an unfamiliar forest or sense the most likely direction of a particular plant."
        }

        #tCtFbQPsCPVzoqwN7wXenrNa ^"I, (the runemaster), may speak with the shades of the past." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Ihwaz" FIXED
                ^"Level" STRING "35" FIXED
                ^"Method" STRING "I" FIXED
                ^"Descriptor" STRING "Ihwaz 35, Method I"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "By standing within ten paces of a grave, the vitki may mentally communicate with the ghostly spirit of its inhabitants."
        }

        #tECD8kkwFQ3Y7WnNukX2LhTO ^"I, (the runemaster) protect against beings of fire and pain." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Algiz" FIXED
                ^"Secondary Rune" STRING "Kauno"
                ^"Level" STRING "General" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Algiz (Kauno) General, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The vitki carves the runes into an object, such as an amulet or a stone. For the duration of the effect, fire creatures and disease spirits with Might less than or equal to the level of this effect cannot come within ten paces of the runes, and cannot use their powers to affect anything within that area."
        }

        #tdxfLg2fMixOWrJTheB4q93X ^"(The runemaster) protects against the beasts of the wild." DEF {
            EXTENDS ^"Rune Spell"
            PROPERTIES {
                ^"Rune" STRING "Algiz" FIXED
                ^"Secondary Rune" STRING "Uruz"
                ^"Level" STRING "10" FIXED
                ^"Method" STRING "II" FIXED
                ^"Descriptor" STRING "Algiz (Uruz) 10, Method II"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For the duration of the effect of the spell, wild animals cannot come within ten paces of the rune."
        }}
