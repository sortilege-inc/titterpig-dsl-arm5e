    #tH9EtuV8bXuzGMglovygRHEp ^"Sigel (Anglo-Saxon Futhorc)" DEF {
        EXTENDS ^"Modified Rune"
        PROPERTIES {
            ^"Table" STRING "The Anglo-Saxon Futhorc" FIXED
            ^"Letter" STRING "S" FIXED
            ^"Rune Name" STRING "Sigel" FIXED
            ^"Pronounced" STRING "SEE-wel"
