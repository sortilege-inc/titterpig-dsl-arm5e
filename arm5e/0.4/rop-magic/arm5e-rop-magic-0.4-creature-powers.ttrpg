EXTENSION "ArM5_RoP_Magic_Creature_Powers" {
    NAME "Ars Magica Fifth Edition, Realms of Power: Magic - Creature Powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ArM5_RoP_Magic_Gap_Types"

    #ts6i6hIFXsOLQTFmUuRLR7wD ^"Command the Flock" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Bird of Nephelococcygia" FIXED
            ^"Page" INTEGER 69
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 Point, Init: Qik–4, Animal R: Voice, D: Sun, T: Group The character can trill commands to a group of up to 100 birds. The birds will try to obey any command that they can understand (mundane birds can understand commands equivalently to a dog), but they will not do anything obviously suicidal and if the birds have a Magic Resistance this power must Penetrate. The power lasts for a duration of Sun, and after this period the birds will act on their own initiative. ReAn 35 (Base 5, +2 Voice, +2 Sun, +2 Group): Greater Power (35 levels, –3 cost)"
        REFERENCES {
            "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #tV2WAjF2b5Cp2Xn21VStnhbD ^"The Crow’s Song" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Bird of Nephelococcygia" FIXED
            ^"Page" INTEGER 69
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 Points, Init: Qik–4, Corpus R: Voice, D: Special, T: Ind The character sings this song at a target individual, and the next time the target sleeps an Aging Roll is made for him, adding 5 to the roll — even if he is too young to make Aging Rolls normally. This power must penetrate the target’s Magic Resistance to be effective. PeCo 40 (Base 15, +2 Voice, +3 Special Duration): Greater Power (40 levels, –2 cost)"
        REFERENCES {
            "Aging Rolls" -> #t6d4SWNJLfybVZert1zKUkqW ^"Aging Rolls"
            "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #tBvG9nUPE2i1BfrtWSs3jxXv ^"Air for Flying" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Bird of Nephelococcygia" FIXED
            ^"Page" INTEGER 69
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 Point, Init: Qik–4, Auram R: Sight, D: Conc, T: Group While the character sings this tune, the weather in the locale remains calm and temperate. This will also negate any magically created inclement weather where the magnitude of the effect that caused the inclement weather is less than the character’s Might / 5 (round up). This power has a duration of concentration. ReAu 35 (Base 5, +3 Sight, +1 Concentration, +2 Group): Greater Power (35 levels, –3 cost)"
        REFERENCES {
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #ta5PURS7cvV2PjDgfp9YWFYf ^"Call the Flock" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Bird of Nephelococcygia" FIXED
            ^"Page" INTEGER 69
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 Point, Init: Qik–4, Animal R: Special, D: Diameter, T: Group If the character is in the open air, she may sing a song that summons a cloud of mundane birds about herself. From the next round, 10 birds arrive each round, every round over the next Diameter. The type of birds that arrive depends on the locale; at sea the birds will be mostly seagulls, shags, and shearwaters, for example. When they arrive, the birds attempt to gather about the character, attacking any other characters in the way. If they are not commanded to perform some task, the birds will slowly disperse over the next few hours. This power itself does not grant the character an intrinsic ability to command the flock. ReAn 35 (Base 2, +4 special range, +1 diameter, + 2 Group +2 Size of Group): Greater Power (35 levels, –3 cost)"
        REFERENCES {
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #tgvpsNXRl3zxOC2HLHj1jwVO ^"Aura of Rightful Authority" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "4 points, Mentem R: Eye, D: Sun, T: Ind This effect is used to overcome the shock caused by talking cats. It also inclines humans to obey orders. (20 spell levels: Base 5, +1 Eye, +2 Sun)"
    }

    #t7XhdbTOiC4Qj7J3rZsbYsuz ^"Blackberry Cat" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "or Feigned Innocence, 5 points, Mentem R: Eye, D: Mom, T: Group This causes a Group of people to forget something the cat did, much as the spell Loss of But A Moment’s Memory does. The name comes from the belief that cats born in blackberry season have mischief in them. (25 spell levels: Base 10, +1 Eye, +2 Group)"
    }

    #t9IKXLr5Akvc9WLANXVQma05 ^"Curse of Rheumatism" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Corpus R: Touch, D: Mom, T: Ind If a person touches the cat, he develops rheumatism in that limb. This power is traditionally used on those who kick cats. (10 spell levels: Base 5, as per laming in table on ArM5, page 133, + 1 Touch)"
    }

    #tVEKjusrUz1zw0FwBNDSSXXn ^"Drain Energy" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Corpus R: Touch or Eye, D: Mom, T: Ind This power, similar to Invocation of Weariness, has either a Touch or Eye Range; it varies by cat. (15 spell levels: Base 10, +1 Touch or Eye)"
    }

    #tNsLoRQahl6mayn6vMaoMZ9a ^"Fear of the Mouse" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Mentem R: Eye, D: Sun T: Ind This power, similar to Panic of the Trembling Heart is often used to make people afraid of the cat. Many cats have alternative emotional effects. (15 spell levels: Base 4, +1 Eye, +2 Sun)"
    }

    #tbwYoxDfguY5nI4MSBt1dpTC ^"Feline Lullaby" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "or Keeping the Humans Safely Tucked Away, 2 points, Mentem R: Voice, D: Mom T: Ind This is a version of The Call to Slumber. (10 spell levels: Base 4, +2 Voice)"
    }

    #tMyCuWv1mIUoBuEmmw734pcb ^"Humans are Easily Misplaced" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "4 points, Corpus R: Arc, D: Conc, T: Ind A version of Inexorable Search. The maps cats use are a mixture of scents and textures, and make little sense to humans. This requires an Arcane Connection, so cats often scent–mark humans they wish to find again by rubbing on them. (20 spell levels: Base 3, +4 Arc, +1 Conc)"
    }

    #tZS1gNi9rUqFJD9ks3RVRGgA ^"Incredibly Cute" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Mentem R: Touch or Eye, D: Diam T: Ind This ability, similar to Trust of Childlike Faith allows the cat to become so endearing that it impairs the rationality of others. Some cats have an Eye contact version of this ability, while others have a Touch Ranged power, triggered by stroking the cat. (10 spell levels: Base 4, +1 Eye or Touch, +1 Diam)"
    }

    #txsaHkqvVNkn0ZXDY7js4t8w ^"Mackerel Sky" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "4 points, Auram R: Touch, D: Mom, T: Group A version of Sailor’s Foretaste of the Morrow. (20 spell levels: Base 4, + 1 Touch, +2 Group, +1 size)"
    }

    #tmNalgGghP3F4xz8F9T4Ca7G ^"Master of the Undergrowth" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Herbam R: Touch, D: Sun, T: Group A version of Intuition of the Forest. (10 spell levels: Base 1, +1 Touch, +2 Sun, +2 Group)"
    }

    #tWmmhHa0eLDGBfFxRiDa07yH ^"Minor Allergy" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Corpus R: Sight, D: Mom T: Ind A Sight Ranged version of Touch of the Goose Feather. (10 Spell levels: Base 3, +3 Sight)"
    }

    #tJyM1mKJlaIVZjlMOME5iqWa ^"Moving Objects with the Mind" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "6 points, Terram R: Sight, D: Conc T: Ind A Sight Ranged version of Unseen Arm, used by cats to manipulate objects — when humans are not available. (30 spell levels: Base 2, +3 Sight, +1 Conc)"
    }

    #tkw3uqsHejzZlBRHETNyzGEn ^"Pass the Unyielding Portal" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point; Herbam R: Touch, D: Diam, T: Ind A version of the spell of the same name, used when no humans are available to open doors. (5 spell levels: Base 3, +1 Touch +1 Diam.)"
    }

    #tvymSPKfvReSnPE1yStU2Ccf ^"Prison for Mice and Birds" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Animal R: Touch, D: Ring, T: Circle This is a version of Circle of Beast Warding. It is sometimes used in conjunction with the Greater Magical Powers, described below. (5 spell levels: Base 2, +1 Touch, +2 Ring)"
    }

    #tWax724AX1WVlkf3pPZ0RaME ^"Prying Eyes" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 71
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Imaginem R: Touch, D: Conc, T: Room This effect is used to look inside buildings and rooms while patrolling a house or town. Note that a cat touching the roof of a room can see inside it.. (5 spell levels: Base 1, +1 Touch, +1 Conc +2 Room)"
    }

    #tU4APuvagyzVQmojB7MXWCwX ^"Suck the Breath" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Corpus R: Eye or Touch, D: Mom, T: Ind The cat causes an asthma attack with the same effects as Grip of the Choking Hand but with either Eye or Touch range (choose when the cat is created.) (15 spell levels: Base 10, +1 Eye or Touch)"
    }

    #tJVwBQosvdKfmzNfbeZschxd ^"Suckle Cows Dry" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Animal R: Touch, D: Conc, T: Ind This power is used to make a cow lactate while a cat suckles from its udders. Cats filling themselves with milk often find it difficult to maintain concentration, so it is common to find cats working in groups, to restrain a cow in turns. (15 spell levels: Base 5, + 1 Touch, +1 Conc)"
    }

    #tVGtwJtm8OtBFM0mR5o8QLW7 ^"Suffocate the Dead" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Cost equals (Magnitude / 5), Mentem R: Voice, D: Mom, T: Ind Some cats can create an effect similar to Lay to Rest the Haunting Spirit by sitting or sleeping on the ghost’s grave. If several cats sleep on the same grave their Penetration scores are added together, and the highest level effect applies, so even powerful ghosts can be destroyed this way, with sufficient co-operation and persistence. This does not require Warder’s Walk, although no one is sure why. (Spell levels vary. Base Effect)"
        REFERENCES {
            "Warder’s Walk" -> #tyoHbToUzdO7epBYkwhoJFQe ^"Warder’s Walk"
        }
    }

    #t2VNodgpDquANqcshEbxgdQZ ^"Viper’s Gaze" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Animal R: Eye, D: Conc, T: Ind A variant of the spell of the same name, used to immobilize prey. (15 spell levels: Base 5, +1 Eye, +1 Concentration)"
    }

    #tBP7Oc7uoIvensx4wwasyeAS ^"Wake the Dead" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "4 points, Corpus R: Touch, D: Conc, T: Ind Some cats are able to animate corpses by leaping over them, a power similar to a Touch Ranged version of Awaken the Slumbering Corpse. Reports of this power are most common in Eastern Europe, and may refer to Infernally tainted cats. Some cats claim to be able to wake the dead with their nightly singing, but this may be a metaphor. (20 spell levels: Base 10, +1 Touch, +1 Conc)"
    }

    #tyoHbToUzdO7epBYkwhoJFQe ^"Warder’s Walk" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magnitude points, Vim. R: Voice, D: Mom, T: Group Cats in the Black Lineage use this power to combine their other powers. This allows their rituals to penetrate the Magic Resistance of creatures they wish to ward. It is a variant of Wizard’s Communion. Use of the Warder’s Walk is dangerous, as the addition of too many cats makes a fatal botch very likely, so the cats use this power sparingly. (Spell levels vary by base effect.)"
        REFERENCES {
            "Black Lineage" -> #tDJTpGMIKYHNiI28iJq6UPxr ^"Black Lineage"
            "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
            "Wizard’s Communion" -> #tdkgCSrZ0q9N4EKVLdhCIliQ ^"Wizard’s Communion"
        }
    }

    #tXakMJyPmu6M9ui8AEIAxMEV ^"Whispers Through the Black Gate" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Greater or Lesser Power)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "3 points, Corpus R: Touch, D: Conc, T: Ind The ability to talk to corpses is found most often in tortoiseshells. (15 spell levels: Base 5, +1 Touch, +1 Conc, no cost for requisite)"
    }

    #t45wKN6KEQWDJwplJA0RzMFV ^"Circular Ward Against Demons" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Black Cat Ward)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magnitude points, Vim R: Touch, T: Ring, D: Circle See ArM5, page 162 for a fuller description of this effect. (Spell levels vary by base spell)"
    }

    #tdeaVFv8tuxfNNZXDxUI45rb ^"Ward Against Beasts of Legend" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Black Cat Ward)" FIXED
            ^"Page" INTEGER 72
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magnitude points, Animal R: Touch, T: Ring, D: Circle See ArM5, page 120 for a fuller description of this effect. (Spell levels vary by base spell)"
    }

    #tvjCjrjaQ4RuIZHhvLqcM7rZ ^"Ward Against the Faeries of the Wood" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Black Cat Ward)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magnitude points, Herbam R: Touch, T: Ring, D: Circle See ArM5, page 138 for a fuller description of this effect. (Spell levels vary by base spell)"
    }

    #t3c18bDBcUwmI5ixg2k8vs9N ^"Ring of Warding Against Spirits" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Black Cat Ward)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magnitude points, Mentem R: Touch, T: Ring, D: Circle See ArM5, page 151 for a fuller description of this effect. (Spell levels vary by base spell) Cats with other wards that contain fire, protect from poor weather, and exclude crop rusts have also been frequently reported."
    }

    #tMA4lnB1TyUONB0YezDymuh7 ^"Cat Like a Shadow" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Init: Qik –1, Imaginem R: Per, D: Sun, T: Ind A personal version of Veil of Invisibility, as per ArM5, page 146. (15 spell levels: Base 4, +2 Sun, +1 changing image)"
    }

    #tDvCWnaElKSHUFKdLoEYvhlv ^"Felianthrope" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Init: Qik–1, Animal R: Per, D: Sun, T: Ind The cat takes human shape. This is a Personal version of The Beast Remade. (20 spell levels: Base 10, +2 Sun, no addition for requisite)"
    }

    #tVdhnhdwaHxtIti00xFPp4dq ^"Inconspicuousness" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Init: Qik–1, Imaginem R: Per, D: Sun, T: Ind A Personal version of Invisibility of the Standing Wizard (20 spell levels: Base 4, +2 Sun)"
    }

    #toKzhzDpFuiZsDKpOPKmstW6 ^"Puffed Up and Hissing" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Init: Qik–1, Animal R: Per, D: Sun, T: Ind The cat puffs itself up to fight, and magic grants it extra mass. A Personal version of Beast of Outlandish Size. (10 spell levels: Base 4, +2 Sun)"
    }

    #t1AOpjJyfvrXUww41ed3jAjF ^"Resistance to Claws" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 point, Init: Qik–1, Animal R: Per, D: Sun, T: Ind The cat’s coat becomes resistant to damage. A Personal version of Doublet of Impenetrable Silk (ArM5, page 118.) (10 spell levels: Base 4, +2 Sun)"
    }

    #t9BcufybfNBe7oIaD6Tw4lM4 ^"True Sight of the Air" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Init: Qik–1, Auram R: Per, D: Sun, T: Vision A version of the spell of the same name. (15 spell levels: Base 1, +2 Sun, +4 Vision)"
    }

    #tQKUk5Yp2GmpUqhCfX8eYw79 ^"Unmarked Passage" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Cat (Personal Power)" FIXED
            ^"Page" INTEGER 73
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "2 points, Init: Qik–1, Terram R: Touch, D: Sun, T: Ind A version of the spell Trackless Step. (20 spell levels: Base 4, +1 Touch, +2 Sun, +1 for constant effect)"
    }

    #te2tvXEzDTtQjBfjIYIvJokt ^"Decree of the Atlantean" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Atlantean" FIXED
            ^"Page" INTEGER 90
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "1 Point, Init: Qik+1, Animal R: Water-way, D: Conc, T: Ind The character may summon a creature of water within the same water-way (see Chapter 4: Characters, New and Modified Virtues, Atlantean Magic), and order it to perform a task. Dolphins are particularly eager to please Atlanteans and always attempt to obey a summons, even at considerable risk to themselves. Other water creatures will only obey a summons if a Presence + Leadership roll against an Ease Factor of 6 + Creature Size is successfully made. The power must also Penetrate the Magic Resistance of a Magical creature to be effective. The character can attempt to summon either a specific individual, or a type of creature, in which case the closest of that type responds. Of course, if the water creature is distant it may take a considerable period of time for it to swim to the character’s location. ReAn 10 (Base 2, +3 Water-way, +1 Conc): Greater Power (10 levels, 30 levels of Penetration, +2 Init)"
        REFERENCES {
            "Atlantean Magic" -> #tDYAofy6B5HFq4bAfTr6MDGj ^"Atlantean Magic"
            "Magic Resistance" -> #tlGQ74lDDi7aSQx6wD4ns0MO ^"Magic Resistance"
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #tjcrJXQcbYDF1brHO12CmRwl ^"Murmur of the Deep" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Atlantean" FIXED
            ^"Page" INTEGER 90
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "0 points, Init: Qik+1, Imaginem R: Water-way, D: Conc, T: Ind The character can hear from the vantage of any point in the same Water-way (see Chapter 4: Characters, New and Modified Virtues, Atlantean Magic). InIm 5 (Base 1, +3 Water-way, +1 Concentration): Greater Power (5 levels, –1 cost, 15 levels of Penetration, 15 xp in Concentration, +2 Init)"
        REFERENCES {
            "Atlantean Magic" -> #tDYAofy6B5HFq4bAfTr6MDGj ^"Atlantean Magic"
            "Greater Power" -> #tI9yiBqA2pLll1mfoJpQrwzX ^"Greater Power"
        }
    }

    #tjOLw7TVedhEUBdVbNv7WK7J ^"Endurance of the Flame Dancer" DEF {
        EXTENDS ^"Power"
        PROPERTIES {
            ^"Creature" STRING "Flame Dancer" FIXED
            ^"Page" INTEGER 91
            ^"Source" STRING "Realms of Power: Magic"
        }
