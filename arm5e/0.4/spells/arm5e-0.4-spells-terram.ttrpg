        }
        LEVEL_CALCULATION {
            BASE 2
            MODIFIERS {
            +2 "Voice"
            +2 "Sun"
            +1 "Part"
            +1 "size"
            }
        }
        DESCRIPTION "Weakens earth in a 15-pace-by-15-pace area, making packed dirt as loose as plowed ground."
    }

    #tZuFPoU3Dxp7R7G6PgIjyzj6 ^"Unyielding Earth" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Terram" FIXED
