EXTENSION "ArM5_Against_the_Dark_Core_Ext" {
    NAME "Ars Magica Fifth Edition, Against the Dark - core type extensions"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Core_Base"

    # Against the Dark is an EXTENSION on the arm5e edition (spec S13 composition). It defines no type of its
    # own: its oppida and characters are .actor files, its places LOCATIONs in its .setting, its records the corpus's types.

}
