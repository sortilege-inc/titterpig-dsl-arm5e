EXTENSION "ArM5_Against_the_Dark_Creatures_GeorgheAndLadislauAPairOfGiantBrothers" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Georghe and Ladislau, a Pair of Giant Brothers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # Georghe and Ladislau, a Pair of Giant Brothers (Chapter Eight: Creatures, p112): one being, its printed stat lines verbatim fields.

    #t84815d7999c855c5d0c812 ^"Georghe and Ladislau, a Pair of Giant Brothers" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 15
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 11
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER -5
            }
            ^"Size" INTEGER 4
            ^"Virtues and Flaws" STRING "Negative Reaction; Focus Power, Huge (x3); Humanoid Faerie; Incognizant, Traditional Ward (places)"
            ^"Soak" INTEGER 12
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "(Size +2) –1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Wound Penalties" STRING "(Size +4) –1 (1–9), –3 (10–18), –5 (19–27), Incapacitated (28–36), Dead (37+)"
            ^"Pretenses" STRING "Area Lore 2 (hidden pastures), Animal Handling 2 (draft horses), Ride 2 (charging), Single Weapon 6 (long sword), [Local] Living Language 4 (bragging)"
            ^"Equipment" STRING "Full chainmail, heater shield, long sword"
            ^"Vis" STRING "3 pawns of Corpus vis (each ear and nose)"
            ^"Appearance" STRING "The giant brothers look like a pair of local knights, magnified in size. Their armor is unadorned but well-kept."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 112
        }
        PERSONALITY_TRAITS {
            "Warlike" +3
            "Persistent" +2
        }
        COMBAT {
            "Long Sword & Heater Shield (on foot)" INIT -3 ATTACK 13 DEFENSE 6 DAMAGE 17
            " Long Sword & Heater Shield (on horseback)" INIT -3 ATTACK 15 DEFENSE 8 DAMAGE 17
            " Lance & Heater Shield (on horseback)" INIT -3 ATTACK 14 DEFENSE 4 DAMAGE 16
        }
        POWERS {
            #tf44d20d4ef2f21f0e1e639 ^"Shrinking (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Shrinking"
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "x"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The giant can shrink to Size +2 or grow to Size +4 in an instant. Cost: 20 spell levels (Base 3, +3 Size increase)"
            }
        }
        DESCRIPTION "Neighbors to their mother, Georghe and Ladislau have built adjacent homesteads that share a common border. Over the years, each has tried to push the fence that separates the two homesteads onto the other’s land, hoping that the other brother won’t notice. When he invariably does, the two come to blows. Because they are evenly matched, these quarrels can last for hours with neither gaining the upper hand.\n\nThe brothers’ farms are adjacent to a road. When the pair battle, they inevitably fight in the road, especially if one notices an approaching traveler. The battle will obstruct travel, and after a few minutes of traded blows, one of the giants asks the traveler to intervene, either to settle the disagreement between them or to pick up arms against the requestor’s brother."
    }

}
