    }

    #t69c751302ccdbf24f63767 ^"Hands of the Fiery Beast (dragon-born power)" DEF {
        EXTENDS #tL4MotIBVF5lx9HoVrT1yDlM ^"Power"
        PROPERTIES {
            ^"Printed Name" STRING "Hands of the Fiery Beast"
            ^"Creature" STRING "Dragon-born"
            ^"Group" STRING "Personal Power"
            ^"Range, Duration, Target" STRING "R: Per, D: Conc, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "The character can cause his hands to become so hot that they ignite held material and burn those he touches. Visually, the character’s hands glow as brightly as molten iron. It costs the character a Fatigue Level to use this power, which has a Penetration of 10.\n\n(Base 5, +1 Conc, +1 Part. Excess spell levels used for Penetration)"
    }

}
