            ^"Initiative" STRING "Init –4"
            ^"Form" STRING "Imaginem"
            ^"Printed Stat Line" STRING "Illusory Home, 4 points, Init –4, Imaginem"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Makes a place look, sound, smell, and feel like a suitable place for the faerie’s role."
    }

    #t5a75ce6916fe4b5dd2a2f1 ^"Kiss of the Mermaid (vila power)" DEF {
