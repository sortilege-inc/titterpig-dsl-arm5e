            ^"Might Cost" STRING "0 points, constant, Mentem"
            ^"Might Cost Value" INTEGER 0
            ^"Form" STRING "Mentem"
            ^"Printed Stat Line" STRING "Extend Glamor: 0 points, constant, Mentem"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "The faerie is aware of all activity in her place of power. The more powerful the faerie, the larger this area can be, and the more vis she can force it to produce each year, as per *Realms of Power: Faerie* page 61. This is a personal power."
    }

    #t97a32f6814a771b3284af6 ^"Transform Victim Into (animal) (vila power)" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
        PROPERTIES {
            ^"Printed Name" STRING "Transform Victim Into (animal)"
            ^"Creature" STRING "Vila"
            ^"Group" STRING "Woodland Maiden"
            ^"Might Cost" STRING "3 points, Init –3, Animal"
            ^"Might Cost Value" INTEGER 3
            ^"Initiative" STRING "Init –3"
            ^"Form" STRING "Animal"
            ^"Printed Stat Line" STRING "Transform Victim Into (animal): 3 points, Init –3, Animal"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Turns a character who can hear the voice of the vila into a specified animal for Sun duration. *Transform Victim into (object*): 5 points, Init –5, as per object: Turns character who can hear the vila’s voice into the specified object for Sun Duration. Some vilas instead have a version of this power with Touch Range and Until Duration. This version has the same cost and Initiative as earlier. Note that a faerie with extended glamour has extended Touch."
    }

