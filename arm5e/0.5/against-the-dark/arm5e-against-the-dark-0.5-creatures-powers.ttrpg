            ^"Printed Stat Line" STRING "Kiss of the Mermaid, 3 points, Init –3, Imaginem"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Allows the recipient of the kiss to breathe water until he or she next steps on dry land."
    }

    #t7cba3137058d1d11664f7f ^"Extend Glamor (vila power)" DEF {
        EXTENDS #t84d15c61569668f6f97c5a ^"Faerie Power"
