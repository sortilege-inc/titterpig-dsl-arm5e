EXTENSION "ArM5_Against_the_Dark_Creatures_VampireSnake" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Vampire Snake"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # Vampire Snake (Chapter Eight: Creatures, p119): one being, its printed stat lines verbatim fields.

    #tfd35528f2907e51e72f3e5 ^"Vampire Snake" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 5
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -1
                ^"Perception" INTEGER -2
                ^"Presence" INTEGER -5
                ^"Communication" INTEGER -6
                ^"Strength" INTEGER -6
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER -3
            ^"Virtues and Flaws" STRING "Faerie Beast, Feast of the Dead, Lightning Reflexes; Incognizant, Negative Reaction, Traditional Ward (sunlight)"
            ^"Combat" STRING "Fangs: Init +2, Attack +10, Defense +8, Damage –5 +6 to Defense against grapple attacks"
            ^"Soak" INTEGER 0
            ^"Wound Penalties" STRING "–1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
            ^"Pretenses" STRING "Awareness 2 (prey), Brawl 4 (fangs), Hunt 4 (rodents), Stealth 4 (stalking prey), Survival 3 (grassy areas)"
            ^"Vis" STRING "1 pawn of Animal, in tongue"
            ^"Appearance" STRING "A remarkably large snake, easily two paces long and as thick as a man’s thigh; the vampire snake has red eyes."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 119
        }
        PERSONALITY_TRAITS {
            "Hostile" +2
        }
        POWERS {
            #t60882d950b674dd77deab4 ^"Sap the Life" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "Qik – 3"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See earlier for details; except that the vampire snake’s touch inflicts a Medium Wound. PeCo 20 (Base 15, +1 Touch) Lesser Power (20 levels, –1 Might cost)"
            }
        }
        DESCRIPTION "The vampire snake has 3 points of Virtues and 3 points of Flaws."
    }

}
