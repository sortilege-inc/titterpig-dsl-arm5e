EXTENSION "ArM5_Against_the_Dark_HedgeTraditions_InitiationScripts" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Nine: Hedge Traditions initiation scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # The chapter's initiation scripts, structured; each DESCRIPTION the source's text, verbatim.

    #t84adc39a717b2c9968bed1 ^"Heart of the Storm Initiation" DEF {
        EXTENDS #tMCInitiationScriptTypeAAAA ^"Initiation Script"
        PROPERTIES {
            ^"Ease Factor" STRING "21"
            ^"Script Bonus" STRING "+15"
            ^"Initiation Total" STRING "Presence + Organization Lore: Storm Wizards + Script Bonus"
            ^"Grants" STRING "Giant Blood Major Virtue"
            ^"Mystery" STRING "Storm wizards"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The storm wizard initiate gains Giant Blood Major Virtue. **Initiation Ease Factor: **21 **Initiation Total: **Presence + Organization\n\nLore: Storm Wizards + Script Bonus **Script Bonus:** +15 (+3 Quest, Hunt and eat the heart of a giant; +9 Major Ordeal, Gain Feud (Giant Tribe) Major Flaw; +3 Sympathetic Bonus)"
    }

}
