    # Thietmar (Chapter Nine: Hedge Traditions, p126): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t2dd78899155774f5bcec05 ^"Thietmar" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per +1, Pre 0, Com 0, Str +3, Sta +3, Dex 0, Qik 0"
            ^"Size" STRING "+2"
            ^"Age" STRING "37 (37)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (4)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Storm Wizard; Giant Blood; Personal Vis Source (ice cave), Puissant Ability (Storm Calling), Tough; Feud (Giant Tribe); Reclusive, Visions, Weird Magic."
            ^"Personality Traits" STRING "Reclusive +3, Persistent +2"
            ^"Reputations" STRING "Storm wizard living in caves above the snow line 4 (local)"
            ^"Combat" STRING "Dodge: Init 0, Attack n/a, Defense +2, Damage n/a Fist: Init 0, Attack +3, Defense +3, Damage +3 Knife: Init 0, Attack +3, Defense +2, Damage +5"
            ^"Soak" STRING "+7 (+3 Tough, +3 Sta, +1 hide clothing)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Abilities" STRING "Area Lore: Mountain 4 (Magical Sites), Athletics 2 (Running), Awareness 2 (Ambush), Brawl 2 (Fist), Folk Ken 1 (Storm Wizards), Hunt 2 (Giants), Native Language 5 (Peasant), Organization Lore: Storm Wizards 5 (Ice Harvesting), Penetration 2 (Storm Fighting), Stealth 3 (Forest), Storm Calling 5+2 (Storm Moving), Storm Fighting 5 (Attacking Giants), Storm Riding 5 (Travelling (Self)), Survival 4 (Mountains), Swim 2 (Rivers)"
            ^"Equipment" STRING "Warm fur and hide clothes, magic ice in satchel (6 pawns), knife."
            ^"Appearance" STRING "The storm wizard Thietmar is a tall, shy man. He hides his face deep within a wild, unkempt beard, and he dresses in fetid, poorly cured, ice-jeweled furs and hides. He has an uneasy relationship built on mutual fear and distrust with the villagers scattered about the foot of the mountain. Thietmar and the villagers have arrived at a complex routine of caches and paths, whereby they leave “gifts” of food for him, and he moves storms away from their settlements, all without needing to meet."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 126
        }
