EXTENSION "ArM5_Against_the_Dark_HermeticCulture_JuturnusOfTremere" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Juturnus of Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # Juturnus of Tremere (Chapter Two: Hermetic Culture, p28): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #td3aabfac5d40009e848503 ^"Juturnus of Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tc8accbf3f145108f6a3575 ^"Coeris (Against the Dark)"]
            ^"Age" STRING "45"
            ^"Personality Traits" STRING "Cocksure +3, Eloquent +2. Prefers Rego, some Perdo and Intellego, Animal and Terram. Juturnus is sent to clarify faults in the operations of the House. That is, when something goes wrong and Horatius can’t figure out why, he sends Juturnus to assess things and then fix them. Cocky, skillful, and decisively violent, Juturnus doesn’t act a lot like a bureaucratic Tremere, and has perhaps risen too quickly to his position. His sigil is that small objects near him rearrange themselves into geometric shapes. Juturnus is black, and has the athletic build common to Tremere magi. A few decades ago, one of the Primi encouraged the Redcaps to find gifted Arabic and African children for his sodales to raise. He believed this would enable them to work in Arabic lands less conspicuously than magi of Hungarian stock. Nothing substantial came of this, but it does add some randomness to the race of the House’s members. Like many of these children, he was trained as an Assessor (a sort of spy) initially, although he has more eclectic training now."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 28
        }
    }

}
