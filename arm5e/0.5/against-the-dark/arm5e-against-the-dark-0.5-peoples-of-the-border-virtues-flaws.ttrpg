EXTENSION "ArM5_Against_the_Dark_PeoplesOfTheBorder_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Six: Peoples of the Transylvanian Border virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t0b6831e8d2d9a3843ded9b ^"Brother Chaplain (Against the Dark)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Brother Chaplain"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "The character is a priest of the Teutonic Order, which is like other priests except that the required Vow includes obedience and poverty, in addition to chastity. Outside of the Teutonic Order he is answerable only to the pope. He may purchase Academic Abilities during character generation. He wears the black cross of the Teutonic Order on a green surcoat. This Virtue is only available to male characters."
    }

    #tfa6050dfc84b0f6d8d3f3d ^"Brother Knight (Against the Dark)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Brother Knight"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "The character is a knight of the Teutonic Order, and it is his duty to be ready to fight infidels and pagans at any time. He has sworn a lifelong vow of obedience, poverty, and chastity, and is answerable only to his superiors and the pope. Unless he is Poor, he may have expensive weapons and armor, and two horses. He may take Academic and Martial Abilities during character generation. He wears the black cross of the Teutonic Order on a white mantle. This Virtue is only available to male characters."
    }

    #tc954c38f987f80a0f8df36 ^"Brother Sergeant (Against the Dark)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Brother Sergeant"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "The character is a member of the Teutonic Order, but not a knight or nobleman. He has sworn a vow (which may be lifelong or twenty years) of obedience, poverty, and chastity, but this may not be enforced as strictly for him as it would be for a brother knight. He is answerable only to his superiors and the pope. He may be a clerk or physician, in which case he can take Academic Abilities during character generation. Alternatively, he may be a man-at-arms, and can take Martial Abilities during character generation. Unless he is Poor, he may have superior equipment appropriate to his role; for a man-at-arms this means high-quality weapons and armor, and a horse. He wears the black cross of the Teutonic Order on a gray surcoat. This Virtue is only available to male characters."
    }

}
