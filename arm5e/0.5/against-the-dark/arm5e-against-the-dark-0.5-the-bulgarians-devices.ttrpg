EXTENSION "ArM5_Against_the_Dark_TheBulgarians_Devices" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Four: The Bulgarians devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t74fef008c9035e5dae76eb ^"Everbright Chandelier" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun; +4 constant effect)"
            ^"Printed Effect Line" STRING "CrIg 24 Pen +0, constant effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "The chandeliers in the exhibits are enchanted items that continuously create bright light.\n\nThe light appears to emanate from lit candles, but there is no actual flame. Thus, there is no danger of the chandeliers igniting flammable exhibits."
    }

}
