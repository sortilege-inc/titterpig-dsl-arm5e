EXTENSION "ArM5_Against_the_Dark_TheBulgarians_YekaterinaOfHouseTremere" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Yekaterina of House Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Against_the_Dark_Core_Ext"

    # Yekaterina of House Tremere (Chapter Four: The Bulgarians, p52): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tfa62c80b6eff4ce52bbb3c ^"Yekaterina of House Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tb241ebf352d5e6224bbaef ^"Evredika"]
            ^"Age" STRING "48 (apparent age 32)"
            ^"Personality Traits" STRING "Tenacious +2, Morbid +1, Passionate –2. Privilege: Cives Yekatarina is the latest in a series of aediles to Evredika. Oeagrus usually manages to alienate “the Tremere overseer” (as he calls them) sufficiently that they request redeployment after a decade or so. He considers Yekaterina a double insult by the House, due to his well-known antipathy for women. Despite these adversities, Yekaterina is (for the moment) determined to stay. From the relative isolation of her sanctum in the Devil’s Throat, she has been able to expand her knowledge of necromancy. Yekaterina is slim and blond, and typically wears a mask made from a skull that she has begun to make into her talisman."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 52
        }
    }

}
