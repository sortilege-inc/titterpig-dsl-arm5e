EXTENSION "ArM5_Ancient_Magic_CanaaniteNecromancy_Devices" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Two: Canaanite Necromancy devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tafebe2fadc247895421588 ^"Zephaniah’s Brazier" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Veil"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "InMe 15 Pen +0, 1/day R: Veil, D: Mom, T: Ind"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This brazier is a copper dish about five inches in diameter. The color of the smoke in the brazier can be used to determine whether an individual is dead. To use the brazier it is lit, and the name of the target is spoken into the white smoke spiraling upwards from the dish. If the individual is dead, the smoke changes, becoming acrid and purple in color. The brazier may be used once per day.\n\n(Effect: Base 4, +3 Veil)"
    }

    #t98816ec85fae4a7a77cb90 ^"Mot’s Hand" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 37
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Veil"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReMe 37 Pen +20, 3/day R: Veil, D: Diam, T: Ind"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This item is a skeletal marionette-type puppet about one foot tall, and by manipulating the puppet the puppeteer may direct the actions of the closest ghost. As this effect has a Range of Veil of Death there is always a ghost in range, although of course, unforeseen consequences may result if the manipulated ghost is not within the sight of the puppeteer. The effect can only penetrate a Might of 19, so ghosts that are more powerful are unaffected.\n\nGross movements of the ghost (stop, move left, etc.) are controlled without a roll. A stress roll of Dexterity + Profession Puppeteer must be made against an Ease Factor of 9 to direct the movements of the ghost more carefully (to move through a doorway or up stairs, for example). To attempt very precise movements (to write or fight, for example) a stress roll of Dexterity + Profession Puppeteer against an Ease Factor of 12 must be made.\n\n(Effect: Base 5, + 3 Veil, +1 Diam; Modifications: +10 Pen, +2 3/day)"
    }

}
