EXTENSION "ArM5_Ancient_Magic_DefixioMagic_Spells" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Three: Defixio Magic spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tae3c68aeb07eb35c6acb3a ^"Call to Arms" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Event (Mom)"
            ^"Target" STRING "Room"
            ^"Requisite" STRING "Intellego, Corpus"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Re(In)Me(Co) 35 R: Arc, D: Event (Mom), T: Room, Ritual"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "This Ritual wakes all of the grogs (or any other predefined group) in one room of the covenant if the condition described at the time of casting occurs within the walls of the covenant.\n\n(Base 4, +4 Arc, +1 Event [Mom], +2 Room)\n\n*Darius wants to set a trap for anyone who might try to assassinate him in his sleep. He decides to cast a Perdo Corpus Ritual that wounds anyone who enters his sanctum and was not present at the casting of the spell. Because the triggering condition and the Form of the spell are both Corpus, no requisite is required. If Darius had created a spell that was triggered by the target’s intentions, it would have needed a Mentem requisite.*"
    }

    #tabd94ffcf065e506931e93 ^"Trap for the Thief in the Night" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Event (Mom)"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Intellego"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Pe(In)Co 25 R: Voice, D: Event (Mom), T: Ind, Ritual"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Inflicts a Medium Wound on any person who meets the definition of the target determined at the time of casting and who comes within the range of the casting point.\n\n(Base 10, +2 Voice, +1 Event [Mom])\n\n*Although a spell with Duration Event is a continuous magical effect, it is not generally cast on anything until it takes effect, and thus does not cause Warping. On the other hand, it cannot move.*"
    }

    #te8beb21a5f1002da84be3e ^"Draw on Diana’s Hounds" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Unlimited"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "InCo 30 R: Unlimited, D: Conc, T: Ind, Ritual"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Locates any person named in the Ritual on a map. Before the Ritual begins, the caster must create a figurine of the target of the spell. The caster then places the figurine on a map. At the completion of the Ritual, the figurine moves toward the person’s location at the rate of one inch per minute. When the figurine reaches the location, it spins rapidly. The target is located somewhere within the area covered by the spinning figurine. If the quarry’s location is not on the map used, the figurine does not move.\n\nAlthough only one map is required to cast the spell, multiple maps of various scales provide the best results. A character may draw a map for use in the spell with a successful Dexterity + Area Lore roll against an Ease Factor of 6. If the roll is unsuccessful, the figurine does not move. The figurine is the focus of the spell and, as long as the magus maintains concentration, the figurine may be placed on any number of maps.\n\nA Dexterity + Craft roll of 9 is required to create the figurine depicting the quarry. The figurine created is approximately three inches tall. To determine the location of the target more precisely, the caster may create a smaller figurine. For each halving of the size of the figurine, increase the Ease Factor by 3.\n\n(Base 3, +6 Unlimited, +1 Conc)\n\n*Darius wants to create a spell that replicates *The Leap of Homecoming*, but allows the caster to travel anywhere. Because the range for the base spell is Personal, but it requires an Arcane Connection, the Unlimited Range Breakthrough allows the Arcane Connection to be replaced by a +2 sympathetic connection and adds +2 magnitudes to the final level of the spell.*"
    }

    #t9585b089c9b6c77523cce8 ^"Passage to the Place Pictured" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReCo 45 R: Per, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "This spell transports the caster anywhere. As part of the Ritual, the caster must paint or draw a picture of the location to which he wishes to travel. If the player succeeds in making a Dexterity + Craft roll of 9 and the spell is cast successfully, the magus is transported to the site depicted. If the roll is botched the character may be transported to the location but buried in a wall, be sent to a place that merely resembles the intended location, or be sent to a Faerie regio.\n\n(Base 35 with Arc, +2 Unlimited)"
    }

    #tf115710f7df6a4f5a4aee8 ^"See the Spirits of the Night" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InMe 30 R: Per, D: Conc, T: Vision"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "The caster is able to see Mentembased spirits (ghosts) that are normally invisible to the living. For spirits that are not in close proximity to the caster, a successful Perception roll may be required to locate them. For example, ghosts hidden behind intervening walls are not visible, and a ghost amid a large crowd may not be immediately obvious. This spell does not allow the caster to communicate with the dead, only to see a ghost. This spell must penetrate the Magic Resistance of the invisible ghost to be successful.\n\n(New Base 5 [Sense any Mentem spirit], +1 Conc, +4 Vision)"
    }

}
