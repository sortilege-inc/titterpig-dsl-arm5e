EXTENSION "ArM5_Ancient_Magic_FertilityMagic_Tables" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Four: Fertility Magic tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t35d032f4d88e9535a65f29 ^"Fertility Ritual Traits" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Trait", "Trait Point Cost"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 57
        }
        TABLE {
            "Major Virtue or Flaw" "3"
            "Minor Virtue or Flaw" "1"
            "The Gift" "3"
            "Specify gender" "1"
            "Specify other general features (e.g., red hair, green eyes)" "1"
            "Specify precise features (e.g., child’s features are those of the king of France)" "3"
        }
    }

}
