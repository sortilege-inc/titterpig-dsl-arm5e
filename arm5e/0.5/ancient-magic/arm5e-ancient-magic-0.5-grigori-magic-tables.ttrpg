EXTENSION "ArM5_Ancient_Magic_GrigoriMagic_Tables" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Five: Grigori Magic tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t43fe186b2779a79168278d ^"Secrets of the Chiefs of Ten" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Watcher", "Arts"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the box it stands in"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 67
        }
        TABLE {
            "Araqiel" "Creo, Terram, Corpus"
            "Armaros" "Rego, Imaginem, Vim"
            "Azael" "Perdo, Terram, Imaginem"
            "Baraqijal & Kokabel" "Intellego, Mentem, Imaginem"
            "Ezeqeel" "Muto, Aquam, Auram"
            "Sariel" "Perdo, Mentem, Ignem"
            "Semyaza" "Creo, Corpus, Herbam"
            "Shamsiel" "Rego, Ignem, Vim"
        }
    }

}
