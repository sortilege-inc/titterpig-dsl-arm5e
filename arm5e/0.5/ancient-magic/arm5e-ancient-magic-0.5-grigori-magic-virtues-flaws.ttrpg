EXTENSION "ArM5_Ancient_Magic_GrigoriMagic_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Five: Grigori Magic virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #tb70aa280ff268595434505 ^"Araquiel’s Secret" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural (Divine)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Some say that what the Grigori taught their students was the basis of Hermetic magic. Sadly, as there are no living practitioners of these arts, it is difficult to say with certainty. There are definitely links between the two, however, as this Virtue demonstrates. Araquiel’s Secret allows anyone who possesses it and who can use the Arts of Creo, Corpus, and Terram to use vis for any of these Arts interchangeably. When using vis in this way in either a Divine or Infernal aura, however, the wielder must roll double the usual number of botch dice. Araquiel’s Secret also allows the possessor to ignore Creo, Corpus, or Terram requisites for any spell that uses another of these three Arts."
    }

    #tb7253a73ed7fcea22defe6 ^"Araquiel’s Legacy" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Any magus who possess this Virtue may used Creo, Corpus, and Herbam vis interchangeably. Araquiel’s Legacy also allows the possessor to ignore Creo, Corpus, or Terram requisites for any spell that uses another of these three Arts."
    }

}
