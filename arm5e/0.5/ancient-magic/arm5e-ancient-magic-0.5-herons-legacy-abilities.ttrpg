EXTENSION "ArM5_Ancient_Magic_HeronsLegacy_Abilities" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Six: Heron of Alexandria’s Legacy abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #tda990424b7c21dd8cdc181 ^"Mechanica of Heron (Ability)" DEF {
        EXTENDS #tWPnyoi9rSMWyMo7Njlo9XM2 ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Ability Mechanica of Heron"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Specialties" LIST OF STRING ["Inventing Mechanica", "Constructing Anima", "working with a particular material"]
            ^"Printed Specialties" STRING "Specialties: Inventing Mechanica, Constructing Anima, working with a particular material. (Supernatural)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "Knowledge of what mechanica are, how to construct them, and how to use them. Primarily used in the laboratory to construct mechanica (see above)."
    }

}
