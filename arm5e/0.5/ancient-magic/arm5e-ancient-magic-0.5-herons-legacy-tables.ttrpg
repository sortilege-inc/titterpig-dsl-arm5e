EXTENSION "ArM5_Ancient_Magic_HeronsLegacy_Tables" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Six: Heron of Alexandria’s Legacy tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tf45e204642990ad2ccf05b ^"Mechanica Creation Level Modifiers" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Modifier", "Effect"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 77
        }
        TABLE {
            "Wagon- or boat-sized" "–3"
            "Easily carried" "+3"
            "Hand-sized" "+6"
            "Additional time to employ" "–3"
        }
    }

}
