EXTENSION "ArM5_Ancient_Magic_HyperboreanMagic_Parameters" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Eight: Hyperborean Magic parameters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's parameters, structured; each DESCRIPTION the source's text, verbatim.

    #te0ea2cdb9ac3fab93469a4 ^"19 Years (Duration)" DEF {
        EXTENDS #tcff0104e131e6468aca4da ^"Spell Parameter"
        PROPERTIES {
            ^"Printed Name" STRING "New Duration: 19 Years"
            ^"Parameter" STRING "Duration" FIXED
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "*It is also said that . . . Apollo visits the island of Hyperborea once in the course of nineteen years, in which period the stars complete their revolutions, and that for this reason the Greeks distinguish the cycle of nineteen years by the name of “the great year.”*\n\n— Hecataeus of Abdera,\n\n*Peri Hyperboreon*\n\nThe power or spell lasts for 19 years, or until the stars complete their 19-year revolution, whichever is the lesser. Some understanding of astrology (Artes Liberales) is required to know the positions and revolutions of the stars. This Duration is one magnitude higher than Year Duration."
    }

}
