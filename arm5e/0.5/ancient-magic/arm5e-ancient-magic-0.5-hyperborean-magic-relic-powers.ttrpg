    #te99564348e7a3f46eba08c ^"Sight of the Pythian Oracle" DEF {
        EXTENDS #t73d2fb798f0fdc97ad886c ^"Relic Power"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2 uses/day, constant effect"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Hymn" STRING "Iaó"
            ^"Principle" STRING "Sight"
            ^"Effect Design" STRING "(Base 2, +4 Arc, +2 Sun, +2 Room, +1 level uses/day, +3 levels constant effect)"
            ^"Printed Effect Line" STRING "InIm 34 Pen +0, 2 uses/day, constant effect R: Arc, D: Sun, T: Room"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "A variation of the Hermetic spell, *Summoning the Distant Image*. The user of this Power must possess an Arcane Connection to the place she wishes to see."
    }

    #t5590b24e324b7cf7f7bb78 ^"Apollonian Prayer of Chryses" DEF {
        EXTENDS #t73d2fb798f0fdc97ad886c ^"Relic Power"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 80
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "1 use/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Bound"
            ^"Hymn" STRING "Iaó"
            ^"Principle" STRING "Disease"
            ^"Effect Design" STRING "(Base 20, +4 Arc, +4 Bound, +1 additional effect, +10 levels Penetration)"
            ^"Printed Effect Line" STRING "PeCo 80 Pen +20, 1 use/day R: Arc, D: Mom, T: Bound"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Chryses was a priest of Apollo whose daughter was enslaved by the Greek king Agamemnon during the Trojan War. When Agamemnon refused to return the priest’s daughter, Apollo punished the Greek army by raining down plague arrows. This Power’s effect is as the Hermetic spell, *Curse of the Unportended Plague*. The user of this Power must possess an Arcane Connection to the place she wishes to inflict the plague upon. The user may also invoke this Power if she can see the target, such as through using the Power *Sight of the Pythian Oracle*."
    }

}
