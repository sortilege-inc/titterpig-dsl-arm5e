EXTENSION "ArM5_Ancient_Magic_HyperboreanMagic_RelicPowers" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Eight: Hyperborean Magic relic powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's relic powers, structured; each DESCRIPTION the source's text, verbatim.

    #t6a6d928488d6911c29f9a9 ^"Protection of the Bright Lightener" DEF {
        EXTENDS #t73d2fb798f0fdc97ad886c ^"Relic Power"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 64
            ^"Requisite" STRING "Intellego, Animal, Mentem"
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "2 uses/day, constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Hymn" STRING "Azai"
            ^"Principle" STRING "Defence"
            ^"Effect Design" STRING "(Base Gen 20, +1 Touch, +2 Sun, +3 requisites, +1 level uses/day, +10 levels Penetration, +3 levels environmental trigger)"
            ^"Printed Effect Line" STRING "Re(In)Co(An, Me) 64 Pen +20, 2 uses/day, constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This Power prevents creatures with ill intent from touching or otherwise damaging the relic, in particular creatures associated with the Infernal realm that have an Infernal Might of 20 or less. This also affects humans and animals without a Might score."
    }

