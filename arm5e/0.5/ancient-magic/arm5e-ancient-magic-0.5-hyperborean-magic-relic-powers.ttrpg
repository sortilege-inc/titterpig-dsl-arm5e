            ^"Hymn" STRING "Semesilam"
            ^"Principle" STRING "Good health"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +3 levels uses/day)"
            ^"Printed Effect Line" STRING "CrCo 23 Pen +0, 6 uses/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Ancient Magic"
