EXTENSION "ArM5_Ancient_Magic_Introduction_Rules" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Introduction rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t398b08635eb32a1a29eef3 ^"Chapter 1" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "How to Use This Book"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 5
        }
        FORMULAS {
            "Chapter 1" "The Language of"
        }
    }

    #tb8fc427e02fe985df24d05 ^"Chapter 4" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Chapter"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 6
        }
        FORMULAS {
            "Chapter 4" "Fertility Magic."
        }
    }

    #tf27e0b39b021433d4faaf1 ^"Chapter 7" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Chapter"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 6
        }
        FORMULAS {
            "Chapter 7" "The Hesperides."
        }
    }

}
