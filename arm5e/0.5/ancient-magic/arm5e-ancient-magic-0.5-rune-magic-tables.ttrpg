EXTENSION "ArM5_Ancient_Magic_RuneMagic_Tables" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Nine: Rune Magic tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tfce0157a9ad8e635c886b4 ^"Hermetic Rune Magic Variation Modifiers" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Variation", "Modifier"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 140
        }
        TABLE {
            "Hidden name" "–2"
            "No name" "–5"
            "Hidden description" "–5"
            "No description" "–10"
            "Extra effort" "+1"
            "Emphasis" "+1"
        }
    }

    #t87db0563dd695ce79de3e5 ^"The Elder Futhark (Ancient Magic)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Letter", "Rune", "Name", "Pronounced", "Meaning"]
            ^"Printed Name" STRING "The Elder Futhark"
            ^"Rune Glyph Source" STRING "the book prints each rune as a glyph of a rune font, which its text layer carries as a font code; recorded here as the Unicode runic letter named for the row's printed rune name (the Younger Futhark in its long-branch forms)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 142
        }
        TABLE {
            "F" "ᚠ" "Fehu" "FAY-hoo" "Wealth"
            "U" "ᚢ" "Uruz" "oo-ROOZ" "Auroch"
            "TH" "ᚦ" "Thurisaz" "THUR-ee-sahz" "Ogre"
            "A" "ᚨ" "Ansuz" "AN-sooz" "Mouth"
            "R" "ᚱ" "Raido" "RYE-doh" "Riding"
            "K" "ᚲ" "Kauno" "COW-noh" "Pain"
            "G" "ᚷ" "Gebo" "GHAY-boh" "Gift"
            "W" "ᚹ" "Wunjo" "VUN-yoh" "Joy"
            "H" "ᚺ" "Hagalaz" "HAH-ghah-lahz" "Hail"
            "N" "ᚾ" "Naudhiz" "NOW-thiz" "Need"
            "I" "ᛁ" "Isa" "EE-sah" "Ice"
            "J" "ᛃ" "Jera" "YEH-rah" "Year"
            "Y" "ᛇ" "Ihwaz" "EYE-vaz" "Yew"
            "P" "ᛈ" "Perth" "PAIR-th" "Cup"
            "Z" "ᛉ" "Algiz" "AL-gheez" "Elk"
            "S" "ᛊ" "Sowilo" "SOH-veel-oh" "Sun"
            "T" "ᛏ" "Tiwaz" "TEE-vahz" "Tyr"
            "B" "ᛒ" "Berkanan" "BARE-kan-ahn" "Birch"
            "E" "ᛖ" "Ehwaz" "AY-vahz" "Horse"
            "M" "ᛗ" "Mannaz" "MAH-nahz" "Man"
            "L" "ᛚ" "Laguz" "LAH-ghooz" "Water"
            "NG" "ᛜ" "Ingwaz" "ING-vahz" "Lord"
            "D" "ᛞ" "Dagaz" "DHAH-ghaz" "Day"
            "O" "ᛟ" "Othila" "OH-thi-lah" "Inheritance"
        }
        DESCRIPTION "The oldest version of the runes is called the Elder *futhark *(the word *futhark* refers to the first six letters in the alphabet), and was known to the rune wizards of Scandinavia and Iceland. Since it is believed to comprise the original runes that were taught by Odin to his followers, it is considered to represent rune magic in its purest form. It consists of 24 letters, broken up into three *aetts *(“eights”) of eight letters each."
    }

    #t9f97f865c8f9ab56318119 ^"The Younger Futhark (Ancient Magic)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Letter", "Rune", "Name", "Pronounced", "Meaning"]
            ^"Printed Name" STRING "The Younger Futhark"
            ^"Rune Glyph Source" STRING "the book prints each rune as a glyph of a rune font, which its text layer carries as a font code; recorded here as the Unicode runic letter named for the row's printed rune name (the Younger Futhark in its long-branch forms)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 142
        }
        TABLE {
            "F" "ᚠ" "Fe" "FAY" "Wealth"
            "U" "ᚢ" "Ur" "OOR" "Drizzle"
            "TH" "ᚦ" "Thurs" "THURZ" "Ogre"
            "A" "ᚬ" "Ass" "AHSS" "God"
            "R" "ᚱ" "Reidh" "RAYTH" "Ride"
            "K" "ᚴ" "Kaun" "COWN" "Sore"
            "H" "ᚼ" "Hagall" "HAH-gall" "Hail"
            "N" "ᚾ" "Naudhr" "NOW-thur" "Need"
            "I" "ᛁ" "Iss" "EES" "Ice"
            "J" "ᛅ" "Ar" "AHR" "Year"
            "S" "ᛋ" "Sol" "SOHL" "Sun"
            "T" "ᛏ" "Tyr" "TEER" "Tyr"
            "B" "ᛒ" "Bjarkan" "BYAR-kahn" "Birch"
            "M" "ᛘ" "Madhr" "mah-THUR" "Man"
            "L" "ᛚ" "Logr" "lah-GHUR" "Water"
            "Y" "ᛦ" "Yr" "EAR" "Yew"
        }
        DESCRIPTION "In Denmark and Germany, the *futhark* began to develop over time as it was used to communicate as well as work magic. Many of the names of the runes and their meanings changed as the language became more compact, and the runemasters began using fewer characters, eventually settling on a set of 16 runes instead of the original 24. Instead of three *aetts* made up of eight runes, in this system the first *aett* had six runes and the other two had five. This variation came to be known as the Younger *futhark*."
    }

    #t7966fd1a8a6821421e7dc6 ^"The Anglo-Saxon Futhorc (Ancient Magic)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Letter", "Rune", "Name", "Pronounced", "Meaning"]
            ^"Printed Name" STRING "The Anglo-Saxon Futhorc"
            ^"Rune Glyph Source" STRING "the book prints each rune as a glyph of a rune font, which its text layer carries as a font code; recorded here as the Unicode runic letter named for the row's printed rune name (the Younger Futhark in its long-branch forms)"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 143
        }
        TABLE {
            "F" "ᚠ" "Feoh" "FAY-oh" "Wealth"
            "U" "ᚢ" "Ur" "OOR" "Auroch"
            "TH" "ᚦ" "Thorn" "THORN" "Thorn"
            "O" "ᚩ" "Os" "OH-ss" "Mouth"
            "R" "ᚱ" "Rad" "RAYD" "Riding"
            "C" "ᚳ" "Cen" "KEEN" "Torch"
            "G" "ᚷ" "Gyfu" "GUY-foo" "Gift"
            "W" "ᚹ" "Wynn" "WIN" "Joy"
            "H" "ᚻ" "Haegl" "HIGH-gull" "Hail"
            "N" "ᚾ" "Nyd" "NID" "Need"
            "I" "ᛁ" "Is" "EYE-ss" "Ice"
            "J" "ᛄ" "Ger" "GEAR" "Year"
            "Y" "ᛇ" "Eoh" "EE-oh" "Yew"
            "P" "ᛈ" "Peordh" "POHR-th" "Cup"
            "X" "ᛉ" "Eolhx" "OHLHK" "Elk"
            "S" "ᛋ" "Sigel" "SIGH-gel" "Sun"
            "T" "ᛏ" "Tir" "TIRE" "Star"
            "B" "ᛒ" "Beorc" "BORK" "Birch"
            "E" "ᛖ" "Eh" "EH" "Horse"
            "M" "ᛗ" "Mann" "MAHN" "Man"
            "L" "ᛚ" "Lagu" "LAH-guh" "Water"
            "NG" "ᛝ" "Ing" "ING" "Hero"
            "D" "ᛞ" "Daeg" "DYE-gh" "Day"
            "OE" "ᛟ" "Ethel" "EE-thell" "Homeland"
            "A" "ᚪ" "Ac" "ACHE" "Oak"
            "AE" "ᚫ" "Aesc" "EYE-sk" "Ash"
            "YR" "ᚣ" "Yr" "EAR" "Bow"
            "EA" "ᛠ" "Ear" "YAHR" "Grave"
        }
        DESCRIPTION "In England, the rune wizards instead expanded their alphabet, eventually adding more runes and altering the meaning of many of the others, producing a very different set of runes, called the *futhorc*. Scholars agree that it included these 28 runes, though there are several other letters that may also have been included."
    }

}
