EXTENSION "ArM5_Ancient_Magic_TheHesperides_Spells" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Seven: The Hesperides spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Ancient_Magic_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #te30d1b29848d5e49360611 ^"A Comparison of the Positions of the Fixed Stars" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InVi 25 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This spell charts the course of the light emanating from the fixed stars. It then compares the angles between these lines, to provide a unique pair of numbers, representing the array. This is the Ptolemaic coordinate for the caster’s position, provided that the caster knows the array at origin. A magus is unable to hold coordinates in her mind with sufficient precision to represent a circle less than 500 paces across. Notebooks or devices with coordinates in them allow greater precision.\n\n(Base 10 given in *The Mysteries Revised Edition*, +3 Sight)"
    }

}
