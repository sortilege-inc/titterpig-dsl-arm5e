EXTENSION "ArM5_Apprentices_Pueritia_Characters" {
    NAME "Ars Magica Fifth Edition, Apprentices - Chapter Four: Pueritia named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-31"
    DEPENDS_ON "ArM5_Apprentices_Core_Ext"

    # Statted example characters, one DEF each. Every stat line is a verbatim
    # typed field off the source's **Label:** markers (Combat printed malformed as
    # '**Combat:*', normalised before the run-in split); text after Appearance is the
    # character's narrative -> DESCRIPTION.

    #t33489aaa1363080a260937 ^"Grog: Urchin" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per –2, Pre +3, Com +3, Str –2, Sta 0, Dex +1, Qik +1 (Characteristic Modifier –2)"
            ^"Size" STRING "–3"
            ^"Age" STRING "11 (11)"
            ^"Virtues and Flaws" STRING "Daughter of Branded Criminal; Inconspicuous, Inspirational; Small Frame"
            ^"Personality Traits" STRING "Mischievous +3, Determined +2, Loyal –1"
            ^"Combat" STRING "Dodge:* Init –1, Attack n/a, Defense +1, Damage n/a"
            ^"Soak" STRING "–2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
            ^"Abilities" STRING "Area Lore 2 (secondary streets), Athletics 1 (avoiding pursuit), Awareness 1 (city guards), Brawl 1 (dodge), Charm 1 (city guards), Folk Ken 1 (adults), Guile 2 (city guards), Leadership 3 (peers), Legerdemain 2 (picking pockets), Music 2 (singing), Native Language 5 (thieves’ slang), Stealth 1 (following people), Survival 2 (finding fresh water)"
            ^"Equipment" STRING "Ratty clothes, shabby cloak, and a hidden dagger"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The urchin is a small, freckled-face, dirty girl, with quick fingers and ferretlike eyes."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The urchin is the daughter of a branded outlaw, who fled her abusive home and lives on the streets of a large city. She has made friends through her inventive songs, which usually poke fun at some local dignitary or market celebrity. Her immediate goal is to lead a gang of child thieves. The urchin started with the Exploring Childhood sample childhood. The character has room for another Minor Virtue and Flaw."
    }

    #t0d882ba55e734d168363ff ^"Companion: Merchant’s Son" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per 0, Pre +1, Com +3, Str 0, Sta 0, Dex –1, Qik 0 (Characteristic Modifier –1)"
            ^"Size" STRING "–1"
            ^"Age" STRING "13 (13)"
            ^"Virtues and Flaws" STRING "Son of Merchant; Wealthy, Inherited True Faith; Luck, Relic; Dark Secret, Overconfident; Obsessed (with saint’s lives), Short of Breath"
            ^"Personality Traits" STRING "Bully +3, Brave +2, Loyal +1"
            ^"Combat" STRING "Dodge:* Init –1, Attack n/a, Defense +1, Damage n/a *Dagger: *Init +2, Attack +1, Defense +2, Damage +2"
            ^"Soak" STRING "–1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16), Dead (17+)"
            ^"Abilities" STRING "Area Lore: Area A 1 (people), Area Lore: Area B 1 (history), Animal Handling 2 (pack mules), Bargain 2 (best price), Brawl 2 (dagger), Church Lore 3 (saints’ days), Folk Ken 2 (merchants), Leadership 3 (teamsters), Living Language 3 (merchant terminology), Native Language 5 (merchant terminology), Profession: Merchant 2 (exchange rates), Ride 2 (long distances), Survival 2 (roads)"
            ^"Equipment" STRING "Fine merchant clothes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The merchant’s son is of average build and height, with features and color common to the area of his birth. Dressed in fine clothes, he looks uncomfortable, and continually shifts and picks at his clothing."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The merchant’s son is a good example of a character designed to develop according to a predestined plan. The player ultimately wants the character to forsake his mercantile ways and become a preaching friar, much like St Francis of Assisi. Growing up, the merchant’s son is fascinated with Saints’ Lives, both in collecting the stories and visiting the saints’ places of martyrdom. During one such excursion, he found a holy relic, and the player assumes that veneration of the relic and the associated saint will lead to the character gaining True Faith. Lucky since birth, the character has a measure of overconfidence that could lead to trouble.\n\nAt some point, the merchant’s son discovered his father’s illegal business practices, and he is fearful that public knowledge will lead to his family’s ruin. While he is starting to detest business, he loves his family. The player hopes that the ensuing tension between keeping his family’s secret and his repulsion of merchant life will trigger that life-changing event that leads to True Faith.\n\nThe merchant’s son is based on the Traveling Childhood sample childhood. Because he is Wealthy he received 20 experience points for each year past five, 160 in total."
    }

    #t3a6f48acaafa9df5ea150a ^"Apprentice of House Bonisagus" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +1, Pre +1, Com –2, Str –1, Sta +3, Dex +1, Qik +1 (Characteristic Modifier –3)"
            ^"Size" STRING "–2"
            ^"Age" STRING "8 (8)"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Apprentice; Apt Student; Soft-Hearted"
            ^"Personality Traits" STRING "Obedient +3, Generous +2, Agreeable +1"
            ^"Combat" STRING "Dodge:* Init –2, Attack n/a, Defense 0, Damage n/a"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Area Lore 1 (deer paths), Athletics 1 (jumping), Awareness 1 (alertness), Brawl 1 (dodge), Latin 2 (Hermetic usage), Native Language 5 (storytelling), Profession: Forester 1 (gathering wood), Stealth 2 (hiding), Survival 3 (forest), Swim 1 (underwater) **Arts: Cr** 0**, In **1**, Mu **0**, Pe **0**, Re ** 0**; An** 2**, Aq **0**, Au **0**, Co** 0**, He** 0**, Ig **0**, Im **0**, Me **0**, Te **0**, Vi **0"
            ^"Equipment" STRING "Apprentice robes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "A happy looking girl, with braided hair and a wide smile."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The character has just been accepted into House Bonisagus, starting play after her first year of apprenticeship. Prior to her discovery, she lived in the woods with her parents. The character started with the Wilderness sample childhood, received 30 experience points for the two years before being accepted as an apprentice, and 19 experience points for her first year with the Bonisagus magus.\n\nThe character does not begin play with any Hermetic Virtues and hopes to learn them from her parens. The Apt Student Virtue adds to the Teaching Source Quality when her parens teaches her."
    }

    #t186a455795a810cdaa9c4a ^"Apprentice of House Verditius" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +1, Pre –1, Com 0, Str +1, Sta +2, Dex +1, Qik +1 (Characteristic modifier –1)"
            ^"Size" STRING "–1"
            ^"Age" STRING "12 (12)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Apprentice; Major Magical Focus (Metal); Affinity with Craft: Goldsmith, Cautious Sorcerer, Verditius Magic*; Weak Spontaneous Magic; Hunchback, Slow Caster *Free House Virtue"
            ^"Personality Traits" STRING "Loyal +3, Jealous +2, Indecisive +1"
            ^"Combat" STRING "Dagger: *Init 0, Attack +5, Defense +3, Damage +3 *Dodge*: Init 0, Attack n/a, Defense +2, Damage n/a"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–15), Dead (16+)"
            ^"Abilities" STRING "Artes Liberales 1 (rhetoric), Brawl 2 (dagger), Craft: Goldsmith 3 (fine details), Guile 2 (women), Latin 2 (Hermetic usage), Magic Theory 2 (enchanting items), Native Language 5 (metalworking terminology), Stealth 2 (shadowing) **Arts: Cr** 0**, In **0**, Mu **4**, Pe **0**, Re ** 4**; An** 0**, Aq **0**, Au **0**, Co** 0**, He** 0**, Ig **0**, Im **0**, Me **0**, Te **5**, Vi **3"
            ^"Equipment" STRING "Robe, heavy leather apron, and a pouch containing the casting tokens for his cantations"
            ^"Encumbrance" STRING "0 (0) **Spells Known:* Probe for Pure Gold* (InTe 4/ +6) A variant of *Probe for Pure Silver*. *Shattering Touch* (PeTe 5/ +6) *The Crystal Dart* (MuTe(Re) 10/ +10)"
            ^"Appearance" STRING "Vile-looking and di- sheveled, the apprentice wears craftsman’s clothes appropriate for the forge."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The Verditius apprentice has spent five years in apprenticeship. The character used the Mischievous Childhood as a starting point, received 30 experience points for the two years before apprenticeship, and received 95 experience points (19 x 5) for the five years spent as a Verditius apprentice. His parens has already initiated him into the Outer Mystery of the Cult (Verditius Magic Virtue).\n\nExperience points have been spent on Abilities, Arts, and spells, deviating slightly from the standard model of apprenticeship. The character is not limited to cantations, and has bought a higher level spell."
    }

}
