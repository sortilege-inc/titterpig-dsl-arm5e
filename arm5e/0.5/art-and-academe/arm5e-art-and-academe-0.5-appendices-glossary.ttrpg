EXTENSION "ArM5_Art_Academe_Appendices_Glossary" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Appendices glossary"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The chapter's glossary, structured; each DESCRIPTION the source's text, verbatim.

    #t07ca2fc01dff6b1ad54289 ^"Artes Liberales (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Artes Liberales"
            ^"Definition" STRING "The seven liberal arts, as defined by the ancients and practiced by medieval scholars. Divided between the trivium (q.v.) and the quadrivium (q.v.)."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #ta22bbb74e629a9ac8286d0 ^"Categories (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Categories"
            ^"Definition" STRING "The ways in which a substance can be; the ten ways that define a subject in reality. Substance is the most important, followed by quality, quantity, relation, and (less significantly) time, place, posture, possession, action, and passion."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t1655359279453a30a9e0d3 ^"Commentator, The (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Commentator, The"
            ^"Definition" STRING "A name given to Averroes as the preeminent commentator on Aristotelian philosophy."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #teec4105df8eb0f37831629 ^"Complexion (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Complexion"
            ^"Definition" STRING "An individual’s natural balance of the humors, affecting personality, physiognomy, and susceptibility to disease. There are four basic complexions — sanguine, choleric, melancholic, and phlegmatic."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tc80204498c8f24af96ed0a ^"Contra-naturals (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Contra-naturals"
            ^"Definition" STRING "Things that promote dyscrasia (q.v.) — injurous objects, poisons, corrosives, parasites, supernatural entities, etc."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tbaa12ac7d3d973d6c7536b ^"Disputatio (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Disputatio"
            ^"Definition" STRING "A formal method of debating between academic opponents, used to settle philosophical differences and for instructive purposes."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tdec4b7be3d01331152fcdc ^"Doctor (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Doctor"
            ^"Definition" STRING "Someone who has graduated from a university faculty (not just medicine)."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t562decdf56f7a8b5804a30 ^"Dyscrasia (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Dyscrasia"
            ^"Definition" STRING "Disease; a state of ill-health due to an overabundance of healthy or morbid humors."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tffe8e520b733b83a4f090e ^"Empirica (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Empirica"
            ^"Definition" STRING "A practical result of experimental philosophy (q.v.)."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t47f2e446615e72ca6832ac ^"Empiricus (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Empiricus"
            ^"Definition" STRING "One who practices experimental philosophy (q.v.); a scientist (in the modern meaning). In the specific case, a medicus (q.v.) who has little formal (but often substantial practical) knowledge of medicine; used in a derogatory or condescending manner."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #ta500156e30c52b29b1f3bc ^"Eucrasia (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Eucrasia"
            ^"Definition" STRING "A state of good health, where all the humors are in balance."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t9f8e98b49124bebc0f0409 ^"Experimental Philosophy (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Experimental Philosophy"
            ^"Definition" STRING "The direct observation of the world, as opposed to theoretical speculation."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t20f5618af36b1e09e4fd22 ^"Formula (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Formula"
            ^"Definition" STRING "A type of empirica (q.v.) resulting from study and laboratory activity; the products of alchemical research, astrological calculations, or medicinal remedies."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #te71d6364316ba9b334bdcd ^"Faculties (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Faculties"
            ^"Definition" STRING "Four divisions of academic learning taught at universities — artes liberales, civil and/or canon law, philosophy, and theology."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #td15a505df8044aafbf7951 ^"License (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "License"
            ^"Definition" STRING "The medieval equivalent of a modern academic degree, which grants the holder the right to teach specific subjects at specified universities."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t3e3a2eb2464960cf101c4a ^"Ligature (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Ligature"
            ^"Definition" STRING "A type of empirica (q.v.) designed to assist an action through the manipulation of the natural laws of the world."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t930482b86707486ab57cac ^"Medicus (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Medicus"
            ^"Definition" STRING "A general term for someone who has received formal academic training in medicine and/or chirurgy."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tbd35fbcd0c567c76cb482c ^"Nations (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Nations"
            ^"Definition" STRING "Groups of foreign students, coming from the same general area, living together in a university town."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t0fe721010558019b1509dc ^"Natural Magic (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Natural Magic"
            ^"Definition" STRING "Another term for experimental philosophy (q.v.); does not actually involve magic in the supernatural sense."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t740144f532c43ce8444160 ^"Non-naturals (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Non-naturals"
            ^"Definition" STRING "Things that promote eucrasia (q.v.) — climate, diet, exercise, sleep, emotions, sensations. Excessive non-naturals can cause dyscrasia (q.v.)."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t672a311ffcd328b29b9724 ^"Oath of Matriculation (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Oath of Matriculation"
            ^"Definition" STRING "The official swearing of a student to be a master’s pupil. Hermetic magi are forbidden to swear oaths of fealty outside of the Order."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #ta2b58420a8e3d15af47412 ^"Philosopher, The (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Philosopher, The"
            ^"Definition" STRING "A title given to Aristotle, which will become more common in the mid-thirteenth century."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t64e7bb0453a0f1ecadfd9a ^"Physicus (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Physicus"
            ^"Definition" STRING "A medicius (q.v.) who has received advanced training in medicine and philosophiae; not generally used for those who practice chirurgy."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tac6f3e043423fd026fac67 ^"Quadrivium (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Quadrivium"
            ^"Definition" STRING "The second or greater division of the liberal arts, including arithmetic, music, astronomy, and geometry."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #tdacf53efa7eb2d7627e5e2 ^"Regimen (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Regimen"
            ^"Definition" STRING "A “recipe” for good health, prescribed by a physician. Involves affecting the non-naturals (q.v.) to stave off disease."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t23872feafb2e57f9741fdc ^"Trivium (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Trivium"
            ^"Definition" STRING "The first or lesser division of the liberal arts, including grammar, logic, and rhetoric. Students learn these arts before moving on to the quadrivium (q.v.)."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

    #t0a6b7095b347c14a44ab9c ^"Universals (Glossary)" DEF {
        EXTENDS #tb6e69a70fb15d7d9c6b592 ^"Glossary Entry"
        PROPERTIES {
            ^"Term" STRING "Universals"
            ^"Definition" STRING "Plato’s forms or ideas, a perfect template for any subject in reality. Universals are unchangeable, have no beginning or end, exist outside reality, and can only be know through reason."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 140
        }
    }

}
