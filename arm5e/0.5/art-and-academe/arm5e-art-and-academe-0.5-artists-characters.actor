EXTENSION "ArM5_Art_Academe_Artists_Characters" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Eight: Artists named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # Statted characters, one DEF each. Every stat line is a verbatim typed field off the
    # source's **Label:** markers; text after Appearance is the character's narrative -> DESCRIPTION.

    #ta3c3fdea06c9249e9389fc ^"Brogo the Dwarf" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –2, Per +1, Pre 0, Com +4, Str –1, Sta –1, Dex +2, Qik 0"
            ^"Size" STRING "–2"
            ^"Age" STRING "30 (30)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Wanderer; Death Prophecy; Artistic Renown, Affinity with Enchanting Music, Educated, Enchanting Music, Great Communication, Puissant Trouvère; Curse of Venus, Dwarf, Proud"
            ^"Personality Traits" STRING "Proud +3, Gregarious +2, Sly +2"
            ^"Reputations" STRING "Trouvère 2 (Artist)"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +0, Damage n/a"
            ^"Soak" STRING "–1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Athletics 2 (grace), Artes Liberales 2 (music), Awareness 2 (searching), Bargain 4 (benefactors), Carouse 3 (drinking songs), Concentration 2 (maintaining enchanting music), Enchanting Music 7 (joviality ), Etiquette 2 (court), Folk Ken 2 (sponsors), French 5 (music terminology), German 3 (music terminology), Guile 2 (lying about his past), Order of Hermes Lore 1 (covenants), Profession: Trouvère 5 + 2 (adulterous love songs), Music 3 (lyre), Latin 4 (music), Swim 1 (diving)"
            ^"Equipment" STRING "Colorful clothes and a small lyre"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Brogo is short, the height of a seven-year-old child, but stocky, with a bristling black beard and long hair cut short in the front and long in the back. He wears a yellow-and-purple-striped tunic and trousers, and a wide-brimmed, yellow hat with a long peacock feather jutting out."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "Brogo was born and raised in Tournai, where he attended the cathedral school as a young man. A natural with the harp and lyre, Brogo spent most of his young adulthood singing and playing in inns and taverns in Picardy. As his reputation as a trouvère grew, he extended his performing circuit, and now travels throughout France and the Holy Roman Empire, entertaining and entrancing audiences with his songs. Brogo has visited Hermetic covenants before, and wouldn’t hesitate to visit a new one.\n\nBrogo is a composer, using his Performance: Trouvère to create and perform songs. The Aesthetic Quality of his compositions is 12: Com (+4) + Trouvère (5) + Puissant Trouvère (+2) + one-third Artes Liberales (+1). Because of his pride, he will probably attract an infernal muse once his Trouvère Reputation reaches 7.\n\nBrogo can be used as a starting companion-level character."
    }

}
