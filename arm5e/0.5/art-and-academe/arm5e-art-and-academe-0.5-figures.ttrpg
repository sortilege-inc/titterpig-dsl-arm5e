EXTENSION "ArM5_Art_Academe_Figures" {
    NAME "Ars Magica Fifth Edition, Art & Academe - diagrams and map"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The book's six diagrams and map (Contents, 'Diagrams & Maps'), as ^"Figure" records. Their labels were
    # read by eye (no text layer); the transcription and how it was made: art-and-academe/figures.json.

    # source: page 16, read by eye from the art (no text layer; figures.json)
    #t3d0670bc567206618df429 ^"The Platonic Solids" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Platonic Solids"
            ^"Lettering" LIST OF STRING ["THE PLATONIC SOLIDS", "Tetrahedron", "Cube", "Octahedron", "Dodecahedron", "Icosahedron"]
            ^"Shows" STRING "the five Platonic solids drawn in outline, hidden edges dashed, each named beneath"
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 16
        }
    }

    # source: page 18, read by eye from the art (no text layer; figures.json)
    #tad11a9225a208ca124fb30 ^"The Celestial Spheres" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Celestial Spheres"
            ^"Lettering" LIST OF STRING ["OUR HABITABLE REGION", "EAST", "INDIAN SEA", "ASIA", "JERUSALEM", "NORTH", "SOUTH", "RIVER DON", "EUROPE", "MEDITERRANEAN SEA", "RIVER NILE", "AFRICA", "ATLANTIC SEA", "WEST", "SPHERE OF EARTH", "MERIDIAN", "ARCTIC ZONE", "OUR HABITABLE REGION", "MERIDIAN", "ANITCTHONAL REGION", "EQUATOR", "TORRID ZONE", "ANTOECIAL REGION", "ANTIPODAL REGION", "ANTARCTIC ZONE", "ZODIAC", "TWELVE CELESTIAL SPHERES", "FIXED STARS", "SATURN", "JUPITER", "MARS", "VENUS", "MERCURY", "SUN", "MOON", "EARTH", "WATER", "AIR", "FIRE"]
            ^"Shows" STRING "the cosmos in three linked views: the twelve celestial spheres around the Earth, from the four elemental spheres (earth, water, air, fire) out through the Moon, Sun and planets to the fixed stars, each planet with its symbol; the zodiac band with the twelve signs' symbols; and the sphere of Earth with its zones and four regions, the habitable one enlarged as a map of Asia, Europe and Africa"
            ^"Depicts" LIST OF STRING ["the symbols of the twelve signs of the zodiac", "the symbols of Saturn, Jupiter, Mars, Venus, Mercury, the Sun and the Moon", "the symbol of the Earth"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 18
        }
    }

    # source: page 31, read by eye from the art (no text layer; figures.json)
    #t0cabae59c8e3d50e5ac7ca ^"The Human Mind" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Human Mind"
            ^"Lettering" LIST OF STRING ["DEVS", "MUNDIS INTELLECTUALIS", "VIRGENITAS", "VIRGENITOR", "SERAPHIM", "CHERUBIM", "DOMINATIONES", "POTESTATES", "THRONES", "PRINCIPATUS", "VIRTUTES", "ARCHANGELOS", "ANGELOS", "MUNDIS IMGINABILIS", "UMBRA IGNIS", "UMBRA AERIS TENUIS", "UMBRA AERIS GROSS", "UMBRA AQUA", "UMBRA TERRAE", "MUNDIS SENSIBILIS", "LUX SEU IGNIS", "AER TENUIS", "AER GROSSUS", "AQUA", "TERRA", "MENS", "INTELLICTUS", "RATIO", "COGITATIUA", "AESTIMATIUA", "HIC ANIMA EST", "CUSTOS", "MUNDI", "IMAGINI", "SENSI", "MEMORIA", "VISIONUM", "EST ENIM", "VERMIS", "MEMORATIUA", "HIC ANIMA EST", "MOTIUA", "SENSITIUA", "HIC ANIMA EST", "IMAGINATIUA", "TACTUS", "VISUS", "ODORATUS", "GUSTUS"]
            ^"Shows" STRING "a man at prayer, lines running from his senses (touch, sight, smell, taste) to the faculties of the mind drawn as overlapping circles in his head; above, the sensible world as concentric elemental spheres around the earth, the imaginable world as their shadows, and the intellectual world of God ringed by the nine orders of angels"
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 31
        }
    }

    # source: page 37, read by eye from the art (no text layer; figures.json)
    #t0e38206b18a6043bfc5447 ^"The Human Body" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Human Body"
            ^"Lettering" LIST OF STRING ["BRAIN", "ANIMAL SPIRITS", "AIR", "AORTA", "PNEUMA (AIR)", "LUNG", "PNEUMA (AIR)", "IMPURE BLOOD", "BLOOD", "LUNG", "VENA CAVA", "VITAL SPIRITS", "LIVER", "NATURAL SPIRITS", "CHYLE", "WASTE"]
            ^"Shows" STRING "the organs of the body joined by arrows: air drawn through the windpipe to the lungs, blood through the heart, the liver and the gut, chyle entering and waste leaving, the brain at the top holding the animal spirits"
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 37
        }
    }

    # source: page 38, read by eye from the art (no text layer; figures.json)
    #t10e34d850444cf08430e62 ^"The Concoctions" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Concoctions"
            ^"Lettering" LIST OF STRING ["FIRST CONCOCTION", "SECOND CONCOCTION", "THIRD CONCOCTION", "FOURTH CONCOCTION", "NON NATURALS", "WASTE PRODUCTS", "FOOD", "SLEEP", "EXERCISE", "EMOTIONS", "AIR", "SENSORY EXPERIENCES", "MOUTH", "LUNGS", "SENSE ORGANS", "HEART", "VITAL FACULTY", "STOMACH", "CHYLE", "LIVER", "NATURAL FACULTY", "BRAIN", "SENSITIVE FACULTY", "TISSUES", "CAMBION SPERMAE", "INTESTINES", "KIDNEYS", "LUNGS", "SENSE ORGANS", "SKIN", "FAECES", "URINE", "EXHALED AIR", "MUCUS", "SWEAT, HAIR, NAILS"]
            ^"Shows" STRING "the four concoctions as a chart: across the top the non-naturals taken in (food; sleep, exercise, emotions; air; sensory experiences), through the organs where each is concocted (stomach, liver, heart, brain, tissues) to the faculties they produce, and down to the waste each yields"
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 38
        }
    }

    # source: page 80, read by eye from the art (no text layer; figures.json)
    #t759a1311d5586e55824999 ^"Mythic Europe Schools & Universities Map" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Mythic Europe Schools & Universities Map"
            ^"Lettering" LIST OF STRING ["Mythic Europe", "SCHOOLS & UNIVERSITIES", "Orkney Is", "Hebrides", "SCOTLAND", "NORWAY", "IRELAND", "Isle of Man", "Irsih Sea", "ENGLAND", "WALES", "North Sea", "DENMARK", "SWEDEN", "Oland", "Baltic Sea", "HOLSTEIN", "POMERANIA", "Oder R.", "KINGDOM OF POLAND", "HOLY ROMAN EMPIRE", "SILESIA", "Elbe R.", "THURINGIA", "SAXONY", "Rhine R.", "LOWER LORRAINE", "UPPER LORRAINE", "FRANCONIA", "SWABIA", "BOHEMIA", "BAVARIA", "Danube R.", "AUSTRIA", "SERB", "Atlantic Ocean", "THE SUBMERGED KINGDOM OF LYONESSE", "English Channel", "BRITTANY", "NORMANDY", "FLANDERS", "CHAMPAGNE", "Seine R.", "FRANCE", "ANJOU", "AQUITANE", "GULF OF GASCONY", "GASCONY", "NAVARRE", "ARELA", "Rhone R.", "PROVENCE", "Golfe du Lion", "LEON", "PORTUGAL", "NEW CASTILE", "ARAGÓN", "ALMOHAD EMPIRE", "GRANADA", "Pillars of Hercules", "Alboran Sea", "Balearic Sea", "Balearic Islands", "Mediterranean Sea", "Sardinia", "Corsica", "Ligurian Sea", "PATRICONIUM PETRI", "ITALY", "Adriatic Sea", "APULIA", "CALABRIA", "Tyrhenian Sea", "Sicily", "MAL", "= University", "= Monastic School", "= Cathedral School"]
            ^"Shows" STRING "a map of western and central Europe marking the schools and universities of Mythic Europe by an icon for each kind, with the realms, regions, seas and rivers named; 'SCOTLAND' and 'NORWAY' are partly covered by the title lettering, and 'SERB' and 'MAL' are cut by the map's frame"
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 80
        }
    }

    #t9fca432fac220973f4c5d5 ^"Mythic Europe Schools & Universities Map (placemarks)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Place", "School"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Note" STRING "'Paris' and 'Victorine' are set beneath one double icon, a university and a cathedral school side by side; the art does not say which label names which, so the row keeps both as printed."
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-480 dpi (the image has no text layer); labels as printed"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 80
        }
        TABLE {
            "York" "Cathedral School"
            "Peterborough" "Monastic School"
            "Cambridge" "University"
            "Oxford" "University"
            "Canterbury" "Cathedral School"
            "Tournai" "Cathedral School"
            "Utrecht" "Cathedral School"
            "Corvey" "Monastic School"
            "Fulda" "Monastic School"
            "Laon" "Cathedral School"
            "Reims" "Cathedral School"
            "Mainz" "Cathedral School"
            "Regensburg" "Cathedral School"
            "Mont-St-Michel" "Monastic School"
            "Savigny" "Monastic School"
            "Bec" "Monastic School"
            "Rouen" "Cathedral School"
            "Paris, Victorine" "University, Cathedral School"
            "Clairvaux" "Monastic School"
            "Chartres" "Cathedral School"
            "Poitiers" "Cathedral School"
            "Bordeaux" "Cathedral School"
            "Aurillac" "Monastic School"
            "Cluny" "Monastic School"
            "Lyons" "Cathedral School"
            "Montpellier" "University"
            "St Gall" "Monastic School"
            "Vicenza" "University"
            "Reggio" "University"
            "Bologna" "University"
            "Arezzo" "University"
            "Palencia" "University"
            "Salamanca" "University"
            "Toledo" "Cathedral School"
            "Monte Cassino" "Monastic School"
            "Salerno" "University"
        }
    }

}
