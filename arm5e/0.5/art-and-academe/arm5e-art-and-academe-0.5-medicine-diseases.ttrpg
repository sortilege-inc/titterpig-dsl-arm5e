EXTENSION "ArM5_Art_Academe_Medicine_Diseases" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Four: Medicine diseases"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The chapter's diseases, structured; each DESCRIPTION the source's text, verbatim.

    #te335e7797cea0d3f2f56f5 ^"The Ague" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 14
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Continuous fever with chills. Other types of the ague corrupt different humors, and are either Minor or Serious Diseases. As a choleric disease, the ague induces fever every fourth day; as a melancholic disease the fevers occur every third day; and as a sanguine disease the fever occurs every day."
            ^"Printed Stat Line" STRING "Major Phlegmatic Disease, Severity 14 Stable: 9, Improve 15, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "Caused by bad air, particularly around sewage and tanneries (Non-Natural). This is the most severe type of this disease."
    }

    #t225ad46098daa02374e57d ^"Anal Fistula" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Melancholic"
            ^"Severity" INTEGER 5
            ^"Stable Ease Factor" STRING "4"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Hemorrhoids, mild pain and distraction, aposteme of melancholy and blood called a fistula that requires surgical removal (see Surgery)."
            ^"Printed Stat Line" STRING "Minor Melancholic Disease, Severity 5 Stable: 4, Improve: 10, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "This unpleasant condition is caused by excessive retention of melancholy on the fundament; commonly resulting from sitting for long periods on horseback while wearing heavy armor (Non-Natural)."
    }

    #t564f2c1a0abe140cbe0628 ^"Apoplexy" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Critical"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 16
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Crushing pain to chest followed by immediate collapse and disease Crisis."
            ^"Printed Stat Line" STRING "Critical Sanguine Disease, Severity 16 Stable: 6, Improve: 15, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "This disease causes massive and immediate damage to the heart, which disrupts the vital faculty and causes immediate collapse. Apoplexy is caused by a malicious faerie and is sometimes called “elfshot.” Some other supernatural beings may also be capable of causing it (Contra-Natural)."
    }

    #t6573b446d22323245b6531 ^"Bloody Flux" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Diarrhea, chills, cramps, a running nose, and bloody stools."
            ^"Printed Stat Line" STRING "Serious Phlegmatic Disease, Severity 9 Stable: 6, Improve: 12, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "The bloody flux is an excess of phlegm caused by living in cold, wet conditions (Non-Natural). It is common in towns and campaigning armies. This complaint can cause weakness or wasting if it continues for too long, as the body evacuates nourishment before it can be used.\n\nThere are more severe versions of the bloody flux that have higher Stable and Improvement Ease Factors."
    }

    #tceb8c6a04ce20b591d48bb ^"Chaudepysse" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Season"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Pain, a discharge of blood from the male organs, excessive itching, rash. Continuous fever may follow, and if the disease becomes Major, sterility and impotence."
            ^"Printed Stat Line" STRING "Minor Choleric Disease, Severity 9 Stable: 6, Improve: 12, Interval: Season"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "This disease is contracted by men who have commerce with unclean women (i.e. during their monthly flow), and is often called “the burning” due the pain of urination (Contra-Natural). It is notoriously difficult to cure and is most often treated by direct injection into the urethra of parsley, oil of roses and violets, and the milk of a mother nursing a manchild."
    }

    #t40bed868c22b45b948446f ^"Childbed Fever" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 11
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Chills, fever, abdominal pain, nausea, and in terminal cases a rotting of the reproductive organs that can spread"
            ^"Printed Stat Line" STRING "Major Sanguine Disease, Severity 11 Stable: 6, Improve: 10, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "The act of giving birth causes swings in a woman’s balance of humors that make her vulnerable to the childbed fever demon (Contra-Natural). This demon attempts to enter the woman’s body as the baby leaves, so this disease can only be contracted by women who have just given birth.\n\nto the rest of the body. If there were birthing complications (prolonged labor, placenta retention, conception during menstruation, or a still-birth, for example) this is a Critical Disease rather than a Major one."
    }

    #t630ddc0c94d605427313a8 ^"Coryza" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 4
            ^"Stable Ease Factor" STRING "4"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Catarrh, unpleasant cough. If it worsens, a quotidian fever, inflammation of the lungs, extreme weariness (make Fatigue rolls for even light exercise)."
            ^"Printed Stat Line" STRING "Minor Phlegmatic Disease, Severity 4 Stable: 4, Improve: 10, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Coryza, or the common cold, is caused by a cold, damp environment such as that found in late autumn and winter (Non-Natural). The cold and wet conditions cause an excess of phlegm in the head."
    }

    #tfcae112929129790ea64e6 ^"Diabetes" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 14
            ^"Stable Ease Factor" STRING "4"
            ^"Improvement Ease Factor" STRING "n/a"
            ^"Interval" STRING "Lifelong"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Instead of a Disease Penalty, causes fainting for a few minutes whenever a Fatigue roll (**ArM5**, page 178) is failed."
            ^"Printed Stat Line" STRING "Minor Sanguine Disease, Severity 14 Stable: 4, Improve: n/a, Interval: Lifelong"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Rich food and a gluttonous appetite can result in this disease, a result of the disruption of the digestion and thus a surfeit of nutrition (Non-Natural). The children of gluttonous parents occasionally suffer from this disease. It was named by Aretaeus the Cappadocian after the Greek word for a siphon, due to the excessive discharge of urine."
    }

    #t6acf9e347bcca0c188287a ^"Erysipelas" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 6
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Severe itching rash, most prominent on the extremities, but also on the face and arms. Can poison the blood if the disease worsens."
            ^"Printed Stat Line" STRING "Minor Choleric Disease, Severity 6 Stable: 6, Improve: 10, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Erysipelas is a disease of morbid choler due to excessive heat and dryness derived from inappropriate food for the character’s complexion (Non-Natural). It migrates to the skin to cause a maddening rash. People tend to avoid a sufferer of erysipelas because of his obvious symptoms of disease"
    }

    #tb09b74ae4d28326d0340af ^"The Falling Evil (Disease)" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Printed Name" STRING "The Falling Evil"
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 16
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Season"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Rather than a Disease Penalty, this disease manifests as convulsions. Convulsions occur randomly and infrequently. For any given event, the storyguide should secretly roll a stress die; if the result is 9 or more then a convulsion will occur at some point during that event, as chosen by the storyguide. This spasm perturbs both sensation and movement, causing both to occur at random, leaving the character temporarily Incapacitated. He collapses to the ground and twitches. Every round he can make a Stamina roll against an Ease Factor of 9; success means that the convulsion ends, although he is reduced to the Dazed Fatigue level."
            ^"Printed Stat Line" STRING "Major Phlegmatic Disease, Severity 16 Stable: 6, Improve: 15, Interval: Season"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Known by a large number of names (e.g. epilepsy, morbus caducus, morbus lunaticus), the “sacred disease” of Hippocrates is now known to be caused by demonic possession (Contra-Natural). The most common cure is to induce a quartan fever with medicinals that will dry up the moistness polluting the sensitive faculty. Trepanation (see Surgery) is occasionally recommended, but this is a dangerous procedure. The demons who cause the falling evil are weak, and this Major disease is easily resisted by those with a strong constitution; the demons usually strike following a debilitating blow to the head."
    }

    #td8604ec734b51a4fcc505a ^"Febris Semitertiana" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 18
            ^"Stable Ease Factor" STRING "12"
            ^"Improvement Ease Factor" STRING "18"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Discharge of watery stools, crippling abdominal pain, raging fever, red rash all over the body."
            ^"Printed Stat Line" STRING "Major Choleric Disease, Severity 18 Stable: 12, Improve: 18, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "This disease is truly fearful. It derives from water corrupted by the malign influence of Saturn and Mars (Contra-Natural). In the heat of summer, this disease can kill thousands."
    }

    #tb20b1c169129ca090e7270 ^"Gangrene" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 8
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Continuous fever. The infected wound cannot improve until the gangrene is gone, but it can worsen. Surgical intervention (deep cautery or amputation; see Practice of Chirurgy, below) to prevent the gangrenous wound worsening is often the best option, because Wound Penalties affect Disease Recovery rolls and vice versa."
            ^"Printed Stat Line" STRING "Minor Sanguine Disease, Severity 8 Stable: 9, Improve: 15, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Evil spirits in an improperly cleaned wound cause putrefaction of the blood (Contra-Natural). Gangrene is the most common result of a botched Wound Recovery roll. The wound becomes a festering ulcer as the flesh is consumed by the morbid blood."
    }

    #t618ec415fa3962e36b1641 ^"Garotillo" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Tertian fever, mild pain in the throat, drowsiness, a white, livid, or black concretion of morbid humors at the back of the mouth. If this disease worsens to a Major Disease, the sufferer is in danger of suffocation if he ever fails a roll involving Stamina. Follow the rules for Deprivation (**ArM5**, page 180–181). For each Deprivation roll he also gets a Stamina + Concentration roll against an Ease Factor of 6; success means that he regains his breath."
            ^"Printed Stat Line" STRING "Serious Choleric Disease, Severity 9 Stable: 6, Improve: 12, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "This disease is contracted through excessive exercise that dries the body and inflames the choler (Non-Natural). The disease is also known as *morbus suffocans* for its distinctive second stage, in which the disease spreads to the windpipe and causes death by gradual suffocation."
    }

    #tf4229312086cf0cf737268 ^"Leprosy (Disease)" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Printed Name" STRING "Leprosy"
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Melancholic"
            ^"Severity" INTEGER 21
            ^"Stable Ease Factor" STRING "n/a"
            ^"Improvement Ease Factor" STRING "n/a"
            ^"Interval" STRING "Lifelong"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Skin damage, clawing of hands and feet, blindness, loss of sensation and paralysis in the limbs, and sometimes madness. The victim of leprosy gains the Leprosy Major Flaw. A leper has a permanent –2 modifier to her Living Condition Modifier and whenever she undergoes an Aging Crises (**ArM5**, page 170) the leper sustains a Heavy Wound in addition to any other result. Lepers cannot gain a positive reputation due to the pungent rotting smell that they emanate. As a lifelong disease, no Disease Recovery rolls are possible."
            ^"Printed Stat Line" STRING "Major Melancholic Disease, Severity 21 Stable: n/a, Improve: n/a, Interval: Lifelong"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Medically, leprosy is an excess of black bile, and it is inflicted through the wrath of the Almighty as a punishment for unclean living (Contra-Natural). (See *City and Gild*, page 26, for the societal consequences of contracting leprosy.) There is no chance of avoiding catching leprosy — if God wills it, then the character is afflicted."
    }

    #t7dce345022d31f4465ccf4 ^"Leprosy, Hermetic" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Critical"
            ^"Humor" STRING "Melancholic"
            ^"Severity" INTEGER 16
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Victim’s flesh rots off in a matter of weeks. If the victim survives the Disease Crisis, he will find it impossible to develop a positive reputation."
            ^"Printed Stat Line" STRING "Critical Melancholic Disease, Severity 16 Stable: 6, Improve: 12, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Hermetic leprosy is caused by the Hermetic spells* Curse of the Leprous Flesh* and *Curse of the Unportended Plague* (**ArM5**, page 133; Contra-Natural). It conforms to everyone’s worst fears about true leprosy, manifesting as a rapid and hideous wasting disease accompanied by a pungent rotting smell."
    }

    #t239da1171c627b1b50c696 ^"Phimosis" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 6
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Soft sores on the coital organs, which may become poisoned. A man who suffers a disease Crisis induced by phimosis is left impotent."
            ^"Printed Stat Line" STRING "Minor Choleric Disease, Severity 6 Stable: 6, Improve: 10, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "A particular affliction of promiscuous men (but can be suffered by both sexes) caused by excess lust (Non-Natural). It is a painful and embarrassing disease, but usually clears up on its own with no lasting aftereffects."
    }

    #t22667934c0acddd64d57ba ^"Phthisis" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Major"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 17
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "18"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Hacking cough, shortness of breath, blood in the sputum, quoditian fever, and wasting; all of which amount to the Enfeebled Flaw."
            ^"Printed Stat Line" STRING "Major Phlegmatic Disease, Severity 17 Stable: 9, Improve: 18, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Phthisis pollutes the vital faculty with excessive phlegm. It is an epidemic disease, caught initially from foul air deriving from marsh water, and subsequently spreading from person to person through putrid breath (Contra-Natural). It is also known as consumption because it eats away at the flesh of its victims. Physicians recommend climatic therapy of sea voyages and high altitudes to rid the lungs of the putrid air, but few can afford the luxury of such treatment."
    }

    #tf209529af8dbdfac6e2ab6 ^"Pneumonia" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Acute pain in the chest, quotidian fever. The afflicted character is also reduced to the Winded Fatigue level until he improves. At the Major stage of the disease, the victim suffers from the Enfeebled Flaw in place of the Disease Penalty."
            ^"Printed Stat Line" STRING "Serious Phlegmatic Disease, Severity 9 Stable: 6, Improve: 12, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "This inflammation of the lungs is diagnosed by the presence of blood or choler in the sputum. It is caused by polluted air (Contra-Natural). Pneumonia has a tendency to exhibit a Crisis on the seventh day. Treatment is typically bleeding to reduce the excess fluid, and drying compresses applied to the chest."
    }

    #tb22045232203a53f6b7ebe ^"Quinsy" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Phlegmatic"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "10"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Pain localized in the back of the throat. Should it worsen to a Serious Disease, the Disease Penalty remains –1, but the character suffers from an Afflicted Tongue, and at the Major stage he becomes Mute."
            ^"Printed Stat Line" STRING "Serious Phlegmatic Disease, Severity 9 Stable: 6, Improve: 10, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Quinsy is contracted from swallowing worms in one’s food, which live in the tonsils and cause them to swell (Contra-Natural). If the swelling gets so great that it threatens breathing, it is recommended that the tonsils should be surgically opened with a curved knife on a long stick, although some chirurgeons attempt to remove the tonsils entirely."
    }

    #tb76e9b04ace72b522038e1 ^"Rabies" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 13
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "18"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Raging thirst, extreme fear of water, violent convulsions. The mind of the sufferer is also affected, reduced to that"
            ^"Printed Stat Line" STRING "Serious Choleric Disease, Severity 13 Stable: 9, Improve: 18, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "This dreadful disease is caused by the bite of a mad dog (Contra-Natural), which inflames the choler and dries the body. It is swift to affect its victim and difficult to treat due to the extreme mental disturbance of its sufferers. A physician must forcibly apply medicinals to the patient, and the involuntary convulsions mean that bed rest is impossible, even if tied down.\n\nof a furious beast. The sufferer foams at the mouth and attempts to bite all who come near, and he can transmit the disease in this fashion if the skin is broken."
    }

    #t15229775df5838d1bd9708 ^"Saint Anthony’s Fire" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 12
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "18"
            ^"Interval" STRING "Season"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Red rash, intestinal pain, visions, muscular spasms, and a burning sensation in the extremities. Eventually the limbs begin to rot. This disease is exceptionally hard to recover from due to the tenacity of the demon, and it typically worsens each season until the victim dies."
            ^"Printed Stat Line" STRING "Minor Sanguine Disease, Severity 12 Stable: 6, Improve: 18, Interval: Season"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "Caused by an excess of blood due to possession by a minor demon in the victim’s intestines (Contra-Natural). Exorcizing the demon ends the disease, and the Order of the Hospitalers of St. Anthony specialize in such exorcisms."
    }

    #t9c9e6c7369eb27587cccb7 ^"Scrofula" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Melancholic"
            ^"Severity" INTEGER 10
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Swelling of the glands all over the body, dull pain. If it progresses to a Major Disease, as well as worsening the"
            ^"Printed Stat Line" STRING "Serious Melancholic Disease, Severity 10 Stable: 6, Improve: 12, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "An unpleasant disease caused by the cold dry winds of cities in Northern Europe, particularly those situated far from the sea (Non-Natural). The excess of melancholy congests glands forming hideous lumps over the body. Also called struma and *morbus regius* (the King’s Evil) because the touch of the Kings of England or France is known to cure it.\n\nDisease Penalty the glands — particularly those in the neck — swell to immense size, imposing the Disfigured Flaw. The swellings can be surgically removed once the disease is cured."
    }

    #t212171bef596a2682a5acc ^"Stones" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Choleric or Phlegmatic"
            ^"Severity" INTEGER 11
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "Acute abdominal pain, initially when passing water, but later continuously. Difficult to cure without Surgery."
            ^"Printed Stat Line" STRING "Serious Choleric or Phlegmatic Disease, Severity 11 Stable: 9, Improve: 15, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "A coagulation of bile causes a hard stone to form in the gallbladder, while morbid vitreous phlegm is responsible for stones in the kidney and bladder. The coagulation occurs when either humor is in excess, such as through an inappropriate diet for one’s temperament (Non-Natural)."
    }

    #td97ce91a6ee2d91452cc2d ^"Suffusio" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Melancholic"
            ^"Severity" INTEGER 11
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Dimmed vision; rather than a Disease Penalty the sufferer acquires the Poor Eyesight Flaw until the disease is cured. A complication of the disease — called suffusio nigra or glaucosis — occurs if the disease"
            ^"Printed Stat Line" STRING "Serious Melancholic Disease, Severity 11 Stable: 9, Improve: 12, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "Suffusio is a congregation of humor between the lens and the pupil, obstructing sight, caused by the excessive absorption of harmful visual species (Contra-Natural). A surgical procedure called “couching” can expel the humor through the insertion of a thin needle beneath the lens.\n\nworsens, resulting in the Blind Flaw. Suffusio cannot kill; a failed Disease crisis results in permanent blindness instead."
    }

    #te77a1fc3a9b1dd9544fb79 ^"Tumor, Consumptive" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Sanguine and Melancholic"
            ^"Severity" INTEGER 10
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Month"
            ^"Cause" STRING "Non-Natural"
            ^"Symptoms" STRING "A hard mass, which causes stabbing pains in the affected organ. Rather than worsening in the usual way, every Disease Recovery roll that does not result in Improvement produces a new tumor in a different location; these secondary tumors begin as Minor diseases, and receive their own Disease Recovery rolls at a monthly interval. Only the first tumor can produce new ones; once it is cured or removed no new tumors will develop."
            ^"Printed Stat Line" STRING "Serious Sanguine and Melancholic Disease, Severity 10 Stable: 6, Improve: 12, Interval: Month"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "A consumptive tumor, or carcinoma, has a hard central mass with pointed projections that extend into an organ, which is why it is named after a crab (*carcinos*). It is a precipitate of blood and melancholy formed through insufficient evacuation (Non-Natural), and is the most dangerous tumor of all; it penetrates slowly into tissue but digests it as it goes, spreading its corrupting influence throughout the body. Surgery (see below) to remove the tumor is an option, but rarely meets with success due to the invasiveness of this cancer.\n\nNon-consumptive tumors are called *oncoi* (singular *oncos*). A cold tumor (Minor Disease) is formed from phlegm and melancholy, whereas a hot tumor (Serious Disease)\n\nis coagulated choler and melancholy. Both are slow to act, having an Interval: Season, but neither have the same ability to cause new tumors."
    }

    #t16779066120dc8f7b7961c ^"Variola" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Choleric"
            ^"Severity" INTEGER 11
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "15"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "Eruption of pus-filled pocks all over the skin, a tertian fever, pains in the back. Victims who suffer a disease Crisis and survive are often left blind, or horribly disfigured."
            ^"Printed Stat Line" STRING "Serious Choleric Disease, Severity 11 Stable: 9, Improve: 15, Interval: Week"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "Variola, or small pox, is a disease caused by the accumulation of putrid choler in the skin due to inhaling polluted air in hot and dry conditions (Contra-Natural). It is highly contagious and disfiguring. Physicians recommend the eating of red food, and hanging red drapes around the bed of the patient to draw out the putrid choler from the skin.\n\nThe common name of small pox distinguishes this disease from other pox-causing diseases. Great pox, chicken pox (named after *cicer*, or chick peas, which the pocks resemble) and rubeola (measles) are all milder forms of this disease, and are all Minor rather than Serious illnesses."
    }

    #tfa3b0118c0805454249182 ^"Worms" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Minor"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 9
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Season"
            ^"Symptoms" STRING "Wasting. However, those inflicted with worms are not immediately affected — they take no Disease Penalty. However, if after a season the disease worsens, the patient is afflicted with a Serious Disease."
            ^"Printed Stat Line" STRING "Minor Sanguine Disease, Severity 9 Stable: 6, Improve: 12, Interval: Season"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "Worms spontaneously generate in congealed blood (see Chapter Three: Philosophiae, Worms). In a healthy person the worms disperse, but in the unhealthy they can overwhelm the body. Children are particularly susceptible as their bodily humors are intermingled with milk."
    }

}
