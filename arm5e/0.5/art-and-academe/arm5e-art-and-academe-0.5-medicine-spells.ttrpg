EXTENSION "ArM5_Art_Academe_Medicine_Spells" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Four: Medicine spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t7180dd89ecbbdc0cbf2583 ^"Gift of the Tortured Bowels" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Rego Corpus 10 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "The target is inflicted with a sudden intestinal cramp, then immediately suffers a bout of diarrhea. Once the bowels are empty, there are no physical aftereffects. Medically inclined magi occasionally use this spell (and variants thereof) therapeutically, to purge the body of putrefied humors.\n\n(Base 5, +1 Eye)"
    }

    #t6e9cce7b947be3fbcfe2f9 ^"Blessed Relief of the Benighted Reins" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "Rego Corpus 25 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Cast on a patient suffering from a kidney stone, the stone is removed from the patient’s body and appears in the hand of the caster. The “surgery” requires an Intelligence + Finesse roll against an Ease Factor of 12; failure indicates that the stone remains within the target’s body.\n\n(Base 15, +1 Touch, +1 Part)"
    }

    #t148cb33f3e51389f74c2e3 ^"Sever the Unwanted Limb" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Rego Corpus 25 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "One of the target’s limbs is amputated cleanly and painlessly, without bleeding. The amputation requires an Intelligence + Finesse roll against an Ease Factor of 12; failure indicates that the target is left intact. If this roll succeeds, the target acquires the Lame or Missing Hand Flaw. If used instead of surgical intervention, the patient’s failed Recovery roll is treated as a stable result instead.\n\n(Base 20, +1 Touch)"
    }

    #t4201b02edd6e83d31e2bf9 ^"Conjuration of Wild Thyme" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Creo Herbam 20 R: Touch, D: Mom, T: Group, Ritual"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Creates ten thousand doses of wild thyme, prepared and dried and ready to use. A different spell is required to create each type of herb.\n\n(Base 2, +1 Touch, +2 Group, +3 size)"
    }

}
