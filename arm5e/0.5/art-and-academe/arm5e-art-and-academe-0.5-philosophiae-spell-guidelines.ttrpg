EXTENSION "ArM5_Art_Academe_Philosophiae_SpellGuidelines" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Three: Philosophiae spell guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The chapter's spell guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tde8767c080ee01d435adc6 ^"Rego Animal Guidelines (Art & Academe, Generating Worms)" DEF {
        EXTENDS #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Printed Name" STRING "New Rego Animal Guideline"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 30
        }
        GUIDELINES {
            "Level 5" "Cause vermin to spontaneously generate in appropriate matter, such as flesh, plants, soil, or water."
        }
        DESCRIPTION "A requisite is required for the substrate that gives rise to the worms only if the caster cannot perceive the worms when they are generated. Thus, a Corpus requisite is needed to create intestinal worms, but not fleas or lice. To create worms from living flesh, a Perdo requisite is required to rot the flesh first."
    }

    #t4479a6d966b0f349a4c71d ^"Creo Mentem Guidelines (Art & Academe, Magic Affecting Conscience)" DEF {
        EXTENDS #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Printed Name" STRING "Creo Mentem Guidelines"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 35
        }
        GUIDELINES {
            "Level 10" "Spark a twinge of conscience in an intelligent being’s mind, overriding the temporary obsession of a demon."
        }
    }

}
