EXTENSION "ArM5_Art_Academe_Universities_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Seven: Universities virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_Art_Academe_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #tf9b9099d169868eb051c73 ^"Baccalaureus" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "The character has completed a three-year program at a university to receive a baccalarius artium (Bachelor of Arts degree). He is typically between 16 and 19 years old, and has 90 experience points that he may spend on Latin and Artes Liberales — 30 experience points per finished year of studies. His future decisions are varied once he gains his degree: he can extend his university career, teaching extraordinary lectures as he works toward his magister in artibus degree; teach in a cathedral or secular school; become a private tutor for a noble family; or find work in ecclesiastical or secular circles. The character has an Academic Reputation of 1.\n\nThis Virtue is compatible with the Hermetic Magus, Mendicant Friar, and Priest Virtues."
    }

    #t0950dc350a3e70c2ee1218 ^"Beadle" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is an assistant to a university dean. He is a townsman or student of merit employed by the university to carry the university’s insignia in parades, collect dues and fines, read mandatory announcements at university congregations, and announce disputationes. The character may purchase Academic Abilities at character generation."
    }

    #t3f19d59949374a8602b262 ^"Cathedral School Master" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character teaches at a cathedral school, one of the many that dot Mythic Europe. He is at least (30 – Intelligence) years old and must have scores of 5 in Latin and Artes Liberales, and a Teaching of at least 3. He may learn any Academic Ability, and may teach it to his students. He is typically not a university man, but was instructed at a cathedral school. He receives 240 additional experience points, which may be spent on Academic Abilities and Teaching. The character has an Academic Reputation of 2.\n\nThis Virtue is compatible with the Baccalaureus and Priest Virtues. Characters with higher university degrees should take those Virtues instead; a magister or doctor gains no additional status from teaching at a cathedral school."
    }

    #t6605edac18fc4338c2cf8c ^"Doctor in (Faculty)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character has graduated from one of the higher faculties of a university, in medicine, civil or canon law, or theology, having already received his magister in artibus license, and may instruct fellow students. The character may teach anywhere, even at a university that he didn’t attend. This is the highest educational license in Mythic Europe. A\n\ndoctor of medicine is also titled magister in medicina (see Chapter Four: Medicine), having typically been taught in one of the southern universities.\n\nA character starting the game with this Virtue must be at least (27 – Intelligence) years old. He must have a score of 5 in Latin, Artes Liberales, and the Ability that correlates to his faculty degree. The character has spent ten years at a university and receives an additional 300 experience points, which must be spent on Latin and Academic Abilities. He also begins the game with an Academic Reputation of 3.\n\nLike other working characters, he must spend two seasons a year practicing his profession, either teaching or working in a secular or ecclesiastical court. Both the Wealthy Virtue and the Poor Flaw are allowable, but players must decide what calamity befell such an erudite scholar if he is Poor, for which he receives a Bad Reputation at a level of 2.\n\nThis Virtue is compatible with the Hermetic Magus, Mendicant Friar, and Priest Virtues."
    }

    #tb611504d69bd93fe84a562 ^"Jurist" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is a judge, advocate, or procurator — essentially a medieval lawyer in some capacity. At character generation he may purchase the Abilities Latin, Artes Liberales, and Civil and Canon Law. He is not necessarily university trained, having obtained his education through private schools, tutors, or a cathedral school, and need not have a degree. If he is a cleric, he works in an ecclesiastical setting: the papal curia, the College of Cardinals, or a bishop’s or archbishop’s office. If he is a layman, he works for a secular prince or town municipality.\n\nThis Virtue is compatible with the Baccalaureus, Magister in Artibus, and Doctor in (Faculty) Virtues, as a jurist *may* have a university education. It is also compatible with the Priest and Mendicant Friar Virtues."
    }

    #t4e882a9e92d62c35dd31c9 ^"Lupus (the Wolf)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is employed by the university to watch over the students and ensure that they speak only Latin in their colleges and hostels. He is a member of the urban community where the university is located. He may begin play with scores in Latin or Artes Liberales, although a score of more than 1 in Artes Liberales would be rare. He may live with the students if he is unmarried, but if he has a family then he lives with them, possessing keys to the students’ housing to allow unannounced entry."
    }

    #tdf0d5106820ff016e08894 ^"Magister in Artibus (Art & Academe)" DEF {
        EXTENDS #tevkuWprCcXLN3IeH8T0sk0B ^"Magister in Artibus"
        PROPERTIES {
            ^"Printed Name" STRING "Magister in Artibus"
            ^"Printed Type Line" STRING "Existing Social Status, Major"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "In addition to the description of this Virtue in the regular rules (**ArM5**, page 45), the character begins with an Academic Reputation of 2. This Virtue is compatible with the Hermetic Magus, Mendicant Friar, and Priest Virtues."
    }

    #td777e8abae68d4531f8b0b ^"Nuntius" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Free"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is a *nuntius* (messenger), charged with delivering messages, mail, and monetary donations between students and their families. He is employed by a university nation and is not necessarily educated. He is affected by the Wealthy Virtue and Poor Flaw as normal. The character can be either male or female, although travel is obviously more dangerous for a lone female."
    }

    #tccc407ab9dfaebfe193182 ^"Prestigious Student" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The character is a son of a nobleman or a prosperous merchant, matriculated in a university that specializes in either Civil Law or\n\nMedicine. He has a small group of retainers with him, two or three servants who attend to his needs while at the university. He was trained in Artes Liberales and Latin by a private tutor, and may purchase Academic Abilities at character generation. The character must take a Social Status Virtue to reflect where he is in the educational process."
    }

    #te0df1f62e657c37397f222 ^"Simple Student" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character is a university student who is has not yet taken a degree. He is typically between 14 and 16 years old and somewhere along his university program. He receives 30 experience points per finished year that he can apply to Latin or Artes Liberales. If he has finished his second year of studies, he is in the liminal position of either applying for work or continuing his education.\n\nMore than half of all university students are Simple Students."
    }

    #t5609d69122c66ebfe37432 ^"University Grammar Teacher" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character is employed by a university to teach its younger members grammar. The character can be of any age and either gender. He may purchase the Academic Abilities: Latin and Artes Liberales at character generation, and should have a score in Teaching. He must teach two seasons out of the year."
    }

    #t219696294d5e2914d3175a ^"Failed Student" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Story"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character has studied for a specific university license and failed his final examination. If he passed earlier exams, he may have a scholastic Social Status Virtue showing how far he got. (Obviously, this cannot be Doctor in (Faculty).) The character has a Bad Academic Reputation of 2."
    }

    #t404c6b7214bb6c4b61da84 ^"Poor Disputer" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character has a difficult time with disputationes and suffers a –3 penalty on disputatio die rolls."
    }

    #t1807fb13c8b0c4180faec9 ^"Rector/Proctor" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Story"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character is the representative leader of his faculty or nation, depending on whether he is a master or a student. He is responsible for his colleagues’ behavior and is obliged to deal with their academic\n\nconcerns. The character must have a Social Status Virtue dictating his place within the university. The character can expect to spend considerable time sorting out his fellows’ affairs."
    }

    #t06af4b071c4d73820feead ^"University Dean" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Story"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The character is the head of a university, having already acquired his doctor in (faculty) license. The character has been chosen to lead the university, overseeing external affairs with the town and internal affairs between students and masters. Though prestigious, the position imposes serious demands on the character’s time. The character can expect many interruptions in his teaching during the school year. The character must have the Virtue: Doctor in (Faculty), be at least 40 years old, and can not have the Poor Flaw or any other Flaw that grants a Bad Reputation."
    }

}
