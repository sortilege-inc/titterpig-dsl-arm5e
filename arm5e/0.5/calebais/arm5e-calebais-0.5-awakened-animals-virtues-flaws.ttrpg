EXTENSION "ArM5_Calebais_AwakenedAnimals_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Calebais - Appendix: Awakened Animals virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t14e96010c5afec425cbf53 ^"Animula" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Major Status Flaw (Required)"
            ^"Size" STRING "Major"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "You are an animal that has been granted magical intelligence by a benevolent magus. Few people at your covenant treat you with respect, and you are usually considered a lesser person, in many ways a natural slave or servant. Outside the covenant, you frighten people so terribly that they probably attack you on sight. This flaw essentially encompasses three minor flaws: Judged Unfairly, Feral Upbringing, and Social Handicap, all of which you possess, though their penalties vary depending and are magnified when you are among humans or normal animals of your species. You age as an animal, not a human, so you may begin making aging rolls much earlier in life. Finally, you have Magic Might equal to 10 – your Size (add your Size if it is negative), and if killed your corpse could contain a number of pawns of vis equal to your Magic Might divided by 5, of an Art appropriate to your form."
    }

    #t0df0f33cf43bed2fa4c083 ^"Greater Powers" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Major General Virtues"
            ^"Size" STRING "Major"
            ^"Category" STRING "General"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "You were imbued with great powers by the wizard who awakened you. Take up to 60 spell levels in magical effects, or spend 10 of these levels to reduce the cost of one of your powers by 1 point, though not below 0. You may take this Virtue more than once."
    }

    #teb71d1c935ba59286f743c ^"Ferocity (Calebais)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor General Virtues"
            ^"Printed Name" STRING "Ferocity"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "Like companion and magus characters, you have Confidence points, even though you are only a grog. However, your Confidence points may be used only in situations where your natural animal ferocity is triggered, such as when defending your den or fighting a natural enemy. Describe a situation that activates your Confidence, and take three points for you to use when those circumstances are met."
    }

    #t87ea39de657d8c1ea06d6e ^"Improved Might (Calebais)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor General Virtues"
            ^"Printed Name" STRING "Improved Might"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "You have twice as much Magic Might as is normal for animals of your species; add (10 - your Size) to the amount of Magic Might with which you begin the game."
    }

    #t55f60733885f4203e45cf6 ^"Lesser Powers" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor General Virtues"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "Your master imbued you with supernatural powers during your awakening ritual. Take up to 10 spell levels in magical effects, or reduce the cost of one of your powers by 1 point (though not below 0). You may take this Virtue as many times as you wish."
    }

}
