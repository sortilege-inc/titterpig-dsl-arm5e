EXTENSION "ArM5_Calebais_Introduction_Tables" {
    NAME "Ars Magica Fifth Edition, Calebais - Introduction: The Covenant of Calebais tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t28c4c5c198b8e13fc163e2 ^"Characters (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Chapter", "Page", "Character", "Notes"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the box it stands in"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 9
        }
        TABLE {
            "CHAPTER ONE" "11" "Ash, Redcap" "Respects magi and the Order, dislikes being taken for granted"
            "CHAPTER ONE" "16" "young woman" "Father killed, lover injured, pregnant, held by faerie curse"
            "CHAPTER ONE" "16" "murdered man" "Killed by satyrs in the forest while protecting daughter"
            "CHAPTER ONE" "16" "young man" "Injured protecting lover, resting at abbey, lost memory, heard the Bell"
            "CHAPTER ONE" "16" "Father Eric, abbot" "Angry with the reeve for stirring up the village, assumes girl fled"
            "CHAPTER ONE" "16" "Stephen, reeve" "Investigating murder and abduction, believes great evil in forest, dislikes the abbot"
            "CHAPTER ONE" "21" "Sir Gilbert" "Friendly knight-errant, seeks dragon, knows four of the guides"
            "CHAPTER ONE" "21" "Luc, adviser" "Distrusts characters, protects Sir Gilbert"
            "CHAPTER ONE" "22" "Paul, squire" "Enthusiastic and awkward, serves Sir Gilbert and Luc"
            "CHAPTER ONE" "18" "Boch, satyr" "Speaks for the satyrs, misses the dryad, explains the abduction and the faerie curse"
            "CHAPTER ONE" "29" "dryad" "Controls the Veil, lonely, can only leave the fountain in spirit unless freed"
            "CHAPTER TWO" "42" "Dargaud, ghost" "UnGifted Redcap, sneaky, throws rocks, freed when he understands what happened"
            "CHAPTER TWO" "40" "Ornath, magus" "Quaesitor, disliked Crenvalus, left the covenant, headed its investigation"
            "CHAPTER TWO" "44" "Paulo, ghost" "Crenvalus’s muddled shield grog, war hammer, freed by protecting Calebais"
            "CHAPTER TWO" "47" "Josephine, ghost" "Grog, thief, grieving, freed by rescuing her son Gemaric"
            "CHAPTER TWO" "48" "David, ghost" "Captain; practical; magic armor, sword, shield; freed by killing Crenvalus"
            "CHAPTER TWO" "51" "Gemaric" "Transformed child, now an intelligent rock, has little legs, flees"
            "CHAPTER TWO" "52" "Igack, fire drake" "Pitsdim’s familiar, breathes fire, has a diadem"
            "CHAPTER TWO" "54" "Ferdina, ghost" "Former autocrat, gentle, burned, chime, freed by respect from magi"
            "CHAPTER TWO" "58" "Mormulus, ghost" "Merinita illusionist, lost in dream world, freed by remorse"
            "CHAPTER TWO" "61" "Ierimyra, ghost" "Bjornaer, mother of the Hrools, scholarly, freed by her children’s safety"
            "CHAPTER TWO" "66" "Pitsdim, ghost" "Ignem Flambeau, insane, freed by burning to death"
            "CHAPTER TWO" "80" "Larine, nun" "Librarian, David’s lover, fled Calebais to nunnery with Crenvalus’s letter"
            "CHAPTER TWO" "69" "Althea, ghost" "Lab assistant, freed by satiating her hunger"
            "CHAPTER TWO" "74" "Granorda, ghost" "Necromancer, paranoid, freed by making her corpse safe"
            "CHAPTER TWO" "75" "Crenvalus, ghost" "Rego master, crafty, killed David, fears Larine and his letter"
            "CHAPTER TWO" "76" "Uderzus, ghost" "Tests the characters, magical lance, freed by answers to his questions"
            "CHAPTER THREE" "82" "Hedwig, abbess" "Authoritative, dignified, has a letter from Sister Larine"
            "CHAPTER THREE" "83" "Palona, advocate" "Nun, divides life into good and evil, aids Sister Hedwig"
            "CHAPTER THREE" "84" "Alice, visionary" "Saintly nun, has Faith and holy visions, aids Sister Hedwig"
            "CHAPTER THREE" "84" "Malores, mute" "Faerie nun, mute, worships the moon at night"
            "CHAPTER THREE" "85" "Nadaline, cook" "Larine’s closest friend, doesn’t answer questions, hard worker"
            "CHAPTER THREE" "88" "Raphael" "Fled his lord’s wrath, took sanctuary in the convent stables"
            "CHAPTER THREE" "88" "Father Martin" "Priest for the convent, dour, dislikes strangers, harsh confessor"
        }
    }

}
