EXTENSION "ArM5_Calebais_TheLegacyOfCalebais_SisterHedwigAbbess" {
    NAME "Ars Magica Fifth Edition, Calebais - Sister Hedwig, abbess"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # Sister Hedwig, abbess (Chapter Three: The Legacy of Calebais, p82): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t55901b20ca1654596ed9b3 ^"Sister Hedwig, abbess" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t7116114bca0e93a07cef25 ^"The Convent"]
            ^"Characteristics" STRING "Int +1, Per -1, Pre +1, Com +1, Str -3, Sta +1, Dex -2, Qik -2"
            ^"Age" STRING "58"
            ^"Personality Traits" STRING "Authoritative +3, Careful +3, Kind +2"
            ^"Appearance" STRING "The abbess is a stocky woman in her late fifties who retains the energetic poise and demeanor of her youth. Her hair is well groomed, and her voice is strong and authoritative. Her majestic frown betrays what she thinks of inefficiency or lack of ability in others."
            ^"Roleplaying Tips" STRING "Speak with a deep, steady tone and use a voice that says “obey me” without seeming overbearing. Your gaze should be steady and your face full of dignity. Sister Hedwig is sharp and direct, but also wise and very kind. She will allow no mischief within her convent walls."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "Sister Hedwig, abbess"
    }

}
