EXTENSION "ArM5_Calebais_TheLegacyOfCalebais_SisterPalonaAdvocate" {
    NAME "Ars Magica Fifth Edition, Calebais - Sister Palona, advocate"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # Sister Palona, advocate (Chapter Three: The Legacy of Calebais, p83): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tc321dc08c69f5e6ac9c098 ^"Sister Palona, advocate" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t7116114bca0e93a07cef25 ^"The Convent"]
            ^"Characteristics" STRING "Int +2, Per +2, Pre -3, Com +2, Str -3, Sta -3, Dex -2, Qik -2"
            ^"Age" STRING "61"
            ^"Personality Traits" STRING "Devoted +1, Calm -3, Nice -3"
            ^"Appearance" STRING "Sister Palona walks hunched over with a limp, and has a small round nose which is frequently reddened and raw as she is often sick. She is strident and shrill, and gesticulates with wide, aggressive gestures when she speaks."
            ^"Roleplaying Tips" STRING "No matter what anyone else says, react to it as badly as you can, and let your thoughts show clearly on your face. Stare people in the eye, as that’s the best way to see into their hearts, but look away disdainfully if they stare back. Remember that even though you are vile and constantly suspicious, you’re also a nun."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Sister Palona, advocate"
    }

}
