EXTENSION "ArM5_Calebais_TheMysteryOfCalebais_SirGilbert" {
    NAME "Ars Magica Fifth Edition, Calebais - Sir Gilbert"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # Sir Gilbert (Chapter One: The Mystery of Calebais, p21): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t275ecffe6bbfdc87563687 ^"Sir Gilbert" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t4d3405531e0695c0117ba1 ^"Sir Gilbert’s Camp"]
            ^"Characteristics" STRING "Int -1, Per -3, Pre 0, Com +2, Str +3, Sta +2, Dex +1, Qik +1"
            ^"Age" STRING "25"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Knight; Lesser Immunity (fear), Relic (x3); Pious; Humble; Visions"
            ^"Personality Traits" STRING "Brave +5, Friendly +2, Honorable +2, Wise -1"
            ^"Reputations" STRING "Brave knight 3 (local area), Pious 2 (local churches)"
            ^"Combat" STRING "Long Sword and Heater Shield: Init +3, Attack +11, Defense +14, Damage +11 Long Sword and Heater Shield (mounted): Init +3, Attack +14, Defense +17, Damage +11 Lance and Heater Shield (mounted): Init +4, Attack +13, Defense +17, Damage +12"
            ^"Soak" STRING "+14"
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "Athletics 2 (climbing), Carouse 1 (staying sober), Charm 4 (gentlefolk), Folk Ken 3 (motivations), Great Weapon 5 (lance), Leadership 3 (small groups), Local Language 5 (straight talk), Magic Lore 2 (creatures), Ride 4 (combat), Single Weapon 5 (long sword)"
            ^"Equipment" STRING "Full chain mail, helmet, heater shield, holy long sword"
            ^"Encumbrance" STRING "0 (3)"
            ^"Appearance" STRING "Sir Gilbert is a large, burly man who appears slightly unkempt, his hair mussed and his beard slightly untrimmed. He nevertheless has polite manners despite his unrestrained demeanor. He is tall with blue, childlike eyes and straw-colored hair."
            ^"Roleplaying Tips" STRING "Imagine a friendly, slightly overbearing country sheriff; strap on a sword, and you have Sir Gilbert. He is pleasant company, very good in a fight, and yet still strangely humble. He is pious, but he is also good-naturedly tolerant of things that are strange to him. The characters should find they like him, even if they would normally be at odds with such a figure. Though he is something of a caricature, try to roleplay him as honestly as you can."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Sir Gilbert"
    }

}
