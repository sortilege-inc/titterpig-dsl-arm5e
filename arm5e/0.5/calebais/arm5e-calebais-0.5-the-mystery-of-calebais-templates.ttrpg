EXTENSION "ArM5_Calebais_TheMysteryOfCalebais_Templates" {
    NAME "Ars Magica Fifth Edition, Calebais - Chapter One: The Mystery of Calebais templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #tf06904d571c68b256c0d9d TEMPLATE "Sir Gilbert’s Men" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per +1, Pre 0, Com 0, Str +1, Sta +1 Dex +1, Qik 0"
            ^"Personality Traits" STRING "Brave +1, Loyal +1"
            ^"Combat" STRING "Long spear: Init -2, Attack +7, Defense +9, Damage +7 Crossbow: Init -5, Attack +8, Defense +2, Damage +10"
            ^"Soak" STRING "+5"
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "Awareness 4 (searching), Bows 3 (crossbow), Carouse 2 (camping), Great Weapon 4 (spear), Hunt 5 (tracking), Survival 3 (woods)"
            ^"Equipment" STRING "Full leather armor, helmet, long spear, crossbow"
            ^"Encumbrance" STRING "2 (3)"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Sir Gilbert’s Men"
    }

}
