EXTENSION "ArM5_Calebais_TheRuinsOfCalebais_Althea" {
    NAME "Ars Magica Fifth Edition, Calebais - Althea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_Calebais_Core_Ext"

    # Althea (Chapter Two: The Ruins of Calebais, p69): one being, its printed stat lines verbatim fields.

    #ta60fe898d884ed0dd8f5ef ^"Althea" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#tec3564f3c6d1cd90fd1cfd ^"Ventus Gurges’s Laboratory"]
            ^"Covenant" LIST [#t3258eeb24aa00a2434f405 ^"Calebais"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 15
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER -3
                ^"Stamina" INTEGER -2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 0
            }
            ^"Age" STRING "(70)"
            ^"Decrepitude" STRING "3"
            ^"Size" INTEGER 0
            ^"Soak" INTEGER -2
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (1620)"
            ^"Powers" STRING "Possession, 3 points, +0, Mentem: Althea can take over a living body as if it were her own. Each round, the victim may make an Intellegence roll to resist, adding an appropriate Personality trait (e.g. Rebellious). On a 9+, she is driven out. On a 6+, the two wills are in conflict and neither may act. Otherwise, Althea may use the body as she wishes."
            ^"Vis" STRING "3 Corpus in her corpse if she manages to eat something"
            ^"Appearance" STRING "Althea is an elderly, emaciated woman in rags, hobbling on her cruelly fractured left leg, her eyes wild with hunger."
            ^"Roleplaying Tips" STRING "Let your head dangle from your neck, and speak in a raspy, trembling voice. Stop speaking entirely every few seconds and look woeful."
            ^"What She Knows" STRING "Althea was a relative of Ventus Gurges and came to work at the covenant late in her life, not long before the Sundering. She rarely left his laboratory, eating meals in her living quarters, and thus does not know much about the covenant. She does know that an earthquake killed her master and flooded the well, and that most of the lab notes she copied are kept in the library. She remembers seeing a text about a magical bell, though she recalls nothing of the substance."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 69
        }
        PERSONALITY_TRAITS {
            "Forgiving" -2
            "Hopeful" -2
            "Brave" -3
        }
        COMBAT {
            "Dodge" INIT 0 ATTACK 1 DEFENSE 0 DAMAGE -3
        }
        ABILITIES {
            "Artes Liberales" SCORE 4 SPECIALTY "mathematics"
            "Bargain" SCORE 4 SPECIALTY "food"
            "Charm" SCORE 4 SPECIALTY "begging"
            "Church Lore" SCORE 3 SPECIALTY "schools"
            "Concentration" SCORE 4 SPECIALTY "writing"
            "Latin" SCORE 5 SPECIALTY "reading"
            "Local Area Lore" SCORE 3 SPECIALTY "history"
            "Local Language" SCORE 5 SPECIALTY "academia"
            "Magic Lore" SCORE 3 SPECIALTY "creatures"
            "Magic Theory" SCORE 2 SPECIALTY "writing"
            "Order of Hermes Lore" SCORE 2 SPECIALTY "labs"
            "Philosophiae" SCORE 2 SPECIALTY "moral"
            "Profession: Scribe" SCORE 6 SPECIALTY "Hermetic books"
            "Theology" SCORE 4 SPECIALTY "history"
        }
    }

}
