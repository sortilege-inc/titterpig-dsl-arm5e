    # Igack, a Fire Drake (Chapter Two: The Ruins of Calebais, p52): one being, its printed stat lines verbatim fields.

    #t6b460c5d0d389e7d7e7adc ^"Igack, a Fire Drake" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t51abbcb1c81d6549752fd3 ^"Small Storage Room"]
