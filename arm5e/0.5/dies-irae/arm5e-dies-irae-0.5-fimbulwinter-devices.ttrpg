EXTENSION "ArM5_Dies_Irae_Fimbulwinter_Devices" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Three: Fimbulwinter: The Cold Doom devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #td5ed9e35b86f02854e1a1a ^"Chime of a Sunken Spring Day" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Printed Effect Line" STRING "CrIg 24 Pen +0, 1/day R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 70
        }
        DESCRIPTION "Ringing this handbell and setting it against the wall of a structure fills the structure with warmth equivalent a pleasant, balmy, late spring afternoon.\n\n(Effect: 2, +1 Touch, +2 Sun, +3 Struct; +1 for 2/day use, +3 Environmental Trigger: Sunrise/set)"
    }

    #t1f91caa3af902ac5619b7c ^"Chimes to Mark the True Time" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Printed Effect Line" STRING "CrIg 25 Pen +0, 1/day R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 70
        }
        DESCRIPTION "Ringing this handbell and setting it against the wall of a structure fills it with soft light equivalent to torchlight. A covenant would probably desire two of these items to help maintain a schedule underground, but the second would only need to be level 20, as the light provided would be no greater than candlelight to avoid excessively interfering with sleep patterns.\n\n(Effect: 3, +1 Touch, +2 Sun, +3 Struct; +0 for 1/day use)"
    }

}
