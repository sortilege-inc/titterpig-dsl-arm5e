EXTENSION "ArM5_Dies_Irae_Fimbulwinter_LeifOrmsbrodirYoungMuspelliOfNidhoggEtinMod" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Leif Ormsbrodir: Young Muspelli of Nidhogg, Etin-mod"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # Leif Ormsbrodir: Young Muspelli of Nidhogg, Etin-mod (Chapter Three: Fimbulwinter: The Cold Doom, p71): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tbb76b38b86f53a9ed2af8e ^"Leif Ormsbrodir: Young Muspelli of Nidhogg, Etin-mod" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0 Per +1 Pre 0, Com –1, Str +4, Sta +3, Dex +2, Qik +2"
            ^"Size" STRING "+3"
            ^"Age" STRING "31"
            ^"Warping Score" STRING "0"
            ^"Gleipnir Score" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Muspelli; Giant Blood, Greater Immunity (Exposure & Sleep), Greater Magical Defenses; Improved Characteristics, Tough, Warrior; Curse of Venus, Overconfident; Susceptibility to Infernal Power, Weakness (Women), Visions"
            ^"Qualities" STRING "Aquatic, Claws, Fins, Good Jumper, Tireless, Tough Hide"
            ^"Personality Traits" STRING "Overconfident +3, Contemplative +2"
            ^"Combat" STRING "Axe & Round Shield: Init +3, Attack +11, Defense +9, Damage +10 Bludgeon: Init +2, Attack +8, Defense +6, Damage +6 Claws: Init +2, Attack +10, Defense +9, Damage +8 Dodge: Init +2, Attack N/A, Defense +6, Damage N/A Fist: Init +2, Attack +7, Defense +7, Damage +4"
            ^"Soak" STRING "+14"
            ^"Fatigue Levels" STRING "OK, 0, 0, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32), Dead (33+)"
            ^"Abilities" STRING "Area Lore: Baltic Sea 2 (Coasts), Athletics 2 (running), Awareness 2 (searching), Brawl 4 (Fist), Carouse 1 (power drinking), Concentration 2 (spell concentration), East Norse 5 (storytelling), Finesse 2 (accuracy), Folk Ken 2 (peasants), Guile 2 (lying about motives), Hunt 2 (covering tracks), Jotun 2 (deference), Magic Lore 1 (heipt), Organization Lore: Muspelli 4 (initiation), Single Weapon 4 (axe), Penetration 2 (Winter’s Breath), Stealth 3 (hiding within forests), Survival 2 (arctic), Swim 2 (underwater)"
            ^"Supernatural Abilities" STRING "Animal Ken 6 (orcas), Shapeshifter 10 (birds), Sjonhverfing 6 (mists), Summon Animals 6 (sharks), Wildfire 5 (pyrotechnic tricks), Winter’s Breath 10 (snow);"
            ^"Equipment" STRING "axe, full leather armor, gandur of a serpent’s tooth (+1 to his Power Modifier), round shield"
            ^"Utiseta Held in Gandur" STRING "Scion of Jorgmandir. Leif can take the form of a lindwurm as detailed on Realms of Power: Magic, page 78. (Shapeshifter 27, +5 size) This form is resisted by the Parma, as it is an ongoing utiseta."
            ^"Encumbrance" STRING "6 (0)"
            ^"Appearance" STRING "In etin-mod, Leif appears to be some form of man-like orca whale, with fins, teeth, claws, standing at a towering 12 feet tall. His thick claws are webbed, and he has fins across his forearms and the crest of his head. His wide mouth is full of small, sharp teeth, and his large eyes are black. Leif’s leathery hide is very similar to an orca’s coloration. He looks very much like the creature on page 85 of Rival Magic."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 71
        }
    }

}
