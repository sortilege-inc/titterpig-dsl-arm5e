EXTENSION "ArM5_Dies_Irae_Fimbulwinter_VisSources" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Three: Fimbulwinter: The Cold Doom vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t1ae7a544cd7eab507a6952 ^"The Irminsul" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Rego"
            ^"Yield" LIST OF STRING ["5 pawns of Rego per year"]
            ^"Build Points" INTEGER 25
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "This small stele is carved to resemble a tree with nine branches, and a split, fluted top, vaguely resembling a letter “T” or an uppercase letter “I.” Its sides have faded, nearly imperceptible Futhark runes. In midwinter, if it is festooned with boughs of holly, ivy, mistletoe, yew, and pine, the branches contain the vis after the Solstice. Otherwise, the vis gathers in icicles which form on the split arms. There is a Magic aura of 2 here.\n\nThis source costs 25 Build Points."
    }

    #t4dc0eb067a0e96fc70a87f ^"Sunstone Quarry" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Printed Name" STRING "Vis Site: Sunstone Quarry"
            ^"Art" STRING "Intellego"
            ^"Vis Kind" STRING "Lesser Enchantment Pawns of Intellego Vis"
            ^"Effect Technique" STRING "Intellego"
            ^"Effect Form" STRING "Ignem"
            ^"Effect Level" INTEGER 25
            ^"Printed Effect Line" STRING "InIg Level 25 Pen 0, constant effect R: Touch, D: Sun, T: Vision"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 53
        }
        DESCRIPTION "Cut from a vein of high quality crystal, these rhomboid-shaped calcite stones allow the bearer to always know the direction of the Sun. They are immensely useful for navigators and travelers in snowbound regions with little in the way of landmarks, as viewing an overcast daytime sky through these objects allows the bearer to ascertain the Sun’s position and avoid accidentally going the wrong way."
    }

    #t8587729e542597e8c336d5 ^"Magical Honeycomb" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Printed Name" STRING "Vis Site: Magical Honeycomb"
            ^"Art" STRING "Rego"
            ^"Vis Kind" STRING "Spell-like Pawns of Rego Vis"
            ^"Effect Technique" STRING "Rego"
            ^"Effect Form" STRING "Animal"
            ^"Effect Level" INTEGER 45
            ^"Printed Effect Line" STRING "ReAn Level 45 Pen 10 R: Arc, D: Sun, T: Ind, Ritual"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 53
        }
        DESCRIPTION "This aromatic fragment of beehive still drips with tiny beads of honey. By placing an Arcane Connection to a particular beast (of Size +4 or less) inside the sticky beeswax, then crumpling the honeycomb into a ball and consuming the wax or destroying it in fire, the caster gains total control over the targeted creature until either the next sunrise or sunset.\n\n(Base 15, +4 Arc, +2 Sun, +1 Size)"
    }

}
