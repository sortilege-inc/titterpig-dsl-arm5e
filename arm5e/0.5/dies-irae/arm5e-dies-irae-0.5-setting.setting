        TAGS ["place"]
        LOCATION ^"The Underground Retreat" #t242ac48e4b7652aa0a8f68 {
            # p29
            TAGS ["place"]
        }
    }
    LOCATION ^"The Egesterenstein" #ta94659ccd80c682416e85d {
        # p63
        TAGS ["place"]
    }
    LOCATION ^"The Heart of Winter" #t247ba3f0da386a6ad343d7 {
        # p64
        TAGS ["place"]
    }
    LOCATION ^"The Fen" #tf4e2359c3dc0ddc232e44a {
        # p92
        TAGS ["place"]
        LOCATION ^"The Twilight Tear" #t7a7e28b13a62e980698579 {
