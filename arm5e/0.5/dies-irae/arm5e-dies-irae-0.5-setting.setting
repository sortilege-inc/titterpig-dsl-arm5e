SETTING "ArM5_Dies_Irae_Setting" {
    NAME "Ars Magica Fifth Edition, Dies Irae - places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"

    # HISTORY: The End of Time's timeline (box 'A Timeline', p18), each event as printed, its year the PERIOD.
    # LOCATION: the places the book prints as headings -- its four sagas are set anywhere in Mythic Europe, so there
    # is no root: The End of Time's observatory, laboratory, towns and Megiddo; Fimbulwinter's Egesterenstein and
    # Ingvar's redoubt; the Great Pestilence's fen and the Arcana Centrum; the Twilight of the Gods' Eastern
    # Bastion. A place's text is in its chapter's .lore, under its heading.

    HISTORY {
        ENTRY ^"1178" #t58204b1d7367364c2084f1 {
            PERIOD "1178"
            DESCRIPTION "A Criamon assault on Selene, the spirit of the moon, takes place in the Magic Realm. The assault is visible from Mythic Europe as a fire upon the moon’s surface that blazes for days"
        }
        ENTRY ^"1228" #t2cda3044ae55ff459254f1 {
            PERIOD "1228"
            DESCRIPTION "The Grand Tribunal"
        }
        ENTRY ^"1230" #t06079a03045137d1328990 {
            PERIOD "1230"
            DESCRIPTION "The Great Observatory is completed"
        }
        ENTRY ^"1231" #tb2306eb87939fb001dbced {
            PERIOD "1231"
            DESCRIPTION "The Axis Mundi is found"
        }
        ENTRY ^"1244" #t09a9f2104712440d239088 {
            PERIOD "1244"
            DESCRIPTION "The lost souls escape from Andreva’s laboratory"
        }
        ENTRY ^"1250" #t0189fb5fc3580de45bdd9d {
            PERIOD "1250"
            DESCRIPTION "Andreva finalizes the breakthrough to create the new Hermetic Form of Aether"
        }
        ENTRY ^"1250 (2)" #tfb7b25b602d6e7730fcbc0 {
            PERIOD "1250"
            DESCRIPTION "A star apparently falls to Earth"
        }
        ENTRY ^"1263" #td0f2dc4219ceb757b0efd9 {
            PERIOD "1263"
            DESCRIPTION "The Tribunal of 1263"
        }
        ENTRY ^"1263 (2)" #tf079776c1c7a725b9f7876 {
            PERIOD "1263"
            DESCRIPTION "Knowledge of the new Form of Aether starts to spread into House Criamon"
        }
        ENTRY ^"1265" #t4a4f76779360ab3c7743c5 {
            PERIOD "1265"
            DESCRIPTION "The Last Wizard War"
        }
        ENTRY ^"1270" #t6211db35575cef170bd6b0 {
            PERIOD "1270"
            DESCRIPTION "The Tribunal of 1270"
        }
        ENTRY ^"1272" #t6d0e94eb4879e62edb12fd {
            PERIOD "1272"
            DESCRIPTION "The magi of House Criamon retreat"
        }
        ENTRY ^"1272 (2)" #tf9945d9a339c6c02bf2617 {
            PERIOD "1272"
            DESCRIPTION "Work starts on the ritual to becalm the heavens"
        }
        ENTRY ^"1272 (3)" #t2f40da8cee73a6f246c66a {
            PERIOD "1272"
            DESCRIPTION "Selene, spirit of the moon, sets out to die"
        }
        ENTRY ^"1277" #t0e025c58212c46cc2cec4b {
            PERIOD "1277"
            DESCRIPTION "The Tribunal of 1277 – the Criamon are missing"
        }
        ENTRY ^"1277 (2)" #t89ad7bb52c6c4565246b4f {
            PERIOD "1277"
            DESCRIPTION "December 23rd, the day of the Apocalypse"
        }
        ENTRY ^"1277 (3)" #t43c60328d60145fc48d2af {
            PERIOD "1277"
            DESCRIPTION "Wormwood Falls"
        }
    }

    LOCATION ^"The Great Observatory" #t756f41fce735d24d67f595 {
        # p19
        TAGS ["place"]
    }
    LOCATION ^"Andreva’s Laboratory" #td2bd956871f5cbba2c2d00 {
