EXTENSION "ArM5_Dies_Irae_TheEndOfTime_Diseases" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Two: The End of Time diseases"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's diseases, structured; each DESCRIPTION the source's text, verbatim.

    #t506cb90444e199821f41ac ^"The Lunar Infection" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Critical"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 18
            ^"Stable Ease Factor" STRING "6"
            ^"Improvement Ease Factor" STRING "18"
            ^"Interval" STRING "Week"
            ^"Cause" STRING "Contra-Natural"
            ^"Symptoms" STRING "The veins around the site of first infection grow hard and blackened, visible through the skin. At the end of the incubation period (typically a few days), the individual is unable to move or use that part of their body. These veins soon extrude through the skin and latch onto the ground or other hard surface, locking the infected individual into place. As the disease progresses, more of the body becomes paralyzed until the individual ultimately dies. Each time the infected character fails a recovery roll, their most distinctive Personalty Trait gains or loses a point such that it approaches a score of zero, representing the gradual erosion of their consciousness."
            ^"Printed Stat Line" STRING "Critical Sanguine Disease, Severity 18 Stable 6, Improve 18, Interval: Week"
            ^"Rules Section" STRING "The Lunar Infection"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "This disease is the result of coming into contact with a lunar Spore. The spore grows throughout the body. (Contra-Natural)"
    }

}
