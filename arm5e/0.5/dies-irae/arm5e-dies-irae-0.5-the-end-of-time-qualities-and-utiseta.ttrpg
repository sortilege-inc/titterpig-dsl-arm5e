EXTENSION "ArM5_Dies_Irae_TheEndOfTime_QualitiesAndUtiseta" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Two: The End of Time qualities and utiseta"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's qualities and utiseta, structured; each DESCRIPTION the source's text, verbatim.

    #t85f596bfa337b172dbb553 ^"Lunar" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "New Animal Quality: Lunar"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "A Lunar creature is invisible apart from its eyes and mouth, which glow with lunar light. Its body dissolves quickly after death, fading into intangible aether. If the creature normally leaves vis behind, this must be collected quickly or else it is scattered on the winds.\n\nThe attacks of Lunar creatures sap their victim’s will. For each point of wound penalty inflicted, the victim loses one point off their highest Personality Trait. The Lunar creature may then use that point like a point of Ferocity. Should the victim survive the encounter, these lost Personality Trait points are recovered as the associated wounds heal.\n\nA Lunar creature is immune to harmful effects of water and plants from its own Sphere."
    }

}
