EXTENSION "ArM5_Dies_Irae_TheEndOfTime_TheSpiritOfBitterLoneliness" {
    NAME "Ars Magica Fifth Edition, Dies Irae - The Spirit of Bitter Loneliness"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The Spirit of Bitter Loneliness (Chapter Two: The End of Time, p20): one being, its printed stat lines verbatim fields.

    #t09a86fafd4859f21d38787 ^"The Spirit of Bitter Loneliness" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 15
            ^"Form" STRING "Mentem"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Magic Spirit; Self Confident; Meddler (Minor)"
            ^"Magical Qualities and Inferiorities" STRING "Greater Power (Sweet Touch of Bitterness), Greater Power (Control Human); Lesser Power (Donning the Corporeal Veil), Minor Virtue: Improved Characteristics x3"
            ^"Soak" INTEGER 2
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16), Dead (17+)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Vis" STRING "3 pawns of Mentem, as an immaterial corpse"
            ^"Appearance" STRING "This spirit appears as a wretched, unkempt, and malnourished man or woman."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 20
        }
        PERSONALITY_TRAITS {
            "Bitter" +3
            "Jealous" +2
        }
        COMBAT {
            "Dodge" INIT 1 DEFENSE 4
            " Claws" INIT 1 ATTACK 5 DEFENSE 5 DAMAGE 1
        }
        ABILITIES {
            "Awareness" SCORE 4 SPECIALTY "watching for strangers"
            "Brawl" SCORE 3 SPECIALTY "claws"
            "Folk Ken" SCORE 4 SPECIALTY "the low and wretched"
            "Guile" SCORE 4 SPECIALTY "its true nature"
            "Leadership" SCORE 4 SPECIALTY "intimidation"
            "Magic Lore" SCORE 3 SPECIALTY "ghosts"
            "Penetration" SCORE 4 SPECIALTY "Mentem"
            "Stealth" SCORE 4 SPECIALTY "dark corners"
            "Swim" SCORE 3 SPECIALTY "the ocean"
        }
        POWERS {
            #t409839aecb6fa286dc3159 ^"Sweet Touch of Bitterness" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The spirit raises feelings of bitterness in the target, giving the target a personality trait of Bitter +3. It uses this power before using *Control Human* as the *Bitter* Personality Trait works in the spirit’s favor. CrMe 15 (Base 4; +1 Touch, +2 Sun): Greater Power (15 levels, –1 Might cost, +3 Init)"
            }
            #t5a85db565cc74c37b3bb89 ^"Control Human (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Control Human"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Allows the spirit to control the actions of a target human, forcing them to violence and murder. See *Realms of Power: Magic*, page 101 for more details. ReMe 30 (Base 20, +1 Touch, +1 Conc): Greater Power (30 levels, –1 Might cost, +3 Init)"
            }
            #t1418cca8c68216a60b67ea ^"Donning the Corporeal Veil (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Donning the Corporeal Veil"
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "– 2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "the spirit manifests with the physical Characteristics given above. See *Realms of Power: Magic*, page 102 for more details."
            }
        }
        DESCRIPTION "Loneliness breeds bitterness and this spirit is driven by its bitterness, driven to protect its feelings of desolate despair."
    }

}
