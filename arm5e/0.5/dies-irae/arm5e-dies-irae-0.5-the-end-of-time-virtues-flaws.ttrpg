EXTENSION "ArM5_Dies_Irae_TheEndOfTime_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Two: The End of Time virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t7c21767305f2fee6ea0bf7 ^"Aetheric Magic" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "The Major Hermetic Virtue of Aetheric Magic grants knowledge of the new Hermetic Form of Aether. This represents a form of matter previously hidden from Hermetic magic but which exhibits great force over earthly phenomena, such as the tides, the fates of individuals, and even the rise and fall of sickness and madness. As such, Aether spells can be used to heighten or reduce the influence of the heavens, to create aetheric objects, or to make changes to the nature of aether itself.\n\nThe new Form is a full addition to Magic Theory and each of the Techniques can be applied to it in order to generate magical effects. The standard rules for accounting for rituals apply."
    }

}
