EXTENSION "ArM5_Dies_Irae_TheTwilightOfTheGods_BekkiAnAspectOfLoki" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Bekki, an Aspect of Loki"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # Bekki, an Aspect of Loki (Chapter Five: The Twilight of the Gods, p116): one being, its printed stat lines verbatim fields.

    #t993f9627b3c14b0413eeb1 ^"Bekki, an Aspect of Loki" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 25
            ^"Form" STRING "Corpus"
            ^"Season" STRING "Winter"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 5
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER -3
                ^"Stamina" INTEGER -1
                ^"Dexterity" INTEGER -1
                ^"Quickness" INTEGER -3
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Magic Spirit; Magical Covenfolk; Essential Virtue; Affinity with Intrigue, Great Intelligence x 2, Famous, Protection, Puissant Intrigue, Social Contacts; Dark Secret (true identity), Meddler; Fear (thunderstorms), Noncombatant, Palsied Hands, Poor Characteristics"
            ^"Magic Qualities and Inferiorities" STRING "Gentle Air, Greater Powers x 2, Major Virtue (Entrancement); Improved Abilities x 5, Improved Powers, Mentem Resistance, Minor Virtue (Good Teacher), Minor Virtue (Inspirational), Minor Virtue (Piercing Gaze), Personal Powers x 3"
            ^"Personality Traits" STRING "Consummate Liar (Communication) +6, Sly +6, Ingratiating +3, Smug +2, Brave 0 Essential Trait, replaces listed Characteristic whenever Trait applies."
            ^"Reputations" LIST ["Royal Counselor 3 (Nobility)"]
            ^"Soak" INTEGER -1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Vis" STRING "5 pawns of Corpus vis, in clothing."
            ^"Appearance" STRING "Bekki takes the semblance of a man in his sixties, hale but slow and slightly trembling. He wears rich clothes but in muted colors so that he does not stand out. His hair is gray but shows signs of its original auburn color at the temples."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 116
        }
        COMBAT {
            "Walking Stick (bludgeon)" INIT -3 ATTACK 4 DEFENSE 0 DAMAGE -1
        }
        ABILITIES {
            "Awareness" SCORE 2 SPECIALTY "social situations"
            "Bargain" SCORE 4 SPECIALTY "negotiation"
            "Brawl" SCORE 2 SPECIALTY "walking stick"
            "Carouse" SCORE 2 SPECIALTY "with giants"
            "English" SCORE 5 SPECIALTY "Northumbrian"
            "Entrancement" SCORE 5 SPECIALTY "ambitious young noblemen"
            "Etiquette" SCORE 6 SPECIALTY "among Germans"
            "Charm" SCORE 6 SPECIALTY "nobles"
            "French" SCORE 5 SPECIALTY "Norman"
            "Folk Ken" SCORE 6 SPECIALTY "kings"
            "Guile" SCORE 7 SPECIALTY "lying to kings"
            "High German" SCORE 5 SPECIALTY "Franconian"
            "Intrigue" SCORE 10 BONUS 2 SPECIALTY "court"
            "Latin" SCORE 4 SPECIALTY "Classical"
            "Low German" SCORE 5 SPECIALTY "Saxon"
            "Mentem Resistance" SCORE 4 SPECIALTY "mind reading"
            "Organization Lore: Church" SCORE 2 SPECIALTY "the corrupt"
            "Organization Lore: Nobility" SCORE 5 SPECIALTY "the corruptible"
            "Ride" SCORE 1 SPECIALTY "on roads"
            "Teaching" SCORE 5 SPECIALTY "intrigue"
            "West Norse" SCORE 5 SPECIALTY "Icelandic"
        }
        POWERS {
            #t7927e8e4e1d9780870034a ^"Donning the Corporeal Veil (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Donning the Corporeal Veil"
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See *Realms of Power: Magic*, page 102 Cr(Re)Co 25 (Base 5, +1 Touch, +2 Sun, +1 requisite) Greater Power (25 levels, –3 Might, +2 Init) *Aura of Mundane Semblance*, 0 points, constant effect, Vim: Prevents the detection of Bekki’s Magic Might or of the use of any of his Personal Powers, unless the level of the spell used to examine him exceeds 45. To detect him with Magic Sensitivity would require an Ease Factor of 27 (magnitude of this effect x 3). PeVi 45 (Base effect, +1 Touch, +2 Sun, +1 constant effect) Personal Power x 2 (45 levels, –5 Might cost with 4 mastery points from Improved Powers)"
            }
            #t6c0e3bc107d6e5e9053cd3 ^"Freyja’s Necklace" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–6"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "When donned, this golden necklace studded with amber can incite powerful passions in an individual. Bekki can decide upon the emotion to invoke and all of the individual’s decisions are made in the light of slaking their unnatural emotions until the duration ends. Typical emotions include envy of a political rival, hatred for an enemy state, greed for a particular object, or lust for a certain person. ReMe 30 (Base 10, +1 Eye, +3 Month) Greater Power (30 levels, –2 Might cost)"
            }
            #t563d33e79ff0d592bdb6ba ^"The Tarnhelm" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "This helmet was stolen from dwarfs loyal to the gods. While wearing it, he is completely undetectable to normal sight, hearing, smell, and even if he brushes up against someone, his touch will not register (although any contact more rigorous than this is noticed as normal). PeIm 15 (Base 5, +1 Conc, +1 changing image) Personal Power (15 levels, –1 Might, +2 Init with 1 mastery point from Improved Powers)"
            }
        }
    }

}
