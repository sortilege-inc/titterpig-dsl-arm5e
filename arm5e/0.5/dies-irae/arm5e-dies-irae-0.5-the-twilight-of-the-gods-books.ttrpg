EXTENSION "ArM5_Dies_Irae_TheTwilightOfTheGods_Books" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Five: The Twilight of the Gods books"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's books, structured; each DESCRIPTION the source's text, verbatim.

    #tc8a9e6a7946bbd21a4394b ^"Gylfaginning (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Gylfaginning"
            ^"Translated Title" STRING "The Deluding of Gylfi"
            ^"Author" STRING "Snorri Sturluson"
            ^"Language" STRING "West Norse (Icelandic)"
            ^"Kind" STRING "Summa"
            ^"Level" INTEGER 5
            ^"Quality" INTEGER 10
            ^"Section" STRING "Prophecies of the End Times"
            ^"Printed Entry" STRING "“The Deluding of Gylfi” by Snorri Sturluson. Language: West Norse (Icelandic). Summa on Organization Lore: Norse Paganism, Level 5 Quality 10."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "Written in 1218 by a famous Icelandic lawspeaker, this work is not always accurate and riddled with Christian prejudice but is a good overview nevertheless."
    }

    #t5f321e15d5774104a8e372 ^"Völuspá (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Völuspá"
            ^"Translated Title" STRING "The Seeress’s Prophecy"
            ^"Author" STRING "anonymous"
            ^"Language" STRING "West Norse (Old Norse)"
            ^"Kind" STRING "Summa"
            ^"Level" INTEGER 7
            ^"Quality" INTEGER 7
            ^"Section" STRING "Prophecies of the End Times"
            ^"Printed Entry" STRING "“The Seeress’s Prophecy” by anonymous. Language: West Norse (Old Norse). Summa on Organization Lore: Norse Paganism, Level 7 Quality 7"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "*Völuspá* purports to be the prophecy of Urdur the Jotun of Fate, recited to her son Odin, and is the primary source for Ragnarok. It is filled with complex poetic allusions and metaphor and the Quality drops to 4 for characters who do not already possess the Organization Lore: Norse Paganism Ability from another source. Complete copies of *Völuspá* are currently rare, since it was collated some time in the thirteenth century. However, as an oral tradition *Völuspá* is available intact, although characters may have to search for those who know it."
    }

    #tfa604e688c91d9eced6563 ^"Muspilli (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Muspilli"
            ^"Author" STRING "anonymous"
            ^"Language" STRING "Old High German"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 6
            ^"Section" STRING "Prophecies of the End Times"
            ^"Printed Entry" STRING "by anonymous. Language: Old High German. Tractatus in Faerie Lore, Quality 6"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "Written about 870 by an unknown author, this poem is a thinly Christianized account of Ragnarok, describing the battle between Elijah (Thor) and the Antichrist (Surtur), the champions of God (Odin) and the Devil (Loki). It is a somewhat obscure poem, written in whole as a marginalia in another book. The faerie gods may need to play a hand in getting this to the characters."
    }

    #t4566af79ade19e3ad5d0cc ^"De Principiis (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "De Principiis"
            ^"Translated Title" STRING "On First Principles"
            ^"Author" STRING "Origen Adamantius"
            ^"Language" STRING "Latin"
            ^"Kind" STRING "Summa"
            ^"Level" INTEGER 4
            ^"Quality" INTEGER 12
            ^"Section" STRING "Prophecies of the End Times"
            ^"Printed Entry" STRING "“On First Principles” by Origen Adamantius. Language: Latin. Summa on Theology, Level 4 Quality 12."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "Origen was an early Christian theologian, although some of De Principiis was declared heretical in the sixth century and he was posthumously excommunicated. If an unexpurgated version can be found (containing an additional twenty four chapters), the Level is increased to 6; the unexpurgated text is also a tractatus on Organization Lore: Church (specialized in heresy) of Quality 12"
    }

    #t13cfbc3a3aa9dcd2b89e01 ^"Titanomachia (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Titanomachia"
            ^"Translated Title" STRING "The War of the Titans"
            ^"Author" STRING "Eumelos of Corinth"
            ^"Language" STRING "Classical Greek (Doric)"
            ^"Kind" STRING "Summa"
            ^"Level" INTEGER 5
            ^"Quality" INTEGER 10
            ^"Section" STRING "Prophecies of the End Times"
            ^"Printed Entry" STRING "“The War of the Titans” by Eumelos of Corinth. Language: Classical Greek (Doric). Two summae, one on Magic Lore and one on Faerie Lore, Level 5 Quality 10."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "A description of the Greek version of the creation of the world and the titans, and their subsequent war with their progeny. There is a legendary third poem which contains prophecy of the second titanomachy; if this is found then the Level of the summa on Magic Lore raises to 7. Unfortunately all three poems were lost in antiquity; while fragments of the first two exist as quotes in other works, nothing of the third remains at all. Characters may need to resort to necromancy in order to retrieve this knowledge."
    }

}
