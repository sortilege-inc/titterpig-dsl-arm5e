EXTENSION "ArM5_Dies_Irae_TheTwilightOfTheGods_Templates" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Five: The Twilight of the Gods templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Dies_Irae_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #t3273126c19115c74651ba1 TEMPLATE "Magogoli Trooper" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Name Source" STRING "editorial: the book prints no title for this stat block; named for the kind its paragraph introduces"
            ^"Virtues and Flaws" STRING "Add the Giant Blood Virtue."
            ^"Characteristics" STRING "Increase Strength and Stamina by 1 (from Giant Blood)"
            ^"Size" STRING "+2 (from Giant Blood)"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "A common trooper is a grog character, although he also has the Giant Blood Virtue on top of his normal allotment. He is a human descendent of the Magic Humans who make up the generals and shamans of Magogoli society. For simplicity, give him the statistics of the Specialist template (ArM5 page 21), or the Mongol trooper (*The Cradle and the Crescent* page 180), with the following adjustments:"
    }

    #tb1561957a076e3a84e059c TEMPLATE "Magogoli Orlock" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Name Source" STRING "editorial: the book prints no title for this stat block; named for the kind its paragraph introduces"
            ^"Magic Might" STRING "10 (Corpus)"
            ^"Virtues and Flaws" STRING "Add the free Magic Human Virtue."
            ^"Magic Qualities & Inferiorities" STRING "Gigantic, Greater Power (Son of the Eagle, see later); Minor Virtue (Large), Minor Virtue (Puissant Leadership), Minor Virtue (Self Confident), Minor Virtue (Tough)"
            ^"Characteristics" STRING "Increase Strength by 4 and reduce Quickness by 2 (from Gigantic)"
            ^"Size" STRING "+3 (from Gigantic and Large)"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "A Magogoli *orlock* (general) is a companion-level character and a Magic Human. Give him the statistics of the Knight template (ArM5 page 23) or the Mongol general (*The Cradle and the Crescent* page 180) with the following adjustments:"
    }

    #tfac6a7976e1e6478888156 TEMPLATE "Magogoli Böge" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Name Source" STRING "editorial: the book prints no title for this stat block; named for the kind its paragraph introduces"
            ^"Magic Might" STRING "20 (Corpus), or more for powerful böge"
            ^"Virtues and Flaws" STRING "Add the free Magic Human Virtue"
            ^"Magic Qualities & Inferiorities" STRING "Gifted, Gigantic, Greater Power (Son of the Eagle, see below), Major Virtue (Ghostly Warder), Major Virtue (Greater Immunity to Mind Control and Possession), Major Virtue (Nightwalker); Minor Virtue (Inoffensive to Spirits), Minor Virtue (Temporal Influence)"
            ^"Characteristics" STRING "Increase Strength by 4 and reduce Quickness by 2 (from Gigantic)"
            ^"Size" STRING "+2 (from Gigantic)"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The Magogoli are also accompanied by *böge* or spirit summoners. A *böge* is a maguslevel character and a Magic Human. Use the statistics for the Summoner (*Realms of Power: the Infernal* page 119) or the Mongol Spirit Shaman (*The Cradle and the Crescent* page 181) with the following adjustments:"
    }

}
