EXTENSION "ArM5_Faith_and_Flame_Arelat_PolaTheSophistOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Pola the Sophist of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Pola the Sophist of Jerbiton (Chapter Eight: Arelat, p132): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t8440f549a166adccca9034 ^"Pola the Sophist of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6db295248a1e5be20cb0ac ^"Coenobium Rhodanien"]
            ^"Age" STRING "81 (Apparent Age: 51)"
            ^"Personality Traits" STRING "Precise +3, Haughty +1, Impatient +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "Pola is a descendent of a Jerbiton magus who was a noted Gorgiastic — a member of House Criamon who left the House and rejected its teachings about the Enigma. Over time the lineage has developed into a peripatetic tradition of rhetoricians and skillful advocates by focusing on the teachings of Gorgias and the other Sophists. Some of its younger scions have more recently been adopted into House Tytalus on merit. An excellent speaker, Pola considers the art of debate an expression of beauty and strives to further its popularity as an alternative means of resolving disputes to more distasteful practices such as certamen or Wizard’s War.\n\nOut of all the consuls, she is the one most likely to act as a patron to visiting magi. As the maga nominally in charge of the Avignon holdings of the covenant, she is responsible for supervising Jerbiton apprentices passing through the Coenobium’s sphere of influence while journeying on their Itinerarium to or from the covenant of Eboris in Paris."
    }

}
