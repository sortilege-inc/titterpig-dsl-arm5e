EXTENSION "ArM5_Faith_and_Flame_Arelat_XiphosFiliaDamoclesOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Xiphos filia Damocles of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Xiphos filia Damocles of Jerbiton (Chapter Eight: Arelat, p132): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t93f6db5fdab07dae9bfb63 ^"Xiphos filia Damocles of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6db295248a1e5be20cb0ac ^"Coenobium Rhodanien"]
            ^"Age" STRING "73 (Apparent Age: 54)"
            ^"Personality Traits" STRING "Ill-tempered +3, Intolerant +2, Cruel +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "This disgraced Terram master hoplite, hailing from beyond the Provençal Tribunal, was expelled from House Guernicus for repeated behavior unbecoming for a hoplite.\n\nAt the unexpected insistence of Primus Andru of Jerbiton, she has been grudgingly accepted into House Jerbiton and given a chance to reform. The exact details of her pardon are uncertain, but she appears bound to the provision that she use her talents to support the stability of the Coenobium. Her less martial Housemates may pursue their concepts of Beauty and Taste, but they do so with minimal disruption from magical threats due to her efforts.\n\nXiphos claims descent from a legendary Guernicus Terrae-magus known as Adamantius, and has almost complete mastery over metal and blades."
    }

}
