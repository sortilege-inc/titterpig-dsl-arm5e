EXTENSION "ArM5_Faith_and_Flame_Gascony_Spells" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Five: Gascony spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t3dee628a525a4ca283cbb1 ^"Revoke the Protection of Bonisagus (Faith & Flame)" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Revoke the Protection of Bonisagus"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeVi 20; R: Voice, D: Mom, T: Individual"
            ^"Owner" STRING "Dama of Merinita"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 70
        }
        DESCRIPTION "Destroys the Parma Magica of the target if 30 + stress die exceeds the targets Ability score x5,. Must Penetrate to take effect. (Base 10 (Dispel effects of a specific type, level +4 Magnitudes), +2 Voice)"
    }

    #tce09f1bd7e6923042dfe83 ^"Veil of Haunting Terror" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Road"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReMe 35; R: Road, D: Moon, T: Group"
            ^"Owner" STRING "Dama of Merinita"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 70
        }
        DESCRIPTION "Shifts the targets’ mental state to an unnatural desire for fearful flight from the road. The target simply wants to run away in terror. As a cosmetic effect, each affected person sees their own worst fear manifesting along the road. The fear fades naturally. (Base 4, +2 Road, + 3 Moon, + 2 Group) At Mimizan, Dama walks a game trail surrounding the grounds and leading out to the main thoroughfare to define this road."
    }

}
