EXTENSION "ArM5_Faith_and_Flame_Gascony_Unicorn" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Unicorn"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Unicorn (Chapter Five: Gascony, p59): one being, its printed stat lines verbatim fields.

    #ted7534f5234bff9b154528 ^"Unicorn" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t614fcfe4baefecc1851b8e ^"Gascony"]
            ^"Might Realm" STRING "Divine" FIXED
            ^"Might" INTEGER 20
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 6
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 3
            ^"Season" STRING "Summer"
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Divine Animal; Divine Master, Greater Purifying Touch (poison); Improved Characteristics, Longwinded, Sense Holiness/Unholiness, Unaffected by the Gift; Mute, No Hands; Baneful Circumstances (virgin women), Compassionate, Reclusive, Weakness (virgin women). (Divine Animal and Divine Master are as Magical Animal and Magical Master, but aligned to the Divine Realm)"
            ^"Magical Qualities and Inferiorities" STRING "Greater Power (Righteous Fury), Improved Abilities, Improved Confidence, Improved Initiative (alicorn), Improved Might (x3), Improved Power (x1, Righteous Fury, x2, Sense Virginity), Improved Recovery, Lesser Power (Sense Virginity), Minor Virtue [Improved Characteristics] (x3), No Fatigue (The Unicorn instead uses Confidence points for its Greater Purifying Touch)"
            ^"Reputations" LIST ["Reclusive Beast of the Woods 3 (local)", "Symbol of Romantic Love 2 (Languedoc)"]
            ^"Soak" INTEGER 3
            ^"Fatigue Levels" STRING "OK, 0, 0, –1, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incap. (25–32), Dead (33+)"
            ^"Natural Weapons" STRING "Alicorn: Init +2, Atk +3, Def +2, Dam +3"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "There are four pawns of Divinelyaligned Animal in the unicorn’s horn, or alicorn as it is also called."
            ^"Appearance" STRING "Equal to a mighty charger fit for a king, this creature appears as a horse with a goat’s cloven hooves and beard, a lion’s tail, and a slender, spiral horn on its forehead."
            ^"Design Note" STRING "This creature was created using the rules from Realms of Power: Magic, but with substitutions appropriate for a Divine creature."
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 59
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Pure" +3
            "Unicorn" +3
            "Cautious" +2
        }
        COMBAT {
            "Hooves" INIT 1 ATTACK 7 DEFENSE 5 DAMAGE 7
            " Alicorn" INIT 4 ATTACK 9 DEFENSE 6 DAMAGE 9
        }
        ABILITIES {
            "Area Lore: Local Region" SCORE 1 SPECIALTY "hidden places"
            "Athletics" SCORE 5 SPECIALTY "galloping"
            "Awareness" SCORE 3 SPECIALTY "humans"
            "Brawl" SCORE 4 SPECIALTY "alicorn"
            "Concentration" SCORE 2 SPECIALTY "Sense Virginity"
            "Folk Ken" SCORE 3 SPECIALTY "humans"
            "Penetration" SCORE 4 SPECIALTY "Sense Virginity"
            "Sense Holiness/ Unholiness" SCORE 4 SPECIALTY "women"
            "Stealth" SCORE 5 SPECIALTY "remaining unseen"
            "Survival" SCORE 4 SPECIALTY "forests"
        }
        POWERS {
            #t39e693bc12dae3a8b55602 ^"Righteous Fury" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "**R: ** Per, **D: **Sun, **T: **Ind. Surrounded with a nimbus of soft white light, the unicorn’s hooves and alicorn become razor sharp, infused with the power of the Lord as it gains a +5 bonus to all Attack and Damage rolls. **MuAn 40** (Base 25, +2 sun, +1 size): Greater Power (40 levels, +10xp Penetration), Improved Power (Initiative x5)"
            }
            #t27c08dbd0634e5d2564201 ^"Sense Virginity" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 point"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "**R: ** Eye, **D: **Conc, **T: **Individual. By gazing into the eyes of an individual, the unicorn can determine whether the target is a virgin. **InCo 15 **(Base 5, +1 eye, +1 Conc): Lesser Power (15 levels, +5xp Concentration, +5xp Penetration), Improved Powers x2 (initiative)"
            }
        }
        DESCRIPTION "*Perhaps because it was an emblem of Jesus’ Incarnation or because it was believed to represent the fearsome passions of nature, the unicorn did not widely appear in early heraldry.*"
    }

}
