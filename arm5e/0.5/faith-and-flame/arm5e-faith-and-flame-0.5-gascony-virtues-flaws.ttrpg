EXTENSION "ArM5_Faith_and_Flame_Gascony_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Five: Gascony virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t41f1df78777b18a1e60d25 ^"Saint’s Aid" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Supernatural"
            ^"Printed Name" STRING "New Virtue: Saint’s Aid"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "This Virtue grants the Ability Saint’s Aid at a score of 1. By beseeching St. Valerie (or another saint with a particular interest in the character) for help when performing Divine Powers and Methods or Holy Magic, the character may ignore the necessary Fatigue or Confidence cost. This blessing may be used a number of times between confessions equal to the character’s score in Saint’s Aid. This Virtue is always associated with the Divine realm."
    }

}
