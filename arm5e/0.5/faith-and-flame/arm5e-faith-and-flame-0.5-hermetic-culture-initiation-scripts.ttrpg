EXTENSION "ArM5_Faith_and_Flame_HermeticCulture_InitiationScripts" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Three: Hermetic Culture initiation scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's initiation scripts, structured; each DESCRIPTION the source's text, verbatim.

    #t1807a8325b337840371fd5 ^"Consecration of Priamitus" DEF {
        EXTENDS #tMCInitiationScriptTypeAAAA ^"Initiation Script"
        PROPERTIES {
            ^"Ease Factor" STRING "21 (Major Virtue: Mercurian Magic known to the Mystagogue)"
            ^"Script Bonus" STRING "+18"
            ^"Grants" STRING "Mercurian Magic"
            ^"Mystery" STRING "The Cult of Mercury"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "**Ease Factor:** 21 (Major Virtue: Mercurian Magic known to the Mystagogue)\n\n**Script Bonus:** +18 **Script Details:** To initiate a follower into the virtue Mercurian Magic, the mystagogue must spend at least a full season traveling the paths of the ancient Roman roads with the Initiate (Mystagogue’s time, +3); arriving at an ancient Temple of the Cult of Mercury (such as Aedes Mercurii), and performing the following ceremony on May 15th, the date of the ancient festival of Mercuralia (+3): the Initiate’s head is sprinkled with water won from the spirit guarding the ancient Mercurian well on a Quest into a shrouded Magical regio at the site Porta Capena on the Appian Way (+3); she forswears any allegiance to her former faith and dedicates herself to the old pagan gods of Rome, acquiring the Pagan Major Story Flaw (+9) (see *Houses of Hermes: True Lineages*, page 109)."
    }

}
