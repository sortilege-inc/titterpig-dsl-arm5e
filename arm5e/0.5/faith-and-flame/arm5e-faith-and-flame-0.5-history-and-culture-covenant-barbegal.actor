EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantBarbegal" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Barbegal"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Barbegal (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #tfd45ae1553575fe7a070dd ^"Barbegal" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "895–930"
            ^"Register Entry" STRING "**Barbegal **(895–930): A watermill complex dominated by a trio of mage-smiths, this Verditius covenant just north of Arles was abandoned in the early tenth century due to Saracen raiding of the undefended site. The surviving magi helped establish the Rhone based covenant of Coenobium Rhodanien."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
