EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantBentalone" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Bentalone"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Bentalone (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #tfd89038fab726451db5d4c ^"Bentalone" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1106–1207"
            ^"Register Entry" STRING "**Bentalone** (1106–1207): A summer covenant destroyed during the crusade by the armies of Simon de Montfort when the castle they inhabited was mistaken for a Cathar stronghold and overrun in a surprise attack."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
