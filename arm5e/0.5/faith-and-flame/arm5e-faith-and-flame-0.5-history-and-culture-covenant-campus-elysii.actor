EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantCampusElysii" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Campus Elysii"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Campus Elysii (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #td0985ee924f98306c45d32 ^"Campus Elysii" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "843–1009"
            ^"Register Entry" STRING "**Campus Elysii** (843–1009): A small group of spirit masters dwelling in the Alyscamps driven out by the expansion of the Coenobium. Although the group retreated to the Verdun Gorge, attempting to refound their home under the new name of Portus Termini, the settlement failed before the next Tribunal and was never officially registered as a Provençal covenant."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
