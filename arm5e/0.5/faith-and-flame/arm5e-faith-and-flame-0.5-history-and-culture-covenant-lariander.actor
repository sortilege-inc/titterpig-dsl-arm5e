EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantLariander" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Lariander"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Lariander (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #te6fecd8f0e994240a8de1a ^"Lariander" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1192–1211"
            ^"Register Entry" STRING "**Lariander** (1192–1211): A Tremere Spring covenant in a faerie forest at Montgey, Toulouse, destroyed during the crusade. The magi were mistaken for a community of Cathars after a party of German crusaders was murdered by rebels while in the vicinity of the covenant."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
