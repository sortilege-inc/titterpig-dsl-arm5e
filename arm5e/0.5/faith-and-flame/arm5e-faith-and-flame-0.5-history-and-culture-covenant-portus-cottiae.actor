EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantPortusCottiae" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Portus Cottiae"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Portus Cottiae (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #t32e5b7ab8efe1d390c9afe ^"Portus Cottiae" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "821–906"
            ^"Register Entry" STRING "**Portus Cottiae** (821–906): The original Mercer House and a Mercurian covenant controlling the old Roman pass from the Piedmont into Gaul, this multi-site settlement in the tradition of the Greater Alps was abandoned after repeated attacks by Berber mercenaries in the late ninth century."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
