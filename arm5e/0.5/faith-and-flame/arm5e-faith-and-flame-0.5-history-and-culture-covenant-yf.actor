EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_CovenantYf" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Yf"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Yf (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #t6ae6cbfc0d8cf9ccc4e53b ^"Yf" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "821–911"
            ^"Register Entry" STRING "**Yf **(821–911): A Diedne covenant off the coast of Arelat, this site fell long before the Schism War to the depredations of Fraxinetum. One of its members joined the efforts of Coenobium Rhodanien in revenge but her line faded away just before the Schism War."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
