EXTENSION "ArM5_Faith_and_Flame_HistoryAndCulture_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Two: History & Culture virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t83fea323487feb1b23777f ^"Troubadour/Trobairitz (Faith & Flame)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Virtue: Troubadour/Trobairitz"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "You are not tied to any community and survive by performing, entertaining, or doing other casual work. You may take Academic skills during character creation and should have a reputation regarding the sort of material you produce and your adherence to the tenets of courtly love. The Wealthy Virtue and Poor Flaw affect you normally, although if you are wealthy, you are supported by someone. Your supporter does not question your activities in any way, however.\n\nTroubadour characters often possess virtues such as Famous, Free Expression, Inspirational, Puissant Performance, Social Contacts, True Love, and Well-Traveled."
    }

    #tbc6d58553b1c2d21e0ee64 ^"Notary (Faith & Flame)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Virtue: Notary"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "Due to your training, you may take Academic Abilities during character creation; however, notaries may not be members of the clergy and are subject to secular law. Your responsibilities include drawing contracts, witnessing charters, verifying transactions and documents, and affixing a specially designed seal. Notaries generally receive their salary from their employer on Christmas. Notaries only have jurisdiction in specific realms or towns, such as the County of Nimes or the city of Montpellier. The Wealthy Virtue and Poor Flaw affect you normally."
    }

    #t525ca0e2700f3f85e16ee9 ^"Perfectus (Faith & Flame)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Social Status"
            ^"Printed Name" STRING "Virtue: Perfectus"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "Due to your training, you may take Academic Abilities during character creation. Your responsibilities include preaching the Gospel, abstaining from eating meat and dairy produce, from sex and romance, and from other acts that ensnare you in the sinful world. You should take the Flaw: Vow to represent your solemn religious obligations. You may not take the Wealthy Virtue, as you are supported by the tithes and contributions of your congregations. As a heretic you are currently at great risk from the Crusade, which will execute you if you are caught and refuse to recant your beliefs. You may take the Purity and Transcendence Supernatural Abilities from *Realms of Power: The Divine Revised Edition *if your character has the True Faith Virtue, but these are not free Virtues. You may, however, take them as Virtues, as normal."
    }

}
