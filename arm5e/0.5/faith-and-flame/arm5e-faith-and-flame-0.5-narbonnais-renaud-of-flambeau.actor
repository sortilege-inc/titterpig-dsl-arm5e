EXTENSION "ArM5_Faith_and_Flame_Narbonnais_RenaudOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Renaud of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Renaud of Flambeau (Chapter Seven: Narbonnais, p107): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t5dad86b43562de099cea6b ^"Renaud of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t89e3531582ad22c2eae1be ^"Stella Durus"]
            ^"Age" STRING "54 (Apparent age: 40)"
            ^"Personality Traits" STRING "Dignified +3, Courageous +2, Foolhardy +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "The third son of a minor Norman lord who was fostered with his uncle, a petty knight, Renaud has fought in Iberia, the Albigensian Crusade, and even the Third Crusade shortly after his Gauntlet. He firmly believes in the concept of “mens sana in corpore sano,” — a healthy mind in a healthy body. He trains with the grogs, serving as their mercenary captain, and his battlefield experience only reinforces his reputation as a capable warrior and magus. Several close brushes with jinn in Iberia and a bad experience with the nobles executing the Albigensian Crusade left Renaud recently soured and looking for inspiration. A discussion at Tribunal with Jean Marie about the troubadour movement in the area inspired him to join Stella Durus. From here, he can investigate Roman ruins and local universities for bits of Mithraic lore while experiencing the very core of the troubadour movement. In fact, he has suggested becoming a troubadour patron twice to his fellow magi, and may personally retain one despite the perceived risks. The wisdom of bringing a wandering storyteller within the walls of the covenant seems questionable at this time, and so far, he has been dissuaded despite his role as magus in charge of defenses, but who knows for how long."
    }

}
