EXTENSION "ArM5_Faith_and_Flame_TheCountyOfToulouse_CyprianOfHouseFlambeauLeaderOfTheBlackFaction" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Cyprian of House Flambeau, Leader of the Black Faction"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Cyprian of House Flambeau, Leader of the Black Faction (Chapter Four: The County of Toulouse, p41): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tc789baf5112dfe661d0e44 ^"Cyprian of House Flambeau, Leader of the Black Faction" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tea3c2372bb55a06d9a8c83 ^"Tolosa Paratge"]
            ^"Age" STRING "84 (Apparent age: 71)"
            ^"Personality Traits" STRING "Dignified +3, Courageous +2, Foolhardy +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "In his time, Cyprian has been a troubadour knight and a passionate Seeker, questing for the lost magical secrets of the Tribunal, and he is the parens of Renaud of Stella Durus. Fiercely loyal to the covenant and to Mariola, his years posing as a knight errant and undisputed skill with weapons have led this Perdo Terram specialist to the leadership of the Black faction. A member of the Cult of Mercury, Cyprian is not himself a Cathar; to be honest he regards them as somewhat annoying in their pacifism and mystical beliefs, but he has long felt that Bishop Foulques has betrayed the Church and his honor, and St.Tropez’s slaughter of the defenseless Marc and the subsequent descent into anarchy has made him more than willing to take up arms against his sodales, if only in defense of his home."
    }

}
