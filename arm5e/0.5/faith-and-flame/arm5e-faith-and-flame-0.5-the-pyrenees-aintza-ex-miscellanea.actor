EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_AintzaExMiscellanea" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Aintza Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Aintza Ex Miscellanea (Chapter Six: The Pyrenees and the Hispanic March, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t97851c72a08f1fb49a5d85 ^"Aintza Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "87 (Apparent age: 59)"
            ^"Personality Traits" STRING "Combative +2, Mysterious +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Aintza Ex Miscellanea is one of the few priestesses at Aedes, and the leader of the Janus priesthood. She is a Hermetic Haruspex, one of a small group of oracular magi supposedly invited to join House Flambeau but who spurned the invitation and joined House Ex Miscellanea. She does not care about distinctions of sex, and certainly does not favor women over men; she believes that her lower status at the covenant is because she is House Ex Miscellanea, not because she is female. She is pagan, the primary Mystagogue for the Aedes branch of the Neo-Mercurians, and lives at the *Templum* with the other Haruspexes. She has a magical cat as her familiar, named Elias, whom she believes is possessed by an aspect of the god Janus due to its strangely disfigured face. The cat has two mouths, two noses and three eyes. Azinta makes a special point of including him in all of her magic."
    }

}
