EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_ArtemisOfTremere" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Artemis of Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Artemis of Tremere (Chapter Six: The Pyrenees and the Hispanic March, p82): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t3e01205443e5c6287e99a2 ^"Artemis of Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t103a6a46424a6f8af67b95 ^"Bellaquin"]
            ^"Age" STRING "49 (Apparent age: 33)"
            ^"Personality Traits" STRING "Disciplined +3, Loyal to Order of Hermes +3"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "Robert insisted upon Artemis’ invitation to Bellaquin based on her reputation for dedication and discipline. Given the role of Guardian, she oversees covenant security. She works closely with Captain Michael, and the two have developed an attraction for one another, yet refuse to acknowledge it due to their dedication to duty and sense of propriety.\n\nStrong with Corpus magic, Artemis’ sigil is a dull aching of the teeth felt by those targeted or those near her during casting."
    }

}
