EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_ConstantineOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Constantine of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Constantine of Jerbiton (Chapter Six: The Pyrenees and the Hispanic March, p82): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t34d311ff4d8de12cd1e485 ^"Constantine of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t103a6a46424a6f8af67b95 ^"Bellaquin"]
            ^"Age" STRING "67 (Apparent age: 49)"
            ^"Personality Traits" STRING "Avarice +3, Gluttony +2, Jovial +1, Serious +1"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "Constantine is a merchant deeply invested in banking, and he is a master of his craft, utilizing a network of trusted contacts gained through travel and Imaginem magics to coordinate business and transfers. An old friend of Valgravian, he facilitated the liquidation and transfer of old Bellaquin’s assets, transforming Bellaquin into a wealthy landowner in Andorra. While he envisioned the current incarnation of the covenant, he leaves management to Valgravian, focusing on financial matters.\n\nHe is uninterested in the affairs of other members, and younger magi often find him intimidating. Strict and serious most of the time, he grows lighthearted and jovial amongst friends and family. Respectful of his fellow magi at Bellaquin, Constantine gladly provides them with whatever assistance he can, but he expects a favor to be repaid for a favor. He is an avid collector of coins, and especially seeks ones from distant or ancient lands.\n\nHis sigil is a light dusting of gold appearing on the target or in the air around Constantine."
    }

}
