EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_FlammarcusOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Flammarcus of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Flammarcus of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p84): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t6e1af1ff69e4a9596a57b0 ^"Flammarcus of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "121 (Apparent age 75)"
            ^"Personality Traits" STRING "Passionate +2, Ruthless +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "Flammarcus of Flambeau considers himself the leader of the covenant, and he calls himself the Pontifex Maximus. He is a priest of Mars, though like many who live at the Dorsum he is actually Christian and views the Mercurian priesthood as purely ceremonial. He idolizes Flambeau the Founder, and believes the magi of Castra Solis corrupted and revised the Founder’s history. According to his research, Flambeau was not a Mithraian, but a Mercurian, possessor of some of the lost rituals of the Order. His findings paint a very different picture from the commonly accepted history, though most other magi believe him overzealous, and do not understand his fervor. He is passionately driven to become Primus as soon as Garus dies, and it seems he might be willing to do anything to achieve this goal."
    }

}
