EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_MidiusOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Midius of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # Midius of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t970075896587bdfe57c07d ^"Midius of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "94 (Apparent age: 50)"
            ^"Personality Traits" STRING "Loyal +2, Submissive +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Midius of Flambeau is the current High Priest of Mercury, caretaker of the *Templum* and flamen for the Provençal Tribunal. He still thinks of himself as Ophilio’s subordinate, from his many years of serving beneath him in the temple, and is as ever desperate to impress the old magus. He attends Tribunal on Ophilio’s behalf."
    }

}
