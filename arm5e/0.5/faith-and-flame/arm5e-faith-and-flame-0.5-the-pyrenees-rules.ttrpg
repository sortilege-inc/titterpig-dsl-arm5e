EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_Rules" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Six: The Pyrenees and the Hispanic March rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.



    #t8182fb1df77e8ec51ebf85 ^"Hex Casting Total" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Hex"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 94
        }
        FORMULAS {
            "Hex Casting Total" "Communication + Hex + Aura + Stress Die vs Ease Factor (Severity + Duration + Delay) Hex Ease Factors"
        }
    }

    #t0c3004c91dcbccb6326a8f ^"Catharsis Avoidance Total" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Catharsis Avoidance Total" "Stamina + Concentration + Premonitions + stress die vs. Warping Score + Number of Warping Points Gained + Ecstatic Magic + local aura"
        }
    }

    #t82be2efbf1557f28173a87 ^"Avoidance Time" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Avoidance Time" "40 Rounds minus (Avoidance Success + Second Sight)"
        }
    }

    #t142013d8aaf5d3f3c2e96d ^"Catharsis Assimilation Total" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Catharsis Assimilation Total" "Intelligence + Ecstatic Magic + stress die vs Warping Score + stress die"
        }
    }

    #t4d48dda51aef1ba90e1135 ^"Time Spent in Ecstasy" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Time Spent in Ecstasy" "One hour per point of Warping Score"
        }
    }

    #tf556e450c937b020f0c915 ^"Cost" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Cost" "1 Confidence Point"
        }
    }

    #t97940d6173a6c539da7496 ^"Time Spent becomes" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Warping"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "Time Spent becomes" "Warping – (Stress Die + Perception + Second Sight) hours, see later."
        }
    }

    #tc5ccbd7c368a6a425bd68e ^"Potency" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Potent Magic"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 96
        }
        FORMULAS {
            "Potency" "sum of bonus from each casting item"
        }
    }

}
