EXTENSION "ArM5_Faith_and_Flame_ThePyrenees_Tables" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Six: The Pyrenees and the Hispanic March tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Faith_and_Flame_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #ta7d1d573f2ebc18a452854 ^"Hex Ease Factors (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Base", "Severity", "Examples"]
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 95
        }
        TABLE {
            "6" "Minor" "Ensure Failure, Cause Minor Misfortune, Bestow Minor Flaw for duration, Manipulate target for duration"
            "12" "Serious" "Cripple Sense or Limb for duration, Transform Target for duration"
            "18" "Major" "Inflict Major Disease, Cause Major Misfortune, Bestow Major Flaw for duration"
            "24" "Critical" "Cripple or Incapacitate someone, Cause Aging Crisis"
            "30" "Terminal" "Death or Ruination"
        }
    }

    #t4aa0982a83eb7cdd482541 ^"Hex Duration (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Mod", "Duration"]
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 95
        }
        TABLE {
            "+0" "Momentary"
            "+3" "Hour/Simple Condition (any common superstitious cure)"
            "+6" "Day/Minor Condition (a simple specific task)"
            "+9" "Moon/Moderate Condition (a demanding or complex task)"
            "+12" "Season/Major Condition (a difficult and challenging task)"
            "+15" "Year/Ultimate Condition (a vague or impossible task)"
        }
    }

    #t51e00899c293b499dafd5c ^"Hex Delay (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Mod", "Delay"]
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 95
        }
        TABLE {
            "+12" "Moment"
            "+9" "Hour"
            "+6" "Day"
            "+3" "Week"
            "0" "Month"
            "–3" "Season"
            "–6" "Year"
            "–9" "Generation"
            "–12" "Lifetime"
        }
    }

    #t0cb31f42c6c831e75940a2 ^"Basque Female Names (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Name"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 89
        }
        TABLE {
            "Abene (“pillar”)"
            "Aintza (“glory”)"
            "Alaia (“joyful, happy”)"
            "Alazne (“miracle”)"
            "Amaia (“the end”)"
            "Berezi (“special”)"
            "Bihotz (“heart”)"
            "Elixabete (Elizabeth)"
            "Erlea (“a bee”)"
            "Eskarne (“mercy”)"
            "Esti (“sweet, honey”)"
            "Euria (“rain”)"
            "Garbi (“clean, pure”)"
            "Goizane (“morning”)"
            "Haizea (“wind”)"
            "Hilargi (“moon”)"
            "Hirune (“trinity”)"
            "Ihintza (“dew”)"
            "Itsaso (“ocean”)"
            "Itzaro (“hope”)"
            "Izar (“star”)"
            "Kattalin (Katherine)"
            "Kistiñe (Christina)"
            "Lore (“flower”)"
            "Maia (Maria)"
            "Maialene (Magdalene)"
            "Maite (“lovable”)"
            "Nahia (“desire”)"
            "Nekane (“sorrows”)"
            "Nere (“mine”)"
            "Oihana (“forest”)"
            "Osane (“cure, remedy”)"
            "Udane (“summer”)"
            "Usoa (“dove”)"
            "Zuriñe (“white”)"
        }
    }

    #t77205395d700b42b998460 ^"Basque Male Names (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Name"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 89
        }
        TABLE {
            "Amets (“dream”)"
            "Argi (“light”)"
            "Arkaitz (“rock”)"
            "Bakar (“alone”)"
            "Eder (“handsome, beautiful”)"
            "Edur (“snow”)"
            "Eguzki (“sun”)"
            "Ekaitz (“storm”)"
            "Endika (Henry)"
            "Erlantz (“glow, shine”)"
            "Erramun (Raymond)"
            "Frantzisko (Francis)"
            "Ganix (John)"
            "Garaile (“victor”)"
            "Gorka (George)"
            "Gotzon (“angel”)"
            "Hodei (“cloud”)"
            "Igon (“ascension”)"
            "Itzal (“shadow”)"
            "Izotz (“ice”)"
