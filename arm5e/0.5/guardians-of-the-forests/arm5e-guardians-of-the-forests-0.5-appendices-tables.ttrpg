EXTENSION "ArM5_Guardians_of_the_Forests_Appendices_Tables" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Appendices A-C tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t71a26a1a0b5fe39ba6cb92 ^"Languages in Germany" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Language", "Dialects"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 138
        }
        TABLE {
            "High German" "Swabian, Franconian, Bavarian, Swiss, Yiddish"
            "Low German" "Saxon, Pomeranian, Friesian, Flemish"
            "West Slavonic" "Sorbian, Polish, Czech, Slovak"
            "West Norse" "Danish"
            "French" "Norman"
            "East German (dead)" "Gothic, Vandalic, Burgundic"
        }
    }

    #t52256d87ad275cc59e73c1 ^"Languages in Germany (dialects)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Speakers", "Penalty"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 138
        }
        TABLE {
            "Same language, different dialects" "–1 penalty to both speakers"
            "High German vs Low German" "–2 penalty to both speakers"
            "High German (Yiddish only) vs Hebrew" "–2 penalty to both speakers"
            "Low German vs West Norse" "–3 penalty (only –2 if Saxon dialect) to both speakers"
            "Low German vs English" "–3 penalty (only –2 if Friesian dialect) to both speakers"
            "High German vs West Norse or English" "–4 penalty to both speakers"
        }
    }

