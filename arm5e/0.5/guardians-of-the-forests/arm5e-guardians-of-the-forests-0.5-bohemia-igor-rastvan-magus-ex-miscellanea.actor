EXTENSION "ArM5_Guardians_of_the_Forests_Bohemia_IgorRastvanMagusExMiscellanea" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Igor Rastvan, Magus Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Igor Rastvan, Magus Ex Miscellanea (Chapter Ten: Bohemia, p109): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t5654758f5cfb005d1ac2fa ^"Igor Rastvan, Magus Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tb683c05da3bda52cf98413 ^"Roznov"]
            ^"Age" STRING "101 (Archmage)"
            ^"Personality Traits" STRING "Devoted to Radegast +6, Overconfident +2, Peaceful –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "Rastvan is about 80 years from his Gauntlet, but is still hale in body and (apparently) mind. He has black curly hair and a beard that reaches to his waist and has only a few wisps of gray. He wears elaborately embroidered robes at all times, which depict mythological scenes and denote his rank as priest of Radegast. Rastvan is the filius of one of the founders of Roznov, and possibly the only archmage of his House. His magic draws deeply from the Slavic traditions of cursing magic, and he is feared for his ability to slay his victims from afar. Many of his spells have a non-Hermetic ritual element that draws power from leading a pagan ceremony of many worshippers — the more worshippers, the more power he can achieve. Rastvan’s ambitions revolve around his god; he desires to assert dominance over the Slavic lands, united under the worship of Radegast. This obsession has grown stronger in recent years, and his filii fear that his overwhelming zeal is a symptom of a mind unhinged by Twilight."
    }

}
