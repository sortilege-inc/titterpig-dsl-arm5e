EXTENSION "ArM5_Guardians_of_the_Forests_Bohemia_RichendaSpinosaFollowerOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Richenda Spinosa, follower of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Richenda Spinosa, follower of Flambeau (Chapter Ten: Bohemia, p107): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t90799a67516168e774bfc5 ^"Richenda Spinosa, follower of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t754c31269c8fe1555c2c90 ^"Irencillia"]
            ^"Age" STRING "28 (Journeyman)"
            ^"Personality Traits" STRING "Bitter +3, Prickly +2, Fae –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "Richenda is a very atypical member of House Flambeau. As an apprentice she showed a great aptitude for flame-magics, but it was unknown to her master (Indulius of Fengheld) that this was due to her secret faerie heritage, descended as she was from Kupala, a faerie lord who guards the Fire Flower in Slavic lands. Her master’s bungling (in her opinion) scarred her Gift, and she was left unable to use fire magics except with great difficulty. Her natural aptitude for Herbam made her a laughing stock in her House, particularly when they learned that she had faerie blood. Richenda has become a very angry young maga with an affinity for spells involving thorns, and has sworn vengeance on her master. She has not fully come to terms with her fae side, although her caricature Jennis is helping here; he appears to be a male version of the Polish maga, and they have learned much from each other."
    }

}
