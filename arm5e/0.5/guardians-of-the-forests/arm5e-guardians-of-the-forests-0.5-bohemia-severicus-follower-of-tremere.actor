EXTENSION "ArM5_Guardians_of_the_Forests_Bohemia_SevericusFollowerOfTremere" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Severicus, follower of Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Severicus, follower of Tremere (Chapter Ten: Bohemia, p109): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t6f7e88d7fd41a263ec5ff8 ^"Severicus, follower of Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tb683c05da3bda52cf98413 ^"Roznov"]
            ^"Age" STRING "77 (Master)"
            ^"Personality Traits" STRING "Unyielding +3, Obsessive +2, Sympathetic –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "Severicus is a remarkably tall man, and thin as well. He is totally bald, but maintains a neat beard that is starting to grey with age. He is a noted master of Terram magics, and detests change in any way (magically, politically, or otherwise). Other than Stentorius of Fengheld, Severicus is the only member of House Tremere in the Rhine Tribunal to hold his own sigil, and controls about two-fifths of the sigils of the other Tremere magi, including those of his two filii and that of Hygwald Veritas of Waddenzee."
    }

}
