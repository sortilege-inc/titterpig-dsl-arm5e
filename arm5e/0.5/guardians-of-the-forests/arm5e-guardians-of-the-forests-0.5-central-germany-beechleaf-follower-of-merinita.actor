EXTENSION "ArM5_Guardians_of_the_Forests_CentralGermany_BeechleafFollowerOfMerinita" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Beechleaf, follower of Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Beechleaf, follower of Merinita (Chapter Eight: Central Germany, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t0a947522612fb1f6f68363 ^"Beechleaf, follower of Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t3415d210d228f7856d2157 ^"Fengheld"]
            ^"Age" STRING "20 (Journeyman)"
            ^"Personality Traits" STRING "Otherworldly +2, Suspicious +2, Naive +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "This fresh-faced journeyman, apprenticed at Irencillia by his master, Primus Handri (see Chapter 10: Bohemia, Irencillia), is privileged to have been offered a position at the covenant’s main site, but is not sure of the political reasons behind his appointment and is justifiably nervous. Beechleaf is strongly influenced by the fae; he was raised by a dryad, and understands the ways of faerie better than he does humans. His skin is a faint shade of green, and his bronze-colored hair seems to have a life of its own, ruffled in an unseen breeze."
    }

}
