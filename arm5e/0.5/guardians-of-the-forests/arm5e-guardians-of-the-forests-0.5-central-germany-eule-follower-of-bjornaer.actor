EXTENSION "ArM5_Guardians_of_the_Forests_CentralGermany_EuleFollowerOfBjornaer" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Eule, follower of Bjornaer"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Eule, follower of Bjornaer (Chapter Eight: Central Germany, p84): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tee45c62cafc7a3c42aa707 ^"Eule, follower of Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t3415d210d228f7856d2157 ^"Fengheld"]
            ^"Age" STRING "approximately 160 (Master)"
            ^"Personality Traits" STRING "Owlish +6, Apathetic +3, Wise +3"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "A contender for the oldest magus in the Tribunal (along with Caecilius of Durenmar and Schadrit of Dankmar), Eule is an interesting phenomenon — a follower of Bjornaer who has received the honorary rank of Quaesitor from House Guernicus. For many years she was the only senior Quaesitor in the Rhine Tribunal, but is now in retirement from her official duties. Her heartbeast (as her name suggests) is an owl, and she is still sought out by magi for her famous good advice.\n\nOnly her filius (Günther Lupus) suspects that Eule has entered Final Twilight. She has not taken her human form for many years, and has not spoken for even longer. The myth of her wisdom has been perpetuated by a fraud set up by Günther; in the floor of the room where she receives her visitors is hidden a magic item with a low level (but very high Penetration) Perdo Mentem effect that calms the mind and removes emotion. With a few verbal promptings by Günther (who is “interpreting” his mistress’ hoots), her petitioners usually manage to find their own answers to their quandaries, but attribute the solution to Eule’s wisdom."
    }

}
