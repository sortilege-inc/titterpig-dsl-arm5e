EXTENSION "ArM5_Guardians_of_the_Forests_CentralGermany_TheDrudenbaumOfHarberg" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - The Drudenbaum of Harberg"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The Drudenbaum of Harberg (Chapter Eight: Central Germany, p89): one being, its printed stat lines verbatim fields.

    #t17ac1db7b95c03b12dce30 ^"The Drudenbaum of Harberg" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t2886d57650d6b492986c64 ^"Central Germany"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Magic Might" STRING "30"
            ^"Special Powers" STRING "Grant Virtue (Magic Sensitivity), Grant Virtue (Second Sight), Possession A mythical tree called the Drudenbaum is said to be found on the top of the Harberg mountain, which overlooks Nuremberg. Its name stems from the fact that wizards meet beneath it. It is told that its glossy leaves from time to time shed golden drops, milk oozes out of its roots, and under it lies a treasure guarded by a dragon. On the tree sits a great black bird, who clashes his wings together and raises a storm every time someone tries to steal the treasure. Those who drink a cup of the golden liquid are reputed to become sorcerers."
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 89
        }
        PERSONALITY_TRAITS {
            "Mysterious" +3
        }
        DESCRIPTION "The dragon and the treasure are a myth, the rest is real. Wizards meet here because the golden drops are Creo vis, and the milk is Vim vis. The Drudenbaum is of no known species of tree, but when the spirit possesses any tree of its domain, that tree temporarily acquires the appearance and vis-producing traits of the mythical Drudenbaum. This possession is signified by the arrival of the black bird in the possessed tree’s uppermost branches."
    }

}
