EXTENSION "ArM5_Guardians_of_the_Forests_CurseOfTheRhineGorge_CaudelixTheGaul" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Caudelix the Gaul"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Caudelix the Gaul (Chapter Twelve: Curse of the Rhine Gorge, p134): one being, its printed stat lines verbatim fields.

    #t29b018d9376715baf10505 ^"Caudelix the Gaul" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#td9960ee83fd2c56dd9fac8 ^"The Amphitheater"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Magic Might" STRING "20"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 1
            ^"Soak" INTEGER 8
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24)"
            ^"Appearance" STRING "The final gladiator is a burly giant of a man, his fair braided hair falling behind a fierce-looking iron skull cap with an attached “spectacle” mask. He wields a long-handled axe and his only body armor consists of leather bracae protecting his thighs, and bracers on his forearms."
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 134
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Duty-Bound" +3
            "Violent" +1
        }
        COMBAT {
            "Great axe" INIT 1 ATTACK 16 DEFENSE 9 DAMAGE 15
            "Hatchet" INIT 1 ATTACK 11 DEFENSE 7 DAMAGE 9
            "Gauntlet" INIT 1 ATTACK 8 DEFENSE 8 DAMAGE 7
        }
    }

}
