EXTENSION "ArM5_Guardians_of_the_Forests_CurseOfTheRhineGorge_Devices" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Twelve: Curse of the Rhine Gorge devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #td67001a168bf1b8e558c06 ^"Recognize Your Master" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Door of Deimos"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch)"
            ^"Final Level" STRING "8"
            ^"Printed Effect Line" STRING "InCo 5, R:Touch, D:Mom, T:Ind"
            ^"Location" LIST [#tf4daa04d297b09116481a4 ^"The Sanctum of Arliandus"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "This is an iron door, with faces and skulls embossed onto its surface and highlighted in inlaid lead and silver. Arliandus named it after the son of Ares, whose name meant “Terror.” The door is not locked, but has a complex latch requiring putting one’s hand inside the mouth of a leering face and twisting the catch. The door is also invested with the following effects:\n\nA compartment on the inside of the door holds an arcane connection (currently to the long-dead Arliandus). If the arcane connection matches the person touching the door, then nothing happens. If it does not match, or the toucher successfully resisted the effect (it has a Penetration Total of 0), then the second effect is triggered. The toucher may choose not to resist this effect if he knows it exists. This effect is triggered even if the door is not touched with bare flesh. Operates 6 times per day (+3 levels)."
    }

    #t4fde2dcf2285130f5b7989 ^"Repel the Intruder" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Door of Deimos"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun)"
            ^"Final Level" STRING "43"
            ^"Printed Effect Line" STRING "CrMe 15, R:Touch, D:Sun, T:Ind"
            ^"Location" LIST [#tf4daa04d297b09116481a4 ^"The Sanctum of Arliandus"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "This effect is triggered by the first effect (+3 levels). Anyone affected must make an Intelligence roll against an Ease Factor of 12 or flee in terror. Operates 6 times per day (+3 levels), has a Penetration Total of 22 (+11 levels)."
    }

    #t41800cf5fd701dbcadce37 ^"Lamp without Flame" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Crystal of a Hundred Candles"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Conc)"
            ^"Final Level" STRING "23"
            ^"Printed Effect Line" STRING "CrIg 10, R:Touch, D:Conc, T:Ind"
            ^"Location" LIST [#tf4daa04d297b09116481a4 ^"The Sanctum of Arliandus"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "As the door opens, a small crystal embedded in the ceiling blooms into light, illuminating the whole chamber.\n\nOperates 24 times per day (+5 levels), item maintains concentration (+5 levels), environmental trigger (+3 levels)."
    }

    #t73da1e888a09a1f04db599 ^"Depiction of the Waking Dream" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Mirror of Dreams"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Requisite" STRING "Creo, Imaginem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 25, +1 Eye, +1 Conc)"
            ^"Final Level" STRING "45"
            ^"Printed Effect Line" STRING "InCrMeIm 35, R:Eye, D:Conc, T:Ind"
            ^"Location" LIST [#tf4daa04d297b09116481a4 ^"The Sanctum of Arliandus"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "An ornate, gold-framed mirror is surrounded by a set of elaborate smaller mirror fragments — a willing subject who stares into it will see his own thoughts visualized before his eyes. This assists greatly with certain types of lab work; +3 may be added to any Lab Total involving Mentem. However, use of the Mirror is unsettling and tends to disturb the user’s dreams; 1 Warping Point is gained for each season of use (this is due to it being a Powerful Mystical Effect). It also counts as a continuous effect for calculating yearly gain of Warping Points.\n\nThe thoughts of the subject become visible as images surrounding his head in a mirror. The workings of Mentem spells can thus be analyzed quite precisely. Unlimited uses (+10 levels)."
    }

    #t0ab09594b801539762cc07 ^"Vision of the Haunting Spirits (Guardians of the Forests)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Vision of the Haunting Spirits"
            ^"Part Of" STRING "The Trumpet of Ghostly Summoning"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Requisite" STRING "Imaginem"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +2 Sun, +2 Room)"
            ^"Final Level" STRING "41"
            ^"Printed Effect Line" STRING "MuMeIm 40, R:Touch, D:Sun, T:Room"
            ^"Location" LIST [#tf4daa04d297b09116481a4 ^"The Sanctum of Arliandus"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "A small silver trumpet, when blown, summons forth any ghosts or spirits in the area and renders them visible.\n\nOperates twice per day (+1 level)."
    }

}
