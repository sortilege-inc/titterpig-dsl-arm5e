EXTENSION "ArM5_Guardians_of_the_Forests_CurseOfTheRhineGorge_MarcusTheValiant" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Marcus the Valiant"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Marcus the Valiant (Chapter Twelve: Curse of the Rhine Gorge, p134): one being, its printed stat lines verbatim fields.

    #t17ab3395141375a4ba9f49 ^"Marcus the Valiant" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#td9960ee83fd2c56dd9fac8 ^"The Amphitheater"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Magic Might" STRING "20"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Soak" INTEGER 7
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Appearance" STRING "Marcus is the leader of the three gladiators. He is a stocky man equipped to fight as a hoplomachus — with a round shield, a manica on his right arm, greaves on his left leg, a gladius, and an ornamented, brimmed bronze helmet."
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 134
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Duty-Bound" +3
            "Honorable" +1
        }
        COMBAT {
            "Gladius and round shield" INIT 3 ATTACK 14 DEFENSE 13 DAMAGE 7
            "Gladius" INIT 3 ATTACK 13 DEFENSE 10 DAMAGE 7
            "Dagger" INIT 2 ATTACK 11 DEFENSE 8 DAMAGE 5
        }
    }

}
