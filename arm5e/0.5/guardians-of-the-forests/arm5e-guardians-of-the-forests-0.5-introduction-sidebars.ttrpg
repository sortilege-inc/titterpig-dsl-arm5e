EXTENSION "ArM5_Guardians_of_the_Forests_Introduction_Sidebars" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter One: Introduction sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"A Note on German Names" #te3473f564b6f1ee9569ec5 {
            TEXT "A Note on German Names\n\nGerman-speaking readers should note that we have used the English versions of many German place names (for example “Black Forest” instead of “Schwarzwald” and “Brunswick” instead of “Braunschweig”) and people (for example “Charlemagne” instead of “Karl der Grosse” and “Henry the Lion” instead of “Heinrich der Löwe”). We have adopted some German creature names, but have used English-style capitalization and plurals (for example “bockmen” instead of “Bockmänner”). Further information on German languages and names may be found in Appendix A."
        }
    }

}
