EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_CaeciliusFollowerOfBonisagus" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Caecilius, follower of Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Caecilius, follower of Bonisagus (Chapter Six: The Black Forest, p58): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tb16bcf7051c52ead37fc67 ^"Caecilius, follower of Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t14d731f2aac544e4980694 ^"Durenmar"]
            ^"Age" STRING "approximately 160 (Archmage)"
            ^"Personality Traits" STRING "Diligent +3, Touchy +2, Indolent +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "Caecilius is the most venerable of Durenmar’s magi, and he is acknowledged as the greatest living exponent of Intellego magics. Since being appointed a Quaesitor many years ago, his research has tended towards pushing the limits of the investigative rituals employed by House Guernicus. It is rumored that he initially rejected the title, but was eventually persuaded out of a sense of duty, since the Quaesitorial presence in the Tribunal was otherwise very weak. He remains a somewhat reluctant Quaesitor who is not exactly proactive in politics or enforcing the Code — although this may be in part due to his increasingly frequent Twilight episodes. However, when called upon to take action he reveals himself as a brilliant investigator and his genius has solved and thwarted numerous Hermetic crimes down the years. Caecilius has a spotless Hermetic record, which is notable given his great age, and at Tribunal adjudicates as the senior Quaesitor. His familiar is a silver-coated wolf."
    }

}
