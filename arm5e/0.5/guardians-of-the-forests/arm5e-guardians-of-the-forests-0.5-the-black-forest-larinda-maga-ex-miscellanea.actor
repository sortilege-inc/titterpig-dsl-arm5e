EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_LarindaMagaExMiscellanea" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Larinda, maga Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Larinda, maga Ex Miscellanea (Chapter Six: The Black Forest, p63): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #ta871e8e11b563180c94c27 ^"Larinda, maga Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6cb750c26a1c05850985ea ^"Dankmar"]
            ^"Age" STRING "20 (Journeyman)"
            ^"Personality Traits" STRING "Passionate +2, Cheerful +1, Brave –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 63
        }
        DESCRIPTION "Larinda is a young maga just out of apprenticeship. She is lithe and blonde; and pretty, particularly compared to the rest of her covenant. She is the daughter of Jiphella, who is also her Hermetic parens, but has seemingly not picked up any other traits from her family, although she was conceived under the same charm that produced her mother. She has managed to maintain a sunny disposition despite her cruel mother and dominating grandmother, although she will do what they say out of a sense of familial duty. Her magical affinities lie in the natural world — Animal, Herbam, Aquam, and Auram in particular; she is becoming an expert at brewing potions."
    }

}
