EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_OrphedraFollowerOfMerinita" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Orphedra, follower of Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Orphedra, follower of Merinita (Chapter Six: The Black Forest, p63): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t9f257132633f3be330cbcf ^"Orphedra, follower of Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6cb750c26a1c05850985ea ^"Dankmar"]
            ^"Age" STRING "139 (Master)"
            ^"Personality Traits" STRING "Cruel +3, Frightening +3, Optimistic –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 63
        }
        DESCRIPTION "Orphedra is the covenant’s link to the faeries of their forest home. She was apprenticed at Irencillia ten dozen years ago, but found that covenant stifling rather than invigorating, preferring as she does the darkness of primeval forest. Orphedra is as thin as a stick, and wears her hair in a tight bun, which accentuates her angular features and unnaturally smooth skin. Orphedra is the most despised of the magi among the covenfolk; they rarely see Schadrit and worship Jiphella, but Orphedra has an air that makes the skin crawl. Naturally reveling in Faerie Magic (it was she who taught Schadrit), she is inclined towards the dark fae and specializes in illusions, cold, darkness, and fear. She has struck a deal with the local bockmen (see above), who patrol the area around the covenant."
    }

}
