EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_Spells" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Six: The Black Forest spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tdabf6ba4a528c4c6bef085 ^"Dreadful Bane of the Fae" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi Gen; R:Voice D:Mom, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Like *Demon’s Eternal Oblivion*, but works on creatures with Faerie Might. (Base effect, +2 Voice)"
    }

    #t851abbd6ba99194874513f ^"Evisceration of a Thousand Knives" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeCo 30; R:Voice D:Mom, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Inflicts an Incapacitating wound to one target. (Base 20, +2 Voice)"
    }

    #tc8fcec436272a5e939ab23 ^"Flaws of the Weaponsmith" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeTe 25; R:Voice D:Mom, T:Group"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Affects up to 100 base metal objects (or equivalent), causing them to rust away to nothingness. This is the arms and armor of up to 30 men. (Base 5; +2 Voice, +1 Group, +1 number)"
    }

    #t669d954fe7c042e2c07fb5 ^"The Heathen Witch Reborn (Guardians of the Forests)" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "The Heathen Witch Reborn"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi Gen; R:Voice D:Mom, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Reverses any shapechanging spell or supernatural Ability, if the spell level +10 beats the level of the shapechange spell (or the shapechange Ability x 5). (Base effect, +2 Voice)"
    }

    #t61c7a5b7e5b375b485a52c ^"Sap the Griffin’s Strength" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi Gen; R:Voice D:Mom, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Like *Demon’s Eternal Oblivion*, but works on creatures with Magic Might. (Base effect, +2 Voice)"
    }

    #tbefd9e9b8e791dc844ce98 ^"Shattering the Malicious Rune" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi Gen; R:Voice D:Mom, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Like *Unraveling the Fabric of (Form)*, but targeted specifically at rune-magic. (Base effect, +2 Voice)"
    }

}
