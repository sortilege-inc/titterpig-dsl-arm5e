EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_Talismans" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Six: The Black Forest talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t1ec4c234617968106451f4 ^"Knife of Human Bone" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        TABLE {
            "+2" "Precise Destruction" "" "Attunements"
            "+4" "Destroy Body" "" "Attunements"
            "+3" "Destroying Minds" "" "Attunements"
        }
        DESCRIPTION "A wickedly curved dagger with a serrated blade, enchanted to always be razor-sharp."
    }

}
