EXTENSION "ArM5_Guardians_of_the_Forests_TheBlackForest_WinfridaFollowerOfGuernicus" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Winfrida, follower of Guernicus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Winfrida, follower of Guernicus (Chapter Six: The Black Forest, p61): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t5e7f912be5d6f86bb74558 ^"Winfrida, follower of Guernicus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t14d731f2aac544e4980694 ^"Durenmar"]
            ^"Age" STRING "27 (Journeyman)"
            ^"Personality Traits" STRING "Yearning for a Better Life +2, Self-Confident –1, Forceful –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "Although a Quaesitor, Winfrida is young, inexperienced, and a little timid — secretly she would prefer the peaceful life of research enjoyed by members of House Bonisagus. Since there is always at least one magus of Guernicus at Durenmar, her application for membership was accepted several years ago, shortly after passing her Gauntlet in the Greater Alps Tribunal. Winfrida and Tabanus are among the very few (perhaps even the only two) Guernicus magi in the Rhine Tribunal. Murion seems to be grooming and indoctrinating her, so that her loyalties are confused. Tabanus regards her as weak and ineffectual."
    }

}
