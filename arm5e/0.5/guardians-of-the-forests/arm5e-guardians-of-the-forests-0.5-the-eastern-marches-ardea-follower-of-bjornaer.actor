EXTENSION "ArM5_Guardians_of_the_Forests_TheEasternMarches_ArdeaFollowerOfBjornaer" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Ardea, follower of Bjornaer"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Ardea, follower of Bjornaer (Chapter Nine: The Eastern Marches, p97): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t76e52493796f685745496a ^"Ardea, follower of Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t8724b4b6c8366b5d512a48 ^"Crintera"]
            ^"Age" STRING "83 (Master)"
            ^"Personality Traits" STRING "Neutral +2, Serene +2, Hungry for Knowledge +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "Ardea holds Seat of the Swan, and has the heartbeast of a heron, like all who take this seat. She is quiet and contemplative, and rarely offers an opinion on political matters. Thus far she has studiously avoided committing herself to either the Harmonist or Wilderist viewpoint, knowing that her opinion holds much weight with others, famous as she is for her foresight and her divinatory powers. She has the thirst for magical knowledge that might be expected of members of House Bonisagus rather than Bjornaer."
    }

}
