EXTENSION "ArM5_Guardians_of_the_Forests_TheEasternMarches_Talismans" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Nine: The Eastern Marches talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #tf843c3128a261db239b541 ^"Talisman (Falke, Prima of Bjornaer)" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman"
            ^"Owner" STRING "Falke, Prima of Bjornaer"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        TABLE {
            "+5" "water-related effects" "" "Attunements"
            "+3" "Corpus" "" "Attunements"
        }
        DESCRIPTION "a silver anklet-ring decorated with a checkered pattern of watery crystal and amber."
    }

}
