EXTENSION "ArM5_Guardians_of_the_Forests_TheForest_Spells" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Four: The Forest spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t107e0c2ea3a49fc86c6498 ^"Replenishing the Fount of the Magus" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrCo 30 R: Touch, D: Mom, T: Individual"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "Requisites: Mu, He, Vi With the use of this spell, the magus who has discovered the Path of Energy may restore lost Fatigue levels from the forest; one per each casting. This requires the caster to be in physical contact with the forest, and to have a Forest Lore score of at least 4. The caster must ceremonially receive this energy in some manifest form, such as drinking from a forest spring or the eating of forest herbs. While this spell is recorded in the Great Library, no-one has managed to successfully cast it, and many believe it to be a hoax."
    }

}
