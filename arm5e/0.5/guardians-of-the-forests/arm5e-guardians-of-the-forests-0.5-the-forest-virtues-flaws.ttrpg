EXTENSION "ArM5_Guardians_of_the_Forests_TheForest_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Four: The Forest virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t8207de2264180821f5f382 ^"Immortality of the Forest" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "New Major General Virtue: Immortality of the Forest"
            ^"Size" STRING "Major"
            ^"Category" STRING "General"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "Your life force has become inextricably linked with that of the forest where you live. For each year in which you remain completely within its supernatural aura, you do not make an Aging roll, but instead gain one Warping Point for being under a constant mystical effect (as per **Ars Magica **5th Edition, page 167)."
    }

    #t82fb103e1652a986a65b0f ^"Twilight Mastery" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "New Major Hermetic Virtue: Twilight Mastery"
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "Whenever you suffer a Wizard’s Twilight, you may choose the effects of Twilight, rather than have it imposed upon you by the storyguide. If you fail to control the Twilight, you still gain a bad effect, but you may choose from the options in ArM5, page 89. Additionally, you may induce Warping in any being you touch; once per day you may grant somebody 2 Warping Points. This effect has a Penetration of +5, and, if used on a Hermetic magus, necessitates a roll for Twilight in the usual fashion."
    }

    #t40a29df479904068f39d7b ^"Dispassionate" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "New Minor Personality Flaw: Dispassionate"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Personality"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "You are unable to express any strong emotions. This leaves you hard-hearted and lonely, and prevents you from forming strong or lasting bonds with other people. You cannot have a Personality Trait greater than +1 or less than –1."
    }

    #te9e0cbe2eb00f35695327d ^"Thief of Emotions" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "New Major Supernatural Virtue: Thief of Emotions"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "You are able to manipulate the emotions of others. You gain a Supernatural Ability called Emotion Theft, at a score of 1. To use this ability, you must first find a person expressing the emotion you wish to instill in another. You may then make a Presence + Emotion Theft roll against an Ease Factor of 6 + the target’s Personality Trait for that emotion. If successful, the emotion is removed from the target, leaving them devoid of it (although it may naturally reoccur, over time). You can then transfer the emotion to another by touching him; and he will feel the emotion as strongly as the original “donor.” You can even transfer feelings of true love and true friendship (although the Ease Factor to steal such emotions is raised by 3), but not true faith."
    }

}
