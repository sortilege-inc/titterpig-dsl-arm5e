EXTENSION "ArM5_Guardians_of_the_Forests_TheLowlands_CarolusFollowerOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Carolus, follower of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Carolus, follower of Jerbiton (Chapter Seven: The Lowlands, p74): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t4bafcbb2fe2cc0a133a1b1 ^"Carolus, follower of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t86c663470ee73ae0f109ac ^"Oculus Septentrionalis"]
            ^"Age" STRING "35 (Journeyman)"
            ^"Personality Traits" STRING "Analytical +2, Idealistic +1, Organized –3"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 74
        }
        DESCRIPTION "Carolus is a well-intentioned but scatterbrained young magus who poses as an eccentric scholar, sometimes lending his services to those city folk with a penchant for education. A somewhat naïve recent stay at Crintera, in an attempt to repair relations with the Rügen covenant, turned sour when his raven familiar, believed to be spying, was blinded by Caprea of Bjornaer, a guest maga there. In fact there was a raven spying at Crintera, although it was actually Kolkrabus, the devious familiar of Murion (see Chapter 6: The Black Forest, Durenmar). Caprea was fooled and her wrath was misdirected at Carolus’ familiar instead."
    }

}
