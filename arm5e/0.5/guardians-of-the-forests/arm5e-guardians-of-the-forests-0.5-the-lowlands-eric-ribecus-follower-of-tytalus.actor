EXTENSION "ArM5_Guardians_of_the_Forests_TheLowlands_EricRibecusFollowerOfTytalus" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Eric Ribecus, follower of Tytalus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Eric Ribecus, follower of Tytalus (Chapter Seven: The Lowlands, p67): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t88e1a91ae3307a2b1bba35 ^"Eric Ribecus, follower of Tytalus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t5aeee1ad51e04d6e7f8b43 ^"Waddenzee"]
            ^"Age" STRING "52 (Journeyman)"
            ^"Personality Traits" STRING "Reckless +6, Wry Humor +4, Passive –4"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Eric Ribecus is the other founder of the covenant. This black-haired magus of House Tytalus hails from Ribe in Denmark, and is the most serious about the pirate lifestyle of all of Waddenzee’s magi. He is a dashing extrovert who is charming with the ladies, and he has an over-inflated view of his own abilities. He appears much younger than his true age due to illusions and a good longevity ritual. He is a generalist in his magics, although he favors Aquam and Auram. In combat he can most often be found fighting alongside his men with his magical sword. His familiar is a long-tailed skua called Aegir, a large seabird famed for its rapacious habits."
    }

}
