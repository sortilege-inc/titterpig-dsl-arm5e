    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Gunhilda Henrasdottir, follower of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Gunhilda Henrasdottir, follower of Jerbiton (Chapter Seven: The Lowlands, p72): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t0710e74366b1b5628f9977 ^"Gunhilda Henrasdottir, follower of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t86c663470ee73ae0f109ac ^"Oculus Septentrionalis"]
            ^"Age" STRING "31 (Journeyman)"
            ^"Personality Traits" STRING "Loyal to Family +3, Compassionate +1, Independent -2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 72
        }
        DESCRIPTION "Gunhilda Henrasdottir, of House Jerbiton, is Henri’s daughter and filia, a rather plump young maga specializing in housecraft. She suffers from being excessively sheltered by her parents, but her marriage to Estrid offers her a taste of excitement."
    }

