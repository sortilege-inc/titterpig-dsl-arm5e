EXTENSION "ArM5_Guardians_of_the_Forests_TheLowlands_HygwaldVeritasFollowerOfTremere" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Hygwald Veritas, follower of Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Hygwald Veritas, follower of Tremere (Chapter Seven: The Lowlands, p67): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t562bd54dddec17900126bd ^"Hygwald Veritas, follower of Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t5aeee1ad51e04d6e7f8b43 ^"Waddenzee"]
            ^"Age" STRING "48 (Journeyman)"
            ^"Personality Traits" STRING "Arrogant +3, Honest to Quaesitors +3, Respect for Authority –3"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Hygwald Veritas is a devious magus of House Tremere, and co-founder of Waddenzee. A native of England (and trained in the Stonehenge covenant of Blackthorn), Hygwald is scrupulously honest with the Quaesitores, and secretly aspires to become a member of this select group. When dealing with any other being (magus or not, human or not), Hygwald’s arrogance shows through. He offers respect to members of his House, and elsewhere whenever prudent, but has no compunction about lying, cheating, and stealing to further his own aims. He appears to be a well-groomed man in his late thirties, and always dresses in a manner which displays his great personal wealth and sense of importance. He is a specialist in Mentem magics, particularly Rego Mentem, and makes heavy use of *Aura of Rightful Authority*."
    }

}
