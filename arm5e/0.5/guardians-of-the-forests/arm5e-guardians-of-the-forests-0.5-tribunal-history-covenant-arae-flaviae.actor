EXTENSION "ArM5_Guardians_of_the_Forests_TribunalHistory_CovenantAraeFlaviae" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Arae Flaviae"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Arae Flaviae (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #te6a11112f22794afe8ccc6 ^"Arae Flaviae" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "780-885"
            ^"Register Entry" STRING "**ARAE FLAVIAE** (780-885): in Swabia. The magi of this covenant objected to nearby Schwarzburg, and their resulting warfare caused the Tribunal to abolish both covenants and rule that any covenant could veto the establishment of a new covenant."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
