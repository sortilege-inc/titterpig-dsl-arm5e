EXTENSION "ArM5_Guardians_of_the_Forests_TribunalHistory_CovenantGrandSilesia" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Grand Silesia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Grand Silesia (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #t5a3fdf3d27eecf04aa2222 ^"Grand Silesia" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "993-1009"
            ^"Register Entry" STRING "**GRAND SILESIA** (993-1009): founded between the Oder and Warta rivers in Poland by magi from Rethra and Crintera, this covenant split from the Rhine Tribunal in 1008 to form the New Slavonic Tribunal. Rhine magi, feeling betrayed, destroyed the covenant a year later under the guise of the Schism War."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
