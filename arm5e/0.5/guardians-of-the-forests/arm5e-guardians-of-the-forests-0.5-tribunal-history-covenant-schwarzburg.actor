EXTENSION "ArM5_Guardians_of_the_Forests_TribunalHistory_CovenantSchwarzburg" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Schwarzburg"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Schwarzburg (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #tfd5f8fd64ea8c1d6a94061 ^"Schwarzburg" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "857-885"
            ^"Register Entry" STRING "**SCHWARZBURG** (857-885): founded in the Swabian Jura, this covenant was abolished by the Tribunal after 30 years because of their wars with Arae Flaviae."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
