EXTENSION "ArM5_Guardians_of_the_Forests_TribunalHistory_CovenantTreverorum" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Treverorum"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Treverorum (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #t1cf2f8cbccd249902c998e ^"Treverorum" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1095-1172"
            ^"Register Entry" STRING "**TREVERORUM** (1095-1172): located in the city of Trier. They were consistently in trouble for meddling with the affairs of mundanes, and were eventually destroyed, it is believed, at the order of the Church."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
