EXTENSION "ArM5_Guardians_of_the_Forests_TribunalHistory_CovenantWaldherz" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Waldherz"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Guardians_of_the_Forests_Core_Ext"

    # Waldherz (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #teeea8db3eb9374f44d9860 ^"Waldherz" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "990-1010?"
            ^"Register Entry" STRING "**WALDHERZ** (990-1010?): located in the Black Forest and dedicated to the teaching of Hercynius, this covenant was never officially sanctioned by the Rhine Tribunal due to the veto of Durenmar."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
