EXTENSION "ArM5_Hermetic_Projects_BurningCity_LaboratoryVirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Two: The Burning City laboratory virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's laboratory virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t264924b5e65563f646ac84 ^"Dormant Volcano" DEF {
        EXTENDS #tYwoQHJhsRianV3Iui1tcZOt ^"Laboratory Virtue"
        PROPERTIES {
            ^"Magnitude" STRING "Free"
            ^"Group" STRING "Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "The laboratory is located in a dormant volcano crater. *+1 Aesthetics, +1 Ig.*"
    }

    #t9d6e94fab5af309f4dfcd0 ^"Active Volcano" DEF {
        EXTENDS #tnHWjNQB23uTkH5AHDfh2ZER ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Major"
            ^"Group" STRING "Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "The laboratory is located in an active volcanic crater. Note that the Safety, Upkeep, and Health factors here assume that this laboratory and the magus are both somehow protected from the catastrophic hazards of being in an active volcano crater. *+2 Upkeep, –2 Safety, –1 Health, +1 Experimentation, +3 Ig.*"
    }

    #t93f18a637baa26f6b24500 ^"Mineral Bath" DEF {
        EXTENDS #tYwoQHJhsRianV3Iui1tcZOt ^"Laboratory Virtue"
        PROPERTIES {
            ^"Magnitude" STRING "Minor"
            ^"Group" STRING "Outfittings"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "The laboratory contains a mineral bath that is heated by a volcanic source. The magus takes frequent baths while contemplating his work. * +2 Health, –1 Safety, +1 Aq, +1 Longevity Rituals.*"
    }

    #tfbd959cf6c5cfa6ce43b4e ^"Volcanic Spirit Forge" DEF {
        EXTENDS #tYwoQHJhsRianV3Iui1tcZOt ^"Laboratory Virtue"
        PROPERTIES {
            ^"Magnitude" STRING "Minor"
            ^"Group" STRING "Supernatural"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "The laboratory contains a forge that is heated by a volcanic spirit. * –1 Upkeep, –1 Safety, +1 Experimentation, +1 Re, +1 Ig.*"
    }

    #t291892b1e0cd943c28f737 ^"Hell Portal" DEF {
        EXTENDS #tnHWjNQB23uTkH5AHDfh2ZER ^"Laboratory Flaw"
        PROPERTIES {
            ^"Magnitude" STRING "Major"
            ^"Group" STRING "Supernatural"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "The laboratory contains a fiery portal to Hell. *–2 Safety, +2 Warping, +1 Re, +3 Vi.*"
    }

    #tb578ae412b43f641c69c33 ^"Volcanic Minerals" DEF {
        EXTENDS #tYwoQHJhsRianV3Iui1tcZOt ^"Laboratory Virtue"
        PROPERTIES {
            ^"Magnitude" STRING "Free"
            ^"Group" STRING "Outfittings"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The laboratory is supplied with exotic minerals from a volcano. The laboratory needs to be regularly resupplied, otherwise this Virtue is lost. There is no benefit in taking this Virtue multiple times — once the laboratory’s demands for exotic minerals have been met, additional minerals are of little value. –1 Upkeep, +1 Terram."
    }

}
