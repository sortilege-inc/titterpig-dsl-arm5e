EXTENSION "ArM5_Hermetic_Projects_IntangibleAssassin_Spells" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Five: The Intangible Assassin spells"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #ta7bc83e57ffae6a32caa91 ^"The Minute of Reckoning" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Arcane, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 80
        }
        DESCRIPTION "This spells opens a magical tunnel between the caster and the target. Spells cast through this tunnel can be up to the level of this spell.\n\nUnlike the *Opening the Intangible Tunnel* spell, the caster does not need to maintain concentration on this spell; this spell has duration of Diameter. This has advantages (the caster doesn’t need to maintain concentration) and disadvantages (the tunnel cannot be swiftly closed by ceasing to concentrate).\n\nNote that, despite the name of this spell, a Diameter duration spell actually lasts for two minutes.\n\n(Base effect, +4 Arc, +1 Diameter) Required Lab Total to invent spell: depends upon level (see insert)."
    }

    #tf08d95eef33e7a56b05674 ^"The Cursèd Day" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Arcane, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 80
        }
        DESCRIPTION "This spells opens a magical tunnel between the caster and the target. Spells cast through this tunnel must be at least one magnitude less than the level of this spell.\n\nThis spell has duration of Sun. (Base effect, +4 Arc, +2 Sun) Required Lab Total to invent spell: depends upon level (see insert)."
    }

    #tc7010330ce3757caf46f25 ^"Wizard’s Siege" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Arcane, D: Moon, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 80
        }
        DESCRIPTION "This spells opens a magical tunnel between the caster and the target. Spells cast through this tunnel must be at least two magnitudes less than the level of this spell.\n\nThis spell has a duration of Moon. A confident magus might cast this spell immediately after the Wizard’s War begins.\n\n(Base effect, +4 Arc, +3 Moon) Required Lab Total to invent spell: depends upon level."
    }

    #tb84098f3fa2bb14ec97e97 ^"The Evil Eye (Hermetic Projects)" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "The Evil Eye"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Sight, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 80
        }
        DESCRIPTION "Sometimes a magus cannot acquire an Arcane Connection to his quarry. This spell opens a tunnel between the magus and any target within Sight Range.\n\nThe advantage of this is that it lowers the effective range between the magus and the target — which means that lower magnitude effects can be used on the target, which should increase the effective Penetration Total.\n\nEffects cast through *The Evil Eye* tunnel can be up to one magnitude greater than the magnitude of *The Evil Eye* spell.\n\n(Base effect, +3 Sight, +1 Diameter) Required Lab Total to invent spell: depends upon level."
    }

    #t9b1c8595eb55965fc961f6 ^"The Master’s Message" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Touch, D: Moon, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "This spell opens a tunnel between the magus and a character that he touches.\n\nOnce it is cast, the tunnel remains in place, even if the characters break contact. The purpose of this spell is to enable the magus to open a tunnel between himself and a grog. The grog can then depart on a mission, and the magus is able to monitor his progress and cast spells through the tunnel as required.\n\nEven if the grog character has no Magic Resistance, it is a good idea to record the Penetration of this spell, as the grog may try to pass through a hostile *Aegis*.\n\nEffects cast through *The Master’s Message* tunnel can be up to one magnitude greater than the magnitude of *The Master’s Message* spell.\n\n(Base effect, +1 Touch, +3 Moon) Required Lab Total to invent spell: depends upon level."
    }

    #tc15341c8fd03307cfa1240 ^"Arcane Seal" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "This spell can be cast on a magical tunnel created by an Intangible Tunnel-style of effect, but it may only be cast by the magus who originally cast the Intangible Tunnel\n\neffect, because this spell uses the “suppress own spell” guideline (see **ArM5**, page 161).\n\nThe tunnel is sealed for the duration of this spell, and spells can no longer be cast through the tunnel in either direction.\n\nWhen this spell expires, or it is ended some other way, the tunnel may be used again (if it has not expired in the meantime). This spell may be used to seal *Intangible Tunnel* type effects of a level up to one magnitude less than this spell. The seal itself appears as a Hermetic sigil emblazoned in the air.\n\nNote that the seal itself is a spell, and so can be dispelled. However, the seal is only present at the caster’s end of the *Intangible Tunnel*. There is nothing to dispel at the other end.\n\n(Base effect, +1 Touch, + 2 Sun) Required Lab Total to invent spell: depends upon level."
    }

    #t75ba0d4c5019d922f1d5b3 ^"Break the Siege" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "This spell suppresses a magical tunnel created by Hermetic Vim magic, if the level of the magical tunnel creating spell is less than or equal to half the level of this spell + 1 magnitude. For the duration of this spell, spells can no longer be cast through the tunnel, in either direction. When this spell expires, or it is ended some other way, the tunnel may be used again (if it has not expired in the meantime).\n\nIt is a good idea to master this spell taking the Fast Casting mastery (**ArM5**, page 87).\n\nThis spell can be cast at either end of the magical tunnel. However, note that, without the aid of magical senses, only the original caster of the magical tunnel can target it. Of course, the *Break the Siege* effect is a spell, and can be dispelled itself. However, the *Break the Siege *spell is only present at the end which it was cast at. There is nothing to dispel at the other end.\n\n(Base effect, +2 Voice, +2 Sun) Required Lab Total to invent spell: depends upon level."
    }

    #t77a95656afb85f4c5495ee ^"Listen to the Bells" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InTe 30 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "The caster of spell holds a bell and he can sense whatever the bell can sense with its magical senses. Usually a bell has no magical senses, but this spell is useful if the bell has been enchanted with some, as is the Assassin’s Bell.\n\nIn the case of the *Assassin’s Bell*, using the bell’s senses provides enough information to use or target tunnels that the bell can hear.\n\n(Base 20, +1 Touch, +1 Diameter) Required Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #t4cd5eaf2294904a66b5a4a ^"Eyes for the Lurking Assassin" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 45
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InVi 45 R: Personal, D: Diameter, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "This spell detects the presence of an Intangible Tunnel-style tunnel, and reveals its sigil. This is sufficient information to use the tunnel or target the tunnel itself with spells.\n\nNote that a general Intellego Vim spell to detect magic might be used to provide similar information. This spell, however, specifically detects only *Intangible Tunnel* effects. This is useful because, as a magus is likely to be often among a lot of magical effects, he does not want to take time to scan his surroundings individually identifying specific effects as he searches for an *Intangible Tunnel* (see *See the Light of Magic*). This is important because, if the magus suspects he is under attack by an *Intangible Tunnel,* he may only have moments to react.\n\n(Base 5, +1 Diameter, +4 Vision, +3 detailed information)\n\nRequired Lab Total to invent spell: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

    #t183dae6cd38a6f35732b32 ^"Flesh Crawls at the Intangible Touch" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Touch"
            ^"Printed Stat Line" STRING "InVi 30 R: Personal, D: Diameter, T: Touch"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "The caster feels his skin crawling when he is the target of an *Intangible Tunnel*-style tunnel. This provides sufficient information to use the tunnel or target the tunnel itself with spells.\n\nHowever, note that this only works if the caster is himself the target of the tunnel. It does not work on tunnels that are cast on other characters. As with *Eyes for the Lurking Assassin,* a general detection spell might be useful too, but would perhaps make it more difficult to rapidly identify the tunnel in an emergency situation.\n\n(Base 5, +1 Diameter, +1 Touch, +3 detailed information)\n\nRequired Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #t1909e41aabdbe5f1ca3b6a ^"See the Light of Magic" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InVi 30 R: Personal, D: Diameter, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "The caster can detect all active magical effects. Spells appear as glowing lights with a brightness proportional to their magnitude. This spell provides sufficient information to target the sensed magical effects, but the magus does not receive any information about the magical effects, and therefore he does not know which effect is which, if he is looking for a particular one. However, if the caster has used this spell previously, he can identify the presence of a new effect. If there is a large number of effects present, the troupe may rule that a Perception + Awareness roll is required to notice this detail — the Ease Factor should be modified by the total number of effects the caster can perceive and the magnitude of the new effect (relative to the other effects).\n\nThere may be a large number of magical effects active within the vicinity of the magus — Parma Magica, longevity rituals, *Aegis of the Hearth*, familiar bonds, enchanted items, and of course, any active spells will all be detected. Active, non-Hermetic, but magical, effects are also detected.\n\n(Base 5, +1 Diameter, +4 Vision) Required Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #td02a35169429d63d2a1ad9 ^"Sense of the Lodestone" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 5 R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The caster senses the distance and direction to the target. The caster must have an Arcane Connection to the target.\n\nA Momentary duration version of this spell would actually be sufficient to determine the distance and direction of the target. However, by concentrating for several rounds, the caster can also use this spell to estimate the speed and direction of the target (if the target is in motion).\n\n(Base 3, +1 Touch, +1 Concentration) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #t2545c36e5db50780364877 ^"Befuddled Speaker" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 5 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The target stutters and slurs. Communication rolls made for the target are at –3, and he has a –6 penalty to spoken spellcasting (and an additional botch die).\n\n(Base 2, +1 Touch, +2 Sun) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #tf6fb9c33204c2b41ffae17 ^"Searing Touch" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIg 5 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The caster’s fingers burn the target, leaving a brand in the shape of the caster’s hand. The target takes +5 damage. Note that if this spell is not cast through an Intangible Tunnel, the caster will receive damage too.\n\n(Base 4, +1 Touch) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #tfcb56f5e1bff69edb29a01 ^"Chill Touch of Exposure" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeIg 5 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The target shivers like an unwanted baby left alone in a cold and frosty dell, losing a Fatigue level. Repeated casting of this spell can cause the character to eventually become unconscious; this usually takes 5 castings. Mastering this spell with the Multiple Casting mastery can reduce the time that this takes. Once the target is unconscious, additional castings of the spell increase the length of time that the target naturally remains unconscious (see ArM5, page 179)\n\nIf the target is unconscious at either sunrise or sunset, then his Parma Magica will go down.\n\n(Base 4, +1 Touch) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #t5bc0399d2b9debb9c36ebc ^"Fingers for Eyes" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Room"
            ^"Printed Stat Line" STRING "InIm 5 R: Touch, D: Diameter, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The caster can see the Room that the person he touches is in. The spell can be used by a blind magus to “see,” by moving around with his hand on the shoulder of a servant. It can also be used to see the location that an Intangible Tunnel-style effect terminates in.\n\nThis spell only works if the person touched is actually in a Room. This spell must Penetrate in order to sense creatures with Magic Resistance.\n\n(Base 1, +1 Touch, +1 Diameter, +2 Room)\n\nRequired Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #te4d339ed12d8e3fd77bd34 ^"Breath of the Sleeper" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InMe 5 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "This spell detects whether the target is asleep or not.\n\n(Base 4, +1 Touch) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #tbafe46feaa611ac7abb4dd ^"Nails of Iron" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeVi 5 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The touch of the caster tears at the fabric of stories. The target faerie is weakened and loses 10 Might Score. This must Penetrate the faerie’s Magic Resistance. If the faerie is reduced to 0 Might it is destroyed.\n\nNote that this spell is of little use in a Wizard’s War. However, it is a good way to attack a faerie if the magus has discovered an Arcane Connection to it (and can therefore open an *Intangible Tunnel* to the faerie). Similar spells can be used to attack creatures of other realms.\n\n(Base 4, +1 Touch) Required Lab Total to invent spell: One Season (10), Two Seasons (8), Three Seasons (7)."
    }

    #t783183331b6d0b0a4de049 ^"Sulfurous Membrane" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Corpus"
            ^"Printed Stat Line" STRING "MuAu(Co) 10 R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "This effect transforms the air entering the character’s lungs into a noxious sulfur vapor that causes +1 damage each round.\n\n(Base 1, +1 Touch, +2 Sun , +1 Part, +1 Corpus requisite)\n\nRequired Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t098d416d174ff50d0cf8d3 ^"Claw of the Gladiator" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeCo 10 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "This spell opens a bloody wound on the target, which serves as a Light Wound.\n\n(Base 5, +1 Touch) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t65e34dfe622790c290831c ^"Close the Black Gate" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeCo 10 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "This spell destroys a corpse, turning it into a black pool of sticky, viscous liquid. This effect can be used to stop the sodales of a Wizard’s War victim from using a Whispers Through the Black Gate to ask his ghost how he was attacked.\n\nObviously, there are other techniques for communicating with a ghost. However,  *Whispers Through the Black Gate* is the most common such spell in use in the Order.\n\n(Base 5, +1 Touch) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t407a4e9f7792acdf14788f ^"Snatched Voice" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeIm 10 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "The target loses the ability to make sound. If she is a maga and attempts to cast spells, she suffers the penalties for silent casting.\n\n(Base 3, +1 Touch, +1 Diameter, +1 changing image)\n\nRequired Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t391d1b06b4ee012526118a ^"Slap of Absent Magic" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeMe 10 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "The target forgets how to consciously use one Form for the duration of the spell. This includes casting spontaneous, formulaic, and ritual spells of the Form. It also includes spells that use the Form as a requisite. Unconscious use of the Form (for example, the Form bonus to Magic Resistance) is unaffected.\n\nWhen this spell ends, the target recalls how to use the Form.\n\n(Base 4, +1 Touch, +1 Diameter) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t1df24f47ac1e583357c819 ^"Touch of Falling Feathers" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReMe 10 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "The target rapidly falls into a deep sleep. As the spell has a non-Momentary duration, the target cannot be naturally wakened until either this spell is dispelled, or the duration expires.\n\nIf the target is asleep either at sunrise or at sunset, then his Parma Magica will go down.\n\n(Base 4, +1 Touch, +1 Diameter) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #ted728153482f5733a42d67 ^"Break the Shield" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeVi 10 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "This spell dispels the Parma Magica of the target. The target’s Parma Magica Score must be less than (25 + stress die) divided by 5. The target can, of course, recast his Parma Magica in subsequent rounds, but the target may not notice that his Parma Magic has been dispelled until it is too late.\n\nObviously, this spell is only really useful for attacking other magi. Thus, some tribunals may view magi who are known to have invented this spell with suspicion. On the other hand, there are legitimate reasons for knowing this spell — prosecuting Wizard’s War and hunting Marched magi are entirely legal and uncontroversial pursuits.\n\nLike all spells, this spell must Penetrate to be effective.\n\nHigher-level versions of this are possible for attacking targets with greater Parma Magica scores.\n\nNote that this spell uses the Perdo Vim guideline, which dispels magic effects of a specific type (**ArM5**, page 160). Parma Magica is an example of a magical effect of a specific type, which all Hermetic magi are familiar with. This is why *Wind of Mundane Silence* (**ArM5**, page 161), which dispels *all* magical effects is effective against Parma Magica. This spell does not dispel Magic Resistance generated via other sources, nor is this spell effective against any other sorts of magic.\n\n(Base 5, +1 Touch) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #tc2f0ce10e9e6f6d030d95a ^"Trap of Amber" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 15 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "The caster freezes the target in place for the duration of the spell. As well as being unable to move, the target can neither speak nor use gestures in spell casting, and he takes the appropriate penalties if he does try to cast spells regardless.\n\n(Base 5, +1 Touch, +1 Diameter) Required Lab Total to invent spell: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #tb75a1f27b57f7352cf92b3 ^"Curse of the Blasted Heath" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeHe 15 R: Touch, D: Momentary, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "This spell destroys all wooden items that the target is carrying. Note that many magical items and talismans are made of wood or have wooden components.\n\n(Base 5, +1 Touch, +1 Part) Required Lab Total to invent spell: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #t3438c4c078b8d2390d2c8c ^"Fading Star of Evening" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrVi 15 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "This spell causes wild, uncontrolled magic to course through the target. He gains two Warping Points, and if he is a magus, he must check to see whether he enters Twilight.\n\n(Base 10, +1 Touch) Required Lab Total to invent spell: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #t83d6f07bad315700b2f1c0 ^"Lungs of Drowning" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Corpus"
            ^"Printed Stat Line" STRING "CrAq(Co) 20 R: Touch, D: Diameter, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "This spell fills the target’s lungs with water, causing him to experience the sensation of drowning. The character begins to suffer deprivation due to lack of air (see ArM5, page 180), but as the spell only lasts for Diameter duration (two minutes), the character is unlikely to die unless the spell is repeatedly cast on him.\n\n(Base 4, +1 Touch, +1 Diameter, +1 Part, +1 Corpus requisite)\n\nRequired Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t71dd03549b7a7fb6258704 ^"Face of Molded Clay" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Perdo"
            ^"Printed Stat Line" STRING "Mu(Pe)Co 20 R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The caster molds the target’s face into a horrific and ugly visage. The destruction of the character’s features cripples his senses and makes others unable to understand his speech. It is obvious to all who see the character that he has been cursed by some magical effect.\n\nThe target has a –3 penalty to all speech (including spellcasting) due to his malformed mouth, and a –3 penalty to sight, smell, and hearing based rolls.\n\n(Base 3, +1 Touch, +2 Sun, +1 Part, +1 Perdo requisite)\n\nRequired Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t383533d1112cf35bf0d761 ^"Fist of Crippling" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeCo 20 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "This spell inflicts a Heavy Wound on the target.\n\n(Base 15, +1 Touch) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t79cdad297c6d7e8087f236 ^"Kiss of Aging" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeCo 20 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The target instantly ages five years. If the target is age 35 or older for any of these accelerated years, immediately make an aging roll for each such year as normal.\n\n(Base 15, +1 Touch) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t20b878130862eeb90f76e7 ^"Paralysis of The Gift" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeVi 20 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The target feels The Gift becoming dull and moribund. Reduce all the Casting Totals of the target by 10.\n\n(Base effect, +1 Touch, +1 Diameter) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t59d94bb962d7ecc6ae916f ^"Eyes of the Hawk" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 4
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 4 R: Personal, D:Sun, T:Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "The caster gains the eyes of a hawk, which allows him to clearly see for vast distances.\n\n(Base 2, +2 Sun, free requisite) Required Lab Total to invent spell: One Season (8), Two Seasons (6), Three Seasons (6), Four Seasons (5)."
    }

    #t85e3f2c7f305ad9f20adfd ^"Licking the Blade" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 40 R: Sight, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "When casting this spell, the caster holds a glass phial in one hand. When cast, the spell instantly transports a quantity of spilled blood that the caster can see and is within one league (3 miles) into the phial. The blood can be used as a +3 Arcane Connection to the character(s) from which it came. The Arcane Connection lasts for years (see **ArM5**, page 84).\n\nIf the blood comes from a mixture of individuals, it must be sorted using a spell such as *Division According to Blood *before it can be used as an Arcane Connection. The exception is that the unsorted blood can be used as an Arcane Connection for effects that use a Group target to affect the entire group from which the blood came.\n\nThis spell works because once the blood of a character has been spilled, it does not inherit the character’s Magic Resistance. Versions of this spell that instantly transport the blood a shorter (or longer) distance can obviously be invented. The blood might be spilled by a spell effect such as *Crystal Rain,* or it might be spilled via mundane means such as a sword blow or a punch in the face.\n\nThe caster may require some sort of enhancement to his senses (such as *Eyes of the Hawk*) to target the spilled blood at the extremes of the range of this spell.\n\n(Base 25, +3 Sight) Required Lab Total to invent spell: One Season (80), Two Seasons (60), Three Seasons (54), Four Seasons (50)."
    }

    #tfd30e409ed943d0f270d92 ^"Division According to Blood" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Intellego"
            ^"Printed Stat Line" STRING "Re(In)Co 25 R: Touch, D: Momentary, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "To cast this spell, the caster holds a glass phial in each hand. One phial contains blood which may come from a mixture of sources. The other phial is empty. Upon casting the spell, all the blood from one individual only (in the first phial) is instantly transported into the second phial. By repeatedly casting this spell (and having a sufficient quantity of empty phials available), the caster may separate out the blood from a number of individuals. If the first phial contains only blood from one individual, then all of it will instantly transport into the second phial.\n\nThe Intellego requisite is required to distinguish between the different sorts of blood in the phial. The target is Part because only a fraction of the blood (that belonging to one individual) is instantly transported into the second phial.\n\n(Base 10, +1 Touch, +1 Part, +1 requisite) Required Lab Total to invent spell: One Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
    }

    #t8010b471789a648011bd3d ^"Breath of the Glassworker" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrTe 15 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "The caster of this spell makes an “O” shape with his thumb and index finger, into which he then blows. This forms and inflates a small glass phial. The phial only lasts for a day, but this is often long enough to hold a sample of some substance until it is either used or taken to the magi’s laboratory and repackaged.\n\n(Base 3, +1 Touch, +2 Sun, +1 elaborate shape)\n\nRequired Lab Total to invent spell: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #tdc21ca7f7b346c70e53bd6 ^"The Shattered Goblet" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "At the conclusion of this ritual, the caster throws a glass goblet onto the ground which splits into thousands of sharp glass shards, with many times the volume of the original goblet (about 1,000 cubic paces).\n\nIf spread about on the ground, the glass shards cause +5 damage to anyone who walks over the ground, but this damage can be totally avoided by wearing hard-soled boots or shoes. The glass can cover an area about 60 paces across in glass 1 foot deep.\n\nThe glass shards are intended to be used with the *Crystal Rain* spell. The glass shards can be reduced in size to be more easily carried, using the *Miniaturist of Venice* spell.\n\n(Base 3, +1 Touch, +2 Group, +2 Size) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #tb1cf32be913c33b93e482a ^"The Thirsty Dagger" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This ritual creates a metal dagger. The blade contains cleverly designed gutters that feed into a reservoir in the hilt. This means that if anyone is injured by the dagger (takes a Wound), then a sample of their blood is collected in the dagger’s hilt. A version of this ritual could be created with as a spell with a duration (such as Sun) for use in emergency circumstances. However, the dagger created with the ritual is not magical, so it does not need to Penetrate Magic Resistance to harm a target (which a spell with a non-Momentary duration would need to do).\n\nThe dagger can be used as either a thrown or melee weapon. It is less useful in Defense than a normal dagger, and less aerodynamic than a throwing knife. In both cases, this is because *The Thirsty Dagger* is oddly weighted due to the blood reservoir. The dagger’s weapon characteristics are:\n\n**Ability:** Brawl, Init: +0, Atk: +2, Dfn: –1,\n\nDam: +3, Str: –1, Load: 0 **Ability: **Thrown, Init: –1, Atk: 0, Dfn: –1,\n\nDam: +2, Str: –1, Load: 0\n\n(Base 5, +1 Touch, +2 elaborate design) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t65a1ed9bd4eb7899126659 ^"Crystal Rain" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReTe 30 R: Sight, D: Momentary, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This spell causes a vast cloud of sharp shards of glass fly to a point in the sky, and then fall to the earth. From a distance, as the light refracts through the plunging glass, it looks like a curious sort of localized rain. The area covered by the falling glass is about 10 paces across, and anyone in (or passing through) the area takes +10 damage. If a wound is caused, blood from the victim falls onto the earth.\n\nThis is an Aimed spell that consequently bypasses Magic Resistance, and there is a +12 bonus to the Aiming roll to hit due to the number of glass shards\n\n(see **ArM5**, page 86). This Aiming bonus is for a cloud of shards that contains 100 cubic paces of glass. If the cloud of shards contains only 10 cubic paces of glass, the Aiming bonus is reduced to only +6. Remember to count Defense bonuses because of shields.\n\nThis spell requires that the caster has large collection of sharp glass shards, which need to be mundane in order to bypass Magic Resistance in this way. The shards could be created using a momentary Creo Terram ritual (such as *The Shattered Goblet*), or they could be acquired from a mundane craftsman, although this is probably more expensive and inconvenient for most magi. As long as the fallen glass shards remain within Sight range of the caster, the same shards can be used to cast the effect again in a subsequent round.\n\n(Base 3, +3 Sight, +2 Group, +1 Size, +1 affect glass)\n\nRequired Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #te86b531d4b2c4c2db9fc48 ^"Glass Broom" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReTe 30 R: Sight, D: Concentration, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This spell moves a lot of glass objects around. The spell can be used to move around glass created by The Shattered Goblet. It can also be used to move other glass around.\n\nIf a Finesse Roll against an Ease Factor of 9 is failed, then the glass is broken during transit (which is not a problem if the glass is just glass shards).\n\n(Base 3, +3 Sight, +1 Concentration, +2 Group, +1 affect glass)\n\nRequired Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #t91316a82eac62cad2fd491 ^"The Prodigal Returns" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReTe 25 R: Sight, D: Concentration, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "This spell causes a metal weapon (such as a sword or dagger) to fly through the air, safely returning to the outstretched hand of the caster.\n\n(Base 3, +3 Sight, +1 Concentration +2 affect metal)\n\nRequired Lab Total to invent spell:\n\nOne Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
    }

    #t80df46bc0d0660798501fb ^"Pages of the Unfinished Story" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Structure"
            ^"Requisite" STRING "Intellego"
            ^"Printed Stat Line" STRING "Re(In)An 45 R: Touch, D: Momentary, T: Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "This spell requires a piece of parchment written on by a character, such as a page of Lab Text or part of a tractatus. The caster holds the piece of parchment against the wall of a structure (such as a tower), and all pages of parchment written on by the same author, in the last week, within the tower instantly transport into the caster’s hand.\n\nMost authors would immediately notice that their work has been stolen when they return to their writing table. If more than two weeks’ writing is stolen through successive castings of this spell, any Laboratory work on which the author is working will be interrupted.\n\nThis spell uses the Rego Corpus guideline to instantly transport a body, by analogy, to transport animal products.\n\nNote that who wrote the text on a piece of parchment is a part of the history and origins of an animal product (the parchment), which can be detected with an Intellego Animal effect. This is why an Intellego requisite is required.\n\nThis spell only gathers material written by the same character who wrote the sample. Thus, if the sample piece was in fact written by a scribe, instead of by the expected magus, then this spell will collect work written by the scribe.\n\nAn equivalent Herbam spell could be used to gather text written on paper or papyrus, but parchment (which is made from animal hide) is the most common form of writing surface used in the Order of Hermes.\n\n(Base 20, +1 Touch, +3 Structure, +1 Intellego Requisite)\n\nRequired Lab Total to invent spell: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

    #t3737b691819b73abe6ec1d ^"Blood of My Enemy" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "MuCo 10 R: Personal, D: Sun, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The caster of this spell eats a small piece of bread dipped in the blood of another character, although any Arcane Connection to the other character will work. The spell changes the blood of the character so that he becomes a blood relative of the character from whom the consumed blood came. This effect only lasts for the duration of this spell. This does not stop the character from also being a blood relative to his natural relations. Being a blood relative is worth a +1 Sympathetic Connection (ArM5, page 84).\n\nThis spell is possible because, although being a blood relative is a part of a character’s essential nature, Muto spells can violate a character’s essential nature (turn a man into a wolf, for example); the character’s true essential nature merely returns when the Muto spell ends.\n\n(Base 3, +2 Sun, +1 Part) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t9762c6b051648232594091 ^"Wizard’s Breath Stolen" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReAu 4 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This spell traps the breath of a character and seals it into a glass phial held by the caster. The target’s breath is a short-lived Arcane Connection to him (lasts hours; ArM5 page 84), but if the caster can quickly get to a Laboratory, he can fix the Arcane Connection.\n\nThis spell must Penetrate the Magic Resistance of the target to be effective.\n\n(Base 3, +1 Touch) Required Lab Total to invent spell: One Season (8), Two Seasons (6), Three Seasons (6), Four Seasons (5)."
    }

    #td658dbc835b12969a27870 ^"Convergence of Birth" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 10 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This spell, which can use an astrolabe, determines the birth place and time of the target. This is sufficient information to calculate the nativity horoscope of the target, for a +2 Sympathetic Connection; Int + Artes Liberales (astronomy) roll against an Ease Factor of 9 (see ArM5, page 84). Calculating the horoscope itself takes a day.\n\nThis spell must Penetrate the Magic Resistance of the target to be effective. This spell is intended to be cast through an *Intangible Tunnel*.\n\n(Base 5, +1 Touch) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t26e00ab98669fa41c7065b ^"Convergence of Place" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 4 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "This spell, which can use an astrolabe, determines the current celestial location of the target. This is sufficient information to calculate a daily horoscope for the target, for a +1 Sympathetic Connection;\n\nInt + Artes Liberales (astronomy) roll against an Ease Factor of 9 (see **ArM5**, page 84). Calculating the horoscope itself takes an hour.\n\nThis spell must Penetrate the Magic Resistance of the target to be effective. This spell is intended to be cast through an *Intangible Tunnel*.\n\n(Base 3, +1 Touch) Required Lab Total to invent spell: One Season (8), Two Seasons (6), Four Seasons (5)."
    }

    #t74b3f682cffb732caacaa5 ^"Dance of the Spidery Ink" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Muto"
            ^"Printed Stat Line" STRING "Re(Mu)He 15 R: Touch, D: Momentary, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This effect causes a small quantity of text (up to a page) to form into a spidery creature and walk from one piece of paper or vellum to another. The two pieces of paper or vellum are held in either hand of the caster. Casting the spell transfers the text to the second piece of paper or vellum.\n\nNote that this spell does not attempt to understand the moving text in any way.\n\nIn order to preserve the sense of the text, the caster must make a Dex + Finesse roll against an Ease Factor of 9 (if *he* understands the text) or 12 (if he does not understand the text).\n\nFor this spell to work, the ink must be made of a plant product (which is common). A similar spell designed with an Animal, Corpus, or Terram Form will be needed if the ink is an animal, human, or mineral product.\n\nSimilar spells with longer durations and a Group target could be invented to transfer the entire text from a large work. For a Lab Text, for every magnitude of effect (level divided by 5), it takes one hour to move the text. For a summa or tractatus, it takes one hour to move the text per point of Source Quality. Note that this only moves the text from one place to another; it does not create a copy of the text.\n\nThe Muto requisite is required to make the ink stick to the new piece of parchment.\n\n(Base 5, +1 Touch, +1 Part, free requisite)\n\nRequired Lab Total to invest effect: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #tf1214d0665d3b589bc235a ^"Absent Mind of the Scholar" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuMe 10 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell changes the target’s memory so that he believes that Wizard’s War was declared on him one month prior to when it actually was.\n\nThe intent is that this spell is cast via an *Intangible Tunnel*-style effect while the Wizard’s War is legitimately in progress, and the target (believing that the Wizard’s War occurred during the previous month) stops taking protective measures, and leaves the sanctuary of the *Aegis of the Hearth*. Obviously, this strategy will fail if the target is convinced by another character that their memory is in error. However, it might be very difficult to convince a magus that their memory is incorrect, and to be effective this strategy only requires the magus to make a single absent-minded mistake, such as briefly leaving the *Aegis of the Hearth*.\n\n(Base 3, +1 Touch, +2 Sun) Required Lab Total to invent spell: One Season (20), Two Seasons (15), Three Seasons (14), Four Seasons (13)."
    }

    #t673be2f91cb5924378e772 ^"Guttering of the Home-Fires" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReVi Gen R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell temporarily suppresses an Aegis of the Hearth effect. The Aegis of the Hearth effect must be less than half the level of this spell + 3 magnitudes. The known Lab Texts of this spell incorporate a side effect: while the Aegis of the Hearth is lowered, the temperature within the affected boundary is lowered slightly, which sensitive characters might notice.\n\nThis spell must penetrate the *Aegis of the Hearth* effect, of course.\n\nNote that if the *Aegis of the Hearth* is of a high level, then this spell may need to be a ritual.\n\n(Base effect, +1 Touch, +1 Diameter) Required Lab Total to invent spell: depends upon level (see insert earlier)."
    }

    #t543ec1f6c61a8f2eeb2706 ^"Removing the Hearth’s Keystone" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeVi Gen R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The caster dispels an Aegis of the Hearth effect. There is no other evidence that the Aegis is absent, but alert magi crossing the supposed boundary of the Aegis may notice that they do not feel the characteristic tingle which indicates the presence of an Aegis.\n\nThe *Aegis of the Hearth* effect must be less than the level of the *Removing the Keystone* spell + 3 magnitudes + stress die. This spell must penetrate the *Aegis of the Hearth* effect, of course.\n\nNote that if the *Aegis of the Hearth* is of a high level, then this spell may need to be a ritual.\n\n(Base effect, +1 Touch) Required Lab Total to invent spell: depends upon level (see insert earlier)."
    }

}
