EXTENSION "ArM5_Hermetic_Projects_IntangibleAssassin_Tables" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Five: The Intangible Assassin tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tc9657247eaadb9a12450d5 ^"Required Laboratory Totals" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Spell Level", "One Season", "Two Seasons", "Three Seasons", "Four Seasons"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 80
        }
        TABLE {
            "Level 5" "10" "8" "7" "7"
            "Level 10" "20" "15" "14" "13"
            "Level 15" "30" "23" "20" "19"
            "Level 20" "40" "30" "27" "25"
            "Level 25" "50" "38" "34" "32"
            "Level 30" "60" "45" "40" "38"
            "Level 35" "70" "53" "47" "44"
            "Level 40" "80" "60" "54" "50"
        }
        DESCRIPTION "A number of spells in this chapter, including the *Intangible Tunnel* variant spells, are general spells. Depending upon the level of the spell desired the following Lab Totals are required to invent each spell."
    }

}
