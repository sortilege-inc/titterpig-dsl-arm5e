            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Day, +1 Mentem requisite; +1 frequency, +3 environmental trigger, +3 linking trigger)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (74), 2 seasons (56), 3 seasons (50), 4 seasons (47)"
            ^"Printed Effect Line" STRING "ReCo(Me) 37 Pen: 0, Constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "When activated, this spell-like effect causes the corpse to stand, using the spell Animate the Slumbering Corpse. The effect’s default command is, “Stand up.”"
    }

    #t41195b85762ae12a7550d3 ^"The Anointing of the King" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Invested Device: An Orb and a Crown"
            ^"Rules Section" STRING "Invested Device: An Orb and a Crown"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 48
            ^"Penetration" STRING "+30"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect 25 (to affect a level 30 Corpus effect), +1 Touch; +3 linked trigger, +15 Penetration 30)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (96), 2 seasons (72), 3 seasons (64), 4 seasons (60)"
            ^"Printed Effect Line" STRING "MuVi 48 Pen: +30, 1/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "This effect casts Passing the Reigns of Corpus, which allows the ghost to control the animated corpse."
    }

    #tab7427c4a0088e5b90be6b ^"Perceive the Presence of Magic (Invested Device: An Orb and a Crown)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Perceive the Presence of Magic"
            ^"Part Of" STRING "Invested Device: An Orb and a Crown"
            ^"Rules Section" STRING "Invested Device: An Orb and a Crown"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 Sun, +2 Room; +1 frequency, +3 environmental trigger)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (48), 2 seasons (36), 3 seasons (32), 4 seasons (30)"
            ^"Printed Effect Line" STRING "InVi 24 Pen: 0, Constant effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "This spell detects if magic of the sixth magnitude or higher (level 30) has recently been cast in the targeted room. Its intent is to notice when the spell-like effect, An Orb for the Spectral Sovereign, is activated, at which point it will activate its two linked powers in the crown. There is a chance that it notices other spells. If so, it activates its linked powers and the corpse is again animated. Since the corpse is already animated, there is no visible effect."
    }

