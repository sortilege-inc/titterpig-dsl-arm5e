    #tbaa886149e7e92e56c591a ^"Rousing the Receiving Fleshy Host" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Invested Device: The Necromancer’s Grimoire"
            ^"Rules Section" STRING "Invested Device: The Necromancer’s Grimoire"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 42
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "10"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Sun, +1 Mentem requisite; +1 frequency, +3 environmental trigger, +3 linking trigger, +5 penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (84), 2 seasons (63), 3 seasons (56), 4 seasons (53)"
            ^"Printed Effect Line" STRING "ReCo(Me) 42 Pen: 10, Constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This instilled effect casts Animate the Slumbering Corpse. The book must be touching the corpse. The effect needs Penetration because the target is not a regular corpse, but a revenant with a Magic Might of 9 (see “A Necromantic Miscellany,” later). Although the revenant is already animated, moving under the control of its own animating spirit, this effect will override the revenant’s animating spirit and place the bound ghost in charge. The effect’s default command is, “Stand up.”"
    }

