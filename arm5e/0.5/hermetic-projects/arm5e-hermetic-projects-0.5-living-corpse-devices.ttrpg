    }

    #t6a6a0bcc1938d041383ac0 ^"The Collar of Charon" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 29
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Sun; +1 frequency, +3 environmental trigger)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (58), 2 seasons (44), 3 seasons (39), 4 seasons (37)"
            ^"Printed Effect Line" STRING "ReAn 29 Pen: 0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 118
        }
        DESCRIPTION "This effect animates a dead animal. The animal can be Size +1 or smaller.\n\nBase Level Interpretation: Rego Corpus base level 10 animates a corpse."
    }

    #tb3a2e4f44b833a8c21cc7e ^"The Wand of Commanding Charon’s Pack" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12 uses per day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +2 Voice, +2 Sun; +4 frequency)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (78), 2 seasons (59), 3 seasons (52), 4 seasons (49)"
            ^"Printed Effect Line" STRING "ReAn 39 Pen: 0, 12 uses per day R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 118
        }
        DESCRIPTION "When pointed at an animal and the command word spoken, the animal will follow the orders of the wielder. Once so enchanted, the animal will follow the commands of the wielder until the effect expires. Multiple animals may be commanded individually or as a group, at the discretion of the wielder.\n\nWhile designed to allow the wielder to command dead dogs, animated by Collars of Charon, the wand affects living beasts just as easily."
    }

}
