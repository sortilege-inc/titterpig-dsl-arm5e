EXTENSION "ArM5_Hermetic_Projects_LivingCorpse_Devices" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Six: The Living Corpse devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t04a8ae73af91831fe155a8 ^"A Denarius to Hold the Recalled Centurion" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Lesser Enchantments: The Walking Centurion"
            ^"Rules Section" STRING "Lesser Enchantments: The Walking Centurion"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "20"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 Room; +1 frequency, +3 environmental trigger, +10 penetration.)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (88), 2 seasons (66), 3 seasons (59), 4 seasons (55)"
            ^"Printed Effect Line" STRING "ReMe 44 Pen: 20, Constant Effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "An antique Roman silver coin, a denarius, is instilled with the spell Imprison a Ghost in a Vessel, which forces a ghost inside the silver coin. The silver coin is place on the floor of the room in which the ghost is present, and once the command word is spoken, the magic targets the room and the enclosed ghost."
    }

    #t6fee60ac6167d654ba40b5 ^"The Greave of Reveille" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Lesser Enchantments: The Walking Centurion"
            ^"Rules Section" STRING "Lesser Enchantments: The Walking Centurion"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 34
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Sun, +1 Mentem requisite; +1 frequency, +3 environmental trigger)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (68), 2 seasons (51), 3 seasons (46), 4 seasons (43)"
            ^"Printed Effect Line" STRING "ReCo(Me) 34 Pen: 0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "This iron leg armor is instilled with the spell Animate the Slumbering Corpse, which will animate the non-magical corpse wearing it. The command, “Stand at attention,” is issued as soon as the magic activates."
    }

    #ted2c804e4e2749bec3ff64 ^"The Blade of Lead" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Charged Items: The Necromancer’s Blades"
            ^"Rules Section" STRING "Charged Items: The Necromancer’s Blades"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 36
            ^"Penetration" STRING "12"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +2 Voice, +3 Moon; +6 penetration.)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (36, plus 1 charge for every 5 points above 36)"
            ^"Printed Effect Line" STRING "ReMe 36 Pen: 12 R: Voice, D: Moon, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "This lead dagger is instilled with the spell Imprison a Ghost in a Vessel, which forces a ghost inside a container selected by the wielder at the time of activation. Lead grants a +3 Lab Total bonus for binding ghosts."
    }

    #te1cbe7fb3cb8e28797041c ^"The Blade of Amber" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Charged Items: The Necromancer’s Blades"
            ^"Rules Section" STRING "Charged Items: The Necromancer’s Blades"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "0"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +2 Voice, +3 Moon, +1 Mentem requisite)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (40, plus 1 charge for every 5 points above 40)"
            ^"Printed Effect Line" STRING "ReCo(Me) 40 Pen: 0 R: Voice, D: Moon, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "This dagger made of amber is instilled with the spell Animate the Slumbering Corpse. Because the corpse does not have Magic Resistance, the spell-like effect does not need Penetration."
    }

    #ta1dac9da5bb7bc18ed0fe2 ^"An Orb for the Spectral Sovereign" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Invested Device: An Orb and a Crown"
            ^"Rules Section" STRING "Invested Device: An Orb and a Crown"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 52
            ^"Penetration" STRING "30"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 Room; +1 frequency, +3 environmental trigger, +3 linked trigger, +15 penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (104), 2 seasons (78), 3 seasons (70), 4 seasons (65)"
            ^"Printed Effect Line" STRING "ReMe 52 Pen: 30, Constant Effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "A hand-sized gold globe is instilled with the spell Imprison a Ghost in a Vessel (see earlier), which captures a ghost inside it. The power activates when triggered by the linked spell, Detect the Presence of the Spectral Sovereign."
    }

    #t0e133124042754eb4119be ^"Detect the Presence of the Spectral Sovereign" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Invested Device: An Orb and a Crown"
            ^"Rules Section" STRING "Invested Device: An Orb and a Crown"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 49
            ^"Penetration" STRING "30"
            ^"Uses" STRING "2 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 Room; +1 2 uses per day, +3 environmental trigger, +15 penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (98), 2 seasons (74), 3 seasons (66), 4 seasons (62)"
            ^"Printed Effect Line" STRING "InVi 49 Pen: 30, 2 uses per day R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "This effect detects the presence of a specific ghost, which is determined during the creation of the invested device. Every sunrise and sunset this power activates, constantly scanning the room the invested device is touching for a specific ghost. If the spell-like effect detects the ghost and penetrates its Magic Resistance, this effect activates the device’s primary power and binds the ghost within the gold globe."
    }

    #tcf0bd1ed61cd1fa67e446b ^"The Rising of the King" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
