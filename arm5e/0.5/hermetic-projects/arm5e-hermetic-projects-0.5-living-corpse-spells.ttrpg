EXTENSION "ArM5_Hermetic_Projects_LivingCorpse_Spells" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Six: The Living Corpse spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tc9b86e64f888fa1f87f313 ^"Imprison a Ghost in a Vessel" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 25 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "This spell forces a ghost into a container of some type. The spirit remains bound within the vessel for the duration of the spell. While the spirit cannot affect its prison with magic to force its release, its powers are not otherwise limited.\n\n(Base 5, +2 Voice, +2 Sun) Required Lab Total: 1 season (50), 2 seasons (38), 3 seasons (34), 4 seasons (32)"
    }

    #t3cbda092b085a68bb19029 ^"Animate the Slumbering Corpse" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Mentem"
            ^"Printed Stat Line" STRING "ReCo(Me) 35 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "A variant of Awaken the Slumbering Corpse (ArM5, page 134), this spell allows a caster to control a corpse through mental, rather than verbal, commands.\n\n(Base 10, +2 Voice, +2 Day, +1 Mentem requisite)\n\nRequired Lab Total: 1 season (70), 2 seasons (53), 3 seasons (47), 4 seasons (44)"
    }

    #t23f3c6836b4e77ed76fe80 ^"Passing the Reins of Corpus" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuVi Gen R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "Cast at the same time as another spell, this spell lets the caster pass control of the first spell to another person. The level of the affected spell must be less than the level +1 magnitude of Passing the Reins of (Form), and it only works on spells with Duration longer than Momentary. The spell does not change the target of the affected spell. As with other Muto Vim spells, the caster must succeed at an Intelligence + Concentration roll against an Ease Factor of 9 (ArM5, page 159).\n\n(Base effect, +1 Touch) Required Lab Total: Dependent upon level of spell"
    }

    #t0e18a2fcc973188702438a ^"Create a Human Corpse" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "This ritual creates a human corpse. The lowest level a ritual spell can be is 20.\n\n(Base 5, +1 Touch)\n\nRequired Lab Total: 1 season (40), 2 seasons (30), 3 seasons (27), 4 seasons (25)"
    }

    #t8bdffac6895850a1abcedc ^"Create a Dead Turb" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Mom, T: Group, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "This ritual creates ten human corpses. (Base 5, +1 Touch, +2 Group) Required Lab Total: 1 season (40), 2 seasons (30), 3 seasons (27), 4 seasons (25)"
    }

    #t551c15dd9d4de81f96f0f6 ^"Control the Dead Turb" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReCo 40 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "A group of ten corpses animate and follow the caster’s verbal commands.\n\nIndividual commands cannot be issued to a particular member of the group; every corpse follows the caster’s command. While they each perform the same task, they are not considered a trained group for combat purposes.\n\n(Base 10, +2 Voice, +2 Sun, +2 Group) Required Lab Total: 1 season (80), 2 seasons (60), 3 seasons (54), 4 seasons (50)"
    }

    #tc0be8ac034f6023e79254d ^"Conjure a Dead Army" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 25 R: Touch, D: Mom, T: Group, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "This ritual creates 100 corpses. (Base 5, +1 Touch, +2 Group, +1 for larger group)\n\nRequired Lab Total: 1 season (50), 2 seasons (38), 3 seasons (34), 4 seasons (32)"
    }

    #t8128d86d4355f6394ef655 ^"Control the Dead Army (page 116)" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Control the Dead Army"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReCo 45 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "This spell causes 100 corpses to animate and follow the caster’s verbal commands.\n\nIndividual commands cannot be issued to a particular member of the group; every corpse follows the caster’s command. While\n\nthey each perform the same task, they are not considered a trained group for combat purposes.\n\n(Base 10, +2 Voice, +2 Sun, +2 Group, +1 for larger group)\n\nRequired Lab Total: 1 season (90), 2 seasons (68), 3 seasons (60), 4 seasons (57)"
    }

    #t3c3c970f0f65a34c443acf ^"Conjure the Horde of the Dead" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 30 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This ritual creates 1,000 corpses. (Base 5, +1 Touch, +2 Group, +2 for larger group)\n\nRequired Lab Total: 1 season (60), 2 seasons (45), 3 seasons (40), 4 seasons (38)"
    }

    #t9fe375e171c97f78d0be11 ^"Control the Dead Army (page 117)" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Control the Dead Army"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReCo 50 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This spell causes 1,000 corpses to animate and follow the caster’s verbal commands.\n\nIndividual commands cannot be issued to a particular member of the group; every corpse follows the caster’s command. While they each perform the same task, they are not considered a trained group for combat purposes.\n\n(Base 10, +2 Voice, +2 Sun, +2 Group, +2 for larger group)\n\nRequired Lab Total: 1 season (100), 2 seasons (75), 3 seasons (67), 4 seasons (63)"
    }

    #t71cb48f532148b88e3e37d ^"Conjure the Walking Dead" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Auram, Terram, Vim"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 50 R: Touch, D: Mom, T: Ind, Ritual Req: Auram, Terram, Vim"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This ritual creates a revenant — one of the magical walking dead. Different from an animated corpse, a revenant is a malefic creature with a Magic Might of 9. While it is lacking intelligence, a revenant possesses a violent personality and, if not immediately magically controlled, it attacks the nearest living creature. The Auram and Terram requisites are necessary for instilling the revenant’s magic powers.\n\n(Base 45, +1 Touch) Base Level Interpretation: A level 10 Creo Animal spell creates the corpse of a mundane animal, while a base level 5 Creo Corpus spell creates a mundane human corpse. A level 50 Creo Animal spell will create a magical beast, meaning that a level 45 Creo Corpus spell will create a magical human.\n\nRequired Lab Total: 1 season (100), 2 seasons (75), 3 seasons (67), 4 seasons (63)"
    }

    #t5412b6730df870d7fcd0e3 ^"Conjure the Colossus" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This ritual creates a huge human corpse of Size +4. It is similar to a regular conjured corpse in every way except size. Spells designed to control a colossus must also take into account its larger Size.\n\n(Base 5, +1 Touch, +1 Size increase, min level 20 for a Ritual)\n\nRequired Lab Total: 1 season (40), 2 seasons (30), 3 seasons (27), 4 seasons (25)"
    }

    #t07db7fd20da2ae61596366 ^"Awaken the Colossus" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 35 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This spells causes the Size +4 colossus corpse to animate and follow the caster’s verbal commands.\n\n(Base 10, +2 Voice, +2 Sun, +1 Size increase)\n\nRequired Lab Total: 1 season (70), 2 seasons (53), 3 seasons (47), 4 seasons (44)"
    }

    #t52a0006ae631f0d17c18fb ^"Bequeathing Salome’s Request" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Mom, T: Part, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This spell creates a human head, complete with skin, eyes, teeth, and hair. The particulars of the head’s appearance are up to the spell’s inventor. Castor of Sicily’s version of the spell makes created heads look like his own. The spell is named after Salome, the stepdaughter of King Herod, who asked for and received the head of John the Baptist, according to Biblical history.\n\n(Base 5, +1 Touch, +1 Part: however the lowest level a ritual can be is 20)\n\nBase Level Interpretation: According to *Magi of Hermes*, page 84, the base level to create part of a corpse is the same as the base level to create the whole corpse, adjusted by the increased Target: Part.\n\nRequired Lab Total: 1 season (40), 2 seasons (30), 3 seasons (27), 4 seasons (25)"
    }

    #t67663821829f44b8f65649 ^"Forging the Bone Cover" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuCo 5 R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This spell changes the inelastic nature of bone, making it elastic and able to be reshaped under pressure. The skull becomes as pliable as clay for the duration of the spell. Once this spell is cast, a human skull can be pressed into a book-shaped wooden frame. When the spell ends, the skull reverts to its inelastic property, but retains its new shape. If later used in an enchanted item, the reshaped skull still gives the magus the same Shape & Material bonus (ArM5, page 110).\n\n(Base 3, +1 Touch, +1 Conc) Base Level Interpretation: A base level 1 Muto Terram spell will change one property of dirt. The base level to create dirt is Creo Terram 1, and the base level to create stone is base level 3. A base level 3 Muto Terram would change one property of stone. Bone is harder than dirt but softer than stone, so a base level 1 would not be enough, but base level 3 would. Thus: Muto Corpus base level 3, change one property of bone.\n\nRequired Lab Total: 1 season (10), 2 seasons (8), 3 seasons (7), 4 seasons (7)"
    }

}
