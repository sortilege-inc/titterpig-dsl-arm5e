EXTENSION "ArM5_Hermetic_Projects_LivingCorpse_Tables" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Six: The Living Corpse tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ArM5_Hermetic_Projects_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tc6d5650d49004b91d08e13 ^"Pertinent Material and Size Tables" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Item", "Points"]
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 99
        }
        TABLE {
            "Amulet, bone" "3"
            "Amulet, precious engraved gem" "15"
            "Amulet, semi-precious engraved gem" "12"
            "Coin pendant, gold" "10"
            "Coin pendant, silver" "6"
            "Hamsa, clay" "3"
            "Phylactery, iron" "5"
            "Phylactery, wood" "2"
            "Tefillah, leather" "2"
        }
    }

    #tc124c3d8b29d7aa10e9bb5 ^"The Type of Ghost a Spirit Becomes Table" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Roll", "Result"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 107
        }
        TABLE {
            "1" "No spirit remains — there is simply no spirit to summon, now or in the future."
            "2" "The spirit becomes an Infernal, Divine, or Faerie ghost, whichever best suits the magus."
            "3" "The spirit is mindless and passionless, with a Magic Might of 0 and no magical powers."
            "4-5" "The spirit is a simple animating spirit, similar to one that exists in a revenant."
            "6-7" "The spirit becomes a magic ghost specter."
            "8" "The spirit becomes a magic ghost shade."
            "9-10" "The spirit becomes a magic ghost apparition."
        }
    }

    #t993110c52ed8273847db3a ^"Living Corpse Magic Might Table" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Power", "Specter", "Shade", "Apparition"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 108
        }
        TABLE {
            "Low" "0" "5" "10"
            "Medium" "3" "10" "20"
            "High" "5" "15" "30"
            "Legendary" "10" "25" "50"
        }
    }

    #t5277af281a995871b967cd ^"Abilities: Type of Spirit, Season, and Experience" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Type of Spirit", "Season", "Experience"]
            ^"Table Name Source" STRING "editorial: the book prints no title for this table; named for the section it stands in"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 110
        }
        TABLE {
            "Animating Spirit" "Spring" "120"
            "Specter" "Summer" "360"
            "Shade" "Autumn" "720"
            "Apparition" "Winter" "1200"
        }
    }

}
