EXTENSION "ArM5_Hooks_EchoesOfTheAncientDead_Abilities" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Three: Echoes of the Ancient Dead abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #te6f7263158a802b2fe2680 ^"Lore of the Dead" DEF {
        EXTENDS #tWPnyoi9rSMWyMo7Njlo9XM2 ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "New Supernatural Ability: Lore of the Dead"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Specialties" STRING "specific rite, casual, ceremonial"
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Rites may be cast either ceremonially or casually, using casting totals as shown later, with the Ease Factors listed for each rite.\n\nCeremonial rites take one hour and may include props to utilize appropriate Shape & Material bonuses, limited by the score in Lore of the Dead.\n\nCasual rites take only one round, but the casting total is halved unless a Fatigue level is spent. Vis cost if any is listed.\n\nAll rites need to Penetrate unless noted otherwise."
    }

}
