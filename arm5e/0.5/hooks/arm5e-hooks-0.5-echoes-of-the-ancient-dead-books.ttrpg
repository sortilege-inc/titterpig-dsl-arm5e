EXTENSION "ArM5_Hooks_EchoesOfTheAncientDead_Books" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Three: Echoes of the Ancient Dead books"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # The chapter's books, structured; each DESCRIPTION the source's text, verbatim.

    #tbeb2a090eecce39dfd967d ^"The Clay Tablets (book)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Clay Tablets"
            ^"Kind" STRING "Summa"
            ^"Subject" STRING "Area Lore: Canaan"
            ^"Level" INTEGER 10
            ^"Quality" INTEGER 15
            ^"Section" STRING "Mechanics of the Tablets"
            ^"Printed Entry" STRING "the tablets are revealed to be a Summa in Area Lore: Canaan. A complete sequence of six tablets is Level 10 Quality 15, with each missing tablet subtracting three from Quality."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 22
        }
    }

}
