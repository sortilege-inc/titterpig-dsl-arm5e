EXTENSION "ArM5_Hooks_IntoTheValley_InitiationScripts" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Four: Into the Valley initiation scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # The chapter's initiation scripts, structured; each DESCRIPTION the source's text, verbatim.

    #td620e186b8ca1052b4df19 ^"New Bjornaer Mystery: Initiation of the Simple Heartbeast" DEF {
        EXTENDS #tMCInitiationScriptTypeAAAA ^"Initiation Script"
        PROPERTIES {
            ^"Ease Factor" STRING "15 (Minor Virtue known to the Mystagogue)"
            ^"Script Bonus" STRING "+6 + Participation Modifier (see later)"
            ^"Mystery" STRING "Heartbeast"
            ^"House" STRING "House Bjornaer"
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "The Mystagogue must possess Organization Lore: Bjornaer to perform this ritual. The Initiate must not possess The Gift. At the site of a nature spirit’s regio (+3), the Initiate renounces all spiritual beliefs and accepts the rites and practices of the nature spirit in question. This grants the Flaw Magical Air (+3); however, animals of the same species as the Initiate’s heartbeast ignore this modifier. As at the Ritual of Twelve Years, the Participation modifier provides +1 for every witness who has the same temperament as the probationer’s heartbeast and –1 for every witness who has an opposing temperament. The Initiate’s final Initiation Total must equal or exceed the Ease Factor to succeed.\n\nThe standard heartbeast rules apply (**ArM5**, page 91–2). The heartbeast is a Hermetic Virtue, but Clan Ilfetu has also developed an Initiation that awakens the heartbeast of the unGifted. Antunnos refers to this as the ‘simple’ heartbeast.\n\nInitiation mechanics are discussed in The Mysteries Revised Edition and Houses of Hermes: Mystery Cults."
    }

}
