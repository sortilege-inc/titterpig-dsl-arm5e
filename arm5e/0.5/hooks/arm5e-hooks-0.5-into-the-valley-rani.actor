EXTENSION "ArM5_Hooks_IntoTheValley_Rani" {
    NAME "Ars Magica Fifth Edition, Hooks - Rani"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # Rani (Chapter Four: Into the Valley, p40): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t03ddaeda3dcb3ed508d3e6 ^"Rani" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per +1, Pre –1, Com -1, Str +2, Sta +2, Dex 0, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "27 (27)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Warrior; Shape-shifter; Dark Secret: Pomeranian Witch (Guardians of the Forest, page 99), Social Handicap (morose temperament)"
            ^"Personality Traits" STRING "Quiet +3, Wanderer +2, Greedy +1"
            ^"Reputations" STRING "Mercenary +2 (Antunnos’ bodyguard)"
            ^"Combat" STRING "Bow (short): Init +1, Attack +8, Defense +7, Damage +8 Fist: Init +2, Attack +3, Defense +5, Damage +2 Kick: Init +1, Attack +3, Defense +4, Damage +5 Knife: Init +2, Attack +5, Defense +6, Damage +4 Knife (thrown): Init +2, Attack +5, Defense n/a, Damage +4 Spear: Init +4, Attack +6, Defense +6, Damage +7"
            ^"Soak" STRING "+2 (without armor)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21)+"
            ^"Abilities" STRING "Bows 5 (short bow), Brawl 3 (knife), Craft: Hideworking 2 (skinning), Hunt 5 (forests), Local Language 3 (townsfolk), Shapeshifter 3 (boar, bear, bull), Single Weapon 3 (knife), Slavic 5 (fables), Stealth 5 (forests), Survival 3 (forests), Thrown Weapon 3 (knife)"
            ^"Equipment" STRING "Rani is generally clothed in wools that can be easily discarded if he should shapeshift. Any tool or weapon he uses is taken from the immediate environment, although he does keep a knife in his boot."
            ^"Encumbrance" STRING "0 (2)"
            ^"Appearance" STRING "A man of average build, with the straight nose, brown eyes, and soft brown shoulder-length hair of the Baltic people. He usually wears simple wool clothes and a heavy, hooded cloak to keep warm. His voice is soft and carries a subtle, depressing tone."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 40
        }
    }

}
