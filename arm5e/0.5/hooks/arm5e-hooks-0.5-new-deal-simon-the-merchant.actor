EXTENSION "ArM5_Hooks_NewDeal_SimonTheMerchant" {
    NAME "Ars Magica Fifth Edition, Hooks - Simon the Merchant"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # Simon the Merchant (Chapter Five: New Deal, p47): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t4c2bee4be567ad1c3fb037 ^"Simon the Merchant" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +1, Pre +2, Com +1, Str 0, Sta +1, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "32 (32)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Capo, Wealthy; Vernacular Education; Avaricious, Dark Secret; No Sense of Direction These Virtues and Flaws are found in City & Guild page 109. Capo is a Major Social Virtue: Simon manages the trading company in this town. Vernacular Education is a Minor General Virtue, granting additional experience points for trade-related abilities."
            ^"Personality Traits" STRING "Avaricious +6, Smiling +3, Devious +2"
            ^"Reputations" STRING "Powerful Merchant 2"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +2, Damage n/a Dagger: Init +0, Attack +5, Defense +3, Damage +3"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Town 4 (business), Artes Liberales 1 (arithmetic), Bargain 6 (selling), Brawl 2 (dagger), Charm 4 (customers), Etiquette 4 (nobility), Folk Ken 4 (while trading), Guile 4 (half-truths), Intrigue 4 (plotting), Latin 4 (trade), Leadership 2 (merchant), Local Language 5 (upper class), Organization Lore: Trading Guild 3 (personalities), Profession: Merchant 6 (rare goods), Ride 3 (walk)"
            ^"Equipment" STRING "Fine merchant’s clothes, writing implements, dagger"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Simon is a handsome man, fair-skinned with a healthy complexion. His lightly curled hair is dark brown as is his neatly trimmed beard. He is almost constantly smiling, giving rise to his nickname, but the smile has a sneaky and predatory quality. His sleek frame looks slightly more imposing due to the cut of his clothes, as well as padding in the right places."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "Simon’s merchant father recently died of old age, and the four sons split the business between them. Simon was tasked with setting up a new venture in this town. It was perhaps the hardest task, but he relishes the challenge as well as the freedom to do as he pleases without interference. Besides his trading, he is also a successful moneylender. Since Christians don’t charge interest, his profit comes from impounding wares, ships, or buildings from debtors who fail to pay, and adding any expenses for storage and transport he can get away with."
    }

}
