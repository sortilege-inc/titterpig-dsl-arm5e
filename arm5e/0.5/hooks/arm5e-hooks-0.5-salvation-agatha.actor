        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per +1, Pre +1, Com 0, Str –1, Sta 0, Dex +2, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "19 (19)"
            ^"Virtues and Flaws" STRING "Peasant; Puissant Ability: Second Sight, Second Sight, Student of the Infernal Realm; Infamous (Devil Worshiper), Lost Love (Sara), Offensive to Animals."
            ^"Personality Traits" STRING "Lonely +3, Scared +1"
            ^"Reputations" STRING "Devil Worshiper +4 (local area)"
            ^"Combat" STRING "Dodge: Init +2, Attack n/a, Defense +5, Damage n/a Knife: Init +2, Attack +7, Defense +6, Damage +1"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
