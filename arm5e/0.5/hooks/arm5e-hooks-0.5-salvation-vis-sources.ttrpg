EXTENSION "ArM5_Hooks_Salvation_VisSources" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Six: Salvation vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t68a49ddb20a6682fb20cc9 ^"An Infernal Vis Source" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Ignem"
            ^"Yield" LIST OF STRING ["Five pawns of Ignem vis can be harvested per season"]
            ^"Location" LIST [#t1d6e85434fd69bbd55acb5 ^"The Damned Monastery of Saint Sylvester"]
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "The infernal hellfire can be harvested as an Ignem vis source. Five pawns of Ignem vis can be harvested per season, and this vis is tainted with the infernal. The storyguide can adjust the number of pawns available to suit your saga. It is best to err on the side of generosity, as Hell provides the vis as a temptation."
    }

}
