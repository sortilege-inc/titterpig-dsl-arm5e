EXTENSION "ArM5_Hooks_TheRiver_CattusDaughterOfTheDanube" {
    NAME "Ars Magica Fifth Edition, Hooks - Cattus, Daughter of the Danube"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # Cattus, Daughter of the Danube (Chapter Eight: The River, p80): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tcd8940bfb8d3e451c8cf48 ^"Cattus, Daughter of the Danube" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per –2, Pre –5 (1), Com –6, Str –5, Sta +2, Dex +2, Qik +3"
            ^"Size" STRING "–3"
            ^"Age" STRING "20 (14; ages with Trajan)"
            ^"Decrepitude" STRING "0 (1)"
            ^"Warping Score" STRING "0 (3)"
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Dowsing, Self-Confident, True Friend (Trajan); Nocturnal"
            ^"Qualities" STRING "Aquatic (breathes water), Camouflage (+3 hide when stationary), Pursuit Predator (extra Fatigue Level), Slippery (+6 Defense against Grapple), Thick Scales (+1 Soak)"
            ^"Personality Traits" STRING "Loyal (Trajan) +3, Confident +2, Nocturnal +1"
            ^"Reputations" STRING "Trajan’s Familiar 1 (Hermetic)"
            ^"Combat" STRING "Dodge: Init +3, Attack n/a, Defense +6, Damage n/a Teeth: Init +3, Attack +9, Defense +8, Damage –4"
            ^"Soak" STRING "+5 (+1 Thick Scales, +2 Sta, +2 Bronze Cord)"
            ^"Fatigue Levels" STRING "OK, 0, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
            ^"Abilities" STRING "Awareness 2 (food), Brawl 3 (teeth), Dead Language: Latin 4 (Hermetic usage), Dowsing 5 (vis), Hunt 4 (smaller fish), Living Language: High German 5 (Bavarian), Magic Theory 3 (lab assistant), Stealth 2 (shallows), Survival 3 (rivers), Swim 5 (upstream)"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "None."
            ^"Appearance" STRING "Cattus (Cat) has been Trajan’s familiar for 14 years. She is a playful, speckled brown trout, and very difficult to spot as she swims along the Danube. When Tajan is away from the river Cattus patrols for perils to the river’s spirit (unless set some other task)."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 80
        }
        DESCRIPTION "Cattus is not a magic creature, but she was born with the Supernatural Ability to find things in the river bed (Dowsing) and she found Trajan when he was ready for a familiar. Trajan later paid another Rhine magus to cast rituals to increase Cattus’ Intelligence to 0. As she has no Magic Resistance of her own, Cattus uses Trajan’s Form Art Scores as her Magic Resistance.\n\nTrajan created the Familiar Bond with an InAq Lab Total of 25 (Gold Cord +1, Silver Cord +1, Bronze Cord +2). The bond has been enchanted with Mental Communication which allows Trajan to speak telepathically with Cattus (and vice versa, thus, two powers; see ArM5, page 105)."
    }

}
