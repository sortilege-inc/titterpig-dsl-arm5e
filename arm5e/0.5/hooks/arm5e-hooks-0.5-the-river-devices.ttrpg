EXTENSION "ArM5_Hooks_TheRiver_Devices" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Eight: The River devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t9691cacb9b09c67a660132 ^"Robes of the Cataract" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 24
            ^"Requisite" STRING "Rego"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun; +4 Constant Effect)"
            ^"Printed Effect Line" STRING "Cr(Re)Aq 24 Pen 0, constant effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "Trajan wears this enchanted copper torque, stained blue-green with age, around his neck. The item constantly creates a swirling torrent of water around Trajan in the shape of robes. Any mundanes who see this are impressed and terrified. Most magi consider it to be showing off."
    }

}
