EXTENSION "ArM5_Hooks_ToTheDarkTower_AndruASquire" {
    NAME "Ars Magica Fifth Edition, Hooks - Andru, a Squire"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # Andru, a Squire (Chapter Nine: To the Dark Tower, p91): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #td0f5c48ff1f60462fb1a9c ^"Andru, a Squire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +3, Pre +1, Com –2, Str 0, Sta 0, Dex +1, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "21 (21)"
            ^"Confidence Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Custos (squire); Premonitions (Magic Supernatural Ability), Warrior; Poor Student, Social Handicap, Weakness (solving social mysteries)"
            ^"Personality Traits" STRING "Curious +3, Loyal +3"
            ^"Reputations" STRING "Interfering +3 (local)"
            ^"Combat" STRING "Gauntlet: Init +1, Attack +5, Defense +6, Damage +3 Long Sword: Init +3, Attack +11, Defense +8, Damage +6 Heater Shield: Init -, Attack -, Defense +3, Damage -"
            ^"Soak" STRING "+9 (Sta + Full Chain)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 3 (horses), Area Lore: Brittany 2 (towns), Athletics 2 (grace), Awareness 2 (things out of place), Bows 1 (short bow), Brawl 3 (gauntlet), Carouse 1 (courtly), Chirurgy 1 (light wounds), Etiquette 1 (courtly), Folk Ken 3 (social problems), Great Weapon 1 (spear), Hunt 3 (falconry), Leadership 1 (battle), Living Language: Breton 5 (courtly), Premonitions 3 (domestic problems), Ride 3 (racing), Single Weapon 5 (sword), Stealth 1 (urban), Survival 1 (forest)"
            ^"Equipment" STRING "Long sword, heater shield, full chain armor, warhorse."
            ^"Encumbrance" STRING "4 (4; armor + long sword + heater shield)"
            ^"Appearance" STRING "A young, clean shaven man with short unruly, curly brown hair, Andru is a keen observer of how others interact socially. Andru is particularly adroit at spotting unresolved social tensions, which he often then attempts to resolve, despite the anger his interference usually provokes. Like the others he is heavily armed and armored. He wears a simpler tabard than the others, which reveals to those with suitable heraldic knowledge that he is a retainer of Sir Erwan."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 91
        }
    }

}
