EXTENSION "ArM5_Hooks_ToTheDarkTower_SirLouisAndSirRudolph" {
    NAME "Ars Magica Fifth Edition, Hooks - Sir Louis and Sir Rudolph"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Hooks_Core_Ext"

    # Sir Louis and Sir Rudolph (Chapter Nine: To the Dark Tower, p90): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tbc17b16a52cc9522776526 ^"Sir Louis and Sir Rudolph" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per 0, Pre +1, Com 0, Str +2, Sta +1, Dex +1, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "28 (28)"
            ^"Confidence Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Knight; True Friend, Warrior; Ability Block (Academic), Afflicted Tongue (Louis only), Missing Eye (Rudolph only), Vow (Code of Chivalry)"
            ^"Personality Traits" STRING "Brave +3, Chivalrous +2, Loyal +2"
            ^"Reputations" STRING "Twin Valiant Knights +2 (nobles), Vicious Brawlers +1 (local)"
            ^"Combat" STRING "Gauntlet: Init +1, Attack +4, Defense +5, Damage +4 Long Sword: Init +3, Attack +11, Defense +8, Damage +8 Heater Shield: Init -, Attack -, Defense +3, Damage - Lance: Init +3, Attack +13, Defense +9, Damage +7 Long Spear: Init +4, Attack +10, Defense +8, Damage +9 Sir Rudolph’s Attack values have a penalty of –1 due to his Missing Eye. Soak: +10 (Sta + Full Chain)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 2 (hunting dogs), Area Lore: Brittany 3 (Penthièvre), Athletics 2 (racing), Awareness 2 (battlefield), Brawl 3 (wrestling), Carouse 2 (soldiers), Chirurgy 1 (brawling injuries), Concentration 1 (vigil), Etiquette 1 (heraldry), Great Weapon 5 (spear), Hunt 3 (tracking), Leadership 2 (men-at-arms), Living Language: Breton 5 (courtly), Ride 5 (battle), Single Weapon 5 (sword), Stealth 3 (forest), Survival 1 (forest)"
            ^"Equipment" STRING "Long sword, heater shield, full chain armor, warhorse, lance, long spear."
            ^"Encumbrance" STRING "2 (4; armor + long sword + heater shield)"
            ^"Appearance" STRING "The twins Louis and Rudolph are heavily armed and wear virtually identical heraldry, such that only the most skilled heralds can distinguish them from each other on the battlefield. Even their warhorses appear to be twins. When they remove their helms, both brothers reveal long mustaches, and blue eyes set in nearly identical faces, albeit both somewhat beaten and weathered by a brutal career of hunting, drinking, and fighting. Stripped of the anonymity of his steel helm, Rudolph is easily identifiable by a large, long-healed, scar that cuts through the entire left-side of his face."
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 90
        }
    }

}
