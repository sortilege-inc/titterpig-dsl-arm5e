        }
        DESCRIPTION "Target level 17, as Major Virtue 21 (may briefly ignore mundane objects), second Initiation since Intermediate Ordeal –4\n\nScript Bonus +12: Ordeal (Major Flaw Twilight prone) +9, Mystagogue’s time +3"
    }

    #ta76ba62c9df87d1d7fc83a ^"The Avenue of Faith in Strife and the Station of the Eater of Sin" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "21: Treated as a Major Virtue (may sense magic and use a weapon with Enigmatic Wisdom score)"
            ^"Script Bonus" STRING "+15"
            ^"Path" STRING "The Path of Strife, Portrayed With Figures"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 21: Treated as a Major Virtue (may sense magic and use a weapon with Enigmatic Wisdom score)\n\nScript Bonus +15: Ordeal (Blatant Gift) +9, special Ppace and time +3, sympathetic bonus (commit transgression by eating meat, having sex, and engaging in other profanities) +3\n\nAs an alternative Script, those magi who kill the Primus during the House’s succession ritual are Initiated into the first station of this path. They cannot continue on the path until they study House Criamon Lore and may not know that the House has granted them this gift until their mystical sense begins to manifest. Followers of the second script do not develop the Blatant Gift. In this ritual, the genius of the House acts as Mystagogue (Presence + House Criamon Lore of 15).\n\nScript Bonus +6: Special place and time +3, sympathetic bonus (transgression of murdering the Primus) +3"
    }

    #td25db210c52a35e7351399 ^"The Avenue that Splinters and the Station of Blood and Bronze" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "12"
            ^"Script Bonus" STRING "+6"
            ^"Path" STRING "The Path of Strife, Portrayed With Figures"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 12, as Major Virtue 21 (can destroy things by meditating around them and do extra damage with weapons), first Initiation since Major Ordeal –9\n\nScript Bonus +6: Minor Ordeal (Higher Purpose to eat sin on behalf of the House) +3, special time and place +3. Characters who slew a Primus on the first avenue suffer an additional Ordeal\n\non this avenue, which gives them the Blatant Gift +9 (offsets loss of –9 modifier in target level for first Initiation since Major Ordeal)."
    }

    #t58bdbef9b07c846efd4e6e ^"Avenue of Charm and Scorn, and the Station that Repels and Attracts Elements" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "15"
            ^"Script Bonus" STRING "+9"
            ^"Path" STRING "The Path of Strife, Portrayed With Figures"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 15, as Major Virtue 21 (may attract or repel a single element at a time), second Initiation since Major Ordeal –6. (The latter is –9 for those who slew a Primus, but the House doesn’t take advantage of this. Characters on the path might discover that the special time and place isn’t required for Primus-slayers.)\n\nScript Bonus +9: Quest (seek lover) +3, special time and place +3, sympathetic bonus (marriage as metaphor for love and strife) +3"
    }

    #t2c3dabd37693492516d832 ^"The Avenue of Befriending the Silent and the Station that Charms the Elements" DEF {
