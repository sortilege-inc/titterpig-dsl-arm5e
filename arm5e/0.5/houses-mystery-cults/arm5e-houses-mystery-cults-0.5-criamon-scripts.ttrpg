EXTENSION "ArM5_HoH_MysteryCults_Criamon_Scripts" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: Mystery Cults - House Criamon Initiation Scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ArM5_Houses_Mystery_Cults_Core_Ext"

    # Initiation Scripts, found by evidence: a section that prints the source's own
    # **Ease Factor** / **Script Bonus** / **Script Details** labels. The parsed
    # fields sit beside the full printed text, which is kept verbatim as the
    # DESCRIPTION so none of the line's own tokens are lost (decision S-11).

    #t12532e98cf50028b92679d ^"The Avenue of Subduing the Meat and the Station of the Perfect Tool" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "21"
            ^"Script Bonus" STRING "+15"
            ^"Path" STRING "The Path of the Body, Expressed Symbolically"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 21, as Major Virtue (Minor Potency in an aspect of Corpus, may use Enigmatic Wisdom in lieu of Medicine and Chirurgy)\n\nScript Bonus +15: Major Ordeal comprising three minor Flaws (Vow to not pollute the body and to use it aptly, Deleterious Circumstances while ill, Disfigured by stigmata) +9, sympathetic bonus (a complete year cycle as a plant, or similar) +3, special time and place (symbolic rebirth) +3"
    }

    #t48fe493c02b857b7c35f25 ^"The Avenue of Drinking the Winds of Inspiration and the Station of Spiritual Nourishment" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "12"
            ^"Script Bonus" STRING "+6"
            ^"Path" STRING "The Path of the Body, Expressed Symbolically"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "See the note in the introductory section for this path to determine whether this is gained as the third station and Perfect Movement as the second.\n\nTarget level 12, as Major Virtue 21 (allows characters in high auras to not eat, drink, or sleep and replaces the longevity ritual), first Initiation after Major Ordeal –9\n\nScript Bonus +6: Psychodramatic visions or conflict to secure a site (Quest) +3, special time and place +3"
    }

    #t3c228550e7954b98b83ead ^"The Avenue of the Tiniest Seed and the Station of Perfect Economy of Movement" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "15"
            ^"Script Bonus" STRING "+9"
            ^"Path" STRING "The Path of the Body, Expressed Symbolically"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 15, as Major Virtue 21 (perfectly precise movement), second Initiation after Major Ordeal –6\n\nScript Bonus +9: Major Flaw (Pious) replaces Minor Flaw (Vow) +6, Mystagogue’s time +3"
    }

    #te76fda2fe1c983d9f8d2fc ^"The Avenue of the Spherical Mirror and the Station of the Microcosm" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "15"
            ^"Script Bonus" STRING "+9"
            ^"Path" STRING "The Path of the Body, Expressed Symbolically"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 15, Major Virtue 21 (Arcane Connections to most things), first Initiation after Intermediate Ordeal –6\n\nScript Bonus +9: Psychodramatic Quest +3, Mystagogue’s time +3, special time and place +3"
    }

    #tf457c5dc5754bf1cca0d2e ^"The Avenue of Repose in the Body and the Threshold of Corporeal Repose" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "17"
            ^"Script Bonus" STRING "+12"
            ^"Path" STRING "The Path of the Body, Expressed Symbolically"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 17, Major Virtue 21 (purified of mortal frailties), second Initiation after Intermediate Ordeal –4\n\nScript Bonus +12: Three Quests to legendary places +9, special time and place +3"
    }

    #t47463230834d6152dfca5b ^"Avenue of Gruel, Water, and Starlight and the Station of Differentiation of Seeming" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "21: Package treated as a Major Virtue (Clear Thinker"
            ^"Script Bonus" STRING "+15"
            ^"Path" STRING "The Path of Seeming, Depicted in Digits"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 21: Package treated as a Major Virtue (Clear Thinker, Common Sense, and Keen Vision)\n\nScript Bonus +15: Minor Ordeal: Disfigurement +3, Mystagogue’s time +3, psychodramatic Quest representing subduing the senses +3, special site and time (a certain cave complex during the dark of the moon) +3, sympathetic bonus (deprivation) +3"
    }

    #te619ee26acad5419107612 ^"Avenue that Assaults the Modesty of the Universe and the Station of True Sight" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "18"
            ^"Script Bonus" STRING "+12"
            ^"Path" STRING "The Path of Seeming, Depicted in Digits"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 18, as Major Virtue 21 (may use Enigmatic Wisdom as if it were Magic Sensitivity and Second Sight), first Initiation since Minor Ordeal –3\n\nScript Bonus +12: Ordeal (Vow) +3, Quest of insane wanderings +3, special time and place +3, Mystagogue’s time +3"
    }

    #t55fec701edc0280f23ede8 ^"The Avenue of the Unexpected Pages and the Station of Vivid Memories from Objects" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "18"
            ^"Script Bonus" STRING "+12"
            ^"Path" STRING "The Path of Seeming, Depicted in Digits"
            ^"House" STRING "House Criamon"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Target level 18, as Major Virtue 21 (may read the memories of objects), first Initiation since Minor Ordeal –3\n\nScript Bonus +12: Ordeal (Major Flaw Pious replaces Minor Flaw Vow) +6, special time and place +3 (or possibly Loss of Talisman +3), psychodramatic Quest +3"
    }

    #tecfb09ffbaa8a06080f45d ^"The Avenue that is a Crossroad and the Station of Passing Through Seeming" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "15"
