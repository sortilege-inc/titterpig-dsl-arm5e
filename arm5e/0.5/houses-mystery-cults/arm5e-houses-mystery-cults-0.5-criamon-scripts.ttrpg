        }
        DESCRIPTION "Target level 15, as Major Virtue 21 (spirit traveling), first Initiation since Intermediate Ordeal –6\n\nScript Bonus +12: Mystagogue’s time +3, special time and place +3, sympathetic bonus +3, Quest +3"
    }

    #t0a14cc89c53a504bda20c7 ^"The Avenue that Leads to Transcendence and the Station from Which to Ignore the Real" DEF {
        EXTENDS ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "17"
            ^"Script Bonus" STRING "+12"
            ^"Path" STRING "The Path of Seeming, Depicted in Digits"
            ^"House" STRING "House Criamon"
