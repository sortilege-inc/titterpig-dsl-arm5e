EXTENSION "ArM5_Houses_True_Lineages_Core_Ext" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: True Lineages - core type extensions"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-27"
    DEPENDS_ON "ArM5_Core_Base"

    # Houses of Hermes: True Lineages is an EXTENSION on the arm5e edition,
    # loaded alongside the core rulebook (spec S13 composition). It details four
    # of the twelve Hermetic Houses — Bonisagus, Guernicus, Mercere, Tremere —
    # each already defined as a mechanical ^"House X" DEF in
    # arm5e-0.5-houses.ttrpg (EXTENDS ^"Hermetic House"). This book's records
    # EXTEND / point at those canonical House DEFs; it does not redefine them.
    #
    # What it does NOT declare, deliberately (matching the RoP:Faerie precedent):
    #   - Virtues and Flaws. The book's new Hermetic/Supernatural/General/Social
    #     Virtues and Flaws fit the core ^"Virtue"/^"Flaw" types unchanged (same
    #     Size enum, same free-text Category axis). Those records EXTEND
    #     ^"Virtue"/^"Flaw" and DEPEND_ON ArM5_Core_Virtue_Flaw directly.
    #   - Spells. Fenicil's Rituals (Guernicus), the Mercere spells, and the
    #     Tremere new spells fit the core ^"Hermetic Spell" shape unchanged.
    #   - Narrative. The House histories, organization, customs, and the Code of
    #     Hermes discussion are prose → the .lore files; their in-chapter
    #     headings are dispositioned in coverage (a .lore contributes only its
    #     own basename to the entity set — verified against coverageAudit).
    #
    # House-specific SYSTEMS this book introduces (House Acclaim & folios for
    # Bonisagus; the Redcap network for Mercere; Certamen dueling refinements &
    # the House structure for Tremere; Quaesitorial duties for Guernicus) are
    # declared here as new types only where a core type has no place for them —
    # added per-bucket as those systems are converted.

    # ── Types introduced by Chapter One (House Bonisagus) ──────────────────
    # Each is a named, enumerable kind the book itself distinguishes; a core
    # type has no place for them. Instances live in the per-House .ttrpg files.

    #tHoHTL05HouseUtilityTypeAA ^"House Utility" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"House" STRING REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05BreakthroughTypeAA ^"Breakthrough" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Scale" ENUM ["Minor", "Major", "Hermetic"] REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05OrigResearchStepAA ^"Original Research Step" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Order" INTEGER REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05ExampleDiscoveryAA ^"Example Discovery" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Breakthrough Scale" STRING REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05ParmaMagicaFoldAAA ^"Parma Magica Fold" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Latin Name" STRING REQUIRED
            ^"Translation" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05ExampleCharacterAA ^"Example Character" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"House" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    # ── Types introduced by Chapter Two (House Guernicus) ──────────────────

    #tHoHTL05CodeClauseTypeAAA ^"Code Clause" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Oath Text" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05TribunalStepTypeAA ^"Tribunal Procedure Step" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Stage" STRING REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05HermeticPenaltyAAA ^"Hermetic Penalty" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Kind" ENUM ["Damages", "Fine", "Punishment"] REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05QuaesitorPowerAAAA ^"Quaesitorial Duty" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05FenicilRitualAAAAA ^"Fenicil Ritual" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Scale" ENUM ["Greater", "Lesser"] REQUIRED
            ^"Technique and Form" STRING
            ^"Range" STRING
            ^"Duration" STRING
            ^"Target" STRING
            ^"Ease Factor" STRING
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }

    #tHoHTL05SpellGuidelineAAAA ^"Spell Guideline Set" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Technique" STRING REQUIRED
            ^"Form" STRING REQUIRED
            ^"Source" STRING DEFAULT "Houses of Hermes: True Lineages"
        }
    }
}
