EXTENSION "ArM5_HoH_True_Lineages_Mercere_Spells" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: True Lineages - House Mercere spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-27"
    DEPENDS_ON "ArM5_Core_Magic_Spell"

    # The Mutantum spells and the chapter's other new spells. They fit the core
    # ^"Formulaic Spell" shape unchanged; Technique and Form come from each spell's
    # printed group heading, and Range/Duration/Target/Level (plus Ritual and any
    # requisites) are parsed into typed fields rather than left in the prose.

    #t6c3861e20d35a4aef8d859 ^"Twinning the Tome" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" STRING "50"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Requisites" STRING "Intellego, Terram"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Mom,** T:** Group,** Level 50, **Ritual **Requisites:** Intellego, Terram This spell creates a nearly perfect copy of the binding and every page of a book you are touching, including illumination, creases, and damages. It requires an Intellego\n\nrequisite to determine the shape and size of the pages, and a Terram requisite to create the ink. While an effective method of quickly copying the contents of a book, the vis cost is generally considered prohibitive; Milvi instead use it to recover valuable books that have been stolen or lost, or to copy ancient works that are too fragile to move. Thus, this version of the spell also allows for vis boosting, so that you can accommodate an arcane connection to the book without requiring you to learn another spell.\n\n(Base 5, +1 Touch, +2 Group, +5 intricacy, +1 requisites; Boosted)"
    }

    #tea5612ce1895b3f95c010e ^"The Transformed Folio" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" STRING "35"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Year,** T:** Group,** Level 35, **Ritual This changes all the pages of a book into those of a different book for the duration of the spell. You must touch both books when casting the spell, and may end the spell at any time by concentrating. If the original book is damaged or altered, the contents of the duplicate will change to match it. Milvi occasionally use this spell to lend the same book to several different magi, or to communicate with each other on a long journey. The spell allows for vis boosting, allowing you to copy a book using an arcane connection from wherever you happen to be, and is harnessed so that the book can be quickly returned to normal when the reader is finished with it, or for reasons of secrecy.\n\n(Base 1, +1 Touch, +4 Year, +5 intricacy; Boosted, Harnessed)"
    }

    #tae2ecc67bef9d5de6604c3 ^"Hunter’s Lethal Arrow" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Level" STRING "40"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "ouch"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Diam,** T:** Ind,** Level 40** This spell causes an animal to suffer a fatal wound, just as if it had been pierced through the heart. Casting this spell while intending to touch the animal is dangerous, as it may take several minutes to die, during which time it may thrash around wildly or strike the caster. For this reason, Milvi usually tether the spell to an arrow or javelin (though any sort of tether may be used), allowing them to cast it in secret from a safe distance. The beast will die after it is struck, and the increased duration ensures the caster has time to fire the arrow after casting the spell.\n\n(Base 30, +1 Touch, +1 Diam; Tethered)"
    }

    #t902f76a93bd1cb23ebba9f ^"Shape of the Ancient Kite" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "ouch"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Moon,** T:** Ind,** Level 40 Requisites:** Animal You transform the target into a hawk, kite, or other small raptor, and any books carried by the target or clothing made of animal products that the target is wearing are also transformed. The spell is harnessed and tethered, so that the target has control of the spell and can end the effect at will, returning easily to human form when necessary.\n\n(Base 20, +1 Touch, +3 Moon; Harnessed, Tethered)"
    }

    #tf1d02e3aeeefd7c76d04e0 ^"The Tireless Flight" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" STRING "20"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "ouch"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Conc,** T:** Ind,** Level 20** The target feels no fatigue for the duration of the spell, allowing her to endure a long journey without rest or sleep. She may also ignore hunger and thirst, and if she is injured she does not feel the pain. Practically speaking, she may ignore all Fatigue and wound penalties. However, this effect only masks the feeling, it doesn’t actually replenish her energy, so she still must actually eat and drink to avoid starving to death, and if she pushes herself too hard she may cause herself serious injury (Fatigue levels past Unconscious become Light wounds).\n\nThe spell is tethered so that the target can control the effect, allowing her to stop concentrating when she has reached her destination and has time to recover. It is also boosted so that the duration may be extended to as much as a month if necessary, and harnessed so that the target can still cancel it at will.\n\n(Base 10, +1 Touch, +3 Moon; Boosted, Harnessed, Tethered)"
    }

    #t1220f75cec65fa2607c40e ^"Sense the True Path" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Level" STRING "15"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "You can sense the direction of any location to which you have an Arcane Connection. You feel an instinctive pull towards its relative position to you while you concentrate, though you must make simple Perception rolls of 6+ to stay on track when traveling on foot through woods or brush, and if your destination moves, the Ease Factor of this roll increases depending on its speed."
    }

    #t53c3f4df4ff32c977fba94 ^"(physical Characteristic) of the Followers" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" STRING "35"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Mom,** T:** Ind,** Level 35, **Ritual There are four variations of this lesser version of *(Physical Characteristic) of the Heroes *(CrCo60), which permanently increase a physical Characteristic (Strength, Stamina, Dexterity or Quickness) by one, but to no more than 0. During these minor rituals, followers of the Cult of Heroes are purified and anointed with oil, and have their innate weaknesses magically removed, making them truer to their ideal forms, to prepare them for the other, greater rituals.\n\n(Base 30, +1 Touch)"
    }

    #tbf93ddb33f4ca4baa197fa ^"(physical Characteristic) of the Heroes" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" STRING "60"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Mom,** T:** Ind,** Level 60, **Ritual Each of the four variations of this ritual permanently increases one of the subject’s physical Characteristics (Strength, Stamina, Dexterity or Quickness) by one, to no more than +5. During the ceremony, the subject is buried under earth, emerging from the ordeal permanently improved and one step closer to human perfection.\n\n(Base 55, +1 Touch)"
    }

    #t4c32469c7d2a6337693ab5 ^"(mental Characteristic) of the Followers" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" STRING "35"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Mom,** T:** Ind,** Level 35, **Ritual There are four variations of this lesser version of *(Mental Characteristic) of the Heroes* (CrMe60), which permanently increase a mental Characteristic (Intelligence, Perception, Presence or Communication) by one, but to no more than 0. During these minor rituals, followers of the Cult of Heroes are purified and anointed with oil, and have their innate weaknesses magically removed, making them truer to their ideal forms, to prepare them for the other, greater rituals.\n\n(Base 30, +1 Touch)"
    }

    #tb199e1e729189a6eddcdd3 ^"(mental Characteristic) of the Heroes (crme60)" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" STRING "60"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Mom,** T:** Ind,** Level 60, **Ritual Each of the four variations of this ritual permanently increases one of the subject’s mental Characteristics (Perception, Intelligence, Presence, or Communication) by one, to no more than +5. During the ceremony, the subject is held immersed in water, emerging from the ordeal permanently improved and one step closer to human perfection.\n\n(Base 55, +1 Touch)"
    }

    #tdcd1a231432c76040ee450 ^"Mercury’s Blessing" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Level" STRING "25"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "ouch"
            ^"Ritual" STRING "Yes" FIXED
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "D:** Year,** T:** Ind,** Level 25, **Ritual This ritual imbues the target with a kind of supernatural aura, similar to Might, which improves the chances that children conceived and born during its duration will have The Gift or heroic qualities. It is said that this magic is a sign the gods are watching over the subject, and it is often incorporated into wedding and fertility ceremonies of those within the Cult of Heroes.\n\n(Mercurian Ritual)\n\nThese new Virtues and Flaws are most often found in characters belonging to House Mercere, but most are not exclusive to that House."
    }

}
