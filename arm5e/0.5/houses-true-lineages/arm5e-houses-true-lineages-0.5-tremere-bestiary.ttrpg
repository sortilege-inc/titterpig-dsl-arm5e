EXTENSION "ArM5_HoH_True_Lineages_Tremere_Bestiary" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: True Lineages - creatures of the Tremere chapter"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-27"
    DEPENDS_ON "ArM5_Houses_True_Lineages_Core_Ext"

    # The ghosts, summoned soldiers and trained animals printed as stat blocks in
    # Chapter Four's sidebars. Each stat line keeps the source's own label as its own
    # typed field, verbatim - the Realms of Power: Magic precedent - rather than being
    # flattened into one prose string.

    #tccb15f1d5318219a7837e1 ^"Legionary" DEF {
        EXTENDS ^"Magic Creature"
        PROPERTIES {
            ^"Magical Might" STRING "10 (Mentem)"
            ^"Characteristics" STRING "Int 0, Per 0, Pre 0, Com 0, Str +2, Sta +2, Dex +2, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "Appears to be between 16 and 35"
            ^"Decrepitude" STRING "n/a"
            ^"Virtues and Flaws" STRING "n/a"
            ^"Personality Traits" STRING "Loyal +3 **Reputations:** n/a"
            ^"Combat" STRING "Sword (gladius) and rectangular shield (scutum): *Init. +2, Attack +11, Defense +12, Damage +7. *Dagger (pugio): *Init.1, Attack +9, Defense +6, Damage +5 *Javelin (pilum): *Init +1, Attack +9, Defense +10, Damage +7"
            ^"Soak" STRING "Varies by historical period to suit armor: Chain 6, Plate 9, Scale 8, including Stamina bonus. Immune to physical weapons."
            ^"Fatigue" STRING "Tireless"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "[Area] Lore 3 (ancient fortifications), Athletics 3 (marching), Awareness 3 (in combat), Bargain 2 (for supplies), Brawl 4 (dagger), Carouse 3 (drinking), Charm 2 (opposite sex), Latin 5 (military jargon), Legion Lore 2 (pay and conditions), Profession (Soldier) 4 (fortifications), Single Weapon 5 (short sword), Survival 1 (foraging), Thrown weapon 4 (javelin)"
            ^"Powers" STRING "Strike:* 0 points, Terram: The centurion can affect the world through a single possession. For most, this is a gladius: a Roman sword."
            ^"Equipment" STRING "Arms and equipment of a Roman soldier"
            ^"Encumbrance" STRING "0 (0)"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "This ghost is typical of the fallen legionaries summoned in Western Europe. Many vanish after their first victory in combat, but a small portion feel they have a duty to defend Rome, and undertake moonlit pilgrimages to the Eternal City, dissolving into the Dominion at their quest’s end."
    }

    #te0fcf54e4f415c026c51b1 ^"Cataphract" DEF {
        EXTENDS ^"Magic Creature"
        PROPERTIES {
            ^"Magic Might" STRING "15 (Mentem)"
            ^"Characteristics" STRING "Int 0, Per +1, Pre 0, Com 0, Str +1, Sta +1, Dex +2, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "Appears 20"
            ^"Decrepitude" STRING "n/a"
            ^"Virtues and Flaws" STRING "Improved characteristics"
            ^"Personality Traits" STRING "Loyal +3, Proud +2 **Reputations**: n/a"
            ^"Combat" STRING "Cavalry sword (spatha) and shield (mounted): *Init +4, Atk +18, Def +17, Dam +7 *Cavalry sword (spatha) and shield (on foot): *Init +4, Atk +12, Def +11, Dam +7 *Lance (mounted): *Init +4, Atk +17, Def +8, Dam +6 Bow (mounted): *Init +1, Atk +14, Def +11, Dam +7 *Bow (on foot): *Init +1, Atk +11, Def +8, Dam +7 *Dagger:* Init +2, Atk +7, Def +5, Dam: +4 * Cataphracts charge slowly in tight formation, because they lack stirrups."
            ^"Soak" STRING "usually +10 for chainmail or +8 for scale. Rare examples of plate (+12) are known known."
            ^"Fatigue" STRING "Tireless"
            ^"Wound Penalties" STRING "–1 (1-7), –3 (8-11), –5 (12-14), Incapacitated (16-19)"
            ^"Abilities" STRING "Animal Handling 2 (horses), [Area] Lore 3 (posting), Athletics 2 (hiking), Awareness 3 (battle), Bow 5 (short bow), Brawl 1 (dagger), Chirurgy 1 (arrow wounds), Etiquette (archaic Byzantine) 3, Hunt 2 (varies by posting), Intrigue 1 (Byzantine court), Leadership 4 (soldiers), Roman Army Lore 2 (duties of officers), Greek 5 (giving orders), Ride 5 (in combat), Single Weapon 5 (spatha), Survival 1 (deserts),"
            ^"Equipment" STRING "Full chain mail, cavalry sword, mediumsized shield, bow, lance."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "2 pawns Mentem, engagement ring or keepsake."
            ^"Appearance" STRING "An impressive warrior, obscured by his armor. Sometimes the armor contains an ethereal skeleton. Sometimes it is empty."
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "Cataphracts are the mounted warriors of the Eastern Empire. They are found in the West in a handful of places, left behind after Justinian’s imperial adventure in the Sixth Century. Cataphracts found in the West are particularly useful to the House. Their unfinished business is often the rebuilding of the Empire: a task that the Tremere do not oppose. The House recruits ghostly cataphracts where it can, and directs the remainder over the border into the Theban Tribunal, where they harass the Latin invaders. The statistics here are for a young cataphract, with basic training but little combat experience."
    }

    #t5cd82e6060820a0ce8c549 ^"Common White Wolves" DEF {
        EXTENDS ^"Magic Creature"
        PROPERTIES {
            ^"Magic Might" STRING "10 (Animal)"
            ^"Characteristics" STRING "Int +1, Per +3, Pre +1, Com +1, Str +2, Sta +2, Dex +2, Qik +2"
            ^"Size" STRING "1"
            ^"Age" STRING "n/a"
            ^"Decrepitude" STRING "n/a"
            ^"Virtues and Flaws" STRING "The Visions Virtue occurs occasionally among these wolves."
            ^"Personality Traits" STRING "Loyal +2, Amused by Humans +1 **Reputations:** None"
            ^"Combat" STRING "Bite:* Init +12, Attack +10, Defense +14, Damage +9"
            ^"Soak" STRING "+7"
            ^"Fatigue" STRING "0,–1/–1,–3/–3,–5,Unconscious"
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-10), –5 (11-13), Incapacitated (15-18)"
            ^"Abilities" STRING "[Area] Lore 6 (Pack land), Brawl 3 (bite), Folk Ken (Tremere magi) 3, Hunt 6 (in a pack), Latin* 3 (Hermetic terms). Stealth (forests) 3, Swim (lakes) 1, Survival 6 (forests) * Cannot speak Latin without magical assistance, but some packs are trained to understand it by familiars which can."
            ^"Powers" STRING "Theft of Voice,* 1 point, Init +10, Mentem: The wolf can steal the voice of any human with whom it makes eye contact. The effect usually lasts until the next sunrise, although some individual wolves have variant powers, so that the effect ceases when"
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "There are several types of magical wolf that serve the House in its packs but this type, descended from Tremere’s familiar, are the most common."
    }

    #tf131986a3ce433e16e2d06 ^"Shadow Owls and Fire Hawks" DEF {
        EXTENDS ^"Magic Creature"
        PROPERTIES {
            ^"Magic Might" STRING "10 (Animal)"
            ^"Characteristics" STRING "Cun –2, Per +5, Pre n/a, Com n/a, Str –2, Sta 0, Dex +2, Qik +3"
            ^"Size" STRING "–3"
            ^"Age" STRING "n/a"
            ^"Decrepitude" STRING "n/a"
            ^"Virtues and Flaws" STRING "Nil"
            ^"Personality Traits" STRING "Fierce +5, Patient +2 **Reputations:** None"
            ^"Combat" STRING "Talons: Init +7, Attack +6, Defense –1, Damage +4"
            ^"Soak" STRING "0"
            ^"Fatigue" STRING "0, –3, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-2), –3 (3-6), –5 (7-9), Incapacitated (10-15)"
            ^"Abilities" STRING "n/a **Shadow owl powers:* Dapple,* 1 point, Imaginem: Shadow owls can alter the appearance of their plumage, so that they blend more readily with their surroundings. If stationary, the owl is hidden by a minor illusion of sight. During flight, any roll to detect an owl using this power suffers a –3 penalty. *Straight chase, *1 point, Animal: After this power is activated, a shadow owl can fly through solid objects, for the next few minutes, as if it was a ghost. Shadow owls cannot strike through objects, like armor, because they need to be solid to harm their target. Owls pursue game through forests using this power. The House uses these owls to collect arcane connections, as they can carry game, or small items, in ghostly form. **Fire kite powers:* Kindle,* 1 point, +5 Init. Ignem: Fire kites can ignite flammable objects by touch. They light small brushfires to flush, and sometimes cook, insects. They usually grasp a stick or clump of grass, ignite it, and then drop it while swooping over a target area. A kite using the Kindle power that strikes a foe does +9 damage (including the talon damage given above). The House uses these animals as saboteurs."
            ^"Equipment" STRING "None."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "1 pawn Imaginem, feathers or 1 pawn Ignem, both claws. The House has found uses for a variety of small raptors. Shadow owls are useful for collecting arcane connections. Fire kites are used as saboteurs. The most popular large raptor in House Tremere is the griffin vulture, found along the Adriatic coast. These creatures, which follow griffins and feed on their scraps, can see tremendous distances and are magically sensitive. Their cooperative hunting pattern, searching for dead lambs by scouring the countryside in a comb formation, makes them perfect intelligence gatherers."
            ^"Source" STRING "Houses of Hermes: True Lineages"
        }
        DESCRIPTION "Shadow Owls and Fire Hawks are small raptors, sharing many mechanical attributes."
    }

}
