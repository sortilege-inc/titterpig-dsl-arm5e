EXTENSION "ArM5_Legends_of_Hermes_Figures" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - maps"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The book's four maps (Villa Fortunata p62; Variña's Tomb p79; Hérisson's Garden p92; Hermanus' Underwater
    # Laboratory p108), as ^"Figure" records. Their labels were read by eye; the transcription, its links, its uncertain
    # readings and how it was made: legends-of-hermes/figures.json.

    # source: page 62, read by eye from the art (figures.json)
    #t1305e6eb1985dc782c586f ^"Villa Fortunata (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Villa Fortunata"
            ^"Lettering" LIST OF STRING ["Villa Fortunata", "Guest Quarters", "Storage", "Dining Room", "Kitchen", "Main Hall", "Graveyard", "Hidden Library & Laboratory", "Master Bed-room", "Boiler & wood-stores", "Servant Quarters", "Baths", "Necromanteion"]
            ^"Shows" STRING "a plan of Fortunata’s villa on her island: its rooms around a central garden court, the graveyard, the hidden library and laboratory, and the necromanteion"
            ^"Locations" LIST [#t7958c6fc3b6907b271af63 ^"Fortunata’s Villa", #t5479d33b913143297a11cc ^"The Villa Graveyard", #tc482b9586e031a01166bd0 ^"Fortunata’s Laboratory and Library"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-220 dpi (raster labels; p79's title and two captions are also live text); labels as printed"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 62
        }
    }

    # source: page 79, read by eye from the art (figures.json)
    #t8b3ce99af92a894a4a0aef ^"Variña’s Tomb (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Variña’s Tomb"
            ^"Lettering" LIST OF STRING ["Variña’s Tomb", "INTERIOR VIEW", "Giant Owl’s Nest", "Trap Door", "Feathers, Animal Bones, etc.", "ROOF", "Stone Wall", "Stairs Down", "Table", "Shelves", "Debris", "Level 5 of Regio", "Equipment & Boxes", "Columns with Gargoyles at top", "TOP FLOOR", "BOTTOM FLOOR", "Massive Stone Sarcophagus", "Stairs Up", "Level 3 of Regio", "Chests, Wardrobes, etc.", "Note: Levels 2, 4 & 6 of regio follows the outer walls", "SIDE VIEW", "Level 1 Regio", "ROOF", "TOP FLOOR", "BOTTOM FLOOR", "MOUNTAIN PEAK", "Giant Owl’s Nest", "Trap Door", "10ft", "30ft", "30ft", "Level 5 (Small Cylinder Behind Column)", "Level 3 (Small Cylinder Behind Column)", "Level 2, 4 & 6 Follows Outer Wall", "Sarcophagus", "Position for Columns (Columns not shown )"]
            ^"Shows" STRING "Variña’s tower: an interior view of its roof, top floor and bottom floor, a cut-away of the tower, and a side view on its mountain peak, with the levels of the regio"
            ^"Locations" LIST [#t6afbec94bd92c0be5a9d46 ^"Variña’s Tomb"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-220 dpi (raster labels; p79's title and two captions are also live text); labels as printed"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 79
        }
    }

    # source: page 92, read by eye from the art (figures.json)
    #t4eb4b6864e7b7d272fa542 ^"Hérisson’s Garden (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Herisson’s Garden"
            ^"Lettering" LIST OF STRING ["Hills", "Line of Poplars", "Marsh", "Orchard", "Forest", "Park", "Flowers", "Herbs", "Meads", "Pleasaunce", "Hedgerow", "Park", "Herisson’s Garden"]
            ^"Shows" STRING "Hérisson’s garden: the meads, herbs, flowers and orchard within its line of poplars and hedgerow, the marsh and pleasaunce at its corners, and the forest, park and hills about it"
            ^"Uncertain Readings" LIST OF STRING ["Herisson’s Garden: the blackletter title shows no accent on the e; read as lettered"]
            ^"Locations" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-220 dpi (raster labels; p79's title and two captions are also live text); labels as printed"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 92
        }
    }

    # source: page 108, read by eye from the art (figures.json)
    #t3ffc3a1779d4b515c75bad ^"Hermanus’ Underwater Laboratory (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Hermanus’ Underwater Laboratory"
            ^"Lettering" LIST OF STRING ["Hermanus’ Underwater Laboratory", "Hallway", "Receiving Room", "Laboratory", "Spare Laboratory", "Sanctum", "Store Room", "Scriptorium"]
            ^"Shows" STRING "a plan of Hermanus’s laboratory complex: its seven rooms in three rings, the laboratory at the centre"
            ^"Locations" LIST [#t39bfed3958c3619d4cbb37 ^"The Laboratory of Hermanus", #ta8e00470c32e5247cc5d47 ^"Hallway", #t5ad52a3da429e109f54037 ^"Receiving Room", #t8ec11d93d3b167c41a5b1c ^"Laboratory (The Laboratory of Hermanus)", #t56592402b88bbfdf723dc8 ^"Spare Laboratory", #tc2c582807882d4aa2903e0 ^"Sanctum", #td2148fcf5dddfa25c1b313 ^"Store Room", #t8674a8786d84d5feea12a1 ^"Scriptorium"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 150-220 dpi (raster labels; p79's title and two captions are also live text); labels as printed"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 108
        }
    }

}
