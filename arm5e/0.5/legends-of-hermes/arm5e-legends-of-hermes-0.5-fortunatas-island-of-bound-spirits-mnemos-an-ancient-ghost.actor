EXTENSION "ArM5_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_MnemosAnAncientGhost" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Mnemos, an Ancient Ghost"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # Mnemos, an Ancient Ghost (Chapter Three: Fortunata’s Island of Bound Spirits, p68): one being, its printed stat lines verbatim fields.

    #tb5677bdd6749f4d9aabae8 ^"Mnemos, an Ancient Ghost" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 5
            ^"Form" STRING "Mentem"
            ^"Season" STRING "Spring"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 0
            ^"Virtues and Flaws" STRING "Magic Spirit (spectre)"
            ^"Vis" STRING "none"
            ^"Appearance" STRING "A dark-skinned man, with a shaven head and a long, waxed chin-beard. He wears a skirt of linen, and the ghost of a gold collar."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 68
        }
        PERSONALITY_TRAITS {
            "Lost" +3
        }
        ABILITIES {
            "Artes Liberales" SCORE 3 SPECIALTY "grammar"
            "Concentration" SCORE 1 SPECIALTY "reading"
            "Dead Language (Sumerian)" SCORE 5 SPECIALTY "scholarship"
        }
        DESCRIPTION "Mnemos lived and died a long time ago, before the time of Christ, for certain. He remembers little of life, except a bright, hot sun, and much sand. He speaks a language only spoken then, and forgotten since — but he was literate in life, and can read even now. Fortunata used to summon him and command him to examine ancient scrolls, and to read aloud to her if he could. She then used *Thoughts Within Babble* to understand his speech.\n\nShe would sometimes transcribe what he read out, and sometimes just listen, studying from his words as if she were reading the text herself.\n\nMnemos is an example of one of the ghosts named and described in a list in Fortunata’s library; her notes for Mnemos annotate him as “Sumerian?”. Fortunata’s methods meant that she never bothered to learn ancient languages, just summoned spirits until she found one who could read a text for her.\n\nIn his unchanging ghost-life, he does not remember Fortunata. He has faded though, to the extent that he does not remember why he remains on earth."
    }

}
