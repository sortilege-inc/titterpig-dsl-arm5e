EXTENSION "ArM5_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_Rules" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Three: Fortunata’s Island of Bound Spirits rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t2256fcfc94a590c9b743c6 ^"A season dedicated to Practice Cult Lore" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Borrowing Cult Lore and Initiation Scripts"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 49
        }
        FORMULAS {
            "A season dedicated to Practice Cult Lore" "Quality 4"
        }
    }

    #tebb62bf8f3655ff9860342 ^"A season of Practice Cult Lore inspired by ancient lore" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Borrowing Cult Lore and Initiation Scripts"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 49
        }
        FORMULAS {
            "A season of Practice Cult Lore inspired by ancient lore" "Practice Source Quality 5"
        }
    }

    #t8e8be9e1d9b6c307647bd9 ^"To Understand Another Cult’s Script" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Borrowing Cult Lore and Initiation Scripts"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 49
        }
        FORMULAS {
            "To Understand Another Cult’s Script" "Intelligence + (other Cult) Lore vs. 9"
        }
    }

    #t1ae10d0009e8b0013ca346 ^"To Modify the Script, Change a Script Component" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Borrowing Cult Lore and Initiation Scripts"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 49
        }
        FORMULAS {
            "To Modify the Script, Change a Script Component" "Intelligence + (own Cult) Lore vs. 12"
        }
    }

    #t374b5e208307a7512352c4 ^"Initiation Total" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "Initiation Total" "Presence + (Mystery Cult) Lore + Script Bonus"
        }
    }

    #t268f95540d403aec1cd8f1 ^"To Initiate a Minor Virtue known by the Mystagogue" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "To Initiate a Minor Virtue known by the Mystagogue" "Target Level is 15"
        }
    }

    #t4cac3af12b12557eec8873 ^"To Initiate a Major Virtue known by the Mystagogue" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "To Initiate a Major Virtue known by the Mystagogue" "Target Level is 21"
        }
    }

    #t6ee4ac78726c3ab8a24579 ^"To Initiate a Minor Virtue NOT known by the Mystagogue" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "To Initiate a Minor Virtue NOT known by the Mystagogue" "Target Level is 18"
        }
    }

    #t8d75642be97b5ef562badf ^"To Initiate a Major Virtue NOT known by the Mystagogue" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "To Initiate a Major Virtue NOT known by the Mystagogue" "Target Level is 30"
        }
    }

    #te9e3c292a465612ecd12e7 ^"Target Level for First Initiation after an Ordeal" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "Target Level for First Initiation after an Ordeal" "–3 (Minor), –6 (Medium), –9 (Major)"
        }
    }

    #tae398119866be6872d51d4 ^"Target Level for Second Initiation after an Ordeal" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
