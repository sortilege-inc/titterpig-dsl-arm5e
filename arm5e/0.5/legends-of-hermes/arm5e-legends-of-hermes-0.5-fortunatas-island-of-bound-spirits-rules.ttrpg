            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "Target Level for Second Initiation after an Ordeal" "–2 (Minor), –4 (Medium), –6 (Major)"
        }
    }

    #ta86fea0f49b991d39e2646 ^"Target Level for Third Initiation after an Ordeal" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Initiation Mechanics"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 50
        }
        FORMULAS {
            "Target Level for Third Initiation after an Ordeal" "–1 (Minor), –2 (Medium), –3 (Major)"
        }
    }

    #t6717b1439a438c33f3a544 ^"Spirit Familiar Bonding level" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Virtue: Spirit Familiar"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 52
        }
        FORMULAS {
            "Spirit Familiar Bonding level" "Spirit’s Might + 25"
        }
    }

}
