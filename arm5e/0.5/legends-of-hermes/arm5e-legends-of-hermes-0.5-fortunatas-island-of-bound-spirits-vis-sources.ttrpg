EXTENSION "ArM5_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_VisSources" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Three: Fortunata’s Island of Bound Spirits vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t068d242ead335f9e975f1d ^"Vis Sources (Fortunata’s Island)" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Printed Name" STRING "Vis Sources"
            ^"Art" STRING "Rego, Muto, Aquam, Auram, Imaginem, Mentem, Vim"
            ^"Yield" LIST OF STRING ["sources for about 20 pawns of vis per year: Rego, Muto, Aquam, Auram, Imaginem, Mentem, Vim"]
            ^"Location" LIST [#t6c1f57f21248799024ac6f ^"Fortunata’s Island"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The island supported a powerful maga, and provided her with vis, though she also harvested vis elsewhere. If the magi are interested in Fortunata’s resources, and spend the time to study and investigate the island, there are sources for about 20 pawns of vis per year: Rego, Muto, Aquam, Auram, Imaginem, Mentem, Vim."
    }

}
