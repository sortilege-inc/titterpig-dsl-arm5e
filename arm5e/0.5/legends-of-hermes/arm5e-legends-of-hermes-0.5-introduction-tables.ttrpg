EXTENSION "ArM5_Legends_of_Hermes_Introduction_Tables" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter One: Introduction tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t5cf8611b5aa36eaabc965f ^"What the Order Remembers (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Ease Factor", "Category"]
            ^"Printed Name" STRING "What the Order Remembers"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 10
        }
        TABLE {
            "0" "Known by All"
            "6" "Widely Known"
            "12" "Uncommon Knowledge"
            "18" "Lost Secrets"
        }
    }

}
