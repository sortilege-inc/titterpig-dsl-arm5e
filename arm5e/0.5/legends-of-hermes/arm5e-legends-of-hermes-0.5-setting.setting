SETTING "ArM5_Legends_of_Hermes_Setting" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"

    # HISTORY: the Appendix's Timeline of the Order (p139), each event as printed, its date the PERIOD.
    # LOCATION: the places the book prints as headings -- its five legends are set across Mythic Europe and beyond,
    # so there is no root: Conciatta's Zaragoza (with La Torre No Vista), Toledo, Qadis, Tartessos and Narixa;
    # Fortunata's island and villa; Variña's tomb, Caerfloron and Hérisson's garden; the aquatic valley and the
    # laboratory of Hermanus with its rooms; Thomae's flying castle and Santa Lucia. A place's text is in its
    # chapter's .lore, under its heading.

    HISTORY {
        ENTRY ^"767" #t571027c0a442e3c52e15eb {
            PERIOD "767"
            DESCRIPTION "The Order of Hermes is founded at Durenmar."
        }
        ENTRY ^"c. 857" #t9d81d99c843d0a1fb8c302 {
            PERIOD "c. 857"
            DESCRIPTION "Hérisson is born."
        }
        ENTRY ^"867" #t5ce3d9e155b81615311022 {
            PERIOD "867"
            DESCRIPTION "Hérisson joins House Bjornaer at the Gathering of Twelve Years."
        }
        ENTRY ^"881" #t153b4efa8f101e1f462679 {
            PERIOD "881"
            DESCRIPTION "Hérisson passes his apprentice’s Gauntlet and becomes a magus of the Normandy Tribunal."
        }
        ENTRY ^"c. 885" #t88e4e6b37471682568c765 {
            PERIOD "c. 885"
            DESCRIPTION "Conciatta is born."
        }
        ENTRY ^"895" #t113536e6f86037582bf632 {
            PERIOD "895"
            DESCRIPTION "Baltasar hears of a Gifted child and buys the girl from her father. Conciatta’s apprenticeship begins."
        }
        ENTRY ^"900–990" #td9a0ae21e7c7ee2316a567 {
            PERIOD "900–990"
            DESCRIPTION "Hérisson develops his research on the creation of vis."
        }
        ENTRY ^"910" #t1e2227c6535f525aa0d5cf {
            PERIOD "910"
            DESCRIPTION "Conciatta passes her Gauntlet."
        }
        ENTRY ^"915" #t05915d8fe06e98933bdbf5 {
            PERIOD "915"
            DESCRIPTION "Conciatta Founds a covenant in Saraqusta with Currito."
        }
        ENTRY ^"923" #t7fbac4a3bb8a9fede47f1c {
            PERIOD "923"
            DESCRIPTION "Conciatta publishes The Appliction of Vim to the Supenatural Humors, but her experiments leave her Gift damaged."
        }
        ENTRY ^"925" #tac102f3e755c2fba99e1d6 {
            PERIOD "925"
            DESCRIPTION "Baltasar of Bonisagus is marched on charges of Infernal corruption."
        }
        ENTRY ^"933" #t836e540a9739c68339b5e7 {
            PERIOD "933"
            DESCRIPTION "Conciatta studies the Dominion in Toledo."
        }
        ENTRY ^"937" #t8a8b8c04153b425725c115 {
            PERIOD "937"
            DESCRIPTION "Conciatta submits her final papers and withdraws from the Order."
        }
        ENTRY ^"c. 940" #t29f8d993d6e8b9e2142b6a {
            PERIOD "c. 940"
            DESCRIPTION "Hermanus is born."
        }
        ENTRY ^"952" #tbb114fc0320ea3779e7854 {
            PERIOD "952"
            DESCRIPTION "Hérisson moves his laboratory and sanctum to his garden."
        }
        ENTRY ^"961" #tf6f68129dc4cd9321732a8 {
            PERIOD "961"
            DESCRIPTION "Evidence of infernal corruption in House Tytalus brought to light."
        }
        ENTRY ^"965" #td934323ec0d252c8e1f5a8 {
            PERIOD "965"
            DESCRIPTION "Hermanus of Tremere completes his Gauntlet and joins the Order."
        }
        ENTRY ^"980" #t9699cfb85e80d96f87583c {
            PERIOD "980"
            DESCRIPTION "Currito leaves both Saraqusta and Conciatta."
        }
        ENTRY ^"986" #t0ded383aae8173ed59d85c {
            PERIOD "986"
            DESCRIPTION "Fortunata is born, daughter of Prince of Milan."
        }
        ENTRY ^"987" #t533827a12269345069e18c {
            PERIOD "987"
            DESCRIPTION "Hérisson argues with the Primus of Bjornaer at the Gathering of Twelve Years, but the house is not interested in his talk of peace."
        }
        ENTRY ^"990" #tdf7e49b44b14e34bc12719 {
            PERIOD "990"
            DESCRIPTION "Hérisson submits a thesis to the Library of Durenmar regarding his original research, detailing some of the advances he has made."
        }
        ENTRY ^"996" #tab970b42e7da1037d62841 {
            PERIOD "996"
            DESCRIPTION "Fortunata apprenticed to Apollo of Jerbiton."
        }
        ENTRY ^"999" #t2d40353db51502f19a3930 {
            PERIOD "999"
            DESCRIPTION "Conciatta makes her final breakthrough."
        }
        ENTRY ^"1000" #tac97962e8f01c39459a08d {
            PERIOD "1000"
            DESCRIPTION "With her Gift overcoming her, Conciatta takes sanctuary in Toledo."
        }
        ENTRY ^"1001" #t17da31df5856de491443d4 {
            PERIOD "1001"
            DESCRIPTION "Hérisson meets with the primus of House Diedne in an attempt to reduce mounting hostilities."
        }
        ENTRY ^"1002" #te296363868bec283a73869 {
            PERIOD "1002"
            DESCRIPTION "Hérisson is killed in a Wizard’s War by Gypaetus of Bjornaer."
        }
        ENTRY ^"1004" #t701b5d27186d955992ef8c {
            PERIOD "1004"
            DESCRIPTION "Commencement of the Schism War."
        }
        ENTRY ^"1007" #t0bc23acd576fc58bd281ec {
            PERIOD "1007"
            DESCRIPTION "Conciatta enters Final Twilight and her spirit fractures."
        }
        ENTRY ^"1011" #tcf07927a97fa583890a69e {
            PERIOD "1011"
            DESCRIPTION "Fortunata passes her Gauntlet and adopts her Hermetic name."
        }
        ENTRY ^"1013" #t37f1046c9efffe1db8a5c1 {
            PERIOD "1013"
            DESCRIPTION "Formation of the Vexillation of the Adamant Rook."
        }
        ENTRY ^"1015" #t571ea3f07e12a25e8e2ada {
            PERIOD "1015"
            DESCRIPTION "Fortunata liberates Lucida from the cleft tree."
        }
        ENTRY ^"1017" #t068be769b42c22b7744f33 {
            PERIOD "1017"
            DESCRIPTION "Fortunata joins the summer covenant of Cupressa Nigra, and begins publishing text translations from ancient languages."
        }
        ENTRY ^"1019" #t0d99ba2c69d092a033a1de {
            PERIOD "1019"
            DESCRIPTION "House Bjornaer emerges from hiding with a new Harmonist agenda based on Hérisson’s philosophy."
        }
        ENTRY ^"1048" #tefbc1021bf65a910507249 {
            PERIOD "1048"
            DESCRIPTION "Fortunata acquitted of charges of diabolism."
        }
        ENTRY ^"1055" #tb34022b97cf55564d26095 {
            PERIOD "1055"
            DESCRIPTION "Fortunata acquitted of charges of spying using spirit magic."
        }
        ENTRY ^"1061" #t796f4de865e88ea1656d24 {
            PERIOD "1061"
            DESCRIPTION "Fortunata, senior maga at Cupressa Nigra, abandons her covenant and moves to a remote island, but opens her house in Venice to the Redcaps."
        }
        ENTRY ^"1067–1123" #t133b751b48e1c08cbab5f5 {
            PERIOD "1067–1123"
            DESCRIPTION "Cupressa Nigra is abandoned when the remaining junior magi join other covenants. Fortunata continues translating ancient texts, writes Hermetic texts on spirit lore, and circulates a few texts on Principles Lore. Fortunata acquires a reputation as a powerful eccentric."
        }
        ENTRY ^"1070" #t2ba6e4a0450882b48ce880 {
            PERIOD "1070"
            DESCRIPTION "Dissolution of the Vexillation of the Adamant Rook."
        }
        ENTRY ^"1098" #t048694e841e121852d48ba {
            PERIOD "1098"
            DESCRIPTION "Hermanus and the wing of Coeris that contains his laboratory disappear in what is assumed to be a Twilight episode brought on by a magical botch. Vexillation of the Unbarred Gateway is formed."
        }
        ENTRY ^"1104" #t72d58e98720be7facdf69d {
            PERIOD "1104"
            DESCRIPTION "Vexillation of the Unbarred Gateway dissolved."
        }
        ENTRY ^"1110" #t7cde81efc57365674bc344 {
            PERIOD "1110"
            DESCRIPTION "Amarantha of Tremere disappears."
        }
        ENTRY ^"1115" #t256836c1653360a806c289 {
            PERIOD "1115"
            DESCRIPTION "Velius sets his archmagus challenge."
        }
        ENTRY ^"1120" #t756aaf6e723ad36961c882 {
            PERIOD "1120"
            DESCRIPTION "Velius succumbs to Final Twilight."
        }
        ENTRY ^"c. 1122" #tfa4f32f82166901a152e52 {
            PERIOD "c. 1122"
            DESCRIPTION "Thomae is born."
        }
        ENTRY ^"1123" #t9256ebe512fe5b5fa5e5d4 {
            PERIOD "1123"
            DESCRIPTION "Last contact with Fortunata before she is lost to Twilight."
        }
        ENTRY ^"1198" #tc51a0950c3cb8e79e024d7 {
            PERIOD "1198"
            DESCRIPTION "Thomae and his castle vanish."
        }
    }

