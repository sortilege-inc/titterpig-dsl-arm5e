EXTENSION "ArM5_Legends_of_Hermes_TheFourAspectsOfConciatta_AbbessPrudencia" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Abbess Prudencia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # Abbess Prudencia (Chapter Two: The Four Aspects of Conciatta, p29): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #te1efcb7b1f30c5344b0dd1 ^"Abbess Prudencia" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Magic Resistance" STRING "10 (from her relic)"
            ^"Characteristics" STRING "Int +2, Per +1, Pre 0, Com +1, Str –1, Sta +1, Dex 0, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "45 (45)"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Senior Clergy; Clear Thinker, Educated, Puissant Leadership, Relic; Monastic Vows, Poor; Weak Characteristics"
            ^"Personality Traits" STRING "Contempt for Men +2, Prickly +3, Compassionate +1"
            ^"Reputations" STRING "Abbess of a convent in need of money (Toledo) 4, Aloof (Toledo) 2, Strict (convent) 3"
            ^"Combat" STRING "Dodge: Init –1, Attack N/A, Defense –1, Damage N/A Fist: Init –1, Attack +0, Defense –1, Damage –1"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Arabic 2 (markets), Toledo Lore 3 (people of the Church), Artes Liberales 2 (rhetoric), Awareness 3 (things being out of place), Castilian 5 (commerce), Chirurgy 3 (minor wounds), Church Lore 4 (Toledo), Concentration 1 (accounts), Etiquette 3 (wealthy visitors), Folk Ken 4 (men), Latin 4 (church ceremonies), Leadership 5 + 2 (novices), Medicine 3, Profession: Scribe 1 (copying), Teaching 3 (theology), Theology 4 (psalms)"
            ^"Equipment" STRING "Cord belt containing a relic with one Faith Point."
            ^"Appearance" STRING "Abbess Prudencia strides around her convent with supreme authority and a withering look. Her neck is always erect, her back always straight, her eyebrows always arched, her hands always clasped, and her eyes forever finding fault."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Realms of Power: The Divine, page 93.\n\nAbbess Prudencia gets bonus of +3 to resist lies, confusion, and subterfuge from her Clear Thinker Virtue and she has a Divine resistance of +10 from the relic of San Ildefonso she unknowingly wears (a cord from his robe wound into a belt passed from abbess to abbess). She is also attended by two novices who follow her and carry out her instructions."
    }

}
