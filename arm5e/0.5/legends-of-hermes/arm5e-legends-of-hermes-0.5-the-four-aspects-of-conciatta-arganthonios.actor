EXTENSION "ArM5_Legends_of_Hermes_TheFourAspectsOfConciatta_Arganthonios" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Arganthonios"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # Arganthonios (Chapter Two: The Four Aspects of Conciatta, p38): one being, its printed stat lines verbatim fields.

    #tf3387003a5a45c1caa9bf0 ^"Arganthonios" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#ta7577edad62c09782b18cd ^"Tartessos"]
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 35
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 2
            ^"Age" STRING "N/A"
            ^"Virtues and Flaws" STRING "External Vis (Major), Huge, Ritual Power (x2); Faerie Speech, Humanoid Faerie, Improved Soak (x2); Sovereign Ward (cannot leave Tartessos); Depressed, Incognizant, Role Requires Suffering"
            ^"Reputations" LIST ["King of a Lost City 3 (Iberia)"]
            ^"Soak" INTEGER 5
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Pretences" STRING "Athletics 4 (running), Awareness 3 (searching), Bargain 3 (foreigners), Brawl 5 (grappling), Etiquette 3 (messengers), Faerie Lore 3 (Iberian faeries), Folk Ken 4 (peasants), Great Weapon 5 (long spear), Intrigue 4 (spies), Leadership 5 (intimidation), Penetration 5 (Mentem), Tartessos Lore 5 (past glories)"
            ^"Equipment" STRING "Silver crown of laurel leaves, too large for a mortal head. The crown is the manifestation of his External Vis virtue and bestows both the Puissant Leadership virtue and the Reclusive flaw upon its wearer. A great spear with a silver shaft, an ivory head, and binding strung with peacock feathers."
            ^"Vis" STRING "7 pawns (Mentem) in the crown he wears."
            ^"Appearance" STRING "A huge muscular man over eight feet tall whose body and beard seem to made of shining fluid silver. His brow is heavy and furrowed beneath the silver crown he wears."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 38
        }
        PERSONALITY_TRAITS {
            "Resigned" +3
            "Commanding" +2
            "Depressed" +2
        }
        COMBAT {
            "Grappling" INIT -2 ATTACK 6 DEFENSE 4 DAMAGE 4
            " Long spear" INIT 1 ATTACK 9 DEFENSE 5 DAMAGE 11
        }
        POWERS {
            #t1d651b2e8755dcec889f0c ^"Binding Oath (Legends of Hermes)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Binding Oath"
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "–22"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "This power enforces the power of a solemnly-sworn oath or contract between two or more parties. All parties must agree to the oath of their own free will, and the power must penetrate the Magic Resistance of all parties to take effect. If one participant attempts to act in direct contravention to the oath, the other participants are immediately aware of this. Humans who attempt to break their oaths are given a warning in the form of seeing Arganthonios in every reflective surface they chance upon. If the character disregards this warning, he is struck blind (as per the Flaw). The blindness can be removed by powers that destroy mystical effects. The character may also end the Flaw by fulfilling the conditions of the oath, swearing a new oath with the wronged faerie, or destroying all of the oath’s other participants. Faeries cannot break their oaths, although some roles allow them to seek loopholes and alternative interpretations. Special, No Hermetic equivalent (R: Touch, D: Mom, T: Group, Ritual)"
            }
        }
        DESCRIPTION "Arganthonios is alone with the exception of his loyal queen. But it is his nature to endure loss and so he willingly frees her from any obligation to stay. Note that Arganthonios is Incognizant in that despite his understanding of and connection with the Faerie Realm, he cannot seek to change or improve his role."
    }

}
