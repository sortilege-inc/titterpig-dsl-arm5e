EXTENSION "ArM5_Legends_of_Hermes_TheFourAspectsOfConciatta_Devices" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Two: The Four Aspects of Conciatta devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t00c818b348c13f046f334d ^"The Sands of Time" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 19
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, +2 complex effect; +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "InVi 19 R: Touch, D: Sun, T: Individual"
            ^"Location" LIST [#taab60f4b7e2ad80249defb ^"La Torre No Vista"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "This large three-chambered hourglass, standing one foot in height, indicates whether a Magic aura is waxing, waning, or is stable. If the aura is waning the sand flows through the hourglass into the lower chamber. If the aura is waxing the reverse is true and the sands run upwards. If the aura is essentially stable then the sands collect in the middle chamber.\n\nThe only example left in the sanctum is broken, its glass chambers smashed and the sand blown away. However, the wooden frame survives and the device can be reforged by a skilled Verditius.\n\n(Base 2, +1 Touch, +2 Sun, +2 complex effect; +1 for 2/day, +3 triggered at sunrise/set)\n\nIf the device were working it would provide a bonus of +3 to an insight roll. In its current state it provides no bonus but does provide 4 points towards integrating *Insight of the Realms*."
    }

    #tf351925160401ef49ce5c8 ^"The Lodestone" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 33
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun; +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "InVi 33 R: Touch, D: Sun, T: Individual"
            ^"Location" LIST [#taab60f4b7e2ad80249defb ^"La Torre No Vista"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 27
        }
        DESCRIPTION "This small palm-sized silver device contains a pointer beneath a glass lens. When exposed to a Magic aura the pointer aligns in the direction of the closest supernatural tether currently anchoring the aura. If the aura is diffuse and has no anchor the pointer moves with the casing and aligns to no particular direction.\n\n(Base 5, +1 Touch, +2 Sun; +1 for 2/day, +3 triggered at sunrise/set)\n\nGiven the simplicity of its working, the lodestone provides no bonus to the insight roll. Recreating the effect grants 7 points towards integrating *Insight of the Realms*."
    }

    #t65c00e439994004edb4f36 ^"Maintaining the Unstable Conjuration" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+16"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Effect Design" STRING "(Base, +2 Ring, +1 Circle; +2 for 3/day, +8 Penetration)"
            ^"Printed Effect Line" STRING "ReVi 30 Pen +16, 3/day R: Personal, D: Ring, T: Circle"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This enchanted circle sustains a target spell of level 15 or less cast within the circle. Importantly, in support of Conciatta’s research, this effect also works on the non-Hermetic magic of the Learned Magicians. The spell is canceled if the target of the spell moves outside the circle or any other spell is cast within it.\n\nThe laboratory notes describing this effect suggest that this is one of four effects to be enchanted into this Greater Enchanted Device. While this effect is aligned to the Magic realm, the others not only targeted effects of the other three realms but also the non-Hermetic effects of supernatural spirits. Astute readers will realize the implication that Infernal spirits must, at some point, have contributed to Conciatta’s research.\n\nThe ring itself is described as a large iron construction, made in pieces and riveted with brass rivets to the floor, opened with 20 pawns of vis.\n\n(Base, +2 Ring, +1 Circle; +2 for 3/day, +8 Penetration)"
    }

    #t8f9e04fee262e2a1a73612 ^"Clearing the Mind of the Caster" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Requisite" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Ring, +1 requisite)"
            ^"Printed Effect Line" STRING "PeIm (Vi) 30 Pen +0, 1/day R: Touch, D: Ring, T: Circle"
            ^"Location" LIST [#tdcdef8a24e178330a26de0 ^"Qadis"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "The magic in this set of fifteen slate tablets, laced together with leather cords and each carved with a magical symbol, is activated when they are arranged in a circle around the caster. The alignment of the tablets is important, so laying out the stones takes three rounds.\n\nAll sights, sounds, and other sensations crossing into the circle are dulled unless they are created by a Magicaligned source. The effect is to allow the caster within the circle to better ignore distractions arising from sources not aligned with the Magic realm. Sensations are not destroyed completely and the caster may attune herself to them simply by concentrating.\n\nThe magic on its own provides a +1 bonus to Concentration rolls to activities that are entirely contained within the circle. When used as props in ceremonial casting the circle of stones provides a +3 ceremonial casting bonus.\n\nRecreating this effect gives six points towards integrating *Insight of the Realms*.\n\n(Base 10, +1 Touch, +2 Ring, +1 requisite)"
    }

    #t2c62a9b32ff228f3bade94 ^"Unveil the Subsumed (Realm)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Fourfold Lens"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 54
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Base 20, +2 Sun, +4 Vision; +1 for two uses per day, +3 triggered at sunrise and sunset)"
            ^"Printed Effect Line" STRING "InVi 54 Constant Effect R: Personal, D: Sun, T: Vision"
            ^"Location" LIST [#t7e5e4e69cf1d7319329b53 ^"The Roman Theater"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "Each lens can be used to see through the apparent aura into the subsumed aura of the appropriate type, if such an aura is present. The image seen by looking through the lens shows the world as it would look if that aura were dominant. So a subsumed Infernal aura shows the potential for unnerving shadows, while a Magic aura may appear somewhat cleaner or more regular.\n\nAlthough subsumed auras of any level can be detected, the enchantment is only strong enough to penetrate a level 3 apparent aura. Only the lowest level of each subsumed aura type is detected, so regiones cannot be directly perceived using this device.\n\n(Base 20, +2 Sun, +4 Vision; +1 for two uses per day, +3 triggered at sunrise and sunset)\n\nRecreating this device provides 11 points towards integrating *Confluence of the Realms*."
    }

    #t7401ecc399700f064c9df7 ^"Sense the Line" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Insightful Stylus"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 Sun; +1 for 2/day, +3 triggered by sunrise/set)"
            ^"Printed Effect Line" STRING "InVi 14 Pen +0, Constant Effect R: Touch, D: Sun, T: Individual"
            ^"Location" LIST [#t03a9f380c44d10e900e7ea ^"The Caves"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "This enchantment detects the line of the Infernal regio boundary. The information it collects is available to the Inscribe the Line effect described below.\n\n(Base 3, +1 Touch, +2 Sun; +1 for 2/day, +3 triggered by sunrise/set)"
    }

    #te58096847584c374d92d1c ^"Inscribe the Line" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Insightful Stylus"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +2 Sun, +2 affect metal; +1 for 2/day, +3 triggered by sunrise/set)"
            ^"Printed Effect Line" STRING "ReTe 14 Pen +0, Constant Effect R: Personal, D: Sun, T: Individual"
            ^"Location" LIST [#t03a9f380c44d10e900e7ea ^"The Caves"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "While the stylus is touched to a wax tablet, the stylus is held perpendicular to its surface. When this effect receives information about a regio boundary, the stylus moves and inscribes the line of the regio boundary into the wax tablet.\n\n(Base 2, +2 Sun, +2 affect metal; +1 for 2/day, +3 triggered by sunrise/set)"
    }

    #t9e671ec517b253079a90c1 ^"Note These Landmarks" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Insightful Stylus"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited Use"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +2 affect metal; +10 for unlimited use)"
            ^"Printed Effect Line" STRING "ReTe 14 Pen +0, Unlimited Use R: Personal, D: Momentary, T: Individual"
            ^"Location" LIST [#t03a9f380c44d10e900e7ea ^"The Caves"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "At the wielder’s verbal command, the stylus scribes markings onto the wax tablet that describe distances and landmarks sufficient to make the map of the regio boundary navigable. The stylus understands a set of Latin words, primarily numbers and distances, such as “twenty paces” or “thirteen feet”, and landscape features, such as “tree” or “door” and is able to form symbols to match. This effect can be used while the stylus is inscribing a regio boundary without damaging the map.\n\n(Base 2, +2 affect metal; +10 for unlimited use)\n\nThe stylus must be successfully investigated in the laboratory, which then provides a source of insight. Recreating the stylus grants 5 points towards integrating *Insight of the Realms*."
    }

}
