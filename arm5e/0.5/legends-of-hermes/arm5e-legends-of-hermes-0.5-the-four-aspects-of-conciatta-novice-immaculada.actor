EXTENSION "ArM5_Legends_of_Hermes_TheFourAspectsOfConciatta_NoviceImmaculada" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Novice Immaculada"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # Novice Immaculada (Chapter Two: The Four Aspects of Conciatta, p31): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t1b55a52e60677ed298d466 ^"Novice Immaculada" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +2, Pre 0, Com 0, Str 0, Sta 0, Dex +2, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "17 (17)"
            ^"Warping Score" STRING "1 (5)"
            ^"Confidence" STRING "N/A"
            ^"Virtues and Flaws" STRING "Peasant; Sense Holiness and Unholiness, Puissant Sense Holiness and Unholiness; Enfeebled, Plagued by Supernatural Entity (Spirit of Conciatta), Monastic Vows; Visions"
            ^"Personality Traits" STRING "Fearful of being alone +3, Confident –2, Strong-Willed –1 Combat: Dodge: Init +0, Attack N/A, Defense +0, Damage N/A Fist: Init +0, Attack +2, Defense +0, Damage +0"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 1 (music), Music 1 (sing), Church Lore 1 (the convent), Profession: Scribe 1 (copying), Chirurgy 2 (minor wounds), Castilian 5 (poetry), Charm 2 (first impressions), Concentration 2 (prayers), Farmer 2 (almonds), Folk Ken 2 (clergy), Sense Holiness and Unholiness 4+2 (the unseen), Latin 4 (church ceremonies), Swim 1 (short distances), Theology 3 (biblical knowledge)"
            ^"Appearance" STRING "Immaculada is a small girl of 17 years old. Her skin is washed out and tear-streaked, her eyes red through crying. Her hair has been shorn and her habit replaced with a grubby white smock and cap. Her fingernails are picked and bitten raw."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION " Imposed by the spirit of Conciatta\n\nImmaculada is only the latest in a long line of novices that Conciatta has inhabited, but she is faring the worst. With the exception of the flaws imposed on her by Conciatta, the game statistics here represent Immaculada as she should be. In her possessed and enfeebled state she rarely sleeps, so is constantly at a –3 Fatigue penalty. Her Warping Score is Divine in origin."
    }

}
