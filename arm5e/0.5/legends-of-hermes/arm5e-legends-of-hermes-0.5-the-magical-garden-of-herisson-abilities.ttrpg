EXTENSION "ArM5_Legends_of_Hermes_TheMagicalGardenOfHerisson_Abilities" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Four: The Magical Garden of Hérisson abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #t3395f9bb3039ce0bd40fe4 ^"Hermetic Viresculture" DEF {
        EXTENDS #tWPnyoi9rSMWyMo7Njlo9XM2 ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "New Supernatural Ability: Hermetic Viresculture"
            ^"Ability Type" STRING "Supernatural" FIXED
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 72
        }
        DESCRIPTION "The character can produce varieties of self-reproducing vis, and cultivate vis as a form of magical agriculture. Note that, because it fully incorporates Hermetic magic, Hermetic Viresculture can be taught to other magi without needing to subtract one’s Art Scores from the Source Quality (*Houses of Hermes: True Lineages*, page 29). Only those opened to the Hermetic Arts can make use of this Ability since it relies on Hermetic magic."
    }

}
