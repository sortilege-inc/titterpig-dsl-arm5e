EXTENSION "ArM5_Legends_of_Hermes_TheMagicalGardenOfHerisson_VarinaAnOwlOfVirtue" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Variña, an Owl of Virtue"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # Variña, an Owl of Virtue (Chapter Four: The Magical Garden of Hérisson, p78): one being, its printed stat lines verbatim fields.

    #ta803280553a6ac068adc90 ^"Variña, an Owl of Virtue" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 35
            ^"Form" STRING "Auram"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 2
            ^"Confidence" STRING "2 (6)"
            ^"Virtues and Flaws" STRING "Magic Animal; Magical Monster; Ways of the Mountain; Improved Characteristics, Large, Puissant Stealth; Proud"
            ^"Magical Qualities and Inferiorities" STRING "Focus Power (Winter’s Queen), Gigantic x2; Improved Attack, Improved Defense, Improved Initiative, Improved Powers, Improved Soak x3, Minor Virtue (Great Dexterity) x2, Minor Virtue (Improved Characteristics), Minor Virtue (Tough) Mundane"
            ^"Qualities" STRING "Accomplished Flyer, Aggressive, Ambush Predator, Large Claws, Sharp Ears, Thick Feathers"
            ^"Combat" STRING "Large Claws: Init +6, Attack +21, Defense +13, Damage +9 Includes Ways of the Mountain Virtue."
            ^"Soak" INTEGER 12
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32), Dead (33+)"
            ^"Powers" STRING "Winter’s Queen, 1–6 points, Init –Might cost, variable form: Variña can duplicate any spell involving snow, ice, or cold with a level less than or equal to 30. this costs her 1 Might point per magnitude of the spell. Focus Power (5 mastery points to increase maximum level)"
            ^"Vis" STRING "7 pawns of Auram vis, in feathers"
            ^"Appearance" STRING "An immense white owl with black speckles and amazing emerald-colored eyes."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 78
        }
        PERSONALITY_TRAITS {
            "Owl" +5
            "Vain" +4
            "Territorial" +3
        }
        ABILITIES {
            "Awareness" SCORE 4 SPECIALTY "prey"
            "Athletics" SCORE 5 SPECIALTY "flying"
            "Brawl" SCORE 5 SPECIALTY "claws"
            "Hunt" SCORE 4 SPECIALTY "prey"
            "Stealth" SCORE 5 BONUS 2 SPECIALTY "from sky"
            "Survival" SCORE 3 SPECIALTY "mountains"
        }
        DESCRIPTION "Variña had a Heartbeast Ability of 7 when she entered Final Twilight, leaving her Inner Heartbeast with a Magic Might of 35. She can have up to 15 more points of Magical Qualities (see *Realms of Power: Magic*, page 36), which have been left for the storyguide to develop. It is exceptionally unlikely that Variña would consent to becoming a familiar, given her background in House Bjornaer. She need not be considered to be a monster that must be killed, but she must be bypassed to gain entrance into her tower.\n\nWhen she attacks, the owl will often do so from ambush; if she is not spotted and wins Initiative she gains a +3 bonus to her first Attack total. Furthermore, if she is first in the Initiative order even after her first attack, she can fly out of reach of melee weapons after making her attack. Should she wish to circle around and attack again, make new Initiative rolls for the combat."
    }

}
