EXTENSION "ArM5_Legends_of_Hermes_TheSunkenLaboratoryOfHermanus_Guidelines" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Five: The Sunken Laboratory of Hermanus guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tf4b324daf4dd4a833d2894 ^"Rego Vim Guidelines (Legends of Hermes, Rego Vim Guidelines)" DEF {
        EXTENDS #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Printed Name" STRING "Rego Vim Guidelines"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 5" "Activate an enchanted device with a simple trigger (i.e., not a linked trigger or an environmental trigger, see **ArM5** page 99). The caster must know the triggering action for the target device either because he invested the enchantment himself, because he investigated the enchantment in the laboratory or because he has learned it in some other manner such as being shown the action by someone else who already knows it. The target item is activated directly by the Rego Vim spell; the normal trigger is not reproduced."
        }
    }

}
