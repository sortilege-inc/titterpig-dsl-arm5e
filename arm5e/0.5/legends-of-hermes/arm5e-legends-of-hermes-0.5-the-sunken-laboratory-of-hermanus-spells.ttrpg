EXTENSION "ArM5_Legends_of_Hermes_TheSunkenLaboratoryOfHermanus_Spells" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Five: The Sunken Laboratory of Hermanus spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Legends_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tf934b121739582ccf857a3 ^"Cloak of Fins and Scales" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20 +1 Touch, +2 Sun, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 35 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "The caster hangs a small cape of fish scales on the back of the target and the target transforms into a naturally occurring fish of the same approximate size as the original target. The target may choose to change back to human form at any time, but doing so ends the spell. Fish and other naturally aquatic creatures do not suffer any penalties due to pressure.\n\n(Base 20 +1 Touch, +2 Sun, requisite free)"
    }

    #t722dfb52723213ea2eddad ^"Form of the Aquatic Predator" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +2 Sun, +1 size alteration, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 35 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "The caster hangs a small cape of Shark scales on his back and transforms into a large shark of size +2 as described in the accompanying sidebar. The caster may choose to change back to human form at any time but doing so ends the spell. Fish and other naturally aquatic creatures do not suffer any penalties due to pressure.\n\n(Base 20, +2 Sun, +1 size alteration, requisite free)"
    }

    #t0df87bbde29c576178edb7 ^"Shape of the Siren" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +2 Sun, +1 Part, +1 complexity, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 40 R: Per, D: Sun, T: Part"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "The caster’s body from the hips down is transformed into the tail of a large fish, keeping the same approximate size. The caster also develops gills on his throat allowing him to breathe water but inhibiting his ability to speak, imposing a –3 modifier on all rolls to communicate verbally and a –5 to spell casting totals, as if the character were speaking quietly.\n\nWhile in this form, the caster can move at full speed underwater and does not suffer any penalties due to pressure.\n\n(Base 20, +2 Sun, +1 Part, +1 complexity, requisite free)"
    }

    #t68d59352a325e2f25e6cf6 ^"Breeze from Within" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Sun, +4 magnitudes, wholly divorced from natural context)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrAu 20 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "A very minor breeze is generated in the nose of the target, allowing him access to all of the air that he requires for breathing. While underwater, the target of this spell exhales a constant stream of bubbles that cannot be stopped by the target for more than a second by holding their mouth and nose closed. The breeze cannot be halted without the spell being dispelled or expiring. The breeze makes the manipulation of especially small and light objects by the target difficult.\n\n(Base 1, +1 Touch, +2 Sun, +4 magnitudes, wholly divorced from natural context)"
    }

    #td31e18a14bfe86417df8b0 ^"Eyes of the Fish" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuCo 5 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "The target gains the eyes of a fish, which allow him or her to see clearly while underwater but only blurrily while out of the water.\n\n(Base 2, +1 Touch, +2 Sun, requisite free)"
    }

    #t844fccfb41e3d358ab240f ^"Ward Against Water" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Touch, +2 Ring)"
            ^"Location" LIST [#ta8e00470c32e5247cc5d47 ^"Hallway"]
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReAq 20 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "No water may enter or leave the protected circle. Characters who are wearing wet clothing or perspiring are slowed when entering or leaving a protected area as the excess liquid is stripped from their bodies and possessions. Hermanus cast this ward using forceless casting (Houses of Hermes: True Lineages page 72), so the ward surrounding his laboratory complex has a Penetration of zero, allowing liquids carried by magi and creatures with Magic Resistance to pass through unimpeded.\n\n(Base 5, +1 Touch, +2 Ring)"
    }

    #t337e49e79e99798b30fa5b ^"Circular Ward Against Faerie Spirits" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base Spell)"
            ^"Location" LIST [#ta8e00470c32e5247cc5d47 ^"Hallway"]
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReVi Gen R Touch, D Ring, T Circle"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "All creatures with Faerie Might equal to or less than the level of the spell are unable to enter the circle or harm those within it. Note that, since the spell on the laboratory was cast with a Penetration of 35, only faeries with a Might of 34 or lower are actually stopped, even though it is level 40, as the ward fails to penetrate the Magic Resistance of more powerful fae.\n\n(Base Spell)\n\nThe door on the north side of the hallway is just less than two paces tall, leaving room for the rings that are inscribed above it to be reached by a person of normal height. Providing that the structure has not been moved, this door leads out to the sea floor. If this door is opened characters see that water forms a wall and does not pass into the room from the exterior. A similarly-sized door lies on the inside wall of the hallway at the hall’s southernmost extent. The remaining two doors are located at the ends of the hallway. These two doors are flush with the exterior wall and extend from floor to ceiling in order to allow a magus to trace the inscribed circles when casting a spell. The doors connecting the hallway to the other rooms within the complex are locked. Hanging on the north door is a Locksmith’s Will sentinel. Sitting atop a locked chest upon a table in front of the door to the exterior is the Statue of Conjured Assistants, and within this chest is a silver ring into which 2 pawns of Vim vis have been transferred. If one of the locked doors or the locked chest is unlocked by some manner other than by use of a key that fits the lock, the spirits Ferox and Fidelius will be summoned to see to the defense of the laboratory."
    }

    #tb6b62d3c1e1e3ec925438a ^"Circular Ward Against Magical Spirits" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base Spell)"
            ^"Location" LIST [#t8ec11d93d3b167c41a5b1c ^"Laboratory (The Laboratory of Hermanus)"]
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReVi Gen R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "All creatures with Magical Might equal to or less than the level of the spell are unable to enter the circle or harm those within it.\n\n(Base Spell)\n\nThere is also a casting tablet (see *Covenants* page 89-90) for the spell *Cargo of Angel’s Wings.*"
    }

    #t0c28ebc7fcd3f6d46c8594 ^"Cargo of Angel’s Wings" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 35, +1 requisite, +1 Touch)"
            ^"Location" LIST [#t8ec11d93d3b167c41a5b1c ^"Laboratory (The Laboratory of Hermanus)"]
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 45
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Herbam"
            ^"Printed Stat Line" STRING "ReTe(He) 45 R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "The caster transports the target object to the location of an arcane connection. Hermanus used this spell to obtain vis and arcane connections from the location of the Wooden Mannequin that he used to explore the world without leaving his laboratory. In order to use this spell from a distance, Hermanus employed a spell similar to Opening the Intangible Tunnel (ArM5 page 162) in conjunction with the casting tablet.\n\n(Base 35, +1 requisite, +1 Touch)"
    }

    #tf184ae4148ba2233403e56 ^"Scraping Razor of Memory" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 4
            ^"Range" STRING "Pers"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeMe 4 R: Pers, D: Mom, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "The caster removes a single important detail from his or her own memory.\n\n(Base 4)"
    }

}
