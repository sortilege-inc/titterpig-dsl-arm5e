EXTENSION "ArM5_Magi_of_Hermes_AlexanderOfJerbiton_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter One: Alexander of Jerbiton spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tabad65e0d60bf57a3a9967 ^"Recruiting A Tiny Phalanx" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Touch, +2 Sun, +1 Group, +1 Rego requisite)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Rego"
            ^"Printed Stat Line" STRING "Cr(Re)An 30 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "This spell allows Alexander to create a swarm of scorpions. The swarm, combined, has the mass of a human being. The spell has a Rego requisite, which allows Alexander to command the swarm to do things other than chase beetles and run from larger creatures. In dangerous areas, he often casts two Circles of Beast Warding, one slightly larger than the other, around the area where his party is going to camp. He then pours scorpions into the ring this creates, and orders them to attack anyone else that crosses the ring, casting the spell multiple times if he feels it is necessary. This technique also has the advantage that if he botches the spell, and creates a swarm of enraged and uncontrollable scorpions, he need only wait safe behind his inner Circle of Beast Warding for them to disappear.\n\nScorpion venom is painful, but individual stings are rarely fatal for healthy people. In areas where scorpions are common, the allergy that causes their sting to be fatal may be taken as a Minor Flaw. An attacking swarm of scorpions does +10 damage automatically each round, but this can be Soaked normally.\n\n(Base 5, +1 Touch, +2 Sun, +1 Group, +1 Rego requisite)"
    }

    #t1abf995be71f12fe22d4b4 ^"Scales of the Scorpions" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +2 Voice, +1 Diameter, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuAn Level 40 R: Voice, D: Diam, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "Alexander uses this ability to plate friendly animals, including his grogs when transformed, in chitinous armor. These plates are enormous versions of the armor that protect scorpions. This grants +3 Soak.\n\n(Base 15, +2 Voice, +1 Diameter, +2 Group)"
    }

    #tb7a9e1b3d87e6ce6ed68bb ^"Bag of Teeth" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +3 Moon, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuAq(An) 20 R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "Transforms a pool of water into an animal tooth. When on expedition, Alexander often carries several of these teeth. They are not a perfect solution to water shortage, because Alexander, while young, cannot dispel this effect, so the water only becomes available when the spell expires. If forced to use his emergency water, Alexander prefers to first create a sanctuary using A Place of Recuperation and A Time for Slumber, then ration his water by keeping his servants, and himself, in diminutive animal forms until the Bag of Teeth reverts to gallons of water.\n\nEach tooth may become just under a hundred cubic feet of water. This means that the teeth destroy any closed container they are stored within when they change back. They are able to cause explosions, but Alexander has never considered their military potential.\n\n(Base 4, +1 Touch, +3 Moon, requisite free)"
    }

    #tf1b7e883fd22008afb2920 ^"Clouds of Obscuring Sand" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +3 Sight, +2 Sun +2 Group (for larger area))"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrAu 30 R: Sight, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "Alexander uses this spell to call up a small, but severe, sandstorm. This obscures the vision of everyone within an area 1000 paces across, and prevents travel by those unprepared for sandstorms. Alexander uses *Movement Within the Sirocco* to allow him to move freely through the storm, although navigation by sight remains difficult unless he takes bird form, using *The Shadow on the Sand*, to rise above the affected area.\n\n(Base 3, +3 Sight, +2 Sun +2 Group (for larger area))"
    }

    #t1e6ca629610eef615e76c2 ^"Movement Within the Sirocco" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReAu 25 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "Allows Alexander, or the person he touches, to operate in the worst possible sandstorms. Alexander uses it when a sudden storm occurs, so that he can then cast Ward Against the Sirocco. It has also proven useful while battling some of the wind creatures that guard the Kushite ruins in which he has developed an interest.\n\n(Base 10, +1 Touch, +2 Sun)"
    }

    #t8312035182a41e895085f6 ^"Ward Against the Sirocco" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReAu 25 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "Wards against sandstorms by repelling the breezes that carry dust. It is powerful enough to defend Alexander and his servants from the most powerful sandstorms.\n\n(Base 10, +1 Touch, +2 Ring)"
    }

    #tc56f2f71383ae5c41571c8 ^"Eyes of the Housecats" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +2 Sun, +2 Group, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 20 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "The targets gain the ability to see as a cat sees, allowing them to operate normally in low-light conditions. Alexander prefers his group to travel at night when in desert locations, to avoid the heat in the middle of the day.\n\n(Base 2, +2 Voice, +2 Sun, +2 Group, requisite free)"
    }

    #t68d21ae6f5de5a4039863b ^"The Guardian of the Tombs" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 20 R: Per, D:Sun, T:Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "When faced with animals that might feed upon his camel form, Alexander uses this spell to take the shape of a cobra. Many predators find snakes intimidating or too small to be suitable prey. While in snake form, Alexander can detect the movement of nearby animals through vibrations in the ground, and he has a poisonous bite. If Alexander bites something hollow, so that his poison is injected into it, the poison does not disappear when he returns to human form. Some of Alexander’s grogs occasionally use his poison to envenom their arrows. Alexander has a serpent skin wristband that he uses as a physical focus for the spell, so that he can cancel it at will.\n\n(Base 10, +2 Sun)"
    }

    #t79184f28441f3054dffc17 ^"The Desert Wanderer" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Sun, +1 for size change)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 25 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "Alexander uses this spell to transform into an Arabian camel. This allows him to travel through the arid regions of Northern Africa more easily than if he had human shape. In this form he has the innate abilities of a camel, which includes the ability to detect the direction and distance of water for many miles, by scent. He has a belt made of camel leather that acts as a focus for this spell, enabling him to dispel it at will.\n\n(Base 10, +2 Sun, +1 for size change)"
    }

    #taa11c145d7d42f8ce589a6 ^"The Shadow on the Sand" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 30 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "The ability to take the shape of a vulture allows Alexander to forage for food, and travel swiftly over areas that do not interest him. Vultures have exceptionally keen eyesight, so he is able to observe distant events on the ground in this form. Vultures are also considered birds of ill-omen, and he has occasionally used this shape to unnerve mundanes. Alexander has a strand of vulture feathers that he uses as a physical prop to allow this spell to be canceled at will.\n\n(Base 20, +2 Sun)"
    }

    #t928c44a9c98f9abb8c3b35 ^"Retreat As Flying Vermin" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Circle"
            ^"Requisite" STRING "Corpus"
            ^"Printed Stat Line" STRING "Mu(Co)An 35 R: Voice, D: Sun, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This spell allows Alexander to turn a group of people, and their Animal-based equipment, into bats. It was designed to be used as a spell that would allow his grogs to rapidly retreat from danger, but the effect Alexander desired is slightly beyond his skill, so he needs to draw a circle before the spell can be used. He plans to use it only in emergencies, because his grogs will lose those items of equipment that are not based on animal products when it is used, which includes their weapons. If forced to use this spell to flee a foe, Alexander plans to use Clouds of Obscuring Sand, and perhaps Ward Against the Sirocco first. He has a piece of bat leather in a small bag of trinkets he always carries, to use as a physical prop if this spell is cast.\n\n(Base 20, +1 Touch, +2 Sun)"
    }

    #t77da7077f9ef74644a3cb4 ^"The Lurker in the Rushes" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +1 Touch, +2 Sun. Crocodiles are treated as fish when selecting a base level for this spell, +1 great Size change)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 40 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This spell transforms Alexander, or someone he touches, into a crocodile. Crocodiles are fearsome foes in combat around water, and the stealth of the crocodile makes grogs that have experience with the form into useful amphibious or aquatic scouts. Alexander has a crocodile skin dagger scabbard, which he uses to cancel the spell at will.\n\n(Base 20, +1 Touch, +2 Sun. Crocodiles are treated as fish when selecting a base level for this spell, +1 great Size change)"
    }

    #t78be521b1a81220ce04ed6 ^"A Punishment for Brigands" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice +2 Sun, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 40 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This spell transforms a human into a mouse. While in mouse form, the victim of this spell may be affected by Circle of Beast Warding, which prevents him or her from fleeing if cast swiftly enough. This allows the mouse to be gathered into a bag and transferred to a place of confinement, or casually destroyed.\n\n(Base 10, +2 Voice +2 Sun, +2 Group)"
    }

    #ta20542a5ff63ab460555c8 ^"A Source of Tremendous Pride" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice +2 Sun +2 Group +1 for size change)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 45 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "Used to transform the covenant’s servants into a pride of lions. Medieval bestiaries recognize three varieties of lion. Male lions of the straight-maned type, which this spell produces, are lazier than female ones, and this has led to the formation of a small cadre of female warriors in the covenant, who are skilled in unarmed combat. A few carry bone weapons. Alexander sometimes uses a tail spur he carries in his trinket pouch as a physical prop to allow this spell to be canceled at will.\n\n(Base 10, +2 Voice +2 Sun +2 Group +1 for size change)"
    }

    #taf4830ad938841cb25f4f0 ^"Bag of Feathers" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +3 Moon, +2 Group, +1 requisite (changes animal products into lighter animal products)."
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuHe(An) 35 R: Touch, D: Moon, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This spell is used to lessen the load carried by expeditions, by transforming all of the food supply they must carry, excepting that required during the spell’s duration, into feathers. In Alexander’s case each type of food becomes a different color and pattern of feather, so that servants who travel with him learn to read which feather is which provision. Food in feather form does not spoil, although it often tastes slightly of chicken after it regains its original form. Note that the food does not change back when the caster wishes; without Perdo Vim magic, he must wait for the duration to end.\n\n(Base 4, +1 Touch, +3 Moon, +2 Group, +1 requisite (changes animal products into lighter animal products)."
    }

    #tdcb9510ed5639ba8b797af ^"Conflagratious Lanyard" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +3 Moon, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuIg(An) 30'); read from its design line '(Base 10, +1 Touch, +3 Moon, requisite free)' (p14), which adds no Target step: Individual"
            ^"Duration" STRING "Moon" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuIg(An) 30'); read from its design line '(Base 10, +1 Touch, +3 Moon, requisite free)' (p14), which adds no Target step: Individual"
            ^"Target" STRING "Individual" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuIg(An) 30'); read from its design line '(Base 10, +1 Touch, +3 Moon, requisite free)' (p14), which adds no Target step: Individual"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuIg(An) 30"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This is a spell Alexander designed to avenge a personal slight. This spell transforms a large campfire into a bootlace, glove, thong, lanyard, belt, or similar leather product, for Moon Duration. When the spell’s duration expires, the campfire continues burning as a natural fire, if it has sufficient fuel and air. A person wearing the item suffers +5 Damage in the first round, and in each subsequent round provided the fire has sufficient fuel to continue burning. Alexander appears to have used this spell to burn all of his rival’s favorite clothes, by incinerating the contents of a closet. Rumors that the rival’s ship was lost at sea with all hands have never been proven.\n\n(Base 10, +1 Touch, +3 Moon, requisite free)"
    }

    #t41e3519e22543e01c6c744 ^"A Time For Slumber" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "PeIg 5 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "When this spell is cast around a camp, it dims the blinding light of the desert sun. This allows grogs and animals to sleep more easily. Alexander uses it in conjunction with A Place of Recuperation when on expedition.\n\n(Base 2, +1 Touch, +2 Ring)"
    }

    #t5aac73f8ba6c6fd489eea5 ^"A Place of Recuperation" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "PeIg 15 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "When this spell is cast around a camp, it lowers the temperature within the site to that of a mild summer’s day. Alexander uses it, in conjunction with A Time For Slumber, to allow his expedition to rest during the hottest part of the day during desert travel.\n\n(Base 4, +1 Touch, +2 Ring)"
    }

    #t67be08cbfbf791f0cc6e20 ^"The False Dune" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "MuIm Level 5 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Sometimes Alexander can’t just make an unnaturally cool, dark space, surrounded by a moat of scorpions, when he wants to camp. This spell changes the way his camp looks and sounds. He often makes it appear to be a sand dune or copse of trees.\n\n(Base 2, +1 Touch, +2 Ring)"
    }

    #t5b5e8050fba054e8a111a1 ^"Avoiding the Blame" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Eye, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 15 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "This spell allows Alexander to rewrite all of the target’s memories concerning a length of time. Alexander uses this spell to misdirect mundane enemies, but its Duration is so brief that it must be used cautiously. It is suitable for assisting his servants, when in trouble with mundane authorities, to gain their freedom long enough to flee an area. It can also be used to trick rivals into social gaffes, which can harm their political position.\n\n(Base 4, +1 Eye, +2 Sun)"
    }

    #t63b91c7eb908f890ee238f ^"The Petrine Deception" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +1 Concentration, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuIm Level 15 R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "This spell makes Alexander’s grogs look and sound like small rocks. Alexander is unable to dispel his magic, and while in rock form his grogs cannot communicate with each other to co-ordinate attacks, so this spell dissipates when Alexander’s concentration wavers.\n\n(Base 2, +2 Voice, +1 Concentration, +2 Group)"
    }

    #t084de76cb638317b992e38 ^"Rapid Excavations" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Sun, +2 Part, +1 large target)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuTe(Aq) Level 30'); read from its design line '(Base 3, +2 Voice, +2 Sun, +2 Part, +1 large target)' (p14)"
            ^"Duration" STRING "Sun" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuTe(Aq) Level 30'); read from its design line '(Base 3, +2 Voice, +2 Sun, +2 Part, +1 large target)' (p14)"
            ^"Target" STRING "Part" FIAT "the book prints no Range, Duration or Target (its effect line is 'MuTe(Aq) Level 30'); read from its design line '(Base 3, +2 Voice, +2 Sun, +2 Part, +1 large target)' (p14)"
            ^"Requisite" STRING "Aquam"
            ^"Printed Stat Line" STRING "MuTe(Aq) Level 30"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "This spell allows Alexander to turn large volumes of sand into water, which rapidly dissipates in the desert heat. Alexander uses this spell to excavate sites that have become sand-bound, and to disorient foes by making the ground they are standing on into a deep waterhole. This spell can affect one hundred cubic yards of sand. Alexander can alter the shape of the space affected with a Finesse Roll.\n\n(Base 3, +2 Voice, +2 Sun, +2 Part, +1 large target)"
    }

}
