    #t1e6c2c70f90236d83bae70 ^"Conscientia at Gauntlet" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Conscientia of Bonisagus"
            ^"Role" STRING "Magus"
            ^"Characteristics" STRING "Int +4, Per +2, Pre +1, Com +1, Str –1, Sta –2, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "20 (20)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Adept Laboratory Student, Affinity with Creo, Affinity with Magic Theory, Affinity with Muto, Book Learner, Great Intelligence, Inventive Genius, Study Bonus, Skilled Parens, Privileged Upbringing, Puissant Magic Theory; Waster of Vis, Weak Spontaneous Magic; Careless Sorcerer, Difficult Spontaneous Magic, Exciting Experimentation, Poor Formulaic Magic"
            ^"Personality Traits" STRING "Inquisitive +2, Clever +3, Extrovert 2"
            ^"Reputations" STRING "“Disaster in the Making” +2, Brilliant +1"
            ^"Combat" STRING "Dodge: Init: +0, Attack n/a, Defense +0, Damage n/a Fist: Init: +0, Attack +0, Defense +0, Damage –1 Kick: Init: –1, Attack +0, Defense –1, Damage +2"
            ^"Soak" STRING "–2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Abilities" STRING "Artes Liberales 1 (correcting mistakes), Awareness 2 (finding flaws), Bargain 1 (vis), Charm 2 (begging for favors), Code of Hermes 1 (nitpicking details), Etiquette 1 (apologies), Finesse 1 (getting it right the first time), Folk Ken 2 (magi), French 5 (explanations), Guile 1 (breaking bad news), Latin 4 (writing), Magic Lore 1 (famous mistakes), Magic Theory 5+2 (enchanting items), Parma Magica 1 (lab explosions)"
            ^"Arts" STRING "Cr 10, In 0, Mu 10, Pe 5, Re 5, An 5, Aq 2, Au 5, Co 0, He 1, Ig 1, Im 1, Me 0, Te 10, Vi 5"
            ^"Equipment" STRING "Ink-stained robes, more vis than anyone thinks she needs, and the finest lab equipment she could barter for."
            ^"Encumbrance" STRING "0 (0)"
            ^"Spells Known" STRING "Epona’s Bane (ReAn 25/+3) Be Rid the Tell Tale Smoke (PeAu 20/+3) Statim Sessio (CrHe 10/+4) Evening’s Comfort (CrIg 5/+4) Palm of Odorous Flame (CrIg 5/+4) Veneficus Enigma (CrIm 20/+4) Spy the Approaching Grog (InIm 5/–6) Circle of Undisturbed Rest (ReIm 5/–1) Conjure the Ocean’s Breath (MuTe 15/+13) Armatura Vitreus (MuTe 20/+13) Saving the Apprentice’s Time (PeTe 10/+8) Foras Vim (ReTe 15/+8)"
            ^"Appearance" STRING "Conscientia is a scruffy girl of small stature, often found in robes stained with innumerable unidentifiable substances. She keeps herself in a practical state, often with hair tied back and the sleeves of her robes pulled up. Conscientia’s left cheek bears an unsightly blue stain, a relic of experiments past."
            ^"Sigil" STRING "When Conscientia casts her spells, lines around the target appear twisted and broken. Her voting sigil is five curved lines forming a pentagram."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 25
        }
    }

