EXTENSION "ArM5_Magi_of_Hermes_ConscientiaOfBonisagus_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Three: Conscientia of Bonisagus spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t807aedc4ffbf3db66bc97a ^"Doublet of Silk, That’s Impenetrable" DEF {
        EXTENDS #tGLTBmNOJYwLoU5LtbkxpnAZ ^"Doublet of Impenetrable Silk"
        PROPERTIES {
            ^"Variant Of" STRING "Doublet of Impenetrable Silk"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "As *Doublet of Impenetrable Silk*, but experimentation has resulted in a minor side effect. The clothing affected is changed into actual silk, as well as gaining the normal benefits of the spell."
    }

    #t62836be1739117a8c950ac ^"Pests of a Colossal Size" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Sun. +2 Group, +2 Voice)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuAn 30 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "While experimenting with Beast of Outlandish Size, an unforeseen side effect gave birth to this unusual, but peculiarly effective, spell. Pests of a Colossal Size causes the ordinary pests on the target (such as lice, fleas, ticks, etc.) to grow to an enormous size. Being covered in enormous and often hostile insects is disconcerting to say the least, as the pests themselves tend to revert to their basic fight or flight instincts.\n\n(Base 4, +2 Sun. +2 Group, +2 Voice)"
    }

    #tcdd6af8dc764adcf39d7d4 ^"Epona’s Bane" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReAn 25 R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "Created as a defense against the eastern horseman, Epona’s Bane startles and panics up to a small unit of cavalry horses. The riders of these horses must roll Strength + Ride against an Ease Factor of 12, or be thrown to the ground and risk being trampled. Even those who manage to keep themselves on their mounts must bring their horses back under control before continuing forward.\n\n(Base 5, +2 Voice, +2 Group)"
    }

    #t7ac7efb88ce35ebc4f0ddd ^"Summon the Eldritch Bond" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReAn 35 R: Voice, D: Sun, T: Ind."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "A fine preparation to a Wizard’s War, this spell commands a biting insect, such as a mosquito or flea, to bite a specific target and then return. A canny magus can then harvest the blood and its Arcane Connection from the insect. Of course, this needs to be cast fairly close to the target for the insect to have a chance of catching him. However, combining this spell with Pests of a Colossal Size greatly extends its effective range, as well as the intimidation factor. It does rather reduce its subtlety, however; a magus who would ignore a normal mosquito is unlikely to do the same for a giant one.\n\n(Base 15, +2 Voice, +2 Sun)"
    }

    #tf4cf3e54687a9d367f3fb8 ^"Conjure From the Mist" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Sun, +1 Part, +2 Voice, +2 size, +1 Intricate)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Terram"
            ^"Printed Stat Line" STRING "MuAu(Te) 40 R: Voice, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "Developed as an all-purpose utility spell, Conjure From the Mist turns a large section of air into stone, in the shape of the user’s choice. More-complicated shapes require Finesse rolls as normal, but items such as stairs, bridges, walls, spikes and other obstacles are possible.\n\n(Base 4, +2 Sun, +1 Part, +2 Voice, +2 size, +1 Intricate)"
    }

    #tdcadfa5ea9ad0e99ebdaf3 ^"Be Rid the Tell Tale Smoke" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Ring, +1 Touch)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "PeAu 20 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "Conscientia learned this spell from her parens, who developed it after overhearing grogs complaining about a how a campfire’s smoke always gives away their position. This spell simply destroys all smoke within the circle. Great for setting up camp on the sly, or keeping the laboratory smoke-free.\n\n(Base 5, +2 Ring, +1 Touch)"
    }

    #t440bd50417b5058a5a499c ^"Touch of the Blessed Virgin" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, Ritual)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 28
        }
        DESCRIPTION "Conscientia swears this was developed for a friend, and she has never personally found a use for this spell. Popular with fathers, princesses, and nuns alike, this spell restores a woman’s maidenhood and virtue. This is often combined with an Elixir of Morning’s Afterthought for full effect.\n\n(Base 15, +1 Touch, Ritual)"
    }

    #t43f2840f764809e8fae38b ^"Statim Sessio" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrHe 10 R: Touch, D: Sun, T:Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Favored by magi young and old who just need a quick rest, this spell creates a comfortable wooden chair.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #t4656d42ad8c20a1cae0995 ^"Evening’s Comfort" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Per"
            ^"Printed Stat Line" STRING "CrIg 5 R: Touch, D: Sun, T: Per"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "After many sleepless nights spent chilled to the bone, enough was enough. Slipping down to the lab to work at night, Conscentia developed this simple spell to keep her warm at night. This spell simply keeps your bed toasty warm until sunrise.\n\n(Base 2, +1 Touch, +2 Sun)"
    }

    #t74b44d0d56ed8598fa645f ^"Palm of Odorous Flame" DEF {
        EXTENDS #tFTTWu85yhnWh1j6b3BWAtBN ^"Palm of Flame"
        PROPERTIES {
            ^"Variant Of" STRING "Palm of Flame"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "The first spell Conscentia developed on her own, this spell works as *Palm of Flame*, but experimentation has produced a small side effect. Each time the spell is cast, the flame produces the smell of a random odor. Oddly enough, the most common scent produced is elderberry. Needless to say, this spell has proven difficult to trade."
    }

    #t1308a43834cb223ca6bc07 ^"Veneficus Enigma" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Conc, +2 Move/ Noise, +1 Intricate)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrIm 20 R: Touch, D:Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Developed as a quick game for magi, the Veneficus Enigma creates the illusion of a small puzzlebox in the palm of the caster’s hand that can be manipulated by another. When cast, the caster sets the puzzle for the Veneficus Enigma. The illusory box then produces lights and sounds that are clues on how to open it. Figuring out the puzzle requires an Intelligence + Artes Liberales roll versus an Ease Factor equal to the casters Intelligence + Artes Liberales + 5. Traditionally, the caster holds an item in the palm of his hand when he casts this spell, to be retrieved as the “prize” when the box is opened. Removing the box from the caster’s hands to reveal the item without solving the puzzle is considered extremely impolite.\n\n(Base 3, +1 Touch, +1 Conc, +2 Move/ Noise, +1 Intricate)"
    }

    #ta6ce8e4be3e21b8d5e9bc4 ^"Spy the Approaching Grog" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +1 Con, +2 Room)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Printed Stat Line" STRING "InIm 5 R: Touch, D: Conc, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "A touch of a wall allows the caster to peer around the corner without entering the room. Great for sneaking down to the lab or the kitchen without being caught. This spell is designed to be cast forcelessly, as to not accidentally scry on another magus.\n\n(Base 1, +1 Touch, +1 Con, +2 Room)"
    }

    #t5a9c4833808d733015d470 ^"Circle of Undisturbed Rest" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +2 Ring, +1 Touch, +1 additional sense)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReIm 5 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Created in conjunction with Be Rid the Tell Tale Smoke, this large circle spell is meant to be used around an encampment. The circle prevents iconic and echoic species from leaving the circle, making the encampment undetectable. Perfect for ensuring privacy in unfamiliar territories, it does leave the camp as a silent black area; this is normally enough at night, when everything is dark, and Conscientia does not see the need for additional illusions.\n\n(Base 1, +2 Ring, +1 Touch, +1 additional sense)"
    }

    #tfb468bdc46c1c111311c78 ^"Robed in Angelic Beauty" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Voice, +1 Con, +2 Group, +1 Imaginem Req.)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Con"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Imaginem"
            ^"Printed Stat Line" STRING "CrMe(Im) 25 R: Voice, D: Con, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell creates the image of perfect beauty and a holy aura, instilling a feeling of being near a divine source. This comes in handy when you need the local plebs to believe … well, anything. Conspicuous effects are also more likely to be accepted when the populous thinks of them as miracles rather than spells. However, caution is advised so as not to attract too much attention from the church, or indeed, from demons.\n\nNote that all Mythic Europeans know that the devil can masquerade as an angel of light; if a Gifted individual serves as the spokesperson during the effect of this spell, that is almost certainly what the audience will believe.\n\n(Base 4, +1 Voice, +1 Con, +2 Group, +1 Imaginem Req.)"
    }

    #t4d393557f16d805dfc5006 ^"Thoughts Within Speech" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 25, +1 Eye)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InMe 30 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Yet another spell where its creation resulted in a side effect worth keeping, this spell acts like Peering Into the Mortal Mind, but while the magus is searching through the thoughts of the target, the target unknowingly speaks those thoughts aloud, going so far as to even weave them into an ongoing conversation. For example: “Did you hear about the new sheriff? Why yes, I was in the gardens last night. I hear he is going to raise taxes this year.”\n\n(Base 25, +1 Eye)"
    }

    #tadef552d31e843149619ed ^"Apollo’s Fearful Gaze" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 30 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This horrific spell rewrites the target’s common sense, so that light induces pain signals (Art and Academe, page 33). The brighter the light, the stronger the pain sensed. Note that the pain isn’t caused by any wounds, and will disappear as soon as the spell ends, or when the target is no longer exposed to light.\n\nLight Source Penalty Moonlight or Candlelight –1 Torchlight –3 Bonfire –5 Daylight Incapacitated\n\n(Base 10, +2 Voice, +2 Sun)"
    }

    #t3d332b2bf22da9e67cb332 ^"Slave of Charity" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +1 Eye, +2 Sun)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 35 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell acts as Enslave the Mortal mind, with one exception. The target remains open to all commands as long as the spell remains active. Any time the target hears a new suggestion, he stops what he’s doing and follows the new command, returning to his previous commands when the most recent task is complete. Needless to say this side effect proved quite awkward when discovered.\n\n(Base 20, +1 Eye, +2 Sun)"
    }

    #t10e0bf3b7aba761b2628e6 ^"Conjure the Ocean’s Breath" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, + 3 Moon, + 1 Part, +1 Touch)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "MuTe 15 R: Touch, D: Moon, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Developed for the traveling magus who needs a quick, easily tradable resource. Conjure the Ocean’s Breath turns a large patch of dirt into salt. It is best that the magus not be around when the spell’s duration expires.\n\n(Base 2, + 3 Moon, + 1 Part, +1 Touch)"
    }

    #t733ba4a80e3317a1fd27d2 ^"Armatura Vitrea" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +2 Diam, +2 metal)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuTe 20 R: Voice, D: Diam, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Designed for those who fear the threat of armor-wearing assailants, Armatura Vitrea transforms one attacker’s armor into glass. The armor now provides a protection of 2, and a load of 3. If struck with a weapon, the glass armor shatters sending razor-sharp shards everywhere, adding an additional simple die to the attack’s damage. This, of course, destroys the armor.\n\n(Base 2, +2 Voice, +2 Diam, +2 metal)"
    }

    #tb2d631cc23cd708c8451c1 ^"Foras Vim" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReTe 15 R: Voice, D Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "An easily fast-cast defense against other magi, this spell shoots a choking cloud of dust and gravel at its targets. Those within the cloud are blinded by the dust and grit, and find it difficult to breathe. Casting a spell while in the cloud requires a Stamina + Concentration roll against an Ease Factor of 12. This spell also has uses in detecting invisible opponents. Conscientia has been meaning to get around to mastering this spell so that she can fast cast it ever since she created it. Maybe next season ...\n\n(Base 3, +2 Voice, +2 Group)"
    }

    #t0f3c20d432b924bef08531 ^"Carve Domain" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Part, +3 Size)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeTe 20 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Carve Domain destroys a channel of up to 10,000 cubic feet of earth. This can be used, among other things, as a defensive emplacement, to channel a river, to expand irrigation, or to develop a makeshift moat. A Finesse roll is required for more-complex designs.\n\n(Base 3, +1 Touch, +1 Part, +3 Size)"
    }

    #t92da2a9dd5f782929255ae ^"Saving the Apprentice’s Time" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, + 2 Room)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Printed Stat Line" STRING "PeTe 10 R: Touch, D: Mom, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Realizing she could squeeze in a few more precious moments of lab time, Conscentia decided to “cheat” in her chores. With just a wave of the hand, she can have an hour’s worth of dusting completed in a minute.\n\n(Base 3, +1 Touch, + 2 Room)"
    }

}
