    }

    #t24b8ab1d313d732e560637 ^"Chamber of Spring Breezes (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Chamber of Spring Breezes"
            ^"Part Of" STRING "Fresh Air Vines"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, +3 Structure, +3 size; +1 lvl 2 uses a Day, +3 lvls environmental trigger [sunrise/sunset])"
            ^"Printed Effect Line" STRING "CrAu 39 Pen +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "Creates a breeze of fresh air that continually moves throughout a covenant, keeping the air continuously breathable even if the room is airtight.\n\n(Base 2, +1 Touch, +2 Sun, +3 Structure, +3 size; +1 lvl 2 uses a Day, +3 lvls environmental trigger [sunrise/sunset])"
    }

