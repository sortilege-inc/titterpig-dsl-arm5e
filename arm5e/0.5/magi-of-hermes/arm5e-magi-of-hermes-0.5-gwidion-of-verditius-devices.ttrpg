            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Circle"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 Circle, +1 Corpus Requisite, +1 Herbam Requisite, +3 lvls environmental trigger (sunset).)"
            ^"Printed Effect Line" STRING "ReTe(Co,He) 33 Pen +0, 1/day R: Touch, D: Sun, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "This effect to mixes the dirt, waste, and plant material at night until it becomes natural compost. The compost is then removed during the day and fresh dirt is added.\n\n(Base 5, +1 Touch, +2 Sun, +2 Circle, +1 Corpus Requisite, +1 Herbam Requisite, +3 lvls environmental trigger (sunset).)"
    }

