    #t0f547520e3d8ca1c8b4f35 ^"Single Root System" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Wall of Iron Thorns"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +3 Size; +1 lvl 2 uses a day, +3 lvls environmental trigger)"
            ^"Printed Effect Line" STRING "MuHe 34 Pen +0, constant effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "The plant grows large, but in an altered way. Its roots snake out through the dirt and shoot up many stalks that create apparently separate individual plants growing about an area. Although it may appear that there are many plants about, there in fact is just one single plant connected through a network of roots.\n\n(Base 4, +1 Touch, +2 Sun, +3 Size; +1 lvl 2 uses a day, +3 lvls environmental trigger)"
    }

