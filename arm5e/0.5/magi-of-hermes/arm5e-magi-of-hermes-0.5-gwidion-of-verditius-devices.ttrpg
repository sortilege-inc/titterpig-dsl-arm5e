            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, +3 Structure, +3 lvls Environmental Trigger (Sunrise/Sunset), +1 Herbam Requisite, +1 lvl 2 uses a day)"
            ^"Printed Effect Line" STRING "CrIg 24 Pen +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This effect keeps the covenant warm during the winter. (See the new spell, earlier.)\n\n(Base 2, +1 Touch, +2 Sun, +3 Structure, +3 lvls Environmental Trigger (Sunrise/Sunset), +1 Herbam Requisite, +1 lvl 2 uses a day)"
    }

