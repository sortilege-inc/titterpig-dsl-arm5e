    }

    #t928e6c52576a70493d694a ^"Move Water" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Water Vines"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 23
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +1 Diameter, +3 Size; +10 lvls unlimited uses a day, +3 lvls Linked Trigger)"
            ^"Printed Effect Line" STRING "ReAq 23 Pen +0, unlimited uses R: Touch, D: Diameter, T: Individual"
            ^"Enchantment Note" STRING "Enchanted Item, 3 pawns of Aquam vis, 1 Season spent to invest"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "A person has only to take hold of one of the buds along the spell’s vines and give the mental command, and a small steady stream of water pours out of the buds for a total of two minutes.\n\n(Base 1, +1 Touch, +1 Diameter, +3 Size; +10 lvls unlimited uses a day, +3 lvls Linked Trigger)"
    }

