    #t8173e166f0f73c34c33442 ^"Friendly Bees" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Tree Hive"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Sun, +2 Group; +1lvls 2 uses a day, +3lvls Environmental Trigger (sunrise/sunset))"
            ^"Printed Effect Line" STRING "ReAn 39 Pen +0, constant effect R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "This spell makes every bee in the hive passive for a day. This means that the grogs can work the gardens and harvest the honey, and as long as no one attacks the hive, the bees will not sting.\n\n(Base 10, +1 Touch, +2 Sun, +2 Group; +1lvls 2 uses a day, +3lvls Environmental Trigger (sunrise/sunset))"
    }

    #t1d88c76b5475478fb5cdbb ^"Mixed Compost" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ring of Mixed Compost"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Requisite" STRING "Corpus, Herbam"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "+0"
