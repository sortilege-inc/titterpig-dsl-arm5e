EXTENSION "ArM5_Magi_of_Hermes_GwidionOfVerditius_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Four: Gwidion of Verditius devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #te3b1e89cfac50c2c320b4b ^"Silent forest" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Staff of Silent Forest Stride"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Requisite" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 1, +2 Voice, +1 Diameter, +1 Part, +1 Size, Unlimited uses +10 lvls)"
            ^"Printed Effect Line" STRING "PeIm(He) 25 Pen +0, constant effect R: Voice, D: Diameter, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This effect destroys all sound species that a plant could make for the duration of the spell, but it does not affect any sound species produced by the magus.\n\n(Base 1, +2 Voice, +1 Diameter, +1 Part, +1 Size, Unlimited uses +10 lvls)"
    }

    #te3ea8f143adce6d2e65407 ^"Warmth of the Wood (Stone Disk of Warmth of Wood)" DEF {
