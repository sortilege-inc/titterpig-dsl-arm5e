EXTENSION "ArM5_Magi_of_Hermes_HughOfFlambeau_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Five: Hugh of Flambeau devices"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t99db3d9d156e65e94fb68d ^"Night-Time Thunder" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Tonatris"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+12"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +1 Diam; Modifications +4 12/day, +6 Penetration)"
            ^"Printed Effect Line" STRING "ReMe 20 Pen +12, 12/day R: Touch, D: Diam, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "This effect is triggered when the wearer of the gauntlet strikes a being with his thumb between his ring and little fingers. The target falls asleep, and cannot be naturally awakened until the effect’s duration has expired.\n\n(Effect: Base 4, +1 Touch, +1 Diam; Modifications +4 12/day, +6 Penetration)"
    }

    #t56bfed6f28d2a2892414a0 ^"Vaulting Lightning" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Tonatris"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+12"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch; Modifications +4 12/day, +6 Penetration)"
            ^"Printed Effect Line" STRING "ReCo 30 Pen +12, 12/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "This effect is triggered when the wearer of the gauntlet strikes a being with his thumb between his middle and ring fingers. The target is propelled backwards with incredible force, traveling up to 5 paces. Upon landing, the target suffers +8 damage. The damage is doubled if the target strikes a hard object such as a wall before the range of 5 paces is reached, or if the target lands on a hard surface such as flagstones.\n\n(Effect: Base 15, +1 Touch; Modifications +4 12/day, +6 Penetration)"
    }

    #t757bd489d55cf946a4beeb ^"Wood that Neither Bends Nor Breaks" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Troll’s Wife"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Requisite" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "n/a"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: base 4, +2 Sun; Modifications +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "MuHe(Te) 14 Pen n/a, constant effect R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "The haft of the axe becomes as hard as iron, and is virtually unbreakable by mundane means.\n\n(Effect: base 4, +2 Sun; Modifications +1 2/day, +3 environmental trigger)"
    }

    #ta76107eff2ffe9a24d4836 ^"Fell the Faerie" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Troll’s Wife"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 23
            ^"Penetration" STRING "20"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch; Modifications +10 Penetration, +3 6/day)"
            ^"Printed Effect Line" STRING "PeVi 23 Pen 20, 6/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "This effect is triggered when the wielder of the axe says “ferrum et fraxinus” (“iron and ash”) when striking a creature with the haft; but it only affects entities with Faerie Might. If the effect penetrates, the creature loses 15 Might.\n\n(Effect: Base 5, +1 Touch; Modifications +10 Penetration, +3 6/day)"
    }

    #t7afc156020b6c6aa34cfc4 ^"Hew the Hell-Beast" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Troll’s Wife"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 23
            ^"Penetration" STRING "20"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch; Modifications +10 Penetration, +3 6/day)"
            ^"Printed Effect Line" STRING "PeVi 23 Pen 20, 6/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "This effect is triggered when the wielder of the axe says “os et orichalcum” (“bone and brass”) when striking a creature with the haft; but it only affects entities with Infernal Might. If the effect penetrates, the creature loses 15 Might.\n\n(Effect: Base 5, +1 Touch; Modifications +10 Penetration, +3 6/day)"
    }

    #t8d1ded87ec0b81437c1aae ^"Sharpening the Wizard’s Blade of Vim" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Troll’s Wife"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 28
            ^"Penetration" STRING "n/a"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch; Modifications: +5 24/day, +3 linked trigger)"
            ^"Printed Effect Line" STRING "MuVi 28 Pen n/a, 24/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        DESCRIPTION "This effect is automatically triggered when the wielder says the word “acuere” (“be sharpened!”) before triggering another enchantment in the talisman that has a unmodified level (that is, excluding Uses per Day, Penetration, and so forth) of 10 or less. The Penetration total of the target effect is increased by 10, which is a total change of effect. This effect can only increase the Penetration of an effect in the item, or the Penetration of the item itself.\n\nHugh invested this effect because when he first created many of the effects in his talisman he was unable to give them a particularly high Penetration total. This effect makes up for that deficiency, even though it adds an extra round to the activation of these effects. It is more economical in terms of enchantment costs than reinvesting the effects he has currently.\n\n(Effect: Base 15, +1 Touch; Modifications: +5 24/day, +3 linked trigger)"
    }

    #t9927c64e6ee6b38106da11 ^"Ride of the Einherjar" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Familiar bond: Bathild the Magical Horse"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 27
            ^"Penetration" STRING "n/a"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Conc; Modifications: +2 3/day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "ReAn 27 Pen n/a, 3/day R: Per, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "When Hugh activates this power, Bathild is able to travel through the air as easily as she would over land. Each use of the power lasts for as long as she remains airborne; as her feet touch the ground the effect ceases. The base level for this effect is assumed through analogy with the Rego Corpus guidelines. The Einherjar were Odin’s warriors, chosen from the slain.\n\n(Effect: Base 15, +1 Conc; Modifications: +2 3/day, +5 maintains concentration)"
    }

    #t7dc560f96c62dcdef62545 ^"Gird the Steed for War" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Familiar bond: Bathild the Magical Horse"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Requisite" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "n/a"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "CrTe(An) 30 Pen n/a, 1/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "When Hugh activates this power, Bathild is clothed in metal scale barding, granting a Protection of 7. The Animal requisite is required to create the armor’s leather straps, woolen padding, and gambeson — without these elements, the armor would not be effective (Effect: base 5, +1 Touch, +2 Sun, +2 very elaborate shape)"
    }

}
