EXTENSION "ArM5_Magi_of_Hermes_HughOfFlambeau_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Five: Hugh of Flambeau talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t13099ca5f65888fd118d66 ^"Troll’s Wife" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Troll’s Wife"
            ^"Owner" STRING "Hugh of Flambeau"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 51
        }
        TABLE {
            "+3" "Corpus" "amber" "Attunements"
            "+4" "blood and wounds" "bloodstone" "Attunements"
            "+4" "demons and angels" "brass, from Houses of Hermes: Mystery Cults, page 137" "Attunements"
            "+7" "harm or repel faeries" "iron" "Attunements"
        }
        DESCRIPTION "Hugh has enchanted a long-hafted bearded axe as his talisman. He calls this Troll’s Wife, in deference to a Northern tradition to name an axe after a fearsome monster. Only the haft has been enchanted, allowing the blade to be unimpeded by Magic Resistance. The weapon is beautifully made: the head is made of steel with an iron edge, and inlaid silver depicts mythological scenes of heroes slaying dragons and giants. The haft is made of holly wood, perfectly sized to Hugh’s height and reach, and bound in bands of brass. It is carved with horses, eagles, and wolves. Near the axe head are six inlaid discs, three of amber and three of bloodstone. This weapon was made personally for Hugh at great expense, and is of excellent quality (see *City & Guild*, pages 69–70), granting a +3 to Attack and Defense rolls when using it. The weapon otherwise has the statistics of a pole axe.\n\nTroll’s Wife was opened with 12 pawns of vis (the highest cost component is the tiny semi-precious gems near the axe-head), and currently has no room left for further effects as Hugh has not chosen to increase its space just yet."
    }

}
