    # Marcus of Criamon (Chapter Nine: Marcus of Criamon, p79): 4 stat blocks, one DEF each, as printed at each age, its printed stat lines verbatim fields.

    #ta406a6d3a2c2510b9c0b64 ^"Marcus at Gauntlet" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Marcus of Criamon"
            ^"Role" STRING "Magus"
            ^"Characteristics" STRING "Int +3, Per +2, Pre 0, Com –1, Str +3, Sta +3, Dex –2, Qik –1"
            ^"Size" STRING "+2"
            ^"Age" STRING "24 (24)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Giant Blood, Major Magical Focus (organs); Affinity with Animal, Animal Ken, The Enigma, Improved Characteristics, Inventive Genius; Driven, Low Self-Esteem; Ability Block (Martial Abilities), Oversensitive (teasing), Poor Eyesight, Warped Magic House Virtue"
            ^"Personality Traits" STRING "Brave +3, Obsessed +3, Angry +2, Outgoing –2"
            ^"Reputations" STRING "none"
            ^"Combat" STRING "Dodge: Init –1, Attack n/a, Defense –1, Damage n/a"
            ^"Soak" STRING "+3"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Abilities" STRING "Animal Ken 1 (cattle), Artes Liberales 2 (logical traps), Athletics 1 (escape), Awareness 1 (ambushes), Chirurgy 2 (internal surgery), Cretan Lore 2 (ruins), Enigmatic Wisdom 1 (mazes), Finesse 1 (Animal), Greek 5 (Cretan), House Criamon Lore 1 (Corpus experts), Latin 4 (Hermetic), Magic Lore 1 (hybrid beasts), Magic Theory 4 (original research), Parma Magica 1 (Corpus), Penetration 1 (Animal), Stealth 1 (avoiding pursuers), Survival 2 (barren lands)"
            ^"Arts" STRING "Cr 8, In 0, Mu 8, Pe 0, Re 0; An 10, Aq 0, Au 0, Co 8, He 0, Ig 0, Im 0, Me 0, Te 0, Vi 0"
            ^"Twilight Scars" STRING "none"
            ^"Equipment" STRING "Peasant clothing"
            ^"Encumbrance" STRING "0 (0)"
            ^"Spells Known" STRING "True Rest of the Injured Brute (CrAn 20/+21) Beast of Outlandish Size (MuAn 15/+21) Growth of Creeping Things (MuAn 15/+21) Transformation of the Ravenous Beast to the Torpid Toad (MuAn 25/+21) Decay Fur and Hide (PeAn 10/+13) Bind Wound (CrCo 10/+19) Eyes of the Cat (MuCo(An) 5/+27 F) Arm of the Infant (MuCo 20/+27 F) F includes Magical Focus"
            ^"Appearance" STRING "Marcus is massive; eight feet tall and broad with it. He dresses in simple clothing and invariably hunches his shoulders in a futile attempt to hide his size. He has an olive complexion and black hair, and wears a beard (but no mustache) trimmed close to his jaw line."
            ^"Sigil" STRING "Marcus’ casting sigil is horns, normally in shadow or as a ghostly image. His voting sigil is a bronze bull’s head."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 79
        }
    }

