EXTENSION "ArM5_Magi_of_Hermes_MarisOfTytalus_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Eight: Maris of Tytalus spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tfdf23b5335d1102b847b7f ^"Securing the Harvest" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReAn 4 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "This ward prevents any mundane pest from entering and absconding with the food growing within the protective boundary of the circle. If Maris finds that the ward has been bypassed and the food tampered with, it is an indication that something far more interesting than vermin has been in the area.\n\n(Base 1, +1 Touch, +2 Ring)"
    }

    #tab3dac6f5c55003001292b ^"Sense the Tide’s Boundaries" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Sun, +2 Size)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InAq 25 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "As Eyes of the Bat, but senses the displacement of water to see in the ocean’s depths. Since this spell isn’t bound by the limitations of sight, it is often preferred when scouring the ocean depths where light does not reach.\n\n(Base 4, +1 Touch, +2 Sun, +2 Size)"
    }

    #t663defabb003d4f103ae15 ^"Captured by Höðr’s Shackles" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +1 Part, +1 Size)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReAq 20 R: Voice, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Instantaneously, a submerged target is imprisoned in a thick casing of ice. Due to ice’s natural buoyancy, Maris often uses this spell to float something of value to the surface. If used against an opponent, the ice suffocates an individual, as well as causing +3 damage per round from cold. Note that the spell does not create ice; it only works on targets already immersed in water.\n\n(Base 3, +2 Voice, +1 Part, +1 Size)"
    }

    #tb8515cefa061e1e81698a8 ^"Swallowed by the Mist" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, + 2 Voice, +1 Part, +2 Size)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReAq 20 R: Voice, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "This spell turns the targeted section of water to mist, causing swimmers and ships alike to plummet to the ground while the mist rises up, and then the sea crashes down around them. Successfully targeting this attack requires a Perception + Finesse roll against an Ease Factor of 9 (6 if the target is smaller than a rowboat, as there is more leeway in the transformed area). Observers of this spell will often just see a large cloud of mist rise around the target, and the ship will simply be gone.\n\n(Base 3, + 2 Voice, +1 Part, +2 Size)"
    }

    #t727628b0aacc583be432e5 ^"Grow the Bountiful Feast" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "CrHe 4 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "This spell ensures that all plants within the circle grow healthily, and produce a good crop. The plants still mature normally, but when it comes time to harvest, all will produce the maximum amount of crops, of the finest quality the plant can produce.\n\n(Base 1, +1 Touch, +2 Ring)"
    }

    #t7565d8269b44073f08cbb2 ^"Plant the Bountiful Feast" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Group, +1 Size, *ritual*)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrHe 20 R: Touch, D: Mom, T: Group, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "This ritual creates a number of edible or food-producing plants. The plants appear fully mature, but still need time to produce a crop. Maris’ version of this spell produces Irish moss.\n\n(Base 1, +1 Touch, +2 Group, +1 Size, *ritual*)"
    }

    #t8111367a3584dd3cc6e995 ^"Repel Winter’s Clutches" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Conc)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrIg 5 R: Touch, D Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Rapidly warms the target with an internal heat. This can be used to quickly defrost an object, or, if applied quickly enough, to save an individual from freezing to death. When using this spell in conjunction with treating hypothermia, the Medicine roll receives a bonus of +5.\n\n(Base 3, +1 Touch, +1 Conc)"
    }

    #t6f7ac5149d88425288352f ^"Form the Hermetic Boundary" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +3 Moon, +2 Size)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrTe 25 R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Forms a large, stone circle where cast. The circle, which is nine paces across, rises out of the ground to produce a level, stone surface that is a foot high, and several inches thick. Maris likes to use this spell as a base to set up underwater gardens, which are an invaluable source of food.\n\n(Base 3, +1 Touch, +3 Moon, +2 Size)"
    }

}
