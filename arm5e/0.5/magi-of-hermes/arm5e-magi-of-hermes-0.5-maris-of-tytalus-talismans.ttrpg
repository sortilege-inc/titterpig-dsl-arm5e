EXTENSION "ArM5_Magi_of_Hermes_MarisOfTytalus_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Eight: Maris of Tytalus talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #tad6418a7978a8a0c72e97d ^"Paregro Mare" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Paregro Mare"
            ^"Owner" STRING "Maris of Tytalus"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        TABLE {
            "+4" "Affect Currents" "" "Attunements"
            "+4" "Affect Dead Wood" "" "Attunements"
            "+4" "Aquam" "" "Attunements"
            "+4" "Banish Weather Phenomenon" "" "Attunements"
            "+4" "Create/Control Winds" "" "Attunements"
            "+7" "Protection from Storms" "" "Attunements"
        }
        DESCRIPTION "Built by Maris’ own hand, the *Paregro Mare’s* design is based on an amalgam of the Knarr-type long ship, and the later Buss-type vessel. The ship itself is oar-less, foregoing the shallow draft in favor of a lower deck, like the Buss. Supporting only a single mast with one sail, the *Paregro Mare* has room for about 30 tons of cargo and can reach up to 10 knots under favorable conditions. It holds a cramped sanctum below deck, and Maris has practically lived on this vessel ever since leaving the Novgorod Tribunal. Enchanted as his talisman soon after its completion, the *Paregro Mare* has had several effects instilled within it, as well as having had several enchanted devices attached to it that allow it to be sailed by Maris alone, and to withstand the worst man or nature can throw at it."
    }

}
