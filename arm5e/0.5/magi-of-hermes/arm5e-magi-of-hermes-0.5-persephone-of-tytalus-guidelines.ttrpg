EXTENSION "ArM5_Magi_of_Hermes_PersephoneOfTytalus_Guidelines" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Ten: Persephone of Tytalus guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tbe600cf45195da055bbd23 ^"Rego Terram Guidelines (Magi of Hermes, New Guideline: ReTe 4)" DEF {
        EXTENDS #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Printed Name" STRING "New Guideline: ReTe 4"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        GUIDELINES {
            "Level 4" "Transport a target instantly up to five paces. Add one magnitude for 50 paces, two magnitudes for 500 paces, three magnitudes for one league, four magnitudes for seven leagues, and five magnitudes for a place to which you have an Arcane Connection."
        }
    }

}
