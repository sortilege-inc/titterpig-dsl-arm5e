EXTENSION "ArM5_Magi_of_Hermes_PersephoneOfTytalus_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Ten: Persephone of Tytalus talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t7f6cb1ea90b79c458131c2 ^"Amor Sororis" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Amor Sororis"
            ^"Owner" STRING "Persephone of Tytalus"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 95
        }
        TABLE {
            "+4" "transform self" "" "Attunements"
            "+4" "protect self" "" "Attunements"
            "+4" "nobility" "" "Attunements"
        }
        DESCRIPTION "Persephone’s talisman is a simple gold ring. Wound around the unadorned band are seven strands of her sister Kore’s hair, which are a fixed Arcane Connection. Kore possesses an identical ring with seven strands of Persephone’s hair, but the enchantments in this ring are very different (see Fides Sororis earlier). The ring was prepared for enchantment with 10 pawns of vis, and currently has one pawns’ worth of space left.\n\nPersephone has instilled three effects into her talisman so far, as listed below."
    }

}
