EXTENSION "ArM5_Magi_of_Hermes_PetalichusOfVerditius_ItemsOfQuality" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Eleven: Petalichus of Verditus items of quality"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's items of quality, structured; each DESCRIPTION the source's text, verbatim.

    #t816f314bda988a86988022 ^"Battle Standard" DEF {
        EXTENDS #tc5d94e298a42b8096c879d ^"Item of Quality"
        PROPERTIES {
            ^"Bonus" INTEGER 2
            ^"Bonus To" STRING "Leadership"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This standard was crafted for a wealthy Byzantine noble and grants a +2 bonus to Leadership when used on the battlefield. Interestingly, while the standard has been designed for the specific noble, if the standard is ever captured in battle, the capturing side benefits from the Leadership bonus."
    }

    #t13d1d2857fa090cde0746a ^"Cloth Shears" DEF {
        EXTENDS #tc5d94e298a42b8096c879d ^"Item of Quality"
        PROPERTIES {
            ^"Bonus" INTEGER 2
            ^"Bonus To" STRING "rolls to create or mend clothing"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Petalichus brought the inherent quality of these fine steel shears out to assist him with his more mundane work. The shears grant a +2 bonus to rolls to create or mend clothing. But he took the process further and enchanted the shears with Rego Craft Magic (see below) and found that the quality also aided the spell. The shears grant the same bonus to Finesse rolls (when making or mending clothes) called for when using the enchantment (see below)."
    }

    #t52ad1868a71cea4714cb28 ^"Cuirass of Steel" DEF {
        EXTENDS #tc5d94e298a42b8096c879d ^"Item of Quality"
        PROPERTIES {
            ^"Bonus" INTEGER 4
            ^"Bonus To" STRING "Soak"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Despite its name, this cuirass is leather, not steel. Petalichus brought out the natural protective quality of armor to give this elegant embossed leather cuirass a +4 Soak bonus (the maximum Petalichus could achieve at that time). The armor retained its relative lightness while becoming as hard as steel. He granted the cuirass to his shield grog, Adrastos, in return for his long service and loyalty. This partial leather scale gives protection of 7 and a load of 3."
    }

    #t5a1bede5c07106d662bb21 ^"Loom" DEF {
        EXTENDS #tc5d94e298a42b8096c879d ^"Item of Quality"
        PROPERTIES {
            ^"Bonus" INTEGER 4
            ^"Bonus To" STRING "weave cloth"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Petalichus has brought out his loom’s intrinsic quality to work cloth. As a loom has a very specialized use, it benefits from a +4 shape and material bonus to weave cloth (Petalichus could instead have brought out a +2 shape and material bonus with Imaginem). This bonus applies to all mundane weaving work done on the loom. He also spent a season investing the loom with the *Day’s Worth of Weaving* spell effect (see above) with two uses per day. The Finesse rolls required by this effect also benefit from the +4 bonus."
    }

}
