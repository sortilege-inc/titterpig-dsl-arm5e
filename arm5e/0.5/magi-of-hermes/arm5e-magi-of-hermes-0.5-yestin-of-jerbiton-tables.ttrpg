EXTENSION "ArM5_Magi_of_Hermes_YestinOfJerbiton_Tables" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fifteen: Yestin of Jerbiton tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ArM5_Magi_of_Hermes_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tdaeefef25d6c630c12e97a ^"Mend Thy Broken Strings (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Task", "Complexity", "Finesse Roll"]
            ^"Printed Name" STRING "Mend Thy Broken Strings"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 139
        }
        TABLE {
            "Clean instrument" "Trivial" "3+"
            "Re-tune a crwth" "Simple" "6+"
            "Re-string a fiddle" "Easy" "9+"
            "Straighten a bow" "Average" "12+"
            "Re-glue a frame" "Hard" "15+"
        }
    }

    #tbe37279e7020f872f6cff5 ^"Let This Fire Sing You to Sleep (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Size of Fire", "Equivalent Sound"]
            ^"Printed Name" STRING "Let This Fire Sing You to Sleep"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 139
        }
        TABLE {
            "A candle flame" "A whisper"
            "A burning torch" "A conversation"
            "A campfire" "A song or heated discussion"
        }
    }

}
