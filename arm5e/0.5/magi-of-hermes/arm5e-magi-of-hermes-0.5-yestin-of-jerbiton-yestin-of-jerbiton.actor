    #tb31838a0599ca069aab46a ^"Yestin at Gauntlet" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Yestin of Jerbiton"
