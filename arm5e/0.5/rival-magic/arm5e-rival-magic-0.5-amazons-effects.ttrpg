            ^"Printed Stat Line" STRING "Level 45 R: Sister, D: Month, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 39
        }
        DESCRIPTION ", Rite Req: Kardia This rite instantly heals a Medium wound.\n\n(Base 15, + 2 Sister, +4 Month)"
    }

    #t2823fd538a3d5a6ab7453a ^"Summon the Slain Sister" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Zoi"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This incantation summons an Amazon spirit of Might 5 or less. The spirit must have had a Cousin relationship with the caster prior to its demise, and must have previously been summoned by the caster. The spirit remains for the duration of the incantation.\n\n(Base 5)"
    }

    #ta4398102102de9e4940105 ^"Contact the Fallen Amazon" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Zoi"
            ^"Level" INTEGER 15
            ^"Range" STRING "Unseen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +2 Unseen Stranger)"
            ^"Printed Stat Line" STRING "Level 15 R: Unseen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This incantation summons an Amazon spirit of Might 5 or less for the first time. Later spells do not need to have this\n\nRange to summon this spirit again, and can use a Range based on the relationship between the caster and the spirit while it was living.\n\n(Base 5, +2 Unseen Stranger)"
    }

    #t7fec9af5771171b66c3021 ^"The Presence of a Meddling Sorceress" DEF {
