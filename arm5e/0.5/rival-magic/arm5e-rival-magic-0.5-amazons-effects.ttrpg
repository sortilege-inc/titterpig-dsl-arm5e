EXTENSION "ArM5_Rival_Magic_Amazons_Effects" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Two: Amazons effects"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Rival_Magic_Core_Ext"

    # The chapter's effects, structured; each DESCRIPTION the source's text, verbatim.

    #tadfd8ed89f48cdd524c7e0 ^"The Aid of Goitosyros" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Api"
            ^"Level" INTEGER 4
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +1 Seen Stranger, +1 Size)"
            ^"Printed Stat Line" STRING "Level 4 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "This incantation brightens the illumination of sunlight in an volume of 1000 cubic paces (base Individual plus one). Anyone standing in the designated volume finds it difficult to see, as if he was staring into the rising sun. Perception rolls suffer a –3 penalty. Sunlight has to be present for this incantation to work. Goitosyros is a Scythian name for Apollo.\n\n(Base 2, +1 Seen Stranger, +1 Size)"
    }

    #t37f0ff0041d060d4296dcb ^"The Mouth of Hades" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Api"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "This incantation rips open the earth under a targeted person’s feet, plunging him into a ten-cubic-pace hole.\n\n(Base 5)"
    }

    #t14da85cbb9dc15af98b108 ^"Summon the Guardian of the Land Bridge" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Api"
            ^"Level" INTEGER 25
            ^"Range" STRING "Unseen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, + 2 Unseen Stranger)"
            ^"Printed Stat Line" STRING "Level 25 R: Unseen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "This incantation summons a particular Might 15 elemental, one that has lived in Amazonia for centuries. One of its powers is to force an area of land underneath water to rise to the surface, effectively creating a bridge. Since Amazons are not sailors, a sorceress traditionally casts this spell whenever a raiding party leaves or enters Amazonia.\n\n(Base 15, + 2 Unseen Stranger)"
    }

    #t1486fcd6aac925239838ee ^"The Fortress Unmade" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Api"
            ^"Level" INTEGER 30
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +4 size, +1 stone)"
            ^"Printed Stat Line" STRING "Level 30 R: Cousin, D: Hour, T: Ind (1 Plethron)"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "The earth is rent asunder, causing a single tower or stone manor house to crumble to the ground. The rubble continues to shake until the incantation ends.\n\n(Base 5, +4 size, +1 stone)"
    }

    #t29a4d2a2e21b944044c283 ^"Find our Enemies" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Api"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, + 2 Size)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation lets a sorceress know where her enemies are. She casts the incantation at a target with an area of 1,000 feet square (Size +2), then looks at the ground at her feet, which acts as a medium for her view. The ground before her vibrates according to the number of people walking on the area of targeted ground, indicating the general number of people, with no other details. Since this spell targets a section of earth, it does not need to penetrate the Magic Resistance of any creature walking on the targeted area.\n\n(Base 3, + 2 Size)"
    }

    #t8d4a1a5a3ebce68fef0e17 ^"Sense the Potent Fodder" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Api"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation indicates if an item contains raw vis.\n\n(Base 5)"
    }

    #t8bd4d098060051582458e6 ^"Surveying the Distant Realm" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Api"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This spell indicates the presence of a supernatural aura: Divine, Magic, Faerie, or Infernal. The aura must touch the ground, which most do. The incantation does not indicate what type of supernatural aura exists or its strength.\n\n(Base 5)"
    }

    #td1a5ca8057d8dadee5b5fd ^"Command the Guardian of the Land Bridge" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Api"
            ^"Level" INTEGER 20
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, Seen Stranger +1)"
            ^"Printed Stat Line" STRING "Level 20 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation commands the elemental summoned by the incantation *Summon the Guardian of the Land Bridge*, to build a bridge between Amazonia and the shore. The elemental’s power does not create a permanent bridge. It takes the elemental two to three hours to make the bridge.\n\n(Base 15, Seen Stranger +1)"
    }

    #t75a4c888b4d2189dde2f04 ^"Rob Them of Goitosyros’ Gift" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Api"
            ^"Level" INTEGER 5
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Seen Stranger, +1 Size)"
            ^"Printed Stat Line" STRING "Level 5 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation targets an area 10 paces wide, 10 paces deep, and 10 paces high and plunges it into darkness. It is extremely useful for daylight battles, hindering the enemy when they are suddenly overwhelmed by darkness.\n\n(Base 3, +1 Seen Stranger, +1 Size)"
    }

    #t53e813a70276c43f8d2975 ^"The Moat’s Mortal End" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Api"
            ^"Level" INTEGER 10
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Size increase)"
            ^"Printed Stat Line" STRING "Level 10 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation pushes closed a moat,\n\nallowing passage for besieging armies. The water previously in the moat is forced out by the moving earth or stone, and goes wherever it would naturally considering the new terrain. If the moat is fed by another body of water, the area surrounding the castle becomes a mire. Water is not a necessity for the spell to work, as the incantation targets the moat, not its contents.\n\n(Base 5, +1 Size increase)"
    }

    #te92762be02d8fe8b8bb4c0 ^"The Hut Made Safe" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Api"
            ^"Level" INTEGER 30
            ^"Range" STRING "Unseen Stranger"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +2 Unseen Stranger, +1 Day, + 1 Size)"
            ^"Printed Stat Line" STRING "Level 30 R: Unseen Stranger, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This incantation protects an area of 100 square feet from supernatural creatures of Might 10 or less, who cannot enter the area or affect it with their powers. Like wards from other magical traditions, this incantation has to penetrate to be effective.\n\n(Base 10, +2 Unseen Stranger, +1 Day, + 1 Size)"
    }

    #t07a73450362b9480026050 ^"Athena’s Breath" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Kardia"
            ^"Level" INTEGER 10
            ^"Range" STRING "Sister"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10)"
            ^"Printed Stat Line" STRING "Level 10 R: Sister, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This incantation “heals” a lost shortterm Fatigue Level. This low-level incantation allows the sorceress’ shield-sisters to exert in every round of combat. If a target receives five or more of this incantation, she will fall unconscious once the magic eventually ends. Fatigue is recovered normally once the target awakens.\n\n(Base 10)"
    }

    #t0d1d636b76570c9fe60222 ^"The Invalid’s Call to Arms" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Kardia"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sister"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, + 2 for additional bonuses)"
            ^"Printed Stat Line" STRING "Level 15 R: Sister, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This incantation cancels the penalties incurred from suffering a disease that acts as a Medium Wound. It does not combat the disease itself, providing the target temporary relief only.\n\n(Base 5, + 2 for additional bonuses)"
    }

    #t1ca91fe8ca10f347dcd6be ^"Recalling her Ancestors" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Kardia"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sister"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15)"
            ^"Printed Stat Line" STRING "Level 15 R: Sister, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This incantation gives the recipient an Angry Personality Trait of +2. It is commonly cast on shield-sisters before a battle, especially one in which prisoners are not desired.\n\n(Base 15)"
    }

    #t612e4346ba1c6bf281e115 ^"Sense the Stench of Sickness" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Kardia"
            ^"Level" INTEGER 25
            ^"Range" STRING "Unseen Stranger"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, + 3 Unseen Stranger)"
            ^"Printed Stat Line" STRING "Level 25 R: Unseen Stranger, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "This incantation will tell a sorceress if a person is possessed by a disease spirit up to Might 10 and the nature of that spirit. Since the disease spirit is unknown to the caster, the Range must be increased to Unseen Stranger. The incantation must penetrate the disease spirit’s Magic Resistance to work.\n\n(Base 10, + 3 Unseen Stranger)"
    }

    #t65884eef1f10df0f8540ee ^"The Faulty Strike" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Kardia"
            ^"Level" INTEGER 15
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +2 Seen Stranger)"
            ^"Printed Stat Line" STRING "Level 15 R: Seen Stranger, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "This incantation makes the target lose one short-term Fatigue level.\n\n(Base 5, +2 Seen Stranger)"
    }

    #taed8f90be39a61b3f10760 ^"Fear Our Wrath" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Kardia"
            ^"Level" INTEGER 20
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10, +2 Seen Stranger)"
            ^"Printed Stat Line" STRING "Level 20 R: Seen Stranger, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "This incantation lowers a target’s Brave Personality Trait by 2 points.\n\n(Base 10, +2 Seen Stranger)"
    }

    #t4aec4c9deac3ea25955c7a ^"Mire the Fleeing Army" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Nux"
            ^"Level" INTEGER 4
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hours"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4)"
            ^"Printed Stat Line" STRING "Level 4 R: Seen Stranger, D: Hours, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "This incantation creates a severe rainstorm that gathers quickly and rains for the duration of the incantation. After a few minutes, the rain turns the ground to mud.\n\n(Base 4)"
    }

    #t41309193a6fdb5f86bc15a ^"Mask Argimpasa’s Warriors" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Nux"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hours"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Cousin)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hours, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "This incantation forces a fog to generate around a single individual. The fog covers her and follows her wherever she goes, closely adhering to her. Others can see the fog but not the person hidden within. Argimpasa, the Amazon name for Aphrodite, often masked her son the Trojan hero Aeneas with such a spell.\n\n(Base 4, +1 Cousin)"
    }

    #t3afe3f9ad105baf959230f ^"Clipping the Sacrifice’s Wings" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Nux"
            ^"Level" INTEGER 10
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hours"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10)"
            ^"Printed Stat Line" STRING "Level 10 R: Seen Stranger, D: Hours, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "This incantation breaks a bird’s wing, preventing it from flying away and escaping.\n\n(Base 10)"
    }

    #t43a4d60fa558f1ec176262 ^"The Wrath of the Sky-God" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Nux"
            ^"Level" INTEGER 20
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hours"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 20)"
            ^"Printed Stat Line" STRING "Level 20 R: Seen Stranger, D: Hours, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "This incantation creates a thunderstorm. Every other round a lightning bolt may be called to strike a target, for the duration of the storm. To change targets, the sorceress must make a new casting roll, which acts as her aiming roll. Additional casting rolls have no effect on the spell except for aiming the bolts of lightning.\n\n(Base 20)"
    }

    #tcda1445b3f4ec1216c67fe ^"Foresee the Oncoming Storm" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Nux"
            ^"Level" INTEGER 3
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3)"
            ^"Printed Stat Line" STRING "Level 3 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 37
        }
        DESCRIPTION "This incantation allows the sorceress to know if a storm is developing. More accurate information is revealed towards the end of the incantation.\n\n(Base 3)"
    }

    #t19c0a436c106c9c373e66a ^"Sense the Potential of the Sky Sacrifice" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Nux"
            ^"Level" INTEGER 5
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 37
        }
        DESCRIPTION "This incantation allows the sorceress to know whether a targeted bird has a Might score, although it will not indicate how high its Might score is.\n\n(Base 5)"
    }

    #t8a8a972798ddf529e4b21e ^"Weigh the Sky Sacrifice" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Nux"
            ^"Level" INTEGER 10
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10)"
            ^"Printed Stat Line" STRING "Level 10 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 37
        }
        DESCRIPTION "This incantation gives the sorceress knowledge of the Might score of a targeted magical bird.\n\n(Base 10)"
    }

    #tb86c341a698592882b5847 ^"Cleansing the Sky’s Face" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Nux"
            ^"Level" INTEGER 20
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Day"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Day, +2 Size)"
            ^"Printed Stat Line" STRING "Level 20 R: Cousin, D: Day, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 37
        }
        DESCRIPTION "This incantation clears 10,000 cubic paces of sky of any weather conditions. For the duration of the spell, weather phenomenon cannot form in the targeted area, which is generally large enough to grant a large building clear weather.\n\n(Base 5, +1 Day, +2 Size)"
    }

    #t4a29276a3f38efa84560ea ^"Hestria’s Guidance" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Alala Soma"
            ^"Level" INTEGER 5
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +1 Cousin, +2 Hour)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This incantation grants a +3 recovery roll bonus to a woman in childbirth. Depending on the sorceress’ Amazon Chant score, this incantation’s Duration may be long enough to cover the whole of the lengthy birth process. Hestria is the goddess of the hearth, and one of the Amazons’ most important deities.\n\n(Base 2, +1 Cousin, +2 Hour)"
    }

    #t43b5cbdfd717e22823ef94 ^"The Blade of Menhit" DEF {
