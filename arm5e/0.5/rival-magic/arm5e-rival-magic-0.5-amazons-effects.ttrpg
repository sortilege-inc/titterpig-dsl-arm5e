            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5)"
            ^"Printed Stat Line" STRING "Level 5 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "This incantation controls a summoned Amazon spirit of Might 5 or less. While the incantation lasts, the spirit will perform tasks assigned to it by the caster, to the best of its ability.\n\n(Base 5)"
    }

    #td681a5d0683216f3c6cdf3 ^"Measure the Thread of Life" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Zoi"
            ^"Level" INTEGER 10
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 10)"
            ^"Printed Stat Line" STRING "Level 10 R: Cousin, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 41
        }
        DESCRIPTION ", Rite Req: Kardia This rite measures the expected, natural life of a woman. Traditionally, it was cast on an important person’s daughter to foresee how long her life would last. The rite still does that, but does not take into account any accidental happenings that may transpire along the way. It is a less than useful rite, and is usually cast at the command of the queen on a selected daughter.\n\n(Base 10)"
    }

    #t38a7a95e81e850b55e32df ^"Spot the Taint of Bonisagus" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Zoi"
            ^"Level" INTEGER 10
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Seen Stranger)"
            ^"Printed Stat Line" STRING "Level 10 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "Developed by the Amazon sorceress Viea, this rite allows a sorceress to determine if a target is Gifted. It is not precise enough to distinguish between the Gift and Supernatural Virtues the target may possess.\n\n(Base 5, +1 Seen Stranger)"
    }

    #t0e3bea1290dce3fbd41438 ^"Persuade the Reluctant Mistress" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Zoi"
            ^"Level" INTEGER 30
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 20, + 2 Month)"
            ^"Printed Stat Line" STRING "Level 30 R: Cousin, D: Month, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "This incantation controls a summoned sorceress spirit of Might 20 or less and forces it to teach the caster. The Duration has been extended to cover the seasonal requirement of teaching, and the required summoning spell must also have its Duration increased.\n\n(Base 20, + 2 Month)"
    }

    #tb15569364000ace2d73c86 ^"Salting the Spirit’s Grave" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Zoi"
            ^"Level" INTEGER 10
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Seen Stranger)"
            ^"Printed Stat Line" STRING "Level 10 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "This incantation destroys 5 points of\n\na targeted spirit’s Might. The sorceress must be able to see the ghost to target it. This incantation is designed as a catch-all for foreign spirits who the sorceress has not summoned.\n\n(Base 5, +1 Seen Stranger)"
    }

    #t81c2eaad1cd38e4035883a ^"Gag the Sons of Bonisagus" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Zoi"
            ^"Level" INTEGER 20
            ^"Range" STRING "Seen Stranger"
            ^"Duration" STRING "Hour"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, + 1 Seen Stranger)"
            ^"Printed Stat Line" STRING "Level 20 R: Seen Stranger, D: Hour, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "Originally invented by the Amazon sorceress Viea, this incantation robs a Gifted target of his Gift, essentially depriving him of the ability to cast spells for the duration of the incantation. It also prevents a target with Supernatural Abilities from using them.\n\n(Base 15, + 1 Seen Stranger)"
    }

    #t1a8613b49d8e0575ba77b8 ^"Extend the Servant’s Service" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Zoi"
            ^"Level" INTEGER 35
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +2 additional magnitudes for additional bonuses, +2 Personal, +2 Month)"
            ^"Printed Stat Line" STRING "Level 35 R: Personal, D: Month, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 42
        }
        DESCRIPTION ", Rite Req: Soma This rite allows the target to add a +3 bonus to her Aging rolls. This rite remains in effect until the recipient suffers an Aging Crisis, at which point the spell fails.\n\n(Base 5, +2 additional magnitudes for additional bonuses, +2 Personal, +2 Month)"
    }

}
