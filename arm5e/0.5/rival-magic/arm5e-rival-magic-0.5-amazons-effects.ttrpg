            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This incantation blinds a giant of Size +3. Similar incantations exist for giants of different sizes.\n\n(Base 20, +1 Size modifier)"
    }

    #t14438bac0958b6d763abce ^"The Discerning Eye (Rival Magic)" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Printed Name" STRING "The Discerning Eye"
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Soma"
            ^"Level" INTEGER 5
            ^"Range" STRING "Sister"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, + 2 Sister)"
            ^"Printed Stat Line" STRING "Level 5 R: Sister, D: Momentary, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This spell grants immediate knowledge of the target’s physical health, instantly informing the caster of the severity of the target’s wounds.\n\n(Base 3, + 2 Sister)"
    }

    #ta9db7b57dcedc21fe6c8f7 ^"The Distant Eye" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Ma’at Soma"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sister"
            ^"Duration" STRING "Exchange"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, + 2 Sister, +1 Exchange)"
            ^"Printed Stat Line" STRING "Level 20 R: Sister, D: Exchange, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This incantation allows the caster to view a target with whom she has a personal relationship, no matter how distant the target is physically from the caster. The caster must use some medium for the image to appear: a bowl of water, a plate of sand, or a pile of ashes, for example. The image shifts according to what the target does, allowing a sorceress to watch a companion while she is in battle.\n\n(Base 5, + 2 Sister, +1 Exchange)"
    }

    #t359c996a788f809bcb9ff9 ^"The Iron Gag" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Soma"
            ^"Level" INTEGER 3
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Exchange"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Cousin, +1 Exchange)"
            ^"Printed Stat Line" STRING "Level 3 R: Cousin, D: Exchange, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This incantation forces a target’s mouth closed, which can be a great hindrance to antagonistic sorceresses (–10 on her casting rolls). A version of this spell designed for foreign spellcasters is only level 2, using the Soma base Range: Seen Stranger.\n\n(Base 1, +1 Cousin, +1 Exchange)"
    }

    #t9d2e4fbc3fcd58c6c34a26 ^"The Soothing Balm of Antiope" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Amazons"
            ^"Spell Type" STRING "Incantation"
            ^"Arts" STRING "Papaios Soma"
            ^"Level" INTEGER 20
            ^"Range" STRING "Cousin"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, + 1 Cousin, +4 Month)"
            ^"Printed Stat Line" STRING "Level 20 R: Cousin, D: Month, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This incantation grants a +3 recovery bonus to a wounded target. The incantation must last as long as the necessary length of the healing process. Legend has it that Antiope originally designed this spell for her husband, Theseus of Athens.\n\n(Base 2, + 1 Cousin, +4 Month)"
    }

    #t7b7b3a33518e1cc38682c8 ^"The Shield-Sister Made Whole" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
