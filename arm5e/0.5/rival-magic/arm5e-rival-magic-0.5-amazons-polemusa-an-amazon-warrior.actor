EXTENSION "ArM5_Rival_Magic_Amazons_PolemusaAnAmazonWarrior" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Polemusa, an Amazon Warrior"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Rival_Magic_Core_Ext"

    # Polemusa, an Amazon Warrior (Chapter Two: Amazons, p20): one character, its printed stat lines verbatim fields.

    #t1d8563be2d32156ead8252 ^"Polemusa, an Amazon Warrior" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Polemusa, an Amazon Warrior"
            ^"Role" STRING "Companion"
            ^"Characteristics" STRING "Int +1, Per 0, Pre 0, Com –1, Str +2, Sta +1, Dex +3, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "27 (Appearance: 27)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Amazon; Improved Characteristics, Self-Confident, Tough; Ability Block (other languages), Ambitious, Oversensitive"
            ^"Personality Traits" STRING "Ambitious +2, Brave +2, Insensitive +1"
            ^"Combat" STRING "Dodge: Init –1, Attack n/a, Defense +3, Damage n/a Fist: Init –1, Attack +7, Defense +4, Damage +2 Labrys and pelta: Init 0, Attack +13, Defense +8, Damage +8 Labrys and pelta, mounted: Init 0, Attack +16, Defense +11, Damage +8 Scythian bow: Init –2, Attack +11, Defense +5, Damage +8"
            ^"Soak" STRING "+8"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Athletics 3 (running), Amazon 5 (concise statements), Amazonian Lore 2 (Poliochni), Bow 4 (Scythian bow), Brawl 3 (fist), Caucasus Mountains Lore 3 (routes into Georgia), Chirurgy 2 (field dressings), Hunt 2 (tracking), Leadership 4 (in combat), Ride 3 (surprise attacks), Single Weapon 5 (labrys and pelta), Survival 3 (mountains), Swim 1 (at sea)"
            ^"Equipment" STRING "Amazonian armor, Scythian bow and quiver, labrys and pelta, horse"
            ^"Encumbrance" STRING "1 (3)"
            ^"Appearance" STRING "Polemusa is stocky and square-shouldered, and looks very rugged when dressed for war. Paradoxically, her facial features are extremely fine, with narrow lips and a slender nose."
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "Polemusa is an Amazon warrior, the general of a small raiding party. Raised in Amazonia, she has spent the last several years of her life away from home, raiding the mountain passes that interlace the Caucasus Mountains. Riding with a dozen other Amazons, she has raided as far west as Armenia and is just beginning to encroach upon Trebizond. Polemusa has not had great luck as the group’s general and has only returned to Amazonia twice, once with plunder and a second time to recruit new warriors after a defeat. She is quite sensitive about her lack of success and has challenged those who criticize her.\n\nHer raiding party has recently accepted an Amazon sorceress, and Polemusa has high hopes that the sorceress will increase their number of successful raids. However, she does not trust the woman and never leaves her unguarded or unwatched. Until the sorceress proves herself in battle, Polemusa remains aloof.\n\nIn combat, Polemusa can lead a group of warriors a trained group, serving as both the leader and the vanguard (see ArM5, page 173). She can lead a group of four warriors for an Attack or Defense bonus of +15 (counting her Leadership specialty). Her preferred method of attack is to split the raiding party into four groups, each with a leader, and attack at dawn just as a caravan is preparing for its day’s journey."
    }

}
