EXTENSION "ArM5_Rival_Magic_Amazons_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Two: Amazons virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Rival_Magic_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t15b96e6abc1b95f8598e74 ^"Amazon" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Free, Social Status"
            ^"Size" STRING "Free"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The character is an Amazon — a woman warrior of good standing within the community. The character may purchase Martial Abilities at character generation."
    }

    #te22582b00ef0cf3863ec95 ^"Martial Connection to Magic" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Supernatural"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The sorceress has a strong mental connection between her magic and her combat prowess. Every time she gains at least 2 experience points in a Martial Ability, through study or adventure, she also gains 1 experience point in Finesse. She cannot, through this Virtue, gain more than 1 experience point in Finesse per season, no matter how many experience points she puts into Martial Abilities, nor how many Martial Abilities she raises. She may, however, put adventure experience into both Martial Abilities and Finesse, and claim the bonus point. The reverse is also true, and improving Finesse by at least 2 experience points awards 1 experience point in any Martial Ability."
    }

    #t53d9bccc6bab00f5e358b8 ^"Strong Magic" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Supernatural"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The sorceress’ magic is stronger than her sisters and is more difficult to resist. Resistance Roll Ease Factors start at 9 instead of 6."
    }

    #t6fbfbf2383a767ff58d5f3 ^"Proven Raider" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, General"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The character has gone on several raids and has shown she is extremely capable. She has an additional 50 experience points to spend on Martial Abilities during character generation."
    }

    #t7472bcffb1dfa2dd25cfbe ^"Amazon Sorceress" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Free, Social Status"
            ^"Size" STRING "Free"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The character is an Amazon sorceress. She begins play with a constructed temple for her magical activities, situated somewhere outside of Amazonia. The site has a Magic aura of 1. She may learn any Ability available to Amazons, including Martial and Arcane Abilities, and must have The Gift."
    }

    #tfd356c8612aa7814897052 ^"Symbolic Understanding" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Supernatural"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress has a more symbolic understanding of Amazon Vowels, viewing them as the beginning, middle, and end of the day, a woman’s life, or a journey. Each time she raises one Vowel score through study, she receives 1 experience point in the other two Vowels."
    }

    #te8dbae51c981dfb5790682 ^"Amazonian Slave" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Social Status"
            ^"Size" STRING "Major"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The character is a male slave of the\n\nAmazons, having been either born in Amazonia or captured during a raid. If the character has an Amazon mother, he has spent his entire life in Amazonia and cannot take any Virtues that give access to Martial Abilities. If he was captured in a raid, he may have pre-existing weapon skills."
    }

    #t8f00bf9f3cc35bf0a0b746 ^"Beloved Slave" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Story"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Story"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The character is male with an Amazon mother who loves him enough to help him in his life as a slave. He may be one of the rare few who don’t live in the slave quarters, instead of being assigned as a personal attendant to another Amazon or even still living with his mother. While there are limits to her aid, his mother will do her best to make life easier for the character."
    }

    #tdafc0a3c50be21b83c65ed ^"Bitter Mistress" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Story"
            ^"Size" STRING "Major"
            ^"Category" STRING "Story"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress’ mistress loathes her former apprentice so much that she will do everything in her power to humiliate, debase, and obstruct the character. Since there are no customs to prevent violent interactions between Amazon sorceresses, this Flaw is worse than the Hermetic equivalent: Tormenting Master."
    }

    #tb459f93b6a974a5d4bbdc1 ^"Frail Magic" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Supernatural"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress’ magic is weaker than her sisters and is easier to resist. Resistance Roll Ease Factors start at 3 instead of 6."
    }

    #t3bc2a58766126be5fc2fb7 ^"Magic Aura Temple" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Story"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Story"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress character starts play with her temple located in a +3 Magic aura. Others will try to take this from her, either through political, social, or violent means."
    }

    #t3338a50d0575a4a94f9c45 ^"Friendly Mistress" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Story"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Story"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress’ mistress went to great efforts to be friendly to her apprentice, and the two had genuine affection for each other. To maintain this friendship, the character must continue to interact with her mistress, spending one season assisting in the mistress’ temple every other year. The elder sorceress is an ally and offers aid or resources if the relationship is maintained. Regardless of how often she sees the character, the mistress occasionally requests help."
    }

    #t3fbd8f8f3376c824f4ef82 ^"Prolonged Apprenticeship" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Major, Story"
            ^"Size" STRING "Major"
            ^"Category" STRING "Story"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The sorceress character is still considered an apprentice by her mistress, even though she has spent 15 years under her mistress’ care and received all the required training in the Amazon Arts. The mistress has not pronounced the character a sorceress, so she is still viewed by her contemporaries as an apprentice. No one will respect her, her temple, or her work until she removes herself from her mistress’ control."
    }

    #t585fdbb58fdb0d10d18e25 ^"Clumsy Magic (Amazon)" DEF {
        EXTENDS #tjE7udxVnIlTU0eS9IKAEB8m ^"Clumsy Magic"
        PROPERTIES {
            ^"Printed Name" STRING "Clumsy Magic"
            ^"Amazon Size" STRING "Major Flaw"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "This is a Major Flaw for Amazons, since every incantation needs to be aimed."
    }

    #td319365372217418185d30 ^"Harnessed Magic (Amazon)" DEF {
        EXTENDS #t76C5ZCBgXkVANLRSwuDuatg ^"Harnessed Magic"
        PROPERTIES {
            ^"Printed Name" STRING "Harnessed Magic"
            ^"Amazon Size" STRING "Major Virtue"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "This is a Major Virtue for Amazons, since Durations can be much longer for sorceresses than magi, and having the ability to end a lengthy duration is more of an advantage."
    }

    #tb62ad898e3f18e1383175f ^"Magical Animal Companion (Amazon)" DEF {
        EXTENDS #tunOUSrsoG5lGnrazDnMBeaA ^"Magical Animal Companion"
        PROPERTIES {
            ^"Printed Name" STRING "Magical Animal Companion"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "Since Amazons use magical animals to make rites permanent, the character must decide how this animal fits into play. Is it an animal waiting to be sacrificed? Or is it a real friend, who will draw the attention of every sorceress who knows about it?"
    }

    #t53b10e53b441d7c6a353a0 ^"Poor Incantation Magic" DEF {
        EXTENDS #t7gbC2lxBjrO62U3APBfUNE1 ^"Poor Formulaic Magic"
        PROPERTIES {
            ^"Amazon Size" STRING "Major Flaw"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "This adaptation of Poor Formulaic Magic is a Major Flaw for a sorceress."
    }

    #t0072245513ab777da14629 ^"Short-Lived Magic (Amazon)" DEF {
        EXTENDS #tEHuAmzw948whTRfumj0HJQT ^"Short-Lived Magic"
        PROPERTIES {
            ^"Printed Name" STRING "Short-Lived Magic"
            ^"Amazon Size" STRING "Major Flaw"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "This is a Major Flaw for Amazons, not a Minor Flaw. To determine how much shorter a spell is, roll a simple die. 1–3 subtract one from the sorceress’ Amazonian Chant score when calculating the spell’s duration, 4-–6 subtract 2, 7–9 subtract 3, and on a 10 decrease the Duration by one step. Spells will always last at least Momentary duration."
    }

    #t8b0d1f10075c77b951eefd ^"Skilled Mistress" DEF {
        EXTENDS #tG66iS8Gpk7XRZhZJjrVdd3H ^"Skilled Parens"
        PROPERTIES {
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The Amazon variant of Skilled Parens, this Virtue adds 60 extra experience points at character generation. It does not add more levels of spells at character generation."
    }

    #t6f092e09c8a9d4aba36954 ^"Unpredictable Magic (Amazon)" DEF {
        EXTENDS #tliGSwmXMplprZ1bs3TaxPrH ^"Unpredictable Magic"
        PROPERTIES {
            ^"Printed Name" STRING "Unpredictable Magic"
            ^"Amazon Size" STRING "Major Flaw"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The player must always roll a stress die both for casting an incantation and aiming it, making this a Major Flaw for a sorceress."
    }

}
