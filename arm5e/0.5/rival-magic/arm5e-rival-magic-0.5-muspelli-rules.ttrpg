            ^"Rules Section" STRING "Valgaldrar"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 102
        }
        FORMULAS {
            "Casting Total" "Communication + Valgaldrar + Aura modifier + stress die"
        }
    }

    #t561c0e3f454ad759e78bbb ^"Commanding Roll" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Valgaldrar"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 102
        }
        FORMULAS {
