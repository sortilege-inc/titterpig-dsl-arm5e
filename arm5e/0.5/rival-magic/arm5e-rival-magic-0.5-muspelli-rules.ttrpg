        }
        FORMULAS {
            "Casting Total" "Presence + Wildfire + Aura modifier + stress die"
        }
    }

    #t9105f550079dea4bd6c827 ^"Casting Total (Winter’s Breath)" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "Casting Total"
            ^"Rules Section" STRING "Winter’s Breath"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 105
        }
        FORMULAS {
            "Casting Total" "Stamina + Winter’s Breath + Aura Modifier + stress die"
        }
    }

    #tb175b670d8a3a4acb8a20b ^"Exposure Deprivation Total" DEF {
