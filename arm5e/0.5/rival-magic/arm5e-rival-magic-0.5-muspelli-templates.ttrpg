EXTENSION "ArM5_Rival_Magic_Muspelli_Templates" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Four: Muspelli templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Rival_Magic_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #t501995be6bbb01685a8039 TEMPLATE "A Valkyrie" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 0
            ^"Virtues and Flaws" STRING "3 x Increased Faerie Might, Faerie Sight, Faerie Speech, Humanoid Form, Personal Faerie Power; Incognizant, Visions Valkyries know where and when worthy men are likely to die."
            ^"Combat" STRING "Axe and Round Shield (unmounted): Init +2, Attack +16, Defense +12, Damage +6 Axe and Round Shield (mounted): Init +2, Attack+19, Defense +15, Damage +6 Wolf’s Teeth: Init –2, Attack +9, Defense +9, Damage +3"
            ^"Soak" INTEGER 9
            ^"Wound Penalties (Valkyrie)" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+)"
            ^"Wound Penalties (Wolf)" STRING "–1 (1-8), –3 (8-16), –5 (17–24), Incapacitated (25–32), Dead (33+)"
            ^"Pretenses" STRING "Awareness 9 (battlefields), Brawl 9 (einherjar), Ride 5 (wolf), Single Weapon 9 (giants)"
            ^"Powers" STRING "Fly: 0 points, constant, usually Corpus (2 intricacy points on cost)"
            ^"Equipment" STRING "Arms, armor, wolf mount, vast quantities of wine."
            ^"Vis" STRING "4 Corpus, in heart"
            ^"Appearance" STRING "Valkyries are shield maidens or crones who ride wolves above battlefields, and select the worthy dead. They have excellent equipment and extraordinary training. This one rides an immense wolf (Size +3) that is made from her glamour. The wolf can also attack in combat; its combat statistics are included with the valkyrie’s above. However, any wounds inflicted on the mount are counted separately from the valkyrie’s, and wound penalties are based on its greater size."
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 86
        }
        PERSONALITY_TRAITS {
            "Brave" +5
            "Judgmental" +3
        }
        DESCRIPTION "This valkyrie responds to failed Heipt roll by a Muspelli with a Warping Score of 4. Her abilities and powers should be adjusted appropriately for a weaker or stronger encounter. See *Realms of Power: Faerie* for more details on Faerie characters and powers."
    }

}
