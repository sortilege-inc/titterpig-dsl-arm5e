EXTENSION "ArM5_Rival_Magic_SorcerersOfSoqotra_Effects" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Five: Sorcerers of Soqotra effects"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Rival_Magic_Core_Ext"

    # The chapter's effects, structured; each DESCRIPTION the source's text, verbatim.

    #tc11400bac37d8746cd0aba ^"Closing Lacerations of the Skin" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 9 (Base 6 +3 Touch) / CrCo 15 (Base 10 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 9 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell is used to repair the superficial damage from cutting or stabbing weapons. It is also suited to repair injuries from many work accidents that involve accidental skewering on sharp objects. It does not heal Wounds, but makes the entire injury stable so that the character can continue to work without threat of the wound worsening. Similar spells exist to cure bruising and crushing injuries, injuries from fire, and poisoning.\n\nAloe Magic Level 9 (Base 6 +3 Touch) / CrCo 15 (Base 10 +5 Touch)"
    }

    #tc848af40fd3a41ebbff08e ^"Regrowth of the Lost Finger" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 9 (Base 6 +3 Touch) / CrCo 15 (Base 10 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 9 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell is used as a reward for good service. Characters often lose fingers due to work injuries, or in warfare. This spell causes them to regrow over a period of up to two days. The process is painful, so Soqotrans chew qat — an herb imported from Africa — to dull the pain.\n\nAloe Magic Level 9 (Base 6 +3 Touch) / CrCo 15 (Base 10 +5 Touch)"
    }

    #tec319898241da395f9e86d ^"Restoring the Injured Warrior" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 18
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 18 (Base 15 +3 Touch) / CrCo 30 (Base 25 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 18 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell completely cures a character of wounds, but the process is painful in proportion to the injuries the character has suffered. In many cases it is kinder to render the character unconscious before casting the spell, but mundane methods of distraction — like alcohol and blows to the head — are healed early in the process.\n\nAloe Magic Level 18 (Base 15 +3 Touch) / CrCo 30 (Base 25 +5 Touch)"
    }

    #t5a0f77d6a9eeeec08790ed ^"Repair the Tools of the Sorcerous Craft" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 21
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Incense"
            ^"Effect Design" STRING "Aloe Magic Level 21 (Base 21 –3 Incense +3 Touch) / CrAn(HeTe) 35 (Base 35 –5 Incense +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 21 R: Touch, D: Regrowth, T: Incense"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Versions of this spell are used to repair damaged sorcerous tools. This includes the knives and censers of the island’s sorcerers.\n\nAloe Magic Level 21 (Base 21 –3 Incense +3 Touch) / CrAn(HeTe) 35 (Base 35 –5 Incense +5 Touch)"
    }

    #t4b4044cf7d00ec8c9a5fb7 ^"Suitability For Burial" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 21
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 21 (Base 18, +3 Touch) / Cr(Mu)Co(An) 35 (Base 30 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 21 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell allows Aloe sorcerers to force a damaged corpse to repair itself, so that it is suitable for public burial by its kinfolk. Even the tiniest sliver of the missing person can be used to grow a satisfactory corpse, although that sliver must be placed in sufficient water, meat, and bone to be able to form this matter into a corpse. This spell also works perfectly well for characters wanting to fake their own deaths, or provide food for cannibalistic jinniyahs. Even fish can be used to make human corpses this way, because humans are, from a local perspective, made from meat.\n\nSpells similar to this can be used to reconstruct the corpses of animals before they are bought back to life with high-level Aloe magic. They can also be used to change one sort of meat into another, or “freshen” it. For example, the rotting corpse of a camel might be used to feed a piece of wool until it becomes the fresh carcass of a lamb.\n\nAloe Magic Level 21 (Base 18, +3 Touch) / Cr(Mu)Co(An) 35 (Base 30 +5 Touch)"
    }

    #t9fd60794af1db11e81c51b ^"The Fresh Minting of Swords" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 24
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 24 (Base 21, +3 Touch) / CrTe 40 (Base 35 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 24 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell allows a character to create useful weapons out of random and rusted bits of metal and wood, provided he already has one excellent sword. The magician chips pieces off the sword, and casts this spell on each one, being careful to ensure that each piece has sufficient metal to rebuild itself, and that the growing swords are not so close together that they simply merge.\n\nAloe Magic Level 24 (Base 21, +3 Touch) / CrTe 40 (Base 35 +5 Touch)"
    }

    #te5f94834fef267ac482163 ^"Repairing The Boat" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 30 (Base 18, +3 Touch, +9 Structure) / CrHe 50 (Base 30 +5 Touch, +15 Structure)"
            ^"Printed Stat Line" STRING "Aloe 30 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell allows the character to repair the hull or masts of a ship by laying plant matter on its deck, and then waiting for the craft to heal itself. Despite the name, it works perfectly well on any timber structure, so the roofs of houses and minor fortifications can also be repaired in this way.\n\nAloe Magic Level 30 (Base 18, +3 Touch, +9 Structure) / CrHe 50 (Base 30 +5 Touch, +15 Structure)"
    }

    #t2b9dc919514c58d38809d9 ^"Return to Vigor" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Aloe Magic"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Regrowth"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Aloe Magic Level 30, (Base level 27, +3 Touch) / CrCo 50 (Base 45 +5 Touch)"
            ^"Printed Stat Line" STRING "Aloe 30 R: Touch, D: Regrowth, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell removes the Impotence\n\nFlaw. Impotence is one of the side effects of chewing qat, a popular recreation among merchants on Soqotra.\n\nAloe Magic Level 30, (Base level 27, +3 Touch) / CrCo 50 (Base 45 +5 Touch)"
    }

    #t2af814b0832e217885e33e ^"The Continuance of Good Fortune" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Cinnabar Magic Level 9 (Base 3 +3 Touch +3 Censer) / ReVi(CoMe) 15 (Base 5 +5 Touch +5 Censer)"
            ^"Printed Stat Line" STRING "Cinnabar 9 R: Touch, D: Censer, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This spell allows a player to use the roll his character makes directly after the spell is cast in future rounds, until the duration of the spell expires. The player may choose not to continue to use the roll, which causes the spell to end.\n\nFor example, a character wishes to climb one of the cliffs in the mountains to explore a cave complex said to have been used as a retreat by the Egyptian priests in the island’s distant past. A sorcerer friendly to the character casts this spell, and the character immediately tries to climb a nearby wall. The player rolls an 8 on his Athletics Ability. While the spell remains in place, the player may instead of rolling Athletics, simply act as if he had rolled an 8. If the player had rolled a lower number, he could choose to disregard it and roll as normal when next climbing. This would cause the spell to end.\n\nCinnabar Magic Level 9 (Base 3 +3 Touch +3 Censer) / ReVi(CoMe) 15 (Base 5 +5 Touch +5 Censer)"
    }

    #t487ad52a7253e8d95ef20e ^"The Maintenance of Bravery" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Cinnabar Magic Level 9 (Base 3 +3 Touch +3 Censer) / ReMe15 (ReMe 5 +5 Touch +5 Censer)"
            ^"Printed Stat Line" STRING "Cinnabar 9 R: Touch, D: Censer, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "The target makes a Brave check, then this spell is cast. This permits the character to use to use that score in lieu of any further Brave check until the spell expires. If the Brave check was poor, the player may ignore it and roll at the next check, but this ends the spell. It is common for this spell to be cast after a stirring speech is made, to force the Brave check.\n\nCinnabar Magic Level 9 (Base 3 +3 Touch +3 Censer) / ReMe15 (ReMe 5 +5 Touch +5 Censer)"
    }

    #tfff51c2626f64f220ae218 ^"The Continuance of Ill Fortune" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Cinnabar Magic Level 15 (Base 3 +9 Sight +3 Censer) / ReVi (CoMe) 25 (Base 5 +15 Sight +5 Censer)"
            ^"Printed Stat Line" STRING "Cinnabar 15 R: Sight, D: Censer, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This spell causes the character to continue to suffer a negative modifier on a dice roll, even if the cause of that modifier is removed.\n\nFor example, a wizard wants to be able to sneak past a sentry later in the day. He waits until the morning fog, and casts this spell on the sentry. The sentry has a –3 modifier on Awareness rolls, as if there were a fog regardless of the actual weather, until the spell ends. The spell ends if the sentry ceases to watch, for example to eat his lunch, because it only affects continuous activities.\n\nCinnabar Magic Level 15 (Base 3 +9 Sight +3 Censer) / ReVi (CoMe) 25 (Base 5 +15 Sight +5 Censer)"
    }

    #t9404bf662b77978a50391a ^"Preservation of the Harvest" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Effect Design" STRING "Cinnabar Magic Level 9 (Base 0 +3 Touch, +6 Ring, +0 Circle) / ReAn 15 (Base 0, +5 Touch +10 Ring)"
            ^"Printed Stat Line" STRING "Cinnabar 9 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This spell prevents all of the food within a circle from being attacked by rodents. It does this by giving the grain a Soak score of 3 against rodent attacks. This means that the occasional, incredibly lucky, mouse will still be able to steal a mouthful of grain.\n\nCinnabar Magic Level 9 (Base 0 +3 Touch, +6 Ring, +0 Circle) / ReAn 15 (Base 0, +5 Touch +10 Ring)"
    }

    #t25584c342a7ebd2f672b04 ^"Safety In the Burning Nest" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 12
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Cinnabar Magic Level 12 (Base 6, +6 Sun) / MuCo 20 (Base 10, +10 Sun)"
            ^"Printed Stat Line" STRING "Cinnabar 12 R: Personal, D:Sun, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This spell increases the sorcerer’s resistance to injury from fire, by increasing the character’s Soak against heat sources by +9. It is particularly useful in shipboard combat.\n\nCinnabar Magic Level 12 (Base 6, +6 Sun) / MuCo 20 (Base 10, +10 Sun)"
    }

    #t548fdab95450b12c358bfd ^"Unfair Naval Dueling" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Cinnabar Magic"
            ^"Level" INTEGER 21
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "Cinnabar Magic Level 21 (Base 9, +3 Touch, +6 Group, +3 Censer) / MuCo 35 (Base 15 +5 Touch +10 Group)"
            ^"Printed Stat Line" STRING "Cinnabar 21 R: Touch, D: Censer, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This spell, used for the defense of the island and to aid piracy, makes the crew of a vessel all but immune to arrows (Soak +12). This allows a friendly crew to attack an enemy warship successfully, by remaining at bow range and peppering the rival crew when they attempt to work their ship. The Red Sea is notoriously difficult to navigate, so with sufficient patience and the steady elimination of anyone who tries to steer his ship clear of obstacles, the enemy ship can be driven onto rocks. As an alternative, after this spell has been used to soften the victim, the rival ship can be boarded and seized.\n\nCinnabar Magic Level 21 (Base 9, +3 Touch, +6 Group, +3 Censer) / MuCo 35 (Base 15 +5 Touch +10 Group)"
    }

    #t571368fa8b8d6a4106da22 ^"Eyesight of the Ancient Hero" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Myrrh Magic"
            ^"Level" INTEGER 6
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Myrrh Magic Level 6 (Base 3, +3 Diameter) / MuCo 10 (Base 5 +5 Diameter)"
            ^"Printed Stat Line" STRING "Myrrh 6 R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell grants the Keen Vision Virtue, which allows +3 on rolls involving eyesight. This is a facet of the Awareness ability.\n\nMyrrh Magic Level 6 (Base 3, +3 Diameter) / MuCo 10 (Base 5 +5 Diameter)"
    }

    #tcabacd8c608d0076df33dd ^"Enormity of the Ancient Hero" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Myrrh Magic"
            ^"Level" INTEGER 9
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "Myrrh Magic Level 9 (Base 3, +3 Touch, +3 Censer) / MuCo 15 (Base 5 +5 Touch +5 Censer)"
            ^"Printed Stat Line" STRING "Myrrh 9 R: Touch, D: Censer, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell grants the Large virtue, and adjusts the character’s wound ranges to suit.\n\nMyrrh Magic Level 9 (Base 3, +3 Touch, +3 Censer) / MuCo 15 (Base 5 +5 Touch +5 Censer)"
    }

    #t42669aa0a6b53b74daa9f2 ^"The Motion of the Sprite" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Myrrh Magic"
            ^"Level" INTEGER 12
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "Myrrh 12 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell grants the Lesser Faerie Power Virtue, and the Faerie Power Flight (as described in *Realms of Power: Faerie,* pages 54 and 62).\n\nMyrrh Magic 12 (Base 3 +3 Touch, +6 Sun) / MuCo(Vi) 20 (Base 5 +5 Touch +10 Sun)"
    }

    #t5d675cd24cbb67b2ee9069 ^"Harvesting Knife" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 3
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Incense"
            ^"Printed Stat Line" STRING "Olibanum 3 R: Touch, D: Concentration, T: Incense"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell controls the harvesting knife used by the Olibanum magician, allowing it to levitate and perform simple tasks. It may be used to attack a foe, but this requires an Attack roll using Finesse instead of the character’s combat Abilities. This is generally the first spell taught to young Olibanum magicians, as it aids them when practicing Finesse and Concentration. Older wizards often have more complicated versions of this spell, or other spells that affect their knives, to take advantage of the relative ease of spells targeted on olibanum harvesting equipment.\n\nOlibanum Magic 3 (Base 0, Touch +3, Concentration +3, Incense –3) / ReTe(An) 5 (Base 0, +5 Touch, +5 Concentration –5 Incense)"
    }

    #teb442628c298a517f1f60d ^"Theft of Essences" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 6
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Incense"
            ^"Printed Stat Line" STRING "Olibanum 6 R: Sight, D: Momentary, T: Incense"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell attempts to steal an opponent’s incense. This spell is used to grab and throw the essences that a rival magician is using to cast his spells. It is ineffective if the essences are tightly held or enclosed in something that is secured, like a bag, so its practical use is rare. It is, however, known by virtually every Olibanum sorcerer, and they take childish delight in its successful use. A spell of the same level, *Deprive the Adversary of the Gift of Prometheus*, is used to knock over censers, which often extinguishes them.\n\nOlibanum Magic 6 (Base 0, +9 Sight, –3 Incense)/ ReVi 10"
    }

    #t4cd8fdea9f43d04dd81811 ^"Flying Knife" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 12
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Perpetual"
            ^"Target" STRING "Incense"
            ^"Printed Stat Line" STRING "Olibanum 12 R: Touch, D: Perpetual, T: Incense"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "One of the most popular of the spells used on harvesting knives is this one: it allows the knife to fly while carrying tremendous weight. It’s not particularly comfortable or dignified for a sorcerer to fly this way, but it is far easier than spells that are targeted at the magician’s own body. A character flying this way for more than five minutes must make a Strength check against an Ease Factor of 3. If the character fails, he must land in the following round or lose his grip and fall. A new check is made in every subsequent minute, and the Ease Factor increases by 1 for every added check.\n\nOlibanum Magic 12 (Base 0, +3 Touch, +12 Perpetual, –3 Incense) / ReTe(An) 20 (Base 0, +5 Touch +20 Perpetual –5 Incense)"
    }

    #t96c211b7e56dc1c50ea480 ^"Rain of Rocks" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 12
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "Olibanum 12 R: Voice, D: Momentary, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This is a simple offensive spell that works by flinging gravel and small stones at a designated target. It is a common offensive spell used by dueling sorcerers because the material for it is ubiquitous, but this means that most of the other tribes know to expect this effect. In turn, this means the Olibanum sorcerers may choose not to employ it, because they assume countermeasures are in place. Instead, they may reserve it for wild animals and non-magical people.\n\nWith smooth, natural pebbles, this spell does +10 damage; but nails, usually carried by a magician planning to cast this spell, can cause +15 damage.\n\nOlibanum Magic 12 (Base 0, +6 Voice, +6 Group) / ReTe 20 (Base 0, +10 Voice +10 Group)"
    }

    #t1d80202d470e9d15a755db ^"Command Centipedes" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 24
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Perpetual"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "Olibanum 24 R: Touch, D: Perpetual, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "The centipedes of Soqotra are venomous and around a foot long. This spell commands a nest of them, in perpetuity, even if those commands will result in the death of the centipedes. The people of the island, who are aware of the venomous nature of the centipedes, must make a Brave check against an Ease Factor of 6 to face a nest of them. Olibanum sorcerers often have nests of vermin near their caves, which are commanded to stay in place and attack intruders. Spiders and rats are also frequent choices. Vermin are also particularly useful for sabotaging crops and damaging the personal possessions of enemies.\n\nOlibanum Magic 24 (Base 3, +3 Touch, +12 Perpetual, +6 Group) / ReAn40 (Base 5, +5 Touch +20 Perpetual +10 Group)"
    }

    #t51b915e48966bcd30c705c ^"Mark of Justice" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 33
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Perpetual"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "Olibanum 33 R: Touch, D: Perpetual, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell is the most famous cast by Olibanum magicians; its effects are known by virtually every pirate in the Red Sea. When this mark is upon part of a vessel, it will not leave port regardless of the wind or tide. The sorcerers of Soqotra use it to prevent the escape of pirates who have harmed locals. Drawing a mark in cinnabar dye onto the hull of the ship is not actually a necessary part of the spell, but it is good theater and has a psychological effect on troublemakers.\n\n*Mark of Justice *is very rarely used, because it is a difficult spell. That being noted, there is a second spell, called the *Lesser Mark*, which has a Censer duration and has an Ease Factor of 21. The public ceremony of marking the ship is visually indistinguishable between spells, because it is pure theater in both cases, rather than a requirement of the spell.\n\nOlibanum Magic level 33 (Base 18, +3 Touch, +12 Perpetual) / ReHe 55 (Base 30, +5 Touch +20 Perpetual)"
    }

    #t84c6c4d2011534dc5c0862 ^"Control Wind" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Sorcerers of Soqotra"
            ^"Spell Type" STRING "Spell"
            ^"Arts" STRING "Olibanum Magic"
            ^"Level" INTEGER 33
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Censer"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "Olibanum 33 R: Sight, D: Censer, T: Individual"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell allows Olibanum magicians to order the wind to draw a vessel to any particular place on the island’s shore. It can be used to prevent escape from the island, but can also be used to draw ships onto rocks. Some magicians do this to allow their mundane allies to scavenge through the debris, which shows an attitude to the value of vis entirely alien to the European mindset, while others use it to defend the island from invasion. A similar spell commands seawater.\n\nOlibanum Magic 33 (Base 21, +9 Sight, +6 Censer) / CrAu 55 (Base 35, +15 Sight, +10 Censer)"
    }

}
