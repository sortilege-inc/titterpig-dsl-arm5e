            #t49d0fb99448660710ee031 ^"Halo" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "As *Lamp Without Flame*, which manifests as a halo around Abbas’ head."
            }
            #t84d94c58c142015d07f40d ^"The Lord’s Terrifying Herald" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "As *Jupiter’s Resounding Blow*."
            }
        }
        DESCRIPTION "Praise the Lord … you Mighty Ones who do His bidding, who obey His word.\n\n*Psalm 103:20*\n\nAbbas, one of the Nephilim, is the only survivor of an infernal attack on his home, a terrestrial regio near to the player characters’ covenant. He fled the regio to seek help, but was pursued by a fiery hell-hound that left him badly burned (and afraid of fire). Abbas is a kind-hearted soul with a love for music and keen ability to assess a person’s character. He currently has the enmity of a powerful devil who orchestrated the assault. Abbas is seeking help to avenge his murdered family, a solemn promise he made to God, and may see the characters’ covenant as a possible ally."
    }

    #t15d4ba7e2e10c8e560c252 ^"Chalkydri" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Might" INTEGER 10
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 6
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 5
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Greater Immunity (Fire and Heat)"
            ^"Reputations" LIST ["None Combat: Bite: Init +1", "Attack +14", "Defense +11", "Damage +12 Claws: Init +2", "Attack +16", "Defense +14", "Damage +13 Wings: Init +4", "Attack +8", "Defense +5", "Damage +8"]
            ^"Soak" INTEGER 5
            ^"Fatigue Levels" STRING "OK, 0, 0, 0, –1, –1, –3, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-10), –3 (11-20), –5 (21-30), Incapacitated (30-40)"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "1 pawn of Animal in head, one pawn (total) of Ignem and Auram in wings."
            ^"Appearance" STRING "Chalkydri appear as a lion with a crocodile’s head. They glow with shimmering purple light and have six sets of enormous golden wings, which appear to be made of gleaming fire and water."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 17
        }
        PERSONALITY_TRAITS {
            "Compassionate" +2
        }
        ABILITIES {
            "Athletics" SCORE 7 SPECIALTY "flight"
            "Awareness" SCORE 5 SPECIALTY "sight"
            "Brawl" SCORE 5 SPECIALTY "bite"
            "Dominion Lore" SCORE 3 SPECIALTY "divine creatures"
            "Hunt" SCORE 5 SPECIALTY "sunlight"
        }
        POWERS {
            #td7421a8a345ed633bde112 ^"Blinding Reflection" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+4"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "When threatened, chalkydri can angle a set of their wings to deflect the burning rays of the sun against their foe, which blinds the target as *Flash of the Scarlet Flames*, and does damage as *Arc of Fiery Ribbons*."
            }
            #ta9511875422115ea3cea09 ^"Radiant Invisibility" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 point"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "With this power, chalkydri can turn invisible and walk in even the busiest place without being seen or sensed by humans. Some animals and those with the appropriate Virtues (such as Sense Holiness and Unholiness) may still sense them."
            }
        }
        DESCRIPTION "And I looked and saw other flying elements of the sun, whose name is Chalkydri, marvelous and wonderful, with feet and tails in the form of a lion, and a crocodile’s head, their appearance is empurpled, like the rainbow; their size is nine hundred measures, their wings are like those of angels, each has twelve, and they attend and accompany the sun, bearing heat and dew, as it is ordered them from God.\n\n*2 Enoch 12:1*\n\nChalkydri are fantastic creatures that regulate the heat from the sun, lit by Raphael’s brilliance. They carry down soothing dew and catch its rays in their wings. Chalkydri are found in both terrestrial and celestial regiones, and high above mortal settlements and cities, protecting them from the burning light of the sun, or at sunrise near to the earth, when they dispense the dew."
    }

}
