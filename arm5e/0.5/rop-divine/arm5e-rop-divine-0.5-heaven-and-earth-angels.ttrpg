                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER 0
            ^"Age" STRING "n/a (35)"
            ^"Confidence Score" STRING "3 (12)"
            ^"Reputations" LIST ["None Combat: Holy spear: Init +5", "Attack +12", "Defense +12", "Damage +10 Does an additional +10 damage against Infernal opponents."]
            ^"Soak" INTEGER 13
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Equipment" STRING "Chain mail armor, spear and shield."
            ^"Encumbrance" STRING "0 (3)"
            ^"Vis" STRING "2 pawns of Perdo in spear, 2 pawns of Mentem in eyes."
            ^"Appearance" STRING "Midael appears on earth in the guise of a knight or warrior. His angelic nature is clear from his luminous white skin and his shining eyes."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 31
        }
        PERSONALITY_TRAITS {
            "Love of God" +5
            "Relentless" +4
            "Cunning" +2
        }
        ABILITIES {
            "Athletics" SCORE 6 SPECIALTY "running"
            "Awareness" SCORE 6 SPECIALTY "battle"
            "Dominion Lore" SCORE 6 SPECIALTY "angels"
            "Etiquette" SCORE 6 SPECIALTY "Celestial Court"
            "Hunt" SCORE 6 SPECIALTY "sinners"
            "Infernal Lore" SCORE 4 SPECIALTY "devils"
            "Leadership" SCORE 7 SPECIALTY "angels"
            "Single Weapon" SCORE 6 SPECIALTY "spear"
            "Theology" SCORE 6 SPECIALTY "holy war"
        }
        POWERS {
            #t796163c17287b667a285ae ^"Confound the Wicked" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "As *Confusion of the Numbed Will*."
            }
            #t577ff6073711b29bab6581 ^"Radiance of the Divine Host" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+15"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Causes sinful or evil foes to become awestruck and fearful."
            }
            #te7bf47968e313d53a3f29d ^"Refuge of the Worthy" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+15"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "As per the saintly miracle, *Celestial Immunity* (Mythic Christianity, Saints)."
            }
            #tb92eb855180d956bb0e22d ^"Tireless Pursuit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Midael can unerringly follow a fleeing foe without losing Fatigue levels for as long as he desires."
            }
        }
        DESCRIPTION "Let them be turned back and confounded who devise evil against me. Let them be like chaff before the wind, with the angel of the Lord driving them on. Let their way be dark and slippery, with the angel of the Lord pursuing them.\n\n*Psalm 35:5-6*\n\nMidael is one of the captains of the celestial host, lead by Michael. He is the angel invoked by David in Psalms 34 and 35, and is the defender of those persecuted by evil men, often appearing as a knight or great warrior to protect the innocent or righteous from dishonorable foes or wicked assailants. He has great martial prowess, but his is also a canny warrior and has defeated many opponents with greater skill or power than he by wit and cleverness."
    }

    #t482fd0f4f6c85158702b20 ^"Munkar and Nakir, the Questioners" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Choir" STRING "Thrones"
            ^"Might" INTEGER 40
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 4
                ^"Perception" INTEGER 4
                ^"Presence" INTEGER 4
                ^"Communication" INTEGER 4
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 5
                ^"Quickness" INTEGER 5
            }
            ^"Size" INTEGER 0
            ^"Age" STRING "n/a (33)"
            ^"Confidence Score" STRING "3 (20)"
            ^"Virtues and Flaws" STRING "Piercing Gaze"
            ^"Reputations" LIST ["Angels of the Grave 3", "among Muslims Combat: Fist: Init +16", "Attack +16", "Defense +16", "Damage +16"]
            ^"Soak" INTEGER 15
            ^"Fatigue Levels" STRING "OK, 0/0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20)"
            ^"Equipment" STRING "Green robes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "10 pawns of Corpus each in fists."
            ^"Appearance" STRING "Two identical men in green robes."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 32
        }
        PERSONALITY_TRAITS {
            "Just" +3
            "Love of God" +5
        }
        ABILITIES {
            "Dominion Lore" SCORE 7 SPECIALTY "angels"
            "Brawl" SCORE 7 SPECIALTY "fist"
            "Guile" SCORE 12 SPECIALTY "spot Lies"
            "Theology" SCORE 10 SPECIALTY "angelology"
        }
        POWERS {
            #tf48e6a791a0048eefe49b5 ^"Question" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Munkar and Nakir can ask a character question, which the character will immediately answer as truthfully as possible. This power physically forces the character to answer, making it a power based on Corpus with a Mentem requisite."
            }
            #t7164c4db1d70c2b15830c5 ^"Spirit Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Munkar and Nakir can become creatures of pure spirit as they wish. This means that they are unable to affect things physically, or be affected physically."
            }
            #t102c2fd06e0452deae6d48 ^"Subtle Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Munkar and Nakir can change their appearances to look like any human being they wish, though they always take the same form. Their statistics do not change."
            }
        }
        DESCRIPTION "*Note: Munkar and Nakir have the same statistics.\n\nCharged with the souls of the Muslim dead, Munkar and Nakir are angels who examine and if necessary punish their charges in their graves. They ask the dead their opinions regarding Muhammad. The faithful will answer that he is the Messenger of God, upon which they will leave them alone to await the Day of Judgment. However, unbelievers and sinners will be unable to answer, upon which the angels will punish them by beating them for as long as God wills, in some cases until the Day of Judgment."
    }

    #t8e8bb60f68ed7a3d59b835 ^"Nasir, the Helper" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
