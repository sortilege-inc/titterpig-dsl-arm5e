            }
            ^"Size" INTEGER 0
            ^"Age" STRING "n/a (33)"
            ^"Confidence Score" STRING "2 (10)"
            ^"Virtues and Flaws" STRING "Ways of the (Local Environment); Animal Ken, Wilderness Sense"
            ^"Reputations" LIST ["None Combat: Fist: Init +2", "Attack +8", "Defense +8", "Damage +0"]
            ^"Soak" INTEGER 1
