            "Swim" SCORE 8 SPECIALTY "rough water"
            "Theology" SCORE 8 SPECIALTY "angelology"
            "Wilderness Sense" SCORE 8 SPECIALTY "local environment"
        }
        POWERS {
            #t879d5cff0b8eb48e1917d1 ^"Calming Touch" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Animal/Mentem"
                }
                DESCRIPTION "By touching the target, Nasir can calm his fears, making him feel reassured in the face of dangerous terrain."
            }
            #t12aa7b728f94e924110111 ^"Spirit Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Nasir can become a creature of pure spirit as he wishes. This means that he is unable to affect things physically, or be affected physically."
            }
            #t9b49f1372a66a05f6579c5 ^"Steadying Hand" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+30"
                    ^"Form" STRING "Animal/Corpus"
                }
                DESCRIPTION "By touching the target, Nasir can assure that his footsteps are firm and that he can cross the most impassable of terrain. The target will not slip or fall as long as contact is maintained."
            }
            #t5030d3a5087f4b598524d6 ^"Subtle Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Nasir can change his appearance to look like any human being. His statistics do not change."
            }
        }
        DESCRIPTION "As I was unable to walk, I climbed the mountain on horseback, while its slopes were all covered with pieces of stone and pebbles which slipped backwards under the feet of the horse every time its hoofs struck them ... It slipped backward, with the pebbles and chips of stone sliding under it, and fell. So I dismounted, assisted the horse to its feet and stopped, unable to move. At that moment a man came down to me from the mountain and held me by the hand, my other hand holding the pack horse, until he got me to the summit. No, by Allah, I did not know who the man was and never saw him again. ... He was none other than an angel whom Allah, moved by compassion toward me, sent to my aid.\n\nUsama ibn Munqidh (d. 1188), *The Book of Learning by Example*\n\nNasir is a minor angel charged with the safety of pious travellers. He spends most of his time helping those in need, seeming to appear by mundane means from just out of sight, providing what aid he can, and then leaving again before he can be questioned too closely about his origins."
    }

    #t127177fbeaa2dca0c5f197 ^"Samuil, Angelic Guide" DEF {
        EXTENDS #ta3872b60ee4dd02a88e718 ^"Angel"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Choir" STRING "Cherubim"
            ^"Might" INTEGER 25
            ^"Form" STRING "Ignem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 1
            ^"Age" STRING "n/a (Indeterminate)"
            ^"Confidence Score" STRING "2 (10)"
            ^"Reputations" LIST ["None. Combat: Fist: Init +0", "Attack +7", "Defense +7", "Damage +1"]
            ^"Soak" STRING "+12 (from holy raiment, otherwise +0)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-11), –3 (12-16), Incapacitated (17-21)"
            ^"Equipment" STRING "Holy garments."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "5 pawns of Corpus in arms."
            ^"Appearance" STRING "Samuil appears as a large, resplendent man whose face shines like the sun and whose eyes glow with holy light. His arms appear like golden wings. He wears a golden girdle, and his pure-white clothes are covered in the holy names of God."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 33
        }
        PERSONALITY_TRAITS {
            "Love of God" +5
            "Righteous" +4
            "Poised" +2
        }
        ABILITIES {
            "Awareness" SCORE 5 SPECIALTY "travel"
            "Brawl" SCORE 4 SPECIALTY "fists"
            "Dominion Lore" SCORE 9 SPECIALTY "the Seven Heavens"
            "Etiquette" SCORE 5 SPECIALTY "Divine regiones"
            "Theology (Books of Enoch)" SCORE 8
        }
        POWERS {
            #t086d71ff693dd1ad342043 ^"Infallible Guide" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Samuil can enter and traverse through any regio as though he were a native inhabitant."
            }
            #t6615aafac88a3798fdc902 ^"Grant Vision" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "Can duplicate any Understanding effect (see Blessed By God, Miraculous Effects)."
            }
            #tb595b89c5f2eb8a0089226 ^"Transport the Devout" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+5"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Can take a chosen person to any destination of his choice, and even beyond the Lunar Sphere."
            }
        }
        DESCRIPTION "I was in great trouble, weeping asleep on my couch, and there appeared to me two very big men, such as I have never seen on earth — their faces shone like the sun, their eyes were burning candles, out of their mouths came fire, their clothes and singing were various, and their arms like golden wings. They stood at the head of my couch, and called me by name.\n\n*2 Enoch, 1:5-7*\n\nSamuil, along with Raguel, transported the patriarch Enoch through the Seven Heavens to come before God. He is responsible for keeping the celestial road clear for souls to travel through, and also for ensuring that the faithful know the word and sovereignty of the Lord. He was tasked by God to help Enoch record the journey through the Seven Heavens, and served Enoch while the patriarch still resided on earth. Since Enoch ascended to Heaven and became Metatron, Samuil has been responsible for delivering visions to saints and prophets. He may also have been one of the angels of righteousness to take St. Paul to the Heavens."
    }

    #tf5841e77732a06b72f7f50 ^"Abbas the Hunted" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Divine" FIXED
            ^"Might" INTEGER 4
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 1
            ^"Age" STRING "80 (20)"
            ^"Decrepitude" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Mythic Companion: Nephilim (free); Entrancement, Greater Immunity: Disease, Blood of the Nephilim; Enduring Constitution, Great Stamina, Great Strength, Improved Characteristics (x2), Keen Vision, Lesser Purifying Touch, Long-Winded, Rapid Convalescence, Sense Holiness and Unholiness, Strong Angelic Heritage (free), Student of the Divine; Compassionate, Enemies; Fear of fire, Generous, Lesser Malediction, Vow"
            ^"Reputations" LIST ["None Combat: Fist: Init –1", "Attack +3", "Defense +2", "Damage +4 Spear (Short): Init +1", "Attack +5", "Defense +2", "Damage +9"]
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" STRING "OK, 0, –2, –4, Unconscious"
            ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24)"
            ^"Equipment" STRING "Clothes, jewelry, bronze spear."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "1 pawn Corpus in heart."
            ^"Appearance" STRING "Abbas is a giant (some eight feet tall) with eyes like sapphires. He wears archaic clothes (the style is several hundred years old) encrusted with emeralds and silver, and inscribed with holy words and symbols. He has an oiled beard and jet-black hair that is intricately braided and interwoven with strands of precious metal."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 16
        }
        PERSONALITY_TRAITS {
            "Greedy" +3
            "Devout" +2
            "Callous" -2
        }
        ABILITIES {
            "(Area) Lore" SCORE 5 SPECIALTY "regiones"
            "Athletics" SCORE 4 SPECIALTY "running"
            "Awareness" SCORE 5 SPECIALTY "wilderness"
            "Brawl" SCORE 2 SPECIALTY "fist"
            "Carouse" SCORE 4 SPECIALTY "staying sober"
            "Charm" SCORE 4 SPECIALTY "friendly conversation"
            "Concentration" SCORE 4 SPECIALTY "while performing music"
            "Dominion Lore" SCORE 7 SPECIALTY "divine beings"
            "Entrancement" SCORE 6 SPECIALTY "bringing peace"
            "Etiquette" SCORE 5 SPECIALTY "angels"
            "Folk Ken" SCORE 5 SPECIALTY "divine beings"
