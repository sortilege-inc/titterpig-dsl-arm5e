EXTENSION "ArM5_RoP_Divine_MythicChristianity_Rules" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Four: Mythic Christianity rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_RoP_Divine_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t9ba4bb28f9ee55b7207e61 ^"Invoking a Saint" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "INVOKING A SAINT"
            ^"Rules Section" STRING "Invoking a Saint"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 87
        }
        FORMULAS {
            "INVOKING A SAINT" "Communication + Charm + modifiers + a simple die vs. 15 + a simple die"
        }
    }

    #t3c65c9224d03656536e466 ^"Threatening a Saint" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "THREATENING A SAINT"
            ^"Rules Section" STRING "Threatening a Saint"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 87
        }
        FORMULAS {
            "THREATENING A SAINT" "Presence + Leadership + modifiers + stress die vs. 9 + Saint’s Divine Might/5"
        }
    }

    #t0cd2cf1d80c8716bf7af47 ^"Greater Saint" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "GREATER SAINT"
            ^"Rules Section" STRING "Designing Saints"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        FORMULAS {
            "GREATER SAINT" "Divine Might 75"
        }
    }

    #t86a6b837dc719bbec3c83c ^"Area Saint" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "AREA SAINT"
            ^"Rules Section" STRING "Designing Saints"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        FORMULAS {
            "AREA SAINT" "Divine Might 50"
        }
    }

    #tf6a40c82b5381fafdedd9e ^"Local Saint" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "LOCAL SAINT"
            ^"Rules Section" STRING "Designing Saints"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        FORMULAS {
            "LOCAL SAINT" "Divine Might 25"
        }
    }

    #t917aa786356cec8a4a5f88 ^"Finding a Copy of Ars Notoria" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "FINDING A COPY OF ARS NOTORIA"
            ^"Rules Section" STRING "Finding a Text"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 97
        }
        FORMULAS {
            "FINDING A COPY OF ARS NOTORIA" "Intelligence + Divine Lore + stress die vs. an Ease Factor of 21"
        }
    }

    #t3acc3b557515d98de151aa ^"Recitation Score" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "RECITATION SCORE"
            ^"Rules Section" STRING "The Rings of Solomon"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 98
        }
        FORMULAS {
            "RECITATION SCORE" "Intelligence + Ars Notoria + Modifier"
        }
    }

    #t0028bf123e902dddda67f5 ^"First Recitation of an Ars Notoria Ring" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "FIRST RECITATION OF AN ARS NOTORIA RING"
            ^"Rules Section" STRING "FIRST RECITATION OF AN ARS"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 99
        }
        FORMULAS {
            "FIRST RECITATION OF AN ARS NOTORIA RING" "Ease Factor = 6 + 3 times level of ring + 1 per season of desired duration"
        }
    }

    #tb01ab4c652f82a95913ef9 ^"Subsequent Recitations of a Known Ars Notoria Ring" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "SUBSEQUENT RECITATIONS OF A KNOWN ARS NOTORIA RING"
            ^"Rules Section" STRING "SUBSEQUENT RECITATIONS OF A"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 99
        }
        FORMULAS {
            "SUBSEQUENT RECITATIONS OF A KNOWN ARS NOTORIA RING" "Ease Factor = 3 + 3 times level of ring + 1 per season of desired duration"
        }
    }

    #t074e9ccb606621c99bc93d ^"Sense Realm Affiliation" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "SENSE REALM AFFILIATION"
            ^"Rules Section" STRING "THE FIFTH RING OF SOLOMON"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 100
        }
        FORMULAS {
            "SENSE REALM AFFILIATION" "Perception + Ars Notoria vs. 6 + Target’s Magic Resistance/5"
        }
    }

    #t41cda28ac8d5f0c306136e ^"Divination" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "DIVINATION"
            ^"Rules Section" STRING "THE SIXTH RING OF SOLOMON"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 100
        }
        FORMULAS {
            "DIVINATION" "Perception + Ars Notoria vs. variable Ease Factor"
        }
    }

}
