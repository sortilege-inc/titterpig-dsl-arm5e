EXTENSION "ArM5_RoP_Divine_MythicChristianity_Saints" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Four: Mythic Christianity saints"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_RoP_Divine_Core_Ext"

    # The chapter's saints, structured; each DESCRIPTION the source's text, verbatim.

    #t10319b725b1ef51aa6f0e8 ^"Acknowledgment of Evil" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Vim"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power forces any demon within voice range of the petitioner to declare his Infernal nature, loudly stating that he is a demon. The Penetration of this miracle (Divine Might – (5 x Might Point cost of power)) must equal or exceed the demon’s Infernal Might to be effective."
    }

    #t7f78755c90b2bc21bd5522 ^"Apparition (Saint Power)" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Printed Name" STRING "Apparition"
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "0 points"
            ^"Initiative" STRING "+20"
            ^"Form" STRING "Imaginem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power allows the saint to create a physical manifestation of himself. He is still immune from physical harm; weapons and items will pass through the saint without effect."
    }

    #t671a9db1e5ec58b27fc1a2 ^"Celestial Immunity" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+15"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power makes the recipient completely immune to physical damage, whether from torture, combat, the elements, or natural injury. The protection lasts as long as the threat persists, but dissipates once the imminent danger has passed."
    }

    #te829dd395c0f7db62fdae3 ^"Cure Blindness" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+3"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "Permanently restores sight, regardless of the cause of the affliction. This power can restore sight lost due to aging. It does not prevent future damage."
    }

    #td02005517ca74b3325955b ^"Expel Demons" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+15"
            ^"Form" STRING "Vim"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "By using this power the saint can expel a demon from a person or area, forcing the fiend to return to Hell. This power works the same way as does the Hermetic spell, *Demon’s Eternal Oblivion*. The storyguide compares the saint’s Might + a stress die (no botch) against the demon’s Might."
    }

    #t4d8b110ef24f612884b40d ^"Grant of Serenity" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "–10"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power calms an agitated or worried petitioner, soothing her fears and calming her anxiety, and is very similar to the Hermetic spell *Enchantment of Detachment*. Unlike the spell, this power will also nullify any malign Mentem spell currently affecting the target."
    }

    #t2efb4cd1b72bddccad6100 ^"Mass Healing" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+0"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power heals a crowd of people from all their diseases. It will heal blindness, lameness, deafness, any affliction caused by age or disease, and all wounds an individual might have. It will not remove Decrepitude points or repair Characteristics lowered by aging."
    }

    #t01231350dc21587c5fab37 ^"Raise the Dead" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "7 points"
            ^"Initiative" STRING "+0"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power restores life to a corpse, provided that the soul hasn’t been accepted into heaven. It can raise those who souls are in Purgatory, or even Hell."
    }

    #t534fbd1b840e6d91d57dc0 ^"Resist Temptation" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power bestows Magic Resistance equal to the Divine Might of the saint to the petitioner to help resist the Infernal powers of demonic temptation."
    }

    #t3cc6da2edc72c199a05b2b ^"Sanctuary of Virginity" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "With this power the saint can protect the virginity of one of her followers in some miraculous fashion. Good examples are momentarily blinding the assailant, growing the recipient’s hair to cover her body in an impenetrable mass, or making the assailant believe a collection of kitchen pots is his intended victim."
    }

    #t1d133d78fa4143d1ad5f61 ^"Scourging of Snakes" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+13"
            ^"Form" STRING "Animal"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power expels all snakes and crawling reptiles from an island up to the size of Ireland. Furthermore, once this miracle has been performed, natural snakes will not return to the island, and magical snakes must beat the saint’s Magic Resistance to be created."
    }

    #ta41cf6288f72648e62694e ^"Straighten the Crippled" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power heals the lame and physically deformed. This will repair physical damage received from spells, but will not remove Decrepitude or Warping Points."
    }

    #t56111754b0141cda937207 ^"The Dutiful Shepherd" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Imaginem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power causes an image of the saint to appear before a lost petitioner and lead them to safety. While under the protection of the saint, the petitioner receives a +10 soak against damage and a Magic Resistance of 10 (which does not stack with other forms of Magic Resistance)."
    }

    #t091b32c470267811af92f0 ^"The Faithful Made Whole" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+15"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power cures the recipient of all disease and heals all physical wounds."
    }

    #tc2c468e4dc67691007e6f4 ^"The Incombustible Shroud" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+20"
            ^"Form" STRING "Ignem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This powers renders the target immune to damage from fire, regardless of its size and potency."
    }

    #t37a8f9448d4391884d2038 ^"The Laborer’s Boon" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Terram"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power allows the saint to mend a broken tool or instantly replace a lost one. Sieves, hoes, and axes are common examples of tools broken during use and repaired by a saint."
    }

    #t8c67696c0f979bdbdb8c63 ^"The Leap of the Faithful" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This potent power instantly transports a single person from one location to another, regardless of distance, condition, or situation. This is often used by a saint to retrieve a petitioner’s loved one from distant imprisonment."
    }

    #t84e13dbd139dfc3b3bc798 ^"Tomorrow’s Bounty" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+0"
            ^"Form" STRING "Herbam"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This power allows the saint to instantly create food enough to feed a large crowd — often sacks of grain or baked loaves of bread."
    }

    #te65927be8b41a784168b1b ^"Blindness" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+8"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse blinds the target, removing her power of sight. This is permanent unless repaired by magic or miracle."
    }

    #tf28ff87e1955d82e9c5747 ^"Blisters of Humility" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+12"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse covers the target with boils and sores that last for a week. The target suffers a –6 penalty on all physical actions."
    }

    #t31a7ff52f446c6a0afc750 ^"Dysenteric Infliction" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse destroys the target in the most wretched way, by giving him such a severe attack of dysentery that all his intestines spill out."
    }

    #t3c728fa1150a67038070bf ^"Flabbergast the Impertinent" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+3"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse causes the target to fall into a deep sleep, lasting the night, and accompanied by loud snores. The sleeper will wake in the morning exhausted from his snoring, down two long-term Fatigue levels. No magic can prematurely wake the sleeper."
    }

    #t6de6466254a61f8cdc3ca1 ^"Humility of Caesar" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+12"
            ^"Form" STRING "Animal or Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This subtle curse causes a rider’s horse to throw him to the ground. If the target is already afoot, he ignobly falls flat on his face."
    }

    #t8576198a109a9cdc93e9a5 ^"Ignis Domini" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+18"
            ^"Form" STRING "Ignem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "“The Fire of God” is a pillar of fire that falls from heaven and engulfs the target, doing +30 points of damage."
    }

    #ta824132bcce87fb8878cc2 ^"Rebuke the Unfaithful" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+13"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse attempts to return the fallen to the fold by threatening him with death unless he mend his ways. The saint appears in a vision and tells the target that he will die within thirty days unless he ceases performing some specific unchristian behavior. If the target does not amend her ways, she will die."
    }

    #t2f7f78af8cd34a95d7ae5c ^"Smiting of the Lord" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+13"
            ^"Form" STRING "Auram"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A lightning bolt flashes from the saint’s hands and inflicts +35 points of damage to the target, which is usually indicated by the petitioner in her invocation."
    }

    #t96266aa1e3bada665637fb ^"Swallowed Alive and Sent to Hell" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+3"
            ^"Form" STRING "Terram"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This self-explanatory curse forces a chasm to open up underneath the target’s feet, creating a direct chute to Hell in which the target falls. The chasm instantly reseals itself afterwards."
    }

    #t4ad9ba468d07dd11d41a16 ^"Terrify the Unbeliever" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+18"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse causes fear in the target, making her terrified of the saint and his power and forcing her to flee to the nearest place of safety. A Brave or other appropriate Personality Trait roll of 12+ is need to overcome this terror, which lasts until the next dawn."
    }

    #tced954a3c24d1f3f6c4cde ^"The Earth’s Riches" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+10"
            ^"Form" STRING "Terram"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This power permanently changes sticks and stones into gold and precious stones, with an overall value similar to the Hermetic spell *Touch of Midas. *Typically a saint uses this power to threaten a follower into a more righteous lifestyle, reminding him that he is sacrificing his heavenly reward for riches in the here and now."
    }

    #t382a91339f47a45851dd20 ^"The Feast of Worms" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Corpus"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This curse causes the target’s body to become invested with maggots, doing +10 damage initially. The target must make a Stamina stress roll against an Ease Factor of 12 or permanently lose a point of Presence."
    }

    #ta8b3cb713028a1a51a3559 ^"Blessed Virgin Mary" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Patron saint of the laity in general, also, clothworkers, cooks, fishermen, nuns, protection against epidemics and natural disasters, silversmiths, Teutonic knights, virgins, and women"
            ^"Divine Might" INTEGER 100
            ^"Area of Veneration" STRING "Throughout Mythic Europe"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Celestial Immunity", "Cure Blindness", "Grant of Serenity", "Incombustible Shroud", "Leap of the Faithful", "Rebuke the Unfaithful", "Resist Temptation", "Straighten the Crippled", "The Dutiful Shepherd"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "The Blessed Virgin Mary is the mother of Jesus Christ. She is the most powerful saint in Mythic Europe, enjoying a higher form of adoration than other saints receive, and her cult is the most popular of all the saints. She receives many petitions for aid because she is seen as being more compassionate and merciful than Christ, since she can use her motherly influence to help soften His judgments.\n\nHer birth was preordained to her parents by angels, as was her role as the mother of the Son of God. She spent the first fourteen years of her life secluded in the Lord’s Temple, before being bequeathed to St Joseph, an elder man and widower. The angel Gabriel visited Mary and told her that she was blessed and would conceive the Son of God. Mary left her hometown of Nazareth with her husband and went to Bethlehem, where she delivered Jesus in a secluded grotto. To escape the persecution of Herod, Mary and her family fled to Egypt. She was not directly involved with Christ’s ministry, but was present at the Passion. St Ambrose writes that Mary was the first to see the Lord’s Resurrection. Leaving Jerusalem, Mary moved to Ephesus, living there until the end of her life, when she was raised by angels to heaven. The Blessed Virgin Mary’s tomb is in Ephesus, as is the house she spent her final days living in."
    }

    #t1d7901643bbf8ce2fcdcf6 ^"Saint Peter, Apostle" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Patron saint of the Church, popes, and fisherman"
            ^"Divine Might" INTEGER 75
            ^"Area of Veneration" STRING "Rome, throughout Mythic Europe"
            ^"Saint Powers" LIST OF STRING ["Acknowledgment of Evil", "Apparition", "Celestial Immunity", "Cure Blindness", "Expel Demons", "Mass Healing", "Raise the Dead", "Sanctuary of Virginity", "Terrify the Unbeliever", "The Laborer’s Boon", "Tomorrow’s Bounty"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "St Peter was the chief of the apostles, revered by Christ for his religious conviction and witness to most of Christ’s miracles. Peter was the first apostle chosen by Christ, performed countless miracles himself, and received from Christ’s hand the keys to Heaven, the rock on which the Church was to be built. Peter preached in many cities and converted thousands of pagans to the Christian faith. In Rome Peter defended the faith against Simon Magus, a sorcerer in Emperor Nero’s employ. Peter repeatedly dispelled the demons the sorcerer used to work his magic, which turned fatal when the demons giving the sorcerer the power of flight were expelled. Nero remained unconvinced and crucified Peter, who asked his cross to be placed upside down in a final act of humility. He was buried in Rome."
    }

    #t674d0190cd5197f7aca54f ^"Saint Martin of Tours" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Patron saint of soldiers, horses, horse riders, and beggars"
            ^"Divine Might" INTEGER 50
            ^"Area of Veneration" STRING "Poitiers, Tours, Paris, Normandy, other areas of France and Italy"
            ^"Saint Powers" LIST OF STRING ["Acknowledgment of Evil", "Apparition", "Celestial Immunity", "Expel Demons", "Grant of Serenity", "Terrify the Unbeliever", "The Labor’s Boon"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "St Martin was a professional soldier, born in Hungary and trained in Italy. Entering the city of Amiens, Martin gave his cloak to a beggar and was rewarded that night with a vision of Christ wearing the same cloak. Martin left his military career and became a soldier of God, traveling Europe to preach the Word of God, combat the Arian heresy, and convert pagans. As the bishop of Tours, he continued performing miracles and resisting the temptations of Satan. Martin was a simple and pious man, who made many pilgrimages to Rome and other holy sites. He died in 800 at Candes, at the age of 81. His body was moved to Tours and entombed in a stone sarcophagus, above which a basilica was built. St Martin is one of France’s greatest saints."
    }

    #t91da86c213250322f36685 ^"Saint Guinefort" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Patron saint of protecting local children"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "a diocese In Lyon"
            ^"Saint Powers" LIST OF STRING ["Blisters of Humility", "Grant of Serenity", "Resist Temptation", "Straighten the Crippled", "The Faithful Made Whole"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "St Guinefort was not man, but rather a greyhound. The local lord and lady had left the dog in charge of their newborn baby. During their absence, a snake entered the nursery. In the process of slaying the snake, the dog overturned the baby’s crib and inadvertently splattered snake’s blood on the baby. Returning to the castle, the lord saw his unmoving child covered in blood and, thinking the dog had attacked the baby, killed the dog. When his mistake was made clear, he felt great sadness for his rash action. He buried his beloved greyhound in a well and had it covered with stones. The local population, hearing of the dog’s noble deed, began venerating it as if it were a martyr. The people’s devotion was so great that God took pity on them and allowed the dog to be accepted into the ranks of the holy, allowing St Guinefort to grant miracles similar to a regular local saint."
    }

    #t7aafde45dfb92d04bb384f ^"Saint Nerius" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Patron saint of Christian magi"
            ^"Divine Might" INTEGER 50
            ^"Areas of Veneration" STRING "Individual covenants within the Order of Hermes"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Celestial Immunity", "Ignis Domini", "The Incombustible Shroud", "The Leap of the Faithful"]
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "Tales of St Nerius circulate throughout the Order, especially among Christian magi who hope to promote his cult. The most common tale is that St Nerius was a Criamon magus born in the Provencal Tribunal and active throughout Mythic Europe. A seeker of the Enigma, St Nerius discovered it in a secret well hidden in an Alpine ravine. Instead of succumbing to the mesmerizing vision in the well, St Nerius resisted by asking the angel Michael for assistance. Bathed in the powerful Light of the Lord, St Nerius’s prayer was answered, and he emerged from the mountains a newly made saint and miracle-worker.\n\nThe various stories of his travels are miraculous and many magi find them hard to completely believe. It is told that through the Divine gifts he received from God, St Nerius was able to surpass many of the limits of Hermetic magic. He could cure the sick without vis, travel instantaneously from location to location, and change the essential nature of things. He never lost a Certamen match, nor could his Divine protection be pierced by spells. Some tales say that St Nerius is one of the protectors of Arcadia, and other legends tell of his incredible adventures in Purgatory.\n\nThe usual story of St Nerius’s martyrdom is that other magi were envious of his powers, especially a group from House Tremere, who eventually succeeded in declaring a Wizard’s March against St Nerius. During the Normandy Tribunal of 1039, St Nerius was martyred at Fudarus, Domus Magnus of House Tytalus, by a collection of Tremere, Tytalus, and Flambeau wizards. His Divine protection having withstood every attack, St Nerius proclaimed God’s Will stronger than the petty cravings of his fellow magi, then stepped from the circle of *Celestial Immunity* and died. However, the records of Tribunal meetings at Fudarus never mention this event. However his life ended, St Nerius was accepted by God to be venerated as a saint.\n\nAn autobiographical account of some of St Nerius’s travels does exist; this collection of twelve scrolls is in the Great Library in Durenmar."
    }

