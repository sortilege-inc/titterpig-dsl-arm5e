EXTENSION "ArM5_RoP_Divine_MythicIslam_SacredTexts" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Five: Mythic Islam sacred texts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_RoP_Divine_Core_Ext"

    # The chapter's sacred texts, structured; each DESCRIPTION the source's text, verbatim.

    #tb4c881b0e5ce76614ea7de ^"The Qur’an" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE QUR’AN"
            ^"Book" STRING "Summa, Theology: Islam (Level 10, Quality 10); Summa, Islamic Law (Level 5, Quality 10); Summa, Dominion Lore (Level 5, Quality 10)"
            ^"Author" STRING "God, who dictated it to Muhammad. The canonical text is said to have been compiled within 25 years of the Prophet’s death."
            ^"Availability" STRING "Widely available, but particularly at any mosque."
            ^"Special Rule" STRING "Copying out the Qur’an is an act of pious devotion that can be a comfort in the face of adversity. A Muslim who does this gains a Confidence Point."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "Regarded by Muslims as the final revelation of the true faith, the Qur’an is both a theological text and a guide to how to live a human life to its fullest potential. It describes or alludes to both many stories contained in the earlier revelations and various legal teachings. It is regarded by Muslims as being inimitable both in terms of its literary beauty and its adherence to absolute truth in every detail."
    }

    #t10d1b2477ac3fe48dd2e42 ^"Jami‘ Al-Bayan ‘An Ta’wil Al-Qur’an" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "JAMI‘ AL-BAYAN ‘AN TA’WIL AL-QUR’AN"
            ^"Book" STRING "Summa, Theology: Islam (Level 5, Quality 10); Summa, Islamic Law (Level 5, Quality 10)"
            ^"Author" STRING "Muhammad ibn Jarir al-Tabari (d. 923)"
            ^"Availability" STRING "In common use in any environment where Islamic theology and law are studied."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A massive text (over 3000 pages) providing a commentary on the grammar, lexicography, theology, and legal teachings presented in the Qur’an. This text is extremely popular among legal scholars and has been translated into Persian, so characters might well encounter copies of it in the latter as well as in Arabic."
    }

    #tb7499cc5ef5d02784c02ee ^"Kitab Al-Luma‘" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "KITAB AL-LUMA‘"
            ^"Book" STRING "Tractatus, Theology: Islam (Quality 8)"
            ^"Author" STRING "Al-Ash‘ari (d. 935 or 936)"
            ^"Availability" STRING "Wherever mainstream Sunni theology is studied."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A discussion of various points of Islamic theology, intended primarily as a defense of the mainstream position against the views of the Mu‘tazilis."
    }

    #t9a3a150ef672853d899ac7 ^"Al-Risala" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "AL-RISALA"
            ^"Book" STRING "Tractatus, Theology: Islam (Quality 10); Tractatus, Islamic Law (Quality 10)"
            ^"Author" STRING "Muhammad ibn Idris al-Shafi‘i (d. 820)"
            ^"Availability" STRING "Wide, especially in schools or mosques where the Shafi‘i *madhhab* is dominant."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A treatise on Islamic jurisprudence and one of several important works by al-Shafi‘i, the *Risala* discusses the derivation of Islamic law, insisting in particular that *hadith* from the Prophet should be given priority over *hadith *recounted on the authority of his Companions. This is because Muhammad was the interpreter of the Qur’an and the one best able to understand the precepts laid down therein."
    }

    #t58cbc62f740f54523cc0de ^"Al-Sahihan" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "AL-SAHIHAN"
            ^"Book" STRING "*Sahih al-Bukhari: *Summa, Theology: Islam (Level 5, Quality 9); Summa, Islamic Law (Level 5, Quality 9)\n\n*Sahih Muslim: *Summa, Theology: Islam (Level 5, Quality 9); Summa, Islamic Law (Level 5, Quality 9)"
            ^"Author" STRING "Al-Bukhari (d. 870) and Muslim ibn al-Hajjaj (d. 875)"
            ^"Availability" STRING "In common use in any environment where Islamic theology and law are studied."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "Collectively known as *al-Sahihan* (the two authentic ones), these works are the two most respected collections of *hadith* in use in the Muslim world, providing a wealth of information on Islamic legal and religious teachings."
    }

    #t29551a2d38505ba00e63ec ^"Al-Sira Al-Nabawiyya" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "AL-SIRA AL-NABAWIYYA"
            ^"Book" STRING "Tractatus, Theology: Islam (Quality 7); Tractatus, Islamic Law (Quality 7); Tractatus, Dominion Lore (Quality 7)"
            ^"Author" STRING "Ibn Ishaq (d. betw. 761 and 767)"
            ^"Availability" STRING "Wide. However, some scholars, both earlier and contemporary, regard parts of it as being of debatable veracity."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A biography of the Prophet."
    }

    #teb106dae854e699a1f7816 ^"Ihya’ ‘Ulum Al-Din" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "IHYA’ ‘ULUM AL-DIN"
            ^"Book" STRING "Summa, Theology: Islam (Level 6, Quality 9); Summa, Islamic Law (Level 6, Quality 9); Summa, Dominion Lore (Level 3, Quality 9)"
            ^"Author" STRING "Abu Hamid al-Ghazali (d. 1111)"
            ^"Availability" STRING "Wide, especially among Sufis (see below)."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A text by the great Sufi and theologian, al-Ghazali, *Ihya’ ‘Ulum alDin* seeks to bring life to the mainstream religious sciences through Sufiinspiration. Thus it discusses both mainstream Muslim doctrine and law and spiritual experience, demonstrating that the two are not merely compatible but actually inextricably linked."
    }

    #t5f5387bf5be542b1c414cf ^"Tadhkirat Al-Awliya’" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "TADHKIRAT AL-AWLIYA’"
            ^"Book" STRING "Tractatus, Dominion Lore (Quality 8); Tractatus, Theology: Islam (Quality 8)"
            ^"Author" STRING "Farid al-Din ‘Attar (d. betw. 1190 and 1230)"
            ^"Availability" STRING "Popular among Sufis (see below)."
            ^"Special Rule" STRING "Make a note when the character reads this work. The first time after doing so that the character makes a roll involving the Knowledge studied, he or she should also roll a botch die, even if the roll is being made on a simple die."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A compilation of biographies of Muslim mystics by the Persian mystical poet, pharmacist, and doctor, Farid al-Din ‘Attar. While an inspirational work for Sufis, the author has altered the evidence of some of his sources to match his own religious ideas."
    }

    #t08b6c6e36927fb5240b33a ^"Kitab Al-Irshad" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "KITAB AL-IRSHAD"
            ^"Book" STRING "Tractatus, Dominion Lore (Quality 10); Tractatus, Theology: Islam (Quality 10)"
            ^"Author" STRING "Al-Shaykh al-Mufid (d. 1022)"
            ^"Availability" STRING "Among Twelver Shi‘is (see below)."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "*Kitab al-Irshad* is both a biography of the twelve *imams* and a powerful statement of Twelver Shi‘i devotion."
    }

}
