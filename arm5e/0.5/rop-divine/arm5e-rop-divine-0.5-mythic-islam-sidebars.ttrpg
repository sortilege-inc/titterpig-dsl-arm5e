    GUIDANCE {
        ENTRY ^"A Muslim Library" #te8e4a0692eb68fe07c93c2 {
            TEXT "A Muslim Library\n\nAs implied above, many mediaeval Muslims are educated. Education is a requirement for members of the civil and religious elite, and many members of the military elite are as skilled with Arabic language and literature as they are with swords and bows. The following represents a selection of texts with which an educated Muslim might be familiar. All of these books were originally written in Arabic."
        }
    }

}
