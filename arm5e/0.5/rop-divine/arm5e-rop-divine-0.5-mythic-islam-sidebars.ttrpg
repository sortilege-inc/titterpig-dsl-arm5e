    GUIDANCE {
        ENTRY ^"Sample Muslim Holy Figures" #t037809adb95bf3babfe045 {
            TEXT "Sample Muslim Holy Figures\n\nThe following represents a selection of Muslim holy figures, at whose shrines *baraka* might be sought."
        }
