    #t3opMUKlzhntjQqdq4qUWhX6 ^"Faerie Antipathy" DEF {
            EXTENDS ^"Flaw"
            PROPERTIES {
                ^"Size" STRING "Major or Minor" FIXED
                ^"Category" STRING "Supernatural" FIXED
                ^"Source" STRING "Realms of Power: Faerie"
            }
            DESCRIPTION "The character has a negative relationship with the Faerie realm, and receives a negative Sympathy Trait, with an initial value of –1 for a Minor Flaw and –3 for a Major Flaw. Subtract the character's Warping Score from this value at the end of character creation, so that a character with the Minor version of the Flaw and a Warping Score of 3 would begin with a –4 Trait.\n\nThis Flaw may be taken more than once. See Sympathy, above, for more information about Sympathy Traits."
