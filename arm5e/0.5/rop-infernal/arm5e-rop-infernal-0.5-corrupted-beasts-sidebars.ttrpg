EXTENSION "ArM5_RoP_Infernal_CorruptedBeasts_Sidebars" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Eight: Corrupted Beasts sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ArM5_RoP_Infernal_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Virtues & Flaws for Corrupted Beasts" #t997d5cae689e4b264d90ea {
            TEXT "Virtues & Flaws for Corrupted Beasts\n\n**Compulsory Flaw: **Corrupted Beast **Virtues: **Greater Immunity, Greater\n\nInfernal Power, Ferocity, Lesser Immunity, Lesser Infernal Power **Optional Flaws: ** Horrifying Appearance, Demonic Weakness, Lesser Malediction"
        }
    }

    GUIDANCE {
        ENTRY ^"Example Horrifying Appearances" #t37f47c6f4a2756c1fc0932 {
            TEXT "Example Horrifying Appearances\n\n• The creature has a pair of huge but useless wings, which hang limply at the sides of its body. • The creature’s skin is transparent, so that its organs can be seen pulsating within its flesh. • The creature has a snake’s body instead of hindquarters, forcing it to move with a combined crawl and slither. • The creature lacks an internal skeleton. It can force itself into its original form for short periods, but soon collapses into a puddle of hair, teeth, and claws, oozing slowly along the ground. • There is a head at each end of the creature’s body, or in the center of its back."
        }
    }

}
