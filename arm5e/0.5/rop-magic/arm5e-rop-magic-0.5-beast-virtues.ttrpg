EXTENSION "ArM5_RoP_Magic_Beast_Virtues" {
    NAME "Ars Magica Fifth Edition, Realms of Power: Magic - New Virtues for Beasts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ArM5_Core_Virtue_Flaw"

    #tTCCMVUU7RU4tAqHe8S8yb5U ^"Ferocity" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor" FIXED
            ^"Category" STRING "Beasts only" FIXED
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Like a magus or companion character, you have Confidence points. Unlike a human character, you may use your Confidence Points only in situations where your natural animal ferocity is triggered, such as when defending your den or fighting a natural enemy. Describe a situation that activates your Confidence score, and take three points for you to use when those circumstances are met."
    }}
