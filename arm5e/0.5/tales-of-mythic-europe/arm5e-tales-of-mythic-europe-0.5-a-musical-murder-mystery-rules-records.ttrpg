EXTENSION "ArM5_Tales_of_Mythic_Europe_AMusicalMurderMystery_RulesRecords" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Seven: A Musical Murder Mystery rules records"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's rules records, structured; each DESCRIPTION the source's text, verbatim.

    #tcbce1d965d57213a75b8e5 ^"Performance (Duration) (Tales of Mythic Europe)" DEF {
        EXTENDS #tcff0104e131e6468aca4da ^"Spell Parameter"
        PROPERTIES {
            ^"Printed Name" STRING "New Duration: Performance"
            ^"Parameter" STRING "Duration" FIXED
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "The spell lasts as long as the caster performs the Performance Ability. Performance is equivalent to Concentration Duration.\n\nTo cast a Performance Duration spell, the magus must succeed in a roll (simple or stress die, according to circumstances) of Characteristic (varies with Ability) + Ability against an Ease Factor of 3.\n\nThe spell fails if this fails, and botches if the roll botches. The spell ends when the magus ceases to perform the Ability, but no Concentration or Ability rolls are needed to maintain the spell while the performance continues.\n\nPerformance Abilities include: Music, Charm, Guile, and Carouse (see *The Mysteries Revised Edition*, page 29 for more information). This originally appeared in *The Mysteries Revised Edition*, page 29-30."
    }

}
