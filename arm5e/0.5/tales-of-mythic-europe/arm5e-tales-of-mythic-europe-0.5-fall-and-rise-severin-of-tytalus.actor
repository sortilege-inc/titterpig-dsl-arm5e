    # Severin of Tytalus (Chapter Four: Fall and Rise, p53): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #te96d16717b8ee54eb582f9 ^"Severin of Tytalus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
