EXTENSION "ArM5_Tales_of_Mythic_Europe_FallAndRise_Talismans" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Four: Fall and Rise talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t0b5561414d6789f66036e7 ^"Severin’s Talisman" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Severin of Tytalus"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 54
        }
        TABLE {
            "+4" "control things at a distance" "" "Attunements"
            "+4" "affect dead wood" "" "Attunements"
        }
        DESCRIPTION "Severin’s talisman is a wooden staff. It is only partially filled with magical effects. Currently, it has the following powers:\n\nSeverin’s talisman has the following attunements, but these have not been included in his casting rolls, above, because he begins the scenario without his talisman: +4 control things at a distance, +4 affect dead wood."
    }

}
