EXTENSION "ArM5_Tales_of_Mythic_Europe_FallAndRise_VisSources" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Four: Fall and Rise vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t3b0e38c0c4157d564ea630 ^"The Supply Cache (vis source)" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Unspecified" FIAT "the book names this vis source (p60) but prints neither its Art nor its yield"
            ^"Location" LIST [#te4eebcbcf3b1bddc719167 ^"The Supply Cache"]
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The supply cache is in a cavern behind a waterfall. It contains a vis source, which is annually harvested by a distant covenant. A tunnel has been carved into the floor of the cavern, and its entrance boarded over and covered with soil. The valuable supplies stored here were removed when the theatre of conflict moved past this area. Less-valuable supplies were left to time and rust and rot. Severin finds no useful equipment here, although the site itself, protected by flowing water from the entanglements, allows him his first true respite in months."
    }

}
