EXTENSION "ArM5_Tales_of_Mythic_Europe_Figures" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - maps"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The book's eleven maps (its List of Maps, p3): Dundrum p8, Dún Rudraige p29, Corfe Castle p67, The Town p80, the
    # Priory of St. Ubaldesca p86, Enrico's House & Warehouse p90, the Village Map p133, the Reliquary Village and the Church
    # Floor Plan p146, the lair from above and the Infernalists' Lair p151 -- as ^"Figure" records. Their labels were read by
    # eye; the transcription, its links, its uncertain readings and how it was made: tales-of-mythic-europe/figures.json.

    # source: page 8, read by eye from the art (figures.json)
    #t0b6092bb6abb77afccfefe ^"Dundrum (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Dundrum"
            ^"Lettering" LIST OF STRING ["Dundrum", "Barracks Hall", "Dundrum Castle", "Stable", "Tower Keep", "The Pool of Wisdom", "Dundrum Bay"]
            ^"Shows" STRING "Dundrum castle's palisade, tower keep, barracks hall and stable, and beside it the coast: the castle, the Pool of Wisdom and Dundrum Bay"
            ^"Locations" LIST [#t662e74f4b38ce0b257f6fe ^"Dundrum"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 8
        }
    }

    # source: page 29, read by eye from the art (figures.json)
    #t4d758094268f83df22b04e ^"Dún Rudraige (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Dún Rudraige"
            ^"Lettering" LIST OF STRING ["Dún Rudraige"]
            ^"Shows" STRING "Dún Rudraige: a palisaded fort of round thatched houses on a hill among mountains, its gate and road"
            ^"Locations" LIST [#tbc894bf81198bb4f722d04 ^"Dún Rudraige"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 29
        }
    }

    # source: page 67, read by eye from the art (figures.json)
    #ta2962abbda7e00c81a833f ^"Corfe Castle (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Corfe Castle"
            ^"Lettering" LIST OF STRING ["The King’s Tower", "The Dungeon Tower", "The Queen’s Tower", "The Castle Ditch", "Corfe Castle", "Main Gate"]
            ^"Shows" STRING "Corfe Castle on its hill: its walls, towers, ditch and main gate"
            ^"Locations" LIST [#t10d71f6303be78beb3d13b ^"Corfe Castle"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 67
        }
    }

    # source: page 80, read by eye from the art (figures.json)
    #t969705af5ce2a908ee1323 ^"The Town (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Town"
            ^"Lettering" LIST OF STRING ["The Town", "Mayor’s House", "Commons", "Bishop’s Cathedral", "Enrico’s House", "Market & Store Houses", "Docks", "Hospitaller Priory"]
            ^"Shows" STRING "the walled town by the sea: the mayor's house, the bishop's cathedral, Enrico's house, the market and store houses, the docks, the Hospitaller priory and the commons"
            ^"Locations" LIST [#tbce3abb50cc5fffe5bb11c ^"The Town", #t1eede4554ec58da76933fb ^"Enrico’s House & Warehouse", #ta398023e7ca9dda4101a3f ^"The Priory of St. Ubaldesca"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 80
        }
    }

    # source: page 86, read by eye from the art (figures.json)
    #ta384b8e7d1c8f115b8e898 ^"Priory of St. Ubaldesca (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Priory of St. Ubaldesca"
            ^"Lettering" LIST OF STRING ["Priory of St. Ubaldesca", "1. Keep", "2. Stables", "3. Chapel", "4. Hall", "5. Cells", "6. Nunnery", "7. Hospital", "8. Rectory"]
            ^"Shows" STRING "a floor plan of the priory's buildings, numbered and keyed"
            ^"Uncertain Readings" LIST OF STRING ["8. Rectory: the legend letters 'Rectory'; the text's building is the 'Refectory' (p87) -- read as lettered, not linked"]
            ^"Locations" LIST [#ta398023e7ca9dda4101a3f ^"The Priory of St. Ubaldesca", #tb896b4490b3b49ce92948b ^"Keep", #tb9c0c83ee4516878e33f0b ^"Stables", #t0497741e24169b15e999a6 ^"Chapel", #te2a4d48c9f7dad0c295e6f ^"Hall", #t92d240ce2ad7809c7f2f00 ^"Cells", #ta685800b1e14d1f8dcc95e ^"Nunnery", #t60f47a824ceb75007f90d5 ^"Hospital"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 86
        }
    }

    # source: page 90, read by eye from the art (figures.json)
    #t2a3f27614b2c189db6c7b8 ^"Enrico’s House & Warehouse (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Enrico’s House & Warehouse"
            ^"Lettering" LIST OF STRING ["Enrico’s House & Warehouse", "1. Foyer", "2. Reception Room", "3. Private Meeting Room", "4. Study", "5. Courtyard", "6. Kitchen", "7. Servants’ Quarters", "8. Storage", "9. Clerical Room", "10. Warehouse", "11. Master Bedroom", "12. Change Room", "13. Balcony", "Up", "Down", "First Story"]
            ^"Shows" STRING "a floor plan of Enrico's house and warehouse, numbered and keyed, with its first story"
            ^"Locations" LIST [#t1eede4554ec58da76933fb ^"Enrico’s House & Warehouse"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 90
        }
    }

    # source: page 133, read by eye from the art (figures.json)
    #t9c017149c5dd72715d81d0 ^"Village Map (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Village Map"
            ^"Lettering" LIST OF STRING ["The Tannery", "Village Map", "The Mill", "Initial Landing Site", "Church", "Parsonage", "N", "0", "150", "300", "feet"]
            ^"Shows" STRING "the raiders' village along its river: the tannery, the mill, the initial landing site, the church and parsonage, its fields and houses, a north arrow and a scale in feet"
            ^"Locations" LIST [#tbf2957313caba7b9201b32 ^"Tannery", #t6d96bcba92ff2eaa123c63 ^"Mill", #t3c3f73f95eccbe3483cb3f ^"Church and Churchyard"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 133
        }
    }

    # source: page 146, read by eye from the art (figures.json)
    #ta9a93e6127d4f0c2f9dfc3 ^"The Reliquary Village (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Reliquary Village"
            ^"Lettering" LIST OF STRING ["The Reliquary Village", "Baldwin’s House", "Road", "Peter’s House", "Shallows", "The Church", "Village Common", "Graveyard"]
            ^"Shows" STRING "Warring Families' village: its stream and road, Baldwin's and Peter's houses, the shallows, the church, the village common and the graveyard"
            ^"Locations" LIST [#t7ffb7f19012ee4221b4974 ^"The Village (Warring Families)", #t3c28cdea4edcbaa7f44c40 ^"The Church (Warring Families)"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 146
        }
    }

    # source: page 146, read by eye from the art (figures.json)
    #tc64aa1c6c9360822402ba4 ^"Church Floor Plan (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Church Floor Plan"
            ^"Lettering" LIST OF STRING ["Church Floor Plan", "study", "Altar", "Main Aisle", "Fr Herbert’s Room"]
            ^"Shows" STRING "a floor plan of the village church: the study, the altar, the main aisle and Father Herbert's room"
            ^"Locations" LIST [#t3c28cdea4edcbaa7f44c40 ^"The Church (Warring Families)"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 146
        }
    }

    # source: page 151, read by eye from the art (figures.json)
    #tcc53b64ca5275a270f84db ^"View of Lair From Above (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "View of Lair From Above"
            ^"Lettering" LIST OF STRING ["View of Lair From Above", "Rock Face"]
            ^"Shows" STRING "the cult's lair seen from above: the hill and its rock face"
            ^"Locations" LIST [#tcd544b84f8f2ab75349fec ^"The Cult’s Lair"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 151
        }
    }

    # source: page 151, read by eye from the art (figures.json)
    #t3be97fee4d2face78ea3b7 ^"The Infernalists’ Lair (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "The Infernalists’ Lair"
            ^"Lettering" LIST OF STRING ["The Infernalists’ Lair", "Rock Face", "Entrance", "Second Cavern", "Altar", "Outer Cavern", "Inner Cavern", "Passage", "Side View of Lair"]
            ^"Shows" STRING "a side view of the lair: the rock face and entrance, the outer, second and inner caverns, the altar and the passage"
            ^"Locations" LIST [#tcd544b84f8f2ab75349fec ^"The Cult’s Lair"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 200 dpi (raster labels); labels as printed"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 151
        }
    }

}
