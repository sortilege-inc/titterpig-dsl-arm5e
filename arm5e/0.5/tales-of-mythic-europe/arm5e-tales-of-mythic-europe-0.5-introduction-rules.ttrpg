EXTENSION "ArM5_Tales_of_Mythic_Europe_Introduction_Rules" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter One: Introduction rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t1c1a9eaa735cc5786a7350 ^"Faerie Speech Penetration" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "New Virtues and Flaws"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 5
        }
        FORMULAS {
            "Faerie Speech Penetration" "the faerie’s Might score + Penetration Pretense + aura adjustment"
        }
    }

}
