EXTENSION "ArM5_Tales_of_Mythic_Europe_TheChampionsPortion_ScathAnIrishGiant" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Scáth: an Irish Giant"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # Scáth: an Irish Giant (Chapter Two: The Champion’s Portion, p32): one being, its printed stat lines verbatim fields.

    #t11b011ed0a2cb99efdf8db ^"Scáth: an Irish Giant" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -3
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 10
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -5
            }
            ^"Size" INTEGER 5
            ^"Season" STRING "Summer"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Magic Human; Great Stamina (x2), Tough; Enemies (Heroes of Ulster)"
            ^"Qualities and Inferiorities" STRING "Gigantic (x4); Increased Might (x5), Improved Fist Attack (x3)"
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–10), –3 (11–20), –5 (21–30), Incapacitated (31–40), Dead (41+)"
            ^"Equipment" STRING "A cudgel as thick as a mill’s wheel-shaft."
            ^"Vis" STRING "4 pawns Corpus in hair."
            ^"Appearance" STRING "Scáth is twenty feet tall and weights 5 tons."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 32
        }
        PERSONALITY_TRAITS {
            "Stubborn" +6
            "Proud" +3
        }
        COMBAT {
            "Dodge" INIT -5 DEFENSE 0
            "Fist" INIT -5 ATTACK 13 DEFENSE 1 DAMAGE 10
            "Cudgel" INIT -4 ATTACK 12 DEFENSE 3 DAMAGE 17
            "Thrown stone" INIT -5 ATTACK 8 DEFENSE 1 DAMAGE 12
        }
        ABILITIES {
            "Brawl" SCORE 5 SPECIALTY "fist"
            "Irish" SCORE 4 SPECIALTY "insults"
            "Great Weapon" SCORE 6 SPECIALTY "cudgel"
            "Survival" SCORE 4 SPECIALTY "Ulster"
            "Thrown Weapon" SCORE 5 SPECIALTY "stone"
            "Swim" SCORE 1 SPECIALTY "lakes"
        }
        DESCRIPTION "He is hideous looking, with an ugly, wrinkled face, bushy eyebrows, and a shorn patch of black hair atop his head. His arms and legs are fat and puffy, and he wears a dun-colored tunic that barely covers his ample rump.\n\nScáth’s favorite attack is to grab an individual and hurl him at another opponent. To grab an individual, Scáth must succeed with a fist attack, meaning he has to have an Attack Advantage over his opponent (see grappling, **ArM5**, page 174). This attack will not do damage to the grabbed individual. The next round, Scáth throws him, making a thrown stone attack against a second opponent. If the thrown individual hits the second target, apply the Damage generated by the attack to both thrown and struck individuals. If the attack misses, the thrown individual still takes +12 damage.\n\nA grabbed character will be dropped if Scáth takes a Medium Wound while holding him. The grabbed character may make an attack, but at a penalty equal to the Attack Advantage of the attack that grabbed him."
    }

}
