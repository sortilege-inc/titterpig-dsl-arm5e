EXTENSION "ArM5_Tales_of_Mythic_Europe_TheChampionsPortion_Tables" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Two: The Champion’s Portion tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t99ce674c17711a32d77e47 ^"The Paths Through Twilight (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Ease Factor", "Length of Journey"]
            ^"Printed Name" STRING "The Paths Through Twilight"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 18
        }
        TABLE {
            "9" "One Season"
            "12" "Moon"
            "15" "Entire Day"
            "18" "Sun"
            "21" "Two Hours"
        }
    }

    #tc427e03bb31d604e674bfa ^"Into Ulster (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Simple Die", "Encounter"]
            ^"Printed Name" STRING "Into Ulster"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 22
        }
        TABLE {
            "1" "Muirgen transformed into a deer."
            "2–3" "18 kerns (a warband of 3 groups of 6 men) looking for Aedh’s father."
            "4" "A fian of 20 fénneda (a warband of 4 groups of 5 men, led by a rígfénnid)."
            "5–6" "Nothing."
        }
    }

    #t38c154f7d73402306843a4 ^"Embitterment (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Ease Factor", "Desired Effect"]
            ^"Printed Name" STRING "Embitterment"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 35
        }
        TABLE {
            "6" "Turn a man against his neighbor, business partner, or co-worker."
            "9" "Turn a man against his wife, friend, or cousin (distant kin)."
            "12" "Turn a man against his kin (father, brother, and nuclear family)."
            "15" "Turn a man against his lord."
            "18" "Turn a man against his king."
        }
    }

    #t046d5b5bcb6facc8db9580 ^"Pronunciation Guide (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Name", "Pronunciation"]
            ^"Printed Name" STRING "Pronunciation Guide"
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 10
        }
        TABLE {
            "Aedh" "**ay** (rhymes with “day”)"
            "Bricriu" "**brik**-ru"
            "Cathal" "**kath**-al"
            "Conán" "**kon**-in"
            "Muirgen" "**mur**-gen (g in “girl”, not “gem”)"
            "Ua Conchobair" "o **kon**-chov-ar"
        }
    }

}
