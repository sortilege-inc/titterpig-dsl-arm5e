EXTENSION "ArM5_Tales_of_Mythic_Europe_TheChampionsPortion_Templates" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Two: The Champion’s Portion templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #tb3b4bb80401f007b5cfbe8 TEMPLATE "Irish Kern" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per +1, Pre 0, Com –1, Str +2, Sta +2, Dex +1, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Virtues and Flaws" STRING "Peasant; Warrior; Dutybound"
            ^"Personality Traits" STRING "Loyal –1"
            ^"Combat" STRING "Dodge: Init +1, Attack n/a, Defense +5, Damage n/a Short spear: Init +3, Attack +7, Defense +5, Damage +7 Short spear thrown: Init: +1, Attack +7, Defense +5, Damage +7"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Ulster 4 (pastures), Bargain 1 (cattle prices), Brawl 4 (fist), Carouse 2 (weddings), English 2 (cattle terminology), Folk Ken 2 (peasants), Hunt 3 (cows), Irish 5 (Ulster dialect), Leadership 3 (resisting authority), Music 2 (singing), Profession: Farmer 5 (cattle), Single Weapon 3 (short spear), Stealth 3 (ambushes), Survival 2 (forests), Thrown Weapon 3 (short spear), Swim 1 (rivers)"
            ^"Equipment" STRING "Short spear"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The typical kern looks like a dirty, tunic-wearing peasant holding a short spear or two."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 23
        }
        DESCRIPTION "Kerns can’t fight in trained groups, although they will form an untrained group for combat. The maximum size of each group is six. They aren’t especially loyal, nor determined when facing superior numbers or better-armed opponents."
    }

    #tb7493bd2d0044840fcc8dc TEMPLATE "Fénnid" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per –1, Pre 0, Com –1, Str +2, Sta +2, Dex +2, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Virtues and Flaws" STRING "Outlaw; Puissant Single Weapon, Tough, Warrior"
            ^"Personality Traits" STRING "Wrathful +2, Loyal +1"
            ^"Combat" STRING "Dodge: Init +1, Attack n/a, Defense +4, Damage n/a Axe: Init +2, Attack +14, Defense +9, Damage +8 Javelin: Init +1, Attack +8, Defense +5, Damage +7 Short bow: Init 0, Attack +9, Defense +5, Damage +8"
            ^"Soak" STRING "+5"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Ulster 3 (local kings), Athletics 2 (leaping), Brawl 3 (fist), Bows 3 (short bow), Carouse 2 (extended drinking sessions), English 3 (directions), Folk Ken 2 (fianna), French 3 (property terminology), Hunt 3 (deer), Irish 5 (nobility), Leadership 4 (intimidating), Ride 4 (speed), Single Weapon 5+2 (axe), Stealth 1 (ambushing), Swim 1 (rivers), Thrown Weapon 3 (javelin)"
            ^"Equipment" STRING "Besides the typical loose-fitting tunic, a fénnid carries his weapons: a javelin, an axe, and a short bow and arrows."
            ^"Encumbrance" STRING "0 (2)"
            ^"Appearance" STRING "The typical fénnid dresses simply, in an undyed tunic. He wears his hair long and has a bushy beard."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 23
        }
        DESCRIPTION "Fénneda can fight as trained groups; their maximum size is four members and the maximum combat advantage is +12. The Outlaw Flaw mirrors the idea of the fian, but without the resulting bad Reputation."
    }

    #te69c7b4a588f68c1053063 TEMPLATE "Rígfénnid" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per –1, Pre +1, Com -2, Str +2, Sta +2, Dex +3, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "28 (28)"
            ^"Virtues and Flaws" STRING "Outlaw Leader; Improved Characteristics, Puissant Single Weapon, Warrior; Disfigured (scars and battle wounds), Reckless"
            ^"Personality Traits" STRING "Reckless +3, Loyal -1"
            ^"Combat" STRING "Dodge: Init +1, Attack n/a, Defense +5, Damage n/a Axe: Init +2, Attack +15, Defense +10, Damage +8 Javelin: Init +1, Attack +10, Defense +7, Damage +7 Short bow: Init 0, Attack +10, Defense +6, Damage +8"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Ulster 3 (local kings), Athletics 2 (leaping), Brawl 3 (fist), Bows 3 (short bow), Carouse 2 (extended drinking sessions), English 3 (directions), Folk Ken 2 (fianna), French 3 (property terminology), Hunt 3 (deer), Irish 5 (nobility), Leadership 4 (his fian), Music 1 (singing), Ride 2 (speed), Single Weapon 5+2 (axe), Stealth 3 (ambushing), Swim 1 (rivers), Thrown Weapon 4 (javelin)"
            ^"Equipment" STRING "Besides the typical loose-fitting tunic, a rígfénnid carries his weapons: a javelin, an axe, and a short bow and arrows."
            ^"Encumbrance" STRING "0 (2)"
            ^"Appearance" STRING "A rígfénnid dresses better than his followers, wearing a dyed tunic or embroidered shirt. Depending on his fortunes, he may have a silver or gold armband or torq."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 24
        }
        DESCRIPTION "A rígfénnid can lead a trained group, acting as leader and vanguard. Its maximum size is five members and the maximum combat advantage is +15."
    }

    #tc48dad348f75b77e4fb33d TEMPLATE "English Knight" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per –1, Pre –1, Com 0, Str +3, Sta +2, Dex +2, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "26 (26)"
            ^"Virtues and Flaws" STRING "Knight; Affinity with Single Weapon, Improved Characteristics; Avaricious"
            ^"Personality Traits" STRING "Avaricious +3"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +5, Damage n/a Lance and shield (mounted): Init +2, Attack +17, Defense +14, Damage +8 Long sword and shield (mounted): Init +2, Attack +16, Defense +14, Damage +9 Lance (dismounted): Init +3, Attack +8, Defense +4, Damage +10 Long sword and shield (dismounted): Init +2, Attack +13, Defense +11, Damage +9"
            ^"Soak" STRING "+11"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Athletics 4 (armored), Area Lore: Ulster 2 (castles), Brawl 4 (Dodge), English 2 (commanding peasants), Etiquette 2 (court), Flemish 1 (military commands), French 5 (courtly conversation), Great Weapon 2 (lance, dismounted), Hunt 3 (boar), Intrigue 2 (alliances), Irish 1 (insults), Leadership 2 (Flemish soldiers), Ride 3 (battle), Single Weapon 7 (lance), Welsh 1 (military commands)"
            ^"Equipment" STRING "War horse, full chainmail, lance, long sword, heater shield"
            ^"Encumbrance" STRING "1 (4)"
            ^"Appearance" STRING "A typical armored knight."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "English knights form trained groups. The maximum size is two and the maximum combat advantage is +6."
    }

    #t120bd53201c5561bce34ee TEMPLATE "Flemish Soldier" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +1, Pre 0, Com 0, Str +1, Sta +2, Dex +1, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "21 (21)"
            ^"Virtues and Flaws" STRING "Wanderer; Warrior; Simple-Minded"
            ^"Personality Traits" STRING "Distracted +2, Loyal +1"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +4, Damage n/a Pole arm: Init +2, Attack +11, Defense +7, Damage +9 Short sword: Init +0, Attack +8, Defense +5, Damage +6"
            ^"Soak" STRING "+4"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Flanders 4 (the coast), Area Lore: Ulster 1 (forests), Athletics 2 (long marches), Awareness 2 (guarding), Bargain 1 (food), Brawl 3 (dodge), Carouse 3 (excessive drinking), English 2 (farming terminology), Flemish 5 (slang), French 3 (military orders), Great Weapon 5 (pole arm), Irish 1 (insults), Leadership 2 (Flemish soldiers), Single Weapon 3 (short sword), Survival 2 (sea coasts)"
            ^"Equipment" STRING "Partial metal reinforced armor, pole arm, short sword"
            ^"Encumbrance" STRING "1 (2)"
            ^"Appearance" STRING "The typical Flemish soldier lives in his armor. He is dirty, far from home, and often bored."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "Flemish soldiers can fight as a trained group. The group’s maximum size is 3 (counting their specialty) and the maximum combat advantage is +9."
    }

    #ta4925a73a51139023b89f5 TEMPLATE "Welsh Bowman" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per +2, Pre -1, Com 0, Str +2, Sta 0, Dex +2, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "21 (21)"
            ^"Virtues and Flaws" STRING "Wanderer; Affinity with Bows, Warrior; Compulsion (gambling), Infamous"
            ^"Personality Traits" STRING "Rambunctious +2, Loyal +1"
            ^"Reputations" STRING "Invaders 4 (Irish natives)"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +3, Damage n/a Dagger: Init +0, Attack +8, Defense +4, Damage +5 Long bow: Init -2, Attack +14, Defense +8, Damage +10"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Wales 3 (mountains), Area Lore: Ulster 1 (Norman lords), Athletics 1 (jumping), Awareness 2 (keeping watch), Bows 7 (long bow), Brawl 3 (dagger), Carouse 2 (games of chance), Craft: Bow-making 2 (superior quality), Craft: Fletching 2 (superior quality), Folk Ken 2 (prostitutes), English 3 (slang), French 2 (military orders), Flemish 2 (gambling jargon), Stealth 3 (ambushes), Welsh 5 (storytelling)"
            ^"Equipment" STRING "Heavy leather armor, dagger, plus long bow and arrows"
            ^"Encumbrance" STRING "0 (2)"
            ^"Appearance" STRING "A Welsh bowman dresses similarly to an Irish kern, except he’ll wear partial leather armor over his tunic. He goes barefoot, always has his bow, and seems to enjoy his time in Ulster more than his fellow Flemish mercenaries."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Welsh bowmen do not fight in trained groups, but usually form up as an untrained group. Their maximum size is six."
    }

    #tec59b444144a351c8481e2 TEMPLATE "Hero of Ulster" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 15
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER -2
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 8
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER -1
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Magic Human; Focus Power, Gigantic; Tough; Monstrous Appearance, Proud"
            ^"Soak" INTEGER 7
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Equipment" STRING "Archaic clothing, wooden shield, spear, and assorted jewelry."
            ^"Vis" STRING "3 pawns Corpus in head."
            ^"Appearance" STRING "A Hero appears as a large, monstrous-looking Irish warrior, with tangled hair, a wild beard, red eyes, embroidered clothing, and weapons. His features are asymmetric, and his muscles bulge and contort in an abnormal fashion."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 15
        }
        PERSONALITY_TRAITS {
            "Brave" +3
            "Proud" +3
            "Disobedient" +2
        }
        COMBAT {
            "Dodge" INIT -1 DEFENSE 5
            "Fist" INIT -1 ATTACK 10 DEFENSE 6 DAMAGE 8
            "Spear and Round Shield" INIT 1 ATTACK 16 DEFENSE 12 DAMAGE 13
        }
        ABILITIES {
            "Animal Handling" SCORE 3 SPECIALTY "cattle"
            "Athletics" SCORE 6 SPECIALTY "leaping"
            "Brawl" SCORE 6 SPECIALTY "fist"
            "Carouse" SCORE 5 SPECIALTY "excessive drinking"
            "Etiquette" SCORE 4 SPECIALTY "feasting"
            "Hunt" SCORE 5 SPECIALTY "deer"
            "Irish" SCORE 5 SPECIALTY "poetry"
            "Leadership" SCORE 3 SPECIALTY "Followers"
            "Music" SCORE 4 SPECIALTY "singing"
            "Ride" SCORE 2 SPECIALTY "tricks"
            "Survival" SCORE 3 SPECIALTY "in the regio"
            "Single Weapon" SCORE 10 SPECIALTY "spear"
        }
        POWERS {
            #t3bb893703733132121e01a ^"Perfect Form of the Contender" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "-4"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This power gives the recipient a +3 on any physical challenge he undergoes, including combat. Like spontaneous magic, it can affect a variety of the target’s physical resources: arms, legs, breathing, singing, etc. (Base special, Range: Per, Duration: Sun, Target Ind., +2 Size adjustment)"
            }
        }
    }

    #tb3fbb3a4acea39441d98f7 TEMPLATE "Follower of Ulster" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 5
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 1
            ^"Virtues and Flaws" STRING "Magic Human; Tough, Large; Monstrous Appearance"
            ^"Soak" INTEGER 7
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Equipment" STRING "Archaic clothing, wooden shield, spear, and assorted jewelry."
            ^"Vis" STRING "1 pawn Corpus in head."
            ^"Appearance" STRING "A Follower appears as a smaller version of a Hero of Ulster."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 16
        }
        PERSONALITY_TRAITS {
            "Brave" +2
            "Rowdy" +2
            "Loyal" +1
        }
        COMBAT {
            "Dodge" INIT 2 DEFENSE 2
            "Fist" INIT 2 ATTACK 5 DEFENSE 5 DAMAGE 2
            "Spear and Round Shield" INIT 3 ATTACK 11 DEFENSE 11 DAMAGE 7
        }
        ABILITIES {
            "Animal Handling" SCORE 2 SPECIALTY "chariot horses"
            "Athletics" SCORE 2 SPECIALTY "running"
            "Awareness" SCORE 4 SPECIALTY "guarding"
            "Brawl" SCORE 2 SPECIALTY "fist"
            "Carouse" SCORE 3 SPECIALTY "excessive drinking"
            "Etiquette" SCORE 2 SPECIALTY "carving"
            "Hunt" SCORE 2 SPECIALTY "tracking"
            "Irish" SCORE 5 SPECIALTY "poetry"
            "Music" SCORE 2 SPECIALTY "harp"
            "Survival" SCORE 1 SPECIALTY "in the regio"
            "Single Weapon" SCORE 6 SPECIALTY "spear"
        }
        DESCRIPTION "Followers are the generic supporters and assistants of the Heroes of Ulster. Although they are magic humans, they have no innate magical powers. If lead by a Hero, Followers can fight in a trained group. The maximum size of the group is 4, including the Hero, and the combat advantage is +12."
    }

}
