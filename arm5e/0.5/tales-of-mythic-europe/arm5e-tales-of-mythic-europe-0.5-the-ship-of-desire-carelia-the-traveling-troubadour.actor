EXTENSION "ArM5_Tales_of_Mythic_Europe_TheShipOfDesire_CareliaTheTravelingTroubadour" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Carelia the Traveling Troubadour"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # Carelia the Traveling Troubadour (Chapter Three: The Ship of Desire, p41): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t36bcfdaffd08f13f9d118e ^"Carelia the Traveling Troubadour" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +2, Pre +1, Com +4, Str –2, Sta –2, Dex +2, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "30 (30)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Wanderer; Free Expression, Great Communication, Puissant Music, Second Sight, Well-Traveled; Dependent (Elena); Noncombatant, Offensive to Animals"
            ^"Personality Traits" STRING "Loyal (to being independent) +3, Self-Sufficient +2"
            ^"Reputation" STRING "Musician 5"
            ^"Combat" STRING "Dodge: Init –1, Attack n/a, Defense –1, Damage n/a"
            ^"Soak" STRING "–2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Athletics 1 (running), Awareness 3 (audience reactions), Bargain 3 (performance remuneration), Charm 3 (potential patrons), English 3 (poetry), Folk Ken 3 (audiences), French 4 (poetry), Languedoc Lore 3 (cities), Music 6 (recorder), Occitan 5 (poetry), Second Sight 3 (ghosts), Stealth 2 (hide), Survival 4 (hills), Swim 1 (rivers), Teaching 3 (music)"
            ^"Equipment" STRING "Besides her clothing, Carelia carries a recorder, a thin reed instrument made of wood."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Carelia has an almost regal bearing, despite being born from the lower class of society. She wears a tight red dress under a maroon traveling cloak. Her hair is dark and streaked with gray, braided and worn atop her head under a plain white cap."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "Carelia is a musician and traveler. She has abandoned the normal way of life associated with a woman in exchange for hardships on the road, suspicion, danger, even death at the hands of an unknown highwayman or drunken knight. Yet she perseveres, unwilling to sink into the ranks of mothers, whores, and washerwomen. Love is a foreign emotion to her; love does not fit into schedules, practices, performances, and life on the move. Love, for her, is confined to her notion of independence — of not needing a man, lord, or savior — and to her idea of freeing herself from society’s gender conventions."
    }

}
