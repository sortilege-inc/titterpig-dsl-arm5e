EXTENSION "ArM5_Tales_of_Mythic_Europe_WarringFamilies_BaldwinTheVillageElder" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Baldwin the Village Elder"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # Baldwin the Village Elder (Chapter Nine: Warring Families, p140): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t9da4fc63fd38fb50048f3d ^"Baldwin the Village Elder" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per–1, Pre +1, Com0, Str +1, Sta +0, Dex +0, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "64 (70)"
            ^"Decrepitude" STRING "2"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Peasant; Temporal Influence; Gossip; Enfeebled, Envious (Minor), Poor Eyesight"
            ^"Personality Traits" STRING "Meddler +3, Honest +3, Loyal +2"
            ^"Reputations" STRING "Influential Villager +3 (local)"
            ^"Combat" STRING "Fist: Init –1, Attack +3, Defense +3, Damage +1"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 3 (sheep), Area Lore: Local 6 (farms), Athletics 3 (climbing), Awareness 5 (fields), Bargain 4 (villagers), Brawl 3, Carouse 1 (festivals), Charm 4 (family), Etiquette 2 (superiors), Folk Ken 6 (villagers), Music 2 (festivals), Native Language 5 (farming), Profession: Farming 7 (large farms), Single Weapon 1 (axe), Survival 2 (fields)"
            ^"Equipment" STRING "Farming tools, tunic, cloth cloak."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Baldwin is an aging and balding man, with a wrinkled face, squinting eyes, and slightly trembling hands. He wears well-made but simple clothes, although he shows some ostentation with a magnificent silver belt buckle."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 140
        }
        DESCRIPTION "Baldwin is the rival village elder to Peter, and is a minor officer of the local lord (such as a reeve or similar appropriate position). Until Peter’s return from the Fourth Crusade, Baldwin’s father was the most respected and influential man in the village; Baldwin inherited that position when his father passed away. Following the death of the previous village priest, Peter’s influence and authority over the village increased, to Baldwin’s detriment.\n\nBaldwin and Peter are in a bitter dispute over the boundary of some land that both claim to own. The plot runs along a small stream, which recently dramatically changed its course after a flood burst its banks and diverted it for several miles. This is the same stream that runs through the village, although the land is a mile or so away from the village proper.\n\nBaldwin is a grumpy old man, approximately sixty years old, with a large extended family — several sons and daughters and a veritable army of grandchildren and great-grandchildren. There is an air of bitterness and resentment held by Baldwin and his children towards Peter, and also towards Father Herbert.\n\nOne of Baldwin’s nephews, Conrad, has been kidnapped by the infernalists."
    }

}
