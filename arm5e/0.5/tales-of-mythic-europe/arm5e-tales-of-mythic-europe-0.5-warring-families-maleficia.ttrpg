EXTENSION "ArM5_Tales_of_Mythic_Europe_WarringFamilies_Maleficia" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Nine: Warring Families maleficia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's maleficia, structured; each DESCRIPTION the source's text, verbatim.

    #t9e3f33dc52aa62a34bf358 ^"Flying on the Devil’s Breath" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Owner" STRING "Michael, Cult Leader"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +3 Sight, +1 Conc)"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 20 R: Sight, D: Conc, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 142
        }
        DESCRIPTION "This power summons powerful winds, great enough to lift a person through the air at high speed. The character must concentrate to control the winds, and cannot do so if they are out of his sight. Michael uses this power on himself to fly around, but can also use it on others. Using this power on himself and another person simultaneously requires Concentration rolls."
    }

    #t96cb883db6dad5173c6310 ^"Hell’s Bellows" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Owner" STRING "Michael, Cult Leader"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +2 Voice, +1 Conc)"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 15 R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 142
        }
        DESCRIPTION "This power causes a fire to increase in heat, which increases the damage caused by the fire by +4."
    }

    #tace06a1d063d7fc4d78c2d ^"Lucifer’s Tongs" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Owner" STRING "Michael, Cult Leader"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +3 Sight, +1 Diam)"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 20 R: Sight, D: Diam, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 142
        }
        DESCRIPTION "Metal objects become red hot when this power is used, causing +6 damager per round to characters touching the metal."
    }

    #t1a589ee9dcaf9e08620d15 ^"Ruin Crops" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Owner" STRING "Michael, Cult Leader"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +3 Sight, +2 Sun, +2 size)"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 20 R: Sight, D: Sun, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 142
        }
        DESCRIPTION "This power turns rain into hail, which causes a great deal of damage to crops and property. People caught in the hail take +2 damage per round they are directly exposed to the hail."
    }

    #t7e1b6e78a0af33f59bbec2 ^"Shroud of the Forsaken" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Owner" STRING "Michael, Cult Leader"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, +4 Boundary)"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 25 R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 142
        }
        DESCRIPTION "With this power, the light of the moon and starlight at night is darkened to almost nothing, shrouding the land in darkness. With all natural light mostly extinguished, only artificial light can illuminate the affected land."
    }

}
