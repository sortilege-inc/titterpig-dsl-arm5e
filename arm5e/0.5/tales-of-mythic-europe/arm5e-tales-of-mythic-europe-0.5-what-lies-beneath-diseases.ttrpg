EXTENSION "ArM5_Tales_of_Mythic_Europe_WhatLiesBeneath_Diseases" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Ten: What Lies Beneath diseases"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's diseases, structured; each DESCRIPTION the source's text, verbatim.

    #te19d7b4fe58744fd310f87 ^"Marsh Sickness" DEF {
        EXTENDS #t52385d670620f6b4d70ab1 ^"Disease"
        PROPERTIES {
            ^"Disease Penalty" STRING "Serious"
            ^"Humor" STRING "Sanguine"
            ^"Severity" INTEGER 11
            ^"Stable Ease Factor" STRING "9"
            ^"Improvement Ease Factor" STRING "12"
            ^"Interval" STRING "Month"
            ^"Symptoms" STRING "Bouts of high fever, chills, and sweating accompanied by nausea, abdominal cramps, fatigue, and muscle pain."
            ^"Printed Stat Line" STRING "Serious Sanguine Disease, Severity 11 Stable: 9, Improve: 12, Interval: Month"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 162
        }
        DESCRIPTION "Marsh Sickness (malaria) is caused by the body reacting to the unhealthy waters of the marsh.\n\nMarsh sickness has been described above in accordance with the disease rules in *Art & Academe*. If you do not have those on hand, use the disease rules in the core rulebook (**ArM5**, page 180) and treat this disease as a Medium Wound.\n\nTo avoid contracting the disease, the character must make a Disease Avoidance roll.\n\n**Disease Avoidance: **\n\n**Stamina + Living Conditions Modifier + (Corpus/5) **\n\n**+ Wound Penalty + stress die**\n\n**Ease Factor: Stable Ease Factor of the disease**\n\nIf the character fails the roll, he starts to suffer the effects. If the Disease Avoidance roll botches, then the disease is contracted at one step (for each 0 on the botch dice) more serious than usual."
    }

}
