EXTENSION "ArM5_The_Contested_Isle_DivineLandscape_SaintBrendanTheNavigatorNaomhBreandan" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Brendan the Navigator (Naomh Breandán)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Saint Brendan the Navigator (Naomh Breandán) (Chapter Twelve: The Divine Landscape, p136): one saint, its stat lines verbatim fields.

    #ta24750c6d83f7d33aeb138 ^"Saint Brendan the Navigator (Naomh Breandán)" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Explorers, Navigators, Clonfert, Ardfert."
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Connacht, especially Ardfert, Inishdadroum, Clonfert, Annaghdown."
            ^"Saint Powers" LIST OF STRING ["Apparition", "Expel Demons", "Hide Fugitive", "Raise the Dead", "Still the Waves", "Tame the Wild Beast"]
            ^"Feast" STRING "16th May"
            ^"Personality Traits" STRING "Pious +3, Inquisitive +2, Brave +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 136
        }
        DESCRIPTION "St. Brendan is perhaps best remembered for his great voyages to explore the isles of the west and to the Isle of the Blessed, but he was an abbot, founder of monasteries, and great miracle-worker as well. His relics lie at Clonfert. One of his strangest miracles was to make an escaped slave appear as a rock, and the rock as the fugitive, so his pursuers carried off the stone thinking they had recaptured their man."
    }

}
