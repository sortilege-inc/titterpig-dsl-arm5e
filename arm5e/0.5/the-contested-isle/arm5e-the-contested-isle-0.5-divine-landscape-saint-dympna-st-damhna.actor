EXTENSION "ArM5_The_Contested_Isle_DivineLandscape_SaintDympnaStDamhna" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Dympna (St. Damhna)"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Saint Dympna (St. Damhna) (Chapter Twelve: The Divine Landscape, p136): one saint, its stat lines verbatim fields.

    #tf022852593417fb3b5442f ^"Saint Dympna (St. Damhna)" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Ghent, Tydavenet, the Insane, the Anxious"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Ulster, Flanders, especially Ghent."
            ^"Saint Powers" LIST OF STRING ["Apparition", "Cure Madness", "Grant of Serenity", "Sanctuary of Virginity", "Test of Truth"]
            ^"Feast" STRING "15th May"
            ^"Personality Traits" STRING "Pious +3, Innocent +2, Compassionate+2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 136
        }
        DESCRIPTION "Just fifteen years of age at the time of her death, St. Dympna is unusual in that she is venerated both by the Irish and by the Flemish mercenaries used by the English. The daughter of a king, tragedy struck when her mother died. Her father, seeing much of her beloved wife in her, tried to marry her, and horrified she fled to Ghent in Flanders where she was eventually killed by his men. Her bachall or staff is a relic still preserved at the village of Tydavnet in Ulster, and has the power to discern the truth."
    }

}
