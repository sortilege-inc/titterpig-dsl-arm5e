EXTENSION "ArM5_The_Contested_Isle_DivineLandscape_SaintKevinOfGlendaloughSaintCoemgen" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Kevin of Glendalough (Saint Cóemgen)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Saint Kevin of Glendalough (Saint Cóemgen) (Chapter Twelve: The Divine Landscape, p135): one saint, its stat lines verbatim fields.

    #t55c0c97bfd6733e668375d ^"Saint Kevin of Glendalough (Saint Cóemgen)" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Dublin, Glendalough, and Crows"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Leinster."
            ^"Saint Powers" LIST OF STRING ["Apparition", "Counting Sheep", "Protect the Wild Prey", "Raise the Dead", "Strange Fruit", "Tame the Wild Beast"]
            ^"Feast" STRING "3rd June"
            ^"Personality Traits" STRING "Pious+3, Gentle+2, Reclusive+2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "An Irish hermit of royal blood, Kevin attracted followers by his personal holiness, so moved to the remote hill at Glendalough to escape them. When they followed anyway he founded a monastery here. His most famous miracle involves making apples grow on willow trees, but he was renowned for his love of wild creatures, who often aided him in his exploits. His name Cóemgen means “gentle one.”"
    }

}
