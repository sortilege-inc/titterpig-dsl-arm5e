EXTENSION "ArM5_The_Contested_Isle_DivineLandscape_SaintSenanMacGeirrcinn" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Senan mac Geirrcinn"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Saint Senan mac Geirrcinn (Chapter Twelve: The Divine Landscape, p137): one saint, its stat lines verbatim fields.

    #t0789ed6bb21f1ccca79fc9 ^"Saint Senan mac Geirrcinn" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Scattery Island, the Corco Baiscinn and the Uí Fhidgeinte."
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Munster"
            ^"Saint Powers" LIST OF STRING ["Acknowledgement of Evil", "Apparition", "Banish Magical Monster", "Call Forth the Waters", "Dysentric Infliction"]
            ^"Feast" STRING "8th March"
            ^"Personality Traits" STRING "Pious+3, Misogynistic +2, Righteous Wrath+2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "Saint Senan is most renowned for his triumph over the evil sea serpent the Scathach that ate any who sailed near Scattery Island. He was determined to found a monastery there, and miraculously banished the beast with the sign of the Cross. He later prevailed over many other monsters with prayer, and cursed to death many evildoers and bandits. While he loved his sister Saint Ibie he would not have her buried on the island, where women were strictly forbidden, so on death he buried her between the low and high tide mark. She was luckier than another woman who came to try to talk with the saint; she died on her boat on the beach, having waited for years for permission to come ashore."
    }

}
