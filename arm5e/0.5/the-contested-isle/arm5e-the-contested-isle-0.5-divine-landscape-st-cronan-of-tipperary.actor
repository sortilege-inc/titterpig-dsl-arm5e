EXTENSION "ArM5_The_Contested_Isle_DivineLandscape_StCronanOfTipperary" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - St. Cronan of Tipperary"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # St. Cronan of Tipperary (Chapter Twelve: The Divine Landscape, p137): one saint, its stat lines verbatim fields.

    #t640c76660cc4d6fd576c1f ^"St. Cronan of Tipperary" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Diocese of Roscrea"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Munster, especially Tipperary and the diocese of Roscrea"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Walk Upon the Waters", "Raise the Dead", "Tame the Wild Beast", "Celestial Immunity", "Bless the Book", "The Sky Made Light"]
            ^"Feast" STRING "28th April"
            ^"Personality Traits" STRING "Pious +3, Passive+2, Protective +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "St. Cronan lived in a time when many fierce raiders troubled the land of Ireland. He protected his parishioners from many attacks by working a miracle to make their enemies’ weapons useless against them, though finally he and his monks chose to submit to martyrdom at the hands of the Vikings when they burned his monastery."
    }

}
