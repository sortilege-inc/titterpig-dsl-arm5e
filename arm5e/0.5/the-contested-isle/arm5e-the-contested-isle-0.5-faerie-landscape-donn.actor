EXTENSION "ArM5_The_Contested_Isle_FaerieLandscape_Donn" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Donn"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Donn (Chapter Eleven: The Faerie Landscape, p127): one being, its stat lines verbatim fields.

    #t28d9b537fa2cccb376198c ^"Donn" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 50
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 1
            ^"Confidence" STRING "4 (3)"
            ^"Virtues and Flaws" STRING "Negative Reaction; Greater Power (x1); Faerie Sight, Faerie Speech, Highly Cognizant, Humanoid Faerie, Large, Lesser Power (x2), Personal Power, Reputation as Confidence; Vulnerable to Salt Water, Infamous, Traditional Ward (red ribbon tied to the tail or in the hair)"
            ^"Reputations" LIST ["The Dark One 4 (Hibernia’s Irish Population)"]
            ^"Soak" INTEGER 3
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Pretenses" STRING "Animal Handling 3 (chariots), Athletics 3 (leaping), Etiquette 3 (hosting feasts), Faerie Lore 2 (the Tuatha Dé), Single Weapon 8 (long sword)"
            ^"Equipment" STRING "Weapons and gear befitting a warrior and a chariot drawn by a team of four horses."
            ^"Vis" STRING "10 pawns of Corpus vis, one in each of the severed heads Donn has tied to his leather belt."
            ^"Appearance" STRING "Donn stands 7’ high, naked except for a wide leather belt that covers his stomach. His chest, arms, and legs are covered in blue tattoos and ten human heads hang from his belt. He grips a huge spear in his left hand and a sword in his right, and the blades of both weapons continually drip blood."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 127
        }
        PERSONALITY_TRAITS {
            "Hates Goibhniu" +3
            "Rapacious" +2
            "Taciturn" +3
        }
        COMBAT {
            "Short Spear" INIT 3 ATTACK 13 DEFENSE 9 DAMAGE 7
            "Short Spear from Chariot" INIT 3 ATTACK 16 DEFENSE 12 DAMAGE 7
            "Long Sword" INIT 3 ATTACK 16 DEFENSE 11 DAMAGE 8
            "Long Sword from Chariot" INIT 3 ATTACK 19 DEFENSE 14 DAMAGE 8
        }
        POWERS {
            #t4eb26d4970628ae99c8f86 ^"Create the Dead Host" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–10"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Donn can create a human corpse that is a perfect image of any man or woman that Donn wishes. Donn must be able to see the person as he performs this power. (Base 5, +1 Touch, +3 Moon)"
            }
            #t2d0762acecc9f530a16ffa ^"Bursting the Heart Vessel" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–4"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "By touching a victim Donn can cause the target’s heart to burst, killing the target instantly. (Base 30, +1 Touch. Excess Greater Power levels used to reduce point cost.)"
            }
            #tb7c30744b5ccb19e8ea16b ^"Summon the Curtains of Donn" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–10"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Donn can make fog grow from his finger tip, forming a fog bank one mile in diameter. Once formed the fog reacts normally. Donn likes to obfuscate his entrance and exit. (Base 2, +1 Touch, +2 Sun, +2 Group, +1 Size, +1 slightly unnatural)"
            }
            #t9c92353df99377ad2666cb ^"Transform into Animal (The Contested Isle)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Transform into Animal"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "Donn can change into various animals, including a fish, bull, stag, hawk, and boar. He typically uses this power when fighting his faerie enemy Find (see Chapter 9). (Base 10, +2 Sun, +1 size)"
            }
        }
        DESCRIPTION "The Dark One, Donn is the death-god of the Tuatha Dé. Like a mundane king, he has sons, keeps cattle, and raids his neighbors. His palace, the rocky island of Teach Duínn off the Munster coast, is where the dead assemble. During wartime, Donn’s three red-haired sons ride through the country spreading terror. They say the slain will rise at Teach Duínn and join Donn’s army.\n\nAt other times Donn wanders the land increasing his army one soldier at a time. He likes to kill a sleeping man, leaving the body behind while the spirit flies to Tech Duínn. Another favorite tactic is leaving a false replica of the man’s corpse and take the still living prisoner back to Teach Duínn. No one knows why Donn is building an army, other than the fact that he is a king and that is what kings do.\n\nIn his house of Teach Duínn, Donn has items that compel the dead, both shuffling corpse and haunting spirit, to do his will. No one knows why he sometimes take living captives. Perhaps he uses them for servants; perhaps as husbands for his daughters; or test subjects for his druids.\n\nDonn is an unbalanced, storyguide character. He has more Pretenses that normally allowable because of his age and observance of human society. Donn works well in stories about feuds, because he has many enemies, and conflict, because he and his sons like to fight.\n\nDonn fought against the Order of Hermes during the Schism War. His large, protected regio may hide an army, and magi wonder if he is preparing for another invasion. Some fear that the constant conflict in Munster may spur another war with Donn. For those starting a war with the Order, Donn is a likely ally."
    }

}
