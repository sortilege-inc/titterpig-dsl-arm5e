EXTENSION "ArM5_The_Contested_Isle_InfernalLandscape_TheSluagh" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - The Sluagh"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The Sluagh (Chapter Thirteen: The Infernal Landscape, p142): one being, its stat lines verbatim fields.

    #t04cb3a7ed65a8a800202ca ^"The Sluagh" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Evil Spirit"
            ^"Might" INTEGER 5
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 0
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Virtues and Flaws" STRING "Berserk, Sharp Ears; Blind"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Combat" STRING "Dodge: Init +2, Attack N/A, Defense +7, Damage N/A Large Teeth: Init +2, Attack +10, Defense +7, Damage +3 Grapple: Init +2, Attack +7, Defense +8, Damage +0"
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Weakness" STRING "Compulsiveness (can only enter houses by open west-facing windows)"
            ^"Vis" STRING "1 Mentem, Vis Infesta (Realms of Power: The Infernal, page 18)."
            ^"Appearance" STRING "These emaciated creatures are grey-skinned and have long sparse hair hanging from their scratched and gouged scalps. Their lips are drawn back so fiercely that their jaws are entirely exposed and their blind eyes lack any lids. They fly through the air, their tattered rags flowing around them as though being drawn through water."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 142
        }
        PERSONALITY_TRAITS {
            "Selfish" +5
            "Cruel" +4
        }
        ABILITIES {
            "Area Lore: County" SCORE 5 SPECIALTY "settlements"
            "Athletics" SCORE 3 SPECIALTY "flying at speed"
            "Brawl" SCORE 5 SPECIALTY "grappling"
        }
        POWERS {
            #tcf36912ecaf7f0db5fa678 ^"Let Me In" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Herbam"
                }
                DESCRIPTION "Although intangible, the Sluagh may rattle doors and shutters that have been closed. It uses this power against any west-facing windows that have been stopped up against it."
            }
            #t748e747eb7e493fdd6d114 ^"Come With Me" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The Sluagh drags the last breath from a target, drawing the spirit out with it. If the Sluagh is then able to race a mile away with that spirit it too becomes one of the Sluagh. If it loses its grip, another Sluagh may expend the Might Points and try to drag the spirit a mile."
            }
        }
        DESCRIPTION "The Sluagh are blind but have keen hearing. If using the rules for magical combat published in *Houses of Hermes: Societates *(page 33), Sluagh treat all opponents as “Indistinct,” which gives the opponent a +3 attack bonus and a +6 defense bonus. This does not apply to grappling attacks. They are selfish by nature and while they travel together they always fight in *untrained* groups.\n\nThe Sluagh often leave damp patches behind them in places from where they take their victims, a result of their excited salivation."
    }

}
