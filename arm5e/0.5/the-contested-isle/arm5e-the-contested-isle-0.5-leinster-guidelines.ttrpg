EXTENSION "ArM5_The_Contested_Isle_Leinster_Guidelines" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Six: The Province of Leinster guidelines"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tc800c61eae005b0d190ead ^"Perdo Vim Guidelines (The Contested Isle, New Guidelines: Perdo Vim)" DEF {
        EXTENDS #tIHnYX4FF4IJ6Zh8Wh2D5gBk ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Printed Name" STRING "New Guidelines: Perdo Vim"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 63
        }
        GUIDELINES {
            "General" "Dispel Hermetic Form Resistance aligned to a given Form with a level less than or equal to the level of the Vim spell + 10 + a stress die (no botch). Spell must penetrate the Vim-based Magic Resistance of the target."
            "General" "Dispel Magic Resistance from a Might score aligned to one Realm with a level less than or equal to the level of the Vim spell + 20 + a stress die (no botch). Spell must penetrate the Vim-based Magic Resistance of the target."
        }
    }

}
