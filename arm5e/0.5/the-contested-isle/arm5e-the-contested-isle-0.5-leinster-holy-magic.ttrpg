EXTENSION "ArM5_The_Contested_Isle_Leinster_HolyMagic" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Six: The Province of Leinster holy magic"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The chapter's holy magic, structured; each DESCRIPTION the source's text, verbatim.

    #tee6d9ab556376ee69419d3 ^"For they are life to those who find them, and healing to all their flesh" DEF {
        EXTENDS #tdde7bcb30a02cb13eb5677 ^"Holy Effect"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrCo 20 (Ritual). R: Touch; D: Momentary; T: Individual"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Resolves successfully a Minor Aging Crisis.\n\n(Base 15, +1 Touch)"
    }

    #td9f6f57637b70e6e712a7c ^"Put on the whole armor of God, that you may be able to stand against the schemes of the Devil" DEF {
        EXTENDS #tdde7bcb30a02cb13eb5677 ^"Holy Effect"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sabbath"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuCo 20 R: Personal; D: Sabbath; T: Individual"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Makes the body more resistant to damage, granting +5 to Soak. No visible effect occurs on the Holy Magus, for this is the armor of righteousness. The spell lasts until the next Sunday, but has no effect at all if cast on the Sabbath.\n\n(Base 10; General Transcendence/ Purity; +2 Sabbath)"
    }

    #t1a988089169802eae9035e ^"It will be health to your flesh, and strength to your bones" DEF {
        EXTENDS #tdde7bcb30a02cb13eb5677 ^"Holy Effect"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 20 R: Personal; D: Sun; T: Individual"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "The target’s body acts as if unwounded and unfatigued. Wound and fatigue penalties do not apply until the spell expires, and wounds may worsen but this will not be apparent until the spell ends, when accumulated Fatigue takes effect (and may leave the target unconscious). Consecutive castings delay the end of the spell, putting off the time until the accumulated wounds take effect — but the body can only take a number of consecutive castings equal to its Size + 2. Further castings have no effect. (Base 10 Transcendence/Purity; +2 Sun)"
    }

    #t2f06946adab2ffb73951c4 ^"That I may come unto you with joy by the will of God, and may with you be refreshed" DEF {
        EXTENDS #tdde7bcb30a02cb13eb5677 ^"Holy Effect"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 25 R: Personal; D: Momentary; T: Individual"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Your faith in God immediately restores a single lost Fatigue level, something impossible for Hermetic magic.\n\n(Base 25 Transcendence/Purity)"
    }

    #tdec37c98656e653e632831 ^"Then I was the craftsman at his side. I was filled with delight day after day" DEF {
        EXTENDS #tdde7bcb30a02cb13eb5677 ^"Holy Effect"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReHe 15 R: Touch; D: Momentary; T: Individual"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Permanently mends a non-living product made of plant materials, sealing rips and tears and reattaching separated parts, though missing pieces are not restored.\n\n(Base: 10, Intervention/Purity; +1 Touch)"
    }

}
