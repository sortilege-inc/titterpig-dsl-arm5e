EXTENSION "ArM5_The_Contested_Isle_MagicalLandscape_FomoirOptions" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Ten: The Magical Landscape fomoir options"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The chapter's fomoir options, structured; each DESCRIPTION the source's text, verbatim.

    #t032bd6a3175ee26b91fdbf ^"Huge (Fomóir Quality)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Huge"
            ^"Kind" STRING "Quality"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "gain +2 to Size; this also adds 4 to Strength but subtracts 2 from Quickness. This may be taken along with Large."
    }

    #t5f6e3c407c9608cb1eb748 ^"Large (Fomóir Quality)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Large"
            ^"Kind" STRING "Quality"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "gain +1 to Size; this also adds 2 to Strength but subtracts 1 from Quickness. This may be taken along with Huge."
    }

    #t1b51c2990bc2b0c297b4c3 ^"Improved Soak (Fomóir Quality)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Improved Soak"
            ^"Kind" STRING "Quality"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "+3 to Soak. This can be taken multiple times."
    }

    #tda7ecd006a1283042d2d00 ^"Improved Initiative (Fomóir Quality)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Improved Initiative"
            ^"Kind" STRING "Quality"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "+3 to Initiative with one weapon. This can be taken multiple times, and it can apply to different weapons or stack with the same weapon"
    }

    #t8b18cb7c43a9ee2ab4fd38 ^"Improved Attack (Fomóir Quality)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Improved Attack"
            ^"Kind" STRING "Quality"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "+2 to Attack Totals with one weapon. This can be taken multiple times, and it can apply to different weapons or stack with the same weapon"
    }

    #td596bfe550ced259512c28 ^"Deaf (Fomóir Inferiority)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Deaf"
            ^"Kind" STRING "Inferiority"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "As the Major Flaw"
    }

    #tfd698e9f43f0552a115fae ^"Monstrous Appearance (Fomóir Inferiority)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Monstrous Appearance"
            ^"Kind" STRING "Inferiority"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "All *Ríastradh* cause terrible contortions, but yours are particularly severe. Your limbs may rearrange themselves, or you might grow new ones, your hair could turn into snakes, etc. Be creative! These changes have a cosmetic effect only (the character gains no extra powers or attacks), but make all social interaction with humans impossible — including leading a trained group."
    }

    #t5312b12e0b8b6c41ae5445 ^"Bloodlust (Fomóir Inferiority)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Bloodlust"
            ^"Kind" STRING "Inferiority"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "The character must continue to fight until the *Ríastradh* ends. If he runs out of enemies, he must attack innocents or his friends, and cannot hold back."
    }

    #t4a42bb11563ab3d4f36c1e ^"Reduced Defense (Fomóir Inferiority)" DEF {
        EXTENDS #tb15f735c6ba29f69708870 ^"Fomóir Option"
        PROPERTIES {
            ^"Printed Name" STRING "Reduced Defense"
            ^"Kind" STRING "Inferiority"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "–3 to all Defense Totals. If the *Ríastradh* involves a change in Size, then all armor is shed as the change takes place. *Ríastradh* provides immunity to Fatigue Penalties; the character still gains Fatigue levels, but they do not penalize any rolls or totals until the character reaches Unconscious. *Ríastradh* only ends once the character falls loses consciousness from Fatigue or other means (such as magic). A character can hasten the end of the *Ríastradh *by spending Fatigue in exertion (**ArM5**, page 173)."
    }

}
