    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #tf3fdb5d634ae9b12dec79f ^"The Book of Kells" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Book of Kells"
            ^"Kind" STRING "Summa"
            ^"Quality" INTEGER 9
            ^"Section" STRING "The Book of Kells"
            ^"Printed Entry" STRING "The Book of Kells is a Quality 9 summa with a Level of 5 in Theology and 3 in Dominion Lore if studied, and may have other secrets."
