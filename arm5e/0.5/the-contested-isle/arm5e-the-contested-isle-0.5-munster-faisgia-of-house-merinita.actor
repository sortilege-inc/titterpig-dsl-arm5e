EXTENSION "ArM5_The_Contested_Isle_Munster_FaisgiaOfHouseMerinita" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Faisgia of House Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Faisgia of House Merinita (Chapter Eight: The Province of Munster, p83): one character, its stat lines verbatim fields.

    #tbeec3f174c171da629a47e ^"Faisgia of House Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t55cd843a02fffe7ec1423f ^"Cliffheart"]
            ^"Age" STRING "157 (apparent age: 98)"
            ^"Personality Traits" STRING "Cranky +3"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Filius of one of Cliffheart’s founders, Faisgia (FASH-yuh) is the leader of Cliffheart. He spends most of his time wandering Munster looking for faeries who participated in the Schism War. He is in charge of maintaining the cathach, annually casting the spell that keeps the Deidne magus transformed into a stone. He is also responsible for the Rego Terram spells that move the cathath to each Tribunal meeting.\n\nSome magi suspect that Faisgia ambushed Conán Derg and maimed the former praeco, since the assault happened in one of Faisgia’s frequent traveling grounds. Conán Derg does not refuse or confirm this information, and Faisgia scoffs when it is mentioned."
    }

}
