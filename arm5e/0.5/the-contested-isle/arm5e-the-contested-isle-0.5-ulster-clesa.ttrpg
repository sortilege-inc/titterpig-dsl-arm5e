EXTENSION "ArM5_The_Contested_Isle_Ulster_Clesa" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Nine: The Province of Ulster clesa"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # The chapter's clesa, structured; each DESCRIPTION the source's text, verbatim.

    #t67d00f04b96a7674578dd1 ^"Baí Brasse, or the Profit of Speed" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Quickness + Athletics"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "A successful feat roll permits the character to hurry at three times walking speed, and run at six times walking speed for one round. Walking speed is usually (10 + Qik – Encumbrance) paces per round, but without this feat, a hurry is twice this and a run four times faster (*Lords of Men*, page 120)."
    }

    #tbbd86788d9be6ceac06092 ^"Cless Caitt, or Cat Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Athletics"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "A feat roll permits a horizontal jump from a standing start to a distance equal to or less than eight times the character’s height. Subtract the character’s Encumbrance from the multiplier, so a character with 3 points of Encumbrance can jump only five times his height."
    }

    #t57b45ee9d3043b1be7e638 ^"Ích-n-Erred, or Hero’s Salmon Leap" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Strength + Athletics"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "The feat roll permits a vertical jump from a standing start, like a salmon leaping up a waterfall. The character can jump up to four times his own height. Subtract half the character’s Encumbrance (rounding up) from the multiplier, so a character with 3 points of Encumbrance can jump only twice his height."
    }

    #tb6b15866e7bae3714d0594 ^"Ochtarchless, or Eight-Men Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Stamina + Athletics"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "A feat roll grants the character +5 to Strength solely for the purpose of lifting something or supporting something’s weight. Once the object is lifted or supported, the character’s Strength remains sufficient to hold in position for every round that he continues to make his feat roll."
    }

    #t2a239e095e132801a6a79f ^"Rothchless, or Wheel Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Strength + Athletics"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "On a successful feat roll, the character can hurl an object that he would normally not be able to throw. Classically, this feat was used to hurl chariot wheels, each one two paces in diameter and having a Load of 4. The character must make a Thrown Weapon attack to hit something as if the missile were a stone, except that the Weapon Damage Modifier is equal to the Load of the object. As a general rule, a character can lift a Load that has a Burden equal to his (Strength +2). If the thrown object hits another object, both need to make a Stress check to remain whole (*City & Guild*, page 77). The thrown object does not need to Penetrate the Magic Resistance of the target: the magic involved was active on it for just for the moment it was thrown."
    }

    #t8573b1d343bdf078c55924 ^"Tétchless, or Rope Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Athletics"
            ^"Ease Factor" STRING "3 + modifiers"
            ^"Group" STRING "Athletics Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "The character is capable of amazing acts of balancing with a successful feat roll. He can stand upright on an unstable object smaller than his own foot, and if applicable, move up to his normal movement rate for a round. Use the following table to determine modifiers to the Ease Factor. Use any that apply:"
    }

    #t84b4a50e27d868ea128766 ^"Cless For Análaib, or Breath Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Stamina + Concentration"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Concentration Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This feat confers the ability to hold one’s breath for extended periods of time. On a successful feat roll the character only needs to make Deprivation rolls from lack of air every five minutes, rather than every 30 seconds. He can also improve his performance in activities requiring great precision by taking three rounds to prepare and holding his breath for the duration of the task, gaining a +3 to such tasks. This includes improving aim with a missile weapon. The effect lasts until the character does something else other than a Concentration-based cles."
    }

    #t05318fcefcc2a844e4d9e1 ^"Corpchless, or Body Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Concentration"
            ^"Ease Factor" STRING "6, 9, or 12"
            ^"Group" STRING "Concentration Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "A feat roll permits wild contortion of the body within the skin to escape bonds or wriggle through small spaces. This includes dislocating wrists, shoulders, hips, or ankles; learning this feat also involves learning how to relocate the bones properly. To escape shackles requires an Ease Factor of 6 and dislocates the hand or foot. Wriggling through a space one Size smaller than the character requires an Ease Factor of 9 and dislocates one shoulder. Getting through a space that would normally only admit someone two sizes smaller requires an Ease Factor of 12 and dislocates a shoulder and a hip. Resetting a joint requires a round per location; until this is done the limb is useless.\n\nCharacters who know this feat can use it while wrestling to gain a +3 bonus to escaping from a Grapple (**ArM5**, page 174); the Ease Factor for this is 6 and he doesn’t need to dislocate anything."
    }

    #t17c5bd3dba613ddfd249ab ^"Sáebchless Díberge, or Wild Feat of Contortion" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Quickness + Concentration"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Concentration Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "A feat roll permits the character to contort her limbs and back, stretching unnaturally or bending the joints the wrong way. This allows her to strike at her opponent from an unexpected direction, such as from over his shoulder or behind his knee. The character gains a +3 to her Attack Advantage for special effect maneuvers such as tripping an opponent or attempting to disarm him (**ArM5** page 175, or *Lords of Men*, page 133), or +3 to her next Defense Total to resist such maneuvers."
    }

    #t9a22e5485d7b0351e9cbd9 ^"Siaburchles, or Phantom Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Quickness + Concentration"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Concentration Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This dangerous feat requires the character to concentrate when an opponent strikes at him, offering up no defense. If the feat roll succeeds, then part of character’s body becomes momentarily insubstantial, and the opponent’s blow passes straight through him causing no damage. The character cannot become wholly insubstantial, and cannot perform this feat in consecutive rounds."
    }

    #tf9f562a0cf5a41be5c7e5d ^"Béim Co Commus, or Stroke of Precision" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Single Weapon"
            ^"Ease Factor" STRING "opponent’s Defense Total, or 9"
            ^"Group" STRING "Single Weapon/ Great Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This feat permits acts of great precision with a blade. The character can cut hair from his opponent’s beard, cut the clothes from his body without harming him, or scribe his initials on a yielding surface. This feat cannot do any damage. If in the midst of combat, the feat roll must equal or exceed his opponent’s Defense Total, but if the target is not resisting then the Ease Factor is 9."
    }

    #tfb22a5d0bd28a53a7cca86 ^"Brúd nGeme, or Crushing Roar" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Stamina + Single Weapon"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Single Weapon/ Great Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "With this feat, a character strikes at his opponent’s weapons and breaks them. He must successfully hit his opponent, but rather than doing damage, attempts a feat roll. Add one to the Ease Factor if the weapon is of Superior Quality, add three if it is Excellent Quality, and add six if it is enchanted by any means (see *City & Guild* page 67 for item Quality).\n\nIf the feat roll is successful, the item takes two damage levels. Standard Quality items only have two damage levels; Superior weapons have three, Excellent weapons have four, and enchanted weapons have five (again, see *City & Guild* page 77 for damaging objects). Once all damage levels are gone, the item breaks and is useless."
    }

    #t37b1df0cbe044e0169d453 ^"Fáenchless, or Sloped Shield Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Strength + Single Weapon"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Single Weapon/ Great Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "Using this feat requires that the character is carrying an Irish edged shield: a round shield with a sharp metal edge around the rim. The feat allows him to deal glancing blows when parrying with the shield. The character can attempt a feat roll whenever his Defense Total with the edged shield exceeds his opponent’s Attack Total.\n\nIf the feat roll succeeds, use the difference between the Defense Total and Attack Total as an Attack advantage, and resolve damage for the edged shield as if the character had attacked rather than defended. The Weapon Damage Bonus of an edged shield is +2. This feat can be performed once per round, regardless of how many Defense rolls you make; your character’s usual action is not affected."
    }

    #tb1448814d07f5b8e06adf3 ^"Foramchles, or Swooping Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Stamina + Single Weapon"
            ^"Ease Factor" STRING "3 + armor’s original Protection"
            ^"Group" STRING "Single Weapon/ Great Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "This feat involves jumping whilst swinging a weapon, with the intent to destroy armor. The character should choose one location: head, body, legs (treated as one location), right arm, or left arm. If the feat roll is successful, then the armor on that spot is sundered or left useless. Reduce the opponent’s Protection by one fifth, rounded up. Alternatively, you could recalculate Protection based on the Expanded Armor Table in *Lords of Men*, page 140."
    }

    #ta7719ba95b030ae94c183e ^"Cless Cletenach, or Javelin Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Thrown Weapon"
            ^"Ease Factor" STRING "9"
            ^"Group" STRING "Thrown Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "This feat requires that the character has two javelins. The first is thrown into the air, and the second is used to push the butt of the first so that it flies with greater force at the target, if the feat roll is successful. The range increment for a successful performance of the Javelin Feat is increased to 15 paces, and the Damage Total is calculated as 2 x (Strength + Weapon Damage Modifier) + Attack Advantage."
    }

    #t91fa6a489fa2931ca81f03 ^"Cless Nónbair, or Nine-Men Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Strength + Thrown Weapon"
            ^"Ease Factor" STRING "6 + 1 / javelin after the first"
            ^"Group" STRING "Thrown Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "This feat allows the character to cast up to nine javelins at once. All must be directed at the same target, and each has its own Attack Total and Defense Total. If the feat roll fails, the character has cast the javelins, but none of them go anywhere near their intended target."
    }

    #tdb102751ada56be4c68507 ^"Torannchless, or Thunder Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Strength + Thrown Weapon"
            ^"Ease Factor" STRING "6 + Brawl Defense Total of opponent"
            ^"Group" STRING "Thrown Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "This feat causes a stone hurled from a sling to fly directly (but not infallibly) at an opponent’s head. If it hits and the feat roll is a success, the target is struck to the ground, falling prone. He also suffers normal damage from the sling stone. Use of this feat causes a crack of thunder, thus its name."
    }

    #t1744061790ac5ddf85a0db ^"Ubullchless, or Apple Feat" DEF {
        EXTENDS #te8f1637d34c88c64b5479a ^"Cless"
        PROPERTIES {
            ^"Ability Roll" STRING "Dexterity + Thrown Weapon"
            ^"Ease Factor" STRING "3 + 2 per missile"
            ^"Group" STRING "Thrown Weapon Clesa"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "This is a juggling feat that keeps up to nine balls or stones in the air at one time — one handed. A feat roll is needed to start juggling. A character can load a sling with one of these missiles without having to stop; else they can be thrown bare-handed at a rate of three per round. The stones can be hurled at three separate targets in one round as long as they are no more than three paces apart. A feat roll is needed to start juggling, and another to throw stones, but not to load a sling."
    }

}
