EXTENSION "ArM5_The_Contested_Isle_Ulster_LewisCultasBheardaoiteasMasterStonemason" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Lewis cultas Bhéardaoiteas, Master Stonemason"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Contested_Isle_Core_Ext"

    # Lewis cultas Bhéardaoiteas, Master Stonemason (Chapter Nine: The Province of Ulster, p107): one character, its stat lines verbatim fields.

    #t6f06128eeebc0033cd8359 ^"Lewis cultas Bhéardaoiteas, Master Stonemason" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t9201fbe38e61bd3ba6975d ^"Qui Sonant Pro Quieto"]
            ^"Age" STRING "70 (apparent age 50)"
            ^"Personality Traits" STRING "Proud +3, Abrupt +2, Hubris (Proud) +2, Disciplined +1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "There were two Verditius stonemasons at Qui Sonant until they disagreed over the right of Ingasia to claim the title of Verditius domus magna. To settle the growing animosity, Finn Mac Cantarus sided with Lewis and Peter opted to leave.\n\nLewis is willing to provide juniors of his House with initiation into the Verditius House Mysteries but only if the initiate professes support for Verdi. Such initiates may find themselves inadvertently drawn into the vendetta that Lewis’ exiled rival is about to escalate.\n\nLewis would pay handsomely for an apprentice with an aptitude for craft magic. He is likely to seek out one of the Coill Trí in the next few years to secure one of the seven Gifted children that they must provide each Tribunal. He will even go so far as to warn off competitors for the child, something that his itinerant rival Peter might be inclined to exploit."
    }

}
