EXTENSION "ArM5_The_Cradle_and_The_Crescent_Figures" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - figures"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_The_Cradle_and_The_Crescent_Core_Ext"

    # The book's eight figures as ^"Figure" records: Solomon's Seal family symbols p25; maps of Arabia p102, Medina and
    # the Mosque of the Prophet p110, Mecca and the Mosque of the Haram p113, Mesopotamia p121, Baghdad p125, Persia p140,
    # Transoxiana and the East p166. Their labels were read by eye (no text layer); the transcription, its uncertain readings
    # and how it was made: the-cradle-and-the-crescent/figures.json.

    # source: page 25, read by eye from the art (no text layer; figures.json)
    #taeec2a106da51317c976b8 ^"Solomon’s Seal Family Symbols (figure)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Solomon’s Seal Family Symbols"
            ^"Lettering" LIST OF STRING ["Solomon’s Seal Family Symbols", "Ashab al-Najm", "“Followers of the Star”", "Ashab al-Sakhr", "“Followers of the Stone”", "Ashab al-Yad", "“Followers of the Hand”", "Ashab al-Halqa", "“Followers of the Circle”", "Ashab al-Nahr", "“Followers of the River”", "Ashab al-Qalb", "“Followers of the Heart”", "قلب"]
            ^"Shows" STRING "the symbols of the six families of the Order of Suleiman, each with its name and its meaning, over a pentagram"
            ^"Uncertain Readings" LIST OF STRING ["قلب: the Ashab al-Qalb’s symbol, the Arabic word qalb (heart), transcribed in Arabic script"]
            ^"Lettering Source" STRING "read by eye from the page rendered at 220 dpi, the small labels at 420-1200 dpi (no text layer); labels as printed"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 25
        }
    }

    # source: page 102, read by eye from the art (no text layer; figures.json)
    #t5b2d7355b9f43696984473 ^"Arabia (map)" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Arabia"
            ^"Lettering" LIST OF STRING ["ARABIA", "Holy Land", "Syrian Desert", "Mesopotamia", "Nefud", "Dahna", "Bahrayn", "Persia", "Persian Gulf", "Hajar", "The Hijaz", "Tayma'", "Khaybar", "Medina", "Badr", "Najd", "Yamama", "Gulf of 'Uman", "Muscat", "Nizwa", "'Uman", "Jiddah", "Mecca", "Ta'if", "The Empty Quarter", "Africa", "Red Sea", "'Asir", "Ubar", "Arabian Sea", "Hadramawt", "Yemen", "Sana'a", "Ma'rib", "Soqotra", "Horn of Africa", "MAP KEY", "City / Town", "Mythic Site", "Realm Border", "Mountains", "Desert", "miles"]
            ^"Shows" STRING "the Arabian peninsula and its neighbours: cities and towns, mythic sites, realm borders, mountains, deserts, seas"
            ^"Uncertain Readings" LIST OF STRING ["Ubar: a mythic site; the text names Ubar the capital of the people of ‘Ad, not as one of its place headings -- not linked"]
            ^"Locations" LIST [#tba6700e7963dd72aab43fb ^"Arabia", #t1064f6c58f821a7d358bb0 ^"Mesopotamia", #t59809b4350e93cb2cd6d23 ^"Bahrayn", #tebff438c04fc4b38ba2900 ^"Persia", #t7ea4401716cd0583832bf5 ^"Hajar", #t8dd8e6346ed7a4aa48a773 ^"The Hijaz", #t0eec323785e3932b1b6fc9 ^"Tayma’ and Khaybar", #t1e7f78811d311ce94d5a49 ^"Medina", #t1dcf338272bf271ab8283a ^"The Najd and Yamama", #t6124f6e1265f5dcd21c600 ^"Muscat", #t8de62ded76f19dccf788f8 ^"Nizwa", #tf769361aedf7c7f9d478e8 ^"‘Uman", #t2a0c3a0b70f56fe2479815 ^"Mecca", #t134404252207a1c74be656 ^"Ta’if", #t94e70672bfc78cff961e59 ^"The Empty Quarter", #tf5d8bb32dd877ccc366edc ^"‘Asir & Yemen", #t0a52493dd7ecb93e65f34e ^"Hadramawt", #t69aeba9ad16ce92ece29d5 ^"Sana’a", #t14dc0095b1a0acb3e06e63 ^"Ma’rib"]
