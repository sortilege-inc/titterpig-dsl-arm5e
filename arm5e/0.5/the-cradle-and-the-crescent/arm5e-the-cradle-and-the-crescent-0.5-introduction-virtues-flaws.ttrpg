EXTENSION "ArM5_The_Cradle_and_The_Crescent_Introduction_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter One: Introduction & Sagas virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t6b3193c56f5191052c4633 ^"Educated (Islamic) (The Cradle & The Crescent)" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, General"
            ^"Printed Name" STRING "Educated (Islamic)"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "The character has been educated in a mosque or *Qur’an* school. The 50 experience points should be spent on some or all of Arabic, Persian, Greek, Latin, Theology: Islam, Islamic Law and Artes Liberales, due to a different education “system.”"
    }

    #te22d7d6b18f4295e01dee0 ^"Dhimmi (The Cradle & The Crescent)" DEF {
        EXTENDS #t2f8QXAkXHom00jIOzQvjyu0 ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, General"
            ^"Printed Name" STRING "Dhimmi"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "The character is a non-Muslim born under Muslim rule. If he is adult and male, he must pay the jizya, and all dhimmis  must abide by certain social restrictions (described earlier), in return for which they receive tolerance and protection from the Muslim authorities. The Judged Unfairly or Outsider flaws are more appropriate for European-born characters who travel through Muslim lands or permanently settle in the Mythic Middle East."
    }

}
