EXTENSION "ArM5_The_Cradle_and_The_Crescent_MythicArabia_Tables" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter Six: Mythic Arabia tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t34e003d5e6198a3fd4a1df ^"Pagan Deities of Arabia (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Term", "Text"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 105
        }
        TABLE {
            "Abgal" "Guardian god of Bedouin and camel drivers. Dhu’l-Khalasa: God of oracles and divination."
            "Dhu Shara" "God of mountains."
            "Hubal" "Senior deity associated with the moon and divination."
            "Ishtar" "Goddess of fertility, sexual love, and war. More commonly worshiped in ancient Mesopotamia."
            "Manaf" "A fertility deity worshiped by women, though women were not allowed to touch its idols during their time of menstruation."
            "Nakhla" "Goddess of the date-palm tree. Al-Qawm: God of war and the night."
        }
    }

}
