EXTENSION "ArM5_The_Cradle_and_The_Crescent_MythicZoroastrianism_Rules" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter Five: Mythic Zoroastrianism rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ArM5_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.





    #t365799623071e9a5668cdd ^"Casting Score" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Holy Powers"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 94
        }
        FORMULAS {
            "Casting Score" "Communication + Invocation + Holy Power + modifiers + aura + die roll"
        }
    }





}
