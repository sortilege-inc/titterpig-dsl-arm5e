            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Taking this Virtue gives the character the Accelerated Supernatural Ability Solomonic Storytelling with an initial score of 0."
