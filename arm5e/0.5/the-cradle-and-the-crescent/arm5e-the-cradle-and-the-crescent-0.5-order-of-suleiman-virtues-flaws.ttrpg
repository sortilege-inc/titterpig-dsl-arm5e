            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Taking this Virtue gives the character the Accelerated Supernatural Ability of Solomonic Astrology with an initial score of 0."
    }

