EXTENSION "ArM5_The_Fallen_Fane_TheFallenFane_CovenantAquila" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Aquila"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ArM5_The_Fallen_Fane_Core_Ext"

    # Aquila: a covenant of the Rhine Tribunal (Part Two: The Fallen Fane, p14); its section the DESCRIPTION.

    #tb829f9f70886efa0b31a36 ^"Aquila" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Members" INTEGER 8
            ^"Present at the Tribunal" INTEGER 2
            ^"Magi" LIST [#t6c5fc8d6264b6136adadf8 ^"Richildis", #t366f06d9418e0fceb2ce02 ^"Westamia"]
            ^"Printed Attendance" STRING "Aquila: Eight members, two present. Richildis of Guernicus, the Quaesitor; Westamia of Tremere."
            ^"Attendance Page" INTEGER 7
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Aquila is a fairly young covenant, but it is growing rapidly and building a strong base. It has a decent library, although nothing special, and is rapidly outgrowing its vis sources. The magi are notably cooperative, and have sent only one representative to the tribunal: Westamia of Tremere, who controls seven votes. Archmage Richildis of Guernicus, the Presiding Quaesitor, is also a member of Aquila, but she has no vote, and is above petty favouritism."
    }

}
