EXTENSION "ArM5_The_Lion_and_the_Lily_AnjouAndAquitaine_AmelieOfMerinita" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Amelie of Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Amelie of Merinita (Chapter Six: Anjou and Aquitaine, p73): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t6cd6bf4ad49875a32868ad ^"Amelie of Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tc9b4b3cdb3958fda250e73 ^"Oleron"]
            ^"Age" STRING "33 (Apparent age 33)"
            ^"Personality Traits" STRING "Curious +3, Meddlesome +2"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Amelie is the maga most likely to act as spokeswoman for the covenant, and to travel on the covenant’s behalf. She is shorter and slighter than average, and uses illusions to give herself blonde hair. She has the blood of a river nymph in her ancestry, which in her particular case causes her to be naturally bald. She also has webbing between her toes and fingers, so she always wears mittens and shoes in public.\n\nAmelie is not a particularly skilled negotiator, but she knows this and so she is willing to allow deals to fail, or to ask potential partners to make their case to Caprican. She uses her role as spokesperson and negotiator for her covenant as an excuse to travel and visit interesting places and people. Her magic is focused on the art of Aquam, and she is particularly skilled at creating unnatural liquids."
    }

}
