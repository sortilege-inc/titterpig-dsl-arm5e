EXTENSION "ArM5_The_Lion_and_the_Lily_AnjouAndAquitaine_JacquesOfHouseFlambeau" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Jacques of House Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Jacques of House Flambeau (Chapter Six: Anjou and Aquitaine, p78): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t352c071eb8d7482c7a26ac ^"Jacques of House Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tcaa75e7a95b2746189b6d1 ^"Atsingani"]
            ^"Age" STRING "44 (Apparent age 39)"
            ^"Personality Traits" STRING "Disciplined +2, Questionable Ethics +2, Greedy +1"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Jacques leads the mercenary contingent of the covenant. He began his apprenticeship under the tutelage of an Ex Miscellanea eremite at the relatively late age of 18, by which time he was already an accomplished Brabançon warrior; thus he is only about ten years past his Gauntlet. Upon becoming a magus, he immediately left the covenant where his pater had settled to rejoin his kinfolk. Soon after, he joined House Flambeau. One of his burning goals is to exact revenge on the Capuchonnes who murdered his father in 1183."
    }

}
