EXTENSION "ArM5_The_Lion_and_the_Lily_AnjouAndAquitaine_RegulusOfMerinitaTheBeeKing" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Regulus of Merinita: The Bee King"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Regulus of Merinita: The Bee King (Chapter Six: Anjou and Aquitaine, p75): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t9f612f99ac61eced2ce4f8 ^"Regulus of Merinita: The Bee King" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t705be3dc14c782e3c434fa ^"Nidi"]
            ^"Age" STRING "72 (Apparent age 21)"
            ^"Personality Traits" STRING "Joyful +3, Fierce +2"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Regulus has blond hair, amber eyes, and golden skin. He smells pleasantly of candles. His unusual and attractive appearance is a result of his Strong Faerie Blood. Regulus is a Bee King.\n\nBee Kings are extremely rare. Some Merinita believe they are created when a young woman accidentally swallows a drone from a faerie hive. Such creatures are the steeds of the tiny knights who serve a queen of the diminutive sprites. Her court progresses through Mythic Europe, and so Bee Kings appear, rarely, in many kingdoms."
    }

}
