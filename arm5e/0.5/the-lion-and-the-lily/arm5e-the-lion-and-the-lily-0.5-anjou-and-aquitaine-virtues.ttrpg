EXTENSION "ArM5_The_Lion_and_the_Lily_AnjouAndAquitaine_Virtues" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Six: Anjou and Aquitaine virtues"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's virtues, structured; each DESCRIPTION the source's text, verbatim.

    #t822531e76191845c2ac35a ^"Bee Kingship" DEF {
        EXTENDS #ttYM5hQuUoCbzVmj60anzIB9 ^"Strong Faerie Blood"
        PROPERTIES {
            ^"Printed Name" STRING "Bee King Virtue"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Bee Kingship is a variety of the Strong Faerie Blood Virtue. It grants the following advantages:\n\nBee Kings do not appear to age, but every Bee King not killed by circumstances dies of a rapid illness precisely a century after birth.\n\nAny Bee King may command any group of bees to perform any action of which they are physically capable, even if it will lead to their deaths. Usual instructions like attacking people, increasing the population of the hive, or constructing objects from wax continue to be performed until the instruction is countermanded (Penetration 50). Simple commands of a sentence or less long can be given orally.\n\nBee Kings may communicate complex messages to bees by having a single bee land on the Bee King’s tongue. This bee then acts as the king’s representative to the hive. Bee Kings can understand the speech of hives, and can read the minds of bees that they are touching.\n\nBee Kings are never stung by any variety of biting insect. An attacking bee swarm is treated as an environmental effect, rather than an opposing mêlée group. The swarm does +10 damage automatically each round. This damage may be Soaked normally."
    }

    #t7310de268b22d737985046 ^"Blood of the Bee King" DEF {
        EXTENDS #tdtcsFn2Qhvmm6rPadswict8 ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "This Minor Supernatural Virtue provides the following advantages:\n\nThe children of Bee Kings age more slowly than other humans, reducing their Aging total by 1.\n\nThe children of Bee Kings may give simple instructions to bees they touch, and may understand the thoughts dominating hives of bees. They are unable to give bees instructions that will kill them, except to command warrior bees to attack, since warrior bees are so willing to die. (Penetration 25)"
    }

}
