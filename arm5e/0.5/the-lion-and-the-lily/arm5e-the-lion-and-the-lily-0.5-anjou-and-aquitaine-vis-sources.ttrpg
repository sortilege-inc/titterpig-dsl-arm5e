            ^"Page" INTEGER 66
        }
        DESCRIPTION "Imaginem: Plume feathers from some of the egrets that nest in a particular grove of trees. Yield 2 pawns per year."
    }

    #te7c09644c10fa0ea5fedd5 ^"Vis Sources Under Threat: Rego" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
