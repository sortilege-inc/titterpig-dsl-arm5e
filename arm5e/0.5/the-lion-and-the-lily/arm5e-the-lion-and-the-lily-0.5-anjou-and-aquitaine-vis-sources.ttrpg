            ^"Pawns per Year" INTEGER 4
            ^"Location" LIST [#t163603b3c41b171fb923c3 ^"La Rochelle"]
            ^"List" STRING "Vis Sources Under Threat"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Rego: The bark of a certain white poplar tree on which the usual pattern of black diamond-shaped marks is particularly regular. Yield 4 pawns per year."
    }

