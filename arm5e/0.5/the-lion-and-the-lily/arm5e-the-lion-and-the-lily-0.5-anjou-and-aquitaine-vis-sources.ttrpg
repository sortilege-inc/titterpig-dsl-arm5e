            ^"List" STRING "Vis Sources Under Threat"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Creo: Unusually large seed cones from a certain alder tree. Yield 3 pawns per year."
    }

    #tee0475621938608c3aeab4 ^"Vis Sources Under Threat: Imaginem" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
