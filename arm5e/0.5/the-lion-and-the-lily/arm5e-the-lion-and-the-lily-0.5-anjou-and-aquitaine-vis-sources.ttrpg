EXTENSION "ArM5_The_Lion_and_the_Lily_AnjouAndAquitaine_VisSources" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Six: Anjou and Aquitaine vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t34fa61fbea42743a4f9ba3 ^"Vis Sources Under Threat: Animal" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Animal"
            ^"Pawns per Year" INTEGER 4
            ^"Location" LIST [#t163603b3c41b171fb923c3 ^"La Rochelle"]
            ^"List" STRING "Vis Sources Under Threat"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Animal: Molted tail feathers from pintail ducks over-wintering at a certain pool. Yield 4 pawns per year."
    }

    #te70cdb5afa465febb861c9 ^"Vis Sources Under Threat: Auram" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Auram"
            ^"Pawns per Year" INTEGER 3
            ^"Location" LIST [#t163603b3c41b171fb923c3 ^"La Rochelle"]
            ^"List" STRING "Vis Sources Under Threat"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Auram: The leaves of a particular aspen tree that quiver as if in a breeze even when in still air. Yield 3 pawns per year."
    }

    #t19eed3110f42bb713a3e52 ^"Vis Sources Under Threat: Creo" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
