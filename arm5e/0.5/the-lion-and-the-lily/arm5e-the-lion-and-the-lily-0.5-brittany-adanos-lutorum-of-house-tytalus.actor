EXTENSION "ArM5_The_Lion_and_the_Lily_Brittany_AdanosLutorumOfHouseTytalus" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Adanos Lutorum of House Tytalus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Adanos Lutorum of House Tytalus (Chapter Four: Brittany, p45): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tc62dbd9a847745814efce0 ^"Adanos Lutorum of House Tytalus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#tffeed8bdd536ed47a1d64d ^"Exspectatio"]
            ^"Age" STRING "57 (Apparent age 41)"
            ^"Personality Traits" STRING "Humorless +2, Unswerving +3, Loyal to Harpax +3"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Adanos bears the blood of an earth spirit, and has a strong affinity for soil, stone, and clay. He is over seven feet tall and totally hairless, and his skin is the texture of rock. He is the youngest of the founding magi of Exspectatio and is a staunch supporter of Harpax since Buliste refused to take him as an apprentice. His signature tactic in conflict of any type (physical, verbal, or magical) is to allow his opponent to expend her energies fruitlessly against his impenetrable defenses, then to strike with a crushing blow once she is exhausted."
    }

}
