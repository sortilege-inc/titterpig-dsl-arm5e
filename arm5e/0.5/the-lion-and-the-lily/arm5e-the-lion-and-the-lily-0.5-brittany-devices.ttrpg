EXTENSION "ArM5_The_Lion_and_the_Lily_Brittany_Devices" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Four: Brittany devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t6466c4994c6d59791037e7 ^"Control Spirit" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "the Circlet of the Primus"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 55
            ^"Penetration" STRING "20"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +4 Arc, +1 Conc; +10 unlimited uses, +5 item maintains concentration, +10 for Penetration Total of 20)."
            ^"Printed Effect Line" STRING "Rego Vim 55 Pen: 20, unlimited uses per day R: Arc, D: Conc, T: Ind."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "This power allows the wielder to command a single task of any spirit in her presence, or to whom the wielder has an Arcane Connection. The commands are issued mentally, and the circlet itself is inscribed with the names of (that is, Arcane Connections to) all of Fudarus’ servant spirits. Any spirit whose Might is less than the Penetration Total of the circlet can be affected by this power."
    }

    #t1101fd3064461a9749dc74 ^"Control Environment of Fudarus" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "the Rod of the Primus"
            ^"Technique" STRING "Variable"
            ^"Form" STRING "Variable"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Structure"
            ^"Effect Line" STRING "Variable Technique, Form, and Level Pen: 0, unlimited uses per day R: Touch, D: Conc, T: Structure"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "The rod has six similar enchantments that use the same spell parameters, but have varying Arts and final levels. The rod can maintain any number of these effects simultaneously, but can only activate one per round.\n\n• Vary light levels from total darkness to unbearable brightness. MuIg base 1, final level 25 • Vary temperature from below freezing to baking hot. MuIg base 1, final level 25 • Open archways or close portals between rooms. MuTe base 1, +1 stone, final level 30 • Create intense smells, either pleasant or putrid. CrIm base 1, final level 25 • Create noises, either soothing or clamoring. CrIm base 1, final level 25 • Change textures of furnishings to feel as soft as down or as sharp as thorns. MuIm base 1, final level 25 • (variable base, +1 Touch, +1 Conc, +3 Structure; +10 unlimited uses, +5 item maintains concentration)\n\nThe Circlet of the Primus commands the spiritual servants of the covenant. Although they can rarely be detected, every room has several invisible spirits within it that perform the simple, menial tasks of the covenant. The servants normally perform whatever task to which they were last set, and the wearer of the circlet is the only individual who can change the commands of a spirit. Prima Buliste currently wears the circlet."
    }

}
