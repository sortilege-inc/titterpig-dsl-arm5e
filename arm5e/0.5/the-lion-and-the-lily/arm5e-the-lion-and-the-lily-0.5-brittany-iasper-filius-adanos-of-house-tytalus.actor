    # Iasper filius Adanos of House Tytalus (Chapter Four: Brittany, p45): one character, its stat lines verbatim fields.

    #t3f98e0fbd5abcfd0db35da ^"Iasper filius Adanos of House Tytalus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tffeed8bdd536ed47a1d64d ^"Exspectatio"]
