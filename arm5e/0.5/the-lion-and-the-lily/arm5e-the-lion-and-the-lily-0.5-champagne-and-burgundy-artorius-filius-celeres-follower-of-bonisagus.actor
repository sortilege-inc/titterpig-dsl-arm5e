EXTENSION "ArM5_The_Lion_and_the_Lily_ChampagneAndBurgundy_ArtoriusFiliusCeleresFollowerOfBonisagus" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Artorius filius Celeres, Follower of Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Artorius filius Celeres, Follower of Bonisagus (Chapter Nine: Champagne and Burgundy, p110): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t22785bed81569a4e66f08a ^"Artorius filius Celeres, Follower of Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Age" STRING "33 (Apparent age 33)"
            ^"Personality Traits" STRING "Loyal +2, Regal +2"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "A newly Gauntleted magus, Artorius was brought to Cunfin as an orphan at the age of sixteen by Eloi, who intended to make the boy his apprentice and train him as his own successor. Celeres, however, proclaimed that he found himself in need of a “squire” and exercised his right to take Eloi’s apprentice as his own. When Artorius passed his Gauntlet (a process Celeres refers to as his “knighting”), his parens gave him the name of legendary king of Britain. Artorius’ future plans are unknown."
    }

}
