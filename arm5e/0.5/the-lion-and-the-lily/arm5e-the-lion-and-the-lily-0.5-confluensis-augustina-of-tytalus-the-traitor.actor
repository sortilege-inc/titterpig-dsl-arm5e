EXTENSION "ArM5_The_Lion_and_the_Lily_Confluensis_AugustinaOfTytalusTheTraitor" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Augustina of Tytalus, the Traitor"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Augustina of Tytalus, the Traitor (Chapter Eleven: Confluensis, p138): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tddfaa0b64a72fe15f77215 ^"Augustina of Tytalus, the Traitor" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t9b2aa72ed33f3af450ee9e ^"Confluensis"]
            ^"Age" STRING "46 (Apparent age 36)"
            ^"Personality Traits" STRING "Concerned About House Tytalus +3, Carefree +1"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 138
        }
        DESCRIPTION "Augustina is a small, assertive woman who looks both tired and happy much of the time. Her hair is black, but her eyes are blue. Her familiar is a small ape, and her talisman is either a locket on a ribbon or a dagger; no one is sure which, because one is kept permanently wrapped about the other.\n\nThe current Traitor, Augustina was trained by the mater of Buliste, the Prima of Tytalus. Augustina was prepared for the role of Traitor from early apprenticeship, and was trained as a hoplite primarily by the previous Traitor. Like most Traitors, Augustina has served for the majority of her life in the Normandy Tribunal, advising her covenant’s leader on the games of House Tytalus. Given Proctor’s feelings about House Tytalus, it comes as no surprise that she is usually given high-risk and low-trust assignments by the Quaesitores."
    }

}
