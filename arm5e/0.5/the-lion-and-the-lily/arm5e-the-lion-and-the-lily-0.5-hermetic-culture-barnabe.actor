    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Barnabé (Chapter Three: Hermetic History and Culture, p20): one character, its stat lines verbatim fields.

    #t1a95039dad7ce594ce8a13 ^"Barnabé" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Grog"
            ^"Characteristics" STRING "Int –1, Per –1, Pre 0, Com –1, Str 0, Sta +3, Dex +1, Qik +3"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (Apparent age 25)"
            ^"Decrepitude" STRING "0"
            ^"Virtues and Flaws" STRING "Standard Grog; Enduring Constitution, Improved Characteristics, Puissant Athletics; Covenant Upbringing, Proud (Minor), Social Handicap (arrogance)"
            ^"Personality Traits" STRING "Self-Important +3, Loyal +2, Brave –2"
            ^"Combat" STRING "Fist: Init +3, Attack +4, Defense +6, Damage 0 Dodge: Init +3, Attack n/a, Defense +7, Damage 0"
            ^"Soak" STRING "+3"
            ^"Fatigue Levels" STRING "OK, 0, 0, –2, –4, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore 4 (roads), Athletics 5+2 (day-long running), Carouse 4 (relaxing), Awareness 2 (obstacles), Brawl 3 (dodge), Folk Ken 3 (grogs), French 5 (covenfolk), Guile 1 (avoiding work), Latin 3 (Hermetic), Order of Hermes Lore 2 (seisins), Stealth 3 (woodland), Survival 2 (woodland)"
            ^"Encumbrance" STRING "0 (Burden 0)"
            ^"Appearance" STRING "An athletic young man in the prime of his life; he has dark hair and a scant beard."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "Barnabé\n\nBarnabé is a cursor. He was chosen for this position at the covenant when he showed promise as a child, and received special training in athletics, both long-distance running and sprinting. Because of the attention given to him as a child he is now possessed of a remarkable arrogance, and has an over-inflated view of his own importance. He considers himself to be indispensable to the magi, and treats others as if he were better than them. Due to his facility with Latin, he is often chosen to accompany the magi as an interpreter."
    }

}
