    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Aedes Salii (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #tb76671b371f5b7d117356e ^"Aedes Salii" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "998 – 1063"
            ^"Liege" LIST [#t0fedb1c4b865c920ed8e71 ^"Sinapis"]
            ^"Register Entry" STRING "Aedes Salii (998 – 1063): Vassal of Sinapis. Established on Jersey (one of the Channel Islands), this covenant — named after the Salii, the priests of Mars — was founded to coordinate the Schism War in Normandy and Stonehenge. After the war, the Tremere members returned to their home Tribunals, leaving it in the hands of House Flambeau. It was disbanded when House Flambeau withdrew from the Normandy Tribunal; two of its members joined Lapis Crudus."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
