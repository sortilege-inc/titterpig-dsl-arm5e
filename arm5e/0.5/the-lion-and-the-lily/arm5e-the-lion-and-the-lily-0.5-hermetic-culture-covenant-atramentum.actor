EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantAtramentum" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Atramentum"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Atramentum (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #t639c9a64ef231b70ae782c ^"Atramentum" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1200 – 1201"
            ^"Liege" LIST [#td930f6dae8abded92ad0b4 ^"Fudarus"]
            ^"Register Entry" STRING "Atramentum (1200 – 1201): Vassal of Fudarus; its founding was sponsored just as the battle between the two Tytalan Primi began. Cynics would say that the young magi were duped into preparing the ground for the magi of Exspectatio, who now occupy the spot. The founders went on to form Atramentum Renatus."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
