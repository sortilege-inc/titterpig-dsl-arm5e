EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantCaputCapra" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Caput Capra"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Caput Capra (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p28): a covenant of the Tribunal’s past, from its register entry.

    #te8026fb44a90a687c07c2f ^"Caput Capra" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "981 – 1005"
            ^"Liege" LIST [#t4c5cfade6ecf08fadc1b28 ^"Branugurix"]
            ^"Location" LIST [#tf3d8baeb2df0a7ae3aec4e ^"Fleury"]
            ^"Register Entry" STRING "Caput Capra (981 – 1005): Vassal of Branugurix, and the furthest east of Normandy’s Diedne covenants, on the banks of the Loire not far from Fleury (see Ile de France: Fleury). Caput Capra was the youngest of Branugurix’s vassals, and was founded to protect the ancient druidic site at Fleury from the lawlessness of the late 10th century. Caput Capra was the first casualty of the Schism War in the Tribunal. Apprentices of Confluensis are brought to the scant ruins of the covenant to receive their lessons in history."
            ^"Register Page" INTEGER 28
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 28
        }
    }

}
