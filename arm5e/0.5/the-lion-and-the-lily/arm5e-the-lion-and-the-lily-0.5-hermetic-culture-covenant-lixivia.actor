EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantLixivia" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Lixivia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Lixivia (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #tda862160566d3e18c9555a ^"Lixivia" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1021 – 1124"
            ^"Liege" LIST [#t51ca18907ef019f0eac23f ^"Conventio Florum"]
            ^"Location" LIST [#ta41d04087d5f25a807eb26 ^"Champagne"]
            ^"Register Entry" STRING "Lixivia (1021 – 1124): Vassal of Florum. Established in the duchy of Champagne just as the Champagne trade fairs were established (see Champagne & Burgundy: Champagne) for the express purpose of acting as an intermediary between the Order and mundane merchants. The covenant consisted of Redcaps and Gentle Gifted magi, and altruistically offered to source any material desired by any covenant. However, magi were suspicious of their motives, and they soon became the popular prey of raiding (see Demography of the Normandy Tribunal). Driven into poverty, the covenant disbanded."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
