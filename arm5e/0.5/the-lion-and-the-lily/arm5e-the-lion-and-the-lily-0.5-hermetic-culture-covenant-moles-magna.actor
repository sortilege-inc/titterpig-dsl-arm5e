EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantMolesMagna" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Moles Magna"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Moles Magna (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #t47f80b10976626c7c9b0a0 ^"Moles Magna" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1136 – 1182"
            ^"Liege" LIST [#tc9b4b3cdb3958fda250e73 ^"Oleron"]
            ^"Location" LIST [#t0eeadf54d179e3a35f754e ^"The Morvan"]
            ^"Register Entry" STRING "Moles Magna (1136 – 1182): Vassal of Oleron. Located on the edge of the Morvan (see Champagne & Burgundy: The Morvan), this covenant was built actually within a dam of a minor tributary of the River Yonne. The river formed a small lake at the covenant’s back, and cascaded over the dam hiding them from view. It was eventually destroyed when the river burst the dam after heavy rain; since the covenant had magically reinforced the dam against such a fate, it is assumed that they had angered a supernatural creature by restraining the river."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
