EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantNaucheFleur" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Nauche-Fleur"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Nauche-Fleur (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #t181f19a94cb926fd0f317f ^"Nauche-Fleur" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1072 – 1166"
            ^"Liege" LIST [#t68c624c503a5278329f995 ^"Montverte"]
            ^"Register Entry" STRING "Nauche-Fleur (1072 – 1166): Vassal of Montverte, this covenant operated a school near to Niort in Aquitaine, where instruction in both martial and academic subjects funded the opulent lifestyle of the magi. The covenant’s role in mundane politics was ever a source of controversy in the Tribunal; consequently none of the apprentices it trained remained to continue its work. The covenant died when the last of its founders entered Final Twilight."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
