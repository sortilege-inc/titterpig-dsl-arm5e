EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_CovenantPagus" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Pagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Pagus (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p28): a covenant of the Tribunal’s past, from its register entry.

    #t7f87695dc0064ac0c5a214 ^"Pagus" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "840 – 1008"
            ^"Liege" LIST [#t9b2aa72ed33f3af450ee9e ^"Confluensis"]
            ^"Register Entry" STRING "Pagus (840 – 1008): Vassal of Confluensis. Founded at a ruined Roman outpost near the town of Cherbourg, it offered a commanding strategic vista over the English Channel. The magi invested a large amount of vis, during the late eighth century and early nineth century, restoring the Roman buildings, including a dock. Cruelly, the covenant then suffered enormous damage during the Viking raids, from which it never recovered. It was destroyed in the Schism War."
            ^"Register Page" INTEGER 28
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 28
        }
    }

}
