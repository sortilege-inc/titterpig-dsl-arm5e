EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_Spells" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Three: Hermetic History and Culture spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t43046db264cb06a60db4c6 ^"An Ear for Distant Bells" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Hearing"
            ^"Printed Stat Line" STRING "InIm Level 15 R: Personal, D: Concentration, T: Hearing"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "This spell allows the caster to precisely determine the distance and direction from their location to the source of a sound. This spell was invented in the Normandy Tribunal by the Quaesitor Fluvius.\n\n(Base 3, +1 Conc, +3 Hearing)"
    }

}
