EXTENSION "ArM5_The_Lion_and_the_Lily_HermeticCulture_Tables" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Three: Hermetic History and Culture tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t8c5e0d4a2845d26a52d986 ^"Saga Seed: Feudal Duty (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Covenant", "Major Boons", "Minor Boons", "Major Hooks", "Minor Hooks"]
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 27
        }
        TABLE {
            "Vassal" "Powerful Ally" "(none)" "Beholden, Indebted" "Beholden, Favors, Indebted"
            "Liege" "Favors Owed, Hidden Resources*" "Promised Favors" "(none)" "Protector"
        }
    }

    #t9a09845da0777d359799d9 ^"Tourney Ranks & Prizes (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Rank Pawns", "", "Rank", "Pawns"]
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 33
        }
        TABLE {
            "1" "31" "12" "5"
            "2" "24" "13" "0"
            "3" "18" "14" "11"
            "4" "15" "15" "3"
            "5" "13" "16" "5"
            "6" "11" "17" "4"
            "7" "17" "18" "3"
            "8" "8" "19" "5"
            "9" "7" "20" "1"
            "10" "6" "21" "6+6"
            "11" "6" "" ""
        }
    }

}
