EXTENSION "ArM5_The_Lion_and_the_Lily_IleDeFrance_Library" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Seven: Ile de France library"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #t8b583d481b1f6f4586a8b4 ^"History of the Franks (Aimon)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "History of the Franks"
            ^"Author" STRING "Aimon"
            ^"Section" STRING "Fleury"
            ^"Printed Entry" STRING "A tome entitled History of the Franks was written here at this time by a monk named Aimon, which has since become adopted as the semi-mythical official chronicle of the royal Capetian house. (This should not be confused with the more famous and ancient work penned by Gregory of Tours; see Chapter 6: Anjou and Aquitaine, Tours.) The book has the following statistics: Summa, Organization Lore: French Royalty (Level 3, Quality 9); Summa, Area Lore: Ile de France (Level 2, Quality 9); Summa, Divine Lore (Level 3, Quality 9)."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 92
        }
    }

}
