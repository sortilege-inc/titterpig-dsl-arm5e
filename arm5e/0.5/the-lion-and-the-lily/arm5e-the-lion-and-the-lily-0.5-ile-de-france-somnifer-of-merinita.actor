EXTENSION "ArM5_The_Lion_and_the_Lily_IleDeFrance_SomniferOfMerinita" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Somnifer of Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Somnifer of Merinita (Chapter Seven: Ile de France, p90): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #te201a1fce22e5fca5a3de7 ^"Somnifer of Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t99cf4cbf2955330baaf8dc ^"Lapis Crudus"]
            ^"Age" STRING "113 (Apparent age 30)"
            ^"Personality Traits" STRING "Sleepy +5, Thoughtful +2, Attentive –2"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "A master of magic pertaining to dreams, Somnifer kept the rest of the covenant appraised of the outside world during their captivity thanks to his ability to cast his mind forth in spiritual form and enter the dreams of those he encounters. He managed to find his apprentice through his dreams, and entice him to Lapis Crudus to receive training through the enchanted mirror. Somnifer has difficulty distinguishing dreams from reality, thanks to his Warping, and it is often difficult to determine whether he is awake, or just sleepwalking."
    }

}
