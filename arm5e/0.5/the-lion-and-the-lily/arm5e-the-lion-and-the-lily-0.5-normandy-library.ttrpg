EXTENSION "ArM5_The_Lion_and_the_Lily_Normandy_Library" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Five: Normandy library"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #tc86d1e024233ec2ec5a220 ^"Historia rerum Anglicarum" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Historia rerum Anglicarum"
            ^"Author" STRING "William of Newburgh"
            ^"Level" INTEGER 5
            ^"Section" STRING "Norman Histories"
            ^"Printed Entry" STRING "Historia rerum Anglicarum by William of Newburgh (1136-1198) includes an Area Lore: England summa of Quality 7 and Level 5; and an Area Lore: Normandy tractatus of Quality 8."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 55
        }
    }

    #t13ea1c2a9a968cc76d6eb4 ^"The Ecclesiastical History" DEF {
