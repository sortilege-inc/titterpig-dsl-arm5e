            ^"Section" STRING "Norman Histories"
            ^"Printed Entry" STRING "The Ecclesiastical History, by Orderic Vitalis (1075-1141) includes an Area Lore: Normandy summa of Quality 8 and Level 4; an Area Lore: England summa of Quality 8 and Level 3; and a Civil and Canon Law tractatus of Quality 7."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 55
        }
    }

