EXTENSION "ArM5_The_Lion_and_the_Lily_Normandy_RunildOfHouseTremere" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Runild of House Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # Runild of House Tremere (Chapter Five: Normandy, p61): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t97e10c8600d07e23ca1fb3 ^"Runild of House Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t68c624c503a5278329f995 ^"Montverte"]
            ^"Age" STRING "64 (Apparent age 43)"
            ^"Personality Traits" STRING "Oblivious to Mundanes +3, Catlike +2, Inquisitive +1"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "The youngest member of the inner council, Runild, is quite unlike the domineering and larger-than-life personalities of the other four. She is a quiet and unassuming woman who is responsible for overseeing the magical resources of the covenant: its library, its vis stores, and the labwork of the junior magi who are required to donate seasons of work. Runild has just finished training her first apprentice, but has not yet gained her own voting sigil. Her familiar is a black cat from the lineage of Jerbiton’s familiar, and she associates with all of Montverte’s numerous cats."
    }

}
