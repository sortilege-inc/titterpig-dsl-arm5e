EXTENSION "ArM5_The_Lion_and_the_Lily_NormandySagas_Spells" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Ten: Normandy Sagas spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t768913e232c5064cb2794c ^"Nordic Triumph" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 65
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Structure"
            ^"Requisite" STRING "Herbam, Terram"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuMe(He)(Te) Level 65 R: Touch, D: Moon, T: Structure, Ritual"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This ritual is cast while on board a ship, which the spell transforms into a dragonprowed longship, and the crew are transformed into fierce Viking warriors who view the caster as their chieftain. The spell does not give the crew any Abilities they did not already have, but it makes them think and act as if they are Viking warriors, including acting as a trained group in combat.\n\n(Base 15, +1 Touch, +3 Moon, +4 Structure, +2 Requisites)"
    }

}
