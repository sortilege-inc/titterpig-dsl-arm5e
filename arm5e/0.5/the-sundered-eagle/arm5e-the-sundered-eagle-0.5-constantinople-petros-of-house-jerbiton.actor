EXTENSION "ArM5_The_Sundered_Eagle_Constantinople_PetrosOfHouseJerbiton" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Petros of House Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Petros of House Jerbiton (Chapter Seven: Constantinople, p100): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tf1b1cb65c5b4c71b5c4acd ^"Petros of House Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tc85ec2f6cb1c1755ee2d70 ^"Michael’s Tabula"]
            ^"Age" STRING "36 (Apparent Age: 11)"
            ^"Personality Traits" STRING "Depressed +2, Meditative +2, Immature +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "Petros, the filius of Michael, had a troubled apprenticeship. First, his master botched his own Longevity Ritual; it instead took effect on his apprentice and stopped his growing further. Despite now being in his fourth decade, Petros retains the body of an 11-year-old boy. Second, his master died during the city’s defense, shortly before Petros was to swear the Oath of Hermes. Despite his youth and inexperience, the magi of Michael’s Tabula elected the boy their leader, out of respect for his pater.\n\nPetros is a melancholy individual, a man trapped inside the body of a boy. His prayers for manhood remain unanswered, and he bears the shame of the failed defense of the city and the fall of Thermakopolis. In his darkest moments of despair, Petros has considered joining a monastery, but stays at the covenant to honor his pater’s cause."
    }

}
