EXTENSION "ArM5_The_Sundered_Eagle_Constantinople_TrasaricusOfHouseCriamon" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Trasaricus of House Criamon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Trasaricus of House Criamon (Chapter Seven: Constantinople, p102): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tf8fbdd38120a993280f514 ^"Trasaricus of House Criamon" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t1279ab0ebf8d87bf54c40f ^"Xylinites"]
            ^"Age" STRING "21"
            ^"Personality Traits" STRING "Proud +3, Bitchy +2, Idle +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "Trasaricus is the only member of Xylinites born within the Tribunal; he is a nephew of the former Emperor Alexios IV Angelos, who was deposed and killed in 1204. Castrated in early childhood for being politically dangerous, he is an implacable enemy of the Doukas family. His imperial blood fascinates Artoud, who is unwilling to expel his apprentice, but who realizes that soon the youth must be sent far from Constantinople to prevent disaster."
    }

}
