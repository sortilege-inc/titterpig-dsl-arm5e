    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t0f4b5425ee49995431bebe ^"Oath Invocation Roll" DEF {
        APPLIES TO [#tXIGEBIb23ZWLcjrSW3X7dQY ^"Character"]
        PROPERTIES {
            ^"Ease Factor" STRING "15 + simple die"
            ^"Rules Section" STRING "The Power of Oaths"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 48
        }
        FORMULAS {
            "Oath Invocation Roll" "Communication + Charm + simple die (+6 if Styx is invoked)"
        }
    }

}
