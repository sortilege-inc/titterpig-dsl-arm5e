    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t380ef03484ecb8cc9e6439 ^"Languages (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Languages", "Penalty*", ""]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 41
        }
        TABLE {
            "Same language, different dialects" "" "–1"
            "Romaic Greek vs Classical Greek" "" "–2"
            "Vlach vs Latin" "" "–3"
            "Italian vs Latin" "" "–3"
            "Veneto vs French" "" "–2"
            "Veneto vs Italian" "" "–3"
            "Lingua Franca vs Veneto" "" "–2"
