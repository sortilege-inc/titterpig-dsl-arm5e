EXTENSION "ArM5_The_Sundered_Eagle_DivineLandscape_SaintPowers" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Eleven: The Divine Landscape saint powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # The chapter's saint powers, structured; each DESCRIPTION the source's text, verbatim.

    #t5d4e3101d10040f11ad69d ^"Healing (The Sundered Eagle)" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+7"
            ^"Form" STRING "Corpus"
            ^"Printed Stat Line" STRING "Healing, 2 points, Init +7, Corpus."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "With this power a saint can heal all of a supplicant’s wounds, regardless of how they were inflicted, cure any disease, and remedy any physical impairments."
    }

    #t6300656904663170b93f7d ^"Overstepping the Temporal Bounds" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Mentem"
            ^"Printed Stat Line" STRING "Overstepping the Temporal Bounds, 5 points, Init +9, Mentem."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "Saints have the ability to slip outside of the regulated structure of God’s temporal framework and view images of the past and future, as well as instantly appear in any place no matter how far it is from their last appearance. Knowledge is often delivered in cryptic riddles or parables. Allow the petitioning character to benefit from the Supernatural Virtue: Premonitions or the Supernatural Flaw: Visions for the day."
    }

    #t2f609d699780b99934f691 ^"Feed the Hungry" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+3"
            ^"Form" STRING "Herbam"
            ^"Printed Stat Line" STRING "Feed the Hungry, 1 point, Init +3, Herbam."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "Using God’s power, a saint can create nourishing food for any number of people it sees fit. This is usually bread and fresh water, but fish and other corn products can be created."
    }

    #tcb3d66a8e54b60d9f142a0 ^"Relief from Natural Disasters" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+6"
            ^"Form" STRING "Aquam or Terram"
            ^"Printed Stat Line" STRING "Relief from Natural Disasters, 5 points, Init +6, Aquam or Terram."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "Many hagiographies recount how a saint saved the faithful from violent storms, earthquakes, or being lost at sea. With this power a saint can halt any natural disaster occurring from mundane causes. For supernaturally caused disasters, this power allows the saint to instantly transport the petitioner away from harm, up to a hundred miles away."
    }

    #tf2b09af042ef847ef85513 ^"Tame the Wild Beast (The Sundered Eagle)" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Animal"
            ^"Printed Stat Line" STRING "Tame the Wild Beast, 2 points, Init +5, Animal."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "This power tames any wild beast, regardless of size or temperament, causing an otherwise hostile animal to depart in peace. Tamed animals cannot be yoked into service, and this power primarily protects the faithful from dangerous predators while traveling."
    }

    #tdf1f561c25f70f3cab8f38 ^"Gift of Endurance" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+6"
            ^"Form" STRING "Corpus"
            ^"Printed Stat Line" STRING "Gift of Endurance, 3 points, Init +6, Corpus."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "This power lets saints fortify a petitioner to be immune to physical deprivation. The petitioner does not need to eat or sleep for a number of days equal to the saint’s Divine Might, nor do naturally occurring weather conditions (heat and cold) impair him."
    }

}
