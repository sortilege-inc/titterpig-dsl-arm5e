EXTENSION "ArM5_The_Sundered_Eagle_DivineLandscape_StGeorge" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - St. George"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # St. George (Chapter Eleven: The Divine Landscape, p137): one saint, its printed stat lines verbatim fields.

    #t78c2652c916709f2846cb0 ^"St. George" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Saint Category" STRING "Greater Saints"
            ^"Divine Might" INTEGER 75
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "St. George, megalo martyros (magnificent martyr), one of the Fourteen Holy Helpers in the Eastern Orthodox Church, patron saint of soldiers (note that St. George does not become the patron saint of England until 1415, after the battle of Agincourt)."
    }

}
