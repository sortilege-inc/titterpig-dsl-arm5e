EXTENSION "ArM5_The_Sundered_Eagle_Greece_AiakiaOfHouseGuernicus" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Aiakia of House Guernicus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Aiakia of House Guernicus (Chapter Five: Greece, p68): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t607cd8cb64bb835ef34e43 ^"Aiakia of House Guernicus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t4d67822019c383f4b5ebf1 ^"Hedyosmos"]
            ^"Age" STRING "61 (Apparent Age: 53)"
            ^"Personality Traits" STRING "Loyal +2, Touchy +2, Friendly –2"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "Aiakia is the youngest filia of Ausculator, and she is being groomed to take over from her pater when he is finally claimed by Twilight. She is not the most powerful of the cult’s members, but has the greatest knowledge of its rituals and therefore is best suited to the role. Aiakia’s specialty is caverns and underground passages. She has extensively explored many cave complexes throughout the Tribunal and beyond, and brought back secrets from them that she only partially comprehends. Her other interest is earth elementals, over which she exerts remarkable control."
    }

}
