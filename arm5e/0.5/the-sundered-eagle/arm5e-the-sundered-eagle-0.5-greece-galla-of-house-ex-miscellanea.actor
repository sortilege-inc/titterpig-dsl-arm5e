EXTENSION "ArM5_The_Sundered_Eagle_Greece_GallaOfHouseExMiscellanea" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Galla of House Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Galla of House Ex Miscellanea (Chapter Five: Greece, p64): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #te09934c17b487f82595e74 ^"Galla of House Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t88f9980f616d446ddb5dd2 ^"Epidauros"]
            ^"Age" STRING "78 (Apparent Age: 52)"
            ^"Personality Traits" STRING "Careworn +3, Earthy +2, Venomous +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 64
        }
        DESCRIPTION "Galla hails from the herbalist Pharmacopoiean tradition (see *Houses of Hermes: Societates*, page 123) — as a Root-Cutter, she is able to reduce the vis cost of healing rituals, which is of great benefit to her covenant. A lame woman with silver hair and wearing a simple gray shawl, she walks awkwardly with the aid of her talisman staff. Her snake familiar sniffs out herbs in the nearby hills for her. Galla tends to be the maga at Epidauros who deals with visitors."
    }

}
