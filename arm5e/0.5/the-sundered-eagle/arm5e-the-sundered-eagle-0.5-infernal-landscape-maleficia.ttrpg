EXTENSION "ArM5_The_Sundered_Eagle_InfernalLandscape_Maleficia" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Twelve: The Infernal Landscape maleficia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # The chapter's maleficia, structured; each DESCRIPTION the source's text, verbatim.

    #td74927c70e8027142182e2 ^"Wings of the Tempest" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 20
            ^"Printed Stat Line" STRING "Debauchery/Effusion 20"
            ^"Tradition" LIST [#t200f6045a493952fd51923 ^"Stringla"]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "The witch can gather winds to herself strong enough to allow her to fly, or else lift others aloft and dash them to the ground. She must concentrate on the winds in order to control them. (Base 4, +3 Sight, +1 Conc)"
    }

    #t5d6668743d3604f405e7c1 ^"The Sanguine Feast" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 35
            ^"Printed Stat Line" STRING "Incantation/Consumption 35"
            ^"Tradition" LIST [#t200f6045a493952fd51923 ^"Stringla"]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "The stringla can heal herself by draining the blood of another. She can restore a Light, Medium, or Heavy Wound by touching another; that touch inflicts the same wound on her victim as she has healed. (Base 25, +1 Touch, +1 affect Medium and Light Wounds)"
    }

    #tf1ce5a3c2ec51eb7e3013f ^"Mephitic Exhalation" DEF {
        EXTENDS #t94643c11773ea1436be1fb ^"Maleficium"
        PROPERTIES {
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Malediction"
            ^"Level" INTEGER 25
            ^"Printed Stat Line" STRING "Debauchery/Malediction 25"
            ^"Tradition" LIST [#t200f6045a493952fd51923 ^"Stringla"]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "The breath of the stringla can wither crops and destroy fruit. She can affect up to 10 bushes, five small trees, or a four-pacediameter circle of field crops with a single exhalation. (Base 5, +2 Voice, +2 Group)"
    }

}
