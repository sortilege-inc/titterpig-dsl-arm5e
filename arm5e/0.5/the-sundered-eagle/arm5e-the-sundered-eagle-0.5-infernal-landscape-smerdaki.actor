EXTENSION "ArM5_The_Sundered_Eagle_InfernalLandscape_Smerdaki" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Smerdaki"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Smerdaki (Chapter Twelve: The Infernal Landscape, p142): one being, its printed stat lines verbatim fields.

    #tfdda459526c637cb1f10b0 ^"Smerdaki" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters / Evil Spirits"
            ^"Might" INTEGER 10
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 1
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER -2
            ^"Virtues and Flaws" STRING "Hex; Weak-Willed"
            ^"Soak" INTEGER 5
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Weakness" STRING "Compulsiveness"
            ^"Vis" STRING "2 pawns of Animal, in eyes"
            ^"Appearance" STRING "See main text The apparent invulnerability of the smerdaki is provided by their illusionary form; they only rarely take corporeal form."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 142
        }
        PERSONALITY_TRAITS {
            "Selfish" +5
        }
        COMBAT {
            "Dodge" INIT 2 DEFENSE 5
        }
        ABILITIES {
            "Animal Handling" SCORE 5 SPECIALTY "inducing stampede"
            "Athletics" SCORE 3 SPECIALTY "giving chase"
            "Brawl" SCORE 3 SPECIALTY "evasion"
            "Folk Ken" SCORE 3 SPECIALTY "shepherds"
            "Hex" SCORE 2 SPECIALTY "abortions"
        }
        POWERS {
            #t4f986b0e679d7cc4dae3ef ^"Coagulation (The Sundered Eagle)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Coagulation"
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 31."
            }
            #t463a1e222d732c8bcf603c ^"Obsession (The Sundered Eagle)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Obsession"
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Terror. See *Realms of Power: The Infernal*, page 31."
            }
            #t7b455766720742893c059e ^"Illusionary Form" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "Creates an image of the demon’s physical form, which can move at the demon’s direction. The demon must appear in this form or in physical form to use its Coagulation power."
            }
            #t301c7125525a8aa1d6763f ^"Shout of Pan" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Animal"
                }
                DESCRIPTION "Animals flee in terror from the demon. Up to 10 animals are directly affected, but herd animals tend to spread the panic to the rest of the herd. Even goats or sheep can form a lethal stampede if in sufficient numbers."
            }
        }
    }

}
