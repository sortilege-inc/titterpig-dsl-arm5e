EXTENSION "ArM5_The_Sundered_Eagle_TheIslands_DelfiniOfHouseBjornaer" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Delfini of House Bjornaer"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Delfini of House Bjornaer (Chapter Six: The Islands, p83): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #td526a3015d89e0bdbfef8d ^"Delfini of House Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#te5828f32d5a86386a99dbf ^"Aegaea"]
            ^"Age" STRING "62 (Apparent Age: 43)"
            ^"Personality Traits" STRING "Gregarious +2, Curious +2, Fierce +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "As her name suggests, Delfini’s heartbeast is that of a dolphin. Her decision to join Aegaea was thus more a practical matter of suitable aquatic surroundings, rather than being due to any particular interest in Faerie. A plain but earnest woman, she is friendly and inquisitive, and loves to swim alongside ships bearing Redcaps and exchange gossip with them — in mundane circles at least, a dolphin accompanying a ship is considered fortuitous. She is mostly well-regarded due to her outgoing nature, although some magi consider her nosy and view her with suspicion."
    }

}
