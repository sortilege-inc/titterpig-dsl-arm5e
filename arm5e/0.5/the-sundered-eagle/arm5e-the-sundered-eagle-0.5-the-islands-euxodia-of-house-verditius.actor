EXTENSION "ArM5_The_Sundered_Eagle_TheIslands_EuxodiaOfHouseVerditius" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Euxodia of House Verditius"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Euxodia of House Verditius (Chapter Six: The Islands, p87): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t4053705cd93abf1e6d86f4 ^"Euxodia of House Verditius" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6f116ece59aa99af21402c ^"Ingasia"]
            ^"Age" STRING "57 (Apparent Age: 42)"
            ^"Personality Traits" STRING "Hubris +3, Unpleasant +2, Gossip +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "Eudoxia is a maker of enchanted mosaics and a member of the Confraternity of Irene (*Houses of Hermes: Mystery Cults*, page 122). Spiteful and full of hubris, Eudoxia is exploring the mysteries of automata, having recently been initiated into the Inner Mystery. She has managed to acquire two of the statues that used to line the Hippodrome, and works to unlock their secrets."
    }

}
