EXTENSION "ArM5_The_Sundered_Eagle_TheIslands_KrumTheSwiftOfHouseBjornaer" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Krum the Swift of House Bjornaer"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Krum the Swift of House Bjornaer (Chapter Six: The Islands, p83): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tdadfd66416298d271e6788 ^"Krum the Swift of House Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#te5828f32d5a86386a99dbf ^"Aegaea"]
            ^"Age" STRING "57 (Apparent Age: 40)"
            ^"Personality Traits" STRING "Competitive +3, Naive +2, Changeable +2"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Krum is a tall, athletic Bulgarian magus, with the heartbeast of a stallion. As a young magus he was a member of Moero’s Garden in Constantinople, where he delighted in running races in the capital’s great Hippodrome. After the sack of the city in 1204 and the subsequent move of that covenant to Nicaea, he met with Lucian at the Tribunal of 1207. Lucian regaled him with colorful tales of Poseidon, the god who was the creator of the horse and the inventor of the art of riding and horse-races. Persuaded and enthused by these legends, and in a rather drastic change of scenery, Krum promptly joined Aegaea. His current idea is to develop his inner heartbeast into one of the great golden-maned sea-horses that drew Poseidon’s chariot."
    }

}
