EXTENSION "ArM5_The_Sundered_Eagle_TheIslands_LeukotheaOfHouseMerinita" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Leukothea of House Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Leukothea of House Merinita (Chapter Six: The Islands, p83): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tdb355205e72adf0e78ca7d ^"Leukothea of House Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#te5828f32d5a86386a99dbf ^"Aegaea"]
            ^"Age" STRING "73 (Apparent Age: 25)"
            ^"Personality Traits" STRING "Withdrawn +3, Tempestuous +2, Regal +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "Charming and beautiful, Leukothea’s strong faerie nature can easily be guessed at from her appearance — most obviously from the tailfins that she has in place of feet, and from her purple eyes. Although born with the blood of the sea nereides, her Twilight Scars are gradually making her even less human and more like a nereid, a side effect of which is that her apparent age is actually decreasing. Her most recent transformation has given her a crab’s pincers attached to her temples, which are mostly hidden beneath her greenish-blue-tinted hair. Lucian has proclaimed this as sign that she is destined to become the faerie Amphitrite, the bride of Poseidon. Although she may indeed eventually pursue the Inner Mystery of Becoming (see *Houses of Hermes: Mystery Cults*, page 93), as Lucian urges, she has mixed feelings about this supposed fate. Nevertheless, she has recently taken to wearing gold-trimmed white robes befitting a queen. She may often be seen riding her dolphin familiar, whom she has named Hippothoon, after a mortal son of Poseidon."
    }

}
