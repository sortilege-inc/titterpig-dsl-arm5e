EXTENSION "ArM5_The_Sundered_Eagle_TheIslands_VerecundaOfHouseVerditius" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Verecunda of House Verditius"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Verecunda of House Verditius (Chapter Six: The Islands, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t9a3c92ee5f0b3b0d8e1586 ^"Verecunda of House Verditius" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t99d78701a695218b339395 ^"Favonius"]
            ^"Age" STRING "51 (Apparent Age: 38)"
            ^"Personality Traits" STRING "Avaricious +3, Uncompromising +2, Careless +1, Hubris +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "A limber woman who typically dresses as one of the sailors — which is far more practical than robes on deck — Verecunda holds the title of Gubernatrix, the chief helmsman of the fleet. Unlike her master Memnos, her enchantment skills are specialized in ropes, knots, cords, and twine; a focus which proves very useful aboard ship, but not one that has led to a steady client-base for enchanted items. Her familiar is a monkey, which she picked up on one of their more long-distance journeys when the covenant was smaller. He can often be seen in the rigging of *The Philomela* keeping watch."
    }

}
