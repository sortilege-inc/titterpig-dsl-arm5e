EXTENSION "ArM5_The_Sundered_Eagle_TheOrderOfHermes_CovenantKyddopetre" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Kyddopetre"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Kyddopetre (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #t6f50d07ab3d3c89c39630b ^"Kyddopetre" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Kyddopetre (1039 – 1076)"
            ^"Years" STRING "1039 – 1076"
            ^"Register Entry" STRING "Kyddopetre (1039 – 1076) Founded by a collection of Flambeau magi at the Cilician Gates, a narrow pass south of the Tarsus mountains that lead to southern Anatolia. After the Battle of Manzikert, in which the emperor was soundly defeated by the Seljuk Turks, the Byzantine Empire lost Cilicia to the Sultanate of Rum. Living outside the Byzantine empire was not a legal problem, but the magi disbanded, feeling too isolated from their Greek fellows to remain."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
