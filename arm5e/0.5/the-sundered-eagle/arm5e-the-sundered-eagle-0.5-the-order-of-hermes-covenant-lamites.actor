EXTENSION "ArM5_The_Sundered_Eagle_TheOrderOfHermes_CovenantLamites" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Lamites"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Lamites (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #t282b8108d65c726ed608be ^"Lamites" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Lamites (1123 – 1127)"
            ^"Years" STRING "1123 – 1127"
            ^"Register Entry" STRING "Lamites (1123 – 1127) A short-lived Anatolian covenant devoted to prophecy, and claiming the Phrygian Sibyl (see Chapter 9) as their patron. It is believed that Lamia killed them all for their presumption, although it may have been the faerie called Lamia (*Realms of Power: Faerie*, page 68) who objected to the competition."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
