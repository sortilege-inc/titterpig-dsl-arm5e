    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Thermakopolis (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #tafb70509561d1d9265c353 ^"Thermakopolis" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1115 – 1204"
            ^"Register Entry" STRING "Thermakopolis (1115 – 1204) The pride and shame of House Jerbiton, pledged to the protection of Constantinople, a task in which it ultimately failed."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
