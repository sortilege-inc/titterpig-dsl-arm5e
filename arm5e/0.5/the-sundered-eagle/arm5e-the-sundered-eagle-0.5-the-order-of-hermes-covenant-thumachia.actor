EXTENSION "ArM5_The_Sundered_Eagle_TheOrderOfHermes_CovenantThumachia" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Thumachia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_The_Sundered_Eagle_Core_Ext"

    # Thumachia (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #ta2871501494b9f5d2fa217 ^"Thumachia" DEF {
        EXTENDS #tMql8hzM4bv6ng0WYA6N9VrH ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Thumachia (1151 – 1185)"
            ^"Years" STRING "1151 – 1185"
            ^"Register Entry" STRING "Thumachia (1151 – 1185) Founded to protect the Tribunal’s western border after ravages from the Second Crusade. The primarily Jerbiton magi trod a fine line between intervention in mortal affairs and protecting their sodales. Thumachia was sacked during the war between the Sicilian Normans and the Byzantine Empire. Instead of reforming Thumachia, the surviving magi joined Thermakopolis."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
