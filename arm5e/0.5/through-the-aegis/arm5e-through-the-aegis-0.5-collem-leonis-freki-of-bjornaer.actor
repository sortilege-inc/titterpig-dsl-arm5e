    # Freki of Bjornaer (Chapter Six: Collem Leonis, p140): one character, its stat lines verbatim fields.

    #t5060c0efb864e60c362f91 ^"Freki of Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t05209705be91b9906fcea8 ^"Collem Leonis"]
            ^"Gild" STRING "Hawthorn"
