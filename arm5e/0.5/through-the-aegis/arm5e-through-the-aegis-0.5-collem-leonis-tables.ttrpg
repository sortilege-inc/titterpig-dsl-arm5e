EXTENSION "ArM5_Through_the_Aegis_CollemLeonis_Tables" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Six: Collem Leonis tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t3fb00dd8985265f41ecfa8 ^"Covenant Summary (Collem Leonis)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Resource", "Build Points (known + hidden)"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 135
        }
        TABLE {
            "Enchanted Devices" "114+22"
            "Labs" "20+110"
            "Laboratory Text" "72+0"
            "Library" "324+793"
            "Money" "1+0"
            "Specialists and Teachers" "17+0"
            "Vis Sources" "95+75"
            "Vis Stocks" "5+0"
            "Total" "650+1000"
        }
    }

    #t80d6ae6fdfce8aa7302753 ^"Summary of Vis Stocks (Collem Leonis)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Art", "Pawns", "Build Points"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 153
        }
        TABLE {
            "Creo" "0" "0"
            "Animal" "0" "0"
            "Intellego" "0" "0"
            "Aquam" "0" "0"
            "Muto" "0" "0"
            "Auram" "0" "0"
            "Perdo" "0" "0"
            "Corpus" "0" "0"
            "Rego" "0" "0"
            "Herbam" "0" "0"
            "Ignem" "0" "0"
            "Imaginem" "0" "0"
            "Mentem" "0" "0"
            "Terram" "10" "2"
            "Vim" "15" "3"
            "Total" "25" "5"
        }
    }

    #t5a358808b3c71f74bbad70 ^"Summary of Vis Sources (Collem Leonis)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Vis Source", "Vis", "Build Points"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 154
        }
        TABLE {
            "Silver Spring" "8 Vim per year" "40"
            "Albino Stoat" "4 Animal per year" "20"
            "Blue stones of the Mine" "7 Terram per year" "35"
            "Total" "19" "95"
        }
    }

}
