EXTENSION "ArM5_Through_the_Aegis_CollemLeonis_VisSources" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Six: Collem Leonis vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t8aa232aec31edd1a4b09f4 ^"Silver Spring" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Vim"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 154
        }
        DESCRIPTION "Each year on the first day of spring, a certain stream formed by melting snow turns silver. Catching this slow trickle of water before it touches the ground yields 8 pawns of Vim vis over a day."
    }

    #t40d3a7733fea7a885bb1ea ^"Albino Stoat" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Animal"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 154
        }
        DESCRIPTION "An extended family of partly domesticated stoats lives near the covenant, and one of the litters always includes an albino. The old records mention that the albino always flies into a blood rage upon reaching maturity and raids the chicken coop during autumn. If the animal is killed without the skin being pierced and subsequently exsanguinated, the blood contains 4 pawns of Animal vis, which does not appear until the rage is imminent. There is no mention of anyone ever having tried to capture and breed the albino stoat."
    }

    #t26e9e087c8ee47f981c4b4 ^"Blue Stones of the Mine" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Terram"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 154
        }
        DESCRIPTION "Starting out as small specks of dark blue on the mine walls in random places, the vis grow in size until they are fist-sized bulbous protrusions. Once ready they fall off the wall like a ripe fruit during summer. If not picked up within a few days, they dissolve and end up as a purple stain on the floor, the vis being re-absorbed into the stone. The annual yield of this source is 7 pawns of Terram vis. Collection is not hard in itself, but old covenant records warn about the kobold of the mine."
    }

}
