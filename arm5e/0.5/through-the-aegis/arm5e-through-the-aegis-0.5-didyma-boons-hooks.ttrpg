EXTENSION "ArM5_Through_the_Aegis_Didyma_BoonsHooks" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Four: The Oracles of Didyma boons hooks"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's boons hooks, structured; each DESCRIPTION the source's text, verbatim.

    #t2c93b08cfa3f9c511875cd ^"Powerful Ally (Apollo Didyma) (Didyma)" DEF {
        EXTENDS #t7zxybSs17k8pu71m5wL0Ict ^"Powerful Ally"
        PROPERTIES {
            ^"Printed Name" STRING "Powerful Ally (Apollo Didyma) (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Each Theban covenant has a supernatural patron. For Didyma this is the faerie Apollo Didyma — the aspect of Apollo manifest at Didyma, and source of the Branchidae’s prophecies. It is rare for a covenant’s patron to be a faerie. It is well-known to both magi and mundanes that Apollo Didyma is the patron of Didyma. (Covenants, page 21)."
    }

    #t00b7bac909f666a8939ca3 ^"Powerful Ally (Metropolitan of Miletos) (Didyma)" DEF {
        EXTENDS #t7zxybSs17k8pu71m5wL0Ict ^"Powerful Ally"
        PROPERTIES {
            ^"Printed Name" STRING "Powerful Ally (Metropolitan of Miletos) (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Niketas, the Metropolitan of Miletos, is an ally of the covenant. (Covenants, page 21)."
    }

    #t1cdcd535abcf8b4fec180a ^"Edifice (Temple to Apollo) (Didyma)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Edifice (Temple to Apollo) (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The magnificent temples to the old pagan gods at Didyma are well-known. Most locals consider the temples part of the region’s heritage and (even if not pagan) admire the beauty of the buildings, although, of course, a few extremists hate the pagan structures. The temples have been destroyed and rebuilt several times over the centuries, but most date from a rebuilding ordered by the Emperor Trajan in 100 AD. (Covenants, page 14)."
    }

    #t0797c018eb6b5d4214f100 ^"Increased Aura (Didyma)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Increased Aura (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The aura at the covenant is 4 (but a Faerie aura, see later). (Covenants, page 8)."
    }

    #tfebafd963a3130c3c9a693 ^"Right (Didyma)" DEF {
        EXTENDS #tyWhkPG5sG3Es8yzUvnGzP7F ^"Right"
        PROPERTIES {
            ^"Printed Name" STRING "Right (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The covenant of Didyma has the right (granted by the city of Miletos) to conduct prophecies, despite their dubious pagan connotations. (Covenants, page 16)."
    }

    #t72d599d260b13eec95ea28 ^"Secondary Income (warehouses) (Didyma)" DEF {
        EXTENDS #tx6z31VdzvF6Eom4jfSzdhwA ^"Secondary Income"
        PROPERTIES {
            ^"Printed Name" STRING "Secondary Income (warehouses) (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The covenant owns warehouses at the Lion Harbor that are rented to the merchants of Miletos. The warehouses are guarded by the turb and are well regarded because of wards against spoilage and vermin. Since the fall of Constantinople there has been an economic boom at Miletos, so this source of income is currently very secure and profitable. (Covenants, page 16)."
    }

    #ta3b5c1e52ef5b3b0043792 ^"Veteran Fighters (Didyma)" DEF {
        EXTENDS #tUENAG0ymvvxZNAiLrLEZ6Il ^"Veteran Fighters"
        PROPERTIES {
            ^"Printed Name" STRING "Veteran Fighters (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The covenant has a platoon of experienced fighters split between Didyma and the Miletos warehouses, and enlarged by the addition of William’s Frankish mercenaries. The skill of the Franks is well received but there is antagonism within the turb, as a number of the Greek fighters fought (for the Byzantine emperor) at the siege of Constantinople. (Covenants, page 18)."
    }

    #tdaed619806bb69ff080c22 ^"Road (Sacred Way) (Didyma)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Road (Sacred Way) (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The Sacred Way is a paved road, lined with shrines, stretching between the city of Miletos and the covenant of Didyma; it takes about 5 hours (at a normal pace) to walk. The Sacred Way is not a secret and everyone who lives in Miletos knows of it. As well as a conventional road, the Sacred Way is an important route from the faerie realm into the mundane world, and it is common for faeries to appear on the Sacred Way. (Covenants, page 9)."
    }

    #t7530c1c91778b1f3eff733 ^"City (Miletos) (Didyma)" DEF {
        EXTENDS #t1McSfe385N10BTPQvBM1FI7 ^"City"
        PROPERTIES {
            ^"Printed Name" STRING "City (Miletos) (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The bustling city of Miletos is 10 miles north of Didyma, and pretty much anything in Mythic Europe can be sourced from its seething ports. If a rare good cannot be immediately purchased, city merchants can find a source within a season - for a price. On the other hand, close proximity to civilization means that the covenant cannot easily hide from mundane scrutiny and is thus liable to be enveloped by crises that affect the city, such as wars, politics, and famine (Covenants, page 23). Currently, the negative impacts of the city are minimized, due to the covenant’s ally (the Metropolitan) and it’s Right (which gives the covenant a clear position in the legal and administrative life of Miletos)."
    }

    #taab05d6dfd2f41aa99c2e7 ^"Monster (Didyma)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Monster (Major Hook, Unknown)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "A powerful demon sleeps in the rocks beneath the covenant. Its previous awakenings were responsible for earthquakes at the site. (Covenants, page 9)."
    }

    #tded4c99b8dedf0abcd1561 ^"Crumbling (Didyma)" DEF {
        EXTENDS #tRwMRUb5UxjUdONUHoS3HkZq ^"Crumbling"
        PROPERTIES {
            ^"Printed Name" STRING "Crumbling (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Even the newest parts of the temple structure were built hundreds of years ago, and parts are on the brink of collapse. (Covenants, page 15)."
    }

    #t52155ae7359105a4b63937 ^"Faerie Aura (Didyma)" DEF {
        EXTENDS #tzBqvC4mMmX7c2y7n0aPCoF8 ^"Faerie Aura"
        PROPERTIES {
            ^"Printed Name" STRING "Faerie Aura (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Didyma"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "The Didyma aura is a faerie aura (level 4). (Covenants, page 10)."
    }

}
