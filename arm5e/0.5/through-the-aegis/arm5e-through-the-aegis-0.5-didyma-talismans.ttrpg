EXTENSION "ArM5_Through_the_Aegis_Didyma_Talismans" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Four: The Oracles of Didyma talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t5e0e73b7296b7dd67be4ad ^"Staff of Branchidae" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Alexander of House Ex Miscellanea"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        TABLE {
            "+6" "Vim vs hostile magic" "" "Talisman attunements"
            "+4" "control things at a distance" "" "Talisman attunements"
            "+4" "destroy things at a distance" "" "Talisman attunements"
            "+3" "project bolt or other missile" "" "Talisman attunements"
        }
        DESCRIPTION "Alexander’s talisman is seven-foot-tall wiry staff, made of hornbeam, and allegedly a branch of a tree planted by the founder Branchos more than two thousand years ago. It has been opened with 30 pawns of vis (15 slots used)."
    }

    #t81b73ba07eb7227f7f639c ^"Soteria’s Hand" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Nikola of House Ex Miscellanea"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        TABLE {
            "+4" "destroy the human body" "" "Talisman attunements"
            "+4" "wards" "" "Talisman attunements"
        }
        DESCRIPTION "Nikola’s talisman is the enchanted, lead plated skeletal hand of Soteria (the first Hermetic Branchidae). It was exhumed by Nikola many years ago, and has been opened with 10 pawns of vis (6 slots used)."
    }

    #t0412bd387ad1a2bf5771d9 ^"William’s Crusade Armor" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "William of Normandy: House Flambeau"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        TABLE {
            "+7" "protect the wearer" "" "Talisman attunements"
            "+7" "repel faeries" "" "Talisman attunements"
        }
        DESCRIPTION "William’s Talisman is an iron-wrought eagle welded to a steel breastplate. Only the iron eagle (small/metal) is actually enchanted, but as it is a part of armor, it benefits from the shape bonuses of armor (see **ArM5**, page 97). The talisman has been opened with 15 pawns of vis (8 slots used)."
    }

}
