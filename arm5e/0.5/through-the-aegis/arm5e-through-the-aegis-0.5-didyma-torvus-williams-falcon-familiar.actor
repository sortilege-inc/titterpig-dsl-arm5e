            "Code of Hermes" SCORE 1 SPECIALTY "familiars"
            "Dead Language: Latin" SCORE 4 SPECIALTY "Hermetic usage"
            "Guile" SCORE 1 SPECIALTY "magi"
            "Faerie Lore" SCORE 2 SPECIALTY "traditions"
            "Legerdemain" SCORE 3 SPECIALTY "picking pockets"
            "Living Language: Low German" SCORE 2 SPECIALTY "military usage"
            "Living Language: French" SCORE 5 SPECIALTY "Norman"
            "Living Language: Romaic Greek" SCORE 2 SPECIALTY "Hermetic usage"
            "Magic Lore" SCORE 2 SPECIALTY "monsters"
            "Magic Theory" SCORE 3 SPECIALTY "Auram"
