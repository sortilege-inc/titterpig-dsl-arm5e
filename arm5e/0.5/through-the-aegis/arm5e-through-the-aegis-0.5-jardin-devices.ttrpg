EXTENSION "ArM5_Through_the_Aegis_Jardin_Devices" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Three: Jardin, A Summer Covenant devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tdf781e2184899233b42d89 ^"Rope of Bronze (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Rope of Bronze"
            ^"Part Of" STRING "Joia’s Trowel"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 17
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "MuHe 17 Pen +0, 3/day R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "As per the spell of the same name in ArM5, 137 (Base 4, +1 Touch, +2 Sun)"
    }

    #t61ade7bb5b6c79e37a941d ^"Well Without Light (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Well Without Light"
            ^"Part Of" STRING "Xenophanes’ Sickle"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Printed Effect Line" STRING "PeIg 25 Pen +0, 1/day R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "As per the spell of the same name in ArM5, page 142. (Base 3, Touch +1, Sun +2, Structure +3)"
    }

    #t463c8830496a56d38358cb ^"Break the Hard Soil" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Xenophanes’ Sickle"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 7
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Effect Line" STRING "ReTe 7 Pen +0, 6/day R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Breaks the soil in a circle 15 paces across, making it ready for sowing or digging. (Base 2, +1 Touch, +1 Part, +3 levels for 6\n\ntimes a day)"
    }

    #tdde8588f77bb6de7261fb4 ^"Beckoning in the Unwelcome Twilight" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Xenophanes’ Sickle"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "CrVi 25 Pen +20, 1/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Immediately grants two Warping Points to the person touched by the sickle, requiring a roll for Twilight in Hermetic magi. (Base 10, +1 Touch, +10 levels Penetration)"
    }

    #t4486f2284bfbd1a3433e29 ^"The Ever Changing Guise" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Beatriz’s Talisman"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "MuIm 14 Pen +0, 12/day R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "As per the spell Disguise Of The New Visage\n\n**ArM5**, page 146. Beatriz tends to change her physical appearance at whim, with often minor alterations in hairstyle or complexion throughout the day. Outside the covenant she never appears as Beatriz, always adopting a different appearance as a form of disguise. She almost never uses the effect at night, and does not use it when she is alone in her sanctum, so she is not constantly under the effect, and does not gain Warping from it. She does her best to use the effect whenever she is with other people, however. (Effect: Base 4, +2 Sun, 4 Levels 12 Uses a day)"
    }

    #tca7073af7c842682446535 ^"The Invisible Eye Revealed (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "The Invisible Eye Revealed"
            ^"Part Of" STRING "Beatriz’s Talisman"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Touch"
            ^"Printed Effect Line" STRING "InVi 25 Pen +0, 1/day R: Personal, D: Concentration, T: Touch"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "As per the spell of the same name in ArM5, page\n\n157. Beatriz often feels others are hostile to her, and this effect reveals scrying magic up to level 50. She uses it infrequently, but sometimes when out and about the covenant, so if Jardin were being spied upon magically Beatriz would probably be the first to realize and notify the other magi. (Effect: Base 20, +1 Concentration)"
    }

    #t032d98473cbdb656d3544b ^"Whispers Through The Black Gate" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Beatriz’s Talisman"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "InCo(Me) 15 Pen +0, 1/day R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "As per the spell of the same name in\n\n**ArM5**, page 130. (Effect: Base 5, +1 Concentration, +1\n\nTouch,)\n\nBeatriz is under the influence of a –5 longevity ritual."
    }

    #t674bdaed0079540493beae ^"The Touch Of Morpheus" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ahenobarbus’ Talisman"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 47
            ^"Penetration" STRING "+64"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReMe 47 Pen +64, 24/day R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "Touch Range variant of Call To Slumber as in ArM5, page 151. (Effect: Base 4, +2 Voice, +32 for penetration, +5 for 24 uses/day)"
    }

    #t4451da7bf17c7a565ea452 ^"Take Me Home!" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ahenobarbus’ Talisman"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "+8"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReCo 39 Pen +8, 1/day R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "As Leap of Homecoming ArM5, page 135.\n\nThe wand’s base contains an Arcane Connection to Ahenobarbus’ laboratory. (Effect: Base 35, +4 levels Penetration)"
    }

    #t7b82f4dd48a4429ad2c774 ^"Enslave the Mortal Mind (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Enslave the Mortal Mind"
            ^"Part Of" STRING "The Collars of Slavery"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2/day, Environmental Trigger"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReMe 44 Pen +0, 2/day, Environmental Trigger R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 50
        }
        DESCRIPTION "As Enslavement of the Mortal Mind in ArM5, page 152, but with range Touch instead of Eye. The person wearing this small iron collar is completely unable to formulate desires, interests, emotions and activities, and responds willingly to suggestions and commands, as they have no will of their own. Once freed he can fully recall all that transpired while collared and will almost certainly seek revenge."
    }

    #te4ffaa76cd75382b3e8970 ^"Subtle Shift of the Intended Destination" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 37
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Effect: Base 5, +2 Voice, +2 Sun, +2 Group; Modifications +2 uses/day) Cost: 15 Build Points"
            ^"Printed Effect Line" STRING "ReMe 37 Pen 0, 3/day. R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "When the user slaps the symbol of the panpipe and calls out to visible targets “Lost your way have you?”, they suddenly feel the urge to avoid the covenant, and instead seek out a place holding special significance for them. At the end of the duration the targets may remember intending to go to the covenant, but not why they did not."
    }

    #tefebcabd89c249895f1e00 ^"Endure Pain & Fatigue" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Alyssa’s Ring"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual" FIAT "the book prints no Target (its text is 'As Endurance of the Berserkers but Range: Touch and Duration: Diameter'); read from its design line '(Base 10: Touch +1, Diameter +1, +4 12 Uses/day)', which adds no Target step: Individual"
            ^"Effect Design" STRING "(Base 10: Touch +1, Diameter +1, +4 12 Uses/day)"
            ^"Printed Effect Line" STRING "ReCo 24 Pen 0, 12/day"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 52
        }
        DESCRIPTION "As Endurance of the Berserkers but Range: Touch and Duration: Diameter. Alyssa uses this power to bestow the ability on any grogs accompanying her if combat appears imminent.\n\n(Base 10: Touch +1, Diameter +1, +4 12 Uses/day)"
    }

}
