    # Fauconrouge, a Falcon Familiar (Chapter Three: Jardin, A Summer Covenant, p52): a familiar, its stat lines verbatim fields.

    #t903079dec2d648992586ad ^"Fauconrouge, a Falcon Familiar" DEF {
        EXTENDS #tOmeyTfuLwkiC9FmXsz8PTO6 ^"Creature"
        PROPERTIES {
            ^"Covenant" LIST [#ta0f81a12401f028063f15a ^"Jardin"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 24
            ^"Form" STRING "Corpus"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -6
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 6
            }
            ^"Size" INTEGER -3
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "Magical Animal; Magical Friend; Improved Characteristics x 3, Keen Vision, True Friend (Alyssa); Fish Out of Water (flying), Fragile Constitution, Reckless From familiar bond Grogs, page 80"
            ^"Magical Qualities and Inferiorities" STRING "Gift Of Speech, Improved Abilities, Improved Confidence, Improved Defense x 3 (Talons), Improved Initiative x 3 (Talons), Improved Fatigue, Improved Might x 4, Improved Soak, Personal Power x 2 Combat Beak: Init +6, Attack +9, Defense +11, Damage –5 Talons: Init +14, Attack +9, Defense +20, Damage –4"
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0/0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
            ^"Powers" STRING "Human Shape: 1 point, Init +4, Corpus Fauconrouge can take human shape. Each transformation has Duration Sun. (Realms of Power: Magic, page 39) Iron Grip of the Raptor: 0 points, Init +4, Terram, This allows Fauconrouge to manipulate and carry items as if he had human hands and a Strength of +5. Fauconrouge must concentrate to do anything other than carry the object, including dropping it. Rego Terram 15 (Base 3, +1 Touch, +2 Sun, +1 Const) Personal Power 15 levels, Might cost reduced by 2."
            ^"Cord Scores" STRING "Gold +1, Silver +2, Bronze +2 (Binding Total 35) Bond Powers: Mental Communication: Alyssa and Fauconrouge have a constant mental link that is sophisticated enough to transmit complex images and emotions."
            ^"Vis" STRING "5 pawns of Corpus, in talons."
            ^"Appearance" STRING "A magnificent red gyrfalcon."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 52
        }
        ABILITIES {
            "Arabic" SCORE 3 SPECIALTY "Iberian"
            "Area Lore: County of Toulouse" SCORE 2 SPECIALTY "flight routes"
            "Athletics" SCORE 7 SPECIALTY "swift flight"
            "Awareness" SCORE 6 SPECIALTY "spotting prey"
            "Brawl" SCORE 4 SPECIALTY "talons"
            "Hunt" SCORE 5 SPECIALTY "game birds"
            "Magic Lore" SCORE 1 SPECIALTY "animals"
            "Magic Theory" SCORE 2 SPECIALTY "spells"
            "Occitan" SCORE 5 SPECIALTY "nobles"
            "Organization Lore: Jardin" SCORE 2 SPECIALTY "familiars"
            "Organization Lore: Order of Hermes" SCORE 1 SPECIALTY "House Bonisagus"
            "Latin" SCORE 5 SPECIALTY "academic terms"
            "Survival" SCORE 3 SPECIALTY "cold climes"
