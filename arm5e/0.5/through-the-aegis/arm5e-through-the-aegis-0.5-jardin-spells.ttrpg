EXTENSION "ArM5_Through_the_Aegis_Jardin_Spells" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Three: Jardin, A Summer Covenant spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t0361253d8e4c6bc6b87a4d ^"The Well Tended Vine" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrHe 5 R: Touch, D: Moon, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "Affects any plant, not just vines, but it was designed by Joia to protect the grape crop initially, and later to win prizes for best vegetable in village contests, before turning it to use on her gardens. The spell effects a plant of a mass equal to ten paces in each direction (that is the size of a small tree, or large vine). While under the influence of this spell the plant grows well, healthy and strong, and any fruit are large and succulent. It does not create the plant, and the plant does not become magical; it simply promotes healthy growth. (Base 1, +1 Touch, +3 Moon)"
    }

    #ta69fc531d35188b7528aee ^"The Healthy Vine" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrHe 5 R: Touch, D: Moon, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "Protects a plant of similar size to that described in The Well Tended Vine (above) above from all disease. Joia created the spell to protect the grapes during an outbreak of Powdery Mildew, a vine disease, but uses it extensively on the garden. (Base 1, +1 Touch, +3 Moon)"
    }

    #td5810348ac91d01107135b ^"Create the Flowers of the Moon" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrHe 15 R: Touch, D: Moon, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "Decorates a room with fresh flowers that grow normally and require care and watering. The quality of the floral display is determined by a Finesse roll. The flowers persist until the spell expires, then simply cease to exist. (Base 1, +1 Touch, +3 Moon, Group +2)"
    }

    #t36cb1db24570ed730824e2 ^"Cool the Lover’s Ardor" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReMe 20 R: Eye, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "The lover is caught for a moment by Joia’s eye, and thinks better of making any advances toward her until dusk or dawn. They know she will not welcome them. (Base 5, +2 Sun, +1 Eye)"
    }

    #t0fb45415e635eae807e121 ^"Detect the Gift" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Touch"
            ^"Printed Stat Line" STRING "InVi 20 R: Personal, D: Concentration, T: Touch"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "Joia found the process of locating a suitable apprentice difficult, and after several neardisasters when children she was hopeful of turned out to bewitched, faerie struck, influenced by demons, or in one case simply unbearably mad, she returned to the laboratory to create a spell that would confirm if a potential apprentice possessed The Gift. The child’s hair, Gifted or not, develops a subtle fragrance of flowers for a few hours after being touched. (Base 10, +1 Concentration, +1 Touch)"
    }

    #t853a9e3b4c43a8b367a387 ^"Lion of Outlandish Size" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 15
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual (+1 Size)"
            ^"Printed Stat Line" STRING "MuAn 15 R: Personal, D: Sun, T: Individual (+1 Size)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "Causes the caster to increase in Size by 1\n\npoint, with an increase in Strength of +2, and a reduction in Quickness of –1.. In Lioness form this gives Lexora a Size of +3. Her Strength increases by +2 to +8, and her Quickness falls by 1 to 0. This changes her combat statistics in lioness form to Claws: Init +1, Attack +15, Defense +11, Damage +12, Bite: Init +1, Attack +13, Defense +8 Damage +11. A Size +3 lioness is a terrifying sight, and inspires awe and fear. Her fur appears to become tinted with gold, and in this form she is the size of a war horse. (Base 4, +2 Sun, +1 Size)"
    }

    #t5f3847143294cc356861ca ^"The Fur That Turns Blades" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual (+1 Size)"
            ^"Printed Stat Line" STRING "MuAn 20 R: Personal, D: Sun, T: Individual (+1 Size)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "This spell causes Lexora’s fur to appear dappled with golden patches, as if in bright sunlight, and it grows warm to the touch. She becomes far more resistant to weapons, teeth or claws, but her fur remains supple, giving +3 protection with no load penalty. She usually casts this before going hunting or if expecting trouble. (Base 5, +2 Sun, +1 Size)"
    }

    #tfe36501b18c4086ad6b438 ^"Endurance of the Lion" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReAn 20 R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "(+1\n\nSize) As Endurance of the Berserkers (**ArM5**\n\npage134), but works in animal form. Lexora’s eyes take on a golden sheen as the spell takes effect, and her fur grows warm as if in direct sunlight. (Base 10, +1 Diameter, +1 Size)"
    }

    #tc7793aebb7367bf2fdf893 ^"The Lamb Lies Down With the Lion" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Spectacle"
            ^"Printed Stat Line" STRING "ReAn 30 R: Personal, D: Sun, T: Spectacle"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "Animals seeing the caster become strangely calm, and, unless attacked, act as if she were a harmless creature. Lexora usually casts this while around the covenant to prevent the horses or village livestock being frightened by her, although her Gift still applies to any direct interactions, for example if she approaches an animal. Lexora appears bathed in warm sunlight to anyone who can see her. (Base 4, Sun +2, Spectacle +4)"
    }

    #tadbb4f6bb936b117de1e15 ^"The Invisible Predator" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Spectacle"
            ^"Printed Stat Line" STRING "PeMe 30 R: Personal, D: Sun, T: Spectacle"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "The subjects simply disregard the caster of the spell, as if she is not there, their minds altered to remove any thought of her. This spell only works on intelligent creatures; those with Cunning require Animal as the Form. Those affected by Lexora’s spell feel the kiss of the sun on their skin, and at night in particular this may alert them something is wrong. This spell was invented by Androcles, and Lexora rarely uses it owing to the difficulty she has casting it reliably. (Base 4, Sun +2, Spectacle +4, +1 requisite)"
    }

    #tc111d1e45c7361ad87c739 ^"The Roar That Induces Terror" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Sound"
            ^"Printed Stat Line" STRING "CrMe 20 R: Personal, D: Diameter, T: Sound"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "The victims of this spell are overcome with a terrible fear of the source of the roar, and attempt to retreat from it. In Lexora’s version, as they hear the roar they also subtly feel the heat of the sun upon their skins. (Base 4, Diameter +1, Spectacle +3)"
    }

    #te8012e854c75ec9becdd07 ^"Aura of Regal Authority" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Spectacle"
            ^"Printed Stat Line" STRING "ReMe 30 R: Personal, D: Diameter, T: Spectacle"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 43
        }
        DESCRIPTION "Androcles developed this spell, and instils a sense of subservience to authority similar to the deference one might give a king in all who can see the caster. In Lexora’s version, those affected by the spell see her as always illuminated by the sun; during the day, this is literal, but at night Lexora simply looks impressive to them in a way that they naturally describe as being in sunlight. (Base 4, Diameter +1, Spectacle +4)"
    }

    #t3d7acb05c8e41e269a2757 ^"The Tremere Trench" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 20 R: Voice, D: Momentary, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "Digs a trench and piles the earth as a rampart on the other side, creating instantaneous earthworks. The trench can be any depth, width and length equivalent to not more than 1,000 cubic paces of earth, and the rampart created is an equivalent size. The lines of any earthworks created zig zag sharply owing to Ahernobarbus’ sigil. (Base 3, +1 part, +2 voice, +2 size for 1,000\n\ncubic paces of earth displaced)"
    }

    #tf19d606798f12417ee17f8 ^"The Mistaken Step" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "Rego Corpus 30 R: Sight, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 52
        }
        DESCRIPTION "Instantly moves a target up to 50 paces, at Sight range. Can be used gently, to move people around, or violently, to place them 50 paces in the air and allow them to fall to earth for +75 damage. The caster must be able to see both the starting and finishing locations. (Base 15, +3 Sight)"
    }

}
