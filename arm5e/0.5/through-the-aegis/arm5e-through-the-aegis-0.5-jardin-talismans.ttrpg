EXTENSION "ArM5_Through_the_Aegis_Jardin_Talismans" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Three: Jardin, A Summer Covenant talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #tf7218c96d0248f2e05d154 ^"Joia’s Trowel" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Joia du Lua of House Jerbiton"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 40
        }
        TABLE {
            "+7" "harm or repel faeries" "" "Attunement Bonuses"
            "+2" "building" "" "Attunement Bonuses"
            "+3" "divination" "" "Attunement Bonuses"
        }
        DESCRIPTION "Joia’s talisman is in the form of a small iron gardening trowel with a hazel handle.\n\nVis Capacity: 20; Total Pawns Invested: 2; Total Effect Levels: 17;"
    }

    #teb04d3f3b24c008ab66c5d ^"Xenophanes’ Sickle" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Xenophanes of House Criamon"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 45
        }
        TABLE {
            "+3" "Terram" "" "Attunement Bonuses"
            "+5" "Darkness" "" "Attunement Bonuses"
            "+2" "Harvesting" "" "Attunement Bonuses"
        }
        DESCRIPTION "Xenophanes’ talisman is in the form of a small bronze sickle.\n\n**Total Pawns Invested:** 7; Total Effect Levels: 60;"
    }

    #t41d28fb1bfc516a4b97e69 ^"Beatriz’s Talisman" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Beatriz of House Jerbiton"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 47
        }
        TABLE {
            "+3" "Corpus" "" "The talisman also has the following attunements"
            "+4" "affect breathing and speaking" "" "The talisman also has the following attunements"
            "+4" "affect Dead Wood" "" "The talisman also has the following attunements"
        }
        DESCRIPTION "Beatriz’s talisman is in the form of a simple wooden necklace she wears at all times. The bead is of amber and contains the carefully carved image of a crown.\n\n**Total Pawns Invested:** 7; Total Effect Levels: 54;"
    }

    #tcc7d651436b1b7f004df86 ^"Ahenobarbus’ Talisman" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Ahenobarbus of Tremere"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 50
        }
        TABLE {
            "+4" "control things at a distance" "Wand" "The talisman also has the following attunements"
            "+3" "Corpus" "Amber" "The talisman also has the following attunements"
        }
        DESCRIPTION "Ahenobarbus’ talisman is in the form of a wand with a tip of amber, and a hollow in the handle to contain an Arcane Connection to his laboratory. Total Pawns Invested: 9; Total Effect Levels: 86."
    }

    #t1b30f15ba89b37c4af4c0b ^"Alyssa’s Ring" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Alyssa, Maga Trianomae"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 52
        }
        TABLE {
            "+4" "affect wealth" "" "Attunement Bonuses"
            "+2" "constant effect" "" "Attunement Bonuses"
        }
        DESCRIPTION "Alyssa’s talisman is in the form of a golden ring that she wears on her right hand at all times. **Total Pawns Invested: **10; Total Effect Levels: 24"
    }

}
