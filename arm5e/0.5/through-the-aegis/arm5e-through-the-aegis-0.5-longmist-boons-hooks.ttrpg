EXTENSION "ArM5_Through_the_Aegis_Longmist_BoonsHooks" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Five: The Covenant of Longmist boons hooks"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's boons hooks, structured; each DESCRIPTION the source's text, verbatim.

    #tdfbb91305dd026bafe339d ^"Aura (Longmist)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Aura (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The mundane world contains only part of Longmist. The magi live and work in a tower that exists within a regio that sits atop the old covenant buildings, which have long been left to the covenfolk. Within this regio, which contains the main tower, the aura rises to six. An enchanted doorway provides a permanent route into the regio, so it is modeled here as an increased localized aura rather than by taking the Regio Boon."
    }

    #t10ac7bd19bb32188a064f4 ^"Magical Fortress (Longmist)" DEF {
        EXTENDS #tPQREJGlOrY8wo68HSSX9qvZ ^"Magical Fortress"
        PROPERTIES {
            ^"Printed Name" STRING "Magical Fortress (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "This is a tall tower raised from within the regio. The\n\ntower was conjured through ritual during Longmist’s long summer and is the work of a long-since dead Verditius specialist."
    }

    #t312b56dd7e4568f69bb853 ^"Mystical Allies (Longmist)" DEF {
        EXTENDS #tK2Pi5dsyhgEWadFeCliDjNA ^"Mystical Allies"
        PROPERTIES {
            ^"Printed Name" STRING "Mystical Allies (Major Boon)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "Longmist’s name carries weight with the Fir Bolg of Ireland, with airy spirits of the land and sky, and with the non-Hermetic druids of Connacht."
    }

    #t94c3a5bc20b4ba49bc729d ^"Aura x2 (Longmist)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Aura x2 (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The covenant’s general aura is five."
    }

    #t195e2b81984054f6718c30 ^"Seclusion (Longmist)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Seclusion (Minor Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "Long before the Normans came to Ulaid, the people of that land learned not to interfere with the druids of the long mists, and so the covenant receives few visitors to the valley that shrouds it."
    }

    #t27fb1516179b237d4c4211 ^"Divided Loyalty (Longmist)" DEF {
        EXTENDS #tyAKoGt7FTzfGTQpPHYgrz1E ^"Divided Loyalty"
        PROPERTIES {
            ^"Printed Name" STRING "Divided Loyalty (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The remaining covenfolk have loyalty to one of the two elder magi of Longmist. They hope to receive favor by supporting one over the other. This extends to the younger magi too, and perceived allies of one elder magus may be treated with suspicion by servants of the other."
    }

    #t4393fc971b6ce611768855 ^"Fractured Council (Longmist)" DEF {
        EXTENDS #ty7lueI0Gm2WEWrzKDcAaUit ^"Fractured Council"
        PROPERTIES {
            ^"Printed Name" STRING "Fractured Council (Major Hook)"
            ^"Magnitude" STRING "Major"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The council is in deadlock. The position of princeps is vacant and both of the elder magi desire it. The younger magi may be called upon to undertake tasks for these opposing masters and must chart a careful course between them."
    }

    #t33a7df9766f6a4ab844de7 ^"Contested Resource (Longmist)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Contested Resource (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "All Hibernian covenants must have a Cathach, or trophy, to prove their connection to Ireland and their worthiness to hold their lands. It must be kept outside the Aegis as a challenge to those who would test themselves against the covenant. In this case, Longmist’s Cathach is the pelt of a Bjornaer magus, ancestor to a covenant of Bjornaer wolves. The continued display of the pelt is an insult that has never been forgiven."
    }

    #t54fc1e7a4313ba9c14cedf ^"Crumbling (Longmist)" DEF {
        EXTENDS #tRwMRUb5UxjUdONUHoS3HkZq ^"Crumbling"
        PROPERTIES {
            ^"Printed Name" STRING "Crumbling (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The covenant is poorly-maintained, with plaster and mortar flaking from the walls, gates rusted shut, and doors and window shutters warped and ill-fitting."
    }

    #t445e326f27163fbc1f9920 ^"Deathbed Visitor (Longmist)" DEF {
        EXTENDS #tXEttjWlLgyfqAeFIzAI3apN ^"Deathbed Visitor"
        PROPERTIES {
            ^"Printed Name" STRING "Deathbed Visitor (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The local Ulaidh people fear the cry of the banshee as it heralds a doom. There are few things that would drive the mundane to the walls of Longmist, but the ungodly wail foretelling death is one of them. The covenant itself is not immune from the banshee’s power and it may be heard circling the valley, portending the death of one of the covenfolk. If the magi can capture the banshee, however, they may be able to prevent the death."
    }

    #tfd2c332d33cc2a0a314f9e ^"Dwindling Resource (Longmist)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Dwindling Resource (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "For years, the walls of Longmist have produced raw Vim vis. But the yield has recently been falling. Whether this is because the aura is generating less vis or the covenfolk have become less adept at finding it isn’t clear. This Hook applies to the From the Very Walls Themselves vis source as described later. From the start of play, the source loses 10% of its yield each year."
    }

    #t31299c6d30c8dc580cb70e ^"Faerie Court (Longmist)" DEF {
        EXTENDS #tsTPGzaRIVVwxKBDDacyIi4L ^"Faerie Court"
        PROPERTIES {
            ^"Printed Name" STRING "Faerie Court (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The kings and princes of the Túatha Dé Danann take an active interest in the magi of Longmist, especially Conchobor and those who support him. They provide service to Conchobor, including maintaining a watch over the Cathach, but they frequently ask for service in return."
    }

    #t0f7d5073174a5129daa0af ^"Superiors (Longmist)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Superiors (Minor Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Longmist"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 101
        }
        DESCRIPTION "The younger magi have few rights over the covenant’s resources. Requests for access or use must be put before the council and an inquorate council or veto from an elder means that the resource may be withheld. Negotiation and service is often required."
    }

    #tacdfdcb13e5975d3e35a9e ^"Criminals (Clan Mac Tire)" DEF {
        EXTENDS #tDNR0bn2wc1Ki76qHPEnwgsC ^"Criminals"
        PROPERTIES {
            ^"Printed Name" STRING "Criminals (Minor Residents Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Residents"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Not only do the magi raid the resources belonging to other covenants, but they offer a haven to mundane criminals and outlaws."
    }

    #t8b414f8f1466e81acf8176 ^"Difficult Access (Clan Mac Tire)" DEF {
        EXTENDS #toHkLxXYLWDAlAKCggYRkMTu ^"Difficult Access"
        PROPERTIES {
            ^"Printed Name" STRING "Difficult Access (Minor Fortifications Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Fortifications"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Many of the booley villages that the covenant uses are built on islands in the middle of lakes, which provides protection against intrusion. As the covenant seeks out those with Magical auras, some even host regiones, which offer even more protection."
    }

    #tfa9004ad6ab0fb99fd5f2d ^"Informants (Clan Mac Tire)" DEF {
        EXTENDS #t1YjWMwPZtiUAJ4FDbW5y8D7 ^"Informants"
        PROPERTIES {
            ^"Printed Name" STRING "Informants (Minor External Relations Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External Relations"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "The covenant maintains links with various robbers across Ulaid, whose information they use to plan their own activities."
    }

    #t7fbd2126ccc6994738b9fe ^"Hidden Resources (Clan Mac Tire)" DEF {
        EXTENDS #tWz08H40XIFI8HYJLjvKVjxa ^"Covenant Boon"
        PROPERTIES {
            ^"Printed Name" STRING "Hidden Resources (Minor Resource Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Resource"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "In order to reduce the amount that the covenant needs to carry with them, some of the covenant’s resources are stored in the booleys that they frequently visit. This means that not all covenant resources are immediately available."
    }

    #tca123e5c4423e5fca10b5e ^"Hidden Ways (Clan Mac Tire)" DEF {
        EXTENDS #tLwXPOOo6nf2yoDzzrbLmjrN ^"Hidden Ways"
        PROPERTIES {
            ^"Printed Name" STRING "Hidden Ways (Minor Surroundings Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Surroundings"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Both as wolves of the wilderness and as magi, the clan knows the best paths surrounding their regular booley camps."
    }

    #tbf863f74c9cc339480d321 ^"Indiscreet Resource (Clan Mac Tire)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Indiscreet Resource (Major Resource Hook)"
            ^"Magnitude" STRING "Major"
            ^"Category" STRING "Resource"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Most of the Clan’s income comes from theft, robbery, and coercion."
    }

    #t0d80479bd3cafbc57359f7 ^"Erratically Mobile (Clan Mac Tire)" DEF {
        EXTENDS #t6H11FY2AzwNOcvopcEQYSoy ^"Erratically Mobile"
        PROPERTIES {
            ^"Printed Name" STRING "Erratically Mobile (Minor Site Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Site"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "The Clan moves frequently, sometimes staying just a season in each booley."
    }

    #tebc2d5b2faec443bd5e63f ^"Infamous (Clan Mac Tire)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Infamous (Minor External Relations Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External Relations"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "Clan Mac Tire"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "The Clan Mac Tire is well-known by other covenants across Hibernia."
    }

}
