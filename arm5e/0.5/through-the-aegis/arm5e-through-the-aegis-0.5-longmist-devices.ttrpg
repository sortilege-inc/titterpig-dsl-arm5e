    }

    #t90040d45c61caf1a0560fa ^"The Master At Work" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 49
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Effect Line" STRING "ReTe(Me) 49 Pen +0, Constant Effect R: Personal, D: Sun, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "The automaton has been invested with the Craft: Blacksmith Ability to a score of 5. (Effect: Base 5, +2 Sun, +1 Part, +1 Mentem requisite, +4 for a score of 5; Modifications: +1 for 2/day, +3 triggered at sunrise/set) Further information on the powers detailed above and their costs is available in Houses of Hermes: Mystery Cults, page 129."
    }

