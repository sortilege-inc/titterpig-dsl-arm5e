            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Sun; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "CrIg 14 Pen +0, constant effect R: Personal, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "As per the Heat of the Searing Forge spell in ArM5, page 140."
    }

    #tbf401fe3377ebd6bf92e8a ^"The Floating Stones of Maghera (effect)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "The Floating Stones of Maghera"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Sun, +1 Stone; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "ReTe 14 Pen +0, constant effect R: Personal, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "Each stone has a power similar to the Unseen Porter spell in ArM5, page 154, that affects the stone itself. The stones are seemingly not impeded by objects placed above it, and they have the power to hold things aloft. It takes a strong man to move one of the stones but once moved it remains where it was put, without any visible means of support."
    }

}
