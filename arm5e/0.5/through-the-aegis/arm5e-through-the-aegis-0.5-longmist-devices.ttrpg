            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +2 metal, +1 Diameter; Modifications: +3 triggered by Divine the Heavens’ Aspect)"
            ^"Printed Effect Line" STRING "ReTe 8 Pen +0, 1/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This effect tolls the bell at each equinox and solstice through the year."
    }

    #te045f76706844d7c063f3d ^"Shard of Iron" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
