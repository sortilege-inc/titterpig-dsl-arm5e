            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This power gives the automaton a Dexterity of +1 as per the description in Houses of Hermes: Mystery Cults, page 130. (Effect: Base 10, +2 Sun, +1 Part; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
    }

    #t8a7e998570745508cf7229 ^"Strength of the Master" DEF {
