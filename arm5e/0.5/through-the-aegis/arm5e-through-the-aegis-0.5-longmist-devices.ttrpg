            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +2 metal, +1 Diameter; Modifications: +3 triggered by Divine the Heavens’ Aspect)"
            ^"Printed Effect Line" STRING "ReTe 8 Pen +0, 1/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This effect tolls the bell at each significant phase of the moon, such as new, quarter, and full moons."
    }

    #t6c9f22483cf71febbf7259 ^"Toll the Equinoxes and the Solstices" DEF {
