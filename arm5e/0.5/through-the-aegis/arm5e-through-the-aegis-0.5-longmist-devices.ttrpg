            ^"Level" INTEGER 40
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "PeCo 40 Pen +20, Unlimited R: Voice, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "As per the spell in ArM5, page 133. (Effect: Base 10 +2 Voice; Modifications: +10 Unlimited Use, +10 for +20 penetration)"
    }

    #tcc0528cf9f002dccfc6953 ^"Whispers Through the Black Gate (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Whispers Through the Black Gate"
            ^"Part Of" STRING "Lugh-éccnaid’s Talisman"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "InCo(Me) 25 Pen +0, Unlimited R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "As per the spell in **ArM5**, page 130. (Effect: Base 5, +1 Touch, +1 Concentration; Modifications: +10 Unlimited Use)"
    }

    #tbfef5e778bb3311a7068cb ^"The Youthful Visage" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Lugh-éccnaid’s Talisman"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Concentration; Modifications: +4 for 12/day, +5 device maintains concentration)"
            ^"Printed Effect Line" STRING "MuIm 14 Pen +0, 12/day R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "Despite Lugh’s years, this effect returns his youthful appearance, becoming once more a man in his early thirties. In his vanity, he is rarely seen without this effect in operation, but mindful of additional Warping he suspends the effect when alone."
    }

    #tee8490ee4c3a5dc9a61d37 ^"The Guiding Hand" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Talisman"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Voice, +1 Concentration; Modifications: +11 for +22 Penetration, +4 for 12/day)"
            ^"Printed Effect Line" STRING "PeCo 30 Pen +22, 12/day R: Voice, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "Causes pain to people or creatures normally affected by Corpus effects, such as faeries that adopt human forms and identities."
    }

    #td6fe87abc621099fe33610 ^"Bring the Light" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Talisman"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +1 Concentration; Modifications: +4 for 12/day, +5 device maintains concentration)"
            ^"Printed Effect Line" STRING "CrIg 19 Pen +0, 12/day R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "Like Lamp without Flame, Conchobor’s arm gives off a white light, illuminating an area about ten paces across. Once triggered, the device maintains concentration."
    }

    #t45640abb669a2549e7d890 ^"Banish the Light" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Talisman"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch, +1 Concentration, +3 Structure; +5 device maintains concentration)"
            ^"Printed Effect Line" STRING "PeIg 25 Pen +0, 1/day R: Touch, D: Concentration, T: Structure"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "As the spell Well Without Light, all light is magically subdued in the target structure. Creo Ignem effects greater than level 20 can overcome this magical darkness."
    }

    #td3254bd03ec47f1d5d51aa ^"This Room is Mine to Command" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Talisman"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited use"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch, +1 Concentration, +2 Room; Modifications: +5 device maintains concentration, +10 unlimited use)"
            ^"Printed Effect Line" STRING "ReTe 30 Pen +0, unlimited use R: Touch, D: Concentration, T: Room"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "Allows Conchobor to remotely manipulate items in his environment as though he had Strength +5. Particularly fine control requires Finesse stress rolls against Ease Factors of 12 or more."
    }

    #t929911b8b772774c39900c ^"Cloak of the Túatha Dé Danann" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Devices"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+14"
            ^"Uses" STRING "Unlimited Use"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch, +4 Vision Target; Modifications: +3 triggered by proximity to the regio boundary, +10 unlimited use, +7 for +14 Penetrations)"
            ^"Printed Effect Line" STRING "InVi 40 Pen +14, Unlimited Use R: Touch, D: Momentary, T: Vision"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "When wrapped around him, the cloak allows Conchobor to pass through faerie regiones as easily as the Túatha Dé Danann themselves do. The effect is triggered by proximity to the boundary, and the wearer can decide whether to step through or not. The effect must penetrate the Magic Resistance of its wearer in order to reveal the way through the boundary. As a result, Conchobor has to suspend his Parma Magica to use this device."
    }

    #t613f718462fd4d2f24af19 ^"Staff of Denial" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Conchobor’s Devices"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+16"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Special"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun, +1 Special Target; Modifications: +2 for 6/day, +8 for +16 Penetration)"
            ^"Printed Effect Line" STRING "ReVi 30 Pen +16, 1/day R: Touch, D: Sun, T: Special"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "This device is a staff made from dogwood, shod with lead, and with a chain of iron shackles secured at the top. When the staff is dragged in a line on any surface, no faerie with Might of 15 or less may cross that line. This warding effect is less powerful than a circular ward, but drawing the line requires no concentration and is usually sufficient to create a lesser ward across an opening or tunnel.\n\nIt has been designed with a base effect of 4; we are using the base effect normally associated with a standard ward against Might 15 creatures and reworking it for different effect parameters."
    }

    #t9d1842fe678363472c0931 ^"Sense the Scale of Divine Power" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Wand of the Cailleach"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Touch"
            ^"Effect Design" STRING "(Effect: Base 2, +1 Touch Target, +2 Sun; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "InVi 9 Pen +0, Constant Effect R: Personal, D: Sun, T: Touch"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "The wand constantly collects information on the prevailing aura surrounding it. Both the supernatural realm and the intensity of the aura is detected through four effects, each dedicated to a particular realm. The information gathered is not relayed directly to the item’s wielder but is used instead to trigger a further effect, described below, which avoids the danger of a constant source of Warping."
    }

    #t31ce3bc6302d54da55bdce ^"Know the Power" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Wand of the Cailleach"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3; Modifications: +12 linked triggers, +10 unlimited use)"
            ^"Printed Effect Line" STRING "InVi 25 Pen +0, Unlimited R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "This effect is triggered by the four Sense the Scale effects described above. Its sole purpose is to gather the information made available by those effects and make it available to subsequent effects that may then be subsequently triggered by this effect."
    }

    #t1c199bf0b17e6c6eda59ed ^"The Power’s Light" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Wand of the Cailleach"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 22
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Concentration; Modifications: +3 linked trigger, +5 device maintains concentration, +10 unlimited use)"
            ^"Printed Effect Line" STRING "CrIg 22 Pen +0, Unlimited R: Personal, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "Triggered by the Know the Power effect described above, the glass within the wand glows with a pure white light when in the presence of the Dominion. The light increases in brightness with the magnitude of the aura such that the Cailleach, and those who understand the effect, are always aware of the aura and its strength.\n\nInformation gained from the linked effects are as follows:\n\n• The light glows white in the presence of a Dominion aura. • The light glows red in the presence of an Infernal aura. • The light glows blue in the presence of a Magical aura. • The light glows green in the presence of a Faerie aura."
    }

    #t3d78a94b501a58ec65621d ^"Great Sword of the Moon" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Effect: Base 2, +3 Sight, +2 Group, +1 Concentration; Modifications: +5 device maintains concentration, +10 unlimited use, +10 for +20 Penetration)"
            ^"Printed Effect Line" STRING "MuCo 45 Pen +20, Unlimited R: Sight, D: Concentration, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "When the sword is drawn, members of the target group who consider themselves Ruadan’s allies see the sword of the moon glow brightly with pure moonlight. When in its presence, they can see in absolute darkness as though it were a clear night with a full moon."
    }

    #t0744042b6a4742e106d0ec ^"The Knife of Sorrows" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+50"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +3 Moon; Modifications: +25 for +50 Penetration)"
            ^"Printed Effect Line" STRING "CrMe 45 Pen +50, 1/day R: Touch, D: Moon, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "Poisons the target’s mind with inconsolable loss that lasts for a Moon. The effects are debilitating, requiring a Personality Roll against Ease Factor 9 to hold the thoughts back for a day. Failure imposes a –3 penalty on all totals."
    }

    #t6fee64170233ada7a7b532 ^"Death with Each Blow" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 38
            ^"Penetration" STRING "+40"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +1 Touch; +3 6/day, +20 for +40 Penetration)"
            ^"Printed Effect Line" STRING "PeAn 38 Pen +40, 6/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "If the effect penetrates a beast’s Magic Resistance, it is instantly struck with a Medium wound in addition to any wound that the ax blow itself causes."
    }

    #tf2372f4134b7f6fce345f6 ^"Dull the Stamina of the Wolf" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 31
            ^"Penetration" STRING "+40"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 4, +1 Touch; +3 triggered by Death with Each Blow, +3 for 6/day, +20 for +40 Penetration)"
            ^"Printed Effect Line" STRING "PeAn 31 Pen +40, 6/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 123
        }
        DESCRIPTION "Triggered when the linked Death with Each Blow effect penetrates, this effect fatigues the target animal, causing the beast to lose a Fatigue Level."
    }

    #te679b6dc20f761b084221b ^"Freedom of Movement" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 29
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Effect Line" STRING "ReTe(Me) 29 Pen +0, Constant Effect R: Personal, D: Sun, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "The automaton is able to walk to places as directed by a human controller or to meet the needs of any other instructions. For such a large device, the automaton is careful to avoid causing damage to people or things around it. (Effect: Base 5, +2 Sun, +1 Part, +1 Mentem requisite; Modifications: +1 for 2/ day, +3 triggered at sunrise/set)"
    }

    #t6485b4bcc17f86bec2f0ad ^"Dexterity of the Master" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
