            ^"Page" INTEGER 127
        }
        DESCRIPTION "This lesser enchanted device, once entrusted to teamsters and other covenfolk, checks whether the weight of something bought at market is as agreed. It takes the form of an iron hook attached to a short length of rope. The device is triggered by looping the hook into the item to be weighed, usually a bale or barrel, and pulling upon the short handle of rope. The device user immediately learns the target’s weight to the desired level of detail, be it a grain, an ounce, a pound, or a ton.\n\nThe laboratory text for this device costs 2BP."
    }

    #tfb368c409722bd83c1a4c5 ^"Honesty of the Unbalanced Merchant" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 28
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "Pen +20, 6/day ReMe 28 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The effect, enchanted into a plain and unobtrusive ring as a lesser enchantment, is activated upon shaking hands with the target. It strongly inclines the target to be truthful, going so far as to admit any lie, deception, or other untruth just told to the device wearer. This is not automatic, however. An Untruthful or similar Personality Trait roll against an Ease Factor of 9 is required for the target to avoid immediately blurting out the truth.\n\nThe ring was given to covenfolk going to market to ensure to help them avoid being taken advantage of by canny and ruthless traders.\n\nThe ring is designed to include a Penetration score in order to deal with traders and merchants who might hide behind relics or even Infernal protection.\n\nThe laboratory text for this device costs 6BP. (Effect: Base 10, +1 Touch; Modifications: +3 for 6/day, +10 for +20 Penetration)"
    }

    #t9a7d754bc4c8429888f8fa ^"Animate this Form" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Cearnach’s Distant Twin"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 50
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +4 Arcane Connection, +1 Concentration; +5 device maintains concentration, +10 unlimited use)"
            ^"Printed Effect Line" STRING "Pen +0, Unlimited ReHe 50 R: Arcane Connection, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This effect animates the wooden man under the control of the device user. Even relatively fine movements are no problem under calm conditions, although a Finesse roll is required under stress.\n\nThe wooden man has physical statistics of 0 for each of Strength, Stamina, Dexterity, and Quickness and these are used in place of the magus’ own."
    }

    #t2c54009c39c6bed8f05d5f ^"His Sight Is Mine" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Cearnach’s Distant Twin"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Special"
            ^"Effect Design" STRING "(Effect: Base 5, +4 Arcane Connection, +1 Concentration, +3 for special Target; Modifications: +5 device maintains concentration, +10 unlimited use)"
            ^"Printed Effect Line" STRING "Pen +0, Unlimited InIm 60 R: Arcane Connection, D: Concentration, T: Special"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "Allows the magus to operate all senses at a distance through the target wooden figure."
    }

    #t5fe663731882797ce71595 ^"Clothe this Form" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Cearnach’s Distant Twin"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 5, +4 Arcane Connection, +1 Concentration; Modifications: +5 device maintains concentration, +10 unlimited use)"
            ^"Printed Effect Line" STRING "Pen +0, Unlimited MuIm 45 R: Arcane Connection, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This effect changes all species emitted by the target figure into those normally emitted by the device’s user. A Finesse roll is required, as described in **ArM5**, page 143 but the device creator gains a +3 to this roll.\n\nCearnach’s original version of this effect included one experimental sideeffect; the image is mirrored such that a scar on the left hand appears on the right. The movement of the image is unaffected, however."
    }

    #tc3b49d8e846db3e5b9b63f ^"Ualgrimm’s Pelt" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, +1 Concentration; Modifications: +5 device maintains concentration)"
            ^"Printed Effect Line" STRING "MuCo(An) 25 Pen +0, 1/day R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "This power is triggered by placing the pelt over the target, and that target is transformed into a wolf. The target may change back at will, ending the effect. The effect is a physical transformation and the target’s mind and character are unchanged."
    }

    #t4c499849604ebf8a94a57a ^"The Enchanted Door" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Requisite" STRING "Imaginem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited use"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +4 Vision, free requisite; +10 unlimited use)"
            ^"Printed Effect Line" STRING "InVi(Im) 30 Pen +0, unlimited use R: Touch, D: Momentary, T: Vision"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "This door installed into a wall in the lesser tower opens into the greater tower by spanning the regio boundary. This allows covenfolk without Second Sight to move freely between the regio layers by simply touching the door, which reveals the regio. Movement through the door does not cause Warping."
    }

    #t3ebda756158065501b59e9 ^"Cearnach’s Mount" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 51
            ^"Requisite" STRING "Rego, Terram"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Rego, +1 Touch, +2 Sun, +1 Size, +2 Group; Modifications: +1 2/day)"
            ^"Printed Effect Line" STRING "Cr(Re)An(Te) 51 Pen +0, 2/day R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This effect creates a living horse and riding tack at the user’s command. The horse becomes fatigued as normal and must be fed and tended, but it is compliant to those with The Gift. In addition, a magus may substitute his Finesse Score for Ride or Animal Handling when riding or interacting with the summoned animal.\n\nAn Intelligence + Finesse roll is used to determine the quality of the saddle, bridle, and reins."
    }

    #tfecf376feb8877ef9c877f ^"Divine the Heavens’ Aspect" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Observance Bell"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 29
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, +2 Sun; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "InVi 29 Pen +0, Constant Effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "As per the effect detailed in The Mysteries: Revised Edition, page 51, the bell has the ability to “watch the heavens” and take constant measurements as to the movement of the sun and the moon through the day and night, the phase of the moon, the seasons, and the year.\n\nThis provides enough information to trigger the other effects invested within the bell."
    }

    #t5e14a7e487f5647ad0a007 ^"Toll the Offices" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Observance Bell"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 12
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +2 metal, +1 Diameter; Modifications: +4 for 12/day, +3 triggered by Divine the Heavens’ Aspect)"
            ^"Printed Effect Line" STRING "ReTe 12 Pen +0, 12/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "Designed into this effect are the hours and offices of Longmist. At the time for each, the bell tolls, sounding through the covenant, calling the magi to assemble."
    }

    #t9769ecec2066997877ed85 ^"Toll the Phases of the Moon" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
