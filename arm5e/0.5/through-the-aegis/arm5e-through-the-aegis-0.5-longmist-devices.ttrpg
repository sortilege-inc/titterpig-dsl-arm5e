EXTENSION "ArM5_Through_the_Aegis_Longmist_Devices" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Five: The Covenant of Longmist devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tc082f64d9bb70ece38e021 ^"Perfect Circle" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Lugh-éccnaid’s Talisman"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 13
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3; Modifications: +10 Unlimited Use)"
            ^"Printed Effect Line" STRING "ReHe 13 Pen +0, Unlimited R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "The staff draws a geometrically-perfect standard-sized circle in the ground without the need for the magus to guide the staff, particularly useful when concentrating on other spells or preparing to cast a Circle spell. Note that a magus must still trace the circle by hand to actually cast a Ring or Circle spell (**ArM5**, page 112)."
    }

    #t68faba1f0b9b2533df4b32 ^"Lifting the Dangling Puppet (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Lifting the Dangling Puppet"
            ^"Part Of" STRING "Lugh-éccnaid’s Talisman"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReCo 40 Pen +20, Unlimited R: Voice, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "As per the spell in **ArM5**, page 134. (Effect: Base 4, +2 Voice, +1 Concentration; Modifications: +5 Device maintains concentration, +10 Unlimited Use, +10 for +20 penetration)"
    }

    #tce5cc2ae3f11f74634039f ^"Invocation of Weariness (Lugh-éccnaid)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
