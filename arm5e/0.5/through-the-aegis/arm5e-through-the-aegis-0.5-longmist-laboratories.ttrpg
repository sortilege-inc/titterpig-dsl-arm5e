EXTENSION "ArM5_Through_the_Aegis_Longmist_Laboratories" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Five: The Covenant of Longmist laboratories"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's laboratories, structured; each DESCRIPTION the source's text, verbatim.

    #t23b32866a484ddc75a13bf ^"Lugh-éccnaid’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 5
            ^"General Quality" INTEGER 3
            ^"Upkeep" INTEGER 8
            ^"Safety" INTEGER 8
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 1
            ^"Aesthetics" INTEGER 7
            ^"Names Added to Sanctum Marker" STRING "None"
            ^"Characteristics" STRING "Size +0 (0), Refinement +5, General Quality +3, Upkeep +8 (36 Mythic Pounds per year), Safety +8, Warping +0, Health +1, Aesthetics +7"
            ^"Virtues & Flaws" STRING "Greater Feature (Cauldron), Highly Organized, Priceless Ingredients, Spotless, Spacious, Gallery, Elevated, Greater Expansion; Greater Focus (Cauldron)"
            ^"Specializations" STRING "Longevity Rituals +11, Teaching +1; Creo +1; Auram +1"
            ^"Features" STRING "Cauldron"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 116
        }
        DESCRIPTION "Lugh-éccnaid’s laboratory occupies the upper-most levels of the hidden tower of Longmist, having been expanded in the past so that it spans two floors. Much of the work is done on the lower level where a great cauldron has been installed, but the gallery formed from the upper level provides areas for contemplation, writing, and space for Lugh’s personal library and stores.\n\nThis laboratory is highly specialized toward the development of Longevity Rituals.\n\nThese enhancements cost 60 Build Points."
    }

    #t962b750461d35052ec1620 ^"The Cailleach’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 2
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 3
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (–2), Refinement +2, General Quality –1, Upkeep +0 (1 Mythic Pound per year), Safety +3, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Greater Feature (Forge), Highly Organized, Superior Tools; Greater Focus (Forge)"
            ^"Specializations" STRING "Enchanting Items +8"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "A forge dominates the Cailleach’s laboratory and the external walls have are punctured by iron hollows and chimneys through which air is pulled and smoke expelled. The sound of the bellows reverberates as the fires reach magically high temperatures: perfect for forging and welding raw magic to devices. Her superior tools are made and maintained by Cathal Gobha and so do not increase the Upkeep cost of this laboratory.\n\nThese enhancements cost 20 Build Points."
    }

    #tf5d15e4bc99023d22180a5 ^"Dara’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -2
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 0
            ^"Warping" INTEGER 1
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 1
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +0, General Quality –2, Upkeep +0 (1 Mythic Pound per year), Safety +0, Warping +1 Health +0, Aesthetics +1"
            ^"Virtues & Flaws" STRING "Greater Feature (Summoning Circle); Greater Focus (Summoning Circle), Haunted"
            ^"Specializations" STRING "Inventing Spells +5; Rego +2; Mentem +2"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This laboratory is dominated by the summoning circle built into a raised circular dais in the center of the chamber. The laboratory equipment lines the walls and Dara has made efficient use of his space.\n\nHowever, the laboratory, or something in it, appears to be haunted. Dara has not seen anything, and his magic has not yet detected a rogue presence, but he is certain that his equipment and notes are interfered with while his back is turned. Given his Dark Secret, Dara is particularly fearful of what the presence may in fact be.\n\nThese enhancements cost 20 Build Points."
    }

    #te709c4d9d819600763129d ^"Eochaid’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 1
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 2
            ^"Safety" INTEGER -1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +1, General Quality –1, Upkeep +2 (3 Mythic Pounds per year), Safety –1, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Greater Feature (Mirror), Lesser Feature (Window), Excessive Lighting, Highly Organized; Greater Focus (Mirror), Awkward Shape"
            ^"Specializations" STRING "Imaginem +10"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Unlike the other laboratories and chambers within Longmist, this room is stark brilliant white. The walls have been plastered smooth and then painted with the most unnatural white that the covenant could acquire. The curved outer tower wall has a large round window that reaches almost floor to ceiling. The images visible through this window are reflected onto a series of hand-sized mirrors mounted against the inner wall, each at a slightly different angle or depth.\n\nThe whole room is highly illuminated by scores of candles and Eochaid has promised to find a cheaper solution to lighting his sanctum. All the equipment must be kept away from the walls for fear of blemishing their purity, so the laboratory may seem a little awkward to some.\n\nThese enhancements cost 40 Build Points."
    }

    #t7913c20ebc569e89275073 ^"Mícheál’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 2
            ^"General Quality" INTEGER 1
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 2
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Conchobor Crosach, Lugh-éccnaid"
            ^"Characteristics" STRING "Size +0 (0), Refinement +2, General Quality +1, Upkeep +0 (1 Mythic Pound per year), Safety +2, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Auspicious Shape, Highly Organized, Lesser Feature (Summoning Circle)"
            ^"Specializations" STRING "Inventing Spells +1; Vim +1"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Mícheál has spent a year enhancing his laboratory, refining it across two seasons and then creating an Auspicious Shape by turning his chambers into a pentagon, and further by engraving a Summoning Circle into the floor.\n\nHe has plans to extend his laboratory further to add both an Antechamber and a Balcony.\n\nThese enhancements cost 20 Build Points."
    }

    #te13b1a48c183ce2bcecb51 ^"The Remaining Laboratories (Longmist)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "The Remaining Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER -2
            ^"Safety" INTEGER -1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER -2
            ^"Names Added to Sanctum Marker" STRING "No Sanctum Marker"
            ^"Characteristics" STRING "Size +0 (–1), Refinement +0, General Quality –1, Upkeep –2 (1/2 Mythic Pound per year), Safety –1, Warping +0, Health +0, Aesthetics –2"
            ^"Virtues & Flaws" STRING "Missing Equipment, Decaying, Missing Sanctum Marker"
            ^"Specializations" STRING "+2 Perdo Impossible Activities: Enchanting Items"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "There are three other laboratories that are currently unoccupied. Much of the valuable equipment has been reused elsewhere, and what has been left is decaying. They each have the following statistics.\n\nThese extra laboratories costs the covenant 150 Build Points."
    }

    #t56707104fb50c319642131 ^"Mobile Laboratories (Longmist)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "Mobile Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER 0
            ^"Upkeep" INTEGER -1
            ^"Safety" INTEGER -2
            ^"Warping" INTEGER 0
            ^"Health" INTEGER -5
            ^"Aesthetics" INTEGER -3
            ^"Names Added to Sanctum Marker" STRING "None"
            ^"Characteristics" STRING "Size +0 (0), Refinement +0, General Quality +0, Upkeep –1, Safety –2, Warping +0, Health –5, Aesthetics –3"
            ^"Virtues & Flaws" STRING "Lesser Feature (cauldron), Living Quarters, Mobile, Specimens, Servant; Hovel"
            ^"Specializations" STRING "+1 Animal, +2 Experimentation, +1 Mentem The servant (with Intelligence +2) is a learned clerk who sees to the needs of the magi in their laboratories. He does a good job for the magi but his loyalty is born of fear rather than attachment."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "Each of the Mac Tire magi has a similar laboratory designed to be packed away for easy transport by the team of servants and soldiers in their employ. As these laboratories usually include the magus’ living quarters they have significant downsides, something that the younger magi in the covenant frequently complain about."
    }

}
