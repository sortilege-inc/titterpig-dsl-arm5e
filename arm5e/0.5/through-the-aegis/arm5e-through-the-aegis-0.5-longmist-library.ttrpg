    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #t6b9b8cf488362862d3ff00 ^"De Initio Creaturae (Longmist Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "De Initio Creaturae"
            ^"Author" STRING "Aelfric"
            ^"Kind" STRING "Tractatus"
