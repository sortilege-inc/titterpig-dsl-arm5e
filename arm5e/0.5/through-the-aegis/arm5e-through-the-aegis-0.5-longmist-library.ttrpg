            ^"Build Points" INTEGER 9
            ^"Section" STRING "Arcane Abilities"
            ^"Printed Entry" STRING "Aelfric, De Initio Creaturae, Dominion Lore Tractatus, Quality 9. Part of a volume that also provides a Tractatus on Infernal Lore. (9BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 123
        }
    }

    #t7e168ec67c5ea894f9b469 ^"The Llancarfan Saints’ Lives (Longmist Library)" DEF {
