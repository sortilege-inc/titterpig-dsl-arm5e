    #td23056da71f0c23798a740 ^"In innectis de phylacterium (Longmist Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "In innectis de phylacterium"
