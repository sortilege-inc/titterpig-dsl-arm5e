EXTENSION "ArM5_Through_the_Aegis_Longmist_Talismans" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Five: The Covenant of Longmist talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t0feb3368ba531e3cb80930 ^"Lugh-éccnaid’s Talisman" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Lugh-éccnaid"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 105
        }
        TABLE {
            "+3" "Air" "Agate" "Attunements"
            "+5" "Protection from Storms" "Agate" "Attunements"
            "+2" "Repel things" "Staff" "Attunements"
            "+4" "Control things at a distance" "Staff" "Attunements"
            "+4" "Destroy things at a distance" "Staff" "Attunements"
        }
        DESCRIPTION "Lugh’s talisman is a slender staff of rowan wood that has developed a lustrous patina over nearly a century of use. An agate is affixed to the staff’s head, bound by strips of leather and resin. It has been opened to 20 pawns of vis so far, and 15 of those pawns have been spent on enchantments."
    }

    #tc505412bea7b11b3a87147 ^"Conchobor’s Talisman" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "Conchobor"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 107
        }
        TABLE {
            "+7" "harm or repel faeries" "Iron" "Attunements"
            "+4" "affect things by touch" "Glove" "Attunements"
            "+4" "manipulation at a distance" "Glove" "Attunements"
            "+5" "darkness" "Bronze" "Attunements"
        }
        DESCRIPTION "Conchobor enchanted a bronze glove, created for him by a smith of the Túatha Dé Danann. The bronze was smelted in fires fueled by exotic citrus woods from far across the seas and the glove was as supple as calf-leather. Before he took this wondrous item into his laboratory, however, he had Faventinus of Verditius carefully replace each rivet with one made of iron.\n\nHe then opened the device for enchantment and with its first effect invested took it to the Túatha Dé Danann. He tried to use its new power to best his allies, to become their master, but he misjudged their power and their response was swift. They caused the glove to grow and to fuse with his flesh such that it now covers his left arm from shoulder to finger tip. The pain of that experience stays with him still as does the memory that the Túatha Dé Danann still hold a powerful Arcane Connection to him: a coin forged by Ruadan of the Túatha Dé Danann from Conchobor’s pain.\n\nThe Arm of Conchobor has been opened with 20 pawns of vis and enchanted with the following effects, which use 13 pawns of space:"
    }

    #t230081540984bf9f6a28aa ^"Wand of the Cailleach" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Owner" STRING "The Cailleach"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 108
        }
        TABLE {
            "+2" "Repel things" "Wand" "Attunements"
            "+3" "Project bolt or other missile" "Wand" "Attunements"
            "+4" "Control things at a distance" "Wand" "Attunements"
            "+4" "Destroy things at a distance" "Wand" "Attunements"
            "+7" "Produce light" "Lamp" "Attunements"
            "+4" "Create fire" "Lamp" "Attunements"
        }
        DESCRIPTION "Cailleach’s talisman takes the form of a slender wand of gleaming steel. From afar, it appears to be a solid piece, but its construction is revealed close-up. It has a core of colored glass that runs its length and the wand was made in the manner of a rope twisted around this core. Here and there, the colored glass appears behind and through the steel, and it glows when magical power is used through it. The steel used in the wand was reforged from what was once a magical lamp created by one of her forebears at the covenant.\n\nIts current vis capacity is 10 with all of those pawns used. Cailleach’s Verditius Magic provides a +4 (equal to her Philosophiae Score and specialty) Shape and Material bonus to future enchantments."
    }

}
