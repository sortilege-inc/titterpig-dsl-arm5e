EXTENSION "ArM5_Through_the_Aegis_NorthernSeas_BoonsHooks" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas boons hooks"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's boons hooks, structured; each DESCRIPTION the source's text, verbatim.

    #t280093c284abfebb04ad1d ^"Mystical Allies (The Northern Seas)" DEF {
        EXTENDS #tK2Pi5dsyhgEWadFeCliDjNA ^"Mystical Allies"
        PROPERTIES {
            ^"Printed Name" STRING "Mystical Allies (Major Surroundings Boon)"
            ^"Magnitude" STRING "Major"
            ^"Category" STRING "Surroundings"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Merfolk are more than just stories that old sailors tell for the price of an ale. They have their kingdoms beneath the sea, they have their princes and their rogues, and so long as the covenant of the Northern Seas treats them well, they make potent allies."
    }

    #t8d8f0c2cc742b8fa60d85d ^"Criminals (The Northern Seas)" DEF {
        EXTENDS #tDNR0bn2wc1Ki76qHPEnwgsC ^"Criminals"
        PROPERTIES {
            ^"Printed Name" STRING "Criminals (Minor Residents Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Residents"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Whether on land or on sea, the covenant can call upon men willing to risk punishment under law on the covenant’s behalf."
    }

    #t9980b01f49abe01b099d30 ^"Difficult Access (The Northern Seas)" DEF {
        EXTENDS #toHkLxXYLWDAlAKCggYRkMTu ^"Difficult Access"
        PROPERTIES {
            ^"Printed Name" STRING "Difficult Access (Minor Site Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Site"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Knowing where the covenant is going to be makes for a good start, but those intent on visiting must have means to travel to the ships on the open seas."
    }

    #tce2bb68e3b9209b3257da5 ^"Famous Resident (The Northern Seas)" DEF {
        EXTENDS #tiyKlBI3N9y2wEfAGXJU5cry ^"Famous Resident"
        PROPERTIES {
            ^"Printed Name" STRING "Famous Resident (Minor Resident Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Resident"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Carles Magnus has built a reputation for himself and his bold idea of a sea-borne covenant. As a result, most covenants surrounding the northern seas have heard of him. His name carries influence either as an inspiration to magi with pretensions to forge their own path, or as a figure of scandal."
    }

    #t8a8a8310d945092e7fd0ce ^"Healthy Feature (The Northern Seas)" DEF {
        EXTENDS #tKtcGprx8MDfM8Bjj5kkfnZD ^"Healthy Feature"
        PROPERTIES {
            ^"Printed Name" STRING "Healthy Feature (Minor Site Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Site"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "The open seas and the clean air, free from corruption, are excellent for the humors. At the expense of weathering storms and wintering in safe harbors, the magi and covenfolk are generally fitter and healthier than their landlocked counterparts."
    }

    #t4890821776dbb13e320cf7 ^"Informants (The Northern Seas)" DEF {
        EXTENDS #t1YjWMwPZtiUAJ4FDbW5y8D7 ^"Informants"
        PROPERTIES {
            ^"Printed Name" STRING "Informants (Minor External Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "The misfits of the Northern Seas may be the black sheep of their former covenants, but they still have their contacts. Some of the younger magi grew up alongside others still learning their Arts who are eager for stories of the high seas. This means the covenant receives word of the interests of important magi and covenants, which may help the covenant in trade."
    }

    #t4749936d2f7c153cc6f008 ^"Local Ally (The Northern Seas)" DEF {
        EXTENDS #tg7RNqPOdy1pi56tw2sTAm78 ^"Local Ally"
        PROPERTIES {
            ^"Printed Name" STRING "Local Ally (Minor External Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "A prominent tax collector at Barfleur, nominally the covenant’s home port, is a strong ally to the covenant. He is a member of the town’s Jewish community and owes much to the covenant’s elder magi for help and protection they afforded him and his family some years ago. Further information is provided below."
    }

    #t79ad2b8d4a363b3fa769f6 ^"Ungoverned (The Northern Seas)" DEF {
        EXTENDS #tW9OoMZbOr2Mo0ZlzUAytHx0 ^"Ungoverned"
        PROPERTIES {
            ^"Printed Name" STRING "Ungoverned (Minor External Boon)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "External"
            ^"Kind" STRING "Boon"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "No ruler can truly lay claim to the seas, although the trade alliances and mercantile families probably try. As a result, the magi of the Northern Seas govern themselves and, ports and harbors aside, can afford to be a law unto themselves."
    }

    #t39c0c0435a7e4437658be1 ^"Missing Aura (The Northern Seas)" DEF {
        EXTENDS #t2pzbV5Oz7UnLItk1h1SnX01 ^"Missing Aura"
        PROPERTIES {
            ^"Printed Name" STRING "Missing Aura (Major Site Hook)"
            ^"Magnitude" STRING "Major"
            ^"Category" STRING "Site"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "A covenant at sea cannot expect to sail within a magical aura all year. There are auras out there, but they are small and widely distributed. As a result, the covenant has a base magical aura of zero."
    }

    #t0257f246ba01b1c5d0d79e ^"Tribunal Border (The Northern Seas)" DEF {
        EXTENDS #tazqu7Oa5oViAs1NbFiQyZLs ^"Tribunal Border"
        PROPERTIES {
            ^"Printed Name" STRING "Tribunal Border (Major External Hook)"
            ^"Magnitude" STRING "Major"
            ^"Category" STRING "External"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "While nominally in the Normandy Tribunal, the independent covenant of the Northern Seas sails the borderlands between multiple Tribunals. The covenant’s connection to Normandy is tenuous at best and its magi enjoy a freedom not often granted to others. As the covenant proves the sea’s worth, multiple Tribunals may try to tempt them into membership. However, when those approaches are rebuffed, proud Tribunals may decide to take action against the upstart covenant."
    }

    #t3fc3aab6abb177d120b233 ^"Erratically Mobile (The Northern Seas)" DEF {
        EXTENDS #t6H11FY2AzwNOcvopcEQYSoy ^"Erratically Mobile"
        PROPERTIES {
            ^"Printed Name" STRING "Erratically Mobile (Minor Site Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Site"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Not only do the ships of the Northern Seas sail where they will, but they may not always sail together. This means that finding the covenant and/or specific members can be difficult. The covenant does have allies on dry land, but their visits may not be regular."
    }

    #t14f350b182e62463dd3249 ^"Gender Imbalance (The Northern Seas)" DEF {
        EXTENDS #t6u2eYt1ZoD58ecJWNehDjfB ^"Gender Imbalance"
        PROPERTIES {
            ^"Printed Name" STRING "Gender Imbalance (Minor Residents Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Residents"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "Many sailors agree that a ship is no place for a woman. As a result, and despite the covenant playing home to a female captain, the ships’ crews are overwhelmingly male. Others may view the covenant as somewhat aggressive and there is little chance for family life within the covenant."
    }

    #ta33e7a9c2f2ea08160f287 ^"Possession Victim (The Northern Seas)" DEF {
        EXTENDS #t9o4xVDyMZhV2pHgL5M9Wlrf ^"Possession Victim"
        PROPERTIES {
            ^"Printed Name" STRING "Possession Victim (Minor Residents Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Residents"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "As the covenant lacks an Aegis, the ships rely on relics or on Hermetic spells to protect the ship and crew from the infernal. Despite this, there is an infernal presence on board one of the ships and the demon is playing the long game of influencing the crew and the magus to sin and damnation. One or more of the crew are possessed by a demon. Carles Magnus suspects that something infernal may be trying to influence his crew but does not know of the possession directly. See below for more details."
    }

    #ta9737b13dfbac14de47245 ^"Poverty (The Northern Seas)" DEF {
        EXTENDS #t5zTycnLMd14Nt4eLJ965o2y ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Poverty (Minor Resource Hook)"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Resource"
            ^"Kind" STRING "Hook"
            ^"Covenant" STRING "The Northern Seas"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 10
        }
        DESCRIPTION "The covenant is young, with few resources. It has the Minor variant of the Poverty Hook and starts with a single Lesser Income Source, providing 40 Mythic Pounds per year. The magi may need to resolve that early on as the covenant currently runs a deficit."
    }

}
