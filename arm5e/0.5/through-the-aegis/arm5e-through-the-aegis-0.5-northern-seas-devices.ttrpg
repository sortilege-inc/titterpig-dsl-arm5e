EXTENSION "ArM5_Through_the_Aegis_NorthernSeas_Devices" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #taf60189ab48bc5c7acd861 ^"Waves of Drowning and Smashing (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Waves of Drowning and Smashing"
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReAq 30 Pen +0, 1/day R: Sight, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As per the spell of the same name in ArM5, page 124."
    }

    #t193995e94f11cc3f7fe5b9 ^"(Effect: Base 10, +3 Sight, +1 size) Wizard’s Leap" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 18
            ^"Requisite" STRING "Animal, Herbam, Terram"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReCo (Animal, Herbam, Terram) 18 Pen +0, 6/day R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "The caster is instantly transported up to 50 paces in any direction, provided he can see his destination or has an Arcane Connection to it. His Talisman and any equipment associated with the forms of Animal, Herbam, and Terram comes with him. Otherwise, as per the description in *Houses of Hermes: Societates*, page 36."
    }

    #t2255f23f2b1992f06405e5 ^"(Effect: Base 15; Modifications: +3 for 6/day) The Wound that Weeps" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+24"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "PeCo 30 Pen +24, 6/day R: Voice, D Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As the spell described in ArM5, page 133. (Effect: Base 5, +2 Voice; Modifications: +3 for 6/day, +12 for +24 Penetration)"
    }

    #tbb452229cef113853b72cf ^"Rusted Decay of Ten Score Years" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman (Carles Magnus)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+24"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +1 Touch, +2 metal; Modifications: +3 for 6/day, +12 for +24 Penetration)"
            ^"Printed Effect Line" STRING "PeTe 20 Pen +24, 6/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "As the spell described in ArM5, page 155. This effect is triggered in combat, when it strikes an opponent’s metal weapon or armor. If the effect penetrates, it rusts the target through and weapons become little more than bludgeons and armor drops to the next protection value as per the table in ArM5, page 176."
    }

    #t7ecca22037d6cfa07c59a4 ^"Babel Rejoined" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+8"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch, +2 Sun, +3 Hearing; Modifications: +1 for 2/ day, +4 for +8 penetration)"
            ^"Printed Effect Line" STRING "InMe 40 Pen +8, 2/day R: Touch, D: Sun, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Those in the same structure as the long bone of Epiphanius understand the spoken words of all others within the structure regardless of the languages that any of them speak. To benefit, targets must at least nominally be members of either the western or eastern Churches. Jewish and Islamic characters do not benefit, neither do heretics, pagans, or those aligned with the Infernal.\n\nThe power is activated by invoking Saint Epiphanius in the presence of the bone, something widely-known by the crew."
    }

    #ta9d4e7a4106156a19001ad ^"Brooch of Lungs of the Fish" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun, +1 Part; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "MuAq 24 Pen +0, Constant Effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "This brooch affects the wearer as per the Lungs of the Fish spell described in ArM5, page 122. The effect is constantly active and so the user simply needs to wear it to benefit.\n\nThe covenant has only one of these at present but the Laboratory Text is available."
    }

    #t6c195ed7fe6a350f88ea67 ^"The Freshwater Barrel" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch) These devices together cost 16 Build Points."
            ^"Printed Effect Line" STRING "PeAq 20 Pen +0, 1/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "This barrel, when filled once per day from the sea, destroys the saltiness property of the seawater caught within it.\n\nBoth Carles and Hilde each have one of these devices and the Laboratory Text is available."
    }

    #t1bd0c8f2d4fe5b0a64b2e0 ^"This device costs 12 Build Points. Finding the Fleet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Master’s Chart"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 2, +4 Arcane Connection; Modifications: +4 for 12/day)"
            ^"Printed Effect Line" STRING "InHe 14 Pen +0, 12/day R: Arcane Connection: D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Provides information on the location of a target ship given an arcane connection to it."
    }

    #t9543048ef282cad6a6f075 ^"Mark the Fleet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Master’s Chart"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 11
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch; Modifications: +4 for 12/day, +3 triggered by Finding the Fleet)"
            ^"Printed Effect Line" STRING "ReHe 11 Pen +0, 12/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 29
        }
        DESCRIPTION "Moves the token placed upon the chart to the location indicated by the Finding the Fleet effect."
    }

    #t81c7883e85077a95bcabd3 ^"Bell of Summoning" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 1, +4 Arcane Connection, +1 Diameter; Modifications: +4 for 12/day, +16 for +32 penetration)"
            ^"Printed Effect Line" STRING "CrIm 30 Pen +0, 12/day R: Arcane Connection, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Commissioned from a Verditius working out of Verdi, when rung this bell sounds throughout all six ships of the fleet, using up six of its 12 uses. This allows the bell to be rung twice with effect.\n\nThe bell is housed on La Charytee to be rung when Carles gets to port ahead of a council meeting. The bell is usually rung twice in succession, once to alert the magi and again to give them chance to locate the direction of the magic using their Magical Astrolabes, described below."
    }

    #t8dd9a35ffff11de533b2aa ^"The Magical Astrolabe" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, +3 for increased information; Modifications +10 unlimited use)"
            ^"Printed Effect Line" STRING "InVi 40 Pen +0, Unlimited R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "When used against an active magical effect, the astrolabe allows the user to determine the horizontal and vertical directions of the magic’s origins. It cannot provide distance information.\n\nThe device is used to locate the source of the sound of the Bell of Summoning. When used in conjunction with charts, this provides a confident view on where the bell is.\n\nEach ship in the fleet is issued with one of these devices."
    }

    #tf1c09604afa716ed943ba7 ^"The Unbidden Horrors" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Summer Fog"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun; Modifications: +5 for +10 Penetration)"
            ^"Printed Effect Line" STRING "CrMe 20 Pen +10, 1/day R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "Individuals touched by the fog feel unease, rising to dread, through suspicion and fear, and into the horror of their deepest nightmares. The effect lasts through the night, and the screams of those unlucky cursed few can be heard throughout the village of Sønder Vorupør.\n\nThe memories of the experience live longer than the effects of the magic itself."
    }

    #t9427e00e23f6858557d4d7 ^"The Animated Corpse" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Alfgeir’s Bones"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 10, +2 Sun; Modifications:"
            ^"Printed Effect Line" STRING "ReCo 24 Pen +0, Constant Effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "A season spent taming Alfgeir’s skeletal form, which can be achieved as a five-day distraction, imparts a Dexterity equal to the controller’s Intelligence and a Single Weapon Ability equal to the controller’s Finesse as the controller impresses their will upon the corpse. All other characteristics and Ability scores are considered to be zero and/or normal for a typical human."
    }

    #t695e72b3c3d31583b5865a ^"The Agile Shield" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Oyster King’s Shell"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Sun, +1 stone; Modifications: +1 for 2/day, +3 triggered at sunrise/set)"
            ^"Printed Effect Line" STRING "MuTe 14 Pen +0, Constant Effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This effect transforms the stone of the giant oyster shell so that it is as hard as the finest steel but as light as beaten tin."
    }

}
