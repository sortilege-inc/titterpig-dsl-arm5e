                ^"Characteristics (Outer Heartbeast)" STRING "Int +1, Per –2, Pre –3/+3, Com –6, Str +7, Sta 0, Dex +2, Qik +1"
                ^"Characteristics (Inner Heartbeast)" STRING "Int +1, Per –2, Pre –3/+3, Com –6, Str +10, Sta 0, Dex +2, Qik +1"
                ^"Size" STRING "+3"
