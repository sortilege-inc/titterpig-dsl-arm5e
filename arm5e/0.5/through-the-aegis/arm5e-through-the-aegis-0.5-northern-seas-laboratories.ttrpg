EXTENSION "ArM5_Through_the_Aegis_NorthernSeas_Laboratories" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas laboratories"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's laboratories, structured; each DESCRIPTION the source's text, verbatim.

    #t471ab77a658fd6fbdf8466 ^"Laboratories (The Northern Seas)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER -1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER -1
            ^"Names Added to Sanctum Marker" STRING "As per individual magus"
            ^"Characteristics" STRING "Size +0 (0), Refinement +0, General Quality –1, Upkeep +0, Safety –1, Warping +0, Health +0, Aesthetics –1"
            ^"Virtues & Flaws" STRING "Mobile, Extensive Stores; Cramped, Unstable"
            ^"Specializations" STRING "Experimentation +2 Each of these laboratories costs 10 Build Points."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 25
        }
    }

    #t2c7e8ade672a62b1c9d5f5 ^"Carles’ Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 2
            ^"General Quality" INTEGER 1
            ^"Upkeep" INTEGER 3
            ^"Safety" INTEGER 1
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 2
            ^"Names Added to Sanctum Marker" STRING "Hilde Oddfish, Columba of Ex Miscellanea, Matilda Page, Tibor Milos, Andrew of Jerbiton"
            ^"Characteristics" STRING "Size +0 (0), Refinement +2, General Quality +1, Upkeep +3, Safety +1, Warping +0, Health +0, Aesthetics +2"
            ^"Virtues & Flaws" STRING "Extensive Stores, Lesser Feature (Map), Specimens, Guard, Highly Organized, Mobile, Precious Ingredients; Cramped, Unstable"
            ^"Specializations" STRING "Experimentation +2, +1 Longevity Rituals; +1 Intellego; +1 Animal"
            ^"Features" STRING "Map"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Carles’ laboratory is dominated by the carved and painted map of the oceans and the skies that covers the chamber’s floor and ceiling. It is very tidy; important given that the working spaces are a little cramped in order to expose as much of the great map as possible.\n\nWhile the sanctum marker bears the names of each covenant member, Carles ensures that his laboratory is guarded at all times and that the guard knows not to admit anyone unless explicitly told by Carles or Hilde.\n\nThese enhancements cost 30 Build Points."
    }

    #ta2ce2a3915e101f4227634 ^"Hilde’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 1
            ^"General Quality" INTEGER -1
            ^"Upkeep" INTEGER 1
            ^"Safety" INTEGER 0
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 1
            ^"Names Added to Sanctum Marker" STRING "Carles Magnus"
            ^"Characteristics" STRING "Size +0 (0), Refinement +1, General Quality –1, Upkeep +1, Safety +0, Warping +0, Health +0, Aesthetics +1"
            ^"Virtues & Flaws" STRING "Mobile, Highly Organized, Lesser Feature (Running Water), Extensive Stores, Specimens; Cramped, Lesser Focus (Running Water), Unstable"
            ^"Specializations" STRING "Experimentation +2; Animal +1, Aquam +3"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Hilde’s laboratory is constantly damp as the Marie de Bayonne has been modified so that the hull remains sound despite the opening from Hilde’s laboratory to the sea. This opening allows Hilde to leave her laboratory directly into the sea in her shark heartbeast, but the water does slosh into the lab during choppy seas, despite an enchantment that keeps the ocean at bay. The ceiling is strung with fish in various states of decomposition, seaweed, and driftwood.\n\nThese enhancements cost 30 Build Points."
    }

}
