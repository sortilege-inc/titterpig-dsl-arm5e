    #tb1b3f942a36cf0a3b618cb ^"The Technique of Precision (The Northern Seas Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Technique of Precision"
            ^"Author" STRING "Culbard of Bonisagus"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 14
            ^"Build Points" INTEGER 14
            ^"Section" STRING "Arcane Abilities"
            ^"Printed Entry" STRING "Culbard of Bonisagus, The Technique of Precision, Finesse Tractatus, Quality 14, This is one of two volumes by the magus Culbard, renowned for his works on Hermetic practices other than simply the Arts. The partner volume, The Form of Precision, is a much sought-after work. (14BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
    }

    #tcfc88100323f7923513f1a ^"The Hermetic Zodiac (The Northern Seas Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Hermetic Zodiac"
            ^"Author" STRING "Niall ex Miscellanea"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 11
            ^"Build Points" INTEGER 11
            ^"Section" STRING "Arcane Abilities"
            ^"Printed Entry" STRING "Niall ex Miscellanea, The Hermetic Zodiac, Magic Theory Tractatus, Quality 11, Written in the Hibernian style, this tractatus on Magic Theory presents tables and charts for various daily, monthly, seasonal, and yearly celestial phenomenon and how they relate to the casting of magic. The vellum pages are particularly fine and clear. (11BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
    }

    #t4475288633401e8144cfbe ^"Methods for the Application of Magic Theory in Enchantment (The Northern Seas Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Methods for the Application of Magic Theory in Enchantment"
            ^"Author" STRING "Bachalo of Verditius"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 10
            ^"Build Points" INTEGER 10
            ^"Section" STRING "Arcane Abilities"
            ^"Printed Entry" STRING "Bachalo of Verditius, Methods for the Application of Magic Theory in Enchantment, Magic Theory Tractatus, Quality 10, Examples of needlessly elaborate enchanted devices demonstrating the core tenets of Magic Theory. (10BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
    }

    #t094fe1cce608301a042b5b ^"The Examples of the Victors (The Northern Seas Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Examples of the Victors"
            ^"Author" STRING "Grawbadger of Tytalus"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 8
            ^"Build Points" INTEGER 8
            ^"Section" STRING "Arcane Abilities"
            ^"Printed Entry" STRING "Grawbadger of Tytalus, The Examples of the Victors, Penetration Tractatus, Quality 8, Little more than a series of tales of the Schism War, but they are used to illustrate feats of Penetration. Several important pages have been removed. (8BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
    }

