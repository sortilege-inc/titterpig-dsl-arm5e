            ^"Printed Entry" STRING "August Jens-Rasmus of Guernicus, Foundations, Code of Hermes Tractatus, Quality 8, A dry work, but clearly laid out with concise discussion on the core foundations of the Code. (8BP)"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 30
        }
    }

    #t8b000f088398f3617152c3 ^"The Authority Granted to the Tribunal by its Members (The Northern Seas Library)" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
