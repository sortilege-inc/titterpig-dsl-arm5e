EXTENSION "ArM5_Through_the_Aegis_NorthernSeas_Silence" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Silence"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # Silence (Chapter Two: The Northern Seas, p21): one character, its stat lines verbatim fields.

    #t374226843dcc134bb4ee45 ^"Silence" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Grog"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int 0, Per +1, Pre –2, Com –2, Str 0, Sta 0, Dex +5, Qik +3"
            ^"Size" STRING "0"
            ^"Age" STRING "26 (26)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Covenfolk; Great Dexterity × 2; Covenant Upbringing, Master of None From the Grogs supplement"
            ^"Personality Traits" STRING "Brave +3, Disciplined +2, Self-Interest +1, Honorable –1"
            ^"Combat" STRING "Dodge: Init +2, Attack n/a, Defense +6, Damage n/a Fist: Init +2, Attack +8, Defense +6, Damage +0 Kick: Init +1, Attack +8, Defense +5, Damage +3 Dagger: Init +2, Attack +11, Defense +7, Damage +3 Throwing Knife: Init +2, Attack +10, Defense +7, Damage +2"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Athletics 4 (acrobatics), Awareness 3 (search), Brawl 3 (dagger), Organization Lore: Covenant of the Northern Seas 1 (people), Disguise 2 (peasants), English 3 (slang), Folk Ken 2 (grogs), Latin 2 (overheard speech), Legerdemain 4 (pilfering), French 5 (Norman), Stealth 5 (urban areas), Swim 2 (stay afloat), Thrown Weapon 3 (throwing knife)"
            ^"Equipment" STRING "Dark clothes and short traveling cloak; Pack; Rope; Quilted Armor; Dagger; Throwing knives"
            ^"Encumbrance" STRING "1 (1)"
            ^"Appearance" STRING "Fit and wiry."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "A thief and a rogue, Silence is more used to subtlety and stealth than open brawling. He is often employed on tasks where his skills of stealth and legerdemain come in useful.\n\nHe can often be seen, on his own, practicing his athletic and climbing prowess, sprinting, and throwing knives at targets.\n\nSilence prefers to use his throwing knives in combat. If these don’t slow his opponent enough, he is always mindful of finding an exit and coming back more prepared. He works well with Fang, with the brawler grappling an opponent to the ground and then Silence coming in with a well-placed dagger."
    }

}
