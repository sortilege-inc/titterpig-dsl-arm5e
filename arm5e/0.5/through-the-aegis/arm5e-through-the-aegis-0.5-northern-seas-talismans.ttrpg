EXTENSION "ArM5_Through_the_Aegis_NorthernSeas_Talismans" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Through_the_Aegis_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t5701819327a7ce6cef7263 ^"Talisman (Carles Magnus)" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman"
            ^"Owner" STRING "Carles Magnus"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 12
        }
        TABLE {
            "+7" "harm or repel faeries" "Iron" "Attunements"
            "+4" "harm human and animal bodies" "Sword" "Attunements"
            "+4" "leadership" "Topaz" "Attunements"
            "+4" "strength, courage, pride" "Topaz" "Attunements"
        }
        DESCRIPTION "Carles’ talisman is a *kilij*, a single–edged sword with curved iron blade. It is of Turkish origin and is adorned with Islamic designs with a golden hilt containing an embedded topaz. The talisman has been opened for enchantment with 14 pawns of vis and contains the following effects:"
    }

}
