EXTENSION "ArM5_Transforming_Mythic_Europe_IslandOfTheMagicians_Spells" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Three: The Island of the Magicians spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t41d70d77ba3bf1143bfb25 ^"Creation of the Walls of Simple Cottages" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual, Ritual."
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "This spell creates a series of identical stone enclosures each suitable, once roofed, shuttered, and portaled, for housing a family. Assuming each cottage is internally 30 feet long, 15 feet wide, and has walls that average 6 feet high and 1 foot thick, each requires 540 cubic feet of stone. That is 20 cubic paces of stone (although that makes no allowance for doorways or windows).\n\nHermetic magic requires that spells of permanent creation be rituals, and that all rituals be 4th magnitude. This spell requires a magnitude for doing complex things, because it creates multiple objects in a precise series. This means that it’s as simple to create one cottage in this manner as to create the maximum possible, which given the amount of stone produced is 5. Every magnitude added to the spell multiplies the number of cottages produced by ten.\n\n(Base 3, +1 Touch, +2 size, +1 complexity. For this spell to be created, thin connecting pieces of stone must run between the houses, to allow the Individual target. A Group Target would add 2 magnitudes.)"
    }

    #te21edea5d2dd89febca6ac ^"Creation of a Legion of Appointed Cottages" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 30 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "This spell creates a series of identical houses, each fitted with a stone roof two inches thick, a stone floor a foot thick, and stone doors and shutters each an inch thick. The moving parts are on stone pivot points. Each house has stone plumbing for water and sewage. Each cottage requires 110 cubic paces of stone, allowing the construction of 9 cottages.\n\nEvery additional magnitude multiplies the number of cottages by 10.\n\nAn additional magnitude allows the characters to create a mass of non-identical cottages.\n\n(Base 3, +1 Touch, +4 size, +2 complexity. These cottages must be linked by thin pieces of connecting stone, to allow the Individual Target.)"
    }

    #t55779f57d58aea01d20088 ^"Creation of a Well-Appointed Town" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 30 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "This spell creates the well-appointed cottages described in an earlier spell, the road between them, and the sewage and water pipes which are contained within the road. At this level, the spell creates 8 cottages. Every additional magnitude multiplies the number of cottages by 10.\n\nAn added magnitude allows the magus to create a series of cottages which are non-identical, creating a town less regimented in appearance.\n\n(Base 3, +1 Touch, +4 size, +2 complexity)"
    }

    #t1764768b121663613e67df ^"A System of Narrow Canals" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "In this spell, it is assumed that the canal is stone-lined, 2 paces deep and 5 paces wide. It has straight sides, and has no locks. The wall of the canal is half a pace thick.\n\nDue to the Hermetic restriction which makes all rituals level 20 spells, there’s no advantage to a magus who chooses to create canal network of less than maximum length, which is 1.26 miles. (Base 3, +1 Touch, + 4 size)\n\nSlightly more powerful spells can create far larger canal systems. A level 25 spell creates 12.62 miles of canals, a level 20 spell creates 126.26 miles of canals, and so on.\n\nNote that this spell can also be used to create irrigation ditches and roadside drains.\n\nPlayers who have chosen clay fill for their island must make their own calculations, as a clay bottom is waterproof and does not need to be lined with stone. Player who have chosen stone fill for their island can reclaim some of their material by including canals."
    }

    #t491c3a6d613010d180a127 ^"Canals that Accommodate Seagoing Vessels" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 61
        }
        DESCRIPTION "The average seagoing vessel in the northern waters of Mythic Europe carries 20 tons of cargo. It has a draft of about 2 paces, although larger and heavily laden vessels may have a draft of just over 3 paces. It is about 6 paces wide, although far larger ships are known. A canal which could accept such a vessel, (14 paces wide to allow vessels to pass each other, 4 paces deep and half a pace thick), created by this spell, can be up to 909 paces long.\n\nAn added magnitude creates a canal just over 5 miles long, two added magnitudes creates a channel 51 miles long, and so on.\n\nThis spell can also be used to create stone lined riverbeds.\n\n(Base 3, +1 Touch, + 4 size)"
    }

    #tcfe6c68b5f87c41d7ef66a ^"The Creation of a Forest" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrHe 40 R: Touch D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "This spell creates a thousand mature trees (Size +2). Each added magnitude multiples this number of trees by 10.\n\nAn added magnitude allows the magus to precisely mix the varieties of plant he creates.\n\n(Base 1, +1 Touch, +2 big initial individual, +2 Group, +3 size)"
    }

    #t950b9183671bb225b6e19f ^"The Creation of Acorns Aplenty" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrHe 20 R: Touch D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "This spell creates a vast pile of acorns, totaling 1 000 cubic paces in volume. An added magnitude (or reduction of the volume to one tenth) allows the maga to precisely mix the varieties of seeds she creates. The maga may use other Creo spells – not rituals this time – to mature each tree, or can use a vast ritual to mature every plant within the Boundary the wall creates.\n\n(Base 1, +1 Touch, +2 Group. +3 size)"
    }

    #t5f4decbe81fad85326689e ^"The Creation of Verdant Grassland" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrHe 10 R: Touch D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "This spell covers just under 1.25 acres of land with thick grass about a pace high. Wheat is, of course, a grass. Characters making an island 3 miles across have just over 6000 acres of land. Player characters adding 4 magnitudes to this spell can cover just over 12,000 acres of land.\n\n(Base 1, +1 Touch. +2 Group, +1 size)"
    }

    #t92dd2636b59b70ec7b3a0c ^"A Pile of Rotting Beef" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrAn 35 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 62
        }
        DESCRIPTION "Bees, which are vital for the production of most crops, are generated by the decay of the corpses of cows. Player characters who create too many bees before they have flowers must watch them starve, but players who have flowers, and no bees, must watch them wither. Fortunately, things generated by magically created animals persist even if the spell’s duration ends. Clever magi can simply strew their island with dead cows, using Sun duration spells like this one, and the bees which arise from these corpses are natural.\n\nThis spell creates ten cow carcasses. Magi wanting to absolutely ensure they have bees can add a Perdo requisite, to make the corpses rot as they wish. Alternatively they can use spells like *Growth of Creeping Things*, bees being one of the insects created when destroying beef.\n\n(Base 10, +1 Touch +2 Sun +2 Group)"
    }

    #t5edb3d386d3ff8c586349a ^"Weather Made Good" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuAq 40, Ritual R: Touch, D: Moon, T: Boundary"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 71
        }
        DESCRIPTION "This spell prevents rain falling on the island for a month. It may prove particularly useful when first settling the island, as it allows peasants and supplies to lie unprotected without suffering damage.  remember to add further magnitudes to increase Boundary size. (Base 4, +1 Touch, +3 Moon, +4 Bound)"
    }

    #t3dc356d54ed1737e6f366e ^"The Command of Every Beast" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc."
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReAn 20, Ritual R: Touch, D: Conc., T: Boundary"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "This spell allows the magus to give a command to every beast on the island. Commands for large groups of animals can be no longer than a sentence, because there are simply too many minds to control.\n\nA level 25 version has** D:** Sun. * Remember to add further magnitudes to increase Boundary size. (Base 2, +1 Touch, +1 Conc, +4 Bound)"
    }

    #t2bdfcdcdab0b453cfd6562 ^"The Eyes of Every Beast" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc."
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "InAn 40, Ritual R: Touch, D: Conc., T: Boundary"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "This spell allows the magus to sense what the animals of the island are seeing. A magus who is not looking for a particular thing can simply ramble through the impressions of nearby animals. A magus seeking a particular thing in these perceptions must make a Perception + Awareness roll vs. an Ease Factor of 12 to fi nd what he seeks.\n\nA level 45 version lasts a day. * Remember to add further magnitudes to increase Boundary size. (Base 10, +1 Touch, +1 Conc, +4 Bound.)"
    }

    #tbccb415bf17ec775d04920 ^"Fumigant of Minor Demons" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "PeVi General, Ritual R: Touch, D: Mom, T: Boundary."
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "A variant of Demon’s Eternal Oblivion (ArM5, page 160) designed to destroy all of the minor infernal spirits on the island. The demons affected have a Might equal to the spell’s level –25, lower if the Boundary is larger.  Remember to add further magnitudes to increase Boundary size. (Base effect (Gen), +1 Touch, +4 Bound)"
    }

    #t7c4d8cffb382876f8e7672 ^"The Lost City" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Requisite" STRING "Rego"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "PeIm 45, Ritual R: Touch, D: Sun, T: Boundary, Req: Rego"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Makes the wall, and everything within it, invisible, no matter what the residents of the island do. The residents can see the contents of the island, so long as they do not step outside the Boundary. Enemies who still reach the walls are able to see the contents of the island normally once the Boundary has been crossed. * Remember to add further magnitudes to increase Boundary size. (Base 4, +1 Touch, +2 Sun, +4 Bound, +1 requisite, +1 changing image)"
    }

    #tb97a573297a8a13a044e26 ^"Murderous Woodland" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 55
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReHe 55, Ritual R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Wakens and mobilizes every tree on the island, forcing them to follow simple commands. The trees can walk at human pace, and fight using their branches.  Remember to add further magnitudes to increase Boundary size. (Base 10, +1 Touch, +2 Sun, +4 Bound, +2 size of plants)"
    }

    #t82a5fb6ecd2ce35fdb5984 ^"Remembered Messages" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuMe 20, Ritual R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "To use this spell successfully requires a little preparation, because\n\neach target needs to be prepared with a memory that can be altered with little trouble. For example, at sporting or cultural events, everyone may be asked to repeat the recipe for sea urchin soup, or memorize a string of flags.\n\nWhen this spell is required, the memory of the recipe is replaced with a single useful piece of information, or the flags are replaced with a single useful image. For example, an evacuation plan can be distributed in this way, or a series of mustering points for militias. * Remember to add further magnitudes to increase Boundary size. (Base 1, +1 Touch, +2 Sun, +4 Bound)"
    }

    #t4940b9a2b951e4e559a02b ^"Speech of the Warding Ring" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InTe 35 R: Touch, D: Sun, T: Ind."
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Stone Tell of the Mind that Sits (ArM5, page 153), the most popular Hermetic spell for interrogating rocks, does not work on the stone jacket of the island solely because the spell’s target is limited to a square pace cubic in size. Characters using this spell can speak with far larger stones.\n\n(Base 20, +1 Touch, +2 Sun. This spell uses the wall, but a mind is an Individual target.)"
    }

    #tb9ee492c21e12903074dcd ^"Strange Tricks Using Canal Contents" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuAq 25 R: Touch, D: Sun, T: Boundary, Ritual."
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "This spell transforms the water in the canals of the island into another natural liquid. Oil, tar, turpentine, treacle, honey, wine, vinegar or whatever else suits the magus’ fancy is possible, save blood which requires a Corpus requisite. * Remember to add further magnitudes to increase Boundary size. (Base 2, +1 Touch, +2 Sun, +4 Bound)"
    }

    #td8d58a898dbc8e36721896 ^"A Spell for the Defense of the Realm Against Expected Invasion" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuCo 50 R: Touch, D: Sun, T: Boundary, Ritual."
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 73
        }
        DESCRIPTION "Adds +3 to the Soak score of all humans on the island, for the rest of the day or night. The spell makes the flesh of the targets tough and insensitive, so they suffer a –1 penalty on all dice rolls requiring sensitive touch. * Remember to add further magnitudes to increase Boundary size. (Base 15, +1 Touch, +2 Sun, +4 Bound)"
    }

    #t2c344cee3b37999226c315 ^"Steering A Vast Stone Dish" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReTe 40 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This spell allows the player characters to direct the voyage of a small floating island whose wall has been created with a level 30 spell. The island travels at the speed of a running horse, which is about 50 land miles per hour. An island with a wall created using a level 35 spell requires a level 45 spell to steer, and one created by a level 40 spell requires one of level 50. Larger islands, if steered by a single spell, can only be maneuvered with rituals.\n\nThis spell does demonstrate the difficulty of steering with simple spells, however: a Ring 800 paces across requires over 250 concentration rolls to draw. Wise player characters would, instead, invest this spell in an invested device that maintained Concentration for them.\n\n(Base 2, +1 Touch, +2 Ring, +1 Circle, +6 Size)"
    }

    #tb36ed58ce033dbfd32ab33 ^"Permanent Wall of Protecting Stone" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "Creates a wall 25 paces long, 4 paces high, and 1 pace thick, which is a total of 100 cubic paces of stone. Vis is used to prevent the wall disappearing after the spell ends. Walls made in this way are made of single pieces of unmortared stone, which gives them far greater durability than conventional walls, unless the caster has a sigil that degrades their composition.\n\n(As **ArM5** page 153, modified for permanent creation of walls. The level rises from 10 to 20 because all Rituals have a minimum level of 20 as per **ArM5**, page 114 , so magi could increase the Range or Size without cost. (Base 3, +1 Touch, +2 size))"
    }

    #t38abeb25d7a38cd262103c ^"Efficient & Permanent Wall of Protecting Stone" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "Creates a wall from a single piece of unmortared stone, which gives it far greater durability than conventional walls, unless the caster has a sigil which degrades its composition. Vis is used to prevent the wall disappearing after the spell ends.\n\nDue to the quirk of Hermetic magic that makes all Rituals fourth magnitude spells or greater, there’s no advantage to a magus who casts a spell to create a permanent, unornamented, wall of stone smaller than 10,000 cubic paces in volume. That creates a wall 167 paces long, 30 paces high and 2 paces thick.\n\n(Base 3, +1 Touch, + 4 size)"
    }

    #tf305b28e429305d6486262 ^"An Expansive & Permanent Wall of Protecting Stone" DEF {
        EXTENDS #t1Chugsx6nUdFUJJvS7FueYL ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 30 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "As Permanent Wall of Protecting Stone, earlier, but with four additional magnitudes spent on size. This creates one million cubic paces of stone, which is sufficient for a wall 30 paces high, 2 paces thick, and just under 9.5 miles in length.\n\n(Base 3, +1 Touch, + 6 size)"
    }

