EXTENSION "ArM5_Transforming_Mythic_Europe_MagicAsTechnology_Devices" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Four: Magic as Technology devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tce302e112223932c4a788b ^"Twinning the Quill" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Quills of Arcane Correspondence"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +4 Arc, +1 Conc, +1 precise control; +4 12/day)"
            ^"Printed Effect Line" STRING "ReAn 19 Pen 0, 12/day R: Arc, D: Conc, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "When the effect is triggered, any movements of the enchanted quill are exactly mirrored by the other, which is usually left atop a sheet of parchment with an open inkwell in a precisely defined position. Errors must be crossed out rather than scraped from the parchment in the usual fashion. A concentration roll is required every few sentences. Arrangements are usually made to change the parchment and refill the inkwell."
    }

    #t1b04628a32126c8fb5f897 ^"The Writing on the Wall" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Unsubtle Knife"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 22
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +4 Arc, +2 Sun, +1 clear letters; +2 3/day)"
            ^"Printed Effect Line" STRING "CrIm 22 Pen 0, 3/day R: Arc, D: Sun, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The effect is triggered by writing a message with the tip of the knife on a suitable flat surface; in the past Atrox has employed ink on a parchment, carved his message on a tavern table, and cut an order into the flesh of a defeated enemy. The knife must be in contact with an Arcane Connection to a location during the writing. The message appears at that location, and persists until the sun next rises or sets. Because of Atrox’s sigil, the message appears to be written in blood."
    }

    #t48d4b33e30748e0234a6ee ^"A Signal of Intent" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Earring of Whispering Voices"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +4 Arc, +3 6/day)"
            ^"Printed Effect Line" STRING "CrIm 8 Pen 0, 6/day R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This effect creates a brief sound at the location designated by the Arcane Connection. The exact form of the sound is between the inventor of the device and his sigil, but a bell’s note is usual. This effect does not need to Penetrate the Magic Resistance of the target; the sound may be heard by anyone in his vicinity.\n\nThis effect is used to signify to the recipient that the device’s owner has used (or is about to use) *The Ear for a Distant Voice*. If made as a paired device to allow two-way conversation, it is usual for the recipient to trigger the same effect in his own device to indicate his own ability to hear the words of the listener; otherwise the first user cannot be sure his words are being received."
    }

    #t3c185e8ae5b1a18009c4ed ^"The Ear for a Distant Voice" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Earring of Whispering Voices"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 12
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +4 Arc, +1 Conc; +2 3/day)"
            ^"Printed Effect Line" STRING "InIm 12 Pen 0, 3/day R: Arc, D: Conc, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The user of the device can hear the voice of the person to whom she has an Arcane Connection. She cannot hear anything else from the vicinity of the target other than his voice. The effect is triggered by touching the earring with the forefinger while holding an Arcane Connection to a person or place in the same hand."
    }

    #tc6a18c667d61997e8f90e8 ^"Summoning the Image of the Distant" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Hermetic Speculum"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 17
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +4 Arc, +1 Conc; +2 3/day)"
            ^"Printed Effect Line" STRING "InIm 17 Pen 0, 3/day R: Arc, D: Conc, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The wielder of the device can see and hear the individual to whom she has an Arcane Connection, provided he has no Magic Resistance. The images are divorced from any surroundings or other beings in the vicinity.\n\nThe effect is normally triggered by rubbing the item with the thumb or palm while holding an Arcane Connection to the person to be viewed. The images appear in the mirror-like flaws in the crystal."
    }

    #t1ba73d3e0e080dafdf0b71 ^"The Scrier Spied" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Hermetic Speculum"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 29
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Smell"
            ^"Effect Design" STRING "(Base effect, +1 to increase Duration from Conc to Sun, +1 to increase Target to Smell; +1 2/day; +3 environmental trigger)"
            ^"Printed Effect Line" STRING "InVi 29 Pen 0, constant effect R: Per, D: Sun, T: Smell"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "This spell operates like The Invisible Eye Revealed (ArM5, page 157): the Speculum responds whenever a spell of 30th level or lower is used to spy on whoever is carrying it. Note that this spell can detect the presence of scrying spells that have failed to Penetrate its bearer’s Magic Resistance because it can “smell” such spells within a three pace radius of its location. A detected scrying spell is signaled by a soft golden light filling the crystal; this is a cosmetic effect indicating that the power has been triggered."
    }

    #t70aaee300b935acc8d8cc8 ^"The Wandering Eidolon" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Effigy of the Errant Image"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 40
            ^"Requisite" STRING "Intellego"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +1 Conc, +1 additional sense, +1 requisite; +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "Re(In)Im 40 Pen 0, 1/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "This effect causes the user’s image to disappear from its current location and appear in a location designated by an Arcane Connection placed in the hands of the statue when triggering the effect.\n\nThe wielder can speak at the designated location and hear any responses, and he can also see everything he could if he were actually there. He cannot move his image from the immediate vicinity of the Arcane Connection, although he has some limited movement — he can pace up and down, for example. While his image is dislocated, he is invisible and inaudible at his true location. The displaced image is his image; if he sits then the image sits, if he is wounded then the image appears to bleed.\n\nNote that the image cannot enter an area protected by an *Aegis of the Hearth* unless the device was made within that covenant or made by a caster who was included in the ritual’s effects. If designed with sufficient Penetration, this effect could potentially overcome this limit."
    }

    #ta588829c95660eb89d7894 ^"The First Furrow Guides the Second (page 102)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "The First Furrow Guides the Second"
            ^"Part Of" STRING "Example Device: The Superb Scrinium"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 22
            ^"Requisite" STRING "Intellego"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +1 Conc, +2 Group, +1 changes as pages turn, +1 requisite; +5 item maintains concentration; +2 3/day)"
            ^"Printed Effect Line" STRING "Cr(In)Im 22 Pen 0, 3 uses per day R: Touch, D: Conc, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This enchantment has the same operation as the spell of the same name, described earlier, except with respect to Range and Duration. Each casting is sufficient for an entire text, since the created illusion affects a moving image. It is triggered when an open book is placed on the left-hand marble slab; an additional command word could be included if desired. To use the item correctly, the back cover of the book should be opened (else the book will be copied and bound in reverse)."
    }

    #t57a8cc1273421512a347aa ^"The Lector’s Deft Hand" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Superb Scrinium"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 requisite; +10 unlimited uses per day)"
            ^"Printed Effect Line" STRING "ReHe(An) 15 Pen 0, unlimited uses per day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This enchantment turns a page of any book placed on the left-hand marble slab. It can turn pages of paper, papyrus, and other plant-based materials as well as parchment and vellum. It is triggered when a sheet of parchment is placed on the right-hand slab (that is, after the Stack the Decorated Page effect has acted)."
    }

    #te6d79cfc56b3ec18118364 ^"The Copyist’s Puissant Quill (page 102)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "The Copyist’s Puissant Quill"
            ^"Part Of" STRING "Example Device: The Superb Scrinium"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 1, +2 Voice, +2 Group; +10 unlimited uses per day)"
            ^"Printed Effect Line" STRING "ReAq 15 Pen 0, unlimited uses per day R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This enchantment has the same operation as the spell of the same name, described earlier, and acts on the topmost sheet of the middle stack of blank pages. It is triggered when a page of the book on the left-hand marble slab is turned (that is, after the Lector’s Deft Hand effect has acted)."
    }

    #t550a09f9c3cbeefea6c4b3 ^"Stack the Decorated Page" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Superb Scrinium"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +2 Voice, +1 requisite; +10 unlimited uses per day)"
            ^"Printed Effect Line" STRING "ReHe(An) 20 Pen 0, unlimited uses per day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "This enchantment moves a sheet of parchment, paper, or other animal or plant-derived writing medium from the stack on the middle marble slab and places it on the right-hand slab. Note that the pages produced by the Scrinium are totally dry; there is no wet ink. It is triggered when the topmost sheet on the middle stack has been written on (that is, after the Copyist’s Puissant Quill effect has acted)."
    }

    #t640a534b72db3da4b2f3a5 ^"Binding the Mundane Codex (Transforming Mythic Europe)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Binding the Mundane Codex"
            ^"Part Of" STRING "Example Device: The Superb Scrinium"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 22
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 Group, +1 requisite, +1 size; +2 3/day)"
            ^"Printed Effect Line" STRING "ReHe(An) 22 Pen 0, 3 uses per day R: Touch, D: Mom, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "This enchantment binds up to 800 individual sheets into a book (a base Individual of Animal is equivalent to a quarternion). The enchantment fails if any of the materials necessary pieces of a codex are missing. It is triggered by tapping three times the stack of fi nished sheets to be bound. The operator of the device must have an Intelligence + Finesse of at least 6 to successfully bind the book. If you are using the extended rules for book creation (Covenants, page 88), then readers of a book bound with this enchantment can claim the +1 quality bonus for sound binding."
    }

    #tf0247b1a36ba582f8a4201 ^"The Longest Step Made Short" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Gate of Countless Vistas"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 35, +1 Touch)"
            ^"Printed Effect Line" STRING "ReCo 40 Pen 0, 1/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "Transports one person, his clothes, and his equipment to a location designated by the Arcane Connection placed in the Gate’s niche. Each time this effect is added to the enchantment, it is keyed to a different trigger word. Each user is given his own password, to be uttered as he steps over the threshold of the arch."
    }

    #t75647a0ad6443784c5a0ba ^"Acquire the Connection" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Phylactery of the Cautious Maga"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 4, +2 Voice, +1 Part)"
            ^"Printed Effect Line" STRING "ReTe 15 Pen 0, 1/day R: Voice, D: Mom, T: Part"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Upon uttering a command word, this effect transports a pinch of dirt, a cobblestone, or a chip of flagstone (as specified by the creator of the device) from the floor around the magus into the empty bottom compartment of the Phylactery."
    }

    #t5f19d0fe62e2430c3ff4a0 ^"Flee to Safe Refuge" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Phylactery of the Cautious Maga"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 35, +1 Touch; +3 linked trigger, +1 2 uses per day)"
            ^"Printed Effect Line" STRING "ReCo 44 Pen 0, 2/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This effect transports the wearer to the place designated by the Arcane Connection in the top compartment of the Phylactery. Note that unless this effect is designed with a Penetration bonus, the wearer must suppress her Parma Magica (ArM5, page\n\n85) for it to affect her; this requires a Stamina + Concentration roll, vs. an Ease Factor determined by the maga’s current situation (**ArM5**, page 82).\n\nThe effect is triggered by activating the Acquire the Connection effect; it can also be triggered separately by a command word. The reason for the linked trigger is to minimize the actions required by the fleeing maga: it takes just one command to activate both effects; and if a maga is sorely injured or in imminent danger, one action may be all she gets."
    }

    #t6832d485947a3872663cbd ^"Summoning the Distant Image (Transforming Mythic Europe)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Summoning the Distant Image"
            ^"Part Of" STRING "Example Device: Phylactery of the Cautious Maga"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 2, +4 Arc, +1 Conc, +2 Room)"
            ^"Printed Effect Line" STRING "InIm 25 Pen 0, 1/day R: Arc, D: Conc, T: Room"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "As the spell of the same name (ArM5, page 145); using the Arcane Connection residing in the bottom compartment of the Phylactery. The images appear in the mirrored lid of the box. Note that the effect will not work if the Arcane Connection is not to a well-defined room."
    }

    #tf0a1d6559985ff210befec ^"Alchemical Separation of Brine" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: Potent Salts"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 4
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReAq 4 Pen 0, charged item R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 119
        }
        DESCRIPTION "A pinch of these crystals converts salt water into pure salt through Rego Craft magic. Saltmaking is a skilled profession, and normally takes a month to turn brine into perfectly dry salt; this spell therefore requires a Dexterity + Finesse roll with an Ease Factor of 12 to successfully produce pure salt. Any sea creatures, seaweed and other flotsam are removed as part of the process and piled up next to the salt.\n\nSaltwater is usually about seven parts salt to two hundred parts water; this spell can affect up to 4,350 gallons of seawater (a base Individual of Aquam, assuming a circular body five paces diameter and two paces at the center), yielding 147 gallons of salt weighing 1228 pounds, or just over half a ton. Salt sells for 120 Mythic Pounds per ton (*City & Guild*, page 142) in a scarce market. (Base 3, +1 Touch)"
    }

    #t833017cd704584724af41b ^"A Harvest of Figs" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Garland of Prosperous Harvests"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +2 Sun, +1 Size; +5 24/day)"
            ^"Printed Effect Line" STRING "CrHe 40 Pen 0, 24/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "This spell brings a plant from seed to maturity over the course of a day. The plant that results is a perfect specimen of its kind appropriate to the season; if cast in spring the plant has flowers, if cast in autumn it is in full fruit. It can affect a tree up to Size +6, about 25 feet tall (a base Individual of Herbam is Size +3). The plant only thrives beyond the spell’s duration if it can normally grow under the climate and soil conditions that it finds itself in."
    }

    #te99cf5cd19028e9ca5889e ^"Nourish the Displaced Vines" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Example Device: The Garland of Prosperous Harvests"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +2 Sun, +2 Group, +1 Size; +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "CrHe 19 Pen 0, constant effect R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "Permits up to a hundred plants of Size +3 (or an equivalent volume, such as a thousand plants of Size +0 or ten trees of Size +6) to grow well regardless of the climate and soil conditions, although they may still be affected by disease. The plants must be growing close enough to each other for their roots or branches to touch, else they are not considered to be part of the same group.\n\nPlants affected by this spell for a year always produce their maximum yield of fruits, nuts, or seeds. A single bush of Size +3 produces anywhere between half to one bushel of produce, depending on the type of plant. A tree of Size +6 can bear five to ten bushels."
    }

    #t65e4bfdf01f4f9842f02b9 ^"The Hermetic Generans" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +1 Conc, +2 affect metal; +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "ReTe 15 Pen 0, 1/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This enchantment takes the shape of a thick disc of iron connected to a rod. This rod can be connected to a gear wheel or cuff which can be slipped over any axis. Once triggered, the device imparts strong motion; this would normally be in a straight line, but because it is tethered to the wheel or axis, it generates rotation instead. Assuming it is sufficiently attached, the Hermetic Generans can do as much work as a person or animal with a Strength of +5 (approximately one horse-power). It continues to turn until commanded to stop by the person who activated it, or until the sun sets. Naturally, the device could be designed to provide truly constant motion, but this would prevent it from ever being shut off. If nothing else, storage of such devices could be amusing.\n\nA stronger Hermetic Generans can be made; each magnitude added to the effect increases the power output ten-fold. One magnitude more would be enough to turn the front axle of a heavily-laden cart. Two additional magnitudes would turn an average waterwheel."
    }

    #tcd2cf982b6446c06df2f36 ^"The Instant Breach" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Charged Item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Part, +1 affect stone, +1 Size)"
            ^"Printed Effect Line" STRING "PeTe 15 Pen 0, Charged Item R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Triggered when touching a stone wall, this Charged Item destroys a section of that wall. It destroys 270 cubic feet of stone; enough to make a 6 foot diameter breach in a castle wall that is 10 feet thick, or 10 feet in diameter in wall that is 3 feet thick.\n\nThe charges are usually placed into separate boulders which are flung in groups by a trebuchet along with ordinary rocks."
    }

    #tde90b4037e864a2c3aaaed ^"The Lancet of Good Health" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +2 Touch, +3 Moon; +5 24/day)"
            ^"Printed Effect Line" STRING "CrCo 25 Pen 0, 24/day R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "Anyone whose blood is let by this sharp scalpel receives a +6 to any Disease Recovery rolls for a Moon’s Duration."
    }

}
