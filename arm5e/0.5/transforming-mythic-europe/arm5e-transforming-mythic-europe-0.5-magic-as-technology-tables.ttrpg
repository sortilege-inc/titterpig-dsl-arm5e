EXTENSION "ArM5_Transforming_Mythic_Europe_MagicAsTechnology_Tables" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Four: Magic as Technology tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ArM5_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t9a950eed0bc9e6aff77999 ^"Quality Remaining After Copying" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Finesse Total", "Effect", "Quality of Copy"]
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 100
        }
        TABLE {
            "3" "Spoil 8 pages in 10" "No readable book results"
            "5" "Spoil 6 pages in 10" "6 points lower than original"
            "7" "Spoil 4 pages in 10" "4 points lower than original"
            "9" "Spoil 2 pages in 10" "2 points lower than original"
            "11 or more" "Spoil no pages" "Equal to original"
        }
        DESCRIPTION "This table assumes an Ease Factor of 12 (i.e. Quality 7 to 9), a simple die roll, and no proofreading. For books requiring Finesse rolls of Ease Factor 9, add 3 to the Finesse Total; and subtract 3 for books requiring Finesse rolls of Ease Factor 15."
    }

}
