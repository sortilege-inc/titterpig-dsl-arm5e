EXTENSION "ARMDef_Against_the_Dark_Creatures_Broukolak" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Broukolak"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # Broukolak (Chapter Eight: Creatures, p121): one being, its printed stat lines verbatim fields.

    #t1a36017ad14eb754bfe377 ^"Broukolak" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Vessel of Iniquity"
            ^"Might" INTEGER 20
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 0
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Shapeshifter; Improved Characteristics, Lightning Reflexes"
            ^"Soak" INTEGER 14
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Weakness" STRING "Protected Group (those born on a Saturday)."
            ^"Vis" STRING "4 pawns, in teeth"
            ^"Appearance" STRING "The broukolak is indistinguishable from ordinary people in appearance, until it reveals its powers, at which point it takes on its true form. They have shiny black skin and are hunchbacked, with black hands and long nails. Their faces are blood-red and peeling, their teeth are like those of a cat or wolf, and they have wild hair and beards. With their Shapeshifter Ability, they usually take the form of cats, goats, and owls."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 121
        }
        PERSONALITY_TRAITS {
            "Hateful" +6
            "Depraved" +6
        }
        COMBAT {
            "Grapple" INIT 2 ATTACK 6 DEFENSE 7 DAMAGE 4
            " Teeth" INIT 2 ATTACK 10 DEFENSE 8 DAMAGE 7
            " Spittle" INIT 2 ATTACK 6 DAMAGE 10
        }
        ABILITIES {
            "Athletics" SCORE 10 SPECIALTY "leaping"
            "Brawl" SCORE 5 SPECIALTY "grapple"
            "Folk Ken" SCORE 3 SPECIALTY "passing for human"
            "Shapeshifter" SCORE 3 SPECIALTY "at night"
            "Thrown Weapons" SCORE 5 SPECIALTY "spittle"
        }
        POWERS {
            #t2466d4dc15583a91717d7b ^"Form of Wickedness (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Form of Wickedness"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 39"
            }
            #t1dafd9ceec598b9bb57823 ^"Form of Man (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Form of Man"
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 39"
            }
            #t7606d64a0d34c94a80510e ^"Contagious Obsession (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Contagious Obsession"
                    ^"Cost" STRING "1 point per victim"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See *Realms of Power: The Infernal*, page 39"
            }
            #t032a7203dbfb66618a7cb1 ^"Obsession (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Obsession"
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Fear. See *Realms of Power: The Infernal*, page 32."
            }
            #tf1907ccfb852e47c9a3461 ^"Burning Spittle (Against the Dark)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Burning Spittle"
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+2"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "The spittle of a broukolak is liquid fire, and it can expel it up to 5 paces. If it hits and penetrates Magic Resistance, the spittle inflicts +10 damage; if it is parried, it eats through any object it touches, rendering that object useless."
            }
        }
        DESCRIPTION "Broukolaci usually take victims who are on their own, locking them in a grapple before biting them. They occasionally keep their victims alive and feed from them night after night by inflicting scuffle damage rather than normal damage."
    }

}
