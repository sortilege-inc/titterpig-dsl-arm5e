EXTENSION "ARMDef_Against_the_Dark_Creatures_Devices" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Eight: Creatures devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t1adde2965e5b0173993d7f ^"Thief’s Valerian Sprig of Rego Vis" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 18
            ^"Requisite" STRING "Terram"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Part, +1 requisite; +3 6/day)"
            ^"Printed Effect Line" STRING "ReHe (Te) 18 Pen 0, 6/day R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "If implanted in a person’s hand, Thief’s Valerian can open locks, lift door bars and shift bolts at a touch. Every time the faerie plant uses its power, it takes a Long Term Fatigue level from its owner. If the weed is ever removed from its owner’s hand, he suffers a Light Wound, and the sprig loses all powers and vis."
    }

}
