        }
        DESCRIPTION "This Virtue gives the character a Score of 1 in the Supernatural Ability, Storm Riding. **Specialties: **seeing, traveling (self), traveling (others)."
    }

    #t07a56da525199bd7e919df ^"Storm Fighting (Virtue)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor Supernatural Virtue"
            ^"Printed Name" STRING "Storm Fighting"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural Virtue"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 130
