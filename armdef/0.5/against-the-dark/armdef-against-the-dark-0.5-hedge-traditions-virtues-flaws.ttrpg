        DESCRIPTION "Choosing this Virtue gives the character the Ban Art with an initial score of 0. Ban is a Difficult Art, meaning that it is treated as any other Art except that it uses the Ability Advancement Table rather than the Art Advancement Table. The Ban Art must be combined with at least one (Foe) Art to be used."
    }

    #tdab92107b1837b02bbea1e ^"Storm Calling (Virtue)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor Supernatural Virtue"
            ^"Printed Name" STRING "Storm Calling"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural Virtue"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "The character has a Score of 1 in the Supernatural Ability, Storm Calling. **Specialties: **storm creation, storm moving."
    }

    #t95bdc082e3350f57988a24 ^"Storm Riding (Virtue)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
