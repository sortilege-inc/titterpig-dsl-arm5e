    #t7564523cd4eb45f7232771 ^"Storm Wizard" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Free Social Status"
            ^"Size" STRING "Free"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "The character is a storm wizard.\n\n**Organization Lore: Storm Wizard**\n\n*Arcane Ability* This Arcane Ability is an Organization Lore that concerns the magic, personalities, and special locations (such as magical ice sites) of the storm wizard tradition. It is also used in ice harvesting and storm wizard initiations. **Specialties: ** ice harvesting, initiations, history, locations, personalities."
    }

}
