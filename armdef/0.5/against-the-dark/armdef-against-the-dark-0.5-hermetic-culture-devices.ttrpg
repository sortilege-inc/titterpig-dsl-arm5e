    #t6ae1305e1c7887b8e30554 ^"Obliteration of the Metallic Barrier (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Obliteration of the Metallic Barrier"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch, +1 size, +1 Rego to fling the objects away: Modifications +5, 24 uses per day)"
            ^"Printed Effect Line" STRING "PeTe 25 Pen +0, 24/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per the spell of the same name (ArM5, page 155). Often used to follow Wall of Protecting Stone."
    }

    #tbdaf3f7c622c4538fe25e8 ^"Sense the Feet That Tread the Earth (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Sense the Feet That Tread the Earth"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Conc, +1 Touch, +1 Part, +3 size; Modifications +5, 24 uses per day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "InTe 40 Pen +0, 24/day R: Touch, D: Conc, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per the spell of the same name (ArM5, page 154). The talisman maintains concentration."
    }

    #t22a9baec3fbe69169a2327 ^"Stone Tell of the Mind that Sits (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Stone Tell of the Mind that Sits"
            ^"Technique" STRING "Intellego"
