EXTENSION "ARMDef_Against_the_Dark_HermeticCulture_Devices" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Two: Hermetic Culture devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t697ebaadaa3ec229863f0f ^"Earth Split Asunder" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Voice, +1 Conc, +1 Part, +2 size, +1 fancy effect. Modifications +5, 24 uses per day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "ReTe 35 Pen +0, 24/day R: Voice, D: Conc, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per The Earth Split Asunder (ArM5, page 156). Item maintains concentration."
    }

    #tcccb183a223c896bad0efe ^"Endurance of the Berserkers (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Endurance of the Berserkers"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, +1 Conc; Modifications +5, 24 uses per day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "ReCo 30 Pen +0, 24/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As Endurance of the Berserkers (ArM5, page 134), but with Touch range. Item maintains concentration."
    }

    #t9229a39592a0825b7ee711 ^"The Invisible Siege Engine" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Voice; Modifications +5, 24 uses per day)"
            ^"Printed Effect Line" STRING "ReTe 15 Pen +0, 24/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As *Wielding the Invisible Sling *(**ArM5**, page 155-156), but permits the flinging of objects up to three feet across."
    }

    #t037ec6500fd005a77f9b0c ^"A Second Iteration of the Invisible Siege Engine" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+40"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Voice; Modifications +5, 24 uses per day, +20 Penetration)."
            ^"Printed Effect Line" STRING "ReTe 15 Pen +40, 24/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The same spell as earlier, reinvested once Monica became more powerful."
    }

    #t8b5630ceeb604c7cfbbb25 ^"Object of Increased Size (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
