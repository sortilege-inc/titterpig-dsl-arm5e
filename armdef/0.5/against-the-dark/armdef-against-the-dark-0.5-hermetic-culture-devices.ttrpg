            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 20, +1 Touch, +1 Conc: Modifications +5 24 uses per day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "InTe 40 Pen +0, 24/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per the spell of the same name (ArM5, page 154). The talisman maintains concentration."
    }

    #t56d1c7cc21ebe03fbe6365 ^"Wings of the Soaring Wind (Against the Dark)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Wings of the Soaring Wind"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 40
            ^"Requisite" STRING "Rego"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch, +1 Conc, +2 highly unnatural, +1 requisite; Modifications +5, 24 uses per day, +5 maintains concentration)"
            ^"Printed Effect Line" STRING "Cr(Re)Au 40 Pen +0, 24/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per the spell of the same name (ArM5, page 126). The talisman maintains concentration."
    }

}
