            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +2 Sun; Modifications +5, 24 uses per day)"
            ^"Printed Effect Line" STRING "MuTe 20 Pen +0, 24/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As per the spell of the same name (ArM5, page 154)."
