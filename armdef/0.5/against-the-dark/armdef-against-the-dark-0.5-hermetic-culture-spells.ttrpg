EXTENSION "ARMDef_Against_the_Dark_HermeticCulture_Spells" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Two: Hermetic Culture spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tae75917bf8799a475296b9 ^"Abrading Stones" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 25 R: Voice, D: Diameter, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell lifts all loose rocks and pebbles in a 15-pace radius about the target, and grinds them against the victim. Damage is +5 per round.\n\n(Base 4, +2 Voice, +1 Diameter, +1 Part, +1 size)"
    }

    #td9914593c855cda25a0c43 ^"Diverting the River" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 50 R: Voice, D: Diameter, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell creates a chasm 30 feet wide, 30 to 40 feet deep, and 10,000 paces long (which is just over 5.5 miles). Monica can use this spell to divert rivers with the aid of her Necessary Monolith spell, which dams the original watercourse. She can also create defensive circles, up to a mile and three quarters across, with each casting of the spell. The channel is not stable, and begins to collapse over the next few days, but if has been used to divert a river, the scouring action of the water may keep it clear.\n\n(Base 3, +2 voice, +1 Diameter, +1 part, +7 size)"
    }

    #t75a73f2b6a7b31d70664b2 ^"The Field of Millstones" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 40 R: Voice, D: Diameter, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "As Abrading Stones, but affects everything in a circle 200 paces across.\n\n(Base 4, +2 Voice, +1 Part, +4 size, +1 Diameter)"
    }

    #t03dc25244b6ca020bb6288 ^"Necessary Monolith" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrTe 35 R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell creates a wall 50 paces long, 20 paces high, and 10 paces thick. Monica uses this spell to dam rivers, so that her Diverting the River spell has sufficient water to be effective.\n\n(Base 3, +2 Voice, +2 Sun, +4 size)"
    }

    #t36177808f190a35b277040 ^"Sudden Well" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeTe 30 R: Voice, D: Mom, T: Part"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "This spell creates a shaft 10 feet square and 100 feet deep. The shaft is not reinforced, so it collapses swiftly after it is created.\n\n(Base 3, +2 Voice, +1 Part, +4 size)"
    }

}
