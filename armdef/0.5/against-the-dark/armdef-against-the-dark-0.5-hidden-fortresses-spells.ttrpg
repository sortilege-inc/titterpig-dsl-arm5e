EXTENSION "ARMDef_Against_the_Dark_HiddenFortresses_Spells" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Seven: Networks of Hidden Fortresses spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t90e25879ebde1d832843e4 ^"Arms of the Salamander" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 30 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "This ritual, written on a casting tablet, instantly restores a character’s lost limb. If the character has been without the limb for more than a season, it takes him about a week to become used to its presence again (rolls that require the limb are at a –3 penalty for the week). Casting this ritual requires 6 pawns of vis. Note that, unlike *The Severed Limb Made Whole*, this ritual does not need the original limb. If the target is missing several limbs, the most recently detached is restored by this ritual.\n\n(Base 25, +1 Touch)"
    }

    #t46921592433d7f55742b3b ^"The Rite of Healing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 50 R: Touch, D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 99
        }
        DESCRIPTION "Zenodochia contain a casting tablet for this ritual, which heals the targets of all Wounds the user may have. Casting this ritual requires a rook of vis.\n\n(Base 35, +1 Touch, +2 Group)"
    }

    #t3f6c0185660effec9a58cc ^"Universal Poultice" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 50 R: Touch, D: Momentary, T: Group, Ritual"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 99
        }
        DESCRIPTION "Zenodochia contain a casting tablet for this ritual which cures the targets of any disease they may have. Casting this ritual requires a rook of vis.\n\n(Base 35, +1 Touch, +2 Group)"
    }

}
