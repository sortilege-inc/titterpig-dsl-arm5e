EXTENSION "ARMDef_Against_the_Dark_HiddenFortresses_Tables" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Seven: Networks of Hidden Fortresses tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t22311dae513a93d25c5746 ^"Fort Locations (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Location"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 101
        }
        TABLE {
            "The Bran Pass"
            "The Madara Plateau"
            "North of Varna on the Black Sea coast"
            "Near the border of Serbia and the Despotate of Epirus on the Adriatic coast"
            "The Iron Gates on the Danube River"
            "West of the Carpathian Mountains on the Pontic-Caspian steppe, an area notorious for large gatherings of Cuman warriors"
            "North of Adrianople on the Bulgarian-Byzantine border"
        }
    }

}
