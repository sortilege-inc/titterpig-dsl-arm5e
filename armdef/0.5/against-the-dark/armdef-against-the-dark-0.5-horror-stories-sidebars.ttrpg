EXTENSION "ARMDef_Against_the_Dark_HorrorStories_Sidebars" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Ten: Horror Stories sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Sources" #tc245d9e5257edd26663ce1 {
            TEXT "Sources\n\nFilms, books, and other media are good sources of inspiration for horror stories. For example, some of the archetypical plots discussed here are based on film criticism by K. Newman’s *Nightmare Movies: Critical History of the Horror Film, 1968-1988* (London: Bloomsbury, 1988) and S. Prince’s *The Horror Film* (New Brunswick, NJ: Rutgers University Press, 2004)."
        }
    }

}
