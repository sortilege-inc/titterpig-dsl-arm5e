EXTENSION "ARMDef_Against_the_Dark_Introduction_Tables" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter One: Introduction tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t64be7572ece69ebd116edd ^"Languages in the Balkans" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Language", "Includes"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 10
        }
        TABLE {
            "South Slavonic" "Bulgarian, Serbian, Church Slavonic"
            "Vlach" "Romanian, Aromanian"
            "Oghuz" "Turkish, Turkman, Azerbaijani, Pecheneg"
            "Kipchak" "Cuman, Kipchak"
            "Magyar" "Hungarian, Transylvanian"
            "Low German" "Saxon"
        }
    }

    #t64ac2838c0950522329117 ^"Languages in the Balkans (penalties)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Languages", "Penalty"]
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 10
        }
        TABLE {
            "Same language, different dialects" "–1"
            "Vlach vs. Latin" "–3"
            "Kipchak vs. Oghur or Oghuz" "–2"
            "Low German vs. High German" "–2"
            "Low German vs. English" "–3"
        }
    }

