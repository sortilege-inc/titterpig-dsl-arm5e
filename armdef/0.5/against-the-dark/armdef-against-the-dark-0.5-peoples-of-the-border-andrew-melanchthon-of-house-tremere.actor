EXTENSION "ARMDef_Against_the_Dark_PeoplesOfTheBorder_AndrewMelanchthonOfHouseTremere" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Andrew Melanchthon of House Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # Andrew Melanchthon of House Tremere (Chapter Six: Peoples of the Transylvanian Border, p94): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tbd362696f0aa061889185b ^"Andrew Melanchthon of House Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#td95e71ec41ffe97a2cd5f7 ^"The Scholomance"]
            ^"Age" STRING "49 (apparent age 36)"
            ^"Personality Trait" STRING "Dedicated +3, Hopeful +2, Naïve +1 Privilege: Cives Melanchthon was forced to leave the Rhine Tribunal after a series of public disputes with a prominent member of House Bonisagus left him branded as both an empiricist and atheist, and unlikely to ever succeed on a political stage within that Tribunal’s hierarchy. The accusation of atheism is unfair; like most Tremere, he is impious but not an atheist per se. His true crime was being vocal about his rejection of God as a loving father. The Scholomance allows Melanchthon to pursue his own curriculum with the pupils of the school. He is specifically interested in the teaching of moral philosophy and rhetoric, drawing on non-standard texts deemed heretical or blasphemous by the establishment. He dreams of a time when his pupils enact his humanist agenda in the universities and courts of Mythic Europe."
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 94
        }
    }

}
