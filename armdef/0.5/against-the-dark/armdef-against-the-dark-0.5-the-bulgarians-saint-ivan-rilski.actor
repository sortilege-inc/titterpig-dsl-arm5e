    # Saint Ivan Rilski (Chapter Four: The Bulgarians, p47): one saint, its printed stat lines verbatim fields.

    #t72106cba32f1ea16e8abee ^"Saint Ivan Rilski" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Printed Name" STRING "Saint Ivan Rilski, Patron of Bulgaria"
            ^"Patronage" STRING "Bulgaria"
            ^"Divine Might" INTEGER 50
            ^"Area of Veneration" STRING "Bulgarians, inhabitants of Sredets and Tarnovo, monks, hermits"
            ^"Feast" STRING "October 19th"
            ^"Attributes" STRING "Holy Cross and a scroll or open book showing Cyrillic characters Powers (see Realms of Power: The Divine Revised Edition, pages 88–89): Apparition, Expel Demons, The Faithful Made Whole, Grant of Serenity, Strike Dumb"
            ^"Location" LIST [#ta625acc355e70d5b124113 ^"Bulgaria"]
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 47
        }
    }

}
