EXTENSION "ARMDef_Against_the_Dark_TheBulgarians_SaintPowers" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Four: The Bulgarians saint powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's saint powers, structured; each DESCRIPTION the source's text, verbatim.

    #t465339fceef5c9805922df ^"Strike Dumb" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+8"
            ^"Form" STRING "Corpus"
            ^"Printed Stat Line" STRING "Strike Dumb, 1 point, Init +8, Corpus"
            ^"Saint" LIST [#t72106cba32f1ea16e8abee ^"Saint Ivan Rilski"]
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "The target of this power is rendered entirely mute. This situation persists until the saint chooses to lift the curse."
    }

}
