EXTENSION "ARMDef_Against_the_Dark_TheBulgarians_Tables" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Four: The Bulgarians tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #te71d9d8fd991750314616d ^"Exhibit Source Quality (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Exhibit", "Source Quality"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 59
        }
        TABLE {
            "Unparalleled" "Source Quality 11+"
            "Comprehensive" "Source Quality 8-10"
            "Cursory" "Source Quality 5-7"
        }
    }

}
