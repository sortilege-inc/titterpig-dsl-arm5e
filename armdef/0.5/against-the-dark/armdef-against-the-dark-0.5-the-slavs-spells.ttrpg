EXTENSION "ARMDef_Against_the_Dark_TheSlavs_Spells" {
    NAME "Ars Magica Fifth Edition, Against the Dark - Chapter Five: The Slavs spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Against_the_Dark_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tbc19ecc2cc141fde2d1a54 ^"Perun’s Arrow" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrAu 25 R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Against the Dark"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "This thee-foot-long fulgurite tube changes into a lightning bolt when hurled and delivers +30 damage to a target if a successful Attack roll is made. Treat the fulgurite as a javelin (Thrown Weapon) with an Initiative of –1 and an Attack modifier of +1.\n\n(Base 5, +4 unnatural)"
    }

}
