EXTENSION "ARMDef_Ancient_Magic_CanaaniteNecromancy_Breakthroughs" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Two: Canaanite Necromancy breakthroughs"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's breakthroughs, structured; each DESCRIPTION the source's text, verbatim.

    #tcf1c13054432a26dd67ede ^"Integrating Canaanite Necromancy" DEF {
        EXTENDS #t60051c4d8aa56491728169 ^"Breakthrough Requirement"
        PROPERTIES {
            ^"Integrates" STRING "Canaanite Necromancy"
            ^"Breakthrough Points" INTEGER 45
            ^"Printed Requirement" STRING "To Integrate Canaanite Necromancy: Accumulate 45 or more breakthrough points"
            ^"Rules Section" STRING "Hermetic Integration"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Note that the character does not gain the Hermetic Virtue until the integration is complete, and so until then he does not gain the special\n\nArcane Connection and he may only utilize the special Range Veil of Death in those spells that he invented using Insight Lab Texts."
    }

}
