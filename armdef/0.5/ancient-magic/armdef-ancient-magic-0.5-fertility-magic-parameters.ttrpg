EXTENSION "ARMDef_Ancient_Magic_FertilityMagic_Parameters" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Four: Fertility Magic parameters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's parameters, structured; each DESCRIPTION the source's text, verbatim.

    #t1b27968fe2181f4573a0ec ^"Unborn Child (Target)" DEF {
        EXTENDS #tcff0104e131e6468aca4da ^"Spell Parameter"
        PROPERTIES {
            ^"Printed Name" STRING "New Target: Unborn Child"
            ^"Parameter" STRING "Target" FIXED
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "The Minor Hermetic Virtue Fertility Ritual Magic allows a magus access to a new Target Unborn Child. This Target is equivalent to Individual for the purposes of calculating a spell level, and it may be used to make an unborn child, from the moment of conception until birth, the target of a spell. The magus must be able to sense the mother to target the unborn child, and the mother’s Magic Resistance (if any) protects her unborn child."
    }

}
