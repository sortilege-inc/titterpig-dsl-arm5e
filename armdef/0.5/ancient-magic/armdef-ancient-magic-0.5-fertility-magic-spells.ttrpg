EXTENSION "ARMDef_Ancient_Magic_FertilityMagic_Spells" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Four: Fertility Magic spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t67a1027647e11e2c1814e4 ^"Midwife’s Eye" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Unborn"
            ^"Printed Stat Line" STRING "InCo 5 R: Touch, D: Mom, T: Unborn"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Child\n\nThis spell indicates the general health and sex of an unborn child. A Perception + Fertility Lore roll against an Ease Factor of 3 indicates the expected date of birth.\n\n(Base 4, +1 Touch)"
    }

    #tb09d90fad5e77e37d05e38 ^"The Frozen Womb" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Unborn"
            ^"Printed Stat Line" STRING "MuCo 35 R: Touch, D: Year, T: Unborn"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Child, Ritual\n\nThis Ritual spell freezes the development of an unborn child for a year. The spell does not damage either the child or the mother — although the mother may be seriously inconvenienced by a delayed late-term pregnancy — but both mother and child gain Warping Points due to being under the influence of a constant, high-power mystical effect (see ArM5, page 167).\n\nThe spell can be cast at yearly intervals in order to delay a pregnancy for years, or even decades, and versions of this spell with other durations could be used to delay a birth until an astrologically favorable moment.\n\n(Base 10, +1 Touch, +4 Year)"
    }

    #tf7d4e241285db62712d69c ^"Black Anne’s Kiss" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Unborn"
            ^"Printed Stat Line" STRING "PeCo 10 R: Touch, D: Mom, T: Unborn"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Child\n\nThis spell wounds an unborn child, causing the fetus to abort. A Stamina stress roll against an Ease Factor of 6 must be made for the mother; if it fails she suffers a Medium Wound.\n\n(Base 5, +1 Touch)"
    }

    #t734ecd1823509981d15b2a ^"The Promenade of Caesar" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Unborn"
            ^"Printed Stat Line" STRING "ReCo 15 R: Touch, D: Mom, T: Unborn"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Child\n\nThis spell transports an unborn child instantly out of his mother’s womb, to a distance of up to five paces away. This is normally fatal for the child but does not harm the mother — the spell also removes the placenta. To determine whether the child survives, make a Stamina roll against an Ease Factor of 3 + 3 for each month prior to natural birth. For example, if *The Promenade of Caesar* is cast on an eight-month-old fetus the Ease Factor is 6. An unborn child has a –4 penalty to his Stamina.\n\n(Base 10, +1 Touch)"
    }

    #tc635c655b542864eac68ac ^"Hand of the Antiquarian" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReTe 15 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The magus traces around a section of stone up to one pace in diameter. That section, to a depth of up to an inch thick, floats out of the wall. While the magus touches the stone, it is effectively weightless.\n\n(Base 3, +1 Touch, +2 Sun, +1 Stone)"
    }

}
