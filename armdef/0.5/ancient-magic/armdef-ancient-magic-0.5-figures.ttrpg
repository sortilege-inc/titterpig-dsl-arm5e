EXTENSION "ARMDef_Ancient_Magic_Figures" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - maps"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The book's four maps and one plan, as ^"Figure" records. Their labels were read from the rendered page and
    # checked against the text layer; the transcription and how it was made: ancient-magic/figures.json.

    # source: page 14, lettering read from the page and its text layer (figures.json)
    #t48b906086f1b23b0a67c3a ^"Medieval Mesopotamia" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Medieval Mesopotamia"
            ^"Lettering" LIST OF STRING ["Medieval Mesopotamia", "100 miles", "ANATOLIA", "CASPIAN SEA", "Tebriz", "MONGOLS", "Antioch", "Aleppo", "SYRIA", "Mosul", "Hamadhan", "MEDITERRANEAN SEA", "Euphrates R.", "Tigris R.", "Samarra", "ZAGROS MOUNTAINS", "Damascus", "Baghdad", "PERSIA", "HOLY LAND", "Acre", "IRAQ", "Jerusalem", "(Gihon R.)", "(Pison R.)", "PERSIAN GULF", "Euphrates R.", "BABYLON", "Hiddekel R.", "Gihon R.", "Ancient Ruins of Babylon"]
            ^"Shows" STRING "map: the lands from Anatolia and the Holy Land to Persia and the Caspian Sea, with an inset of the ruins of Babylon"
            ^"Lettering Source" STRING "read from the page rendered at 80-110 dpi and checked against the text layer (which sets curved and letter-spaced labels as single letters); labels as printed"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 14
        }
    }

    # source: page 35, lettering read from the page and its text layer (figures.json)
    #t78750dcdcab4ee31077f76 ^"Location of En-Dor" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Location of En-Dor"
            ^"Lettering" LIST OF STRING ["Location of En-Dor", "Litani R.", "Acre", "Sea of Galilee", "Hattin", "Nazareth", "Tiberias", "EN-DOR", "Jordan R.", "Jerusalem", "Dead Sea", "Bethlehem"]
            ^"Shows" STRING "map: the land from the Litani River to the Dead Sea, marking En-Dor"
            ^"Lettering Source" STRING "read from the page rendered at 80-110 dpi and checked against the text layer (which sets curved and letter-spaced labels as single letters); labels as printed"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 35
        }
    }

    # source: page 85, lettering read from the page and its text layer (figures.json)
    #te1771e135256c6008738d9 ^"Lost Temple of Serapis" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Lost Temple of Serapis"
            ^"Lettering" LIST OF STRING ["Lost Temple of Serapis", "Altar with Theatre of Heron", "ADYTON", "Pillar", "Statue of Serapis", "CELLA", "Staircase to Pediment Chambers", "Brazier"]
            ^"Shows" STRING "plan: the temple's interior, the adyton and the cella"
            ^"Lettering Source" STRING "read from the page rendered at 80-110 dpi and checked against the text layer (which sets curved and letter-spaced labels as single letters); labels as printed"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 85
        }
    }

    # source: page 92, lettering read from the page and its text layer (figures.json)
    #t4b9d2a0efc9b692278a5d5 ^"Canary Islands" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Canary Islands"
            ^"Lettering" LIST OF STRING ["Canary Islands", "Invallis", "50 miles", "Junonia", "Ninguaria", "Herbania", "Canaria", "Capraria", "Pluvialia", "ATLANTIC OCEAN", "Iberia", "Canary Islands", "Africa"]
            ^"Shows" STRING "map: the Canary Islands, with Iberia and Africa"
            ^"Lettering Source" STRING "read from the page rendered at 80-110 dpi and checked against the text layer (which sets curved and letter-spaced labels as single letters); labels as printed"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 92
        }
    }

    # source: page 137, lettering read from the page and its text layer (figures.json)
    #tbdf46a7d5d8e9321f4956e ^"Lands of the Rune Wizards" DEF {
        EXTENDS #tc349347caf3213a90237bd ^"Figure"
        PROPERTIES {
            ^"Title" STRING "Lands of the Rune Wizards"
            ^"Lettering" LIST OF STRING ["MAP KEY", "Town or Settlement", "Viking Grave Site", "Path of Viking Settlement", "Shaded Areas Indicate Areas of Heaviest Settlement", "Faroe Islands", "Trondheim", "Shetland Islands", "Oslo", "Orkney Islands", "NORTH SEA", "BALTIC SEA", "Ribe", "Dublin", "Derby", "Nottingham", "Leicester", "Stamford", "100 miles", "ATLANTIC OCEAN", "Lands of the Rune Wizards"]
            ^"Shows" STRING "map: the North Sea lands, with the paths and areas of Viking settlement"
            ^"Lettering Source" STRING "read from the page rendered at 80-110 dpi and checked against the text layer (which sets curved and letter-spaced labels as single letters); labels as printed"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 137
        }
    }

}
