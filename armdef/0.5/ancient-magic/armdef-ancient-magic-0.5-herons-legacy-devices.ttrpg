EXTENSION "ARMDef_Ancient_Magic_HeronsLegacy_Devices" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Six: Heron of Alexandria’s Legacy devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tf9d983390af5f35c3db8f5 ^"Quench the Flames" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "PeIg 19 Pen 0, 12/day R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The bulky cart makes this difficult to deploy, requiring two mules or cart horses to move.\n\nSo long as the water tank is full, the pump can extinguish any flames its water jet is directed upon. It quenches an area five paces across with a Perdo Ignem Level 20 effect. Even magical flames are affected.\n\n(Effect: Base 3, +2 Voice, +2 Group; Modifications: 12/day +4)\n\n(Level: 7)"
    }

    #t56fed2e29da47bbf72edc0 ^"Beguile the Gathering" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "6"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "CrMe 33 Pen 6, 3/day R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The Aeolipile requires an extensive set up. Bringing the properly prepared water in the cauldron to a boil and bringing the whirling device up to speed takes about 15 minutes. Once started, the Aeolipile functions until the water boils dry or the user’s concentration is broken.\n\nThose entering the area of effect become curious and stay to watch for the duration of the effect. A stress roll against an Ease Factor of 9 using an appropriate Personality Trait (like Impatient) can break the hold.\n\n(Effect: Base 4, +2 Voice, +1 Conc, +2 Group; Modifications: +3 Pen, 3/day +5)\n\n(Level: 13)"
    }

    #tc22deb62e1de9f510c8bb3 ^"Theurge’s Trumpet" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "CrAu 19 Pen 0, 12/day R: Voice, D: Mom, T: Room"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "The device requires at least 15 minutes to recharge after each use.\n\nAt its maximum effect, the targets must make a Stamina stress roll against an Ease Factor of 9 or be unable to act in the next round. A target who fails may make additional Stamina simple rolls each round thereafter against the same Ease Factor, and recovers if successful. If the first roll botches, the sound knocks the victim unconscious.\n\n(Effect: Base 3, +2 Voice, +2 Room; Modifications: 12/day +4)\n\n(Level: 9)"
    }

    #t7bc0654813706584b843c2 ^"The Web of Mnemosyne" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "1/month"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "InIm 60 Pen +20, 1/month R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "Once per month, Heron’s Theater can predict the future of someone associated with it. The target must be among those watching the play, and the effects last for the duration of the play, which usually takes about an hour. The effect is non-Hermetic and apparently breaks the Limit of Time. As such, investigating it is remarkably difficult.\n\nThe play is often highly allegorical, based on the mythic figures and archetypes available in the theater’s assembly of puppets and figurines. Interpreting what a play means might be an adventure in itself as characters consult with scholars, seers, and holy men."
    }

}
