    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's breakthroughs, structured; each DESCRIPTION the source's text, verbatim.

    #t676ee6dc5ab4e91823b5fc ^"Integrating a New Duration" DEF {
