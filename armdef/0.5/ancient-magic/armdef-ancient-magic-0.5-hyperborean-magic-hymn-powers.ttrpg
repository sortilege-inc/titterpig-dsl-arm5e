EXTENSION "ARMDef_Ancient_Magic_HyperboreanMagic_HymnPowers" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Eight: Hyperborean Magic hymn powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's hymn powers, structured; each DESCRIPTION the source's text, verbatim.

    #tac9fa52229513b8433c5cc ^"Apollo’s Luminescent Blessing" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Ignem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Conc, +2 levels for Penetration)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Light"
            ^"Printed Stat Line" STRING "R: Touch, D: Conc, T: Ind Ignem, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Light"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "Causes the touched character to glow with light that is as bright as daylight on a cloudy day. Looking directly at the light is possible, but uncomfortable (unless the character has Magic Resistance)."
    }

    #t362d7fa29f6d1bd3bbe0af ^"Sovereignty of Phoebus Apollo" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +3 Sight, +2 Sun, +4 levels for Penetration)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "34"
            ^"Principle" STRING "Authority, ghosts, leadership"
            ^"Printed Stat Line" STRING "R: Sight, D: Sun, T: Ind Mentem, Pen +(user’s total), 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 34 Principle: Authority, ghosts, leadership"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power invokes deep respect for your character in all spiritual beings, so long as he Penetrates their Magic Resistance. Spirits, elementals, and ghosts from all realms treat your character with great respect and are inclined to obey him."
    }

    #t31f1d539d3eccb37bacf39 ^"Defy the Hound Cerebus" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 15, +4 Arc, +1 Conc, +5 levels for Penetration)"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Ghosts"
            ^"Printed Stat Line" STRING "R: Arc, D: Conc, T: Ind Mentem, Pen +10, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Ghosts"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power summons a ghost to whom your character has an Arcane Connection, or who is haunting an area (should your character possess its full name), and allows it to possess a body. The body is animated by the ghost, but may be directed by your character’s commands. If the ghost has a Might score, you must successfully penetrate its Magic Resistance for the Power to work. The bodies and ghosts of people buried by a Divine rite are not affected by this Power."
    }

    #t0a2d1a2cbe6d80245fb46f ^"The Swan-Drawn Chariot" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Azai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "2 uses/day"
            ^"Effect Design" STRING "(Base: General guideline, +2 Sun, +4 levels for Penetration, +1 uses/day)"
            ^"Ease Factor" STRING "variable"
            ^"Level Cost" STRING "variable"
            ^"Principle" STRING "Authority, leadership"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Mentem, Pen +(user’s total), 2 uses/day"
            ^"Printed Totals" STRING "Ease Factor: variable Level Cost: variable Principle: Authority, leadership"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This Power infuses your character with ethereal energies, which can only be detected by spiritual creatures, such as daimons and faeries, or angels and demons (who are rarely deceived). It magically brightens your character’s “soul-spark,” the liminal glow that is visible to many spiritual beings. It also makes your character appear to spirits as though he possesses a Magic Might equal to (the level of this power – 15) / 2."
    }

    #tfd0104f55265a4b7c22f74 ^"False Dream" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 2, +4 Arc, +2 Sun, +2 levels for Penetration)"
            ^"Ease Factor" STRING "8"
            ^"Level Cost" STRING "22"
            ^"Principle" STRING "Dreams"
            ^"Printed Stat Line" STRING "R: Arc, D: Sun, T: Ind Mentem, Pen +4, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 8 Level Cost: 22 Principle: Dreams"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Changes the target’s dreams to be anything the hymnist may desire. The target must be asleep and the hymnist must possess an Arcane Connection to the dreamer."
    }

    #t03803b3c472b3e0fe0113e ^"Demeter’s Blessing" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Bound"
            ^"Forms" LIST OF STRING ["Aquam"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +4 Year, +4 Bound, +1 Size [for a total of +4 Size])"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Rain"
            ^"Printed Stat Line" STRING "R: Sight, D: Sun, T: Bound Aquam, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Rain"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Causes nourishing rain to fall upon a designated area up to 6 miles across."
    }

    #t209783ec265aed1649e23a ^"Bestow Fecundity" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Eloure"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Animal", "Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 30, +1 Touch)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Fertility"
            ^"Printed Stat Line" STRING "R: Touch, D: Mom, T: Ind Animal, Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Fertility"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power allows a touched person or animal to conceive a child, even if one of the partners is sterile (although not magically sterile, such as from the Longevity Ritual). The offspring of this Power may be magically Warped or possess Flaws such as Age Quickly, Magical Air, or Offensive to Animals. (For more information on the consequences of magically interfering with fertility, see Chapter 4: Fertility Magic)."
    }

    #tcc766b48e1d8b35bae63d6 ^"The Gift of Far-sighted Apollo" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Forms" LIST OF STRING ["Imaginem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 3, +2 Sun, +4 Vision)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Sight"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Vision Imaginem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Sight"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power allows your character to see clearly great distances, as if the area were only a few feet away. Your character can also judge distances well."
    }

    #t0e2a10af2fc5d1be19853b ^"Opening the Hidden Eyes" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Sight"
            ^"Forms" LIST OF STRING ["Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +1 Conc, +5 Vision, +2 extra detail)"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Auras"
            ^"Printed Stat Line" STRING "R: Touch, D: Conc, T: Sight Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Auras"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "By this Power, the touched character is able to see the fluid vis of an area, the nature and strength of an aura, the presence of nearby regiones, and even elementals, spirits, and magical effects. This Power completely replaces the character’s normal sight, so he cannot see the normal, mundane world. This Power cannot detect non-Magic auras or creatures. The target may also see into and enter magical regiones, and lead other people into them. Specific Abilities, such as Magic Theory or Magic Lore, may be required to interpret the information."
    }

    #t6a9e7f081b269ddf998f64 ^"Cleansing Libation of the Sybil of Cumae" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Iaó"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "19 Years"
            ^"Target" STRING "Bound"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +5 19 Years, + 4 Bound)"
            ^"Ease Factor" STRING "18"
            ^"Level Cost" STRING "55"
            ^"Principle" STRING "Disease"
            ^"Printed Stat Line" STRING "R: Touch, D: 19 Years, T: Bound Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 18 Level Cost: 55 Principle: Disease"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "This Power grants all those within the boundary a +12 bonus to resisting or recovering from the effects of illness and disease. Note that this may cause Warping if a person is exposed for a long period of time."
    }

    #t456c61deeb141e4b60e08a ^"The Unseen Traveler" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Imaginem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 4, +2 Sun, +1 changing image)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Secrecy"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Imaginem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Secrecy"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "Like a spirit, your character become completely invisible and undetectable (except by Intellego magic, Second Sight, or an equivalent), regardless of what the character does."
    }

    #t872f0de591d7cc4c28d779 ^"Turn to Lofty Heights" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Spec"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem", "Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Intellect, spirits"
            ^"Printed Stat Line" STRING "R: Per, D: Spec, T: Ind Mentem, Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Intellect, spirits"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power allows the hymnist’s spirit to leave his body and travel free of its mortal flesh. While using this Power, the hymnist is completely insubstantial, can move through material barriers and items, and may travel as fast as a flying bird. Other spiritual creatures can see the character and interact with him, and can be deceived into believing that he is a native inhabitant of the spirit worlds through a Communication + Guile stress roll versus an Ease Factor equal to the spirit’s Perception + (Might / 2). The hymnist’s physical body is completely immobile and helpless while this power is in effect, does not respond to external stimuli, and may die if not looked after. The hymnist’s spiritual body is vulnerable to control by Mentem and Vim spells, although it is invisible and intangible. If the physical body dies while the hymnist is using this Power, he is permanently stuck in spirit form, and may eventually die, or transform into a spirit or ghost (at the storyguide or troupe’s discretion). If the character does not return from the spirit world in short order, he may begin to accrue Warping Points.\n\n(Non-Hermetic)"
    }

    #t7ee9eb7a9582f7dc34dbd1 ^"Ride the Arrow of Abaris" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Óai"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 35, +3 Sight)"
            ^"Ease Factor" STRING "17"
            ^"Level Cost" STRING "50"
            ^"Principle" STRING "Travel"
            ^"Printed Stat Line" STRING "R: Sight, D: Mom, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 17 Level Cost: 50 Principle: Travel"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power instantly transports your character to any place she can see. Most hymnists, before using this Power, fly to a great height (normally after turning invisible) and use other magic to see a great distance. Remote scrying, at the troupe or storyguide’s option, could also work."
    }

    #t03129fc4a84dda7c80d97f ^"Punishment of Marsyas" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Pentiterouni"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Animal", "Corpus"]
            ^"Penetration" STRING "+(user’s total)"
            ^"Uses" STRING "2 uses/day"
            ^"Effect Design" STRING "(Base 20, +1 Touch, + 4 levels Penetration, +1 level uses/day)"
            ^"Ease Factor" STRING "10"
            ^"Level Cost" STRING "30"
            ^"Principle" STRING "Skin"
            ^"Printed Stat Line" STRING "R: Touch, D: Mom, T: Ind Animal, Corpus, Pen +(user’s total), 2 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 10 Level Cost: 30 Principle: Skin"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "When Apollo was challenged by the satyr Marsyas to a reed-pipe competition, he grievously punished the satyr’s impertinence by tearing off his skin. This Power tears the skin off the whole surface of a touched person’s body, dealing an Incapacitating Wound (regardless of Soak). It is very unlikely that anyone can survive this Power without immediate supernatural aid."
    }

    #t69a3aca3ee430b6627dc13 ^"Radiant Mantle of the Night-Wanderer" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Pentiterouni"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Spec"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Vim"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Ease Factor" STRING "15"
            ^"Level Cost" STRING "45"
            ^"Principle" STRING "Skin, flesh"
            ^"Printed Stat Line" STRING "R: Per, D: Spec, T: Ind Vim, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 15 Level Cost: 45 Principle: Skin, flesh"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "This Power, when used with the Óai Power Turn to Lofty Heights, allows the hymnist’s spirit to take on pseudo-flesh and appear in the mundane world. This phantasmal body appears exactly like the character’s true body, may wear clothes, and is real enough that it can handle light objects, touch people, and otherwise appear real. If the shell suffers any damage at all, it dissolves, ending the Power’s effect and pushing the character’s spirit back into the spirit world, although there are no other ill effects.\n\nWhile clothed in pseudo-flesh the character can see the mundane world clearly. Close examination of the character, with a Perception + Awareness stress roll against an Ease Factor of 9, reveals that there is something not quite right about the pseudo-flesh — that it is merely a fabrication. This Power has no effect if the character casts it when his spirit is connected to his body. Note that if the character possesses The Gift, then people still react to it as normal.\n\n(Non-Hermetic design)"
    }

    #t321974e8fe07485021de74 ^"Fortitude of Cadmus" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 5, +2 Sun)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Stamina, willpower"
            ^"Printed Stat Line" STRING "R: Per, D: Sun, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Stamina, willpower"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 113
        }
        DESCRIPTION "Your character becomes filled with stamina and endurance, gaining a +1 bonus that can be used for either\n\nSoak or to resist Fatigue (see ArM5, page 178)."
    }

    #t65ca30a42d0570e6632438 ^"Victory of the Lapiths" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 10, +1 Diam)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Stamina, conflict"
            ^"Printed Stat Line" STRING "R: Per, D: Diam, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Stamina, conflict"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 113
        }
        DESCRIPTION "The Lapiths were a tribe guarded by Apollo in their victorious battle against the centaurs. This Power allows your character to endure any wound (short of death) or fatigue without penalty. Keep track of all wounds and Fatigue levels lost, as they immediately affect your character once the Power wears off."
    }

    #t375be899da9ce512413389 ^"Courage of the Python Slayer" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+2"
            ^"Uses" STRING "12 uses/day"
            ^"Effect Design" STRING "(Base 4, +2 Voice, +2 Sun, +1 for Penetration, +4 uses/day)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Aggression, willpower"
            ^"Printed Stat Line" STRING "R: Voice, D: Sun, T: Ind Mentem, Pen +2, 12 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Aggression, willpower"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "This Power grants resolute courage and determination in a person who hears the consecration. Supernatural effects that inspire fear must have a greater level than this Power in order to work."
    }

    #tb7ed3f300d645c9c0aafff ^"Slaying of Niobe’s Children" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 20, +2 Voice, +2 levels for Penetration, +3 levels uses/day)"
            ^"Ease Factor" STRING "12"
            ^"Level Cost" STRING "35"
            ^"Principle" STRING "Conflict, fever"
            ^"Printed Stat Line" STRING "R: Voice, D: Mom, T: Ind Corpus, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 12 Level Cost: 35 Principle: Conflict, fever"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Your character may shoot unseen bolts, which infect the target with a deadly disease. The disease causes the equivalent of a Heavy Wound, has an Ease Factor of 9 to resist (see ArM5, page 180), and is not contagious."
    }

    #t8c43d120b7320e75416f29 ^"Eternal Youth of the Sun" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Psyrinpheu"
            ^"Range" STRING "Per"
            ^"Duration" STRING "19 Years"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Corpus"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 40 [non-Hermetic], + 5 19 Years)"
            ^"Ease Factor" STRING "22"
            ^"Level Cost" STRING "65"
            ^"Principle" STRING "Youth"
            ^"Printed Stat Line" STRING "R: Per, D: 19 Years, T: Ind Corpus, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 22 Level Cost: 65 Principle: Youth"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "One of the most powerful hymns of Apollo Phoebus, this Power allows the hymnist to ignore the debilitating effects of aging for the duration of the power, up to and including terminal Aging Crises. This, of course, inflicts 1 Warping Point per year of its effect, and aging continues normally once the Power wears off (i.e., as though the character did not age for the duration)."
    }

    #tb86de2242cb98a161bd145 ^"Thalia’s Relief" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Semesilam"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1 use/day"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun)"
            ^"Ease Factor" STRING "5"
            ^"Level Cost" STRING "15"
            ^"Principle" STRING "Optimism"
            ^"Printed Stat Line" STRING "R: Touch, D: Sun, T: Ind Mentem, Pen +0, 1 use/day"
            ^"Printed Totals" STRING "Ease Factor: 5 Level Cost: 15 Principle: Optimism"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Thalia is the Muse of comedy, and this Power relieves the touched character’s worry, anxiety, or grief, filling him with good cheer and delight."
    }

    #ta314cb1627106662be1e3c ^"Divination of True Intent" DEF {
        EXTENDS #tac091134aaa59eca4f6f30 ^"Hymn Power"
        PROPERTIES {
            ^"Hymn" STRING "Semesilam"
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Forms" LIST OF STRING ["Mentem"]
            ^"Penetration" STRING "+4"
            ^"Uses" STRING "6 uses/day"
            ^"Effect Design" STRING "(Base 15, +1 Eye, +2 levels for Penetration, +3 uses/day)"
            ^"Ease Factor" STRING "9"
            ^"Level Cost" STRING "25"
            ^"Principle" STRING "Justice"
            ^"Printed Stat Line" STRING "R: Eye, D: Mom, T: Ind Mentem, Pen +4, 6 uses/day"
            ^"Printed Totals" STRING "Ease Factor: 9 Level Cost: 25 Principle: Justice"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Your character may divine the true intent of a single action or thought of the target. This is done by asking the storyguide a question as to the truth or sincerity of the target, who remains oblivious to the use of this Power unless it fails to penetrate her Magic Resistance (although she almost certainly notices the character’s praying or singing, and eye contact). Note that this only detects what the target believes, and so may be inaccurate."
    }

