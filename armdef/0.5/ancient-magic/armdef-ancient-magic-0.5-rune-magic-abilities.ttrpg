EXTENSION "ARMDef_Ancient_Magic_RuneMagic_Abilities" {
    NAME "Ars Magica Fifth Edition, Ancient Magic - Chapter Nine: Rune Magic abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Ancient_Magic_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #tfae223a535544c6d7835b1 ^"Rune Magic" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "New Ability: Rune Magic"
            ^"Source" STRING "Ancient Magic"
            ^"Page" INTEGER 140
        }
        DESCRIPTION "This is the rune wizards’ version of Magic Theory. It is knowledge of what the magic of the runes is and how it works, dealing with the symbolism of each rune, how they may be used, how to formulate a rune-script, and how to encrypt the runes so that they are harder for others to recognize. Without The Gift it has few practical applications, though like Magic Theory, a basic understanding is essential for accurately copying books on Rune Magic. **Specialties:** hiding runes, identifying rune magic, runes associated with a particular Art. (Arcane)"
    }

}
