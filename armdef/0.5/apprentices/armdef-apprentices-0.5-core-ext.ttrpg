EXTENSION "ARMDef_Apprentices_Core_Ext" {
    NAME "Ars Magica Fifth Edition, Apprentices - core type extensions"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-31"
    DEPENDS_ON "ARMDef_Core_Base"

    # Apprentices is an EXTENSION on the arm5e edition, loaded alongside the core
    # rulebook (spec S13 composition). Most Virtues and Flaws fit the core
    # ^"Virtue"/^"Flaw" unchanged; narrative goes to .lore and tables are structured
    # TABLE DEFs. Only the two types below are new.

    # Child Virtues and Flaws are, in the source's words, "a new type of Virtue and
    # Flaw that reflects childhood boons and banes that are outgrown by adulthood." A
    # Child Virtue or Flaw must CHANGE during one of the Transitions of Maturation
    # (there is no set pattern for how it changes -- the troupe decides). Modeled as a
    # subtype of the core type so the record set is queryable as its own kind (owner
    # decision 2026-07-31); Size/Category/Source are inherited from the core type.
    #t7e05ec135cc702a13f7d78 ^"Child Virtue" DEF {
        EXTENDS ^"Virtue"
    }

    #t5386d466ee3d995fa32246 ^"Child Flaw" DEF {
        EXTENDS ^"Flaw"
    }

    # ------------------------------------------ Young Character Creation
    # Chapter Two's build budget for characters created younger than adult. The
    # narrative procedure is verbatim in
    # armdef-apprentices-0.5-creating-young-characters.lore; the determinate numbers
    # are ALSO recorded here (double-capture, as with Faerie Character Creation) so a
    # character-creation tool reads the budget without re-parsing prose. The age-based
    # Characteristic/Size penalties are the ^"Aging Chart" TABLE (…-tables.ttrpg).
    # Owner decision 2026-07-31; no numbers invented.
    #tyng5c4ch8crea70nbudg001 ^"Young Character Creation" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Characteristic Points" INTEGER 7 FIXED
            ^"XP Per Year" INTEGER 15 FIXED
            ^"XP Per Year Wealthy" INTEGER 20 FIXED
            ^"XP Per Year Poor" INTEGER 10 FIXED
            ^"XP Start Age" INTEGER 5 FIXED
            ^"Ability Max Score" INTEGER 5 FIXED
            ^"Grog Virtue Flaw Points" INTEGER 3 FIXED
            ^"Companion Virtue Flaw Points" INTEGER 10 FIXED
            ^"Child Virtue Flaw Max Age" INTEGER 20 FIXED
            ^"Apprenticeship Years" INTEGER 15 FIXED
            ^"Apprenticeship XP" INTEGER 240 FIXED
            ^"Apprenticeship Spell Levels" INTEGER 120 FIXED
            ^"Apprenticeship XP Per Year Early" INTEGER 19 FIXED
            ^"Apprenticeship XP Per Year Late" INTEGER 46 FIXED
            ^"Transition Ages" STRING "8, 15, 21"
            ^"Source" STRING "Apprentices"
            ^"Page" INTEGER 7
        }
        DESCRIPTION "Younger characters have 7 points allocated toward Characteristics, with Virtues and Flaws adding or subtracting points from that total. A score of 0 represents an average Characteristic for the character’s age group. Characteristics for young characters are negatively adjusted because of age; use the Aging Chart to determine a character’s Characteristic Modifier and Size Modifier. Young grogs can have up to three points of Virtues and Flaws, and young companions and apprentices can have up to ten. At character generation, the number of Virtues must equal the number of Flaws (the exception is an apprentice who has acquired the Free House Virtue). Each character gains a number of experience points for Abilities depending on the character’s starting age. After 5 years of age, the character gains 15 experience points a year; those with the Wealthy Virtue receive 20 experience points per year, and a character with the Poor Flaw receives 10. Young characters have a maximum Ability score of 5; Hermetic Arts are not limited by age. For a standard apprenticeship, the player receives 240 experience points to spend on Abilities and Arts, and 120 levels of spells, over 15 years. There are three Transitions of Maturation — between ages 7 and 8, between 14 and 15, and at 21 — during which the player may change Virtues and Flaws of equal value; Child Virtues and Flaws must be changed by the final transition. Only magus and companion characters may take Inherited Virtues and Flaws."
    }
}
