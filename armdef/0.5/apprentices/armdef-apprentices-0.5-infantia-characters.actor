EXTENSION "ARMDef_Apprentices_Infantia_Characters" {
    NAME "Ars Magica Fifth Edition, Apprentices - Chapter Three: Infantia named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-31"
    DEPENDS_ON "ARMDef_Apprentices_Core_Ext"

    # The chapter's three statted example children, one DEF each (a single named
    # character belongs in a .actor file). Every stat line is a verbatim typed field
    # off the source's own **Label:** markers; Combat is printed malformed as
    # '**Combat:*' and normalised before the run-in split. Text after Appearance is
    # the character's narrative -> DESCRIPTION.

    #tf97db625a5ee918137d211 ^"Companion: Noble Child" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per –1, Pre 0, Com –3, Str +1, Sta +2, Dex +3, Qik +2 (–4 Characteristic modifier due to age)"
            ^"Size" STRING "–2"
            ^"Age" STRING "6 (6)"
            ^"Confidence Score" STRING "1 (5)"
            ^"Virtues and Flaws" STRING "Son of Landed Noble; Death Prophecy; Inherited Great Dexterity, Inherited Skinchanger, Improved Characteristics (x2); Feud, Know-It-All (major); Ability Block (Academic), Poor Hearing, Poor Student, Reckless"
            ^"Personality Trait" STRING "Know-It-All +3, Reckless +3, Brave +2"
            ^"Combat" STRING "Dodge: *Init –2, Attack n/a, Defense +0, Damage n/a *Kick: *Init –3, Attack +2, Defense +0, Damage +0 *Kick, Mounted:* Init –3, Attack +4, Defense +2, Damage +0"
            ^"Soak" STRING "–2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Athletics 2 (running), Brawl 2 (kick), Native Language 5 (courtly terms), Ride 2 (galloping), Swim 2 (diving)"
            ^"Equipment" STRING "Good clothes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The noble’s son is a richly clad, clean scrubbed boy of average height and weight. He has a devilish look in his eye, a hint at the trouble to come."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The noble’s son is a handful. It was prophesied at birth that he would die by fire, and he has led a reckless life. He has learned to ride from his father’s grooms and is a proficient horseman. The character has two inherited Virtues, Skinchanger and Great Dexterity, that will manifest in the future.\n\nThis character also uses the Athletic Childhood given earlier as a starting base."
    }

    #td2f8492297c91f8a5d2771 ^"Apprentice: Foundling Child" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +3, Per 0, Pre +1, Com +2, Str 0, Sta +1, Dex –2, Qik –1 (–4 Characteristic modifier due to age)"
            ^"Size" STRING "–2"
            ^"Age" STRING "7 (7)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Orphan; Inherited Flexible Formulaic Magic; Book Learner, Puissant Latin, Sense Holiness and Unholiness; Blatant Gift, Plagued by Supernatural Entity"
            ^"Personality Trait" STRING "Outspoken +3, Brave +1, Devoted +1"
            ^"Combat" STRING "Dodge:* Init –5, Attack n/a, Defense –4, Damage n/a"
            ^"Soak" STRING "–3"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Artes Liberales 1 (psalms), Brawl 1 (dodge), Charm 2 (clergy), Church Lore 2 (religious holidays), Folk Ken 2 (clergy), Guile 2 (lying to superiors), Latin 1 (church usage), Native Language 5 (Bible quotes), Sense Holiness and Unholiness 1 (good)"
            ^"Equipment" STRING "Homespun tunic and wool leggings."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The foundling looks like an ordinary child wearing simple, clean clothing. While he isn’t particularly ugly, many folks think he is due to the child’s Blatant Gift."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The foundling was deposited on the priest’s doorstep mere days after his birth. The kindly priest raised the boy, despite the child’s Blatant Gift, viewing it as an act of Christian charity. Because of the foundling’s adoptive father’s profession, the character is allowed to put starting experience points in Artes Liberales and Latin.\n\nThe foundling has a knack for books and reading, making him an ideal future apprentice. As of yet, he hasn’t been noticed by the Order of Hermes.\n\nThe foundling used the Social Childhood as a starting base. He has an Inherited Hermetic Virtue, which means that Flexible Formulaic Magic will materialize sometime during apprenticeship. Further, it supposes that the character will eventually be found and trained by a magus. The character can still learn other Hermetic Virtues (see the next chapter), but does not have to use that system for acquiring the preselected Inherited Virtue."
    }

    #tf58a6a9d1229e6e712f329 ^"Grog: Blacksmith’s Son" DEF {
        EXTENDS ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per –1, Pre –1, Com –1, Str +3, Sta +2, Dex +2, Qik –2 (–4 Characteristic modifier due to age)"
            ^"Size" STRING "–2"
            ^"Age" STRING "7 (7)"
            ^"Virtues and Flaws" STRING "Son of Craftsman; Intuition, Puissant Craft: Blacksmith, Magic Sensitivity; Bully, No Sense of Direction, Slow Reflexes"
            ^"Personality Trait" STRING "Bully +3, Brave +2, Loyal +1"
            ^"Combat" STRING "Dodge:* Init –6, Attack n/a, Defense –4, Damage n/a *Fist:* Init –6, Attack +1, Defense –3, Damage –1"
            ^"Soak" STRING "–2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–3), –3 (4–6), –5 (7–9), Incapacitated (10–12), Dead (13+)"
            ^"Abilities" STRING "Area Lore 1 (hidden places), Athletics 2 (running), Brawl 2 (fist), Charm 1 (mothers), Craft: Blacksmith 2 + 2 (small items), Folk Ken 1 (parents), Magic Sensitivity 1 (auras), Native Language 5 (rhyming slang), Swim 2 (ponds)"
            ^"Equipment" STRING "Clothing similar to his father’s: homespun shirt and trousers, leather apron."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "A broad-shouldered boy with blue eyes and a gaptoothed sneer."
            ^"Source" STRING "Apprentices"
        }
        DESCRIPTION "The blacksmith’s son is a bully. He is stronger than his peers and knows it. He is not looking forward to a life spent as a blacksmith in the village, which might explain why he bullies the other children. His Magic Sensitivity inexplicably draws him toward magic regiones and auras, and his No Sense of Direction means that he invariably can’t find his way home.\n\nThis character uses the Athletic Childhood as a starting base."
    }

}
