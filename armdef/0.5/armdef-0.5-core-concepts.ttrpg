BASE "ARMDef_Core_Concepts" {
    NAME "Ars Magica Definitive Edition - named concepts referenced across the corpus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-29"
    DEPENDS_ON "ARMDef_Core_Base"

    # WHY THIS FILE EXISTS
    #
    # ArMDef covers these concepts in its NARRATIVE files, and a .lore file
    # contributes only its own basename to the corpus entity set -- its internal
    # section headings never resolve as named entities. So a cross-reference to
    # ^"Mythic Europe" has nothing to land on, even though ArMDef devotes a
    # chapter to it. The re-targeted Fifth Edition sourcebooks make 88 such
    # references between them.
    #
    # Each DEF here is an ANCHOR for a concept ArMDef already has, and its
    # DESCRIPTION is ArMDef's OWN opening definition of that concept, quoted from
    # ArMDef's own .lore. Nothing is taken from the sourcebooks, and nothing is
    # written fresh -- the owner's constraint, and the right one: the sourcebooks
    # are Fifth Edition products and their words do not belong in this edition.
    #
    # These are deliberately thin. The chapter remains the real treatment; this is
    # the handle a reference can hold, mirroring the narrative rather than
    # duplicating it.

    # armdef-0.5-mythic-europe.lore :: "XIV. Mythic Europe" -- 60 references
    #tARMDefConceptMythicEurope ^"Mythic Europe" DEF {
        PROPERTIES {
            ^"Treated In" STRING "armdef-0.5-mythic-europe.lore"
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "The official setting for **Ars ** **Magica** is Mythic Europe, a world very like the Middle Ages of our world, but with magic. For many people, this setting is a large part of the fun of the game. You can 'change history', or at least 'visit' historical places. When you save a country from demons, you've saved France, not some imaginary land. It's also possible to actually visit the place where your saga is set, although that's easier for European players."
    }

    # armdef-0.5-order-history.lore :: "II.The Order of Hermes" -- 28 references
    #tARMDefConceptOrderOfHermes ^"Order of Hermes" DEF {
        PROPERTIES {
            ^"Treated In" STRING "armdef-0.5-order-history.lore"
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "The Order of Hermes is an organization of magi that spans the whole of Mythic Europe, even reaching some distance beyond. It has about 1200 members, living in thirteen Tribunals which divide up the continent. In the Magical Realm, no single group can even think to challenge the Order as a whole, but the power of God is far beyond even Hermetic magi. This chapter lays out the history and current state of the Order of Hermes, to which **Ars Magica** characters are almost all affiliated in some way."
    }

    # ── The owner's rulings, 2026-07-29 ────────────────────────────────────────
    # Six of the remaining concepts resolved to records ArMDef ALREADY declares
    # under another name, and those are re-pointed by the transformer rather than
    # redeclared here (^"The Divine" -> ^"The Divine Realm", ^"The Infernal" ->
    # ^"The Infernal Realm", ^"Aging Points" and ^"Aging Rolls" -> ^"Aging",
    # ^"Damage Table" -> the merged record). The rest are declared below.

    # A stub, at the owner's direction. ArMDef devotes a whole chapter to
    # Hermetic magic but declares no record for the concept itself, and its only
    # passage under that heading is a vignette rather than a definition -- so the
    # DESCRIPTION here is an editorial anchor note, NOT quoted rules text, and
    # says so. 18 references, from six of the nine sourcebooks.
    #tARMDefConceptHermeticMagic ^"Hermetic Magic" DEF {
        PROPERTIES {
            ^"Treated In" STRING "armdef-0.5-hermetic-magic.ttrpg"
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "Anchor for the magic practised by the members of the Order of Hermes. ArMDef treats it in full in its Hermetic Magic chapter; this record exists so that cross-references to the concept resolve."
    }

    # ArMDef states the Lab Total inside ^"Basic Laboratory Activities", which is
    # scoped to a Laboratory rather than to the sum itself. The sum is referenced
    # on its own 12 times, so it gets its own record -- ArMDef's own words and
    # ArMDef's own formula, lifted from that record, not rewritten.
    #tARMDefConceptLabTotal ^"Lab Total" DEF {
        APPLIES TO [^"Magus"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        FORMULAS {
            "YOUR BASIC LAB TOTAL IS" "Technique + Form + Intelligence + Magic Theory + Aura Modifier"
        }
        DESCRIPTION "You use one sum, called the Lab Total, frequently in calculating your ability to accomplish various laboratory tasks."
    }

    # Separate from ^"Lab Texts (Build Points)", at the owner's direction: that
    # record is the COST of stocking a covenant's library, this one is the thing
    # itself. Build Points may be spent on Lab Texts; they are not the same record.
    #tARMDefConceptLabTexts ^"Lab Texts" DEF {
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "Anchor for lab texts themselves -- the written record of a magus's laboratory work, which allows another magus to repeat it far more quickly. Their cost as a covenant's starting resource is the separate ^\"Lab Texts (Build Points)\" record."
        REFERENCES {
            "Lab Texts (Build Points)" -> ^"Lab Texts (Build Points)"
        }
    }

    # The paired Arts of a Hermetic spell. ArMDef declares ^"Hermetic Technique"
    # and ^"Hermetic Form" separately; the sourcebooks reference the pair as one
    # concept when naming what a spell is built from.
    #tARMDefConceptTechniqueForm ^"Technique and Form" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "Anchor for the paired Arts that define a Hermetic spell -- its Technique and its Form. ArMDef declares each separately as ^\"Hermetic Technique\" and ^\"Hermetic Art\"."
    }

    # armdef-0.5-mythic-europe.lore :: "Sacraments" -- ArMDef's own sentence.
    #tARMDefConceptExtremeUnction ^"Extreme Unction" DEF {
        PROPERTIES {
            ^"Treated In" STRING "armdef-0.5-mythic-europe.lore"
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "Extreme Unction is the final sacrament, given just before death. For this reason, it draws the most ambiguous attitude of any sacrament. While it is generally believed to ease the passage to heaven, many people believe that, if you have received it, you are dead to the world in some sense, and must enter a monastery if you recover."
    }

    # From the printed ArMDef core table the owner supplied (pp.178-180 / p405).
    # ArMDef's own content, not the sourcebooks'.
    #tARMDefConceptWoundRecovery ^"Wound Recovery Table" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Table Columns" LIST ["Wound Level", "Interval", "Stable Ease Factor", "Improvement Ease Factor"]
            ^"Source" STRING DEFAULT "Core Rules"
        }
        FORMULAS {
            "RECOVERY TOTAL" "Stamina + Medic's Chirurgy or Medicine score + Magical Aid + Stress Die"
        }
        TABLE {
            "Light" "One week" "4" "10"
            "Medium" "One month" "6" "12"
            "Heavy" "One season" "9" "15"
            "Incapacitated" "See below" "" ""
        }
        DESCRIPTION "Roll interval determined by wound severity. Equal or Exceed Improvement Ease Factor: Wound improves by one level. Equal or Exceed Stable Ease Factor: Wound remains at same level, +3 bonus to future rolls. Below Stable Ease Factor: Wound becomes one level worse. Characters recover from all their wounds at the same time."
    }

    # Distinct from ^"Laboratory", at the owner's direction: the laboratory is the
    # place, this is a season's work done in one. ArMDef's ^"Basic Laboratory
    # Activities" enumerates them; this is the type they are instances of.
    #tARMDefConceptLabActivity ^"Laboratory Activity" DEF {
        APPLIES TO [^"Laboratory"]
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "Anchor for an activity a magus performs using a laboratory, as distinct from the laboratory itself. ArMDef enumerates the basic set in ^\"Basic Laboratory Activities\"."
    }

    # EXTENDS ArMDef's own ^"Animal Companion", at the owner's direction.
    #tARMDefConceptMagicalAnimalComp ^"Magical Animal Companion" DEF {
        EXTENDS ^"Animal Companion"
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "An animal companion that is itself a creature of the Magic Realm."
    }

    # The owner's read: this is new in Grogs rather than inherited from core. It is
    # declared here because ArMDef is what the re-targeted book now builds on, and
    # a reference has to land somewhere -- but WHERE it belongs is flagged in
    # ARMDEF-RETARGET-findings.md, because a Grogs-only rule arguably belongs in
    # the Grogs corpus, not in ArMDef core.
    # Owner's ruling, 2026-07-29: make it an extends. A Personality Roll is built
    # on a Personality Trait, so it EXTENDS ArMDef's ^"Personality Trait" rather
    # than standing as a bare ^"Character" anchor.
    #tARMDefConceptPersonalityRolls ^"Personality Rolls" DEF {
        EXTENDS ^"Personality Trait"
        PROPERTIES {
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "A roll made against a Personality Trait to determine how a character behaves."
    }

    # A story genre ArMDef treats in armdef-0.5-stories.lore :: "Exploration".
    # ArMDef declares no story-genre records, so House Grogs' `MODIFY ^"Exploration"`
    # (which adds its own Grogs Story Genre note) had nothing to resolve against --
    # the one remaining validator error. Declared here from ArMDef's OWN lore text,
    # the same concept-anchor pattern as ^"Mythic Europe"; the Grogs MODIFY then
    # augments it. Not taken from the Grogs sourcebook.
    #tARMDefConceptExploration ^"Exploration" DEF {
        APPLIES TO [^"Character"]
        PROPERTIES {
            ^"Treated In" STRING "armdef-0.5-stories.lore"
            ^"Source" STRING DEFAULT "Core Rules"
        }
        DESCRIPTION "The characters go somewhere they haven't been before, and find out about it. This covers going into caves, killing monsters, and taking their stuff, but it is much broader. It also includes traveling to the local abbey and trying to set up good relations with the abbot, finding a faerie forest and learning how to collect raw vis there, and even visiting other covenants of the Order for the first time."
    }
}
