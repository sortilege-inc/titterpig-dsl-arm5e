EXTENSION "ARMDef_Art_Academe_ArtesLiberales_Spells" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Two: Artes Liberales spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_Art_Academe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t3f6cbf08dbd2ee60d35eeb ^"Hearing the Silent Chorus" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Hearing"
            ^"Printed Stat Line" STRING "Intellego Imaginem 15 R: Per, D: Conc, T: Hearing"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This spell allows the recipient to barely hear the unheard sounds of the planetary orbits. Interpreting the sounds depends upon the listener, whose player makes an Intelligence + Artes Liberales + stress die roll against an Ease Factor of 12. If successful, the player gains a +3 to the next astrology roll her character makes, or +3 to the next song the character composes. If the roll botches, the listener gains a Warping Point per zero on the botch dice. This spell only affects the specified astrology activity or song composition once; repeated castings for that activity are not effective.\n\n(Base 3, +1 Conc, +3 Hearing,)"
    }

}
