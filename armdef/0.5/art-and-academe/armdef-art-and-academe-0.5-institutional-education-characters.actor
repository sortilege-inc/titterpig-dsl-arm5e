EXTENSION "ARMDef_Art_Academe_InstitutionalEducation_Characters" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Six: Institutional Education named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_Art_Academe_Core_Ext"

    # Statted characters, one DEF each. Every stat line is a verbatim typed field off the
    # source's **Label:** markers; text after Appearance is the character's narrative -> DESCRIPTION.

    #te1d94aa10b4c306082ed36 ^"Brother Julian" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +2, Per +2, Pre +1, Com +3, Str –4, Sta +2, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "20 (20)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Mendicant Friar; True Faith; Academic Concentration (rhetoric), Aristotelian Training, Clear Thinker, Educated, Improved Characteristics, Strong-Willed; Driven (knowledge), Monastic Vows; Fragile Constitution, Hunchback, Lame, Poor Strength"
            ^"Personality Trait" STRING "Driven +3, Boisterous +2, Polite +1"
            ^"Combat" STRING "Dodge: Init –1, Attack n/a, Defense –1, Damage n/a Fist: Init –1, Attack +2, Defense +2, Damage –4"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 2 (rhetoric), Athletics 2 (running), Awareness 2 (searching), Brawl 2 (fist), Church Lore 2 (offices), French 5 (directions), Folk Ken 3 (peasants), Greek 2 (rhetoric), Languedoc Lore 2 (geography), Latin 4 (church ceremonies), Medicine 2 (anatomy), Occitan 3 (directions), Philosophiae 2 (moral philosophy), Preaching 3 (charity), Teaching 2 (rhetoric), Theology 3 (heresy)"
            ^"Equipment" STRING "Monk’s habit, sandals, walking stick"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Hook-nosed and hunchbacked, Brother Julian is an ominous figure. Draped in his black habit and clutching a walking stick, he casts a fearsome appearance despite his young age."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Born deformed, Brother Julian was given to a Benedictine abbey to be raised. He proved an able student, with a sharp mind and a natural inclination for rhetoric. A rambunctious youth, Julian flew from text to text as quickly as the preceptor would allow him. Devouring the academic learning at hand, he craved more than the monastery could provide. Because of this appetite, his abbot allowed him to leave the monastery and join Dominic’s burgeoning Order of Preachers.\n\nBrother Julian has spent the last two years wandering the roads of Languedoc, traveling with his brothers and preaching against heresy. While a reasonable preacher in central France, Julian’s Occitan is too poor to effectively preach in Languedoc. He hopes to improve his language skills as he travels. Currently, he preaches in central southern France to stem the spread of the Cathar heresy.\n\nJulian’s desire for knowledge is insatiable, and he desperately desires to attend a cathedral school or, better yet, the University of Paris. To improve his chances, he wishes to write, knowing that authorship will improve his reputation with his superiors. This is impossible on the road, and Julian would like to find someplace where he could spend a season or two and be allowed to write tractatus.\n\nBrother Julian can be used as a starting companion-level character."
    }

}
