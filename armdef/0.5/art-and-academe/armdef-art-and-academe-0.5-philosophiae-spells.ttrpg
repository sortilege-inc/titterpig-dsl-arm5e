EXTENSION "ARMDef_Art_Academe_Philosophiae_Spells" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Three: Philosophiae spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_Art_Academe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t551b56ccaa336f850c56a5 ^"Look at Me" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrMe 15 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "This spell creates a thought in the imagination of the target, causing him to look directly at the caster even if the caster has not been previously noticed by the target. This glance is sufficient to make eye contact. If concentrating on another task, the target may make a Stamina + Concentration roll against an Ease Factor of 6 to resist. This spell is most often cast with no voice or gestures as a subtle way of attracting someone’s attention.\n\n(Base 4, +3 Sight)"
    }

    #t6d3a88bd418df7411b951c ^"Human Figment of the Waking Mind" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrMe 25 R: Eye, D: Conc, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 32
        }
        DESCRIPTION "This spell places a hallucinatory person in the mind of another through the common sense. No one else can see or hear the person seen and heard by the target. The caster determines what the hallucination looks like, and can cause it to act in the way he wishes by concentrating. He cannot, however, see it himself.\n\n(Base 3, +1 Eye, +1 Conc, +1 for two sensory species, +2 move at command, +1 intricacy)"
    }

    #t220ea42ed6aa3f9e15c629 ^"Borrow the Eyes of Another" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InMe 30 R: Arc; D: Conc; T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The caster can see through the eyes of another person to whom he has an Arcane Connection. It must penetrate any Magic Resistance of the target.\n\n(Base 5, +4 Arc, +1 Conc)"
    }

    #taead8f9b790f49d11b9298 ^"Distraction of the Magpie" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 10 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The target’s estimation is altered so that shiny objects become highly desirous to him. For the duration of the spell he is easily distracted by anything that glints, and given the opportunity he will acquire such things and secret them somewhere about his person. He must make an Intelligence + Concentration roll against an Ease Factor of 9 to complete a complex task in the presence of a shiny object that he does not yet possess.\n\n(Base 3, +1 Eye, +2 Sun)"
    }

    #t668c07c44b2a1bf1bb47fb ^"Lost in the Memory" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 35 R: Eye, D: Moon, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The mind of the target is filled with memory, dominating all other mental faculties. He will relive scenes from his past and visit places of particular significance while neglecting all but the basic urges to eat, drink, and rest. During this time he cannot put any mental effort into any task, and can only be temporarily roused from his fugue if he succeeds in an Intelligence + Concentration roll of 9 or more.\n\n(Base 15, +1 Eye, +3 Moon)"
    }

    #ta6c6e445ab9a23074e05c0 ^"Rewriting the Mind" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuMe 45 R: Voice, D: Year, T: Ind, Ritual"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "This spell utterly changes the target’s capacity for cognitive thought; all previous goals, hopes and desires are set aside in favor of the agenda dictated by the magus at the time of casting this spell. For the Duration of the spell the target is unusually single-minded in pursuing his new goals, but still has command of his other mental faculties. This spell incurs Warping as a constant effect of high power.\n\n(Base 15, +2 Voice, +4 Year)"
    }

    #tf604375191c6f51895dcf5 ^"The Stultified Peasant" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeMe 30 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The target has all ability to think removed; his imagination (which controls thinking) is destroyed, causing him to stand, mouth open, until the spell ends. Only his imagination is affected, so he acts according to his estimation if threatened.\n\n(Base 15, +1 Eye, +2 Sun)"
    }

    #t3a7a6b4d7d3f2d47d9f401 ^"The Ever-Watchful Turb" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeMe 35 R: Touch, D: Moon, T: Group"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This spell prevents the target group from falling asleep by quelling the inclination to rest when tiredness sets in. The target group accrues fatigue as usual: after being awake for a full day, every eight hours of wakefulness causes the loss of a Fatigue level. Thus, after two days awake, they will be reduced to Unconscious (or earlier if they exert themselves) at which time they sleep for eight hours and then wake again.\n\n(Base 5, +1 Touch, +3 Moon, +2 Group)"
    }

    #tdf296005c44f45e7739cdd ^"The Clean Slate" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeMe 50 R: Touch, D: Year, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This spell wipes the memory of the target clean, removing every stored idea and sense of identity he possesses. All general Abilities (including Languages) are retained, but knowledge of Academic, Arcane, Martial and Supernatural Abilities are lost, as are all Arts. His imagination, which stores images, is not affected, so he recognizes the faces of people he knows, places he has been, and songs he has heard, but lacks all knowledge about those things such as names, locations, emotional importance, and so forth. He cannot relearn those memories for the duration of the spell.\n\n(Base 25, +1 Touch, +4 Year)"
    }

    #t4cf4d3d0ca97dda56cc49b ^"Call the Dream" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 20 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "The caster touches a sleeping person and determines the theme for that night’s dreaming. The actual content of the dream cannot be determined. For example, if the theme is “death” the target might dream about the death of a loved one, or the life-threatening circumstances he has been in. If the theme is “dogs” he might dream of a beloved childhood pet or being hunted by the lord’s hounds. Some magi try to interpret the meaning of the dreams called by this spell.\n\n(Base 5, +1 Touch, +2 Sun)"
    }

    #t2099a019ab71c702a3ba3b ^"Searching the Haystack for a Needle" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 20 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "The target of this spell gets a +3 to all sight-based Perception rolls involving a specific object or quality defined at the time of casting. Examples might include the color red, a particular person, or a unusually shaped shell. Magi often employ this spell to help their servants locate a particular type of vis, as long as they have a sample to show the servant. It does not give the target any extra senses, just more sensitivity to a particular visual characteristic.\n\n(Base 5, +1 Eye, +2 Sun)"
    }

    #ted9668314ad32828b55fb6 ^"Singlemindedness of the Concentrating Wizard" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 25 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "The caster receives a +3 to all Concentration rolls for the Duration of this spell, but automatically fails any Intelligence roll which does not involve Concentration.\n\n(Base 15, +2 Sun)"
    }

    #tfdc08972b1fe54979a1ad9 ^"Plague of Frogs" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "Rego Animal 20 R: Touch, D: Mom, T: Group"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "A swarm of frogs spontaneously generates in a pool of water touched by the caster. A pool five paces across and two paces deep can produce one thousand frogs; for every ten-fold increase in volume, ten times as many frogs are produced up to a maximum of 20,000 (which is a mass of frogs equal to that of ten pigs). Likewise, a smaller pool produces fewer frogs: a pool one tenth the size produces a hundred frogs, and one that is a hundredth of the size (about one pace across and half a pace deep) spawns just 10 frogs. The water in the pool is not diminished by this spell.\n\n(Base 5, +1 Touch, +2 Group)"
    }

    #t92b8e79a835d8564ba50b9 ^"The Verminous Infestation" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Perdo, Corpus"
            ^"Printed Stat Line" STRING "Rego Animal 20 R: Eye, D: Mom, T: Ind Req: Perdo, Corpus"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "The target of this spell is infested with fleshworms, which set up residence in his intestines. The victim immediately acquires Worms, as described in Chapter Four: Medicine, Disease, except that the symptoms occur immediately.\n\n(Base 5, +1 Eye, +1 Perdo requisite, +1 Corpus requisite)"
    }

    #t8cc912499d4dbde4ebdc4d ^"A Moment’s Reflection" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrMe 20 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "This spell removes the Obsession Personality Trait imposed by a demon’s obsession power.\n\n(Base 10, +2 Voice)"
    }

}
