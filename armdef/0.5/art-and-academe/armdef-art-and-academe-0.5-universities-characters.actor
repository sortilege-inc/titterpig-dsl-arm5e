EXTENSION "ARMDef_Art_Academe_Universities_Characters" {
    NAME "Ars Magica Fifth Edition, Art & Academe - Chapter Seven: Universities named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_Art_Academe_Core_Ext"

    # Statted characters, one DEF each. Every stat line is a verbatim typed field off the
    # source's **Label:** markers; text after Appearance is the character's narrative -> DESCRIPTION.

    #t5ede7f7993f147faac66c1 ^"Gilpatrick" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +2, Per +1, Pre -1, Com +2, Str +1, Sta 0, Dex 0 Qik 0"
            ^"Size" STRING "-1"
            ^"Age" STRING "19 (19)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Baccalaureus; Entrancement; Book Learner, Intuition, Latent Magic Ability; Favors, Overconfident; Small Frame"
            ^"Personality Trait" STRING "Overconfident +3, Chatty +2, Self-obsessed +2"
            ^"Reputations" STRING "Good Astronomer 1 (academic)"
            ^"Combat" STRING "Dodge: Init +0, Attack n/a, Defense +0, Damage n/a"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16), Dead (17+)"
            ^"Abilities" STRING "Arabic 2 (astronomical terms), Artes Liberales 3 (astronomy), Athletics 2 (contortions), Awareness 1 (alertness), Bargain 2 (writing supplies), Charm 2 (flattery), English 3 (slang), Entrancement 3 (social equals), Folk Ken 1 (clergy), French 4 (slang), Greek 3 (mathematical terms), Irish 5 (slang), Latin 5 (academic usage), Swim 1 (long distances), Theology 3 (ontological arguments)"
            ^"Equipment" STRING "Scholar’s robes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Gilpatrick has blue eyes, ruddy cheeks, and dark hair poking out of the hood of his scholastic robes. He is short with a slight build."
            ^"Source" STRING "Art & Academe"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "Gilpatrick is an Irish-born student studying at the University of Paris. He is indebted to the bishop of Dublin for his initial scholastic placement, a debt he has yet to repay. He has used his Entrancement Ability to his advantage, finding cheap housing, a master, and securing school supplies. Unfortunately, he can’t use it in disputationes, which are as difficult as combat for those who want to look someone in the eye. He has studied for three years at the university and (barely) received his baccalaureate license. Presently, he is preparing to enter the Faculty of Theology.\n\nGilpatrick is never at a loss to talk about himself. He loves the university environment, both the learning and the wilder side of student life. His overconfidence has led him to some of Paris’ seedier drinking establishments, where he has heard rumors of an order of “philosophers,” men and women who can manipulate reality at their whim. He would be very interested in meeting such a person.\n\nGilpatrick is a companion-level character. He is easily customized for universities other than Paris. If, for example, your saga is set closer to Italy, replace Gilpatrick’s French with Italian, and his Theology with Canon and Civil Law. He also has room for three more points of Virtues and Flaws. He knows the Latin, Greek, and Arabic writing systems."
    }

}
