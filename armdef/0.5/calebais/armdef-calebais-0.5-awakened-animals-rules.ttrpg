EXTENSION "ARMDef_Calebais_AwakenedAnimals_Rules" {
    NAME "Ars Magica Fifth Edition, Calebais - Appendix: Awakened Animals rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t956348ff581a9a4f500760 ^"Awakening Lab Total" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Awakening Lab Total" "Creo + Mentem + Intelligence + Magic Theory + Aura Modifier"
        }
    }

    #t7be7dae5f9bd1cec13e143 ^"Awakening Level" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Awakening Level" "Animal’s Magic Might + 25 + (5 x Size)"
        }
    }

    #t792a1c68975f5539d13ddf ^"Awakening Cost" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Awakening Cost" "1 pawn of Creo or Mentem vis per five levels or fraction"
        }
    }

    #tef3ff9ecbd2d0999cb1624 ^"Power Lab Total" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Power Lab Total" "Technique + Form + Intelligence + Magic Theory + Aura Modifier"
        }
    }

    #t40c39974f20d26669a8a30 ^"Power Level" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Power Level" "as an effect instilled in a device"
        }
    }

    #tec981ecd9b0f16f5daeb97 ^"Power Cost" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Awakening Animals"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 92
        }
        FORMULAS {
            "Power Cost" "1 temporary Might per ten levels or fraction of the effect, minus 1 for every 5 pawns of vis of the effect’s Technique or Form"
        }
    }

}
