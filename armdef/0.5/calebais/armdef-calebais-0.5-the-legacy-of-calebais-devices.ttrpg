EXTENSION "ARMDef_Calebais_TheLegacyOfCalebais_Devices" {
    NAME "Ars Magica Fifth Edition, Calebais - Chapter Three: The Legacy of Calebais devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #ta465e5c27491a38414e50f ^"The Ritual, I" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Effect Design" STRING "InMe30"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "I. Those who wear diadems and who are within the Bell’s boundary will be magically directed towards any people who were not within the boundary during the tuning ritual. They sense a tug in the direction from which strangers approach, and may easily follow this sense to locate them."
    }

    #tcbcabe390d23cf76698061 ^"The Ritual, II" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Effect Design" STRING "ReTe30"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "II. Diadem-wearers may make the Bell ring at will, from any distance. The control is not very fine, and can only be activated once every round, so it is not very useful for sending complex messages. The sound is tuned to match a pitch that corresponds to the wearer, though, so it is possible to recognize who activated it."
    }

    #t39f09bbaeb7f1c2408457f ^"The Ritual, III" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Effect Design" STRING "InVi40"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "III. If any magical creatures or devices which were not within the boundary during the ritual come within a mile of the Bell, it will give a huge, deep toll of warning."
    }

    #t2ec765e5aa060b94dc35be ^"The Ritual, IV" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 20
            ^"Effect Design" STRING "InIm20"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "IV. Those who wear diadems can hear the sound of the Bell ringing, no matter how far the intervening distance."
    }

    #td01e8039b7e01f63fc1b7e ^"The Ritual, V" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Effect Design" STRING "ReMe20"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "V. Those who wear diadems may cast the spell Aura of Rightful Authority three times per day. Doing so causes the Bell to ring very gently at a particular high pitch."
    }

    #tc9dc71c6260ece6f576a1e ^"The Ritual, VI" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Effect Design" STRING "MuMe20"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "VI. While characters wear diadems, their Personality traits associated with the ritual become emphasized, increasing or decreasing by 3. Characters will be compelled to act on these traits as if they were Major Personality Flaws."
    }

    #ta36e81a77d594ff1e18239 ^"The Ritual, VII" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Bell of Ibyn"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Effect Design" STRING "InMe20"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "VII. If anyone who was part of the tuning ritual dies, the Bell will toll twelve times, becoming more and more out of tune as it rings, and it will again cease to function."
    }

}
