EXTENSION "ARMDef_Calebais_TheLegacyOfCalebais_SisterMaloresMute" {
    NAME "Ars Magica Fifth Edition, Calebais - Sister Malores, mute"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # Sister Malores, mute (Chapter Three: The Legacy of Calebais, p84): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t2fff94c900560aa9f3dd24 ^"Sister Malores, mute" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t7116114bca0e93a07cef25 ^"The Convent"]
            ^"Characteristics" STRING "Int -3, Per +3, Pre +4, Com 0, Str -2, Sta 0, Dex +1, Qik -1"
            ^"Age" STRING "55 (29)"
            ^"Personality Trait" STRING "Joyous +5, Curious +3, Distracted +1"
            ^"Appearance" STRING "Malores is lithe and willowy with a vacant and serene expression, and appears about thirty years old, though the nuns all know she has lived at the abbey for at least that long. There is definitely something fay about her, perhaps in her eyes or a slight point to her ears."
            ^"Roleplaying Tips" STRING "Though she cannot talk, she will attempt to communicate through pantomime. Consider this a challenge. Play out her desperation, her sense of being completely lost, and the special quality of innocence she has about her."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "Sister Malores, mute"
    }

}
