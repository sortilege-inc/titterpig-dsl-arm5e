    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # Sister Nadaline, cook (Chapter Three: The Legacy of Calebais, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t2d731d09cb826919dc8ad0 ^"Sister Nadaline, cook" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t7116114bca0e93a07cef25 ^"The Convent"]
            ^"Characteristics" STRING "Int +1, Per +1, Pre -2, Com -2, Str +2, Sta +2, Dex +3, Qik -1"
            ^"Age" STRING "55"
            ^"Personality Trait" STRING "Brave +2, Discerning +2, Patient -3"
            ^"Appearance" STRING "Nadaline is white-haired, wrinkled, with strong blue eyes, hefty build, and an intimidating demeanor. She always seems to have some sort of tool in her hands: a rolling pin, bucket or plucked chicken."
            ^"Roleplaying Tips" STRING "Emphasize her doughty girth and toughness by holding your arms out and squaring your jaw. Expressively wave around whatever she happens to be holding."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Sister Nadaline, cook"
    }

}
