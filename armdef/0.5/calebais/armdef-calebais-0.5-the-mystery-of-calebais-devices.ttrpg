EXTENSION "ARMDef_Calebais_TheMysteryOfCalebais_Devices" {
    NAME "Ars Magica Fifth Edition, Calebais - Chapter One: The Mystery of Calebais devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t1177a2ea8640823578df96 ^"Ash’s cloak (1)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ash’s cloak"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Requisite" STRING "Auram, Ignem"
            ^"Level" INTEGER 14
            ^"Effect Design" STRING "ReAqAuIg Base 1, +1 Touch, +2 Sun, +2 requisites; +4 constant = Level 14"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "**Characteristics:** Int 0, Per +1, Pre -1, Com -2, Str +2, Sta +4, Dex 0, Qik 0 **Age:** 33 **Virtues and Flaws:** Redcap; Dowsing, Wilderness Sense; Enduring Constitution, Great (Stamina), Strong-Willed; Low Self-Esteem; Compulsion (travel), Temperate; Mentor (leader of the Broken Branches); Poor Student, Social Handicap (independent) **Personality Traits:** Independent +3, Respectful +2, Loyal +2 **Combat:** Staff (thorny): Init +0, Attack +7, Defense +11, Damage +8 **Soak:** +4 **Fatigue Levels:** OK, 0, 0, -2, -4, Unconscious **Wound Penalties**: 0 (1-5), -2 (6-10), -4 (11-15), Incapacitated (16-20) **Abilities:** Athletics 3 (walking), Awareness 1, Bargain 4 (services), Brawl 3 (dodging), Carouse 2, Code of Hermes 2 (Redcaps), Dowsing 4 (water), Folk Ken 3, Great Weapon (staff) 5, Local Area Lore (geography) 5, Local Language 5 (directions), Order of Hermes Lore (covenants) 4, Ride 1, Speak Latin 5 (reading messages), Survival 5 (forest), Swim 2 (while burdened) **Equipment:** Ash wears a circular traveler’s cloak fashioned from rough cloth with several magical effects: it protects her from harsh elements"
    }

    #te3ef4feb5bb7ff838a7cc6 ^"Ash’s cloak (2)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ash’s cloak"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Requisite" STRING "Terram"
            ^"Level" INTEGER 9
            ^"Effect Design" STRING "InHeTe Base 1, +1 Touch, +2 Sun, +1 requisite; +4 constant = Level 9"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "makes walking easier by helping her avoid rough ground and snares"
    }

    #t94e7fb6ba5085990692e2c ^"Ash’s cloak (3)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ash’s cloak"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 8
            ^"Effect Design" STRING "CrHe Base 2, +2 Sun; +1 two uses per day, +3 activated by sunrise and sunset = Level 8"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "The cloak also mends any rips or tears it receives"
    }

    #t444dbf1ac9bfa6f9bfba67 ^"Transformation of the Thorny Staff (Calebais)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Transformation of the Thorny Staff"
            ^"Part Of" STRING "Ash’s walking stick"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Effect Design" STRING "MuHe Base 3, +2 Sun = Level 5"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "She carries a walking stick cut from ash, enchanted with *Transformation of the Thorny Staff *"
    }

    #t33fdcaa462341bacedbef3 ^"Shriek of the Impending Shafts (Calebais)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Shriek of the Impending Shafts"
            ^"Part Of" STRING "Ash’s walking stick"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Effect Design" STRING "InHe Base 2, +1 Touch, +2 Sun, +3 Hearing; +4 constant = Level 20"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "*Shriek of the Impending Shafts *"
    }

    #t9f950ce0f690050afde289 ^"Intuition of the Forest (Calebais)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Intuition of the Forest"
            ^"Part Of" STRING "Ash’s walking stick"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Effect Design" STRING "InHe Base 1, +1 Touch, +2 Sun; +1 2x/day = Level 5"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "and a version of *Intuition of the Forest *that affects only her"
    }

    #t3bc5358be87230a92b7d06 ^"Ash’s ring (1)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ash’s ring"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 9
            ^"Effect Design" STRING "MuIm Base 2, +1 Touch, +2 Sun; +4 constant = Level 9"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "Finally, she has a ring that disguises her voice and appearance when worn"
    }

    #t215a235636e90435a2d579 ^"The Veil" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 40
            ^"Effect Design" STRING "ReMe40"
            ^"Location" LIST [#tbf70e9836398bc29478d35 ^"The Marker"]
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 24
        }
        DESCRIPTION "Calebais and the surrouning area are protected against unwanted visitors by a powerful enchantment, similar to the Hermetic spell *The Shrouded Glen*"
    }

}
