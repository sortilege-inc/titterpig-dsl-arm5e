EXTENSION "ARMDef_Calebais_TheMysteryOfCalebais_PaulSirGilbertsSquire" {
    NAME "Ars Magica Fifth Edition, Calebais - Paul, Sir Gilbert’s Squire"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # Paul, Sir Gilbert’s Squire (Chapter One: The Mystery of Calebais, p22): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t7735a84d6d7922c23c64ee ^"Paul, Sir Gilbert’s Squire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t4d3405531e0695c0117ba1 ^"Sir Gilbert’s Camp"]
            ^"Characteristics" STRING "Int +2, Per 0, Pre 0, Com -1, Str +1, Sta +2 Dex 0, Qik +1"
            ^"Age" STRING "15"
            ^"Virtues and Flaws" STRING "Custos; Carefree"
            ^"Personality Trait" STRING "Excited +3, Servile +2, Brave -2"
            ^"Combat" STRING "Long Sword and Heater Shield: Init +1, Attack +8, Defense +12, Damage +9"
            ^"Soak" STRING "+14"
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "Artes Liberales 1 (grammar), Awareness 3 (watching), Athletics 3 (lifting), Brawl 1 (wrestling), Church Lore 2 (politics), Folk Ken 3 (anticipating needs), Latin 1 (formal), Local Language 5 (formal), Ride 1 (long distances), Single Weapon 3 (long sword)"
            ^"Equipment" STRING "Chain hauberk, heater shield, long sword."
            ^"Encumbrance" STRING "2 (3)"
            ^"Appearance" STRING "Paul is a competent young man, not yet sixteen with black curly hair. He tries to be the consummate squire, and is both obsequious and enthusiastic."
            ^"Roleplaying Tips" STRING "Overdo the servility and use your “courtly graces” as much as you can. Try so hard to please others, even when the occasion does not call for it, that you make a mess of things."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Paul, Sir Gilbert’s Squire"
    }

}
