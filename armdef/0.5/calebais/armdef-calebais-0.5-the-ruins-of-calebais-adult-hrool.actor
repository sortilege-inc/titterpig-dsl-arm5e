EXTENSION "ARMDef_Calebais_TheRuinsOfCalebais_AdultHrool" {
    NAME "Ars Magica Fifth Edition, Calebais - Adult Hrool"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # Adult Hrool (Chapter Two: The Ruins of Calebais, p32): one being, its printed stat lines verbatim fields.

    #tbfc532cb9898f3e72c3d4b ^"Adult Hrool" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t5ec6277a332cedb0108847 ^"Calebais"]
            ^"Covenant" LIST [#t3258eeb24aa00a2434f405 ^"Calebais"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 5
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER -2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER -3
            ^"Confidence" STRING "1 (3)"
            ^"Soak" INTEGER 3
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-2), -3 (3-4), -5 (5-6), Incapacitated (7-8)"
            ^"Vis" STRING "1 Animal"
            ^"Appearance" STRING "Adult Hrools look like ferrets or weasels, but larger than normal, alternating between crawling on all fours and walking like humans on their hind legs, and wearing sorry attempts at clothing fashioned from torn cloth and dirty rags. They have an excellent sense of smell and good hearing, often standing still and listening for unusual sounds in the dark corridors."
            ^"Note" STRING "Adult Hrools are used to working in groups, and in combat they can band together under an ermine’s or champion’s leadership, giving up to five of them a +10 bonus, usually to defense."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 32
        }
        PERSONALITY_TRAITS {
            "Curious" +3
            "Tricky" +2
        }
        COMBAT {
            "Bite" INIT 4 ATTACK 5 DEFENSE 5 DAMAGE -1
            " Stone (thrown)" INIT 0 ATTACK 3 DEFENSE 5 DAMAGE 2
        }
        ABILITIES {
            "Animal Handling" SCORE 4 SPECIALTY "rats"
            "Athletics" SCORE 3 SPECIALTY "climbing"
            "Awareness" SCORE 3 SPECIALTY "sentry"
            "Brawl" SCORE 2 SPECIALTY "grapples"
            "Speak Hrool" SCORE 3 SPECIALTY "directions"
            "Swim" SCORE 3 SPECIALTY "diving"
            "Stealth" SCORE 3 SPECIALTY "hide"
            "Thrown Weapons" SCORE 2 SPECIALTY "rocks"
        }
    }

}
