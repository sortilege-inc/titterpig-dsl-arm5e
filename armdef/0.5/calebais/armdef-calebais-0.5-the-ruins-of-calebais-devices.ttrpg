            ^"Level" INTEGER 15
            ^"Effect Design" STRING "CrIg Base 5, +1 Conc; +5 maintain concentration = Level 15"
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 49
        }
        DESCRIPTION "The sword has the symbol of Calebais sculpted into the hilt, and is an invested device with three powers. It can cast *Blade of the Virulent Flame*"
    }

