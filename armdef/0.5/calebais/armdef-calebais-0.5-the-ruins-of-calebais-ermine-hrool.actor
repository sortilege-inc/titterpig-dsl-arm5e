EXTENSION "ARMDef_Calebais_TheRuinsOfCalebais_ErmineHrool" {
    NAME "Ars Magica Fifth Edition, Calebais - Ermine Hrool"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Calebais_Core_Ext"

    # Ermine Hrool (Chapter Two: The Ruins of Calebais, p33): one being, its printed stat lines verbatim fields.

    #tc2fc78c4977f463b5093e2 ^"Ermine Hrool" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t5ec6277a332cedb0108847 ^"Calebais"]
            ^"Covenant" LIST [#t3258eeb24aa00a2434f405 ^"Calebais"]
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 18
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 2
                ^"Perception" INTEGER 3
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER -4
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER -3
            ^"Confidence" STRING "1 (3)"
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-2), -3 (3-4), -5 (5-6), Incapacitated (7-8)"
            ^"Powers" STRING "Sculpt the Mystic Rock, 1 point, +0, Terram: With careful concentration, an ermine Hrool can change rock into clay while digging at it or sculpting it into a primitive shape. Wielding the Invisible Sling, 1 point, +5, Terram: Ermine Hrools can magically throw a small stone at a target, causing +5 damage, or +12 if the stone has been specially sharpened. The Hrools keep many of these stones at hand, marked with their special symbols for war and magic. Banish the Haunting Spirit, 3 points, +0, Mentem: By standing on their hind legs and hissing, ermine Hrools can drive away a ghost with a Might of 15 or less. They can also work together, so that two of them can drive away a ghost with up to 20 Might, and three can affect those with 25. Ghosts cannot stand the sound of their hissing, and must flee the room or vanish when they use this power."
            ^"Vis" STRING "3 Rego"
            ^"Appearance" STRING "Ermine Hrools are leaner and spindlier than their weasel-like counterparts, with pure white fur and pink eyes. Many wear golden wire crowns bent around their heads, with a green gemstone shaped like an eye at their foreheads. They wear almost comical attempts at wizard robes gnawed from tattered tapestry remains, and wrap rings of bark or sculpted stone around their claws or through holes poked in their ears."
            ^"Source" STRING "Calebais"
            ^"Page" INTEGER 33
        }
        PERSONALITY_TRAITS {
            "Prudent" +2
            "Loyal" -3
        }
        COMBAT {
            "Bite" INIT 4 ATTACK 6 DEFENSE 5 DAMAGE -3
        }
        ABILITIES {
            "Athletics" SCORE 2 SPECIALTY "climbing"
            "Awareness" SCORE 1
            "Brawl" SCORE 2 SPECIALTY "grapple"
            "Concentration" SCORE 3 SPECIALTY "rock sculpting"
            "Craft (sculpture)" SCORE 3
            "Finesse" SCORE 3 SPECIALTY "Terram"
            "Hrool" SCORE 4 SPECIALTY "giving orders"
            "Latin" SCORE 2 SPECIALTY "insults"
            "Leadership" SCORE 4 SPECIALTY "combat"
            "Penetration" SCORE 2 SPECIALTY "Rego"
            "Swim" SCORE 2
        }
    }

}
