EXTENSION "ARMDef_CityAndGuild_Crafts_Wondrous_Items" {
    NAME "Ars Magica Definitive Edition, City & Guild - Common Wondrous Items"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_City_And_Guild_Core_Ext"

    # The twelve items the box prints. Craft Level and Magnitude are asserted for
    # ALL of them rather than taken where the regex happened to fire; the Hermetic
    # breakdown the source gives in parentheses and the craftsman who makes it are
    # typed where the entry states them.

    #t4c38f43ee338151e18089a ^"Bishop’s Platter" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "13"
            ^"Magnitude" STRING "1"
            ^"Hermetic Effect" STRING "Muto Imaginem base 2, +1 Touch, +2 Sun"
            ^"Made By" STRING "silversmith"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Made by a silversmith, this silver serving tray copies the effects of the spell *Taste of the Spices and Herbs*. Craft Level 13: Magnitude 1 (Muto Imaginem base 2, +1 Touch, +2 Sun)."
    }

    #t5fb43b624ab54c58200b39 ^"Bridle of the Talking Horse" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "17"
            ^"Magnitude" STRING "5"
            ^"Hermetic Effect" STRING "Intellego Animal base 10, +1 Touch, + 2 Sun"
            ^"Made By" STRING "leather maker"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Made by a leather maker, this bridle allows a horse’s rider to talk to his steed. Craft Level 17: Magnitude 5 (Intellego Animal base 10, +1 Touch, + 2 Sun)."
    }

    #t733118c95dfde18d9ff50b ^"Builder’s Helper" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "15"
            ^"Magnitude" STRING "3"
            ^"Hermetic Effect" STRING "Muto Herbam base 3, +2 Sun, +2 for change in size from –1 to +1"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "This miniature ladder, which can be easily carried in a builder’s pack, expands to 15 feet upon command. Craft Level 15: Magnitude 3 (Muto Herbam base 3, +2 Sun, +2 for change in size from –1 to +1)."
    }

    #tf988237e7bb0063f5ce2c6 ^"Charlemagne’s Loaf" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "17"
            ^"Magnitude" STRING "5"
            ^"Hermetic Effect" STRING "Rego Mentem base 10, +1 Touch, +2 Sun"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "The smallest nibble from this loaf of bread gives the eater incredible courage, granting him a +3 on all Bravery rolls. Craft Level 17: Magnitude 5 (Rego Mentem base 10, +1 Touch, +2 Sun)."
    }

    #t5c05423d8dd9fda7e71c00 ^"Helm of Invisibility" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "16"
            ^"Magnitude" STRING "4"
            ^"Hermetic Effect" STRING "Perdo Imaginem base 4, +1 Touch, +2 Sun, +1 changing image"
            ^"Made By" STRING "armorer"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Made by an armorer, this helmet makes the wearer invisible. Craft Level 16: Magnitude 4 (Perdo Imaginem base 4, +1 Touch, +2 Sun, +1 changing image)."
    }

    #t6fa496f763de0f06f76a00 ^"King Richard’s Ring" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "16"
            ^"Magnitude" STRING "4"
            ^"Hermetic Effect" STRING "Rego Ignem base 4, +1 for up to +10 damage, +1 Touch, +2 Sun"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "This gold ring protects the wearer from fire, granting him a +5 Soak. This is named after Richard the Lionhearted and the legendary ring he wore on crusade. Craft Level 16: Magnitude 4 (Rego Ignem base 4, +1 for up to +10 damage, +1 Touch, +2 Sun)."
    }

    #t37a39d6f5b27a7755662ae ^"Neptune’s Brooch" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "14"
            ^"Magnitude" STRING "2"
            ^"Hermetic Effect" STRING "Rego Corpus base 3, +1 Touch, +2 Sun"
            ^"Made By" STRING "jeweler"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "This carved precious stone, made by a jeweler, prevents the wearer from drowning by allowing him to float on the surface of water. Excess weight, like armor, can still sink the swimmer. Craft Level 14: Magnitude 2 (Rego Corpus base 3, +1 Touch, +2 Sun)."
    }

    #t4258d09c7d3aec33e9a136 ^"Scarf of Healing" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "14"
            ^"Magnitude" STRING "2"
            ^"Hermetic Effect" STRING "Creo Corpus base 3, +1 Touch, +2 Sun"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "This scarf copies the effects of the spell *Bind * *Wound*. Craft Level 14: Magnitude 2 (Creo Corpus base 3, +1 Touch, +2 Sun)."
    }

    #t8bd0edf31f5501997496d7 ^"Shoes of the Zephyr" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "20"
            ^"Magnitude" STRING "8"
            ^"Hermetic Effect" STRING "Creo Auram base 5, +1 Touch, +2 Sun, +2 highly unnatural, +1 size, +1 Rego requisite"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "These horseshoes allow a horse to fly, running across the sky as if it were land. Craft Level 20: Magnitude 8 (Creo Auram base 5, +1 Touch, +2 Sun, +2 highly unnatural, +1 size, +1 Rego requisite)."
    }

    #tc0f8eb877bb070af505e2f ^"The King’s Goblet" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "13"
            ^"Magnitude" STRING "1"
            ^"Hermetic Effect" STRING "Intellego Aquam base 3, +2 Sun"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "This gold cup trembles in the holder’s hand if a poisoned beverage is poured into it. Craft Level 13: Magnitude 1 (Intellego Aquam base 3, +2 Sun)."
    }

    #t5e8673e12d85d63c237bfd ^"Thief’s Slippers" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "15"
            ^"Magnitude" STRING "3"
            ^"Hermetic Effect" STRING "Perdo Imaginem base 3, +1 Touch, +2 Sun, +1 changing image"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "These shoes let the wearer move without making a sound. Craft Level 15: Magnitude 3 (Perdo Imaginem base 3, +1 Touch, +2 Sun, +1 changing image)."
    }

    #ta62b4737420349971c9782 ^"Wolf’s Cloak" DEF {
        EXTENDS ^"Wondrous Item"
        PROPERTIES {
            ^"Craft Level" STRING "17"
            ^"Magnitude" STRING "5"
            ^"Hermetic Effect" STRING "Muto Corpus base 10, +1 Touch, +2 Sun"
            ^"Made By" STRING "furrier"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Made by a furrier, this cloak allows the wearer to change into a wolf. The cloak, but not his other clothes and items, change with the transformation. The wearer remains a wolf until the effect ends, at either sunrise or sunset. Craft Level 17: Magnitude 5 (Muto Corpus base 10, +1 Touch, +2 Sun)."
    }

}
