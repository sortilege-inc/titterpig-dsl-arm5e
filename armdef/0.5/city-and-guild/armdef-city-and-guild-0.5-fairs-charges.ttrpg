EXTENSION "ARMDef_CityAndGuild_Fairs_Charges" {
    NAME "Ars Magica Definitive Edition, City & Guild - tolls, fees and other fair charges"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_City_And_Guild_Core_Ext"

    # The thirteen charges the box lists. `Tolls` and `Fees` are records too, not
    # group headings: the source gives each of them its own definition.

    #t89aef76dce72dd6a7e4ef1 ^"Tolls" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Payments required for carts, people and beasts, to pass town gates and roads."
    }

    #tb9089cea8e5dc687c01f05 ^"Passage, Carriage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Tolls for carrying goods past a checkpoint."
    }

    #td34b278c31bb25f9b38120 ^"Portage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A fee for carrying cargo from one navigable river system to another."
    }

    #t0b9acc53a124ea3ed3a06e ^"Lastage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A toll based on the weight of goods carried."
    }

    #te0addbee7abd6bc9a7eb94 ^"Pontage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A toll for carrying goods over a bridge."
    }

    #tb6eef83a50e16ccac10ee8 ^"Seldage, Stallage, Picage, Terrage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Payments due for setting up a booth, sometimes paid in goods."
    }

    #te318a33fc23d16a66b3cd1 ^"Fees" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "For entry to the fair. (In extreme cases, fees may be higher for late arrivals to encourage merchants to arrive for the start of trading.)"
    }

    #tb10b97fb39c6dfc2445e44 ^"Pesage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A fee for the weighing of goods, paid by the purchaser."
    }

    #tc7fceb29d594335b50cdaa ^"Tronage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A fee for making use of the public weighing beam."
    }

    #t6cd12795ae07aa6bcdf56c ^"Brokerage" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "A fee for acting as a broker in negotiating a deal."
    }

    #tc98e6e0e236292abb6527c ^"Rent" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "For use of a fixed stall in a fair with permanent buildings, or for overnight accommodation."
    }

    #t928c0e804f177d252f7a6c ^"Grazing Payments" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "For the right to graze animals, both those for sale and those who pull the cart home."
    }

    #tdfc41f11b9d757a53b5491 ^"Animal Care Payments" DEF {
        EXTENDS ^"Fair Charge"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "To those who care for the animals during the fair."
    }

}
