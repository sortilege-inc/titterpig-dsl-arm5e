EXTENSION "ARMDef_CityAndGuild_Fairs_Saints" {
    NAME "Ars Magica Fifth Edition, City & Guild - patron saints of the trades"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_City_And_Guild_Core_Ext"

    # The eight saints the box lists, each with the trades it patronises and its
    # feast. The first entry's name wraps out of the emphasis run and is rejoined
    # before the record is named -- unjoined it would be minted as
    # `and St. Crispianian`, and no gate checks DEF names.

    #t5234477c87a525bfa74bb4 ^"St. Crispin and St. Crispianian" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "October 25"
            ^"Trades" STRING "Leatherworkers, cobblers especially"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Leatherworkers, cobblers especially. Feast: October 25. These brothers were members of a noble Roman family who preached in Gaul in the third century. Some say they traveled as far as Faversham in England."
    }

    #td660c089adc9b562791b70 ^"St. Dunstan" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "May 19"
            ^"Trades" STRING "Metalworkers, locksmiths, and embroiderers"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Metalworkers, locksmiths, and embroiderers. Feast: May 19. A tenth century English Benedictine monk who became Abbot of Glastonbury and later Archbishop of Canterbury."
    }

    #tecf96041272ee64cfc0e5d ^"St. Eloi" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "December 1"
            ^"Trades" STRING "Goldsmiths and jewelers"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Goldsmiths and jewelers. Feast: December 1. A preacher who became Bishop of Noyon, northern France, in the seventh century."
    }

    #t51836a08c604acdfd649f5 ^"St. Homobonus" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "November 13"
            ^"Trades" STRING "Cloth and tailoring"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Cloth and tailoring. Feast: November 13. Homobonus died in 1197 and was canonized in 1199. He lived in the north Italian city of Cremona and appears as a well-dressed citizen of that time and place."
    }

    #t91808a8ceba2a37d6310f5 ^"St. Joseph" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "March 19 and May 1"
            ^"Trades" STRING "Woodworkers"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Woodworkers. Feasts: March 19 and May 1. The foster father of the Son of God lived in that part of the Roman Empire known as Judaea and died in the first century."
    }

    #te95d4ae9e4c43c90bbe105 ^"St. Maurice" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "September 22"
            ^"Trades" STRING "Dyers and weavers"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Dyers and weavers. Feast: September 22. Maurice was an Egyptian soldier in the Roman army during the third century who became the principal officer of the Theban legion."
    }

    #tfa8c3f9880797a5e6b6230 ^"St. Michael" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "September 29"
            ^"Trades" STRING "Wholesalers"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Wholesalers. Feast: September 29. The archangel appears in his role as the weigher of souls."
    }

    #t982850c298c809139676a1 ^"St. Vincent" DEF {
        EXTENDS ^"Patron Saint"
        PROPERTIES {
            ^"Feast" STRING "January 22"
            ^"Trades" STRING "Wine"
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Wine. Feast: January 22. A deacon who lived in Saragossa, northern Iberia, and was martyred in 304."
    }

}
