EXTENSION "ARMDef_CityAndGuild_GoodsOfEurope_Tables" {
    NAME "Ars Magica Fifth Edition, City & Guild - Chapter Eight: The Goods of Europe tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_City_And_Guild_Core_Ext"

    # The chapter's tables, structured (the prime directive: a table is never
    # prose). Column sets are read off the printed page or the words' own
    # x-geometry, never guessed, and every cell is gated by cell_verbatim.

    #t80bdd629330c31c59a807b ^"Commercial Sources of Trade Goods" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Region", "Area", "Goods"]
            ^"Source" STRING "City & Guild"
        }
        TABLE {
            "Africa" "Principal Ports (Alexandria, Tunis, Algiers)" "Dyes, Gold, Inks, Ivory, Cheap Potash, Cheap Spices, Wax, Wool"
            "Baltic Sea" "All Areas" "Amber, Grain, Pitch, Timber, Wood"
            "Baltic Sea" "Denmark (Copenhagen, Aarhus)" "Foodstuffs (Cattle), Leather, Horses, Cheap Potash, Slaves"
            "Baltic Sea" "Norway (Oslo, Bergen)" "Foodstuffs (Butter), Iron, Leather, Skins, Timber, Wood, also noted for gyrfalcons"
            "Baltic Sea" "Russia: (Novgorod, Pskov)" "Fish (Sturgeon), Cheap Furs, Cheap Potash, Wax"
            "Baltic Sea" "Southern Coast (Danzig, Lubeck, Reval, and Riga)" "Fish (Herring), Grain, Pitch, Wax"
            "Baltic Sea" "Sweden (Abo, Stockholm)" "Copper, Iron"
            "Black Sea" "All Areas" "Grain, Salt, Slaves"
            "Black Sea" "Bulgaria (Trnovo, Varna)" "Gold, Grain"
            "Black Sea" "Crimea (Kaffa)" "Furs, Slaves, Wax"
            "Black Sea" "Trebizond (Trebizond)" "Cotton, Ivory, Silk, Spices"
            "British Isles" "All Areas" "Foodstuffs (Cheese), Grain, Leather"
            "British Isles" "Scotland (Edinburgh, Aberdeen)" "Fish (Cod), Standard Pearls (Tay), Wool"
            "British Isles" "Ireland (Cork, Dublin)" "Flax, Furs"
            "British Isles" "England (Bristol, London, Scarborough, Southampton)" "Amber, Brass, Coal, Embroidery, Lead, Fine Raw Wool, Silver (the wool surplus creates an oversupply of silver in the economy), Tin"
            "France" "Atlantic Coast (Nantes, Bayonne, Bordeaux)" "Flax, Salt, Cheap Wine"
            "France" "Northern (Calais, Rouen, Paris, Rheims, Troyes)" "Dye (Madder), Dye (Woad), Grain, Carved Ivory, Linen, Raw Wool, Wool Cloth"
            "France" "Southern (Marseilles, Narbonne, Salins-les-Bains, Toulouse)" "Dye, Salt, Slaves, Wine"
            "Germany" "All Areas" "Dye, Coal, Iron, Pitch, Cheap Potash, Timber"
            "Germany" "Bohemia (Prague)" "Copper, Cheap Glassware, Pewter, Silver (particularly at Jihlava after 1222), Wax"
            "Germany" "Central (Frankfurt, Nuremberg, Regensburg, Salzburg)" "Copper, Lead, Salt, Silver (particularly at Freiberg and Goslar), Wine"
            "Germany" "North (Cologne, Hamburg)" "Brass and Brassware, Salt, Cheap Weapons"
            "Germany" "South" "Flax, Timber, Wine"
            "The Holy Land and Ionian Asia Minor" "Principal Ports and Cities (Beirut, Smyrna, Rhodes, Nicosia, Tyre)" "Alum, Cotton, Dye (Indigo and others), Potash, Saffron, Spices, Sugar (particularly in Cyprus), Fine Silk, Tapestries"
            "Iberia" "All Areas Except Mallorca" "Dye (Woad, Crimson), Iron, Olive Oil, Paper, Wax, Wool"
            "Iberia" "Muslim South and Aragon (Balansyia, Barcelona, Cartagena, Ishbiliyah, Malaqah, Qadis)" "Cotton, Flax, Linen, Cheap Silk, Slaves, Cheap Spices (particularly Rice), Sugar, Wine"
            "Iberia" "Kingdom of Mallorca (Balearic Islands and Ibiza)" "Pottery, Salt"
            "Iberia" "North and Center (Lisbon, Oporto, Corunna, Salamanca, Toledo)" "Soap, Weapons"
            "Italy, Adjacent Islands, and Dalmatia" "East Adriatic Coast (Ragusa, Spalato, Venice, Zara)" "Alum, Cloth (all types), Fish, Glass, Iron, Jewelry, Salt, Ships"
            "Italy, Adjacent Islands, and Dalmatia" "Islands" "Salt, Cotton (small quantities), Cheap Silk, Wine"
            "Italy, Adjacent Islands, and Dalmatia" "Northern Industrial Area (Milan, Florence, Siena)" "Cheap Cloth (all types), Dye, Goldwork, Paper, Pottery, Warhorses, Weapons"
            "Italy, Adjacent Islands, and Dalmatia" "South (Naples, Rome)" "Olive Oil, Cheap Silk, Wine"
            "Italy, Adjacent Islands, and Dalmatia" "Southern Alpine Towns" "Copper, Iron, Lead, Tin (small quantities)"
            "Low Countries" "Principal Ports and Cities (Arras, Brussels, Bruges, Ghent, Liege, Utrecht)" "Brass (Liege), Copper, Dye (Woad, Madder), Linen, Cheap Silk Cloth, Tapestry, Timber, Wool Cloth (particularly sewn into luxurious trousers from Bruges)"
            "Romania and the Byzantine Successor States in Europe and Aegean Islands" "Romania (Constantinople)" "Honey, Olive Oil, Perfumes, Salt, Raw Silk, Cheap Silk Cloth, Slaves, Spices, Wax, Wine"
            "Romania and the Byzantine Successor States in Europe and Aegean Islands" "Crete" "Saffron (small quantities), Wine"
            "Southern Russia, Poland, and Hungary" "Russia (Kiev)" "Furs, Fish (Sturgeon), Cheap Potash, Average Pearls, Timber, Wood"
            "Southern Russia, Poland, and Hungary" "Poland (Poznan, Wroclaw, Cracow)" "Wool"
            "Southern Russia, Poland, and Hungary" "Hungary (Zagreb, Pecs, Belgrade, Buda, Brasso, Esztergotti, Kolozsavar, Pozsony, Szeged, Temsevar)" "Copper, Foodstuffs (Cattle), Gold (small quantities), Leather"
            "Places So Far as to Verge on the Mythical" "Everywhere" "Gemstones (type varies by place)"
            "Places So Far as to Verge on the Mythical" "Iceland" "Falcons"
            "Places So Far as to Verge on the Mythical" "India" "Diamonds, Dye (Brazilwood and others), Ivory, Pepper, Other Spices"
            "Places So Far as to Verge on the Mythical" "Persian Gulf" "Gems, Pearls, Saffron, Silk, Slaves"
            "Places So Far as to Verge on the Mythical" "Serica" "Silk, Spices"
        }
    }

    #tb4a6150146209f0fe2595f ^"Prices of Goods Table" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Commodity", "Shoddy", "Standard", "Superior", "Expensive", "Notes"]
            ^"Source" STRING "City & Guild"
        }
        TABLE {
            "Alum" "*" "200" "400" "#" ""
            "Brassware" "150" "300" "600" "1500" ""
            "Copper" "*" "*" "*" "200" ""
            "Cotton Cloth" "100" "200" "400" "10,000" "Fine cotton is rare, and a silk substitute."
            "Cotton, Raw" "40" "50" "100" "250" ""
            "Dye" "10" "50" "" "20,000" "Sold in bottles of varying sizes"
            "Fuel" "1" "2" "3" "n/a" ""
            "Fish" "50" "75" "100" "#" "The most expensive fish, whales and sturgeons, usually belong to the king by right."
            "Flax" "20" "45" "90" "250" ""
            "Fur and Hides" "1" "50" "100" "250" ""
            "Foodstuffs" "1" "10" "20" "50" ""
            "Gemstones" "2,000 (fake)" "10,000" "80,000" "100,000" "Sold in ounces: 2 1/2 pounds per ounce for fine, 2 pounds per ounce for average"
            "Glassware" "#" "1,500" "2,000" "2,500" ""
            "Gold" "*" "*" "*" "24,200" "Sold by the pound, at about ten pounds of silver per pound of gold"
            "Grain" "1" "5" "10" "25" ""
            "Hemp Cloth" "45" "60" "100" "#" ""
            "Hemp, Raw" "15" "20" "25" "#" ""
            "Horses" "2" "4" "8" "64" "Two horses to the ton"
            "Ink" "10" "25" "50" "10,000" "Ground semiprecious stones, sold at one pound per four ounces, dry weight"
            "Iron" "*" "*" "*" "120" ""
            "Ironware and Weapons" "125" "250" "500" "2,500" ""
            "Lead" "*" "*" "*" "60" ""
            "Leather" "150" "250" "500" "2,500" ""
            "Linen Cloth" "125" "175" "350" "1,750" ""
            "Oil" "2" "10" "20" "100" ""
            "Paper" "75" "150" "300" "#" ""
            "Pearls" "5 (fake)" "80,000" "120,000" "n/a" "Sold in ounces: 2 pounds per ounce for river pearls, 3 pounds per ounce for sea pearls"
        }
    }

    #tf9fc097466623fde514452 ^"Prices of Goods Table, Continued" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Commodity", "Shoddy", "Standard", "Superior", "Expensive", "Notes"]
            ^"Source" STRING "City & Guild"
        }
        TABLE {
            "Pewterware" "375" "750" "1,500" "#" "Expensive pewterware is unknown; people who could afford it buy silverware instead."
            "Pitch" "1" "2" "4" "20" ""
            "Potash" "20" "#" "#" "400" "Potash has only cheap and expensive forms."
            "Pottery" "20" "70" "140" "700" ""
            "Saffron" "*" "*" "*" "25,000" "Sold by the ton only rarely"
            "Salt" "*" "*" "*" "120" ""
            "Silk Cloth" "12,500" "25,000" "50,000" "#" "Sold by the roll"
            "Silk, Raw" "300" "500" "600" "#" ""
            "Silver" "250*" "1,650*" "2,200*" "2,420" ""
            "Slaves" "1" "2" "4" "#" "Slaves cost between 5 and 10 pounds each."
            "Soap" "0.5" "1" "5" "10" ""
            "Spices" "5" "50" "1,500" "2,000" ""
            "Tapestries" "100" "3,000" "6,000" "#" ""
            "Timber" "2.5" "5" "10" "25" ""
            "Tin" "*" "*" "*" "250" ""
            "Wax" "2" "5" "10" "#" ""
            "Wine" "5" "10" "20" "50" ""
            "Wool Cloth" "50" "150" "300" "3,000" ""
            "Wool, Raw" "25" "50" "100" "500" ""
        }
    }

}
