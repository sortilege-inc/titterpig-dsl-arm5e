EXTENSION "ARMDef_CityAndGuild_Towns_Ordeals" {
    NAME "Ars Magica Fifth Edition, City & Guild - the ordeals of trial by ordeal"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_City_And_Guild_Core_Ext"

    # The four ordeals the box prints, each a bolded run-in label with its own
    # procedure. Found by evidence, counted against the page.

    #tf6b4f26a1e2dcc76759156 ^"Ordeal of Combat" DEF {
        EXTENDS ^"Ordeal"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "Fought between the plaintiff and the accused; the victor is judged righteous."
    }

    #tadbc2a1fb6d3f528de5f15 ^"Ordeal of Cold Water" DEF {
        EXTENDS ^"Ordeal"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "The accused is thrown into a river; if innocent he sinks instead of floating."
    }

    #td9968f9c6467ab15c31bde ^"Ordeal of Hot Water" DEF {
        EXTENDS ^"Ordeal"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "The accused pulls a stone from a kettle of boiling water; if innocent the ordeal wounds heal after three days."
    }

    #t683ce4fef771e551927fcb ^"Ordeal of Iron" DEF {
        EXTENDS ^"Ordeal"
        PROPERTIES {
            ^"Source" STRING "City & Guild"
        }
        DESCRIPTION "The accused carries a red hot iron a distance of nine feet; if innocent the ordeal wounds heal after three days."
    }

}
