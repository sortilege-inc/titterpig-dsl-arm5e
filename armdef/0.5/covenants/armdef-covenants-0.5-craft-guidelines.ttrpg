EXTENSION "ARMDef_Covenants_Craft_Guidelines" {
    NAME "Ars Magica Fifth Edition, Covenants - Rego Craft Guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-25"
    DEPENDS_ON "ARMDef_Core_Magic_Spell"

    #tfIqXUpx54Cx8hFi8MAaz0nk ^"Creo Animal Guidelines (Covenants)" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Source" STRING "Covenants"
        }
        GUIDELINES {
            "Level 2" "Preserve a corpse from decay."
        }
    }

    #t1XchCTGXiNbS6wsMMVYfs6H ^"Rego Animal Guidelines (Covenants)" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Source" STRING "Covenants"
        }
        GUIDELINES {
            "Level 1" "Manipulate items made of animal products."
            "Level 2" "Treat items made of animal products."
            "Level 3" "Treat and process items made of animal products."
        }
        DESCRIPTION "For greater complexity add one or two magnitudes. (Increased complexity usually also increases the Ease Factor of the mundane craft, and so increases the Finesse roll Ease Factor.)"
    }

    #t9AYjxvocKbCsFeTa3oOgWDd ^"Creo Herbam Guidelines (Covenants)" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Source" STRING "Covenants"
        }
        GUIDELINES {
            "Level 2" "Preserve a dead plant from decay."
        }
    }

    #tAHvXLTAQmkEmAbTx6oBWII7 ^"Rego Herbam Guidelines (Covenants)" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Source" STRING "Covenants"
        }
        GUIDELINES {
            "Level 3" "Manipulate items made of plant products."
            "Level 4" "Treat items made of plant products."
            "Level 5" "Treat and process items made of plant products."
        }
        DESCRIPTION "For greater complexity add one or two magnitudes (e.g., Base 15 might be used to weave thread into a tunic)."
    }

    #tp2shJYy2gadAm8QMdgwZC0y ^"Rego Terram Guidelines (Covenants)" DEF {
        APPLIES TO [^"Formulaic Spell"]
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Source" STRING "Covenants"
        }
        GUIDELINES {
            "Level 2" "Shape and form dirt, as if a craftsman had worked it."
        }
        DESCRIPTION "Add one magnitude for stone or glass, two for metal of gemstones. Add one or two magnitudes according to complexity."
    }
}
