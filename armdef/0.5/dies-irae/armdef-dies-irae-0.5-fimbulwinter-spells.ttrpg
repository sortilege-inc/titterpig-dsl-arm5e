EXTENSION "ARMDef_Dies_Irae_Fimbulwinter_Spells" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Three: Fimbulwinter: The Cold Doom spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t1697b2da3f0a8b7d136875 ^"The Hidden Warren" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeTe 40 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "This spell carves out 2,500 linear paces of passageway that is two paces by two paces, for a total of 10,000 cubic paces of stone or mixed stone and dirt destroyed. This space may be adjusted to create doorways, rooms, and stairs with a Finesse roll against an Ease Factor of 12. An Ease Factor of 15 allows for more intricate details like chairs, tables, and shelves. This spell carves through dirt and stone alike, but a structure cut primarily out of dirt requires wooden supports added afterwards. This spell easily creates a space 6 paces underground, with twenty 5-by-5-by-3 pace rooms joined to a 2-by2-by-60 paces corridor, for approximately 1,775 cubic paces, and allows for 5 such levels, each joined by a 2-by-2 pace stairwell 6 paces deep. The form of the excavation can be modified by the caster, however.\n\n(Base 3, +1 Touch, +1 Part, +4 Size, +1 for Stone, +2 for complexity)"
    }

    #ta9f2ed56168667ac23b1cb ^"The Shroud Cut of Winter’s Cloth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Boundary"
            ^"Requisite" STRING "Mentem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrIm(Me) 45 R: Touch, D: Year, T: Boundary [Ritual]"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "Similar to *The Shrouded Glen *(ArM5, page 152), this spell enchants the Boundary in which the ritual is cast so that anyone moving through it is not only subtly diverted, but believes the space within the Boundary is filled with the image of the terrain of the caster’s choice, usually identical to the area surrounding it. This image affects the senses of sight, touch, and hearing.\n\n(Base 3, +1 Touch, +4 Year, +4 Boundary, +1 Mentem Req.)"
    }

    #t7da61b5b925ae5c2a99049 ^"A House Already Abandoned" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Structure"
            ^"Printed Stat Line" STRING "MuIm 35 R: Touch, D: Moon, T: Structure"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 70
        }
        DESCRIPTION "From outside the structure, the targeted structure appears empty and crumbling, and there are no signs of movement inside. Anyone within the structure seems to be nothing more than a scurrying insect, and any furnishings seem to be rubble. The sounds, sights, and smells of anyone inside are masked and hidden.\n\n(Base 3, +1 Touch, +3 Moon, +3 Structure, +1 Complexity)"
    }

}
