EXTENSION "ARMDef_Dies_Irae_TheEndOfTime_ExampleLunarCreatureWolf" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Example Lunar Creature: Wolf"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # Example Lunar Creature: Wolf (Chapter Two: The End of Time, p34): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t7586426dfe4e3cb6352646 ^"Example Lunar Creature: Wolf" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Cun +2, Per 0, Pre –2, Com 0, Str –1, Sta +3, Dex +2, Qik +2"
            ^"Size" STRING "–1"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Improved Characteristics (x2), Ferocity (when hungry), Long-Winded, Sharp Ears, Compulsion (killing), Infamous"
            ^"Qualities" STRING "Aggressive, Hardy, Keen Sense of Smell, Lunar, Pack Animal/Pack Leader, Pursuit Predator, Sharp Ears, Thick Fur, Vocal"
            ^"Personality Trait" STRING "Brave +3, Cowardly +3"
            ^"Reputations" STRING "Bloodthirsty (local) 4"
            ^"Combat" STRING "Teeth: Init +2, Attack +11, Defense +9, Damage 0"
            ^"Soak" STRING "+4"
            ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16)"
            ^"Abilities" STRING "Athletics 5 (distance running), Awareness 3 (smell), Brawl 5 (teeth), Hunt 4 (track by smell), Survival 3 (winter)"
            ^"Natural Weapons" STRING "Teeth: Init 0, Atk +3, Def +1, Dam +1. Its thick fur gives it a Protection of +1."
            ^"Appearance" STRING "The Lunar Wolf has the same shape as a wolf of the Earth, but its body is made of aether. The only hint as to its presence is the tracks it leaves and the faint silver glow from its mouth and eyes."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 34
        }
        DESCRIPTION " Described earlier"
    }

}
