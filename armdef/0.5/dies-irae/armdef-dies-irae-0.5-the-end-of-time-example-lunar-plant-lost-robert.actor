EXTENSION "ARMDef_Dies_Irae_TheEndOfTime_ExampleLunarPlantLostRobert" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Example Lunar Plant: Lost Robert"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # Example Lunar Plant: Lost Robert (Chapter Two: The End of Time, p35): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t79133e23657c07364a31a6 ^"Example Lunar Plant: Lost Robert" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +2, Pre 0, Com 0, Str +2, Sta +2, Dex –4, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "16 (16)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Peasant; Enduring Constitution; Weak Characteristics, Poor Dexterity × 1"
            ^"Personality Trait" STRING "Fearful +1"
            ^"Combat" STRING "Fist: Init –1, Attack –1, Defense +3, Damage +2"
            ^"Soak" STRING "+2"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 2 (cattle), Area Lore: Home Village 3 (people), Athletics 1 (run), Awareness 3 (search), Bargain 1 (produce), Brawl 3 (fist), Carouse 1 (power drinking), English 5 (slang), Farmer 2 (plowing), Folk Ken 2 (peasants), Guile 3 (lying to authority), Ride 2 (mule), Survival 2 (sleeping rough)"
            ^"Equipment" STRING "Workman’s clothes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "A forlorn figure of a young man locked into a reclining pose. His limbs are split open and blackened roots protrude from them and from his abdomen into the ground. He tries to cover himself with a blanket out of shame, but it too is now becoming part of him. He has one good arm, which he uses to try to shield himself from those who chance upon him."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "Robert was a young peasant farmer until the end of the world came. Robert and his family left their village, taking their livestock away to safe ground. Robert, however, was bitten by something in the night and awoke to find himself rooted to the ground and unable to leave. His family left him, fearful of trying to help.\n\nHe is almost overcome by the time the player characters come across him and both legs and an arm are now blackened, split, and rooted to the ground. The thick tendrils claw their way to his face and now and then his remaining free arm pulls at them so that he may breathe a little easier.\n\nLost Robert suffers a –5 Fatigue penalty to all actions that he takes, which given his condition are necessarily few. He still has his memories, but his personality is all but gone."
    }

}
