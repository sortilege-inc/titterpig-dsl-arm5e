EXTENSION "ARMDef_Dies_Irae_TheEndOfTime_Guidelines" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Two: The End of Time guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tb3160aeb10f9013e88ef7f ^"Creo Aethera Guidelines" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Aether" FIAT "the new Form of Aether (Dies Irae, Appendix: Aetheric Magic, pp.39-43); the type lists the ten Hermetic Forms"
            ^"Printed Name" STRING "Creo Aethera Guidelines"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 42
        }
        GUIDELINES {
            "Level 1" "Create an amount of intangible aether."
            "Level 3" "Create an amount of aether with the density of fire."
            "Level 5" "Create an amount of aether with the density of air."
            "Level 15" "Create an amount of aether with the density of water."
            "Level 25" "Create an amount of aether with the density of earth."
            "Level 30" "Create an amount of aether with the density of stone or glass."
            "Level 35" "Create an amount of aether with the density of metal."
        }
        DESCRIPTION "Creo Aethera spells create a quantity of aether. Creating that aether in some unusual or worked shape is one magnitude higher than the listed values.\n\nHaving no conventional physical properties, aether is intangible at its lowest density, but it can be brought together into progressively more dense accretions, accounting for the moon and stars. While aether itself remains invisible regardless of density, it does emit light, which becomes brighter as the aether becomes more dense."
    }

    #t78f9929be18a5705ba9009 ^"Intellego Aethera Guidelines" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Aether" FIAT "the new Form of Aether (Dies Irae, Appendix: Aetheric Magic, pp.39-43); the type lists the ten Hermetic Forms"
            ^"Printed Name" STRING "Intellego Aethera Guidelines"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 42
        }
        GUIDELINES {
            "Level 1" "Sense the presence of unbounded aether."
            "Level 3" "Sense the presence of aether within another material."
            "Level 5" "Sense unnatural properties possessed by aether."
            "Level 15" "Speak with an aetheric spirit."
            "Level 20" "Speak with an aetheric creature."
            "Level 25" "Speak with an aetheric plant."
        }
        DESCRIPTION "Intellego Aethera spells are not affected by the density of the aether. They allow the magus to detect the presence of aether, any unnatural properties or qualities given the aether, and to communicate with entities formed from aether. As aether is naturally invisible, only giving off light, a magus cannot normally see aether even at high densities. Intellego Aethera spells allow the magus to sense aether, which is sufficient to then target that aether with further magical effects."
    }

    #t72ada55b219b9e0aa2fbb7 ^"Muto Aethera Guidelines" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Aether" FIAT "the new Form of Aether (Dies Irae, Appendix: Aetheric Magic, pp.39-43); the type lists the ten Hermetic Forms"
            ^"Printed Name" STRING "Muto Aethera Guidelines"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 42
        }
        GUIDELINES {
            "Level 1" "Give aether the property of emitting one type of sensory species."
            "Level 3" "Give aether the property of emitting three types of sensory species."
            "Level 5" "Give aether the property of emitting five types of sensory species. Change the speed of aether’s natural motion."
            "Level 10" "Give aether an unnatural property, such as heat, cold, dryness, or moisture."
            "Level 15" "Change aether into one of the elemental Forms (Aquam, Auram, Ignem, Terram)"
            "Level 20" "Change aether into one of the living Forms (Animal, Corpus, Herbam, Mentem)"
            "Level 25" "Change aether into one of the intangible Forms (Imaginem, Vim)"
        }
        DESCRIPTION "Muto Aethera spells grant properties that aether would otherwise not have and to transmute it into another substance. The guidelines below are for intangible aether. Add successive magnitudes for aether with densities of fire, air, water, earth, stone, and metal."
    }

    #tbe3d963f77f9ec16d0bcfe ^"Perdo Aethera Guidelines" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Perdo" FIXED
            ^"Form" STRING "Aether" FIAT "the new Form of Aether (Dies Irae, Appendix: Aetheric Magic, pp.39-43); the type lists the ten Hermetic Forms"
            ^"Printed Name" STRING "Perdo Aethera Guidelines"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 42
        }
        GUIDELINES {
            "Level 5" "Destroy a single property of aether."
            "Level 10" "Destroy a quantity of free aether."
            "Level 15" "Destroy a quantity of aether contained within other material."
        }
        DESCRIPTION "Perdo Aethera spells may be used to destroy an amount of aether. Doing so is particularly difficult, however.\n\nThe guidelines below are for intangible aether. Add successive magnitudes for aether with densities of fire, air, water, earth, stone, and metal."
    }

    #t677e85c22d17e13b36e171 ^"Rego Aethera Guidelines" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Aether" FIAT "the new Form of Aether (Dies Irae, Appendix: Aetheric Magic, pp.39-43); the type lists the ten Hermetic Forms"
            ^"Printed Name" STRING "Rego Aethera Guidelines"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 42
        }
        GUIDELINES {
            "Level 2" "Ward an individual or area against aether."
            "Level 3" "Change the density of aether within the target area."
            "Level 5" "Move aether from one location to another."
        }
        DESCRIPTION "Rego Aethera moves aether between naturally-occurring densities, allowing the magus to accrete aether into higher densities or to disperse it into lower density. Magnitude adjustments are required based on the highest density. Aether does not naturally return to its former density, instead remaining in its magically-induced state."
    }

}
