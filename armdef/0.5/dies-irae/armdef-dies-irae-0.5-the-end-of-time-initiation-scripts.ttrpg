EXTENSION "ARMDef_Dies_Irae_TheEndOfTime_InitiationScripts" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Two: The End of Time initiation scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # The chapter's initiation scripts, structured; each DESCRIPTION the source's text, verbatim.

    #tb39f48cb545190670d5564 ^"Initiation Script: Aetheric Magic" DEF {
        EXTENDS #tMCInitiationScriptTypeAAAA ^"Initiation Script"
        PROPERTIES {
            ^"Target Level" STRING "21"
            ^"Script Bonus" STRING "+13"
            ^"Mystery" STRING "Aetheric Magic"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "The initiate must travel to Megiddo (+3), bringing vis to pay for their tuition (+1), where the mystagogue spends time teaching the initiate (+3). The initiation causes a version of a Criamon Stigma to manifest upon the initiate’s brow (+3). This grants the Disfigured Flaw. The initiate swears that they will further disseminate the knowledge of Aetheric Magic any way they can, gaining the Vow Minor Personality Flaw (+3)."
    }

}
