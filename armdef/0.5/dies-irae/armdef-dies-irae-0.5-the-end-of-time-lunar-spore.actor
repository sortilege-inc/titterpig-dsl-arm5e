EXTENSION "ARMDef_Dies_Irae_TheEndOfTime_LunarSpore" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Lunar Spore"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # Lunar Spore (Chapter Two: The End of Time, p35): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t1a5897fb94896778e9109e ^"Lunar Spore" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Lunar Might" STRING "1"
            ^"Characteristics" STRING "Cun –5, Per –5, Pre –5, Com –5, Str –5, Sta –5, Dex –5, Qik –5"
            ^"Size" STRING "–18"
            ^"Qualities" STRING "Camouflage (+3 to rolls to hide when not moving)"
            ^"Magical Qualities" STRING "Improved Damage (bite)"
            ^"Combat" STRING "Bite: Init –5, Atk +4, Def +2, Dam –1"
            ^"Wound Levels" STRING "Dead"
            ^"Abilities" STRING "Brawl (bite) 5, Stealth (shadow) 5"
            ^"Appearance" STRING "a tiny sharp-pointed black seed suspended by a slender stalk from a parachute of fine black hairs."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 35
        }
    }

}
