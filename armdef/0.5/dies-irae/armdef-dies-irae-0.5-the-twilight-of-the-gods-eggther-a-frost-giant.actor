EXTENSION "ARMDef_Dies_Irae_TheTwilightOfTheGods_EggtherAFrostGiant" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Eggther, A Frost Giant"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # Eggther, A Frost Giant (Chapter Five: The Twilight of the Gods, p130): one being, its printed stat lines verbatim fields.

    #t3e0e1e52492bf7fd27cfb5 ^"Eggther, A Frost Giant" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 33
            ^"Form" STRING "Auram"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 14
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER -4
            }
            ^"Size" INTEGER 6
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Magic Human; Magical Monster; Arcane Lore, Berserk, Master of Animal Creatures, Master of Auram Creatures, Piercing Gaze, Reserves of Strength, Voice of the Winter, Warrior; Envious (major), Monstrous Appearance; Baneful Circumstances (mild weather), Cheerful. free with Magic Human"
            ^"Magic Qualities and Inferiorities" STRING "Focus Power, Gigantic (x5), Greater Powers, Major Virtue (Shapeshifter); Auram Resistance, Improved Abilities, Improved Powers, Improved Soak (x3), Minor Virtue (Lesser Immunity to exposure), Personal Power"
            ^"Combat" STRING "Gambanteinn: Init +9 Attack +20, Defense +16, Damage +23 Pole axe: Init –3 Attack +12, Defense +4, Damage +31 Javelin: Init –4, Attack +5, Defense –2, Damage +19 Kick: Init –5, Attack +4, Defense –2, Damage +17"
            ^"Soak" STRING "+14 (+16 when berserk)"
            ^"Wound Penalties" STRING "–1 (1–11), –3 (12–22), –5 (23–33), Incapacitated (34-44), Dead (45+)"
            ^"Equipment" STRING "lap harp, partial chainmail armor, the Gambanteinn. His Combat Totals reflect that he is wielding a sword of excellent quality but do not account for its powers."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "seven pawns of Auram, in his frozen heart."
            ^"Appearance" STRING "Eggther stands 27 feet tall; most humans do not reach his knees. He has long pale hair streaked with white; this and his similarly colored beard are braided into neat plaits. He wears a chain haubergeon and cuirboulli leg and arm protection. Details of the Gambanteinn are found later in this chapter."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 130
        }
        PERSONALITY_TRAITS {
            "Envious" +6
            "Angry" +3
            "Cruel Sense of Humor" +2
        }
        ABILITIES {
            "Animal Handling" SCORE 4 SPECIALTY "wolves"
            "Auram Resistance" SCORE 4 SPECIALTY "lightning"
            "Brawl" SCORE 3 SPECIALTY "kick"
            "Concentration" SCORE 3 SPECIALTY "controlling storms"
            "Great Weapon" SCORE 5 SPECIALTY "pole axe"
            "Leadership" SCORE 4 SPECIALTY "training"
            "Magic Lore" SCORE 4 SPECIALTY "Norse giants"
            "Music" SCORE 3 SPECIALTY "harp"
            "Penetration" SCORE 3 SPECIALTY "hail"
            "Shapeshifter" SCORE 1 SPECIALTY "wolf form"
            "Single Weapon" SCORE 4 SPECIALTY "Gambateinn"
            "Survival" SCORE 4 SPECIALTY "cold climates"
            "Thrown Weapon" SCORE 1 SPECIALTY "javelin"
            "West Norse" SCORE 5 SPECIALTY "incantations"
        }
        POWERS {
            #t08d6f10b2bebfd80136876 ^"Master of Fierce Winds" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1–5 points"
                    ^"Initiative" STRING "–7"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "Eggther can spontaneously conjure Rego Auram effects of fifth magnitude or less that create violent winds or hail. One of his favorite effects is *Charge of the Angry Winds* (ArM5, page 125).(Focus Power), Improved Powers (+2 Init)"
            }
            #t29b1e60b82a2b49950c2bf ^"Gathering of the Stormy Might (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Gathering of the Stormy Might"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–8"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "As the spell on page 129 of ArM5. ReAu 40 (Base 5, +3 Sight, +2 Group, +2 Size): Greater Power (40 levels, –2 Might cost)"
            }
            #ta8e4cb412e3683b5f2957b ^"True Sight of the Air (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "True Sight of the Air"
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "constant effect"
                    ^"Form" STRING "Auram"
                }
                DESCRIPTION "As the spell on page 127 of ArM5. This ability is continuously active. InAu 20 (Base 1, +2 Sun, +4 Vision, +1 continuous effect): Personal Power (20 levels, –1 Might cost), Improved Powers (–1 Might cost, 10 xp Penetration)"
            }
        }
        DESCRIPTION "* see later for details of the Gambanteinn, which mostly works with Eggther ** Add +2 to Attack and –2 to Defense when Eggther is berserk"
    }

}
