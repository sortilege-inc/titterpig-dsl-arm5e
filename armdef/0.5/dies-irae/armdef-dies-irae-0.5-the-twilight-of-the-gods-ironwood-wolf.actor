EXTENSION "ARMDef_Dies_Irae_TheTwilightOfTheGods_IronwoodWolf" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Ironwood Wolf"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # Ironwood Wolf (Chapter Five: The Twilight of the Gods, p129): one being, its printed stat lines verbatim fields.

    #tb4c5ed375fd9ff7b48727f ^"Ironwood Wolf" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Magic" FIXED
            ^"Might" INTEGER 18
            ^"Form" STRING "Animal"
            ^"Season" STRING "Summer"
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -5
                ^"Strength" INTEGER 7
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Magic Animal; Magical Monster; Berserk, Improved Characteristics x 3, Magical Blood, Tough; Wrathful; Nocturnal"
            ^"Mundane Qualities" STRING "Aggressive, Extra Natural Weapons (Claws), Fast Runner, Grapple, Hardy, Imposing Appearance, Keen Sense of Smell, Large Teeth, Pursuit Predator, Tough Hide"
            ^"Magic Qualities and Inferiorities" STRING "Greater Powers, Major Virtue (Greater Immunity to Iron); Improved Attack (Teeth) x 2, Improved Damage (Teeth) x 2, Improved Initiative (Grapple), Improved Might x 3, Improved Soak, Minor Virtue (Lesser Immunity to Silver)"
            ^"Personality Trait" STRING "Terrifyingly Ferocious +6, Cruel +3, Wolf +3, Brave +2 Essential Trait"
            ^"Soak" STRING "+12 when berserk, +2 Attack, +2 Soak, –2 Defense"
            ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
            ^"Vis" STRING "4 pawns of Animal, in teeth."
            ^"Appearance" STRING "A bulky wolf standing five feet at the shoulder and ten feet nose to tail; it has a dark mangy pelt and bloodied jaws. Its human ancestry is evident in its face (which is curiously man-like) and in its uncommon intelligence. Typically, one pins a foe with a grapple while its pack-mates rip the victim apart. Their immunity to iron renders them unaffected by the hostile flora of the Ironwood."
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 129
        }
        COMBAT {
            "Claws" INIT -1 ATTACK 9 DEFENSE 8 DAMAGE 9
            "Teeth" INIT 0 ATTACK 16 DEFENSE 7 DAMAGE 16
            "Grapple" INIT 3 ATTACK 7 DEFENSE 5
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "pursuit"
            "Awareness" SCORE 3 SPECIALTY "prey"
            "Brawl" SCORE 5 SPECIALTY "teeth"
            "Folk Ken" SCORE 2 SPECIALTY "motives"
            "Hunt" SCORE 4 SPECIALTY "human"
            "Leadership" SCORE 3 SPECIALTY "Ironwood wolves"
            "Survival" SCORE 5 SPECIALTY "winter"
            "Swim" SCORE 3 SPECIALTY "upstream"
        }
        POWERS {
            #t354cb402991231ec973ab2 ^"Relentless Search" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "If in possession of an Arcane Connection, an Ironwood wolf always knows the direction to his prey. The scent of his prey is an Arcane Connection lasting Hours. InCo 15 (Base 3, +4 Arc) Greater Power (15 levels, –2 Might cost)"
            }
            #t34cae870b3b25479db2d62 ^"Terrifying Howl (Dies Irae)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Terrifying Howl"
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–2"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The sound of the creature’s howl creates an overwhelming fear in its chosen victim. This might cause them to bolt or cower, depending upon their nature. These wolves prefer to hunt down terrified prey. CrMe 20 (Base 4, +2 Voice, +2 Sun) Greater Power (20 levels, –1 Might cost)"
            }
        }
    }

}
