EXTENSION "ARMDef_Dies_Irae_TheTwilightOfTheGods_Powers" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Five: The Twilight of the Gods powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # The chapter's powers, structured; each DESCRIPTION the source's text, verbatim.

    #tb60ede858e41ecf5028d50 ^"Son of the Eagle (Magogoli power)" DEF {
        EXTENDS #tL4MotIBVF5lx9HoVrT1yDlM ^"Power"
        PROPERTIES {
            ^"Printed Name" STRING "Son of the Eagle"
            ^"Creature" STRING "Magogoli"
            ^"Group" STRING "Greater Power"
            ^"Might Cost" STRING "0 points"
            ^"Initiative" STRING "constant effect"
            ^"Form" STRING "Imaginem"
            ^"Technique and Form" STRING "InIm"
            ^"Level" INTEGER 30
            ^"Effect Design" STRING "(Base 3, +2 Sun, +4 Vision, +1 constant effect)"
            ^"Printed Stat Line" STRING "InIm 30 (Base 3, +2 Sun, +4 Vision, +1 constant effect) Greater Power (30 levels, –3 Might cost)"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "Magogoli can see distant things clearly, making out the details of objects that are miles distant as if they were only a foot away. This is a constant version of *Eyes of the Eagle* (ArM5, page 145)."
    }

}
