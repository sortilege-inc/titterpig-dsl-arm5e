EXTENSION "ARMDef_Dies_Irae_TheTwilightOfTheGods_Tables" {
    NAME "Ars Magica Fifth Edition, Dies Irae - Chapter Five: The Twilight of the Gods tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Dies_Irae_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tf1799a5547a7746cb25528 ^"Realm Interaction Table (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Aura", "Magic Power", "Divine Power", "Faerie Power", "Infernal Power"]
            ^"Table Columns Source" STRING "editorial: the book prints no head for the first column; named Aura for what it lists"
            ^"Source" STRING "Dies Irae"
            ^"Page" INTEGER 142
        }
        TABLE {
            "Magic Aura" "+ aura" "no effect" "– aura" "– aura"
            "Divine Aura" "– (2 x aura)" "+ aura" "– (4 x aura)" "– (5 x aura)"
            "Infernal Aura" "– aura" "no effect" "– (2 x aura)" "+ aura"
        }
    }

}
