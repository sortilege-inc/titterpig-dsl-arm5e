EXTENSION "ARMDef_Faith_and_Flame_Arelat_AhmadIbnNasrOfTytalus" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Ahmad ibn Nasr of Tytalus"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Ahmad ibn Nasr of Tytalus (Chapter Eight: Arelat, p125): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t398ea2a6b79e28fe2111ef ^"Ahmad ibn Nasr of Tytalus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Age" STRING "68 (Apparent Age: 43)"
            ^"Personality Trait" STRING "Carefree +3, Brave +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Directly descended from the founder of the original raider covenant, Nasr ibn Ahmad, the current leader of the pirates is a master of sea magics, jinn and water elementals. Rumor has it he may have been at least partially schooled by a Hermetic sahir of Andalusia and privy to non-Hermetic mysteries learnt from Faerie *jinn*. His spirit familiar is a powerful sea-dwelling *‘afrit* who claims to be a prince of an underwater tribe of *jinn* dwelling near Gibraltar that Ahmad defeated during his self-taught initiation script."
    }

}
