EXTENSION "ARMDef_Faith_and_Flame_Arelat_NicodemusExMiscellanea" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Nicodemus Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Nicodemus Ex Miscellanea (Chapter Eight: Arelat, p132): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #ta15f9590f1ab4427557b38 ^"Nicodemus Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6db295248a1e5be20cb0ac ^"Coenobium Rhodanien"]
            ^"Age" STRING "102 (Apparent Age: 63)"
            ^"Personality Trait" STRING "Absent-Minded +6, Reclusive +3"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "Although Nicodemus was originally a member of House Jerbiton fascinated by the beauty of Roman hydraulic engineering, the multiple Twilight Scars suffered in his youth have resulted in a Blatant Gift. Obsessed with his experiments in Aquam magic, this senior magus has become estranged from his Gently Gifted colleagues. Unable to blend into mundane society easily and live the usual tasteful lifestyle of his housemates, he has reluctantly transferred his allegiance to House Ex Miscellanea.\n\nHe is warily respected by the river-folk and Redcaps that ply the Rhone and known by most boatmen to live as a hermit along the river shore beneath the Pont St Benezet. He is still considered a nominal consul of the Coenobium, although most think his behavior is unbecoming for a former Jerbiton magus.\n\nAlazais has noted that he is becoming less and less interested in behaving according to the expectations of his Housemates. She suspects that Warping from his experiments is slowly taking its toll on his sanity. Nicodemus is increasingly devoting his energies in attempting to integrate the Atlantean magics of his lineage into standard Hermetic theory."
    }

}
