EXTENSION "ARMDef_Faith_and_Flame_Arelat_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Eight: Arelat virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #ta3dcbdd11b5b7d27f78c16 ^"Mythic Blood (Balthazarine)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Hermetic, Major"
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "Balthazarine descent grants a Minor Magical Focus with Fear or Obedience, and the associated Minor Personality Flaw tends to be one of Cruel or Proud. Their granted power is usually a version of *Aura of Rightful Authority *(**ArM5**, page 151) but with Duration Sun and no Penetration, invoked without words by adopting an overly haughty pose. See **ArM5**, page 47 for further details on the Mythic Blood Virtue."
    }

}
