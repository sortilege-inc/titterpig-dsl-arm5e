EXTENSION "ARMDef_Faith_and_Flame_Core_Ext" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - core type extensions"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Core_Base"

    # Faith & Flame is an EXTENSION on the arm5e edition (spec S13 composition). It defines no type of its own:
    # its covenants and characters are .actor files, its places LOCATIONs in its .setting, its records the corpus's types.

}
