EXTENSION "ARMDef_Faith_and_Flame_Gascony_GarusOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Garus of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Garus of Flambeau (Chapter Five: Gascony, p68): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tab14044cd12672bee3e501 ^"Garus of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tcfc9f1b529b46e5de8a9ad ^"Castra Solis"]
            ^"Age" STRING "135 (Apparent age: 80)"
            ^"Personality Trait" STRING "Political +3, Steadfast +2, Mentoring +1"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "Garus has always been very interested in the politics of the region, and his time as Primus of House Flambeau has brought about a great change in its focus and direction. Born and apprenticed in England, he came to Gascony in 1155, immediately after Henry’s marriage to Eleanor of Aquitaine. When Vancasitum, the previous Primus, disappeared in the latter years of the twelfth century, Garus won the primacy due largely to the support of the milites, the Flambeau Hoplites who continued to live at Castra Solis after each of the wars. Under Garus’s influence, they began to think of themselves more as knights in service to their liege."
    }

}
