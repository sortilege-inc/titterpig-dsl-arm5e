EXTENSION "ARMDef_Faith_and_Flame_Gascony_MarcusMinorOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Marcus Minor of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Marcus Minor of Flambeau (Chapter Five: Gascony, p68): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t2e3225bbe09c2801bfd563 ^"Marcus Minor of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tcfc9f1b529b46e5de8a9ad ^"Castra Solis"]
            ^"Age" STRING "119 (Apparent age: 60)"
            ^"Personality Trait" STRING "Pious +3, Charismatic +3, Crafty +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "The next most senior magus is Marcus Minor of Flambeau (so named because at one time there was an elder Marcus living here, who went by Marcus Major). Charismatic and pious, he is the primary Mystagogue of the Legion of Mithras cult at Castra Solis. Insiders know that Marcus and his followers are the true leaders of the covenant. Garus is not even part of the inner circle of the Legion; he has devoted too much of his life to the Provençal political landscape and supporting his milites. Marcus has continued to support the Legion’s traditional Christian focus, and because of his influence the warrior magi at Castra Solis have come to feel something like members of a holy order of knights."
    }

}
