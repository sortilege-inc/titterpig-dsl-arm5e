EXTENSION "ARMDef_Faith_and_Flame_Gascony_SardaWhale" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Sarda Whale"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Sarda Whale (Chapter Five: Gascony, p66): one being, its printed stat lines verbatim fields.

    #t41c296affc438957e28e13 ^"Sarda Whale" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t614fcfe4baefecc1851b8e ^"Gascony"]
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER -3
                ^"Perception" INTEGER -2
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER 19
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER -4
            }
            ^"Size" INTEGER 9
            ^"Confidence Score" STRING "0"
            ^"Virtues and Flaws" STRING "Improved Characteristics, Reserves of Strength, Tough; Poor Eyesight."
            ^"Qualities" STRING "Aquatic, Defensive Fighter, Hardy, Imposing Appearance (x3), Tireless, Tough Hide, Vocal."
            ^"Reputations" LIST ["Creature which drowns sailors 3 (coastlines)"]
            ^"Combat" STRING "Tail: Init –4, Attack +10 Defense +2, Damage +24"
            ^"Soak" INTEGER 10
            ^"Fatigue Levels" STRING "OK, 0, 0, –1, –1, –3, –3, –5, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–14), –3 (15–28), –5 (29–42), Incapacitated (43–56), Dead (57+)"
            ^"Natural Weapons" STRING "Tail (Init 0, Atk +4, Def +2, Dmg +5)"
            ^"Appearance" STRING "Most consider this enormous fish to be quite strange, with a sweet scent evident from its vast mouth and a thick, pebbly hide rather than scales. Strangely, its tail lies flat, instead of vertically. Bad tempered, they are known to smash or overturn boats when harassed by fishermen."
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 66
        }
        PERSONALITY_TRAITS {
            "Patient" +3
            "Cruel" +2
            "Hungry" +2
        }
        ABILITIES {
            "Awareness" SCORE 2 SPECIALTY "food"
            "Brawl" SCORE 4 SPECIALTY "dodge"
            "Music" SCORE 3 SPECIALTY "bellowing"
            "Survival" SCORE 5 SPECIALTY "coastlines"
            "Swim" SCORE 5 SPECIALTY "coastlines"
        }
        DESCRIPTION "*“…dangerous business catching a whale. Better for me to go on the river than to go hunting whales on the open sea… I prefer a fish I can kill, rather than a fish which could kill not only me but also my fellows with a single blow.”* — From the Journal of Jean-Michel, Former Companion of Castra Solis"
    }

}
