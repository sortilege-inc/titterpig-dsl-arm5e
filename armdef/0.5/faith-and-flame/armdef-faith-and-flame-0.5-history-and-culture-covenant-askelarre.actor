EXTENSION "ARMDef_Faith_and_Flame_HistoryAndCulture_CovenantAskelarre" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Askelarre"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Askelarre (Chapter Two: History & Culture, the register of fallen covenants, p10): a fallen covenant, from its register entry.

    #td2b6be3a62efe7ef4dd572 ^"Askelarre" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "945–1011"
            ^"Register Entry" STRING "**Askelarre** (945–1011): A covenant founded by a coven of Hermetic *sorginak* or Basque witches spread throughout the Basque country and destroyed in the Schism War."
            ^"Register Page" INTEGER 10
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 10
        }
    }

}
