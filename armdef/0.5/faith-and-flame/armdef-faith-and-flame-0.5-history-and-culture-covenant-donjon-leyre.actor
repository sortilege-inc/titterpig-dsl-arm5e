EXTENSION "ARMDef_Faith_and_Flame_HistoryAndCulture_CovenantDonjonLeyre" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Donjon Leyre"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Donjon Leyre (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #t3b3e0902cedb1f3bc5c327 ^"Donjon Leyre" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "955–1008"
            ^"Register Entry" STRING "**Donjon Leyre** (955–1008): An early vassal of Montverte, at the fork of the Leyre river in the Landes, it was originally established as a forward base for raiding into the Basque-held Pyrenees. Its founding magi all perished fighting in the Schism War."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
