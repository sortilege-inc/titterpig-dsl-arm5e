EXTENSION "ARMDef_Faith_and_Flame_HistoryAndCulture_CovenantFiliiSinapis" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Filii Sinapis"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Filii Sinapis (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #t304828aa14735e80e813a3 ^"Filii Sinapis" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1063–1215"
            ^"Register Entry" STRING "**Filii Sinapis** (1063–1215): A covenant established by Flambeau of the abandoned Normandy Liege of Sinapis (see *Lion and the Lily,* page 28), the site was abandoned in the wake of the crusade."
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
