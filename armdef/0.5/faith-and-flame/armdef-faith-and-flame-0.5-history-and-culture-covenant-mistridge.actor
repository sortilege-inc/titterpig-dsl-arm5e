EXTENSION "ARMDef_Faith_and_Flame_HistoryAndCulture_CovenantMistridge" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Mistridge"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Mistridge (Chapter Two: History & Culture, the register of fallen covenants, p11): a fallen covenant, from its register entry.

    #t15b686a2af9dd65450c00d ^"Mistridge" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1050–1209"
            ^"Register Entry" STRING "**Mistridge **(1050–1209): This covenant occupied a magical tower situated in the Val du Bosque. A Wizard’s War led by the magus Tres with his magical siege engines destroyed it, spurring a major Tribunal case. (See later)"
            ^"Register Page" INTEGER 11
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 11
        }
    }

}
