EXTENSION "ARMDef_Faith_and_Flame_HistoryAndCulture_Tables" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Two: History & Culture tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t61f8b8ac04bf34d03b4c12 ^"Languages of Southern France (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Language", "Dialects"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 19
        }
        TABLE {
            "Occitan" "Gascon, Provençal/Languedoc, Limousin, Auvergnat, Vivaro-Alpine, Aranese"
            "French" "Bourguignon, Orelanais, Poitevin"
            "Burgundian/Romand" ""
            "Catalan" "Western, Eastern"
            "Lingua Franca" "Western, Eastern"
            "Basque/Euskara" ""
        }
    }

    #td7c2f284f10ad337f5cee7 ^"Languages of Southern France (penalties)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Languages", "Penalty"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 20
        }
        TABLE {
            "Same language, different dialects" "–1 penalty to both speakers"
            "French vs Occitan" "–2 penalty to both speakers"
            "Occitan vs Catalan" "–1 penalty to both speakers"
            "French vs Catalan" "–3 penalty to both speakers"
            "Lingua Franca vs Occitan or Catalan" "–2 penalty to both speakers"
            "Burgundian vs French (Bourguignon) or Occitan (Provençal or Vivaro-Alpine)" "–1 penalty to both speakers"
            "Burgundian vs French (other dialects) or Occitan (other dialects)" "–2 penalty to both speakers"
        }
    }

