EXTENSION "ARMDef_Faith_and_Flame_Narbonnais_EtienneOfMerinita" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Etienne of Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Etienne of Merinita (Chapter Seven: Narbonnais, p111): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t0e5eb9a4fa8f4e2d4ebb5b ^"Etienne of Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tbc2d2b2f60d7a6dd3f3a58 ^"Ara Maxima Nova"]
            ^"Age" STRING "68 (Apparent age: 43)"
            ^"Personality Trait" STRING "Calm +2, Curious +2, Dedicated +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "With Luc since the beginning through a chance fostering, Etienne is primarily responsible for the maintenance and administration of Ara Maxima Nova as well as for interactions with visitors. An Animal, Herbam, Muto and Rego specialist, he contributes by keeping the structures in superior condition with an almost obsessive attention to detail. Stocky and taciturn with dark features and a piercing gaze, Etienne is a former lover of Luc, but ended the relationship when Luc married Miriam. While he is an active member of the cult, he has no desire to seek its innermost secrets. Rather, he wants to remain close to Luc and support the mystagogue’s search for wisdom in anyway possible. Blessed with the Gentle Gift, he has a weakness for sweets and a good game of chess, often making excuses to enter Perpignan looking for both. Outside specific cult initiations, Etienne remains celibate and makes no effort to seek companionship. He does feel the time is right to begin training an apprentice, and intends to search for one very soon."
    }

}
