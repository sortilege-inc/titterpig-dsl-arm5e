EXTENSION "ARMDef_Faith_and_Flame_Narbonnais_GiacomaOfBonisagusFiliusMarcella" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Giacoma of Bonisagus Filius Marcella"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Giacoma of Bonisagus Filius Marcella (Chapter Seven: Narbonnais, p107): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t29fd18a945998176bbf6c3 ^"Giacoma of Bonisagus Filius Marcella" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t89e3531582ad22c2eae1be ^"Stella Durus"]
            ^"Age" STRING "28 (Apparent age: 28)"
            ^"Personality Trait" STRING "Self-Serving +3, Inquisitive +2, Willing to Cut Corners +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "Giacoma is a former apprentice of Marcella who ran up a sizable debt through a Tribunal decision in Rome. Now, owing vis to a vindictive covenant across the Adriatic, she was more than willing to accept an offer from her mater — if she worked with Marcella on her research on the magical spirit of the River Aude for three seasons a year for the next seven years, she could have the vis to pay off her debt, access to the research results, and Marcella would perform her Longevity Ritual. A little bitter about her need to return to the laboratory of her mater, but happy to be clear of the danger she escaped, Giacoma hopes that the results of their investigations will reveal a better way to draw Vim vis from nature spirits, thereby uncovering vis sources in otherwise vis-poor regions. Such a discovery would make Giacoma rich, which is what really concerns her. She loves the temporal power of wealth and often directs her personal research in directions she believes will create it."
    }

}
