EXTENSION "ARMDef_Faith_and_Flame_Narbonnais_OldManOfTheBridgeTheTempterOfStThibery" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Old Man of the Bridge: The Tempter of St. Thibery"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Old Man of the Bridge: The Tempter of St. Thibery (Chapter Seven: Narbonnais, p100): one being, its printed stat lines verbatim fields.

    #t5014fb8aedb200dacc0ce4 ^"Old Man of the Bridge: The Tempter of St. Thibery" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t3a70b7965555119b337ee7 ^"Narbonnais"]
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters (tenetores)"
            ^"Might" INTEGER 15
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -1
                ^"Communication" INTEGER 2
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 3
            }
            ^"Size" INTEGER 0
            ^"Virtues and Flaws" STRING "Puissant Charm, Puissant Guile; Weak-willed"
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Weakness" STRING "Compulsive (The demon can do nothing until it has finished counting coins thrown on the ground and placing them in its purse)"
            ^"Vis" STRING "There are three pawns of Vim vis, in the demon’s money purse."
            ^"Appearance" STRING "The demon manifests as a wizened old man in peasant’s garb, carrying a large bundle of firewood sticks tied to its back. It moves with the assistance of a cane and carries a lantern. It attempts to convince travelers to dive into the river while it watches their possessions—asking for half of what the victim recovers and using its powers to amplify greedy feelings. As the dupe leaps into the river, the demon uses Rushing Wages of Greed, possibly drowning the individual."
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 100
        }
        PERSONALITY_TRAITS {
            "Greedy" +5
            "Selfish" +5
            "Deceptive" +3
            "Tricky" +3
            "Tempter Demon" +3
            "Cowardly" +2
        }
        COMBAT {
            "Fist" INIT 3 ATTACK 3 DEFENSE 5 DAMAGE 3
            " Walking Stick (club)" INIT 4 ATTACK 6 DEFENSE 7 DAMAGE 6
        }
        ABILITIES {
            "Awareness" SCORE 3 SPECIALTY "humans"
            "Brawl" SCORE 2 SPECIALTY "club"
            "Charm" SCORE 4 BONUS 2 SPECIALTY "first encounters"
            "Concentration" SCORE 3 SPECIALTY "maintaining concentration"
            "Folk Ken" SCORE 3 SPECIALTY "humans"
            "Guile" SCORE 5 BONUS 2 SPECIALTY "reducing risks"
            "Penetration" SCORE 1 SPECIALTY "Rushing Wages of Greed"
        }
        POWERS {
            #t26c758ce810f98e68cef0f ^"Coagulation (Faith & Flame)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Coagulation"
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The demon can obtain a material form, which it may dissolve at will."
            }
            #t33f110c757b63523c72480 ^"Obsession (Faith & Flame)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Obsession"
                    ^"Cost" STRING "1–3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "The demon can impose the Obsession Trait of Greed. (*Realms of Power: The Infernal*, pages 31–32)"
            }
            #t7ca3eccffaa5609c37aa05 ^"Envisioning (Faith & Flame)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Envisioning"
                    ^"Cost" STRING "1/5 points"
                    ^"Initiative" STRING "+0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "The demon may appear in the dreams of a sleeping target (which costs 1 point), or make the target experience a waking dream or vision (in which case it costs 5 points). The demon twists the dream, causing the target to imagine life in terrible poverty with extreme needs. This causes the victim to make a Brave Personality roll against an Ease Factor of 9, or suffer natural abject terror and lose a long term Fatigue level."
            }
            #tec41ecfb57e1dbe60e17fa ^"Change Form (Faith & Flame)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Change Form"
                    ^"Cost" STRING "0 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The demon can change the shape of its manifestation at will, to whatever human or animal form it desires. The Old Man of the Bridge may shift into a raven or cause his bundle of firewood to disappear."
            }
            #t53b2721dd49a9ed8e9ca4f ^"Trove Just Beyond Reach" DEF {
                PROPERTIES {
                    ^"Cost" STRING "4 points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "The Old Man creates a phantasm of a cracked strongbox spilling silver and gold coins into the riverbed and lying in plain view of the bridge. The waters around it look deep enough to leap into safely, but clear and very calm. **CrIm 20 R: ** Sight, **D: **Sun, **T: **Individual. (Base 3, +3 Sight, +2 Sun)"
            }
            #ta6efc56adc8150c625191d ^"Rushing Wages of Greed" DEF {
                PROPERTIES {
                    ^"Cost" STRING "8 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Aquam"
                }
                DESCRIPTION "The Old Man creates an area of swiftly flowing, churning water with a strong undertow. Escaping the area requires Swim rolls with a –6 penalty, or the swimmer suffers deprivation from drowning (**ArM5**, page 180). **ReAq 40 R: **Sight, **D: **Conc, **T: ** Part. (Base 5, +3 Sight, +1 Conc + 1 Part +2 Size)"
            }
        }
    }

}
