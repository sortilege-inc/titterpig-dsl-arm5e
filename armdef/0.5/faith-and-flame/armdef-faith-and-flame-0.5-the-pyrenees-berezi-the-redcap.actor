EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_BereziTheRedcap" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Berezi the Redcap"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Berezi the Redcap (Chapter Six: The Pyrenees and the Hispanic March, p86): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #ta786b616d83d5f5130478b ^"Berezi the Redcap" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "48 (Apparent age: 35)"
            ^"Personality Trait" STRING "Prone to Wanderlust +2, Proud +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "One of the resident Redcaps at the *Dorsum *goes by the name of Berezi, and is a descendent of one of the Milvi Antiquiti (see *Houses of Hermes: True Lineages*, page 98), often spending her two seasons of service traveling between Aedes Mercurii and her mother’s home covenant in the Roman Tribunal to obtain and deliver books for the magi of western Provençal. She possesses a magical device that allows her to transform herself and anything she carries into the shape of a bird."
    }

}
