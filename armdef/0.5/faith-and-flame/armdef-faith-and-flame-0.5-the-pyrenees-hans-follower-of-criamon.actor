EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_HansFollowerOfCriamon" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Hans, Follower of Criamon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Hans, Follower of Criamon (Chapter Six: The Pyrenees and the Hispanic March, p87): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tbcb1ed2340b2a0036da43f ^"Hans, Follower of Criamon" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t4044ee43ec9442e477f3e6 ^"Miniata Sophia"]
            ^"Age" STRING "54 (Apparent age: 40)"
            ^"Personality Trait" STRING "Cheerful +3, Sociable +2, Curious +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "The second son of merchant from Aachen, Hans was initially enrolled in a seminary as a youth. A visiting Criamon with a sensitivity for The Gift recognized his aptitude and offered him a chance at another life. Insatiably curious, and a student of languages, Hans loves his time in the village of Niaux and the children there call him “Grandfather Hans.” His Gentle Gift allows him to interact quite amicably with the populace, and he is the favored ambassador with the town. He feels that while he seeks the answer to the Enigma, he should also enjoy his time in this life to its fullest while living as aptly as possible. He is in no rush to find his way down the Path. His specialties are in Rego, Imaginem, and Terram."
    }

}
