EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_MalfortisOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Malfortis of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Malfortis of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tae9dc8ffb9416146a277e9 ^"Malfortis of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "87 (Apparent age: 44)"
            ^"Personality Trait" STRING "Engaging +2, Expressive +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Malfortis of Flambeau is another priest of Mars, though he is not particularly militant. He is an exceptional teacher and a strong writer, and has written a great many books in the covenant’s library. He fulsomely corresponds with anyone who writes to him, though he is generally not particularly friendly in his replies. He is also a staunch supporter of Flammarcus and his beliefs regarding the Founder. Unusually for a Flambeau, he fights barehanded and specializes in Corpus magic."
    }

}
