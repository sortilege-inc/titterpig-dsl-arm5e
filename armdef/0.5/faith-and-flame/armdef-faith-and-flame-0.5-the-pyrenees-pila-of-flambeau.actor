EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_PilaOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Pila of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Pila of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t0fdaf66f6163eaaf5f13e0 ^"Pila of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "103 (Apparent age: 79)"
            ^"Personality Trait" STRING "Couragous +2, Dedicated +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Pila of Flambeau is a priest of Mars and responsible for the covenant’s defenses, duties she takes very seriously, and some would say fanatically. She is a staunch supporter of Flammarcus and his revised version of the Founder’s history. She also considers herself a true “Hoplite” as the term was once used in the Order and dresses like a Greek infantry soldier when going into battle. She looks surprisingly unassuming and mild otherwise. She resides at the *Dorsum*."
    }

}
