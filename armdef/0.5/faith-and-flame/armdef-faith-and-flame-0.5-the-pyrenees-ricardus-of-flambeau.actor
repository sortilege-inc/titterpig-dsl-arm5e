EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_RicardusOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Ricardus of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Ricardus of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p85): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t29fbc696810f775abe8eb5 ^"Ricardus of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "82 (Apparent age: 42)"
            ^"Personality Trait" STRING "Disturbing +2, Sensual +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Ricardus of Flambeau is a priest of Bacchus, openly homosexual, and rumored to have lustful proclivities. Most of the other magi at the *Dorsum* find his company and interests distasteful, especially when they involve the many tractatus he writes. However, he is very social and tends to get involved in covenant business; few activities pass by the council without his input, and so he is often uncomfortably supported at Tribunal. He is said to be accomplished in the Arts of Creo and Mentem."
    }

}
