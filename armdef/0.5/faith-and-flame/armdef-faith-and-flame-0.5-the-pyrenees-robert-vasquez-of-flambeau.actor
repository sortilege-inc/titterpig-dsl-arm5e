EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_RobertVasquezOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Robert Vasquez of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Robert Vasquez of Flambeau (Chapter Six: The Pyrenees and the Hispanic March, p82): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t7118fafd5cd92d32368160 ^"Robert Vasquez of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t103a6a46424a6f8af67b95 ^"Bellaquin"]
            ^"Age" STRING "59 (Apparent age: 42)"
            ^"Personality Trait" STRING "Brave +3, Protective of children +3, Honorable +2, Overconfident +1"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "Valgravian invited Robert to be the covenant’s champion. Chosen for his prestigious reputation as a skilled combatant and an honorable magus, he is a Flambeau with the Gentle Gift, which fit in with Valgravian’s vision. However, Robert insisted that Bellaquin invite the Blatantly Gifted Artemis as a member to assist him. Robert also brought his two children. His son, Michael, has become Captain of the covenant’s guards, transforming them into a disciplined and effective force. His daughter, Carmen, completed her apprenticeship at Bellaquin, passed her Gauntlet five years ago, and left the Tribunal. He is a widower, as his wife died from complications during childbirth.\n\nHis sigil is a faint taste of ashes in the air."
    }

}
