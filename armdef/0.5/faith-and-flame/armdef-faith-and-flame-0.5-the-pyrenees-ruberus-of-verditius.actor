EXTENSION "ARMDef_Faith_and_Flame_ThePyrenees_RuberusOfVerditius" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Ruberus of Verditius"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # Ruberus of Verditius (Chapter Six: The Pyrenees and the Hispanic March, p86): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t4c487e87c78bfc204231e7 ^"Ruberus of Verditius" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tec0fb19694eeeb8b717559 ^"Aedes Mercurii"]
            ^"Age" STRING "99 (Apparent age: 41)"
            ^"Personality Trait" STRING "Concilatory +2, Relaxed +2"
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "Ruberus of Verditius is the leader of the Confraternity of Roland, a group of Verditius magi dedicated to the construction of magical swords (see *Houses of Hermes: Mystery Cults*, page 121). One of the few magi at Aedes Mercurii with no complaint with Castra Solis, Ruberus admires and respects Garus, the Flambeau Primus. However, deep within the mountain of the *Dorsum,* one of the forges of Hephaestus smoulders, and as the priest of Vulcan he is also the caretaker of this important site. This requires that he maintain cordial relations with his covenant-mates and conceal his friendship with Garus. He also greatly admires and even secretly loves Dama, the Praeco, and would do almost anything to protect her."
    }

}
