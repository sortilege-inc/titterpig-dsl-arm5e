EXTENSION "ARMDef_Faith_and_Flame_ValNegra_Devices" {
    NAME "Ars Magica Fifth Edition, Faith & Flame - Chapter Nine: The Lost Covenant of Val-Negra devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Faith_and_Flame_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t2a0fbe81a99dbe70cef316 ^"The Circle of Light" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"Requisite" STRING "Perdo, Terram"
            ^"Level" INTEGER 79
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Constant"
            ^"Target" STRING "Boundary"
            ^"Printed Effect Line" STRING "Mu (Pe)Vi(Te) 79 Pen +0, constant effect R: Touch D: Constant T: Boundary"
            ^"Covenant" LIST [#t351a772376b4e82412716c ^"Val-Negra"]
            ^"Location" LIST [#tbe3faa75343392d23c4a56 ^"The Valley of Mists"]
            ^"Source" STRING "Faith & Flame"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This shrinks access to Val-Negra to a small circle of light ten paces in diameter, preventing anyone seeing into the next level of regio unless standing in it. This spell utilizes the Mystery of Hermetic Architecture and the enchantment Closed Privacy of the Enchanted Regio, both detailed in The Mysteries Revised Edition, page 97."
    }

}
