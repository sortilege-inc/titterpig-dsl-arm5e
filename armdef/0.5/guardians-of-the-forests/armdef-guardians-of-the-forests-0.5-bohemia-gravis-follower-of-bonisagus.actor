EXTENSION "ARMDef_Guardians_of_the_Forests_Bohemia_GravisFollowerOfBonisagus" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Gravis, follower of Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Gravis, follower of Bonisagus (Chapter Ten: Bohemia, p107): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tec72bea4a0e29f63069846 ^"Gravis, follower of Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t754c31269c8fe1555c2c90 ^"Irencillia"]
            ^"Age" STRING "33 (Journeyman)"
            ^"Personality Trait" STRING "Cheerful +2, Driven +2, Sensitive +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "Gravis has come to Irencillia to pursue his life-long fascination with the fae. He is from House Bonisagus, and has found it particularly frustrating that he has been unable to grasp even the basics of Faerie Magic, despite having a knowledge of Faerie Lore that exceeds that of many Merinita magi. Gravis has avoided becoming bitter, however, and still works toward his goal. His caricature Danket is almost his opposite; a grumpy, stick-thin dwarf with a perpetual scowl that contrasts with Gravis’ chubby frame and sunny disposition."
    }

}
