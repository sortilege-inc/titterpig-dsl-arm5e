EXTENSION "ARMDef_Guardians_of_the_Forests_Bohemia_HandriPrimusOfHouseMerinita" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Handri, Primus of House Merinita"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Handri, Primus of House Merinita (Chapter Ten: Bohemia, p105): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t7f4ee825bf3aaf693e72f1 ^"Handri, Primus of House Merinita" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t754c31269c8fe1555c2c90 ^"Irencillia"]
            ^"Age" STRING "81 (Master)"
            ^"Personality Trait" STRING "Obsessively Secretive +6, Indecisive +1, Secure in Position –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "Handri, the Primus of House Merinita, is a secretive man who shares his concerns and plans with only his most trusted advisors. Whereas his predecessor Vinaria encouraged political dialogue with the Primi of other Houses, Handri has turned his attentions wholly to the faeries, conducting long private diplomatic missions into faerie areas. Rumors suggest that he has even met with survivors of House Diedne. Handri is equally secretive about his magical abilities — none can be found who have witnessed him using magic (or will admit to having witnessed it) apart from his signature spell, which earned him the status of master (see Chapter 3: The Rhine Tribunal, Upon being a Rhine magus). Handri has been a magus for about six decades and has trained two apprentices, Iacob and Beechleaf (see Chapter 8: Central Germany, Fengheld), but has not yet (apparently) sought the status of archmage. His caricature is the Queen of Irencillia’s fae, an imperious-looking woman by the name of Rosmert. The caricature of the Primus is always the monarch of the Faerie Court, but whether there is a single, shape-shifting ruler or whether the king or queen changes as regularly as the Primus remains unknown."
    }

}
