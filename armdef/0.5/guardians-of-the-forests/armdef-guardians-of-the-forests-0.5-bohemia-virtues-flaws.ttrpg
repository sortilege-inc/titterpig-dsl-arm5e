EXTENSION "ARMDef_Guardians_of_the_Forests_Bohemia_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Ten: Bohemia virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t6fd29a02433c6ff68323fa ^"Slave" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "New Major Status Flaw: Slave"
            ^"Size" STRING "Major"
            ^"Category" STRING "Status"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "Likely of Slavic origin, you have at some time in your past been sold into captivity and transported to a land beyond your original home. As a possession of your master, you are beholden to his or her will completely, and are only likely to earn your freedom through some exceptional act of service, if ever. Disobedience, on the other hand, will earn you very severe punishment, possibly even death. You have no belongings of consequence, except that which is given to you by your master. Playing a slave will prove to be challenging, and may be difficult unless your master is another player character."
    }

    #tf0b8beda3c15388490a22e ^"Slave-Owner" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "New Minor General Virtue: Slave-Owner"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "You are the owner of one slave. Unless the slave is another player character, your slave will be largely unskilled, and be suitable only as a personal servant. While it is legal to own a slave in Germany, it is frowned upon by the Church and you are likely to receive negative attention in most major cities. You may free your slave at any time, in which case you lose this Virtue. You also lose this Virtue if your slave is killed. You may take this Virtue multiple times."
    }

}
