EXTENSION "ARMDef_Guardians_of_the_Forests_CurseOfTheRhineGorge_Wolkan" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Wolkan"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Wolkan (Chapter Twelve: Curse of the Rhine Gorge, p125): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t75263ffcb28b710e0681ac ^"Wolkan" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per +1, Pre -1, Com +1, Str +1, Sta +1, Dex +2, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "23"
            ^"Decrepitude" STRING "0"
            ^"Virtues and Flaws" STRING "Branded Criminal; Improved Characteristics, Social Contacts; Ambitious"
            ^"Personality Trait" STRING "Self-Interest +3, Loyal 0, Brave -1"
            ^"Combat" STRING "Short Sword: Init +3, Attack +10, Defense +8, Damage +6 Thrown Knife: Init +2, Attack +7, Defense +6, Damage +3 Dagger: Init +2, Attack +7, Defense +5, Damage +4 Fist: Init +2, Attack +4, Defense +4, Damage +1"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, -1, -3, -5, Unconscious"
            ^"Wound Penalties" STRING "-1 (1-5), -3 (6-10), -5 (11-15), Incapacitated (16-20)"
            ^"Abilities" STRING "Athletics 1 (escaping), Awareness 1 (being watched), Brawl 2 (dagger), Carouse 1 (putting at ease), Charm 2 (getting out of trouble), Folk Ken 2 (criminals), High German 5 (criminal cant), Guile 2 (to authorities), Intrigue 3 (outlaws), Leadership 1 (thieves), Legerdemain 3 (filching), Profession: Boatman 2 (rowing), Rhine Lore 3 (criminal types), Single Weapon 4 (short sword), Stealth 3 (in towns), Survival 2 (in towns), Swim 1 (holding breath), Thrown Weapon 3 (knife)"
            ^"Equipment" STRING "2 daggers, short sword, change of clothing."
            ^"Encumbrance" STRING "0 (1)"
            ^"Appearance" STRING "Wolkan would be handsome were it not for the livid brand on his cheek that marks him as a convicted criminal. He has shoulder-length brown hair that he allows to fall across his face, obscuring the brand. He dresses plainly, but has a sense of self-assurance and grace that often impresses people."
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Wolkan was imprisoned on Pfalz Island by Baron Schönburg for theft. Lord Robert offered him freedom from the jail, if he volunteered to assist Robert collecting the tolls. Wolkan has no idea that what he is doing is unjust, or that Lord Robert is any more than he seems to be.\n\nWolkan would make a good grog for a covenant set on Pfalz. He knows the system for toll collection, the selling of the dripstones (see their description on page 124) for protection against the Loreley, and has contacts in towns both up and down the Rhine with a number of minor criminals and mercenaries who might prove useful to the magi. However, he has his own agenda — to gain leadership of his criminal contacts and grow rich on the proceeds. He may use the covenant’s resources to further this ambition."
    }

}
