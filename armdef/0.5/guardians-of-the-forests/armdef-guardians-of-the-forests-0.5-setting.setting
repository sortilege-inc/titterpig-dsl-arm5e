SETTING "ARMDef_Guardians_of_the_Forests_Setting" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - the Rhine Tribunal: places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"

    # The Rhine Tribunal as Guardians of the Forests prints it. HISTORY: Appendix B's timeline (pp.139-143), each
    # entry as printed, its date the PERIOD. LOCATION: the Tribunal, its regions (Chapters Five to Ten), each place
    # those chapters print as a heading, each covenant's site and the buildings on it, Fengheld's chapter houses,
    # and Chapter Twelve's Rhine Gorge, Westerwald and Mosel Valley. TAGS: tribunal, region, covenant (a covenant's
    # site; the covenant itself is an .actor that points here), chapter house, or place. A place's text is in its
    # chapter's .lore, under its heading.

    HISTORY {
        ENTRY ^"53 BC" #tb9c003c8b53cc95fbe8381 {
            PERIOD "53 BC"
            DESCRIPTION "Julius Caesar produces the first written account of the German peoples."
        }
        ENTRY ^"51 BC" #t18b8d04fd4bccafe772d46 {
            PERIOD "51 BC"
            DESCRIPTION "Caesar successfully concludes his campaign in Gaul. The lands immediately to the west of the Rhine are conquered and divided into the provinces of Germania Superior and Germania Inferior."
        }
        ENTRY ^"38 BC" #t14b443642f7d395af3e1e8 {
            PERIOD "38 BC"
            DESCRIPTION "Establishment of a Roman settlement at the site of Cologne."
        }
        ENTRY ^"16 BC" #t30922cdcb1f31d6932d2a2 {
            PERIOD "16 BC"
            DESCRIPTION "Roman founding of Augusta Treverorum (Trier) as a regional capital. This is the oldest city in Germany and predates the Romans."
        }
        ENTRY ^"13 BC" #t940c1b11fc3354a8976b3f {
            PERIOD "13 BC"
            DESCRIPTION "Founding of Moguntiacum (Mainz)."
        }
        ENTRY ^"9 AD" #t343d80006bc7619ee90f90 {
            PERIOD "9 AD"
            DESCRIPTION "The Roman legions are defeated by the Cheruscan hero Arminius (Hermann) at the Teutoburger Forest."
        }
        ENTRY ^"50" #t7c11e22bbf241be7ae6dda {
            PERIOD "50"
            DESCRIPTION "Colonia Agrippensis (Cologne) becomes a city."
        }
        ENTRY ^"51-96" #tc0e610cdb4d78388b60762 {
            PERIOD "51-96"
            DESCRIPTION "Construction of the limes fortifications, which secures Roman territory in the lands beyond the Rhine and the Danube, Germania Magna; the 2nd century AD marks the greatest extent of the Roman empire."
        }
        ENTRY ^"64" #t71a113a08dc7db1b61229f {
            PERIOD "64"
            DESCRIPTION "Establishment of a Mercurian temple at the later site of Durenmar in the Black Forest. The priests of Mercury attempt to usurp the primeval power of the Hercynian Forest that covers most of Germany."
        }
        ENTRY ^"74" #t3af5c8fea14dbb2cf62fb8 {
            PERIOD "74"
            DESCRIPTION "The Black Forest Road is completed with the aid of Mercurian priests."
        }
        ENTRY ^"98" #t1cf028d21ced3153b75472 {
            PERIOD "98"
            DESCRIPTION "Tacitus writes Germania. 3rd century The Romans abandon the limes and retreat in the face of repeated attacks by Franks, Alemanni, and Goths."
        }
        ENTRY ^"306-337" #t5d00a86d47189143b8765e {
            PERIOD "306-337"
            DESCRIPTION "Augusta Treverorum (Trier) reaches its zenith under the rule of Constantine the Great, becoming capital of the western Roman empire; construction of the Cathedral of St. Peter, the oldest church in Germany."
        }
        ENTRY ^"341" #t21e479b7ad20472ca8b376 {
            PERIOD "341"
            DESCRIPTION "Some of the Goths convert to Christianity; Wulfilas becomes the first German bishop and translates the bible to Gothic. 4th century The Huns begin invading Europe."
        }
        ENTRY ^"413" #t411f5cedc6a41ef9361345 {
            PERIOD "413"
            DESCRIPTION "The Burgundians settle in the city of Worms on the Rhine."
        }
        ENTRY ^"430-453" #t72029e4afd139a1ba400e4 {
            PERIOD "430-453"
            DESCRIPTION "Events from the Nibelungenlied: the great knight Siegfried arrives in Worms, weds Kriemhild, and is later slain."
        }
        ENTRY ^"445" #t8ad2d1419a672c53f1da00 {
            PERIOD "445"
            DESCRIPTION "Attila murders his brother and becomes undisputed leader of the Huns."
        }
        ENTRY ^"451" #tc2f9b33d7205de12bf7c63 {
            PERIOD "451"
            DESCRIPTION "Attila conquers the Burgundians at Worms and weds the widowed Kriemhild."
        }
        ENTRY ^"451 (2)" #te67fa82868677fdbff0e3e {
            PERIOD "451"
            DESCRIPTION "The Battle of Chalons — an alliance of Romans, Franks, and Visigoths lead by the legendary Merovech defeat the Huns and Ostrogoths in Gaul, ending Attila’s westward conquests."
        }
        ENTRY ^"452" #t26738e55372c5c57545e0e {
            PERIOD "452"
            DESCRIPTION "Pope Leo miraculously saves the city of Rome from the army of the Huns."
        }
        ENTRY ^"453" #ta15a54bc5c3104599f1dff {
            PERIOD "453"
            DESCRIPTION "The Burgundians war on the Huns and are destroyed; Attila the Hun is killed."
        }
        ENTRY ^"455" #t67891860b5ce9f4ab11620 {
            PERIOD "455"
            DESCRIPTION "The Vandals sack Rome."
        }
        ENTRY ^"470-485" #t14d19c1ea35d8e6bcefc9d {
            PERIOD "470-485"
            DESCRIPTION "Successful campaigns of the Visigoth king Euric across western Europe."
        }
        ENTRY ^"476" #t48fad26a6477e6720ae0f6 {
            PERIOD "476"
            DESCRIPTION "Fall of the western Roman empire as Italy is conquered by the Gothic king Odovacar; the beginning of the Dark Ages."
        }
        ENTRY ^"481" #tebe84df5c84ea9137da95e {
            PERIOD "481"
            DESCRIPTION "Clovis, a Gifted descendent of Merovech, rises to become king of the Franks; the start of the Merovingian dynasty."
        }
        ENTRY ^"496" #tf152002875b6c8a855707f {
            PERIOD "496"
            DESCRIPTION "Clovis is baptized and becomes the first Christian Frankish king. His people follow suit, although paganism takes centuries to fade among the Franks."
        }
        ENTRY ^"507" #t3a88c32fc84de4641b28f0 {
            PERIOD "507"
            DESCRIPTION "Clovis has by now defeated the Romans, the Burgundians, and the Visigoths, united the Franks, and established a capital in Paris."
        }
        ENTRY ^"511" #t817dead0efcec0bc0fdc15 {
            PERIOD "511"
            DESCRIPTION "Death of Clovis, though his magical lineage endures."
        }
        ENTRY ^"561" #t77afa23398e3db612822b1 {
            PERIOD "561"
            DESCRIPTION "Under Chlotar, son of Clovis, the Frankish kingdom has grown to include all of Provence, Burgundy, and Swabia."
        }
        ENTRY ^"567" #tca7595bab5df6ad52625d7 {
            PERIOD "567"
            DESCRIPTION "Sigebert wars on Chilperic; the Frankish kingdom fractures and becomes corrupted."
        }
        ENTRY ^"594" #t0b3ff914d85264310295e9 {
            PERIOD "594"
            DESCRIPTION "St. Gregory of Tours writes the *Historia Francorum *(History of the Franks)."
        }
        ENTRY ^"687" #t4fc9395202847b34f19987 {
            PERIOD "687"
            DESCRIPTION "Pepin “the Large,” of the Frankish mayoral dynasty, gives himself the title* Dux et Princeps Francorum, *and rules most of the Frankish empire. The power of the Merovingian kings is by now insignificant — they are little more than puppets. 7th and 8th centuries Irish and British missionaries begin work in the pagan lands of Germany to the north and east of the land of the Franks — Frisia, Saxony, and Bavaria."
        }
        ENTRY ^"718" #tb26909501c156856988208 {
            PERIOD "718"
            DESCRIPTION "The English monk St. Boniface begins his missionary work throughout Germany."
        }
        ENTRY ^"725" #t25dba7f0e55b39cfcf9cce {
            PERIOD "725"
            DESCRIPTION "St. Boniface miraculously fells the Donar Oak, a great pagan relic, in Thuringia. The potency of pagan magics and relics begins to wane throughout the land, as does belief in the Old Ways. The power of the great Hercynian Forest is broken and divided among the numerous lesser and separate forests it has become."
        }
        ENTRY ^"731" #t73da602cc6b745ea8177a7 {
            PERIOD "731"
            DESCRIPTION "Trianoma meets Bonisagus in his Alpine cave, becomes his apprentice, and learns his great invention, the Parma Magica."
        }
        ENTRY ^"731-767" #tde0ec143df0343a3647750 {
            PERIOD "731-767"
            DESCRIPTION "Trianoma travels widely and contacts numerous wizards who visit with Bonisagus — many of these become Founders. Learning from his visitors, Bonisagus gradually improves his unified system of magic. The mysterious maga Merinita comes out of the wilderness and convinces the sorceress Bjornaer to abandon her shapeshifting tradition and join the new Order. Bjornaer is condemned by her former fellows, including the sorceress Gyongy."
        }
        ENTRY ^"738" #t66dcb11b71988f0e945cf5 {
            PERIOD "738"
            DESCRIPTION "Charles Martel, illegitimate son and successor of Pepin II, campaigns successfully against the barbarian tribes."
        }
        ENTRY ^"742" #t267783774662706e2f159b {
            PERIOD "742"
            DESCRIPTION "Birth of Charles (later Charlemagne), son of Pepin III."
        }
        ENTRY ^"751" #td60909ee03080c09c22917 {
            PERIOD "751"
            DESCRIPTION "Pepin III “the Short” becomes king proper, crowned by St. Boniface; the start of the Carolingian dynasty, as the last of the Merovingians is retired to a monastery. He is the first king to seek the Pope’s anointment."
        }
        ENTRY ^"754-756" #t9d1dfb5e049e960fbc32ac {
            PERIOD "754-756"
            DESCRIPTION "Pepin III campaigns south of the Alps and conquers Lombardy, establishing a German presence in Italy."
        }
        ENTRY ^"754" #t940e188acaa1ea26c6321e {
            PERIOD "754"
            DESCRIPTION "St. Boniface is martyred; he is buried in Fulda."
        }
        ENTRY ^"754-767" #t374a52a0b483e53b9011a0 {
            PERIOD "754-767"
            DESCRIPTION "Bonisagus travels to Durenmar in the Black Forest and establishes a permanent base at the site of a ruined Mercurian temple, where there is room for many magi to work together."
        }
        ENTRY ^"767" #tddf6c94d9dd5397822e8e3 {
            PERIOD "767"
            DESCRIPTION "Foundation of the Order of Hermes at Durenmar. Bonisagus and the other Founders swear the Oath of Hermes. The first Tribunal gathering takes place."
        }
        ENTRY ^"767-773" #tcbb5775b87801de994acdc {
            PERIOD "767-773"
            DESCRIPTION "Flambeau departs Durenmar with a number of his apprentices to found the covenant of Val-Negra in the Pyrenees. Several other magi also depart after the Founding and establish other covenants, based on the Durenmar model."
        }
        ENTRY ^"768" #tf56c1be6c410207b7a874a {
            PERIOD "768"
            DESCRIPTION "Charlemagne becomes king of the Franks."
        }
        ENTRY ^"771" #tdd436ee2bdc5a41ccdd5fc {
            PERIOD "771"
            DESCRIPTION "Bjornaer and her followers travel to the island of Rügen and hold a council. Thereafter, House Bjornaer holds a gathering there every twelve years."
        }
        ENTRY ^"772-782" #t2f41874bf3e8e8393161d2 {
            PERIOD "772-782"
            DESCRIPTION "Charlemagne campaigns at length against the pagan Saxons, and eventually conquers and subdues them. The defeated Saxons face either baptism or death."
        }
        ENTRY ^"773" #t92df11a383b72549e7cf2e {
            PERIOD "773"
            DESCRIPTION "Second Grand Tribunal of the Order of Hermes. Procedures for lesser Tribunals are established: a Tribunal shall consist of at least twelve magi from at least four covenants. Founding of the covenants of Crintera, domus magna of House Bjornaer, and Fenistal, domus magna of House Merinita."
        }
        ENTRY ^"774" #tdd1520ab12bfcfb0752cbf {
            PERIOD "774"
            DESCRIPTION "Charlemagne defeats Desiderius and becomes king of Lombardy. He confirms the “donation” of these lands to the Pope, and becomes protector of the Church."
        }
        ENTRY ^"780" #t2cd76d858bbf83334e99d8 {
            PERIOD "780"
            DESCRIPTION "Inaugural Rhine Tribunal of 919 at Durenmar: Founding of the covenants of Arae Flaviae in Swabia and Rethra in the Eastern Marches."
        }
        ENTRY ^"782" #te4e775a75f3fe535d68aaf {
            PERIOD "782"
            DESCRIPTION "Charlemagne initiates schooling in the Frankish kingdom, and promotes literacy and education."
        }
        ENTRY ^"788-791" #t034a3fe63f5e67929f8a60 {
            PERIOD "788-791"
            DESCRIPTION "Charlemagne campaigns successfully in Slavic lands."
        }
        ENTRY ^"789" #tcbfacd8463c9634a9c5ed7 {
            PERIOD "789"
            DESCRIPTION "The Founder Jerbiton meets with Charlemagne, after having adopted a number of apprentices of the emperor’s mage-smith, Carolinus. Charlemagne issues a decree outlawing sorcery and paganism, but permits “benevolent magic” such as that practiced by Jerbiton."
        }
        ENTRY ^"792" #t9a1dbc8d2373e6f4774027 {
            PERIOD "792"
            DESCRIPTION "The last recorded sighting of the Founder Merinita — she departs to places unknown to seek the spirit of the wilderness. With the loss of its Founder, the covenant of Fenistal is the first to slip into Winter. The new Primus Quendalon founds Irencillia."
        }
        ENTRY ^"799" #t29b8d8b8024e26d131f5e9 {
            PERIOD "799"
            DESCRIPTION "Amongst numerous administratia, Charlemagne initiates the office of “Count Palatine,” a chief justice."
        }
        ENTRY ^"799 (2)" #tde3e11003458babf862da3 {
            PERIOD "799"
            DESCRIPTION "Third Grand Tribunal of the Order of Hermes. Following this, Quendalon, the first Primus of House Merinita, enters faerie woodlands in Bohemia, leaving Myanar in charge of the House."
        }
        ENTRY ^"800" #t317fe61fa8cb9e67eba0cf {
            PERIOD "800"
            DESCRIPTION "Charlemagne is crowned emperor in Rome; re-establishment of the western (Holy) Roman Empire."
        }
        ENTRY ^"801-802" #td4a79509dd4f7791eb4b9c {
            PERIOD "801-802"
            DESCRIPTION "Quendalon reappears, but Myanar refuses to recognize him as the true Quendalon. An internal struggle ensues in House Merinita, resulting in the death of Myanar and the loss of Fenistal. Irencillia becomes the new domus magna of House Merinita, which becomes dominated by faerie magic. The Elder Gild splits from the Hawthorn Gild."
        }
        ENTRY ^"807" #t0745f445be417d381f0243 {
            PERIOD "807"
            DESCRIPTION "The Founder Tytalus enters the Maddenhofen Woods in Bohemia to challenge the Queen of Faerie, and is not seen thereafter."
        }
        ENTRY ^"814" #t735b98d0fcb7527b259dc1 {
            PERIOD "814"
            DESCRIPTION "Death of Charlemagne; he is succeeded by his remaining son Louis “the Pious.”"
        }
        ENTRY ^"817" #t2bb968c189cc5d2bdc996b {
            PERIOD "817"
            DESCRIPTION "Fourth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"831" #tb7143048a5ae77dab2791e {
            PERIOD "831"
            DESCRIPTION "Gathering of Twelve Years at Crintera: Bjornaer speaks her final words to the magi of her House and disappears into the forest in bear-form."
        }
        ENTRY ^"832" #t23466754b151caf261cc5f {
            PERIOD "832"
            DESCRIPTION "Fifth Grand Tribunal of the Order of Hermes. From henceforth, Grand Tribunals will meet every 33 years, regional Tribunals every 7 years from 836 AD."
        }
        ENTRY ^"840-855" #tde8d4c6f5152f628f8e13b {
            PERIOD "840-855"
            DESCRIPTION "Reign of Lothar I."
        }
        ENTRY ^"843" #te7c0255f7a0750cb52edb9 {
            PERIOD "843"
            DESCRIPTION "The Treaty of Verdun ends four years of civil war amongst the grandsons of Charlemagne — his empire is divided among them."
        }
        ENTRY ^"850-948" #t188ef1b7cb31fb0aade849 {
            PERIOD "850-948"
            DESCRIPTION "Hercynius establishes a lineage of Bonisagus magi, and attracts others to his teaching."
        }
        ENTRY ^"855-875" #t907a255307997a7a99a226 {
            PERIOD "855-875"
            DESCRIPTION "Reign of Louis II."
        }
        ENTRY ^"857" #t3fb2e208c3236d62ebe66a {
            PERIOD "857"
            DESCRIPTION "Rhine Tribunal of 996 AA: The spirits of three Twilight magi famously return to the Tribunal gathering."
        }
        ENTRY ^"865" #t01aaf219bf2ffdf298b3bb {
            PERIOD "865"
            DESCRIPTION "Sixth Grand Tribunal of the Order of Hermes. The boundaries of the Tribunals are formally set according to the break up of the Frankish Empire; they are also named as the Rhine, Normandy, Provencal, Britannian, Roman, Theban, Eastern, and Greater Alps Tribunals."
        }
        ENTRY ^"875-877" #t1bdde64e795853501093e8 {
            PERIOD "875-877"
            DESCRIPTION "Reign of Charles II “the Bald.”"
        }
        ENTRY ^"878" #t5f103ff2e8be0ed34be37d {
            PERIOD "878"
            DESCRIPTION "Rhine Tribunal of 1017 AA: The Tribunal adopts firm rules concerning the voting of “retired” magi, ending two decades of controversy."
        }
        ENTRY ^"881" #tc91366c25660fe78000ec4 {
            PERIOD "881"
            DESCRIPTION "Charles III “the Fat” becomes emperor. By now the empire is beset by attacks from Norsemen."
        }
        ENTRY ^"885" #t39dd17f06ada8adb3ff669 {
            PERIOD "885"
            DESCRIPTION "Rhine Tribunal of 1024 AA: The Tribunal abolishes Arae Flaviae and Schwarzburg, and agrees to strict rules for the establishment of new covenants."
        }
        ENTRY ^"887" #t87a3bebdbfe5f14866b39e {
            PERIOD "887"
            DESCRIPTION "Charles III is deposed and the Frankish empire is split into five kingdoms, of which only one is still ruled by a Carolingian, Arnulf of Carinthia. He forces the other, Norse, kings to pay him homage."
        }
        ENTRY ^"896" #t77d174eb635c06d81f0f56 {
            PERIOD "896"
            DESCRIPTION "Arnulf of Carinthia is crowned emperor."
        }
        ENTRY ^"898" #t8a5f9558a9d10f4d508287 {
            PERIOD "898"
            DESCRIPTION "Seventh Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"899" #t214082edbff4b3eb8b85ba {
            PERIOD "899"
            DESCRIPTION "Arnulf dies seemingly of a stroke under suspicious circumstances; two hedge wizards are convicted of his murder and executed."
        }
        ENTRY ^"910" #tf734f91baa3429671bed54 {
            PERIOD "910"
            DESCRIPTION "The empire is beset by attacks from all sides; Hungarians defeat Louis “the Child” at Augsburg."
        }
        ENTRY ^"919" #t809f186440ede2ff2d52e7 {
            PERIOD "919"
            DESCRIPTION "Henry I “the Fowler” of Saxony is elected king."
        }
        ENTRY ^"929" #t44ed66a92efc70a4c95219 {
            PERIOD "929"
            DESCRIPTION "Henry I issues a decree appointing his son Otto as sole king and heir, so ending the Frankish tradition of shared inheritance."
        }
        ENTRY ^"931" #t838eac2d247edddc3eafd2 {
            PERIOD "931"
            DESCRIPTION "Eighth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"933" #t51b441f9dba9da72a5507a {
            PERIOD "933"
            DESCRIPTION "Henry I defeats the Hungarians at Riade."
        }
        ENTRY ^"936" #tf1d9ebea001792e856cf62 {
            PERIOD "936"
            DESCRIPTION "Death of Henry I; Otto I “the Great” crowned."
        }
        ENTRY ^"941" #t61278ed5c75d10b7c48a2e {
            PERIOD "941"
            DESCRIPTION "Rhine Tribunal of 1080 AA: The Rowan Gild is founded by all the followers of House Diedne in the Tribunal, formerly part of the Hawthorn Gild."
        }
        ENTRY ^"955" #t5b1e4a96264c47479c6c37 {
            PERIOD "955"
            DESCRIPTION "In a great victory, Otto I inflicts a final and decisive defeat on the Hungarians at Lechfeld."
        }
        ENTRY ^"955-973" #t5d563de24c36dcc8c55af1 {
            PERIOD "955-973"
            DESCRIPTION "The Slavs and Danes are converted to Christianity. New bishoprics are founded in the Eastern Marches and in Denmark. A number of pagan Slavs retreat to Rügen."
        }
        ENTRY ^"962" #t0ff56f61d883e882ff7991 {
            PERIOD "962"
            DESCRIPTION "Otto I is crowned emperor in Rome."
        }
        ENTRY ^"964" #tc75caab7ab5504acfbef51 {
            PERIOD "964"
            DESCRIPTION "Ninth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"973-983" #te67a2c00ef22abb9704dd4 {
            PERIOD "973-983"
            DESCRIPTION "Reign of Otto II."
        }
        ENTRY ^"983-1002" #td6af53da83d3f0fb483f3c {
            PERIOD "983-1002"
            DESCRIPTION "Reign of Otto III."
        }
        ENTRY ^"990" #te56697cd7ae562ac353857 {
            PERIOD "990"
            DESCRIPTION "Followers of Hercynius leave Durenmar to found Waldherz; first a chapter house, later a (disputed) covenant."
        }
        ENTRY ^"993" #t9bcfe0f2c155396e8d4412 {
            PERIOD "993"
            DESCRIPTION "Magi from Crintera and Rethra sponsor the formation of the covenant of Grand Silesia, the easternmost expansion of the Order to date. The Bjornaer magi of Grand Silesia, along with the Bonisagi of Waldherz, join the Rowan Gild."
        }
        ENTRY ^"997" #t1906b52a6f6084400a3b9d {
            PERIOD "997"
            DESCRIPTION "Tenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1002-1024" #td0f3be68ac61094f7bda4f {
            PERIOD "1002-1024"
            DESCRIPTION "Reign of Henry II."
        }
        ENTRY ^"1004" #t06c74966349ea561491d1f {
            PERIOD "1004"
            DESCRIPTION "Rhine Tribunal of 1143 AA: The entirety of the Rowan Gild is Marched, sparking the Schism War in the Rhine Tribunal. Magi of Tremere and Flambeau destroy the covenants of Oakdell and Waldherz."
        }
        ENTRY ^"1008" #t8f954a7f94e225d5247479 {
            PERIOD "1008"
            DESCRIPTION "A group of Slavic covenants, including Rethra and Grand Silesia, break ties with their sponsors and declare themselves to be members of the New Slavonic Tribunal. Grand Silesia is destroyed in the same year."
        }
        ENTRY ^"1018" #t0402b80949b71305e46c50 {
            PERIOD "1018"
            DESCRIPTION "Rhine Tribunal of 1157 AA: The Schism War is declared to have ended. The Linden Gild arises over the next couple of decades."
        }
        ENTRY ^"1024-1039" #t84b2e8e9dea401247b878b {
            PERIOD "1024-1039"
            DESCRIPTION "Reign of Conrad II; the start of the Salian dynasty. He reaffirms the principle of sole inheritance, campaigns successfully in Italy, and wins the Burgundian crown."
        }
        ENTRY ^"1030" #tea825fad68b0a4b81b1f81 {
            PERIOD "1030"
            DESCRIPTION "Eleventh Grand Tribunal of the Order of Hermes. The New Slavonic Tribunal is given formal authority over the settlement of new covenants in Slavic lands, despite protests from the Rhine Tribunal."
        }
        ENTRY ^"1037" #t2f46931941f35c3c3d0179 {
            PERIOD "1037"
            DESCRIPTION "Conrad II defeats Odo of Champagne in a massive battle at Bar in Upper Lorraine."
        }
        ENTRY ^"1037 (2)" #t6f56779d045a04c63cfb2d {
            PERIOD "1037"
            DESCRIPTION "Introduction into the German feudal system of ministeriales (unfree knights)."
        }
        ENTRY ^"1039" #tc7bd95aedfd3ae98edf553 {
            PERIOD "1039"
            DESCRIPTION "Rhine Tribunal of 1178 AA: The covenant of Fengheld is founded in the Harz Mountains, with the approval of the Tribunal, by veteran Tremere and Flambeau magi returning from the end of the Schism War in Britannia."
        }
        ENTRY ^"1039-1056" #t24a7a92f6d687345a9bf16 {
            PERIOD "1039-1056"
            DESCRIPTION "Reign of Henry III. He campaigns against, and secures the loyalty of Bohemia, Poland, and Hungary. 1048: Aschlaranda, formerly of Waldherz, reappears at Durenmar."
        }
        ENTRY ^"1052" #tdb75841d19e7069635aedf {
            PERIOD "1052"
            DESCRIPTION "In the New Slavonic Tribunal, a number of Bjornaer magi formerly at Grand Silesia settle at the covenant of Pripet Maior. A cross-Tribunal alliance develops between Crintera and Pripet Maior."
        }
        ENTRY ^"1053" #t7b96497a354115d02761a8 {
            PERIOD "1053"
            DESCRIPTION "Rhine Tribunal of 1192 AA: The “Guardians of the Forest” ruling is made. Dankmar is occupied by Aschlaranda and her apprentice Schadrit, but is not recognized by the Tribunal due to Durenmar’s influence"
        }
        ENTRY ^"1056-1106" #t8f1b87419fd010c894a991 {
            PERIOD "1056-1106"
            DESCRIPTION "Reign of Henry IV."
        }
        ENTRY ^"1063" #t84542684dae918f2e0b832 {
            PERIOD "1063"
            DESCRIPTION "Twelfth Grand Tribunal of the Order of Hermes. Wishing to rein in the power of the Rhine Tribunal, the Grand Tribunal rejects its claim over the Polish territory left by the fall of the Covenant of Grand Silesia. This land (along with all Slavic lands) is granted to the New Slavonic Tribunal."
        }
        ENTRY ^"1067" #t7041ac3e1946222ad8c303 {
            PERIOD "1067"
            DESCRIPTION "Rhine Tribunal of 1206 AA: The covenant of Roznov is founded, and Dankmar finally achieves recognition as a Rhine covenant."
        }
        ENTRY ^"1074" #t122eb010c9fe2f5c55f318 {
            PERIOD "1074"
            DESCRIPTION "The Peace of Gerstungen — Henry IV is forced to return the seized territory around Goslar to the Saxons."
        }
        ENTRY ^"1077" #tff8cb948b68db8bcacc1b7 {
            PERIOD "1077"
            DESCRIPTION "Henry IV is humiliated by Pope Gregory VII at Canossa."
        }
        ENTRY ^"1084" #t76601f731593b51d03e9b6 {
            PERIOD "1084"
            DESCRIPTION "Henry IV returns to Rome and is crowned emperor."
        }
        ENTRY ^"1085" #tc2af14b5b9679f8b60fee9 {
            PERIOD "1085"
            DESCRIPTION "A major raid against Durenmar by forces of the King of the Black Mountain, a powerful faerie lord of the Black Forest, results in the death or capture of a number of Bonisagus magi and many covenfolk. (None of those captured are ever returned and their fate is unknown.)"
        }
        ENTRY ^"1096" #tc1865056bd16b0ea20d9f2 {
            PERIOD "1096"
            DESCRIPTION "The First Crusade — Crusaders destroy the Jewish quarter of Worms; there are massacres of Jews in Worms, Speyer, Cologne, Trier (where many choose suicide by drowning instead of forced baptism), Mainz (where many commit ritual suicide with knives in the episcopal palace), and Bohemia. Henry IV attempts to punish those responsible but is not supported by the Church."
        }
        ENTRY ^"1096 (2)" #t4cb6b30e0f530c47fa5358 {
            PERIOD "1096"
            DESCRIPTION "Thirteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1098" #t7cb18909245a386d0b58ac {
            PERIOD "1098"
            DESCRIPTION "Birth of Hildegard of Bingen."
        }
        ENTRY ^"1106-1125" #t06405d27100779c66ca77c {
            PERIOD "1106-1125"
            DESCRIPTION "Reign of Henry V, the last of the Salian dynasty."
        }
        ENTRY ^"1122" #tf7ca3f1f3491f68fabff9b {
            PERIOD "1122"
            DESCRIPTION "Proclamation of the Concordat of Worms, settling the Investiture Contest between papacy and monarchy."
        }
        ENTRY ^"1125" #td3859d2480467368378a1c {
            PERIOD "1125"
            DESCRIPTION "Lothar II is narrowly elected king."
        }
        ENTRY ^"1127" #t5df72f4f742456585ab685 {
            PERIOD "1127"
            DESCRIPTION "Conrad III is elected anti-king by the Swabians; start of conflict between the Welfs and the Hohenstaufens."
        }
        ENTRY ^"1129" #t2965d8023eab8ec543acce {
            PERIOD "1129"
            DESCRIPTION "Fourteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1137" #t6ef694a8f1ec2294d7b586 {
            PERIOD "1137"
            DESCRIPTION "Conrad III is elected king after the death of Lothar II; the start of the Hohenstaufen dynasty."
        }
        ENTRY ^"1144" #tad8c71f778c5a3ec44d4d1 {
            PERIOD "1144"
            DESCRIPTION "Rhine Tribunal of 1283 AA: At the order of the Tribunal, three magi form the covenant of Oculus Septentrionalis, dedicated to investigating the Order of Odin."
        }
        ENTRY ^"1146-1147" #t51a3941cc3fab2a58ddf48 {
            PERIOD "1146-1147"
            DESCRIPTION "The Second Crusade — widespread slaughter of Jews in many Rhine cities and Würzburg, amidst religious fervor. The Saxons mount their own campaign against the pagan Wends in Pomerania and the northeastern Marches."
        }
        ENTRY ^"1151" #tf59ca9377faebc7cdaaa6b {
            PERIOD "1151"
            DESCRIPTION "Rhine Tribunal of 1290 AA: Dankmar accuses Durenmar of faerie molestation and of plundering faerie sites of the Black Forest for vis; with the support of Crintera, Irencillia, and Fengheld, Durenmar is fined ten pawns of vis to every other covenant in the Tribunal and restricted from taking further vis from faerie sites for fourteen years, unless a peace is made with the fae. The covenant of Triamore is founded, attached to the court of Emperor Conrad III, by magi of the newly formed Apple Gild."
        }
        ENTRY ^"1152" #tdce5dcd7b3c2cdfccc852b {
            PERIOD "1152"
            DESCRIPTION "Conrad III dies before being crowned in Rome; he is succeeded by his nephew, Frederick I “Barbarossa.”"
        }
        ENTRY ^"1155" #t8a341fd3a2de090bb63e75 {
            PERIOD "1155"
            DESCRIPTION "Ulm becomes a Free Imperial City."
        }
        ENTRY ^"1157" #t476e5f0e821401b62fb06a {
            PERIOD "1157"
            DESCRIPTION "Henry “the Lion,” duke of Saxony and rival to Frederick I, seizes the settlement of Lübeck and develops it into a city."
        }
        ENTRY ^"1158" #tbd0592db4bb5ac8d7427fc {
            PERIOD "1158"
            DESCRIPTION "Rhine Tribunal of 1297 AA: The magi of Oculus Septentrionalis are fined for not having fulfilled their charter in establishing a base to study the Order of Odin. Agnes of Irencillia extraordinarily announces a sighting of the Founder Merinita in Bohemia, but little credence is paid to this claim."
        }
        ENTRY ^"1162" #t55a1720d43501e1cf61de1 {
            PERIOD "1162"
            DESCRIPTION "Fifteenth Grand Tribunal of the Order of Hermes. The Rhine Tribunal once again loses a boundary dispute over Poland to the Novgorod Tribunal (formerly the New Slavonic Tribunal)."
        }
        ENTRY ^"1164" #t891454715c7968f8e29e9a {
            PERIOD "1164"
            DESCRIPTION "The Relics of the Three Magi are taken by Frederick I from Milan, and placed in the cathedral of Cologne."
        }
        ENTRY ^"1165" #tef5eac6d5f1f5a04716a5e {
            PERIOD "1165"
            DESCRIPTION "Rhine Tribunal of 1304 AA: The covenant of Treverorum are found guilty of interfering in the affairs of mundanes and the Church, given a fine of fifty pawns of vis, and warned in the strongest possible terms to repair relations with the inhabitants of Trier without delay. Oculus Septentrionalis announces its new location in Lübeck to the Tribunal. The Quaesitores, however, prompted by the current troubles of the Tribunal’s other city covenant, Treverorum, insist on additions to their charter. The covenant of Terschelling is founded on the Friesian island of the same name."
        }
        ENTRY ^"1168" #t442ad7918141c5750f0356 {
            PERIOD "1168"
            DESCRIPTION "The island of Rügen is invaded by the Danish king, Valdemar I; the pagan temple of Arkona is broken and christianization of the island begins. Crintera is thrown into confusion and crisis."
        }
        ENTRY ^"1172" #t0746166f2e5447bc682ff0 {
            PERIOD "1172"
            DESCRIPTION "Rhine Tribunal of 1311 AA: Treverorum is abandoned by its sole surviving magus and abolished."
        }
        ENTRY ^"1179" #tb0c074671b5d2c41cc8abc {
            PERIOD "1179"
            DESCRIPTION "Death of Hildegard of Bingen."
        }
        ENTRY ^"1179 (2)" #t01a9b0311110e583766ae7 {
            PERIOD "1179"
            DESCRIPTION "Rhine Tribunal of 1318 AA: Primus Urgen of House Bjornaer accuses Oculus Septentrionalis of aiding the Danish invasion of Rügen, and kills its leader Prudentum in a Wizard’s War."
        }
        ENTRY ^"1180" #t0a1500d6252c4fa907f8f7 {
            PERIOD "1180"
            DESCRIPTION "Henry’s lands in Saxony are divided and he is sent into exile."
        }
        ENTRY ^"1186" #tabc74c3e2157375ff4af02 {
            PERIOD "1186"
            DESCRIPTION "Rhine Tribunal of 1325 AA: Crintera is denied permission from the Tribunal to expel the Danish invaders of Rügen under the “Guardians of the Forest” ruling."
        }
        ENTRY ^"1189" #tfb1f400d8c2e39417a8ca6 {
            PERIOD "1189"
            DESCRIPTION "Hamburg is granted numerous trade privileges by Frederick I and becomes a Free Imperial City."
        }
        ENTRY ^"1182-1192" #tb9857a0fbe8d2556d2e387 {
            PERIOD "1182-1192"
            DESCRIPTION "The Third Crusade."
        }
        ENTRY ^"1190" #t07894ecadccb3437051ea4 {
            PERIOD "1190"
            DESCRIPTION "The Order of Teutonic Knights is founded in Acre, in Palestine."
        }
        ENTRY ^"1190 (2)" #tfe1a138feba9e7b106161c {
            PERIOD "1190"
            DESCRIPTION "Frederick I dies on crusade — he is drowned while attempting to cross the River Seleph in Asia Minor on horseback."
        }
        ENTRY ^"1190-1197" #t94294d147556bb4972b9a2 {
            PERIOD "1190-1197"
            DESCRIPTION "Reign of Henry VI."
        }
        ENTRY ^"1191" #t9f12231cd89f4f33998fdf {
            PERIOD "1191"
            DESCRIPTION "Avarret of Bonisagus is elevated to Primus of House Bonisagus, marking a return to the conservative philosophy of refining the existing Hermetic theory."
        }
        ENTRY ^"1194" #tc54e0f35420562c7b030e2 {
            PERIOD "1194"
            DESCRIPTION "Birth of Frederick, son of Henry VI."
        }
        ENTRY ^"1194 (2)" #tf27da923f530cfa31081a3 {
            PERIOD "1194"
            DESCRIPTION "Rhine Tribunal of 1333 AA, occurring a year late to accommodate the Grand Tribunal: Falke of Bjornaer fails to persuade the Tribunal to permit the defense of Crintera."
        }
        ENTRY ^"1195" #t5fd902e4b26f2cd691d03b {
            PERIOD "1195"
            DESCRIPTION "Sixteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1198" #t2957260d5ea3887f8090f6 {
            PERIOD "1198"
            DESCRIPTION "Two rival kings are elected in Germany: Philip of Swabia (Hohenstaufen) and Otto of Brunswick (Welf)."
        }
        ENTRY ^"1200" #t5ca69e083e3cce1c5e0053 {
            PERIOD "1200"
            DESCRIPTION "Rhine Tribunal of 1339 AA: Another covenant has been destroyed in the Rhine Gorge — Rheinstein falls to an army of irate mundanes, led by the archbishop of Trier. The Tribunal rules that magi are forbidden from practicing any form of magical activity in the Rhine Gorge, for the next twenty years."
        }
        ENTRY ^"1201" #tb5cf3ea8b83389c25495a5 {
            PERIOD "1201"
            DESCRIPTION "The Danish king Valdemar II “the Victorious” conquers Holstein."
        }
        ENTRY ^"1202" #t52fcc6de929eebcd0eb4c0 {
            PERIOD "1202"
            DESCRIPTION "The Livonian Order of the Knights of the Sword is formed in Pomerania and Livonia to prosecute a crusade against the pagans of the Baltic."
        }
        ENTRY ^"1203" #tda52e848096ae0a561e6ef {
            PERIOD "1203"
            DESCRIPTION "Falke of Fengheld covenant becomes Prima of House Bjornaer."
        }
        ENTRY ^"1204" #t8086265d55eec57da8ae21 {
            PERIOD "1204"
            DESCRIPTION "The Fourth Crusade; Constantinople is taken."
        }
        ENTRY ^"1204 (2)" #ta9f9dcbc64ef766936a320 {
            PERIOD "1204"
            DESCRIPTION "A great festival is held at the Wartburg in Thuringia."
        }
        ENTRY ^"1205" #ta4a772652102c2ba080eb8 {
            PERIOD "1205"
            DESCRIPTION "Birth of the legendary knight and minstrel Tannhäuser."
        }
        ENTRY ^"1206" #t53c626430c654278da1c8a {
            PERIOD "1206"
            DESCRIPTION "Albertus Magnus (later to become a famous natural magician and saint) is born."
        }
        ENTRY ^"1207" #tcfe398ffcbb96073db4059 {
            PERIOD "1207"
            DESCRIPTION "Rhine Tribunal of 1346 AA: The new magi of Terschelling controversially rename their covenant Waddenzee, and completely rewrite their charter. After a Quaesitorial investigation, the Tribunal narrowly rules that this does not constitute a new covenant."
        }
        ENTRY ^"1208" #t58f21b153a441d98ad82e3 {
            PERIOD "1208"
            DESCRIPTION "Philip of Swabia is murdered by Otto of Wittelsbach, the Count Palatine, in Bamberg."
        }
        ENTRY ^"1209" #t4deb6b5d41f62642e52604 {
            PERIOD "1209"
            DESCRIPTION "Otto IV (of Brunswick) is crowned emperor in Rome."
        }
        ENTRY ^"1210" #tde4c3a9fbfe434e60013f0 {
            PERIOD "1210"
            DESCRIPTION "Otto IV is excommunicated (and later deposed)."
        }
        ENTRY ^"1213" #tc454b228d89a20abe4af29 {
            PERIOD "1213"
            DESCRIPTION "Before slipping into Final Twilight, Primus Avarret of House Bonisagus selects maga Murion as his successor. This is a deliberate snub to the arguably more qualified Occultes (who he deems too dangerous), and Murion’s selection signifies the continued dominance of the conservative philosophy in the House."
        }
        ENTRY ^"1214" #ta560f78cd2d42761fc0a33 {
            PERIOD "1214"
            DESCRIPTION "The Battle of Bouvines — Philip II, king of France, supported by Frederick, defeats the combined armies of Otto IV, the English, and the Flemish."
        }
        ENTRY ^"1214 (2)" #t10fbf11e7c67559699b7c7 {
            PERIOD "1214"
            DESCRIPTION "Frederick II is crowned king in Aachen."
        }
        ENTRY ^"1215" #t41f9cdc31b9059f60a9205 {
            PERIOD "1215"
            DESCRIPTION "Three Rhine magi found a covenant called Heorot on Zealand (technically territory of the Novgorod Tribunal)."
        }
        ENTRY ^"1217" #t829204b31319dd8a31c943 {
            PERIOD "1217"
            DESCRIPTION "The Fifth Crusade."
        }
        ENTRY ^"1218" #t29564521a14d047bcdba34 {
            PERIOD "1218"
            DESCRIPTION "Death of Otto IV."
        }
        ENTRY ^"1218 (2)" #t7120be33b9f16639210a79 {
            PERIOD "1218"
            DESCRIPTION "Death of Berthold V, the last Zähringen duke of Swabia. The Hohenstaufens subsume much of the Zähringen lands."
        }
        ENTRY ^"1219" #t16192c7bdcbd080fe536e3 {
            PERIOD "1219"
            DESCRIPTION "Nuremberg becomes a Free Imperial City."
        }
        ENTRY ^"1220" #tbf9584ae4a31332b60b00c {
            PERIOD "1220"
            DESCRIPTION "Frederick II grants a number of customs privileges at the Diet of Frankfurt. He then travels to Rome, vows to undertake a new crusade, and is crowned emperor. He spends the next several years in Italy and Sicily. The hedge wizard Michael Scot becomes his court magician."
        }
        ENTRY ^"1221" #tac5069341b36833d064ded {
            PERIOD "1221"
            DESCRIPTION "Rhine Tribunal Gathering of 1360 AA."
        }
        ENTRY ^"1225" #teae1ec156f39486d1eca6c {
            PERIOD "1225"
            DESCRIPTION "Thomas Aquinas (later a saint) is born."
        }
        ENTRY ^"1225 (2)" #taa52702b949b9beb344438 {
            PERIOD "1225"
            DESCRIPTION "Frederick II marries Isabelle of Brienne, heiress to the kingdom of Jerusalem, in Brindisi."
        }
        ENTRY ^"1225 (3)" #taf5469902821061e7ff86f {
            PERIOD "1225"
            DESCRIPTION "Engelbert I, archbishop of Cologne, is murdered."
        }
        ENTRY ^"1226" #ta82dccfac92d31bdf0c053 {
            PERIOD "1226"
            DESCRIPTION "Lübeck becomes a Free Imperial City."
        }
        ENTRY ^"1227" #t458d808ab827c2f7f66b61 {
            PERIOD "1227"
            DESCRIPTION "Frederick II is excommunicated for delay in embarking on crusade (he and his army are struck with fever). The Danish king Valdemar II is defeated; Holstein and Pomerania return to the Holy Roman Empire."
        }
        ENTRY ^"1227 (2)" #t4ca0a69ecf591809e95ce8 {
            PERIOD "1227"
            DESCRIPTION "Rhine Tribunal Gathering of 1366 AA, held a year earlier than usual to accommodate the Grand Tribunal next year. Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1228" #t0813650734ac8d7c3c2a24 {
            PERIOD "1228"
            DESCRIPTION "The Sixth Crusade. Frederick’s lands in Italy are invaded by Pope Gregory IX."
        }
        ENTRY ^"1228 (2)" #t2fd9c368657619c171d68a {
            PERIOD "1228"
            DESCRIPTION "Seventeenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1229" #tf16be43be586b8997bb79f {
            PERIOD "1229"
            DESCRIPTION "Frederick II is crowned king of Jerusalem."
        }
        ENTRY ^"1230" #tc033a960aeb2af6b9b7e8d {
            PERIOD "1230"
            DESCRIPTION "The Treaty of San Germano — Frederick II and the Pope are reconciled; the emperor is absolved."
        }
        ENTRY ^"1235" #tdaabd65a8ecdddc2eec740 {
            PERIOD "1235"
            DESCRIPTION "Frederick II returns to Germany with a varied retinue of Moors and other foreigners, and a menagerie of exotic animals. He marries the English princess Elizabeth at Worms, and imprisons his rebellious son Henry. The Peace of Mainz — promulgation of the Laws of the Empire by Frederick II, the first imperial law in the German language. An imperial court is established and restrictions are placed on the right of private feuds."
        }
        ENTRY ^"1235 (2)" #t134e91940685588862d844 {
            PERIOD "1235"
            DESCRIPTION "Rhine Tribunal Gathering of 1374 AA."
        }
        ENTRY ^"1237" #t2cd1c69694eb27a87265df {
            PERIOD "1237"
            DESCRIPTION "The Livonian Order of the Knights of the Sword is reprimanded and subsumed into the Teutonic Order, after numerous excesses in Baltic lands. The Mongols attack and conquer much of eastern Europe. The Teutonic Order, seizing on the weakness of the Russians, attacks them from the west."
        }
        ENTRY ^"1239" #t07049589a6900d0d9e368f {
            PERIOD "1239"
            DESCRIPTION "Pope Gregory IX excommunicates Frederick II for the second time, labeling him a heretic and beast of the apocalypse."
        }
        ENTRY ^"1239 (2)" #ta8c648012ede10b4fd4ae1 {
            PERIOD "1239"
            DESCRIPTION "Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1240" #t455f29c714972b35231c39 {
            PERIOD "1240"
            DESCRIPTION "The Teutonic Knights conquer Prussia."
        }
        ENTRY ^"1241" #tf43badbb528da42bee1b46 {
            PERIOD "1241"
            DESCRIPTION "The Treaty of Hamburg and Lübeck is signed, marking the beginning of the Hanseatic League; in subsequent decades they are joined by many other northern cities."
        }
        ENTRY ^"1242" #tb5270991cf7b3b888ab318 {
            PERIOD "1242"
            DESCRIPTION "Rhine Tribunal Gathering of 1381 AA."
        }
        ENTRY ^"1243" #t9698ba7448e6c5861040fd {
            PERIOD "1243"
            DESCRIPTION "Famine and a plague of rats spread across Germany."
        }
        ENTRY ^"1245" #t745165465c184a54def5d1 {
            PERIOD "1245"
            DESCRIPTION "Frederick II is deposed by order of Pope Innocent IV. Frederick’s son Conrad struggles to retain control in Germany; the Church is divided between loyalty to the Pope and to Frederick."
        }
        ENTRY ^"1248" #t2dd91077443b1042ddec7e {
            PERIOD "1248"
            DESCRIPTION "Cologne begins construction of a mighty new cathedral, which will be a more fitting home for the Relics of the Three Magi."
        }
        ENTRY ^"1249" #t7a6eb63426d56ad28cd92c {
            PERIOD "1249"
            DESCRIPTION "Rhine Tribunal Gathering of 1388 AA."
        }
        ENTRY ^"1249-1252" #t766ee0a89baf13869ea6c2 {
            PERIOD "1249-1252"
            DESCRIPTION "The Seventh Crusade."
        }
        ENTRY ^"1250" #t1b61ef7d6b71feccd4ee75 {
            PERIOD "1250"
            DESCRIPTION "Frederick II dies in Florentina in Italy. He is succeeded by his son Conrad IV. Aachen and Erfurt become Free Imperial Cities."
        }
        ENTRY ^"1251" #t513a450a29e82890226d11 {
            PERIOD "1251"
            DESCRIPTION "Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1254" #t7fe91b7abdf098596108a5 {
            PERIOD "1254"
            DESCRIPTION "Death of Conrad IV; the Great Interregnum (a period of nineteen years in which the imperial throne remains empty) begins."
        }
        ENTRY ^"1254 (2)" #tff59d4cbda67bb5ef89fe7 {
            PERIOD "1254"
            DESCRIPTION "The right to appoint the German king is by now restricted to seven Electors (Kurfürsten): the archbishops of Mainz, Cologne, and Trier, the king of Bohemia, the duke of Saxony, the Count Palatine of the Rhine, and the margrave of Brandenburg."
        }
        ENTRY ^"1254 (3)" #t90bb9098f74b06dd2dfaf8 {
            PERIOD "1254"
            DESCRIPTION "The Rhine League is formed — an alliance of cities which successfully attacks a number of robber baron castles along the Rhine Gorge. The League supports the claim of William of Holland to the throne, but he dies two years later battling the Friesians."
        }
        ENTRY ^"1256" #t491bc97286e926376e14ec {
            PERIOD "1256"
            DESCRIPTION "Rhine Tribunal Gathering of 1395 AA."
        }
        ENTRY ^"1257" #t7b5e1268e9bbe10eccf5da {
            PERIOD "1257"
            DESCRIPTION "Electors are divided between Richard of Cornwall and King Alfonso of Castile. In the absence of Alfonso, Richard is crowned in Aachen."
        }
        ENTRY ^"1258" #tde1599f46bcd9bdb204db0 {
            PERIOD "1258"
            DESCRIPTION "Crops fail in Germany; famine and disease follows. The flagellant movement arises as a result, the members of which conduct self-flagellation to atone for the sins for which God is punishing them."
        }
        ENTRY ^"1261" #t0ddc21d6a56bbfc13d5714 {
            PERIOD "1261"
            DESCRIPTION "Eighteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1263" #tc5037f994222e5017c198f {
            PERIOD "1263"
            DESCRIPTION "Rhine Tribunal Gathering of 1402 AA, Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1267" #tb544bc6d9d67c5cc6ef4ac {
            PERIOD "1267"
            DESCRIPTION "Death of Tannhäuser."
        }
        ENTRY ^"1270" #tdf258729d82676eccfe6b2 {
            PERIOD "1270"
            DESCRIPTION "The Eighth Crusade."
        }
        ENTRY ^"1270 (2)" #ta1f082f0dae16875a93d0b {
            PERIOD "1270"
            DESCRIPTION "Rhine Tribunal Gathering of 1409 AA."
        }
        ENTRY ^"1273" #t6b7918248cd5edee47207c {
            PERIOD "1273"
            DESCRIPTION "Rudolf I of Hapsburg is elected; the end of the Great Interregnum."
        }
        ENTRY ^"1273 (2)" #t2f4d74c140a5ff4dc9153b {
            PERIOD "1273"
            DESCRIPTION "Thomas Aquinas, having studied under Albertus Magnus, completes the* Summa Theologiae.*"
        }
        ENTRY ^"1274" #tb2c6dced65885a5a2a92ad {
            PERIOD "1274"
            DESCRIPTION "Death of Thomas Aquinas."
        }
        ENTRY ^"1275" #t5dc60d923d800f1ee21dfb {
            PERIOD "1275"
            DESCRIPTION "Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1277" #tb1f4325736f4d6253a6815 {
            PERIOD "1277"
            DESCRIPTION "Rhine Tribunal Gathering of 1416 AA."
        }
        ENTRY ^"1278" #t2ac5716f1839f983874f85 {
            PERIOD "1278"
            DESCRIPTION "The Battle of the Marchfeld — Rudolf I defeats King Otakar of Bohemia near Vienna and claims the duchies of Austria and Styria."
        }
        ENTRY ^"1280" #tb65ea2bd42ea8ba48963cb {
            PERIOD "1280"
            DESCRIPTION "Death of Albertus Magnus."
        }
        ENTRY ^"1284" #t66ea4764157d854b0d35bd {
            PERIOD "1284"
            DESCRIPTION "The Pied Piper of Hamelin miraculously leads away first the city’s rats and then (after he is given no payment) the city’s children with his magical flute."
        }
        ENTRY ^"1284 (2)" #te81ccf0a6879d8cb764f8d {
            PERIOD "1284"
            DESCRIPTION "Rhine Tribunal Gathering of 1423 AA."
        }
        ENTRY ^"1287" #tadcb2ab0db62378c4c60b4 {
            PERIOD "1287"
            DESCRIPTION "Gathering of Twelve Years at Crintera."
        }
        ENTRY ^"1288" #t5d54a6735cd7f92d35c342 {
            PERIOD "1288"
            DESCRIPTION "Cologne becomes a Free Imperial City."
        }
        ENTRY ^"1289" #ted1b3dc15014ee4b43be79 {
            PERIOD "1289"
            DESCRIPTION "Rudolf I restores order to Thuringia at the Diet of Erfurt."
        }
        ENTRY ^"1291" #t68ee82714453c59bee1f3c {
            PERIOD "1291"
            DESCRIPTION "Rhine Tribunal Gathering of 1430 AA."
        }
        ENTRY ^"1291 (2)" #t252db4b8dbb490f0ae8b0e {
            PERIOD "1291"
            DESCRIPTION "Death of Rudolf I; he is succeeded by Adolf of Nassau."
        }
