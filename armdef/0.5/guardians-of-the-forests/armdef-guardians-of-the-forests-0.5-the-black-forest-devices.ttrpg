EXTENSION "ARMDef_Guardians_of_the_Forests_TheBlackForest_Devices" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Six: The Black Forest devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t81d9142ad72dc3d519816f ^"Unraveling the Fabric of (Form)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Knife of Human Bone"
            ^"Talisman" BOOLEAN true
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect, +2 Voice)"
            ^"Final Level" STRING "25 each"
            ^"Printed Effect Line" STRING "PeVi 20; R:Voice, D:Sun, T:Ind"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "A wickedly curved dagger with a serrated blade, enchanted to always be razor-sharp. Attunements: +2 Precise Destruction, +4 Destroy Body, +3 Destroying Minds\n\nTen related effects, one for each Hermetic Form. Each one has 24 uses per day (+5 levels)."
    }

    #t4f7f41a45ee0ff4397a75d ^"Evisceration of Ten Thousand Knives" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Knife of Human Bone"
            ^"Talisman" BOOLEAN true
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 20, +2 Voice, +1 Group)"
            ^"Final Level" STRING "50"
            ^"Printed Effect Line" STRING "PeCo 35; R:Voice D:Mom, T:Group"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "As the spell of his own invention, but with Target Group. Penetration 20 (+10 levels), usable 24 times a day (+5 levels)."
    }

    #ta86582b4af9b6198e44d82 ^"Bind The Gift" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Wizard’s Bridle"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect, +1 Touch, +2 Sun)"
            ^"Final Level" STRING "34"
            ^"Printed Effect Line" STRING "ReVi 30; R:Touch, D:Sun, T:Ind"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "A wicked-looking frame which sits over the head of the victim, forcing his mouth open and trapping his tongue with a spiked metal plate. Chains and rods attach to a set of shackles and manacles, thus preventing both words and gestures. It was created with the assistance of two of Philippus’ filii.\n\nPrevents the casting of any spells of level 25 or below. With 2 uses per day (+1 level) and an environmental tripper (+3), this is a constant effect."
    }

    #t4a1a71b58de5973d856f13 ^"Hinder the Gift" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Wizard’s Bridle"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 55
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect, +1 Touch, +2 Sun)"
            ^"Final Level" STRING "69"
            ^"Printed Effect Line" STRING "PeVi 55; R:Touch, D:Sun; T:Ind"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Reduces the Casting Total of any spells by 25 points. With 2 uses per day (+1 level), a Penetration of 20 (+10), and an environmental tripper (+3), this is a constant effect."
    }

    #tbae12581f6a957d800e956 ^"Circular Ward Against Demons (Guardians of the Forests)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Circular Ward Against Demons"
            ^"Part Of" STRING "The Subtle Chain"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Effect Design" STRING "(Base effect)"
            ^"Printed Effect Line" STRING "ReVi 30; R:Touch, D:Ring, T:Circle"
            ^"Owner" STRING "Philippus Niger of House Flambeau"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "A fine silver chain, 30 feet long and connected into a continuous loop, when laid on the ground, forms a circle 3 paces in diameter. Creates a variety of warding effects, each once per day:"
    }

