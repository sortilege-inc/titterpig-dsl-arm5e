EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_CovenantHeorot" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Heorot"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Heorot (Chapter Nine: The Eastern Marches): the covenant, with its register entry, its location, and references to its people and records.

    #t0ffdc0ea1c67756544b3df ^"Heorot" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1215-present"
            ^"Location" LIST [#t62cf29791c0cd34e80ac00 ^"Heorot"]
            ^"Magi" LIST [#t2bbcfb50f6076b9ede066a ^"Signum Irruptus, follower of Criamon", #t8c8c8d374aca6e5ad2f29d ^"Theoderich of Augsburg, follower of Jerbiton", #t810ee1cddcec052e8ee993 ^"Pancrestis filius Occultes, follower of Bonisagus"]
            ^"Register Entry" STRING "Heorot (1215-present): this covenant, on Zealand in Denmark, is not yet officially part of the Rhine Tribunal, but they intend to be."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 90
        }
    }

}
