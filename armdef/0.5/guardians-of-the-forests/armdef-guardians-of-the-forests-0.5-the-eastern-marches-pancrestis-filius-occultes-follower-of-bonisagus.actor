EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_PancrestisFiliusOccultesFollowerOfBonisagus" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Pancrestis filius Occultes, follower of Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Pancrestis filius Occultes, follower of Bonisagus (Chapter Nine: The Eastern Marches, p91): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t810ee1cddcec052e8ee993 ^"Pancrestis filius Occultes, follower of Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t0ffdc0ea1c67756544b3df ^"Heorot"]
            ^"Age" STRING "28 (Journeyman)"
            ^"Personality Trait" STRING "Ambitious +3, Fearful of Wilderness +2, Decisive –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This young magus is keen to meet with a Norse wizard and learn whatever he can about their magic. He has both a famous master and also a powerful mentor, Archmage Philippus Niger (see Chapter 6: The Black Forest, Durenmar), who has instilled in him the urgent need to reveal these secrets to the Order. However, Pancrestis has a deep-abiding fear of the wilderness, and has yet to penetrate as far as the pagan regions of Scandinavia."
    }

}
