EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_PhylliaFollowerOfBjornaer" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Phyllia, follower of Bjornaer"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Phyllia, follower of Bjornaer (Chapter Nine: The Eastern Marches, p97): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t6cc47194cd8b1d76ed77dd ^"Phyllia, follower of Bjornaer" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t8724b4b6c8366b5d512a48 ^"Crintera"]
            ^"Age" STRING "58 (Master)"
            ^"Personality Trait" STRING "Curious +3, Restless +1, Discreet –3"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "Phyllia is the Eagle Elder, in charge of keeping the council informed of the doings of the rest of the Order. She travels widely and has contacts all over the Tribunal (and beyond), but is a notorious gossip and largely incapable of keeping any secrets she discovers to herself. She has the heartbeast of a polecat, and believes in the Harmonist viewpoint."
    }

}
