EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_SignumIrruptusFollowerOfCriamon" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Signum Irruptus, follower of Criamon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Signum Irruptus, follower of Criamon (Chapter Nine: The Eastern Marches, p90): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t2bbcfb50f6076b9ede066a ^"Signum Irruptus, follower of Criamon" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t0ffdc0ea1c67756544b3df ^"Heorot"]
            ^"Age" STRING "53 (Master)"
            ^"Personality Trait" STRING "Brave +3, Obsessed +3, Mindful of Danger –2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 90
        }
        DESCRIPTION "The leader of the covenant, Signum Irruptus is fascinated with the trolls, who he believes to be descended from degenerate gods. This obsession has so far lead to the death of 14 grogs and the loss of Signum’s own left arm, yet nevertheless he still pursues his dangerous studies."
    }

}
