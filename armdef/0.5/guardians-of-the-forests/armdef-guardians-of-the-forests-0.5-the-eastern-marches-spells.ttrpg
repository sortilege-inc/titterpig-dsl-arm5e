EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_Spells" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Nine: The Eastern Marches spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t3ef40884524d373f48a1fb ^"Sculpt the Living Water" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuAq 20; R:Voice, D:Sun, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Allows the caster to mold water as if it were clay. The shaping procedure is done mentally; once complete the sculpture remains for Sun Duration. (Base 4, +2 Voice, +2 Sun)"
    }

    #t81cf59c5dd3baa701694fd ^"Neptune’s Imprisoning Arms (Guardians of the Forests)" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Neptune’s Imprisoning Arms"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuAq 25; R:Voice, D:Sun, T:Group"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Operates like* Trap of the Entwining Vines*, but the ‘vines’ are made from water, which takes on a semi-solid form for the duration of this spell. The ‘vines’ can hold still a small rowing boat, or up to 6 people. (Base 4, +2 Voice, +2 Sun, +1 Group)"
    }

    #tdaa30b2db58f0903a412fd ^"Appease the Queen of Winter" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 60
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuAq 60; R: Voice, D:Year, T:Boundary, Ritual"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Propitiates the Queen of Winter, who then allows the Baltic Sea to thaw that year. Falke learned this spell with the assistance of the volkhvy of Arkona and a laboratory text in the possession of Crintera. If this spell is cast at Arkona (which Falke and magi of Crintera do every year), the Casting Total receives a bonus of +10, due to the presence of the sun-god Svantovit, who is opposed to the Queen of Winter. (Base 15, +2 Voice, +4 Year, +3 Boundary, Ritual)"
    }

    #tab00c76eb2f6496fcf1775 ^"Still the Raging Waters" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReAq 15; R:Voice, D: Conc, T: Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Causes all the waves on a small body of water to be stilled to mirror-smoothness. (Base 4, +2 Voice, +1 Conc)"
    }

    #tf81984cd020eb88b0627da ^"In Christ’s Footsteps" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 5; R:Per, D:Conc, T:Ind"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Allows the caster to walk on water. (Base 4, +1 Conc)"
    }

}
