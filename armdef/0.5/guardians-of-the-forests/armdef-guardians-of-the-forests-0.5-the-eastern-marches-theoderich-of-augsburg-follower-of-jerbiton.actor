EXTENSION "ARMDef_Guardians_of_the_Forests_TheEasternMarches_TheoderichOfAugsburgFollowerOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Theoderich of Augsburg, follower of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Theoderich of Augsburg, follower of Jerbiton (Chapter Nine: The Eastern Marches, p91): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t8c8c8d374aca6e5ad2f29d ^"Theoderich of Augsburg, follower of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t0ffdc0ea1c67756544b3df ^"Heorot"]
            ^"Age" STRING "37 (Journeyman)"
            ^"Personality Trait" STRING "Morbid +3, Inquistive +2, Laconic +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "Formerly a member of Oculus Septentrionalis, Theoderich is a necromancer and a historian, who raises the ghosts of dead men to interrogate them about the past. Much to his chagrin, he has not found the remains of either King Hrothgar or Beowulf."
    }

}
