EXTENSION "ARMDef_Guardians_of_the_Forests_TheForest_ForestPaths" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Four: The Forest forest paths"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The chapter's forest paths, structured; each DESCRIPTION the source's text, verbatim.

    #t274236b2a6c1695d1814da ^"Path of Aging" DEF {
        EXTENDS #tffea5b3c44838a75d0ccaf ^"Forest Path"
        PROPERTIES {
            ^"1st Sacrifice" STRING "Missing Eye"
            ^"1st Quest" STRING "Complete a Longevity Ritual with the use of rare forest ingredients and a blood sacrifice."
            ^"1st Fruit" STRING "Minor Magical Focus in Aging"
            ^"2nd Sacrifice" STRING "Difficult Longevity Ritual"
            ^"2nd Quest" STRING "Drink from the Fountain of Youth."
            ^"2nd Fruit" STRING "Immortality of the Forest"
            ^"Account" STRING "The Path of Aging"
            ^"Steps" INTEGER 2
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 38
        }
    }

    #t16d2280092e8ce9bdbe70b ^"Path of Energy" DEF {
        EXTENDS #tffea5b3c44838a75d0ccaf ^"Forest Path"
        PROPERTIES {
            ^"1st Sacrifice" STRING "Unpredictable Magic"
            ^"1st Quest" STRING "Live in the forest for a year like an animal, wearing no clothes, cooking no food, using no tools or magic."
            ^"1st Fruit" STRING "Life Boost"
            ^"2nd Sacrifice" STRING "Chaotic Magic"
            ^"2nd Quest" STRING "Conquer the Dragon of the Sauerland, and eat its heart."
            ^"2nd Fruit" STRING "Mythic Blood"
            ^"Account" STRING "The Path of Energy"
            ^"Steps" INTEGER 2
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 39
        }
    }

    #td666279ebcdf8b0dbb4ae6 ^"Path of Warping" DEF {
        EXTENDS #tffea5b3c44838a75d0ccaf ^"Forest Path"
        PROPERTIES {
            ^"1st Sacrifice" STRING "Fragile Constitution"
            ^"1st Quest" STRING "Acquire a Warping Score of 4."
            ^"1st Fruit" STRING "Puissant Enigmatic Wisdom"
            ^"2nd Sacrifice" STRING "Twilight Prone"
            ^"2nd Quest" STRING "Trap a magus opposed to the forest in Twilight"
            ^"2nd Fruit" STRING "Twilight Mastery"
            ^"Account" STRING "The Path of Warping"
            ^"Steps" INTEGER 2
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 39
        }
    }

    #t82b01221fc22dc21eda90f ^"Arcadian Path" DEF {
        EXTENDS #tffea5b3c44838a75d0ccaf ^"Forest Path"
        PROPERTIES {
            ^"1st Sacrifice" STRING "Dispassionate"
            ^"1st Quest" STRING "Cause an important faerie to display an unaccustomed emotion."
            ^"1st Fruit" STRING "Minor Magical Focus in Emotions"
            ^"2nd Sacrifice" STRING "Weak Magic Resistance (When feeling emotion)"
            ^"2nd Quest" STRING "Enchant four magical jewels to store the emotions of one’s heart, liver, spleen, and brain."
            ^"2nd Fruit" STRING "Thief of Emotions"
            ^"Account" STRING "The Arcadian Path"
            ^"Steps" INTEGER 2
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 40
        }
    }

}
