EXTENSION "ARMDef_Guardians_of_the_Forests_TheLowlands_EstridDanessonMagusExMiscellanea" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Estrid Danesson, magus Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Estrid Danesson, magus Ex Miscellanea (Chapter Seven: The Lowlands, p72): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t89e3f24d18f2087eee4a13 ^"Estrid Danesson, magus Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t86c663470ee73ae0f109ac ^"Oculus Septentrionalis"]
            ^"Age" STRING "36 (Journeyman)"
            ^"Personality Trait" STRING "Extroverted +2, Energetic +1, Conciliatory –3"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 72
        }
        DESCRIPTION "Estrid is a relatively recent recruit and is the second Scandinavian wizard to be successfully absorbed by the covenant. Born in Ribe in Denmark, he is the younger cousin and bitter enemy of Eric Ribecus at Waddenzee. Whereas Eric began his Hermetic training early, Estrid joined the Order of Hermes much later, as a hedge wizard specializing in sailing and weather magics. The two magi have battled more than once on the open seas, although it has not yet come to a full Wizard War. A flamboyant and roguish man — the opposite of his rather demure wife — he maintains his sanctum and laboratory on his ship, being more often away at sea than in Lübeck."
    }

}
