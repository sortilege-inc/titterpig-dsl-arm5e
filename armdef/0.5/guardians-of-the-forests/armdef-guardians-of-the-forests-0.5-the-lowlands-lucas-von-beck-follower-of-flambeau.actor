EXTENSION "ARMDef_Guardians_of_the_Forests_TheLowlands_LucasVonBeckFollowerOfFlambeau" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Lucas von Beck, follower of Flambeau"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Lucas von Beck, follower of Flambeau (Chapter Seven: The Lowlands, p67): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tf41ad946979602664dc520 ^"Lucas von Beck, follower of Flambeau" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t5aeee1ad51e04d6e7f8b43 ^"Waddenzee"]
            ^"Age" STRING "45 (Journeyman)"
            ^"Personality Trait" STRING "Aggressive +3, Morbid +2, Blunt +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 67
        }
        DESCRIPTION "Lucas von Beck of House Flambeau is the son of a German altgraf, and seems unwilling to put aside his noble lifestyle, despite being considered dead by his mundane family. Lucas is a very tall, stocky man who is always dressed in black, although since experiencing a Twilight he has the embarrassing problem of having his clothes disintegrate after excessive spell-casting. He is an expert in Perdo magics, and known for his short temper, being likely to end arguments with mundanes who annoy him with swift and brutal applications of Perdo Corpus spells. He has recently started to study necromancy, finding that his pirate life provides him with ample bodies for research."
    }

}
