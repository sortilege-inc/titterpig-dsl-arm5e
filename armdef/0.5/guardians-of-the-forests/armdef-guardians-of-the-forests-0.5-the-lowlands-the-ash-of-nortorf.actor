EXTENSION "ARMDef_Guardians_of_the_Forests_TheLowlands_TheAshOfNortorf" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - The Ash of Nortorf"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The Ash of Nortorf (Chapter Seven: The Lowlands, p68): one being, its printed stat lines verbatim fields.

    #tfc05a84b081d67644a8526 ^"The Ash of Nortorf" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#ta3d45ed204e9411ed35068 ^"The Lowlands"]
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Infernal Might" STRING "15 (with the potential to be 60)"
            ^"Special Powers" STRING "Grant Victory, Grant Virtue (Entrancement), Grant Virtue (Inspirational), Grant Virtue (Tough) The small town of Nortorf in Holstein is unremarkable other than forming a meeting place for the roads to Schleswig, Lübeck, and Hamburg. Unremarkable, that is, except for a small ash seedling that sprouts in the churchyard of Nortorf. Every year, on New Year’s Night, a white horseman on a white horse cuts it down. A black horsemen on a black horse tries to prevent him, but is put to flight. It is prophesied that one day the black horseman will prevail, and the shoot will grow into a tree. When it is tall enough for a horse to be tied beneath it, a king will come with a mighty army and a terrible battle will be fought. The king will not be conquered if his horse remains under the tree during the fight, and fell powers will be granted him."
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 68
        }
        PERSONALITY_TRAITS {
            "Ambitious" +2
        }
    }

}
