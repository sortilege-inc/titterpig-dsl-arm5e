EXTENSION "ARMDef_Guardians_of_the_Forests_TheRhine_RemiOfMuseauFollowerOfJerbiton" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Remi of Museau, follower of Jerbiton"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Remi of Museau, follower of Jerbiton (Chapter Five: The Rhine, p47): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t5995820f93323d90c9a6f7 ^"Remi of Museau, follower of Jerbiton" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tf51de8e450d95b4ea538b6 ^"Triamore"]
            ^"Age" STRING "48 (Master)"
            ^"Personality Trait" STRING "Unpretentious +3, Worldly +3, Cheerful +2"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "Remi is a friendly and effusive magus, a complete contrast to Daria. He is accomplished in all manner of mundane tasks; a veritable polymath who can debate with scholars, hold his own in a fight, track and kill wild game, craft music and poetry, and display any number of other skills. Many of these tasks he achieves without the use of magic; nevertheless, he has many useful and utilitarian spells as well."
    }

}
