EXTENSION "ARMDef_Guardians_of_the_Forests_TheRhine_SiceroFollowerOfTremere" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Sicero, follower of Tremere"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Sicero, follower of Tremere (Chapter Five: The Rhine, p47): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t8746473b94e357fc617d7c ^"Sicero, follower of Tremere" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tf51de8e450d95b4ea538b6 ^"Triamore"]
            ^"Age" STRING "23 (Journeyman)"
            ^"Personality Trait" STRING "Keen to Impress +2, Confident +1, Quiet +1"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "Sicero is the recently Gauntletted filius of Goliard, a famed member of the Stonehenge Tribunal. He secured membership at Triamore based on his mater’s recommendations, and it remains to see whether he lives up to them."
    }

}
