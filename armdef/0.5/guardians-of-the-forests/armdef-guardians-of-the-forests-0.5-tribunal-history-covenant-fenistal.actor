EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantFenistal" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Fenistal"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Fenistal (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #tfa0bd76c80de6b0df3c1c8 ^"Fenistal" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "773-802"
            ^"Register Entry" STRING "**FENISTAL** (773-802): The temple of Diana that was Merinita’s home, this covenant was abandoned on the death of Myanar."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
