EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantOakdell" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Oakdell"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Oakdell (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #tdf98140cd7de14dc8a1ef5 ^"Oakdell" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "931-1008"
            ^"Register Entry" STRING "**OAKDELL** (931-1008): a Diednedominated covenant in the Westerwald, near the Rhine Gorge. On numerous occasions in the 10th century they accused Durenmar of scrying, but these charges were never proven, and the covenant was destroyed in the Schism War."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
