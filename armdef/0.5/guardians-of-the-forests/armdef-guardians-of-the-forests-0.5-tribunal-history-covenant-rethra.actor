EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantRethra" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Rethra"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Rethra (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #tbbec335c1591ce6c58b316 ^"Rethra" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "780-1202"
            ^"Register Entry" STRING "**RETHRA** (780-1202): in Pomerania. This covenant fell out of favor by allying itself with the New Slavonic Tribunal in the 11th century. It entered a deep Winter for many decades, with no contact with other magi, until finally destroyed by the Knights of the Sword."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
