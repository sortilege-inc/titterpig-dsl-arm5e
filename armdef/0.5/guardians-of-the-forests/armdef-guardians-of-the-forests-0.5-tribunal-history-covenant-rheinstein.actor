EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantRheinstein" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Rheinstein"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Rheinstein (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #tb2abb84e218e9e8374cafe ^"Rheinstein" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1123-1200"
            ^"Register Entry" STRING "**RHEINSTEIN** (1123-1200): founded on an island in the Rhine Gorge. They were destroyed by an irate mob of mundanes lead by the archbishop of Trier."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
