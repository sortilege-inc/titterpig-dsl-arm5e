EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantRudiaria" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Rudiaria"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Rudiaria (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #t87ef0b266bf94ec67413ed ^"Rudiaria" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "892-969"
            ^"Register Entry" STRING "**RUDIARIA** (892-969): affiliated to House Flambeau and located in the Rhine Gorge, this covenant suffered from malefic attention, and demonic involvement was suspected in the magical accident that destroyed the covenant."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
