EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_CovenantSirmium" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Sirmium"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # Sirmium (Chapter Three: Tribunal History & Customs, Past and Present Covenants of the Rhine Tribunal, p19): a covenant of the Tribunal’s past, from its register entry.

    #td2d648e6c4fef28d1a23b2 ^"Sirmium" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "822-930"
            ^"Register Entry" STRING "**SIRMIUM** (822-930): located in the March of Meissen, this covenant was destroyed during the Magyar invasion of Germany. Only Wiederich of House Flambeau survived."
            ^"Register Page" INTEGER 19
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 19
        }
    }

}
