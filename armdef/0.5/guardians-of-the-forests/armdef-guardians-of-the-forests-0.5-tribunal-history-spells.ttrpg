EXTENSION "ARMDef_Guardians_of_the_Forests_TribunalHistory_Spells" {
    NAME "Ars Magica Fifth Edition, Guardians of the Forests - Chapter Three: Tribunal History & Customs spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Guardians_of_the_Forests_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t877ec505b7d5961a503354 ^"Perceive the Eyes of Knives" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Printed Stat Line" STRING "InMe 20; R: Touch, D: Mom, T: Room"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "This spell will indicate to the caster whether there is anyone in the target area that has hostile thoughts towards him. Multiple castings are needed to work out precisely who it is that has the hostile thoughts. Tabanus casts this spell with considerable caution and minimal Penetration, so as to avoid inadvertently scrying on a magus. (Base 5, +1 Touch, +2 Room)"
    }

    #t840efb2231a904db83e7b6 ^"Reveal the Magical Deception" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Touch"
            ^"Printed Stat Line" STRING "InVi 25; R: Per, D: Conc, T: Touch"
            ^"Source" STRING "Guardians of the Forests"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "This spell is specifically designed to overcome spells used to hide the traces of magic, such as *Masking the Odor of Magic*. Such magics of concealment are detected if the Penetration total matches the level of the deceptive spell divided by two. (Base 4, +1 Conc, +1 Touch, +2 to determine Technique and Form, +1 complexity)"
    }

}
