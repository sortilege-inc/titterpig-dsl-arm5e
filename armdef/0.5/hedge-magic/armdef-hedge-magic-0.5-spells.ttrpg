                ^"Target" STRING "Ind"
                ^"Code" STRING "TuMa Level 10"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm protects the target against a single Supernatural Ability, Hex in this case (Realms of Power: The Infernal, page 92). The Ease Factor required to use Hex against the wearer is increased by +9 for the duration of the charm. A different version of this charm exists for other Supernatural Abilities."
            REFERENCES {
                "The Infernal" -> #tDdNoj74JYmyOqnwBbsVXaOm ^"The Infernal"
            }
        }

        #twc65F2fH7xYSMDnZmO2WzbR ^"Dispel Fortuna Belli (Single Weapon)" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Vulnero" FIXED
                ^"Form" STRING "Fortunam" FIXED
                ^"Level" INTEGER 5 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "VuFa Level 5"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This curse exists for each Martial Ability. For the duration of the curse, if the character's Attack Advantage using her Single Weapon Ability is greater than 0, both combatants re-roll. If the second roll produces a 0 or negative Attack Advantage, it is used. If it does not, the curse expires and the worse of the two rolls is used. If the player succeeds in a Perception + Magic Lore roll against an Ease Factor of 11 (12 minus the magnitude of the charm), the character realizes that he has been cursed."
            REFERENCES {
                "Single Weapon" -> #teT2LcXE2F4TDMJ6PBCx2GZI ^"Single Weapon"
                "Magic Lore" -> #tFQbQOWCWW5Dv32setj4ZUFy ^"Magic Lore"
            }
        }

        #t2XiDPD7Og5Y3PNcae91vCcK ^"Curse of Weakness" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Vulnero" FIXED
                ^"Form" STRING "Fortunam" FIXED
                ^"Level" INTEGER 25 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "VuFa Level 25"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The victim of this curse becomes especially unlucky when using all Abilities related to Strength, and suffers a –1 penalty to any roll involving that Characteristic. Different versions of the curse exist for all the Characteristics. The character suffers minor problems while doing anything involving Strength — the sweat on his brow stings his eyes as he is lifting something, his footing becomes loose, or his grip slips at just the wrong moment. If the player succeeds in a roll of Perception + Magic Lore against an Ease Factor of 7 (12 minus the magnitude of the charm), the character realizes that he has been cursed."
            REFERENCES {
                "Magic Lore" -> #tFQbQOWCWW5Dv32setj4ZUFy ^"Magic Lore"
            }
        }

        #t6yB2MC3129lBVcwtMa6yG4r ^"Magician’s Boost (Form)" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "SuMa Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm is cast immediately following the casting of another charm. The effect of the first charm increases by 5 levels in power, but cannot exceed the level of the Magician's Boost. The effects of the extra levels of power are for the storyguide to determine, but she should consult the charm guidelines and generally increase the power of the charm by one magnitude. There are three versions of this charm, one for each Form of the learned magician. The charm may never boost more than one charm."
        }

        #tk4g4HTEH52srqE7c1PUZs90 ^"Revive the Fading Amulet" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "SuMa Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm allows the caster to increase the number of charges in an amulet he created by one. The level of the amulet's effect must be less than or equal to the level of the charm. This charm can never increase the number of charges an amulet has above the number it had when created, and the charm may only be used on a single amulet a number of times equal to the initial charges of the amulet."
        }

        #tGkxkBFnvvFvNPb2cadQ4r7s ^"Magician’s Second Wind (Duration)" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "SuMa Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm is cast immediately following the casting of another charm. If the level of the first charm is less than or equal to the Magician's Second Wind, the Duration of the initial charm is increased by one—meaning a Momentary charm becomes a Diameter charm, and a Diameter charm becomes a Sun charm. However, in no event may a charm ever be increased beyond Sun Duration, and the final charm level may not be higher than the level of the Magician's Second Wind spell. There are three versions of this charm, one for each parameter: Range, Duration, and Target. This charm may never improve the same charm's Duration more than once."
        }

        #tbqZG3XhgUtxcbZT17VHdv3F ^"Stifle the Lengthy Sickness" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Vulnero" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Individual"
                ^"Code" STRING "VuMa Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm reduces the Duration of a magical effect causing disease or sickness. If the level of the charm + a stress die (no botch) + 10 is at least double the casting total of the targeted spell-like effect, the Duration of the spell is recalculated using one less magnitude than the original spell. For example a Moon Duration (+3 magnitudes) Hermetic spell would be reduced to Sun Duration (+2 magnitudes). If the magical effect's duration is not determined by magnitude, as in some Supernatural Abilities, the duration is reduced by half. To determine the spell level equivalent of a Supernatural Ability, use the Ability score x 5. A different charm exists for each type of magical curse or spell. This charm does nothing to affect spells of Momentary Duration."
        }

        #tqu6dJoG0RrqTlBjdd3cTmVc ^"Charm of Protection Against the Faerie" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Vulnero" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "VuMa Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "Creatures with Faerie Might equal to or less than the level of the spell are unable to affect Individual. The spell must penetrate the Faerie creature's Magic Resistance to have an effect. The charm doesn't affect spells or Supernatural Abilities unless the creature responsible for the effect has a Might Score. Different versions of the charm exist for the other realms."
            REFERENCES {
                "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
            }
        }

        #tu9rZVsQurzzaawRHj6ESePa ^"Charm of Protection Against the Attacks of Semita Errabunda" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Tueor" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 15 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TuSa Level 15"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm protects a person from non-magical attacks by the residents of Semita Errabunda, a narrow category of damage. The recipient of the charm receives a +4 to his Defense Total for the Duration of the charm. The charm protects against attacks by any member of the covenant of Semita Errabunda regardless of the weapon used, so long as it is not magical."
        }

        #tLgO1DZPbGUxeeZWsMXLWLwW ^"Charm of Protection Against Achilles’ Bane (Arrows)" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Tueor" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 5 FIXED
                ^"Range" STRING "Per"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TuSa Level 5"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "When an arrow successfully strikes the caster, he is protected by this charm. The charm adds +8 to the character's Soak Total against any non-magical arrow, a broad category of damage. The Soak bonus of this charm is cumulative with the character's Soak provided by armor, the Tough Virtue, or any other source, but multiple charms do not stack. If a character has two or more charms protecting against the same form of damage, only the more-powerful charm works. Versions of this charm exist for all common weapons and must be learned individually."
        }

        #te26GasxmVPCZf9GF4LQLLFx ^"Charm of Warding Against Unwanted Pests" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Tueor" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 5 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TuSa Level 5"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The charm protects the recipient against all forms of pests, including insects, spiders, lice, etc., none of which may come in contact with the person. Creatures with a Might score of any type are not affected by the ward."
        }

        #t7ybXyNbUcTvSZZNGGCnn0OG ^"Amulet for an Ample Harvest" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Season"
                ^"Target" STRING "Bound"
                ^"Code" STRING "SuSa Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This amulet protects a single field of crops, and ensures that they will be healthy and fruitful. The amulet protects against non-magical blight and other diseases, but does not control the weather or prevent anyone from harming the crops. The crops under the protection of the amulet are healthier, larger, and tastier than normal. The amulet can affect any crops, from wheat to an orchard or vineyard. The amulet must be created with two charges, and buried somewhere within the confines of a well-demarcated field on the Vernal Equinox and remain buried until the Autumnal Equinox. The additional charge allows the amulet to reactivate at the Summer Solstice."
        }

        #tbhzsMiTcLpQVIZv8JB4a3Cz ^"Charta for Healing a Broken Limb" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 4 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Moon"
                ^"Target" STRING "Ind"
                ^"Code" STRING "SuSa Level 4"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charta provides a +6 bonus to all Recovery rolls for healing a broken limb. To be effective, the charta must remain in contact with the person, directly over the wound. Once the character is healed, the charta may be removed with no adverse consequences. There are different chartae for all common injuries, diseases, and poisons, which must be created individually. There are different formulae for specific areas of the body, as well. A charta for a cut to the head is ineffective in healing a cut to the abdomen, for instance."
        }

        #t2LT6G93K286dxQdM20J72lJ ^"Amulet of Longevity" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Succurro" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 5 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Season"
                ^"Target" STRING "Ind"
                ^"Code" STRING "SuSa Level 5"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This amulet provides a +2 bonus to the bearer's Living Conditions modifier. For the charm to affect the character's Aging Total, it must be worn the entire year and it must be created with four charges. The effects of the amulet are cumulative with other Living Conditions modifiers, but in no case may the total Living Conditions modifier exceed +10."
        }

        #t0Wg7GEB32lC2P0JZxBQMF5k ^"Curse of Coughing Fits" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Vulnero" FIXED
                ^"Form" STRING "Salutem" FIXED
                ^"Level" INTEGER 10 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "VuSa Level 10"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This curse causes the character to cough uncontrollably for its duration. A victim must make an Intelligence + Concentration roll against an Ease Factor of 12 to successfully cast or maintain a spell while affected. All others are at –2 to most activities while coughing."
        }

        #ttoRjQ5p9YW01MjvBk6SD7B5 ^"Curse of Quotidian Fever" DEF {
            EXTENDS ^"Hedge Spell"
