                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Tueor" FIXED
                ^"Form" STRING "Magicam" FIXED
                ^"Level" INTEGER 10 FIXED
                ^"Range" STRING "Per"
                ^"Duration" STRING "Diam"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TuMa Level 10"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This charm adds +4 to the caster's Defense Total for any magical earth- or stone-based attacks aimed at him. A different version of this charm exists for other types of magical damage."
        }

        #tpPHv7PKQMDGmAQFvnYhku0Y ^"Charm Against the Hex" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Learned Magicians" FIXED
                ^"Technique" STRING "Tueor" FIXED
                ^"Form" STRING "Magicam" FIXED
