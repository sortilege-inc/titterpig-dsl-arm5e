                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell allows the gruagach’s fetch to relay the contents of any conversation by participants who are within the caster’s field of vision."
        }

        #t6fkCQxzCnRrhQop0G7VzbTR ^"Track the Presence of Vis" DEF {
