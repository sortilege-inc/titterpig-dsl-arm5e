EXTENSION "ARMDef_Hedge_Magic_Spells" {
    NAME "Ars Magica Definitive Edition, Hedge Magic [Revised Edition] - Hedge Spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ARMDef_Hedge_Magic_Core_Ext"

    #tSt14g6x7vRwoVqiIUYuHPyL ^"The Numbness of The Gift" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Intellego" FIXED
                ^"Form" STRING "Vim" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Personal"
                ^"Duration" STRING "Conc"
                ^"Target" STRING "Touch"
                ^"Code" STRING "InVi Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "When the caster places his hand on another character who has The Gift, his hand feels numb. This effect must penetrate the Magic Resistance (if any) of the character whose Gift is being sensed, and if that character is a member of the Order of Hermes, casting this spell normally counts as scrying (which is prohibited by the Code). This spell is based on the “detect the traces of powerful magic” guideline. If the target has the Blatant or Gentle Gift, the spell still works."
            REFERENCES {
                "The Gift" -> #tl8PlKeRUtDRy1gIvS6afpp4 ^"The Gift"
                "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
                "Order of Hermes" -> #tARMDefConceptOrderOfHermes ^"Order of Hermes"
                "Gentle Gift" -> #tc41u2TzdGx1UBJfs3U158b7 ^"Gentle Gift"
            }
        }

    #tLkev90FoFkDWwM01Qnrdt3O ^"Traveller’s Respite" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Creo" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 30 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Momentary"
                ^"Target" STRING "Group"
                ^"Code" STRING "CrCo Level 30"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This ritual spell restores one Long-Term Fatigue level to up to 10 individuals. Note that as this is a Ritual spell, the caster will lose at least one Long-Term Fatigue level himself, and possibly more if his Casting Total is low (see **ArM5** page 81)."
            REFERENCES {
                "Long-Term Fatigue" -> #tA6lYfqs2xXcxN8QIypXXGQm ^"Long-Term Fatigue"
                "Long-Term Fatigue" -> #tA6lYfqs2xXcxN8QIypXXGQm ^"Long-Term Fatigue"
            }
        }

        #tp04WGLNh2a4NeMtTofaI5mH ^"Pungent Potion of Ease" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Creo" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Individual"
                ^"Code" STRING "CrCo Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "When this potion is drunk, a Short-Term Fatigue level is restored, but the character gains a Long-Term Fatigue level when the effect expires. The character must be conscious to drink this potion, and as it is very pungent he must make a Stamina roll against an Ease Factor of 3 to avoid gagging, which wastes the potion."
            REFERENCES {
                "Short-Term Fatigue" -> #tNbId0uqvo83QRHb9qL03TY8 ^"Short-Term Fatigue"
                "Long-Term Fatigue" -> #tA6lYfqs2xXcxN8QIypXXGQm ^"Long-Term Fatigue"
            }
        }

        #tyRXlKN44tXtTmUOBHuydn3h ^"Energy Sense" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Intellego" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Momentary"
                ^"Target" STRING "Individual"
                ^"Requisite" STRING "Me"
                ^"Code" STRING "InCo(Me) Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The caster senses the Fatigue status of the target (winded, weary, tired, etc)."
        }

        #tECACzjAcmYEYb75qQFdCOcr ^"Circle of Lethargy" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Perdo" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 30 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Ring"
                ^"Target" STRING "Circle"
                ^"Code" STRING "PeCo Level 30"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "Targets within the circle do not regain Fatigue levels by resting. This can keep a character unconscious indefinitely, unless he is moved from the circle or the circle is broken."
        }

        #tS8tuk9ooQd7goyLBZ37ZwDJ ^"Lens of Glimpsing Spirits" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Intellego" FIXED
                ^"Form" STRING "Imaginem" FIXED
                ^"Level" INTEGER 34 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Constant"
                ^"Target" STRING "Vision"
                ^"Requisite" STRING "Me"
                ^"Code" STRING "InIm(Me) Level 34"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This device is a crystal lens about the size of a fist, which is inset into a brass ring etched with Hermetic script. When a character looks through this lens, he can see spirits with Mentem Mights even if they are normally invisible. The character can target spirits seen in this way with spells, but must add 3 to any Concentration Ease Factors due to the awkwardness of using the lens. The character can also use the lens to engage in melee combat with an invisible spirit, with a penalty of 3 to his Attack Score, although obviously if the spirit is incorporeal the character requires a suitable magical weapon. The lens does not need to penetrate the Magic Resistance of the spirit."
            REFERENCES {
                "Ease Factors" -> #tGQufzy8y8Qc3foo2n9p7nMU ^"Ease Factor"
                "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
            }
        }

        #t4zAnUB9Dxv76ZRXnikMI907 ^"Eyes for the Prince" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Intellego" FIXED
                ^"Form" STRING "Vim" FIXED
                ^"Level" INTEGER 15 FIXED
                ^"Range" STRING "Personal"
                ^"Duration" STRING "Concentration"
                ^"Target" STRING "Vision"
                ^"Code" STRING "InVi Level 15"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The caster can detect Faerie creatures with a Might of 40 or higher. The effect allows the caster to recognize the creature even if it is disguised or invisible, and does not need to penetrate the creature’s Magic Resistance. The effect does not allow the caster to see through intervening objects, however."
            REFERENCES {
                "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
            }
        }

        #t3WBnmtFH44AZsRkQdfwKUyj ^"Stout Potion" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Creo" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 60 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Momentary"
                ^"Target" STRING "Individual, Ritual"
                ^"Code" STRING "CrCo Level 60"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The character who drinks this dark, bitter potion has his Stamina increased by 1 to a maximum of +5."
        }

        #tMC6WmIqe8iTIPvJF0iO65sF ^"Oil of Prometheus" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Creo" FIXED
                ^"Form" STRING "Ignem" FIXED
                ^"Level" INTEGER 60 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Diameter"
                ^"Target" STRING "Boundary, Ritual"
                ^"Code" STRING "CrIg Level 60"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This oil is carefully poured onto the ground at a Boundary — a city wall, or the edge of a forest, for example — which erupts into flame. From the site of ignition, which is about a pace in diameter, the conflagration rapidly spreads through the Boundary doubling in diameter every round until it covers an area up to 60 miles in diameter. The fire burns incredibly fiercely (+20 damage) for the Duration of the effect — even stones burn and iron melts. When the effect expires the fire no longer spreads with supernatural speed or heat, but any fires begun continue to burn naturally. The potion must be poured on the edge of a defined Boundary to have an effect (see **ArM5**, page 113)."
        }

        #t8UY63682xSPjQlDg3N3MLJC ^"Dram of the Lion" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Hermetic" FIXED
                ^"Technique" STRING "Muto" FIXED
                ^"Form" STRING "Corpus" FIXED
                ^"Level" INTEGER 35 FIXED
                ^"Range" STRING "Touch"
                ^"Duration" STRING "Year"
                ^"Target" STRING "Individual, Ritual"
                ^"Requisite" STRING "An"
                ^"Code" STRING "MuCo(An) 35"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "Drinking this potion causes the character to change into a lion for a year. When the character returns to normal, he may temporarily retain some leonine aspect."
        }

    #tpKoNmNFwxkbXLjH5pVWxxX5 ^"Blessing of Urban Wisdom for the Rustic" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Blessing" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvBl Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell grants the target the Virtue of Clear Thinker with a General Limit. Although this spell grants the Virtue Clear Thinker, other spells exist that could be used to grant other Minor Virtues.\n\nExample: The spell could be limited until the target himself dissembles or participates in some form of subterfuge."
            REFERENCES {
                "Clear Thinker" -> #tZhGTYvDqaozEHMkmAT3Xpbn ^"Clear Thinker"
                "Clear Thinker" -> #tZhGTYvDqaozEHMkmAT3Xpbn ^"Clear Thinker"
            }
        }

        #tFPfilCLTGkBt5DVCgxcI6dc ^"Blessing of the Swordsman’s Expertise" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Blessing" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvBl Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell gives the target +2 to his score in the Ability Single Weapon. Although this spell grants a bonus to Single Weapon, different spells could grant bonuses to different Abilities.\n\nExample: The spell could be limited until the target suffers a Medium Wound in combat."
            REFERENCES {
                "Single Weapon" -> #teT2LcXE2F4TDMJ6PBCx2GZI ^"Single Weapon"
                "Single Weapon" -> #teT2LcXE2F4TDMJ6PBCx2GZI ^"Single Weapon"
            }
        }

        #teT6TkF6DC5k535dx29K6mi9 ^"Strike the Proud Low" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Blessing" FIXED
                ^"Level" INTEGER 25 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaBl Level 25"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell reduces a single Ability of the victim to 0. The Ability must be related to martial prowess, and the storyguide selects the Ability affected at the time of casting.\n\nExample: A gruagach witnesses a haughty noble humiliate one of his vassals for making an honest statement to his lord. The wizard casts the spell to punish the lord until he acts with humility by admitting that he was wrong and apologizing to someone beneath him in station. The storyguide elects to reduce the lord’s Ability in Great Weapon to 0 for the duration of the spell. The lord resists the spell with a Stamina check against an Ease Factor of 9, but the roll is modified by –3 because of the appropriateness of the limitation."
            REFERENCES {
                "Great Weapon" -> #tEJFnp2ppuV0LkIzGNa8LPPz ^"Great Weapon"
            }
        }

        #tD9THVuBApOdB6nyWnH9YJhy ^"Make the Miser Generous" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Blessing" FIXED
                ^"Level" INTEGER 30 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaBl Level 30"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell eliminates a Major General or Supernatural Virtue from the victim. It must have something to do with the ability to negotiate with others, and the storyguide selects the affected Virtue at the time of casting.\n\nExample: While bartering with an unscrupulous merchant, a gruagach notices the merchant has weighted scales. He decides to punish the merchant by reducing the merchant’s ability to barter. The storyguide sees that the merchant has Communication +3, a Barter score of 3, and Affinity with Ability (Bargain), but no Major Virtue. The storyguide elects to reduce the merchant’s Barter score to 0 for the duration of the spell. The gruagach states that the merchant can’t regain his Ability in Barter until he behaves honestly, for example by making his scales true. The merchant is able to resist the spell with a Stamina check against Ease Factor 9, but because the condition and spell effect are particularly appropriate to the situation, the merchant has a –6 to his Stamina roll."
            REFERENCES {
                "Affinity with Ability" -> #tJ1KywwFSmtMTdL0mKAR3nsR ^"Affinity with Ability"
            }
        }

        #t94kFgBCojE8GmX9khOYAWuw ^"Geas for the Narcissistic Maiden" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Level" INTEGER 15 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Geas"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvCu Level 15"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The spell inflicts the Minor Flaw Disfigured on a victim. Although this example grants the Flaw Disfigured, other spells exist to grant other Minor Flaws.\n\nExample: To punish a vain maiden for spurning his advances, the gruagach casts a geas that commands her act with humility or she will regret doing so thereafter. The curse that accompanies the geas gives the target the Minor Flaw Disfigured until the victim makes a heartfelt apology to someone (general prohibition). The target must make a Stamina roll against an Ease Factor of 9 with a modifier of –6 because of the appropriateness of the geas and curse."
        }

        #t0ySx0Dmw2oZ9aFeUjuMHAtB ^"Geas of Retribution for the Unthinking Slap" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Level" INTEGER 25 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Geas"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvCu Level 25"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The spell cripples one arm of the target if he breaks the geas, until it heals normally. The caster chooses which arm the spell affects at casting time.\n\nExample: When words become heated between a gruagach and magus, a shield grog raises his hand as a threat against the hedge wizard. The gruagach casts a geas on the grog and warns him, “If you raise your hand again at me, you will lose it.” The curse accompanying the geas causes the victim to lose all use of his sword arm. The grog may resist the geas with a Stamina roll against an Ease Factor of 9, with a modifier of –3 because of the appropriateness of the geas and curse."
        }

        #tRYXsYzWDDIp3Y2rPNDML5fS ^"Curse for the Spied Spy" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Level" INTEGER 35 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvCu Level 35"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The spell blinds the target until the Condition of the spell is fulfilled or it heals normally.\n\nExample: While the covenant’s scout is investigating the gruagach’s camp in a fen, the hedge wizard notices the interloper and curses him. The victim is struck blind until he leaves the fen, or the Wound heals. The troupe decides the punishment fits the crime, and the scout must succeed in a Stamina check against an Ease Factor of 9 with a –6 to the roll."
        }

        #twHe7oQk15wof4F2bobfgYLJ ^"Curse for the Unjust Justice" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Level" INTEGER 25 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Limit"
                ^"Target" STRING "Blood"
                ^"Code" STRING "GvCu Level 25"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The spell curses a bloodline with the Minor Flaw Judged Unfairly for the duration of the spell. This spell grants Judged Unfairly, but other spells exist for other Minor Flaws.\n\nExample: A local lord ignores the evidence presented to him and rules an innocent man a felon so that his property is forfeit. The gruagach witnesses this and curses the lord and his entire line with the Flaw Judged Unfairly until the innocent man’s family’s property is returned. Because this is a specific prohibition, the gruagach casts the spell as if it were 5 levels lower. The lord is able to resist the spell with a Stamina check against an Ease Factor of 9, but because the punishment fits the crime, the lord makes the roll at –6."
            REFERENCES {
                "Judged Unfairly" -> #tZfpG6K1LL4cCNp3vgyieYiu ^"Judged Unfairly"
                "Judged Unfairly" -> #tZfpG6K1LL4cCNp3vgyieYiu ^"Judged Unfairly"
                "Judged Unfairly" -> #tZfpG6K1LL4cCNp3vgyieYiu ^"Judged Unfairly"
            }
        }

        #tYkXYD9GtX47AqJwcBbcXI97 ^"Question the Cursed" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaCu Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "If the level of the spell plus a single stress die meets or exceeds the level of the spell targeted, the gruagach learns who cast the curse, what spell level it is, the duration of the curse, and the Limit on it. If the Target is under a geas, the caster learns the terms of the geas and the curse it carries."
        }

        #t9xUazkIgqOQLABat7IdNVpM ^"Lift the Unfair Curse" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Curse" FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaCu Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "If the level of the spell plus a single stress die meets or exceeds double the spell level of the spell targeted, she removes it. To determine the spell level equivalent of a Supernatural Ability, use the Ability score x 5. See Houses of Hermes: Societates, Ex Miscellanea, page 104. A gruagach need only meet or exceed the spell level of a curse she cast to remove it."
            REFERENCES {
                "Ex Miscellanea" -> #tjy0SS5CHKdh5LFYemvIPIjA ^"Ex Miscellanea"
            }
        }

        #tYMgrPi6SVt00KxyJLAeESRI ^"Borrow the Nose of the Hound" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Level" INTEGER 3 FIXED
                ^"Range" STRING "Per"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvSh Level 3"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The caster’s nose turns into that of a hound. The gruagach gets a bonus of +6 to all Perception rolls associated with smelling. The character receives a –3 modifier to all rolls involving interaction with individuals who aren’t frequently exposed to the effects of magic."
        }

        #tgVWlAh5wQ81SunZ7erg2lmw ^"Borrow the Wings of the Eagle" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Level" INTEGER 10 FIXED
                ^"Range" STRING "Per"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvSh Level 10"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The caster’s arms turns into giant wings. The gruagach is able to fly as quickly as a normal horse gallops. The character receives a –6 modifier to all rolls involving trust."
        }

        #tr1dma2ybgFtPi8QtcnzJyZX ^"Assume the Form of the Ancestors" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Level" INTEGER 15 FIXED
                ^"Range" STRING "Per"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvSh Level 15"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "For the duration of the spell, the caster grows to giant size. The character’s Size increases by +5, but to no more than +5, and for each point of Size the character gains, adjust his Strength by +2 and his Quickness by –1."
        }

        #t73TPH378KpbWPS4UPWVBmBz ^"Return the Lycanthrope to His Native Form" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Mom"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaSh Level Gen"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "If the level of the spell plus a single stress die meets or exceeds double the level of the spell causing the transformation, it is removed. To determine the spell level equivalent of a Supernatural Ability, use the Ability score x 5. See Houses of Hermes: Societates, Ex Miscellanea, page 104. A gruagach need only meet or exceed the spell level of a spell he cast to cause the target to revert to his native form."
            REFERENCES {
                "Ex Miscellanea" -> #tjy0SS5CHKdh5LFYemvIPIjA ^"Ex Miscellanea"
            }
        }

        #t2n7ezYc7zLgunBxuM1cmgiO ^"Turn the Man into His Appropriate Form" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaSh Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "The gruagach is able to turn a human into a land animal with characteristics that most closely mirror the Personality Traits of the Target. A liar might turn into a snake; a traitor might turn into a rat; a glutton might turn into a pig. The caster does not know into what form the target will change before casting the spell."
            REFERENCES {
                "Personality Traits" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
            }
        }

        #tkfDtQy62wUUABlAR7F6eSSO ^"Skin of the Doppelganger" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Take" FIXED
                ^"Form" STRING "Shape" FIXED
                ^"Level" INTEGER 20 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Ind"
                ^"Code" STRING "TaSh Level 20"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "A target of this spell is granted a Stamina roll versus an Ease Factor of 9. If the Stamina check fails, then for the duration of this spell the caster may assume the form of the victim. The physical appearance is a perfect duplication of the victim, and any clothing the victim was wearing is also replicated. If the victim changes clothing during the spell, the caster’s clothes do not change.\n\nThe spell does not allow the caster to mimic the victim’s voice or mannerisms. Anyone who knows the victim may make a Perception roll versus an Ease Factor of 6 to notice that something is peculiar or off about the target. Observers receive a bonus to their Perception roll based on their familiarity with the mimicked character: a casual acquaintance (+1), close friend (+3), and family member or lover (+6)."
        }

        #tRhcFlbiaNgz8vAV6mvoscbK ^"Grant a Glimpse of the Future" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Vision" FIXED
                ^"Level" INTEGER 30 FIXED
                ^"Range" STRING "Conversation"
                ^"Duration" STRING "Moon"
                ^"Target" STRING "Ind"
                ^"Code" STRING "GvVs Level 30"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "When this spell is cast, the recipient receives hints, visions, and images that relate to a specific topic for the duration of the spell. Example topics include: the recipient’s future bride or groom, the sex of a future child, or the dangers encountered in an upcoming trip. As with the Visions Flaw, all images, visions, and hints come at the storyguide’s discretion and reveal only what she wants to reveal."
        }

        #tSbcATophMCU06PbOJtDR9ce ^"Create the Hunters’ Blind" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
                ^"Tradition" STRING "Gruagachan" FIXED
                ^"Technique" STRING "Give" FIXED
                ^"Form" STRING "Vision" FIXED
                ^"Level" INTEGER 10 FIXED
                ^"Range" STRING "Voice"
                ^"Duration" STRING "Sun"
                ^"Target" STRING "Group"
                ^"Code" STRING "GvVs Level 10"
                ^"Source" STRING "Hedge Magic [Revised Edition]"
            }
            DESCRIPTION "This spell covers a small group of people with an illusion of boulders, bushes, or other objects appropriate to the particular locale. The spell allows those covered by the illusion to see out. It does not affect any of the senses other than sight; a bush does not rustle in the wind or have any feeling if touched. Those inside the illusion may still be heard, smelled, or touched."
        }

        #t1az9MV49eHmdMicbIJjwm8A ^"Eavesdrop with the Eyes" DEF {
            EXTENDS ^"Hedge Spell"
            PROPERTIES {
