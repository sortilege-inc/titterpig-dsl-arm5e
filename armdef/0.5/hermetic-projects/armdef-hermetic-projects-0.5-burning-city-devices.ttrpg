EXTENSION "ARMDef_Hermetic_Projects_BurningCity_Devices" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Two: The Burning City devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Hermetic_Projects_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t650a43670a224b9562a4eb ^"Scribe of All That I Can See" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Requisite" STRING "Aquam, Herbam"
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1 use per day, item maintains Concentration"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +1 Concentration, +4 Vision, free requisites; + 5 item maintains Concentration)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
            ^"Printed Effect Line" STRING "InTe(Aq)(He) 25 Pen: 0, 1 use per day, item maintains Concentration R: Touch, D: Concentration, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "This enchanted quill helps a character to rapidly draw an accurate map of what he can see. The item grants the user special magical senses that allow him to precisely estimate the distance, shape, and relationships among geographical features, and figure out how best to represent this information on a page. This is information that anyone with sufficient skill could determine by merely looking. The quill does *not* draw the map by itself. The character draws the map. The quill only ensures that the subsequent map is accurate and that it can also be very speedily drawn, by providing the character with enhanced information about what he can see.\n\nIt takes 1 Diameter to draw what can be seen from a tree-top or church tower, and it takes 3 Diameters to draw what can be seen from a mountaintop, or by a flying character. If what is being mapped includes something complicated (like the streets of a city) it takes an additional 3 Diameters to draw the map.\n\nThe map produced with the aid of the quill can be used in conjunction with spells such as *Trail of Ember* and *The Inexorable Search* (**ArM5**, page 131). Having the map also gives a character a +3 bonus to Area Lore rolls made to navigate the terrain depicted.\n\nThe character needs to provide parchment and ink (or similar materials), and he must be literate if he wishes to annotate the map. If the map is not annotated it can only be used by a character who successfully makes an (appropriate) Area Lore roll against an Ease Factor of 12. If the map is annotated, it can be used by any character literate in the language of annotation. The character who created the map can always use it, even if it is not annotated.\n\nThe requisites are required so that rivers and forests can be mapped too."
    }

    #tbb885d7faefade79751f11 ^"Vulcan’s Glass" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1 use per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +1 Concentration, +4 Vision)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
            ^"Printed Effect Line" STRING "InTe 20 Pen: 0, 1 use per day R: Touch, D: Concentration, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This enchanted mirror allows the user to identify the volcanoes in a mountain range. The user turns his back to the mountains, and studies the reflected image of the mountain range in the mirror. The reflected images of the volcanoes glow with a red aura.\n\nThis spell works because whether or not a particular mountain is a volcano is a visible property that can be distinguished by someone with appropriate skill. This spell compensates for the lack of appropriate skill in the observer."
    }

    #t8042b214d7b3d7aeb293c1 ^"Pitch Brush" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 48
            ^"Requisite" STRING "Ignem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +3 Moon, +1 Part, +1 Ignem requisite, +2 intense heat; +3 six uses per day)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (96), Two Seasons (72), Three Seasons (64), Four Seasons (60)."
            ^"Printed Effect Line" STRING "ReAq(Ig) 48 Pen: +0, 6 uses per day. R: Touch, D: Moon, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "This enchanted item is a brush that is used to paint a dark tar infused with volcanic ash onto the hull of a boat. The brush causes the tar to magically seal, and until the effect expires the boat can be rowed or sailed on lava without damage.\n\nOther items, such as oars or even a person, can also be painted in the pitch. Each charge is enough to paint the hull of a small boat or a single person. However, as the effect has a Part target, larger items can be fully protected by painting it with several charges’ worth of the pitch. If only the hull of the boat is painted, then other parts of the boat will not be protected if they come in contact with the lava. This might happen if the boat capsizes, for example.\n\nThis spell is based on the Rego Aquam guideline to ward against a mundane liquid, and the Ignem requisite prevents the heat damage (with an additional two magnitudes due to the intensity of the heat)."
    }

    #t149ae85a2907c960e4b495 ^"Cloven Hoofed Boots" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 24
            ^"Requisite" STRING "Terram"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +1 Part, free Terram requisite; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (48), Two Seasons (36), Three Seasons (32), Four Seasons (30)."
            ^"Printed Effect Line" STRING "MuAq(Te) 24 Pen: +0, constant effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "These boots turn the lava directly beneath them into a solid. Although the boots are constantly active, the effect only solidifies the lava that the boots are touching. This means that the character wearing the boots can either walk across or stand still on top of an expanse of lava. However, once the character moves, the solid lava that was beneath him melts back into the bulk of the lava field. Another character may be able to quickly follow behind, but this would require a lot of agility.\n\nThe Terram requisite is free because it is part of the guideline. Note that this effect does not change the temperature of the lava, so a character using these boots will likely need protection from heat."
    }

    #tac735ee67704b50235ce65 ^"Fumarole Mask" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +2 Sun; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (68), Two Seasons (51), Three Seasons (46), Four Seasons (43)."
            ^"Printed Effect Line" STRING "PeAu 34 Pen: +0, constant effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This mask is made from porous volcanic rock and it destroys the toxic properties of any air that passes through it. This allows the wearer of the mask to breathe without trouble in the heart of a volcanic crater, or on a river of lava. The air affected by the mask tastes slightly unpleasant, but this does not cause any damage to the wearer.\n\nAlthough the mask is constantly active, once the toxicity of the air has been removed, the air itself is no longer the subject of a magical effect. This means that the air is not resisted by characters with Magic Resistance, so magi can breathe using the mask without lowering their Parma Magica.\n\nNote that Muto effects which change the air to be non-toxic are of little value to magi, as the effect only lasts as long as the spell duration. This means that when the magus tries to breathe the magically changed air, his Magic Resistance will resist the air as it is the subject of a magical effect. So the magus must either asphyxiate or lower his Parma Magica — both options are hazardous.\n\nThis spell is based on the Perdo Aquam guideline to destroy a property of a liquid, and applied by analogy to the Auram Form."
    }

    #tb155db3d0e11fe240bb9e7 ^"The Vibration of Anticipation" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Vulcan’s Warning Bell"
            ^"Rules Section" STRING "Vulcan’s Warning Bell"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Constant Duration Effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Constant"
            ^"Target" STRING "Touch"
            ^"Effect Design" STRING "(Base 4, +2 Sun, +1 Touch, requisite free; +4 levels Constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (38), Two Seasons (29), Three Seasons (26), Four Seasons (24)."
            ^"Printed Effect Line" STRING "InAu 19 Pen: 0, Constant Duration Effect. R: Personal, D: Constant, T: Touch"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This effect gives the bell the magical sense to detect the imminent eruption."
    }

    #t51d74bde8dcce9f97c7a3c ^"Clarion Call (Vulcan’s Warning Bell)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Clarion Call"
            ^"Part Of" STRING "Vulcan’s Warning Bell"
            ^"Rules Section" STRING "Vulcan’s Warning Bell"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 17
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +2 effect metal; +10 unlimited uses, +3 linked trigger)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (34), Two Seasons (26), Three Seasons (23), Four Seasons (22)."
            ^"Printed Effect Line" STRING "ReTe 17 Pen: 0, unlimited uses R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This effect rings the bell. The frequency of the ringing increases as the eruption time nears, and in the final hours the bell urgently rings every few seconds."
    }

    #t5389f981a08740d8b87392 ^"Cold Marble Slab" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun +3 Structure; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (68), Two Seasons (51), Three Seasons (46), Four Seasons (43)."
            ^"Printed Effect Line" STRING "PeIg 34 Pen: +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 17
        }
        DESCRIPTION "This marble slab, about a pace across, is activated when it is hung above the entrance of a building, and it chills the building. Normally, this would make continued occupation of the building intolerable; however, if the building is in a very hot location (such as a volcanic crater), then the cooling provided by the marble slab cancels out the ambient heat and makes the building habitable. This effect targets a base-sized Structure and is thus sufficient to affect a structure similar in size to a Mystic Tower (see ArM5, pages 113 and 153). Larger structures will require a larger Cold Marble Slab effect.\n\nThe chilling effect is not sufficient to cool anything very hot, such as lava, that happens to be in the building. However, it is sufficient to cool the air that is heated by the lava."
    }

    #t6fa3dca491e2d90a1b27e5 ^"Fumarole Vent" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +2 Sun, +2 Room; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (88), Two Seasons (66), Three Seasons (59), Four Seasons (55)."
            ^"Printed Effect Line" STRING "PeAu 44 Pen: +0, constant effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 17
        }
        DESCRIPTION "This enchanted item is a vent that is placed over a window in a room. The fumarole vent destroys the toxic properties of the air passing into the room, in the same way that a Fumarole Mask does (see earlier). This allows people to freely breathe in a room that is in a building constructed in (or very near) a volcanic crater, or on a river of lava.\n\nAs the effect uses the Hermetic target Room, to target the air passing into the room, only one vent is required even if the room has multiple openings. However, if a building has multiple rooms it requires a vent in each room. A version of the vent with a target of Structure could be invented to protect the entire building."
    }

    #tf06048f489d8a49cc1e1e1 ^"Repulsion of Earth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 Sun, +3 Structure, +1 effect stone; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect:"
            ^"Printed Effect Line" STRING "ReTe 34 Pen: +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "This feather encased in amber is an enchanted item that is activated by being brought over the entrance to a stone building. When active, it causes the stone building to float several paces above the ground. If the effect ends (by the item being removed, for example), then the building crashes to the ground. This may cause significant damage to the building.\n\nA Finesse Roll against an Ease Factor of 9 must be made if the building must be torn from its foundations. If the roll is failed, then any subterranean (i.e., basement) levels of the building are damaged and rendered unusable. This does not affect the upper levels. This effect targets a base-sized Structure and is thus sufficient to affect a structure similar in size to a *Mystic Tower* (see **ArM5**, pages 113 and 153). Larger structures will require a larger *Repulsion of Earth* effect.\n\nOnce it is floating, the building can be moved. However, the building is still incredibly massive and so it requires an enormous amount of force (or magic such as *The Heart That Could Move Stone*) to move. The building cannot be pushed by an individual, normal strength man, nor will it blow away in the breeze.\n\nOne Season (68), Two Seasons (51), Three Seasons (46), Four Seasons (43)."
    }

    #tbc1b533d0272d96e95b8e5 ^"Seed of Earth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 59
            ^"Requisite" STRING "Ignem, Terram"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +1 Part, +6 Size, +1 Ignem requisite, free Terram requisite ; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to complete project, as lesser enchanted item: 118"
            ^"Printed Effect Line" STRING "MuAq(Ig)(Te) 59 Pen: +0, constant effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "When this small piece of volcanic rock is thrown onto molten lava, it solidifies a portion of the lava, creating a roughly circular island about 80 feet across and 50 feet deep. The seed itself is buried 25 feet down, in the center of the island. As the effect has a constant duration, the island is stable and suitable for building structures upon. If the seed is removed, dispelled, or destroyed, then roll a stress die; this is the number of rounds that the island remains until it dissolves back into the lava. The Ignem requisite is for cooling the island."
    }

    #t73400d39f16a90f23c490f ^"Harvest Stone" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Stone Harvester"
            ^"Rules Section" STRING "Stone Harvester"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 43
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +3 Sight, +1 Diameter, +1 Part, +2 effect metal; +10 unlimited uses, +3 linked trigger (*Stone Wealth*))"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (86), Two Seasons (65), Three Seasons (58), Four Seasons (54)."
            ^"Printed Effect Line" STRING "ReTe 43 Pen: +0, unlimited uses R: Sight, D: Diameter, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "The Stone Harvester uses this effect to collect stone/mineral/metal material of a particular sort that it encounters — the stone is identifying material using the Stone Wealth effect. The collected stone is placed in a large stone basket on the back of the Stone Harvester which must be periodically emptied by a grog (precisely how frequently depends on the rarity of the collected stone). If the grog fails to empty the basket, the Stone Harvester will continue to harvest, but excess stone will fall out of the basket."
    }

    #t3d7f57a2d2400b8aeafde5 ^"Stone Wealth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Stone Harvester"
            ^"Rules Section" STRING "Stone Harvester"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Smell"
            ^"Effect Design" STRING "(Base 2, +2 Sun, +2 Smell, +1 smell through intervening material; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (38), Two Seasons (29), Three Seasons (26), Four Seasons (24)."
            ^"Printed Effect Line" STRING "InTe 19 Pen: +0, constant effect R: Personal, D: Sun, T: Smell"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "This effect grants the Stone Harvester the sense to smell whether a particular sort of stone, metal, or mineral is nearby\n\n(within about 5 paces). The *Stone Harvester* contains a small compartment and it targets materials that match the material in the compartment. If there is no material in the compartment the *Stone Harvester* continues to move about the crater rim, but will obviously not find any matching material. The *Stone Harvester* only identifies Terram based objects, but of course additional effects could be invented to allow the *Stone Harvester* to identify and manipulate Animal, Aquam, Corpus, or Herbam objects.\n\nThis sense allows the harvester to smell things buried to a depth of about 1 pace."
    }

    #t791c3ec9c5e78dbf405848 ^"Stone Crawler Effect" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Stone Harvester"
            ^"Rules Section" STRING "Stone Harvester"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 3, +2 Sun, +1 affect stone; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (28), Two Seasons (21), Three Seasons (19), Four Seasons (18)."
            ^"Printed Effect Line" STRING "ReTe 14 Pen: +0, constant effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "This effect manipulates the legs of the Stone Harvester, enabling it to move around the crater rim. The Stone Harvester moves constantly, at the pace of a walking man, in a clockwise direction around the crater rim."
    }

    #tff2dbbba73af4411c5cd86 ^"Stone Hammer Effect" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Stone Harvester"
            ^"Rules Section" STRING "Stone Harvester"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +3 Sight, +1 Part, +1 affect stone; +10 unlimited uses, +3 linked trigger (*Stone Wealth*))"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (66), Two Seasons (50), Three Seasons (44), Four Seasons (42)."
            ^"Printed Effect Line" STRING "PeTe 33 Pen: +0, unlimited uses R: Sight, D: Momentary, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "This effect is activated when the Stone Harvester detects that its target material is beneath the surface of the earth. The Stone Hammer effect loosens up to one cubic pace of intervening stone or dirt. This allows the target material to be lifted out of the ground."
    }

    #t85f76209fd2dbd2c520929 ^"Test the Water’s Effect" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Thermal Bath of Good Humor"
            ^"Rules Section" STRING "The Thermal Bath of Good Humor"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (18), Two Seasons (14), Three Seasons (12), Four Seasons (12)."
            ^"Printed Effect Line" STRING "InIg 9 Pen: +0, constant effect R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "This effect determines the temperature in the bath. When the temperature drops below a comfortable bathing temperature, it activates the heating effect Fill the Bath. If the bath is intended to be The Thermal Bath of Scalded Flesh, then this effect is invented to monitor around (and activate the Fill the Bath effect at) the boiling temperature of water."
    }

    #t9bc32dd35120bdc830e9f9 ^"Fill the Bath Effect" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Thermal Bath of Good Humor"
            ^"Rules Section" STRING "The Thermal Bath of Good Humor"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 28
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited uses per day"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 1, +3 Sight, +1 Diameter, +2 very unnatural effect; +10 unlimited uses per day, +3 linked trigger (*Test the Waters*))"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (56), Two Seasons (42), Three Seasons (38), Four Seasons (35)."
            ^"Printed Effect Line" STRING "ReAq 28 Pen: +0, unlimited uses per day R: Sight, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "This effect causes the water in the bath to move through the air, pass over a volcanically heated region, and then back in a circle into the bath. The water travels in its circuit as a gentle stream suspended in the air at about waist height. The water returns to the bath warmed and dissolved in the water are a number of beneficial mineral salts.\n\nIf the bath is being controlled to a comfortable bathing temperature, then any characters who bathe once a day for most of the year receives a +1 Living Condition modifier to their Aging Rolls for that year, and a +1 Modifier to any Recovery Rolls they make during the year (see **ArM5**, pages 168 and 179). This modifier cannot be increased by more frequent bathing. These beneficial effects come from the mineral salts that are entrained in the water. The beneficial effects are not magical in origin, and a character who constantly uses the bath in this way does not gain Warping Points. The bath does not need to be able to detect the mineral salts as they are naturally present in the volcano. If for some reason, the mineral salts are lacking from the volcano (which would be highly unusual) then the bath has no beneficial effects on the bather — apart from cleanliness, of course!\n\nIf the bath is being controlled to a scalding temperature, then any character immersed in the bath takes +12 damage each round due to the elevated temperature.\n\nThe effect requires both the presence of water in the bath and a volcanic region to heat the water within Sight range. If either of these elements are missing the effect does not activate."
    }

    #t231ddfb8c3b2c715af1386 ^"Fill the Well" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Well Ever-full"
            ^"Rules Section" STRING "Well Ever-full"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 54
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2 uses per day"
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 30, +4 Arcane; +3 environmental trigger, +1 2 uses per day)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (108), Two Seasons (81), Three Seasons (72), Four Seasons (68)."
            ^"Printed Effect Line" STRING "ReAq 54 Pen: +0, 2 uses per day R: Arcane, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 23
        }
        DESCRIPTION "This effect is triggered every sunrise and sunset. It instantaneously fills the well with water from the sea (which must be within seven leagues).\n\nThe effect requires an Arcane Connection to the sea. Any water which remains from the previous triggering of the effect is sufficient for this. However, if the well is ever completely drained of water, it must be primed with a cup of water from the sea. If the well ceases to work (for some reason) for more than a few months, then the well must also be refilled with a cup of water from the sea, as the Arcane Connection to the sea will have expired.\n\nThe volume of water that is transported daily into the well is sufficient to supply the water needs of a covenant of several hundred people.\n\nThe effect is based on the Rego Corpus guidelines, applied by analogy to the Aquam Form. Note that the water is only transported a distance of seven leagues, so for this to be effective the well must be located with seven leagues of the water source. A version of this effect, using the guideline one magnitude higher, would enable the water to be transported any distance."
    }

    #t0ca2cc33be73d671ab4dbd ^"Cleanse the Undine’s Tears" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Well Ever-full"
            ^"Rules Section" STRING "Well Ever-full"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 15, +1 Touch; +3 linked trigger, +1 2 uses per day)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (48), Two Seasons (36), Three Seasons (32), Four Seasons (30)."
            ^"Printed Effect Line" STRING "PeAq 24 Pen: +0, 2 uses per day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 23
        }
        DESCRIPTION "This effect eliminates the salt in the water in the well. This effect is triggered by the Fill the Well power, and is activated one round later.\n\nNote that the salinity of the water will not return once it has been removed. This is because salt is not part of the essential nature of water."
    }

    #ta42c82558c1089da5e31e7 ^"Ring of Protection Against Magical Creatures of Fire" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Constant"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base Effect at level 20, using Sun Duration instead of Ring and Individual Target instead of Circle; +11 penetration bonus of 22, +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (70), Two Seasons (53), Three Seasons (47), Four Seasons (44)."
            ^"Printed Effect Line" STRING "ReIg 35 Pen: +22, constant effect R: Touch, D: Constant, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "This ring, with an inset ruby, wards the wearer against creatures with an Ignem Form who have a Magic Might of no more than 20."
    }

    #tbfc1bf275f2caee43cfde1 ^"The Entrapped Flame" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Constant"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base Effect at level 20, using Sun Duration, +2 Room; +11 penetration bonus of 22, +4 constant effect)"
            ^"Printed Effect Line" STRING "ReIg 45 Pen: +22, constant effect R: Touch, D: Constant, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "This effect is enchanted into a cage made from basalt stone (see Basalt Cage) which is large enough to hold ten man-sized creatures. Creatures with Ignem Magic Might up to 20 cannot escape from the cage.\n\nThe cage has a gate, that can be opened and shut by characters who are not affected by the cage. Shutting the gate activates the effect.\n\nThis item could be invented as a lesser enchanted item. Required Lab Total to invent lesser enchanted item: 90\n\nAlternatively, the item could be invented as an invested item. It takes 20 pawns of vis (huge, stone), one season and a Magic Theory Score of 10 to open the basalt cage for enchantment. Then, invest the effect. Required Lab Total to invest effect: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

}
