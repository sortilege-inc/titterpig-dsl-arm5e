EXTENSION "ARMDef_Hermetic_Projects_BurningCity_Spells" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Two: The Burning City spells"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Hermetic_Projects_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #td33da74a61a75dd5e9d6e4 ^"Scent of Ash" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Smell"
            ^"Printed Stat Line" STRING "InAu 15 R: Personal, D: Concentration, T: Smell"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 12
        }
        DESCRIPTION "The caster can smell and identify, on the breath of the air, the ash that has carried from volcanoes. This is enough information for the caster to determine the approximate direction and distance to each of the volcanoes he detects. A dormant volcano can be detected in this way from within one league (three miles), a volcano that has erupted within the last 100 years can be detected from within seven leagues (21 miles), and a volcano that has erupted in the last season can be detected from within 100 miles. Dormant volcanoes are detectable in this way because ash from their violent eruption is still present in the environment. The ash may have fallen to the ground, but some small (but detectable via Hermetic magic) fraction has been blown up into the air again.\n\nOf course, the huge plume of ash from a large on-going eruption can easily be identified without the aid of magic from many hundreds of miles away.\n\n(Base 4, +1 Concentration, +2 Smell) Required Lab Total to invent spell: One Season (30), Two Seasons (23), Three Seasons (20), Four Seasons (19)."
    }

    #td11911419f06daf95d7652 ^"Trail of Ember" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InTe 20 R: Arcane, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "The caster of this spell throws a piece of volcanic rock onto a map. The rock lands on the location of the volcano it was expelled from. If the volcano’s location is not bounded by the map, then the rock rolls off in the direction that the volcano lies.\n\nIf the rock thrown onto the map is not volcanic, then it just lands somewhere at random. The caster can confirm this by casting the spell several times: a volcanic rock will always land on the same spot on the map.\n\nNote that a volcanic rock created via Creo Terram magic will not reveal what volcano it came from when thrown onto the map with the *Trail of Ember* spell. This is because such a magically created volcanic rock did not in fact come from a volcano.\n\n(Base 4, +4 Arcane) Required Lab Total to invent spell: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t135c1e06e6347c8248155b ^"Tear the Earth Asunder" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 65
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 65 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "The caster of this ritual stabs a dagger into the ground: from the wound a volcano rises, and lava and scalding gases erupt. Over a period of a day, the volcano erupts, darkening the sky with plumes of ash, and forming a large volcanic crater.\n\nObviously, the eruption of the volcano devastates villages, towns, monasteries, covenants, or other settlements built in its shadow. Once the spell has been cast, there is no active magical effect; the eruption is natural and does not need to Penetrate Magic Resistance, and consequent rivers of lava and falling ash can also pass unhindered through an *Aegis of the Hearth*. The caster of the ritual also needs some form of protection to avoid being killed in the eruption.\n\nThe volcano region can be up to 20 miles in diameter (though the crater will be a fraction of this size), and the peak can be up to 15,000 feet high (which would make it one of the taller mountains in Mythic Europe).\n\n(Base 3, +1 Touch, +13 Size)\n\nRequired Lab Total to invent spell: One Season (130), Two Seasons (98), Three Seasons (87), Four Seasons (82)."
    }

    #te774a1a481905615ae4bc3 ^"Awaken Sleeping Giant!" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Ignem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReTe(Ig) 45 R: Touch, D: Momentary, T: Part, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "This spell is cast in the crater of a dormant volcano, and causes the volcano to erupt into life again. The volcanic crater can be up to two miles across, and the spell has no effect if cast in a location other than a volcanic crater. Obviously, the caster will be caught in the eruption, which may be a problem if he is not protected by appropriate wards.\n\nOnce the spell has been cast there is no active magical effect; the eruption is natural and does not need to Penetrate Magic Resistance. The effect is considered “slightly unnatural,” as it is natural for a volcano to erupt, but the spell artificially triggered the eruption.\n\n(Base 2, +1 Touch, +1 Part, +8 Size, +1 affect Volcano (same as stone))\n\nRequired Lab Total to invent spell: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

    #t92c0d99d89c1d00fffae6e ^"Steed of Vesuvius" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Ignem"
            ^"Printed Stat Line" STRING "MuAn(Ig) 45 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This spell magically transforms a horse so that he is able to gallop across molten lava as if it were a cobbled road. The horse also has no fear of the heat or fumes expelled by the lava, and he does not suffer from the heat of the lava or the toxicity of the fumes. The rider of the horse does not receive any protection from this spell.\n\nWhen the spell expires, the horse suffers a Long-Term Fatigue level.\n\nThe requisite is free because it is part of the guideline and required for the effect.\n\n(Base 25, +1 Touch, +2 Sun, +1 Size, free requisite)\n\nRequired Lab Total to invent spell: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

    #ta5e5066646da4eceab7a9c ^"Dragon’s Blood" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 70
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Rego, Ignem, Terram"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Mu(Re)Co(Ig)(Te) 70 R: Personal, D: Year, T: Part, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This ritual changes the blood of the caster into lava. This does no harm to the caster himself, and his super-heated blood means that he is immune to any heat-based damage that causes +15 or less damage (which includes lava).\n\nIf the character is injured in melee combat, his opponent(s) must make Dexterity rolls against an Ease Factor of 6 to avoid being splattered by hot lava. Opponents who fail take +15 damage. If the caster’s melee opponents are unaware of his lava blood (that is, it is the first time they have seen him injured), then the Dexterity roll is made against an Ease Factor of 9.\n\nThe Ignem and Rego requisites are required to give the additional protection from heat. The Terram requisite is free because it is required for the effect.\n\n(Base 25, +4 Year, +1 Part, +1 Ignem requisite, +1 Rego requisite, +2 intense heat)\n\nRequired Lab Total to invent spell: One Season (140), Two Seasons (105), Three Seasons (94), Four Seasons (88)."
    }

    #tcbd100d264af28f1161128 ^"Covenant of the Dragon" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 85
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Rego, Terram, Ignem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Mu(Re)Co(Te)(Ig) 85 R: Touch, D: Year, T: Group, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This ritual changes the blood of a Group of up to 100 individuals into lava. This has the same effect on each member of the Group as the ritual Dragon’s Blood. This is an efficient way (in terms of vis) of protecting an entire covenant from the heat hazards of living in a covenant located in a volcano — although each person will take 6 Warping points every year (see ArM5, page 168).\n\n(Base 25, +1 Touch, +4 Year, +2 Group, +1 size, +1 Ignem requisite, +1 Rego requisite, +2 intentse heat)\n\nRequired Lab Total to invent spell: One Season (170), Two Seasons (128), Three Seasons (114), Four Seasons (107)."
    }

    #te681c73a5681c7e9ed522f ^"Creeping Earth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 25 R: Touch, D: Moon, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "The caster of this spell stamps his foot on the ground and a patch of earth, centered on his position and 35 paces across, slowly but inexorably rises up for the duration of the spell. The earth rises at a rate of about one inch per day (up to three feet over the spell duration).\n\nThis is fast enough for people to observe if they watch the earth for more than a Diameter, and the movement can destroy buildings and other structures — even the strongest castle walls run the risk of collapse.\n\nThis spell only works when cast within a league of a volcano (three miles). This is because this movement is only a slightly unnatural property of the earth in such regions, whereas it is a grossly unnatural property of earth elsewhere.\n\n(Base 2, +1 Touch, +3 Moon, +1 Part, +2 Size)\n\nRequired Lab Total to invent spell: One Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
    }

    #tf4611222865411eb9edfcd ^"Flame Tongue" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Ignem"
            ^"Printed Stat Line" STRING "ReAq(Ig) 25 R: Voice, D: Momentary, T: Part"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This spell causes a glutinous glob of lava (from a lake or river of magma) to leap out and hit something. The volume of lava moved is about 2 cubic feet, and it can be moved to hit any location within Voice range. Whatever the lava hits takes between +15 and +60 damage, depending on how much of it is covered by the lava. The lava sticks to whatever it hits and continues to inflict damage each round. It takes several days for the lava to cool naturally.\n\nThe heat of the lava is also sufficient to ignite anything flammable that it hits.\n\n*Flame Tongue* is an Aimed spell, with a +6 bonus to hit due to the size of the volume of lava.\n\nIf the caster tries to totally immerse a person with the lava projectile, there is a –6 penalty to the Aiming Roll (effectively canceling the +6 size bonus). There is no penalty to the Aiming Roll if the objective is to merely splash someone. In some circumstances, the storyguide may decide that a missed attack to immerse a character results in a splash.\n\n(Base 10, +2 Voice, +1 Size) Required Lab Total to invent spell: One Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
    }

    #tef0fd0c8566c99a530aa6b ^"Scorn of Aphrodite’s Tears" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 70
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Ignem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReTe(Ig) 70 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 16
        }
        DESCRIPTION "This ritual is cast when the eruption of a volcano is imminent, and it climaxes with a vial of pure water being poured into the crater mouth. The ritual prevents the volcano from erupting.\n\nThe volcano region can be up to 20 miles in diameter (although the crater will be only a fraction of this size), and the peak can be up to 15,000 feet high.\n\n(Base 3, +1 Touch, +13 Size, +1 affect a volcano (equivalent to affecting stone))\n\nRequired Lab Total to invent spell: One Season (140), Two Seasons (105), Three Seasons (94), Four Seasons (88)."
    }

    #t51623e712f82a6d0b0257f ^"The Heart That Could Move Stone" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Structure"
            ^"Printed Stat Line" STRING "ReTe 25 R: Touch, D: Diameter, T: Structure"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 18
        }
        DESCRIPTION "The caster can move stone buildings with incredible force. This usually causes the stone building to collapse, as it is torn from its foundations. Anyone inside takes +10 damage from the falling structure.\n\nHowever, if the building is floating (through the *Repulsion of Earth* effect, for example), then the character can push the building to a new location. Characters inside the building when it is being moved must make Dexterity rolls against an Ease Factor of 6, each round, or lose their footing. Unless special precautions are taken, laboratories inside the building are disrupted by the movement, which ruins any laboratory activities being conducted that season. It takes a season to reorganize a laboratory disrupted in this way.\n\n(Base 3, +1 Touch, +1 Diameter, +3 Structure, +1 affect stone)\n\nRequired Lab Total to invent spell: One Season (50), Two Seasons (38), Three Seasons (34), Four Seasons (32)."
    }

    #t01525a60dad1c7a0249d43 ^"Tower of Lava" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReAq 50 R: Touch, D: Momentary, T: Part, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "This spell sculpts a tower out of hot bubbling lava. The resulting tower is solid and rigid, but if its foundations remain in lava, then the tower will dissolve back into the bulk within a day. The Part target is required, because the spell does not use all the available lava.\n\nThe tower is about the same size and dimensions as the one created by the spell *Conjuring the Mystic Tower* (see **ArM5**, page 153). A Finesse roll against an Ease Factor of 15 is required to ensure that the tower is well made; failure means that the lava takes a solid but malformed shape.\n\n(Base 3, +1 Touch, +1 Part, +6 size, +3 elaborate design)\n\nRequired Lab Total to invent ritual: One Season (100), Two Seasons (75), Three Seasons (67), Four Seasons (63)."
    }

    #t52c6c1ec90e2b15525ce2b ^"Solidity of Stone" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuTe 45 R: Touch, D: Moon, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION "This spell changes a mass of stone so that it has the unnatural property that it does not melt, even when heated to tremendous temperatures. The purpose of this spell is to prevent a building created out of molten lava (like that created by Tower of Lava) from dissolving back into the bulk lava.\n\nObviously, this spell must be cast every month otherwise the tower will melt and collapse.\n\nThe stone will still be hot, even if it is solid. So, a building protected like this will need to be cooled (or inhabited by characters immune to heat).\n\n(Base 4, +1 Touch, +3 Moon, +4 size, +1 affect stone)\n\nRequired Lab Total to invent spell: One Season (90), Two Seasons (68), Three Seasons (60), Four Seasons (57)."
    }

    #t4c5218418087c76e174b78 ^"Sculpt the Stone Machine" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 19
        }
        DESCRIPTION ", ritual\n\nThis ritual creates a machine made of stone that is suitable for use as the invested item *Stone Harvester*. The machine appears to be a large stone beetle about one pace in length. Until it is invested with the *Stone Harvester* suite of effects, the machine is merely a very elaborate statue.\n\n(Base 3, +1 Touch, +3 elaborate design, +1 minimum ritual effect magnitude)\n\nRequired Lab Total to invent ritual: One Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t631c1e43afe979a6dbe6fd ^"Basalt Cage" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrTe 20 R: Touch, D: Momentary, T: Individual, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 24
        }
        DESCRIPTION "This ritual creates a large cage made out of basalt stone with a single gate (also made of basalt) that can be opened and shut. The cage is large enough to hold ten man-sized creatures. Individuals in the cage may find it difficult to escape, if the gate is somehow locked or barred. However, the main purpose of the ritual is to create a cage which is subsequently enchanted as an item with the effect *The Entrapped Flame*.\n\nNote that, if your character is talented at Rego magics, he may find it easier to use a Rego Terram craft effect to sculpt such a cage from a hunk of basalt. However, remember to consider that the magus must make a Finesse roll against an Ease Factor of 24 to succeed in casting such a Rego craft effect, as it would be hard for a mundane craftsman to sculpt such an item and it would take him a long time to do so (see *Covenants* page 49).\n\n(Base 3, +1 Touch, +1 Size, +1 complex structure, +2 minimum level of a ritual)\n\nRequired Lab Total to invent spell:\n\nOne Season (40), Two Seasons (30), Three Seasons (27), Four Seasons (25)."
    }

    #t8d56eb64a740185d21e87b ^"Commune with the Fire Soul" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InTe 30 R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "The caster plunges his hands into lava (which will cause damage if he is not protected) and communes with the spirit of the volcano. If the volcano’s spirit is a creature with Might, then this spell needs to penetrate its Magic Resistance.\n\nThe length of time a conversation with a volcano spirit takes is highly variable, and depends on the activity of the volcano. The spell allows the caster to perceive and participate in the conversation at either great speed or very slowly, as appropriate. A conversation of a few simple sentences with a dormant volcano could take many days, and would therefore require either a spell with a different duration or magical effects similar to *Maintaining the Demanding Spell* (**ArM5**, page 162) in order to maintain the Concentration duration. On the other hand, a long multi-faceted discourse with an active volcano can be conducted in a fraction of a round.\n\n(Base 20, +1 Touch, +1 Concentration) Required Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #t53422eea8b4f1627664d53 ^"Sense the Hearts of Fire" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InIg 30 R: Personal, D: Sun, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 25
        }
        DESCRIPTION "The caster detects whether creatures he can see have an Ignem Form Might. This is a magical property of a creature made of flame. It has no effect on creatures that are not made of Ignem, regardless of whether they have a Might or not. Creatures apparently made of flame (creatures of another Form, illusions, or the effects of Hermetic Rego Ignem magic) who do not have an Ignem Form Might are also not detected by this effect.\n\nObviously, this spell needs to Penetrate the Magic Resistance of the detected creatures.\n\n(Base 4, +2 Sun, +4 Vision)\n\nRequired Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

    #tba3fe49ba6b4e427956aad ^"Sublimation of Flame" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Auram"
            ^"Printed Stat Line" STRING "MuIg(Au) 30 R: Voice, D: Diameter, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "This spell changes a fire elemental (or another creature made of fire) into air for a short period of time. This renders the fire elemental incapable of using many of its powers for the duration of the spell.\n\nIf the target is in a well-ventilated area (such as outside), then the air that forms its body disperses. This inflicts an Incapacitating Wound on the fire elemental, and when its body returns to fire, numerous small fires erupt throughout the volume it has filled (about 50 paces across). These small fires cause +3 damage to anyone in the volume, and ignite flammable materials.\n\nIf the target is in an enclosed area (such as inside a room), then the air is closely contained, and the creature suffers no damage. When the fire elemental’s body returns to flame anyone else remaining within the room immediately takes either +10 or +Might damage (whichever is greater) as the elemental’s incandescent body of flame coalesces.\n\nThis spell must Penetrate the Magic Resistance of the fire elemental. This spell is able to affect creatures of up to Size +6 (this includes fire elementals of up to Might 25)\n\n(Base 5, +2 Voice, +1 Diameter, +2 size) Required Lab Total to invent spell: One Season (60), Two Seasons (45), Three Seasons (40), Four Seasons (38)."
    }

}
