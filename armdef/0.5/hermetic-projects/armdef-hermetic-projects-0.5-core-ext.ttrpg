EXTENSION "ARMDef_Hermetic_Projects_Core_Ext" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - core type extensions"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Core_Base"

    # Hermetic Projects is an EXTENSION on the arm5e edition (spec S13 composition). It defines no type of its own:
    # its records are the core corpus's types and those Covenants defines (Enchanted Device, Laboratory, Laboratory Virtue,
    # Laboratory Flaw).

}
