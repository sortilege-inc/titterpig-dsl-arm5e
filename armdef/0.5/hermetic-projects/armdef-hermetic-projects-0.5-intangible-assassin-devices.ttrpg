EXTENSION "ARMDef_Hermetic_Projects_IntangibleAssassin_Devices" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Five: The Intangible Assassin devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Hermetic_Projects_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t5b74f275de09bff584d644 ^"Hearing the Tearing" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Assassin’s Bell"
            ^"Rules Section" STRING "Assassin’s Bell"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 49
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Base 5, +2 Sun, +3 Hearing, +3 detailed information; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (98), Two Seasons (74), Three Seasons (66), Four Seasons (62)."
            ^"Printed Effect Line" STRING "InVi 49 Pen: 0, constant effect R: Personal, D: Sun, T: Hearing"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "This effect enables the bell to hear when an Intangible Tunnel-style of effect is within Hearing distance (about 15 paces), which easily encompasses a normal-sized laboratory.\n\nNote that this spell requires no Penetration as an *Intangible Tunnel* does not have any Magic Resistance.\n\nThis effect triggers the *Clarion Call* bell-ringing effect."
    }

    #t6d5120ee84bea11b52795b ^"Clarion Call (Assassin’s Bell)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Clarion Call"
            ^"Part Of" STRING "Assassin’s Bell"
            ^"Rules Section" STRING "Assassin’s Bell"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 17
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +2 effect metal; +10 unlimited uses, +3 linked trigger)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (34), Two Seasons (26), Three Seasons (23), Four Seasons (22)."
            ^"Printed Effect Line" STRING "ReTe 17 Pen: 0, unlimited uses R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "This effect rings the bell continuously, if the Hearing the Tearing effect detects an Intangible Tunnel."
    }

    #tab5d5e0a086d9a3bb7b605 ^"Miniaturist of Venice" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 50
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +2 Group, +1 Size, +1 affect glass, +3 increased shrinking effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invent spell: One Season (100), Two Seasons (75), Three Seasons (67), Four Seasons (63)."
            ^"Printed Effect Line" STRING "MuTe 50 Pen: 0, constant effect R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This spell reduces 100 cubic paces of glass into a small volume, about 1 cubic foot. The shrunken glass can be more easily transported.\n\nWhen the spell ends, the glass bursts back into full size. Anybody within 9 paces of the shrunken glass takes +10 damage from flying shards of glass. Bursting back in this manner breaks any complex glass objects.\n\nThe spell is based on the Muto Terram guideline that increases the volume of an object by 8, but instead is used to decreases its volume by a factor of 8."
    }

    #tc2190b59f5b55ecb313901 ^"Sense the Heavens" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Simulacrum of the Spheres"
            ^"Rules Section" STRING "Simulacrum of the Spheres"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Base 3, +2 Sun, +3 Hearing; +4 constant effect)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (48), Two Seasons (36), Three Seasons (32), Four Seasons (30)."
            ^"Printed Effect Line" STRING "InIm 24 0 Pen, constant effect R: Personal, D: Sun, T: Hearing"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "This effect gives the device the sense to listen to the barely-perceptible sounds of the celestial bodies in motion (see Art and Academe, page 16)."
    }

    #t67449ace7d20b9f6622ce1 ^"Move the Wheels" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Simulacrum of the Spheres"
            ^"Rules Section" STRING "Simulacrum of the Spheres"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 37
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 3, +1 Touch +2 Sun, +2 Group +2 affect metal; +4 constant effect +3 linked trigger)"
            ^"Required Lab Total" STRING "Required Lab Total to invest effect: One Season (74), Two Seasons (56), Three Seasons (50), Four Seasons (47)."
            ^"Printed Effect Line" STRING "ReTe 37 0 Pen, constant effect R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "This effect is triggered by the Sense the Heavens effect, and constantly moves the wheels in a way that represents the movement of the celestial bodies. This allows a character with an Artes Liberales Score of at least 1 to read the astrolabe."
    }

    #td664f2c73bab2a0922439a ^"Mirror of the Frozen Scene" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24 uses per day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 1, +2 Sun; +5 24 uses) Required Lab Total to invest effect: One Season (16), Two Seasons (12), Three Seasons (11), Four Seasons (10)."
            ^"Printed Effect Line" STRING "CrIm 8 Pen: 0, 24 uses per day R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This enchanted item is a mirror. When the device is activated, the image reflected on the mirror surface is frozen until the effect duration ends. This frozen image can be used as symbolic representation of anyone or anything depicted for a +2 Sympathetic Connection.\n\nAs the reflected image of a character is a species, this spell does not need to Penetrate the Magic Resistance of the depicted characters.\n\nNote that strictly the mirror actually creates an image that depicts what it “saw,” rather than truly freezing an image."
    }

}
