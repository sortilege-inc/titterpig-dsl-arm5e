EXTENSION "ARMDef_Hermetic_Projects_Menagerie_Devices" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Seven: The Menagerie of Magical Beasts devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Hermetic_Projects_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #ta5c1974142bd84d5834828 ^"Surveying the Lands for Magic" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Base 1, + 1 Touch, +2 Sun, +4 Vision) Required Lab Total: 1 season (40), 2 seasons (30), 3 seasons (27), 4 seasons (25)"
            ^"Printed Effect Line" STRING "InVi 20 Pen: 0, 1/day R: Touch, D: Sun, T: Vision"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 120
        }
        DESCRIPTION "Instilled in a small rock crystal (+5 shape and material bonus to Lab Total), this effect grants the holder the ability to detect magical auras through his vision. Similar devices must be constructed to detect other types of auras (i.e., Divine, Infernal, and Faerie). Any seen location with a magic aura will appear as if covered by a shimmering violet veil."
    }

    #t6a686f66714a0c6d7b8f7d ^"The Wand to Produce a Forest Overnight" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 20, +1 Touch, +2 Sun; +10 unlimited uses)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (90), 2 seasons (68), 3 seasons (60), 4 seasons (57)"
            ^"Printed Effect Line" STRING "CrHe 45 Pen: 0, unlimited uses R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 121
        }
        DESCRIPTION "Instilled in an oak wand, this effect matures a plant in about two hours. Typically, a person carries the wand and a sack of live acorns. Pushing the acorn into the ground, he then touches it with the wand, speaks the command word, and gets out of the way. This enchanted device is not limited to oaks and acorns, however, and will mature any plant from a seed to full growth."
    }

    #tb86fa697cf6fb34a5645c7 ^"The Chorus of the Distressed Hare" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Concentration +1 clear sounds; +1 frequency, +5 maintains concentration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (18), 2 seasons (14), 3 & 4 seasons (12)"
            ^"Printed Effect Line" STRING "CrIm 9 Pen: 0, 2/day R: Per, D: Conc, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This effect, instilled in any small device, produces terrified rabbit shrieks upon command. Such noise is very effective in drawing curious predators, especially those that eat rabbits. Because the device maintains concentration on the spell it can be commanded to stop, which lets it be set and used in two different locations in a day. The created species of sound need not penetrate a magical creature’s Magic Resistance to be heard."
    }

    #ta4ecdef4f6ad907bdf4b27 ^"A Ring to Approach Animals Undetected" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, + 1 Touch, +2 Sun; +1 frequency, +3 environmental trigger)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (28), 2 seasons (21), 3 seasons (19), 4 seasons (18)"
            ^"Printed Effect Line" STRING "PeIm 14 Pen: 0, Constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This lesser enchanted device is a ring (+2 shape and material Lab Total bonus) that destroys the wearer’s scent, allowing easier access when sneaking up on animals."
    }

    #t298e45873b1087e56be7af ^"A Net of Immobilization" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "30"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, + 1 Touch, +2 Sun; +1 frequency, +3 environmental trigger, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (78), 2 seasons (59), 3 seasons (52), 4 seasons (49)"
            ^"Printed Effect Line" STRING "ReAn 39 Pen: 30, Constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This simple device is a net (+5 Shape and Material Bonus to Lab Total) that paralyzes any animal caught in it. The target is immobilized until the following sunrise or sunset after the net is removed, which may aid transportation depending on its Size. It is ideal for capturing smaller animals."
    }

    #t6c35082688f4cbd1521b94 ^"Trap of the Humane Hunter" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 57
            ^"Penetration" STRING "30"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind (up to Size +3)"
            ^"Effect Design" STRING "(Base 5, +3 Sight, +2 Sun, +2 Size; +2 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (114), 2 seasons (86), 3 seasons (76), 4 seasons (72)"
            ^"Printed Effect Line" STRING "ReAn 57 Pen: 30, 3/day R: Sight, D: Sun, T: Ind (up to Size +3)"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "Instilled in a wand or a staff tipped with a topaz (+5 Shape and Material Bonus to Lab Total), this effect paralyzes an animal when the command word is spoken. The effect must Penetrate the target’s magic resistance to work. Care must be taken when used on birds and fish, because sudden paralysis will affect their means of locomotion and could cause injury. This effect will not prevent a magical animal from using its powers, which it can invoke without any necessary physical activity."
    }

    #t1bf093f45c6e093bf6935a ^"The Saddle of Settling the Wild Stallion" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "30"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind (up to Size +3)"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +2 Size increase; +1 frequency, +3 environmental trigger, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (88), 2 seasons (66), 3 seasons (59), 4 seasons (55)"
            ^"Printed Effect Line" STRING "ReAn 44 Pen: 30, constant effect R: Touch, D: Sun, T: Ind (up to Size +3)"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "When placed on an animal’s back, this saddle calms the beast, allowing it to be easily handled and even ridden."
    }

    #te811d0d7cc07b93be82fe5 ^"Instantaneous Transportation of the Captured Beast" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "30"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 35, + 1 Touch; +5 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (120), 2 seasons (90), 3 seasons (80), 4 seasons (75)"
            ^"Printed Effect Line" STRING "ReAn 60 Pen: 30, 24/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "Instilled in a shepherd’s crook, this device instantly transports an animal to anywhere that the wielder has an arcane connection to, typically a predetermined pen or cage. The wielder holds the arcane connection against the crook’s shaft and touches the animal. Once the command phrase is spoken, the animal is transported away.\n\nBase Level Interpretation: Rego Corpus base level 35 instantly transports the target to a place that the caster has an arcane connection to, and the Rego Animal guidelines explicitly state that the Rego Corpus guidelines can be used for animals."
    }

    #t55472678450495bba69275 ^"Shrinking to the Convenient Size" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Staff of Convenient Shipping"
            ^"Rules Section" STRING "The Staff of Convenient Shipping"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+30"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +3 Moon, +2 additional Size reduction, +2 Target Size adjustment; +5 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (120), 2 seasons (90), 3 seasons (80), 4 seasons (75)"
            ^"Printed Effect Line" STRING "MuAn 60 Pen: +30, 24/day R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "This power shrinks the animal 4 Sizes. It will not affect animals that start at greater than Size +7."
    }

    #t8d128b21f8f0e64e51671b ^"Changing to the Convenient Shape" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Staff of Convenient Shipping"
            ^"Rules Section" STRING "The Staff of Convenient Shipping"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 55
            ^"Requisite" STRING "Herbam"
            ^"Penetration" STRING "+30"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +3 Moon; +5 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (110), 2 seasons (83), 3 seasons (74), 4 seasons (69)"
            ^"Printed Effect Line" STRING "MuAn(He) 55 Pen: +30, 24/day R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "This power turns an animal into a crate for a month. The animal does not need to eat, sleep, or breathe while under this effect."
    }

    #t27bbb74971d728fa08b150 ^"The Brand of Ownership" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+30"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Dia"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2 (create an image that affects two senses), +1 Touch, +1 Diameter, +1 for clear words; +10 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (60), 2 seasons (45), 3 seasons (40), 4 seasons (38)"
            ^"Printed Effect Line" STRING "CrIm 30 Pen: +30, unlimited uses R: Touch, D: Dia, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This brand creates an illusory image of the beast’s owner, sitting atop or standing next to the creature. The illusion looks like the owner and announces his name repeatedly until the effect ends. It is activated whenever anyone touches the beast. The owner should be aware that this brand is a blatant display of magical power, and might not work in areas where subtlety is preferred."
    }

    #ta19cfff15c41a28b659531 ^"The Brand of the Aroused Stallion" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind (up to Size +2)"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +1 Size modifier; +10 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (70), 2 seasons (53), 3 seasons (47), 4 seasons (44)"
            ^"Printed Effect Line" STRING "ReAn 35 Pen: +20, 1/day R: Touch, D: Sun, T: Ind (up to Size +2)"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "This brand arouses the creature as a prelude to mating, usually used on the lead stud of the herd, or a male with highly desired physical characteristics. It works on the animal’s emotions and is much more helpful for males than females, whose bodies might not be in season despite the sudden mental urge to procreate. The brand is triggered by a command word spoken by a trainer or groom. Once activated, the animal becomes increasingly aggressive and might prove dangerous to its handlers."
    }

    #t826a67433826abc375337d ^"The Brand to Ward off Rustlers" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun; +10 frequency)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (50), 2 seasons (38), 3 seasons (34), 4 seasons (32)"
            ^"Printed Effect Line" STRING "CrMe 25 Pen: 0, unlimited uses R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "The brand protects a beast from a mundane thief. When a human hand touches the beast, the brand creates an overpowering fear of the beast in the person’s mind, hopefully causing him to flee. The effect has no penetration, so that the maga can easily handle the animal herself when necessary."
    }

    #t61c07f6d9595af491272f5 ^"Horn of Hearing the Cow Laden with Child" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "30"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch; +5 frequency, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (50), 2 seasons (38), 3 seasons (34), 4 seasons (32)"
            ^"Printed Effect Line" STRING "InAn 25 Pen: 30, 24/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "This hollowed-out cow horn, placed against an animal, will indicate to the holder if the targeted animal is pregnant. The intent is for the animal handler to use this on a female after mating to see if conception occurred."
    }

    #t34e59ea69e4a245d6df159 ^"Ease of Birthing" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "20"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 4, + 1 Touch, +2 Sun, +2 Room; +1 frequency (2 uses per day), +3 environmental trigger, +10 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (78), 2 seasons (59), 3 seasons (52), 4 seasons (49)"
            ^"Printed Effect Line" STRING "CrAn 39 Pen: 20, Constant effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "Instilled in a small wooden statue, this effect grants a mammal a +9 Recovery bonus to delivering its young. It is usually placed in a stall or pen, and the animal must spend the entire delivery period in the room to receive the benefits of the statue. Created to aid magical beasts, who are immune to Warping, it can be used on mundane animals, but will inflict a Warping point because it is a powerful mystical effect."
    }

    #t013bf6df124d5343c4fb02 ^"The Lens of Avian Inspection" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 23
            ^"Penetration" STRING "30"
            ^"Uses" STRING "Constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 1, +1 Touch, +2 Sun; +1 frequency, +3 environmental trigger, +15 Penetration)"
            ^"Required Lab Total" STRING "Required Lab Total: 1 season (46), 2 seasons (35), 3 seasons (31), 4 seasons (29)"
            ^"Printed Effect Line" STRING "InIm 23 Pen: 30, Constant effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Instilled in a clear glass lens (+5 Shape & Material Bonus), this effect lets a viewer see through an egg’s shell and view its interior. Using the same principle as the spell Prying Eyes, the lens allows the viewer to inspect the developing chick inside the egg. The lens must touch both the egg and the viewer at the same time."
    }

}
