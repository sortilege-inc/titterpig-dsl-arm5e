EXTENSION "ARMDef_Hermetic_Projects_Menagerie_Spells" {
    NAME "Ars Magica Fifth Edition, Hermetic Projects - Chapter Seven: The Menagerie of Magical Beasts spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Hermetic_Projects_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #ta4dec17c6bcf72603a6337 ^"Conjure the Mighty Barn" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrHe 25 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This spell creates a large barn constructed entirely of wood, including paddocks, stalls, and a loft. The barn is 100 paces long and wide, and twenty feet high. The interior’s design is determined by the caster.\n\n(Base 3, +1 Touch, +3 size, +2 elaborate design)\n\nRequired Lab Total: 1 season (50), 2 seasons (38), 3 seasons (34), 4 seasons (32)"
    }

    #tc3fdfc7912cd1cce72c63f ^"Conjuring the Magical Wolf" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 60
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Mentem, Vim"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrAn(Me, Vi) 60 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "This ritual spell creates a magical wolf, as described in **ArM5**, page 193. Once created, the wolf is not naturally friendly with the caster, and instantly reacts according to its own motivations.\n\n(Base 50, +1 Touch, +1 Mentem requisite)\n\nRequired Lab Total: 1 season (120), 2 seasons (90), 3 seasons (80), 4 seasons (75)"
    }

    #t300ad785540e4b5bf3060f ^"Fashion the Ancient Worm" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 80
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Corpus, Ignem, Mentem, Vim"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrAn(Co, Ig, Me, Vi) 80 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This spell creates a dragon, which has the same statistics and powers as Stellatus (ArM5, page 194). This dragon is not actually Stellatus, who is an individual, but the creature mirrors his powers and Abilities.\n\n(Base 50, +1 Touch, +2 Size increase, +3 Corpus, Ignem, and Mentem requisites)\n\nRequired Lab Total: 1 season (160), 2 seasons (120), 3 seasons (107), 4 seasons (100)"
    }

    #t8207ac03f4a8391f1b1a34 ^"The Breath of Life Returned" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 80
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrAn 80 R: Touch, D: Mom, T: Ind, Ritual"
            ^"Source" STRING "Hermetic Projects"
            ^"Page" INTEGER 130
        }
        DESCRIPTION "This spell returns a mundane animal of up to Size +1 to life.\n\n(Base 75, +1 Touch, Ritual) Required Lab Total: 1 season (160), 2 seasons (120), 3 seasons (107), 4 seasons (100)"
    }

}
