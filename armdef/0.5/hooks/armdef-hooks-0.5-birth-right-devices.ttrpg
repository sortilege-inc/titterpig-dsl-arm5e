EXTENSION "ARMDef_Hooks_BirthRight_Devices" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Two: Birth Right devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Hooks_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t7d031db928a37f6ccc4497 ^"Quiet My Darling Husband" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "a plain gold wedding ring"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1 / day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "While (Worn)"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 While)"
            ^"Printed Effect Line" STRING "ReMe 10, 0 Pen, 1 / day R: Touch, D: While (Worn), T: Individual"
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This faerie ring causes the wearer to fall asleep."
    }

}
