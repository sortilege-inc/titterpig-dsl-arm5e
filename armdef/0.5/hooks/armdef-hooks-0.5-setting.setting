SETTING "ARMDef_Hooks_Setting" {
    NAME "Ars Magica Fifth Edition, Hooks - places"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"

    # LOCATION: the places the book prints as headings -- its eight scenarios are set wherever the troupe's saga
    # is, so there is no root: Birth Right's faerie court and Nursery; Into the Valley's estate, marker, shop,
    # church and gelb; New Deal's town, warehouse and townhouse; Salvation's monastery, mass grave and crypt;
    # Small Game's city and fair; To the Dark Tower's County of Penthièvre. A place's text is in its chapter's
    # .lore, under its heading.

    LOCATION ^"The Faerie Court" #te36a20b00607a3f376d52e {
        # p12
        TAGS ["place"]
    }
