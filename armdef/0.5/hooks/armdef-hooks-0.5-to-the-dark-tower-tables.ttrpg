EXTENSION "ARMDef_Hooks_ToTheDarkTower_Tables" {
    NAME "Ars Magica Fifth Edition, Hooks - Chapter Nine: To the Dark Tower tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Hooks_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t21ed269f47a0f58882ae50 ^"Sir Erwan’s Greater Malediction (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Roll", "Effect"]
            ^"Source" STRING "Hooks"
            ^"Page" INTEGER 89
        }
        TABLE {
            "1-3" "Gains Compulsion Flaw"
            "4-6" "Gains Delusion Flaw"
            "7-9" "Gains Short Attention Span Flaw"
            "10-12" "Gains Poor Memory Flaw"
            "12+" "Gains Depressed Flaw"
        }
    }

}
