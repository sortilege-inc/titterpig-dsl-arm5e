EXTENSION "ARMDef_HoH_MysteryCults_Bjornaer_Virtues_Flaws" {
    NAME "Ars Magica Definitive Edition, Houses of Hermes: Mystery Cults - House Bjornaer Virtues & Flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_Core_Virtue_Flaw"

    # Found by evidence: a section whose first paragraph OPENS with the source's
    # own "*Size, Category*" note, run in ahead of the body. Size and Category are
    # classified by value, not by position; a parenthesised qualifier becomes its
    # own field. The kind comes from the "New Virtues" / "New Flaws" heading the
    # record sits under.

    #t47a803f2a13da150e482ed ^"Clan Ilfetu" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Hermetic"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is a member of Clan Ilfetu, and has received extra training in the rituals of the House. You receive 50 extra experience points that may be spent on House Bjornaer Lore, Magic Lore (with a specialty in the Great Beasts), and Gothic, the dead language that the House uses for all of its rituals. It is possible that the magus has also been Initiated into the Esoteric Mystery of Divination and Augury (see *The Mysteries Revised Edition*); if so, this Virtue must be purchased with the normal allowance of ten points of Virtues and Flaws. Clan Ilfetu teaches the Divination method of haemagmomancy, which is divination by observing the blood splatters of wounded animals; this gives the following bonuses to Divination: +5 family, +3 Corpus."
    }

    #t417045ec66429c606de623 ^"Keen Sense of Smell" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character’s nose is more sensitive than normal for a human. He gets a +3 bonus to all rolls involving his sense of smell, including following tracks with the Hunt Ability."
    }

    #t198c5d4aebea9b31d3968a ^"Pack Leader / Natural Leader" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is a dominant person with a demeanor that encourages others to do what he says. His self-assured manner gives him a +3 bonus to social situations\n\nin which he takes the lead; people are more likely to follow his orders or do as\n\nhe suggests. If he is Gifted, this bonus can temporarily help to overcome the social\n\npenalty of The Gift, due to the strength of his domineering personality. Members of House Bjornaer who were Initiated early in their apprenticeship often have this Virtue."
    }

    #t5bdc5a78f88598315372c2 ^"Unbound Tongue" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Whenever the character is transformed into a non-human form (whether by spell, magic item, curse, or a heartbeast) he may speak any human languages he knows with no impediment. If he is a magus, he may use his voice as normal to cast spells."
    }

    #t9ab5ae2eb0c7a95498bed4 ^"Feral Scent" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Perhaps due to his beast blood or feral upbringing, the character has the strong natural smell of a wild animal. Humans tend to avoid being too close to him, and may be on edge in his vicinity without knowing why. He may well spook domesticated animals if he surprises them. He suffers a –1 penalty to social interactions (which stacks with the penalties imposed by The Gift, if he has it), and develops a negative Reputation of Unclean at level 2. However, if he has Initiated the Sensory Magic Mystery, any spells he casts with a Scent Target have twice their normal area of effect."
    }

    #t3ca9a56619c834127770f0 ^"Pack Mentality / Follower" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Personality"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is a follower, not a leader. He rarely takes the initiative, but is usually happy to follow the direction of a forthright and decisive person. If he finds a leader, he tends to stick with her."
    }

    #taec0c69cd9255dc651b3af ^"Secretive" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Personality"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is prone to keeping secrets from his sodales. He rarely explains what he is doing or why he is doing it, which can frustrate those around him."
    }

    #t6cad614d0426921aa24619 ^"Slothful" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Personality"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character is lazy and indolent, and enjoys nothing better than doing as\n\nlittle as possible. He is very good at coming up with excuses as to why things need not be done right now. When roused into action, he works as hard as any other, but is constantly looking for opportunities to lapse into sloth again."
    }

}
