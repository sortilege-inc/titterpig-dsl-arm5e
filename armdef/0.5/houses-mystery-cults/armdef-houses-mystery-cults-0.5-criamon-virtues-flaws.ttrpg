EXTENSION "ARMDef_HoH_MysteryCults_Criamon_Virtues_Flaws" {
    NAME "Ars Magica Definitive Edition, Houses of Hermes: Mystery Cults - House Criamon Virtues & Flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-28"
    DEPENDS_ON "ARMDef_Core_Virtue_Flaw"

    # Found by evidence: a section whose first paragraph OPENS with the source's
    # own "*Size, Category*" note, run in ahead of the body. Size and Category are
    # classified by value, not by position; a parenthesised qualifier becomes its
    # own field. The kind comes from the "New Virtues" / "New Flaws" heading the
    # record sits under.

    #t543c022e91355c95fb26ff ^"Dance that Heals" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Characters from some Sufi traditions have the ability to dance objects to wholeness, much as magi on the Path of Walking Backward do."
    }

    #td14bb67a0ab54100811169 ^"Guest of the House" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "Magi with this Virtue are, politically, members of House Criamon, but may be created using the rules for any other House. Guests are offered membership, which Criamon see as a political formality, for many reasons. The troupe and player should determine why the character found it necessary to find sanctuary with this House."
    }

    #t79bfd1dfc1c1b40e0db311 ^"Gorgiastic" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "These magi, or their ancestors, have rejected the teachings of House Criamon. These magi may have Enigmatic Wisdom and House Criamon Lore scores after character creation. The character’s Enigmatic Wisdom Score cannot exceed 4 without the assistance of Criamon magi, or a magical breakthrough. House Criamon attempts to convince Gorgiastic magi to rejoin. Gorgiastic magi do not usually have Criamon stigmata, but develop them if they begin to delve into the causes of things."
    }

    #t6a9e610c8f79c5a229971c ^"Speech with the Silent" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character has the ability to charm elemental objects into assisting him, as magi on the Path of Strife do."
    }

    #td5aa8a2d995edbe3362ea3 ^"Inscribed Shadow" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character’s stigmata are reflected by glowing symbols in the character’s shadow. This causes alarm among nonmagicians and makes the character’s stigma extremely easy for other Criamon magi to read (+3 on all rolls). The shadow’s glowing symbols do not vanish when there is insufficient light to form a shadow, they burn brighter. Characters who use magic to hide their stigmata are not acting aptly."
    }

    #t88e9c28973509df7c76417 ^"Stigmatic Catalyst" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Mystery Cults"
        }
        DESCRIPTION "The character’s presence causes symbolic marks to appear on the bodies of people without magic resistance nearby. The magus cannot control this process, but may make Intelligence + Enigmatic Wisdom rolls of 6 or more to tell those so afflicted what form or spiritual purification they must undergo for the stigma to disappear. Characters who are stigmatized may react violently toward the magus."
    }

}
