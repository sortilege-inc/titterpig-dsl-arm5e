EXTENSION "ARMDef_HoH_Societates_Tytalus_Spells" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: Societates - House Tytalus spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-27"
    DEPENDS_ON "ARMDef_Core_Magic_Spell"

    # Chapter Three's spells, from the chapter body and from its sidebars alike.
    # A section becomes a spell only if it actually prints a stat line, so the set
    # is derived from the source rather than from a list that could omit one.

    #t5f98325ce42b1993ef7463 ^"Aura of Beguiling Appearance" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 10 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell is a variant of *Aura of Ennobled Presence*, except that it causes the target to appear more friendly, conciliatory, and credible. The character gets a +3 on rolls to win trust and make friends. In a debate, the target receives a +3 to Defense Totals based on Charm. The social penalties caused by The Gift are not negated by this spell; the caster merely seems to be suspiciously over-friendly.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #tcd2d1861622ba45b0677c0 ^"Aura of Childlike Innocence" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 10 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell is a variant of *Aura of Ennobled Presence*, except that it causes the target to appear more guileless, gullible, and naïve. The character gets a +3 to rolls to deflect suspicion or convince others of his innocence. In a debate, the target receives a +3 to defenses based on Guile. To those affected by the caster’s Gift, his apparent innocence and unblemished honor appears sanctimonious and self-righteous.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #t5127e4dedeabc4e6d118f7 ^"The Succubus’s Trick" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 5
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuCo 5 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell causes a female caster to adopt male physical characteristics. A similar spell (*The Incubus’s Trick*) turns a male caster into a woman. Eye color, hair color, hairstyle, stature, build, and similar characteristics are not changed by this spell, so anyone familiar with the caster’s original appearance can easily recognize her after the change (although the enchanted maga is sometimes instead assumed to be her own “twin brother”). The names of these spells derive from demons of lust who can change their gender.\n\n(Base 3, +2 Sun)"
    }

    #tfb3ef258ebf76ed6b5cafc ^"The Far-Speaking Voice" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 20
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrMe 20 R: Arc, D: Diam, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "The caster can deliver two minutes of conversation directly into the mind of the person to whom he holds an Arcane Connection, although the target cannot communicate back. This spell is often\n\nplaced within an enchantment (either a charged item or one with an effect which expires) with the caster’s own Arcane Connection, allowing a spy to communicate with him.\n\n(Base 3, +4 Arc, +1 Diam)"
    }

    #t178dfcfa3fa1297ae7c46a ^"Donning the Mask of Another" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING ""
            ^"Printed Stat Line" STRING "MuMe 35 R: Touch, D: Year, T:"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "Ind, Ritual This spell creates a persona from the identity of another (henceforth called the donor). The donor must be present during the Ritual spell, but need not be willing or even conscious for the correct operation of the spell, though it must penetrate any Magic Resistance as usual.\n\nThe caster acquires the full memories and personality of the donor as a deep cover disguise with a Reputation score of 3, but which offers no reduction in the social penalty of the caster’s Gift. This spell can also be used on characters who have established a deep cover disguise of their own, in which case it confers the Reputation at the same score as the donor’s, with the\n\nsame reduction in The Gift’s effects that he enjoyed. If, in the year that the caster maintains this foreign identity, he is able to apply at least 5 experience points to the Reputation, then the Reputation persists once the spell’s Duration expires.\n\nThe caster must employ further magic to acquire the physical resemblance of the persona. The caster could even fool close friends and family, if his physical disguise is good enough. This spell inflicts one Warping Point on both the caster and donor when it is cast (from the powerful mystical effect), and the caster suffers an additional Warping Point at the end of the spell’s duration (from the constant mystical effect).\n\n(Base 10, +1 Touch, +4 Year)"
    }

    #t162a8fa07f8a48e261151e ^"Reveal the Hidden Words" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Aquam" FIXED
            ^"Level" INTEGER 5
            ^"Range" STRING "Per"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Group"
            ^"Enchanted Item" STRING "Pen +0, 1/day, Charged Item"
            ^"Printed Stat Line" STRING "MuAq 5 Pen +0, 1/day, Charged Item R: Per, D: Diam, T: Group"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "Any group of words written in the enchanted, colorless liquid becomes visible upon activating its magic, as the ink turns black for Diameter Duration.\n\n(Base 2, +1 Diam, +2 Group)"
    }

    #t04f721e955c11848c7ac55 ^"The Clandestine Mask" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Imaginem" FIXED
            ^"Level" INTEGER 4
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 4 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell blurs the face and distorts the voice of the caster, so that she may not be recognized by anyone who knows her. The caster’s sigil determines what form this disguise takes; Carolus of Tytalus, whose sigil is darkness, has his face cast perpetually in shadow and his voice echoing and deep. Harpax, whose sigil is multiplicity, acquires a new face every few seconds, and his voice changes randomly between accents and pitches. A magus with a particularly obvious sigil must create a more powerful version (+1 magnitude for higher complexity) to blur this distinction further.\n\n(Base 2, +2 Sun)"
    }

    #t26a4b8690be73fbe69630c ^"Betraying Whispers of the Jealous Mind" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 30
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Hearing"
            ^"Printed Stat Line" STRING "InMe 30 R: Per, D: Conc, T: Hearing"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell allows the caster to hear the dominant emotion regarding himself from those who come within his earshot. He does not sense any emotions other than those which pertain to himself, and each emotion manifests as a muffled voice in his head, repeating again and again a word or short phrase which indicates that emotion. Thus, if his rival is jealous of his reputation, the caster might hear “Your fame should be mine” whispered over and over. The volume of the voice indicates the proximity of the emotion. By concentrating, the caster can single out one voice among any others within earshot; as the caster approaches the owner of that emotion, he hears an increase in the volume of the voice.\n\n(Base 5, +1 Conc, +3 Hearing, +1 complexity — only detects emotions concerning the caster)"
    }

    #t1f22b9ffca5733e0217792 ^"Enchantment of the Pedestrian Pigeon" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 15
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 15 R: Eye, D: Moon, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "After telling a person a piece of information, this spell is cast to occlude the memory of that information. A key phrase or word is also set at the time of casting, and subsequently uttering this phrase unlocks the memory. If the message has not been delivered by the time the Duration expires, then the memory of the information is restored to the target. A spell to read the thoughts of the target does not reveal the protected information unless its Penetration exceeds the spell’s level.\n\n(Base 2, +1 Eye, +3 Moon, +1 complexity)"
    }

    #tf694e42a9dc08931f46441 ^"Burning Issue of the Day" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 30
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReMe 30 R: Eye, D: Sun, T: Group"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "After casting this spell, the caster utters a piece of information (true or false) to the target Group, and must speak in a language that the targets understand. The members of the Group are then strongly inclined to repeat that information to anyone they meet for the Duration of the spell.\n\n(Base 5, +1 Eye, +2 Sun, +2 Group)"
    }

    #t425fe9724f307f3b2f8ef1 ^"Coerce the Spirit of Anger" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 20 R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell makes a spirit of anger obey the caster as long as he can coerce it with threats. The more lurid and dramatic the threats, the more cooperative the spirit is. If the spell penetrates the spirit’s Magic Resistance, make a stress roll of Communication + Leadership to see how effective the threats are. The storyguide should always give a bonus or penalty depending on the potency of the threat, but note that any roll other than a botch compels at least minimal obedience, while increasing rolls indicate a more cooperative spirit. Note that the caster must be capable of sensing the spirit to use this spell,\n\nunless it is reinvented at Range Arcane Connection.\n\n(Base 5 [see *The Mysteries Revised Edition*, page 28], +2 Voice, +1 Conc)"
    }

    #tb256657cd4dc2b56758fd1 ^"Summoning the Spirit of Anger" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Mentem" FIXED
            ^"Level" INTEGER 40
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReMe 40 R: Arc, D: Conc, R: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell calls a spirit of wrath to the magus’s current location, if he has an Arcane Connection or knows its full name, and overcomes its Magic Resistance. The name can be a non-magical name, and need not be a magical True Name. A wrathful person serves as an Arcane Connection to any spirit of anger; if he has a Major Personality Flaw such as Wrathful, then the spirit has a Magic Might of 30. A Minor Personality Flaw attracts a spirit of Might 20. Otherwise, the spirit has a Might equal to (5 x Angry Personality Trait). Casting this spell inflicts a Warping Point on the source of the anger, unless it is the caster himself.\n\nSimilar spells exist for summoning the spirits of other emotions.\n\n(Base 15 [see *The. Mysteries. Revised. Edition*, page 28], +4 Arc, +1 Conc)"
    }

    #t868cdf4f1dd535b70e424e ^"Reveal the Lurking Watchers" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Level" INTEGER 30
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InVi 30 R: Per, D: Conc, T: Vision"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This spell allows the caster to see any creatures of the Magic realm within his field of view and identify them as possessing Magic Might. The spell does not distinguish between what is spiritual and what is not, so if a spirit has an animal form, the caster may mistake it for a magical animal. The caster receives no information about the type of creature except that which can be deduced from its appearance. This spell must penetrate the Magic Resistance of\n\nthe creature; if it fails to penetrate a spirit’s Might, then the spirit cannot be seen by the caster.\n\n(Base 5, +1 Conc, +4 Vision)"
    }

    #t41d9cb4b510bec75c17565 ^"Invoke the Pact of Zelos" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"General Level" BOOLEAN true
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING ""
            ^"Printed Stat Line" STRING "ReVi Gen R: Arc, D: Mom, T:"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "Ind, Ritual This spell represents the formation of a pact with Zelos, the Daimon of rivalry and contention. It targets a duplicate (called an Aspect) of Zelos, rather than the spirit itself, and if the spell penetrates the Aspect’s Might (see insert), that Aspect appears before the caster to perform a specific service. This spell does not exert any control over this spirit.\n\nWithout the Mystery Virtue of Hermetic Theurgy, this spell must have a level of at least 40 (twice the Might of the Daimon’s Aspect), and it usually needs to be cast using *Wizard’s Communion*, to achieve sufficient Penetration. As a spell adapted from non-Hermetic theurgic practices, it requires knowledge of a Mystery, or a Hermetic Breakthrough, to invent, although nontheurgist Hermetic magi can learn the spell from a Lab Text or from a teacher. Acquiring an Arcane Connection to a Daimon such as Zelos is no simple task, and may be the focus of a story in its own right.\n\n(General effect, +4 Arc, see *The Mysteries Revised Edition*, Chapter 9: Hermetic Theurgy for more details)"
    }

    #t1d190ab71c593d65466278 ^"Ward the Cruel Touch of Pestilence" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrCo 20 R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "The target gains a +9 bonus to Stamina rolls to avoid contracting diseases (see ArM5, Debilitation, page 180).\n\n(Base 4, +1 Touch, +3 Moon)"
    }

    #t59d8079ad213882fc783c8 ^"Gentle Caress of Aesclepius" DEF {
        EXTENDS ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING ""
            ^"Printed Stat Line" STRING "CrCo 30 R: Touch, D: Mom, T:"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "Ind, Ritual All of the target’s wounds immediately improve by one level of severity; an Incapacitating Wound becomes a Heavy Wound, a Heavy Wound becomes a Medium Wound, and so forth. Light Wounds are healed instantly.\n\n(Base 25, +1 Touch)"
    }

}
