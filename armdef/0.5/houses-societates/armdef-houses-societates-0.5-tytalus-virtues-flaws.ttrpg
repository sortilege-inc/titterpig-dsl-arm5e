EXTENSION "ARMDef_HoH_Societates_Tytalus_Virtues_Flaws" {
    NAME "Ars Magica Fifth Edition, Houses of Hermes: Societates - House Tytalus Virtues & Flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-27"
    DEPENDS_ON "ARMDef_Core_Virtue_Flaw"

    # Chapter Three's new Virtues and Flaws. Size and Category come from each
    # record's OWN opening line and are classified by value, not by position -- this
    # book prints the two in either order.

    #t58252e6090f2ef92b8e50c ^"Leper Magus" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic"
            ^"Restriction" STRING "House Tytalus only"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "This Virtue describes the mystic legacy passed on from Tytalus to Hariste’s line through the vector of leprosy. This Virtue can only be bought if the character also has the Leprosy Flaw. It allows him to draw upon the strength of his body to increase the power of his magic, granting the Life Boost Minor Virtue. He can also draw even deeper into this power if he desires, mortifying his disease-ridden flesh to produce vis to power his own spells. The vis generated in this way can only be used by the magus himself, in spellcasting or laboratory activities (but not study), and cannot be stored in any way — in fact, it never leaves his body. By accepting a Light Wound, the magus can infuse a single magical working with three pawns of vis, of any Technique or Form. A Medium Wound supplies six pawns, a Heavy Wound nine pawns, an Incapacitating Wound 12 pawns, and a Deadly Wound (killing the magus) 15 pawns. Any vis that is produced beyond the magus’s capacity to use in the current magical activity is lost, as is any vis surplus to the requirements of the activity to which this power is applied. Leprotic wounds open on the magus’s body as he calls upon this power, but not quickly enough to affect the Casting Total of a non-Ritual spell affected by this power. All Lab Totals suffer the wound penalty as normal, as do the Casting Totals of spells that take more than one round to cast (such as Ritual spells). These wounds\n\ndo not start to heal until the magical activity that they are being used for is complete (i.e., at the end of the casting of the spell, or the end of a season for lab work), and since the power is expressed from the pain of these wounds, magic used to negate that pain also negates the benefits of this Virtue. A wound taken in this fashion must heal completely before the power may be used again, and any character using this power more than three times a year must make an extra Aging roll in winter."
    }

    #tdca136c158c0b3a4f82863 ^"Persona" DEF {
        EXTENDS ^"Virtue"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "The character may adopt one or more flawless disguises, changing both his physical appearance and mannerisms. Choosing this Virtue confers the Supernatural Ability Persona 1 (see Personae, above)."
    }

    #t00f6194ed5184fdab93956 ^"Leprosy" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Major"
            ^"Category" STRING "General"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "A leper has a permanent –2 modifier to her Living Conditions (with an additional –1 if she lives in a leper colony), and whenever she undergoes an Aging Crisis (ArM5, page 170) the leper sustains a Heavy Wound in addition to any other result. Lepers cannot gain a positive Reputation due to a pungent rotting smell that they emanate."
    }

    #t18a086dfce71c89239b649 ^"Beloved Rival" DEF {
        EXTENDS ^"Flaw"
        PROPERTIES {
            ^"Size" STRING "Minor"
            ^"Category" STRING "Story"
            ^"Source" STRING "Houses of Hermes: Societates"
        }
        DESCRIPTION "The character has a rival who is both fiercely protective of him and obsessed with opposing him at every turn. For Tytalan magi, this rival is usually an older maga, most likely the magus’s former teacher, or possibly an elder apprentice\n\nof the character’s master. Much like the Enemies Flaw (ArM5, page 53), the rival periodically causes trouble for the magus; however, she jealously guards the privilege of making the magus’s life a misery, and often steps in to remove obstacles that are not of her own making. The rival genuinely believes that her opposition benefits her victim, and desires to see him prosper through adversity."
    }

}
