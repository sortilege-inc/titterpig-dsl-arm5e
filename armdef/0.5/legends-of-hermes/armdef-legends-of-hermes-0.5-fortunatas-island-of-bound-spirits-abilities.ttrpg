EXTENSION "ARMDef_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_Abilities" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Three: Fortunata’s Island of Bound Spirits abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #t5ea4fab3cb70370ada5017 ^"Principles Lore" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 47
        }
        DESCRIPTION "Principles Lore is a Mystery Cult Lore of Fortunata’s own devising (see this chapter, Cult Lore: Fortunata’s “Principles Lore”), which forms the basis of Initiations and Initiation Scripts devised by Fortunata. She copied and distributed texts on Principles Lore, hoping that others might follow her teachings, but they are largely forgotten by 1220. The actual Initiation Scripts she kept mostly to herself: they form part of the treasure in the library."
    }

}
