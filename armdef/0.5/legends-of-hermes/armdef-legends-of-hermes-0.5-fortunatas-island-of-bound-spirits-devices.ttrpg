EXTENSION "ARMDef_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_Devices" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Three: Fortunata’s Island of Bound Spirits devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t720d4b5b8cf3c03774a5d6 ^"Empowering Prison of the Declining Spirit (Fortunata’s Lab Text)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Empowering Prison of the Declining Spirit"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Requisite" STRING "Muto, (Form)"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "enchantment, Mystery (Hermetic Empowerment), , 1 use per day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect)"
            ^"Printed Effect Line" STRING "Re(Mu)Vi(Form), Gen, enchantment, Mystery (Hermetic Empowerment). R: Per, D: Mom, T: Ind, Pen +0, 1 use per day."
            ^"Location" LIST [#tc482b9586e031a01166bd0 ^"Fortunata’s Laboratory and Library"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 65
        }
        DESCRIPTION "This enchantment binds a spirit into the device, draining its Might Score to power Ritual Magic effects in the device. The library has Lab Texts for Empowering Prisons for Terram, Ignem, Imaginem and Mentem, at levels 20, 34, and 50. (See this chapter, Initiation of Hermetic Empowerment)\n\n(Base effect)"
    }

    #t939dc0848df10945fb005f ^"Calling The Dead" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+20"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +4 Arc, +1 Conc, +10 levels for penetration, +5 levels 24/day, +5 maintain concentration)"
            ^"Printed Effect Line" STRING "ReMe 60 Pen +20, 24/day R: Arc, D: Conc, T: Ind"
            ^"Location" LIST [#t7958c6fc3b6907b271af63 ^"Fortunata’s Villa"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 65
        }
        DESCRIPTION "Calls up a ghost which has a regular haunt if you are at that place, or if you have previously summoned the ghost by magic, and you have an Arcane Connection such as the ghost’s full name. This effect is particularly applicable to spirits originally called by Ritual summoning.\n\nOnce summoned, the Staff maintains concentration on the summoning, until the ghost is dismissed.\n\n(Base 15, +4 Arc, +1 Conc, +10 levels for penetration, +5 levels 24/day, +5 maintain concentration)"
    }

    #td1850b5f6f7225a67a6b50 ^"Maintain the Caster’s Spell" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 30, +1 Touch, +1 Diam, +5 levels 24/day)"
            ^"Printed Effect Line" STRING "ReVi 45 Pen +0, 24/day R: Touch, D: Diam, T: Ind"
            ^"Location" LIST [#t7958c6fc3b6907b271af63 ^"Fortunata’s Villa"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 65
        }
        DESCRIPTION "Applied to a spell which you have already cast and are concentrating to maintain, the device sustains the spell for a diameter while you perform other actions. You can still concentrate on the spell to alter its effects. The device affects spells up to level 40.\n\n(Base 30, +1 Touch, +1 Diam, +5 levels 24/day)"
    }

    #tc9f17b1e0a9dc8ef8fd9af ^"Empowering Prison of the Declining Spirit" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Requisite" STRING "Muto, (Forms)"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Mystery enchantment , uses per day as enchanted"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Guideline level)"
            ^"Printed Effect Line" STRING "Re(Mu)Vi(Forms), Gen, Mystery enchantment Pen +0, uses per day as enchanted R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 54
        }
        DESCRIPTION "The enchantment has requisites of all Forms of all Ritual Effects to be powered by the Empowering Prison. Effects with other Forms cannot be powered by this Prison. The base level of the enchantment must equal or exceed twice the Might of the spirit that will be bound; uses per day limits the number of Ritual Effects which can be powered each day. An enchanted device may have more than one Empowering Prison, to bind more spirit Might, or for to cover additional Forms.\n\nOnce a spirit is commanded to enter the device and so bound to an *Empowering Prison*, it is trapped so long as the enchantment remains, even if its Might falls below a useful level. The spirit is freed if the *Prison* is disenchanted or the device is shattered.\n\nWhile bound to the *Empowering Prison*, the spirit cannot use its Might for any purpose other than resisting spells cast on it, and cannot leave the prison. It can use powers with no Might cost, so many spirits can perceive the world and converse with those nearby.\n\nDraining Might Score from a spirit is agonizing, and many spirits are driven insane by the process. Since they cannot be fully drained by this process, breaking the device is likely to release a furious, maddened spirit, not caring that the breaker is their kind liberator.\n\n(Guideline level)"
    }

    #tb989bfcbd5435f7a3e56f4 ^"Monocaudus’ Binding" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 55
            ^"Penetration" STRING "+32"
            ^"Uses" STRING "constant use"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 20, +1 Touch, +2 Sun; Modifications +4 levels constant, +16 levels Penetration)"
            ^"Printed Effect Line" STRING "ReMe 55 R: Touch, D: Sun, T: Ind Pen +32, constant use"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 64
        }
        DESCRIPTION "While under this enchantment, Monocaudus must obey Fortunata, or her continuing commands, or any deputized agent of Fortunata.\n\n(Base 20, +1 Touch, +2 Sun; Modifications +4 levels constant, +16 levels Penetration)\n\nNote that Monocaudus is guileful and very hard to persuade as to the genuine agency of any new command — even from Lucida; he also sometimes talks himself out of the duties he has been ordered to, such as maintaining the villa, or at the very least he shirks his duty. Even while Fortunata was here, she had to remind and chastise him for slacking. It may be possible, if difficult, to masquerade as Fortunata well enough to claim rulership of Monocaudus."
    }

}
