EXTENSION "ARMDef_Legends_of_Hermes_FortunatasIslandOfBoundSpirits_Guidelines" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Three: Fortunata’s Island of Bound Spirits guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #ta44274aa6d3a8996e79832 ^"Rego (Form) Guidelines (Legends of Hermes, Spells to Summon and Command Spirits)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "(Form)" FIAT "guidelines for a spirit of any Form; the book prints the Form as a placeholder, 'a disembodied spirit of (Form)' (p65)"
            ^"Printed Name" STRING "Spells to Summon and Command Spirits"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 65
        }
        GUIDELINES {
            "Level 5" "Control a disembodied spirit of (Form)."
            "Level 15" "Summon a disembodied spirit of (Form)."
        }
        DESCRIPTION "The following Guidelines appeared in *The Mysteries: Revised Edition*, page 28:"
    }

}
