EXTENSION "ARMDef_Legends_of_Hermes_TheFourAspectsOfConciatta_Books" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Two: The Four Aspects of Conciatta books"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's books, structured; each DESCRIPTION the source's text, verbatim.

    #tca4b5490c7ca14b3aa4f9e ^"The Application of Vim to the Supernatural Humors" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Application of Vim to the Supernatural Humors"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 7
            ^"Section" STRING "Research"
            ^"Printed Entry" STRING "The Application of Vim to the Supernatural Humors (tractatus on Magic Theory, quality 7)"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 12
        }
    }

    #t38636d86aa40d26609cf94 ^"The Tome of Binro" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Tome of Binro"
            ^"Section" STRING "Conciatta’s Spells, Devices, and Laboratory Texts"
            ^"Printed Entry" STRING "Binro was an early follower of Bonisagus who took an interest in the realms and sought to extend Bonisagus’ theory to include them. The early House saw Bonisagus’ great theory as being a set of principles against which to invent and apply new Arts."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 26
        }
        DESCRIPTION "Binro was an early follower of Bonisagus who took an interest in the realms and sought to extend Bonisagus’ theory to include them. The early House saw Bonisagus’ great theory as being a set of principles against which to invent and apply new Arts. But while the House’s wisdom was that the three new Arts should be researched, one each for the Divine, Faerie, and Infernal realms, Binro saw Bonisagus’ theory as flawed from the outset. His opinions on the theory led some of his Bonisagus colleagues to label him, only partly in jest, “heretic.” This volume is a collection of 60 correspondences (*Covenants*, page 90), many in Binro’s own hand, each contributing to a discussion on how Magic Theory could, or should, accommodate the supernatural realms.\n\nThe tome can be studied in two ways. Firstly, as a level 6 tractatus on Magic Theory. Doing so reveals that the text contains a casting tablet. The spell is clearly experimental, even by contemporary standards, and is a variation on the common *Ward Against Faeries of the Wood* spell."
    }

}
