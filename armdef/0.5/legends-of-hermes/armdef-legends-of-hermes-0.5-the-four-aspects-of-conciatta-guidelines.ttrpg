EXTENSION "ARMDef_Legends_of_Hermes_TheFourAspectsOfConciatta_Guidelines" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Two: The Four Aspects of Conciatta guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tce8f9d5497598957e460a6 ^"Intellego Vim Guidelines (Legends of Hermes, New Spell Guidelines for Auras)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Intellego" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Printed Name" STRING "New Intellego Vim Guidelines"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 17
        }
        GUIDELINES {
            "Level 1" "Detect the presence and strength of a supernatural tether of level 5 or higher."
            "Level 2" "Detect the presence and strength of a supernatural tether of level 4 or higher."
            "Level 2" "Detect the presence of a subsumed aura."
            "Level 3" "Detect the presence and strength of a supernatural tether of level 3 or higher."
            "Level 4" "Detect the presence and strength of a natural or supernatural tether of level 2 or higher."
            "Level 5" "Detect the presence and strength of any natural or supernatural tether."
        }
        DESCRIPTION "Natural and Preternatural tethers are described in *Realms of Power: Magic*, page 10. Tethers are objects or circumstances of mystical significance that draw fluid vis to a location and both cause and sustain an aura. Storyguides should feel free to extend the metaphor to all of the four supernatural auras."
    }

    #t53227137c1386921d8a680 ^"Rego Vim Guidelines (Legends of Hermes, New Spell Guidelines for Auras)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Vim" FIXED
            ^"Printed Name" STRING "New Rego Vim Guidelines"
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 17
        }
        GUIDELINES {
            "General" "Suppress an aura of strength less than or equal to the spell’s magnitude. The aura is not destroyed but its effects, including any casting bonuses/penalties, are suppressed for the spell’s duration. The aura returns to full strength at the end of the spell’s duration. The presence of the suppressed aura is detected by magic or abilities that can normally detect such auras. This Ritual cannot affect regio levels beyond the mundane level. As the target aura is still in place, merely locked away, events and actions that fuel the aura may raise the level beyond the power of this Ritual to contain it. If this happens, the Ritual’s power is broken and the aura is made apparent again. (Ritual)"
        }
    }

}
