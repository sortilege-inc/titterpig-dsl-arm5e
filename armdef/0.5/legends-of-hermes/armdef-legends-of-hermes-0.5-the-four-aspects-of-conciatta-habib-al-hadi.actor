EXTENSION "ARMDef_Legends_of_Hermes_TheFourAspectsOfConciatta_HabibAlHadi" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Habib al-Hadi"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # Habib al-Hadi (Chapter Two: The Four Aspects of Conciatta, p34): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t99c487f2b32279c21177ec ^"Habib al-Hadi" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Location" LIST [#t7e5e4e69cf1d7319329b53 ^"The Roman Theater"]
            ^"Characteristics" STRING "Int +2, Per 0, Pre 0, Com +2, Str –2, Sta –1, Dex –1, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "45 (45)"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "‘Alim, Educated, Arcane Lore; Poor"
            ^"Personality Trait" STRING "Inquisitive +2, Humble +1, Persistent +1 Combat: Dodge: Init: –1, Attack N/A, Defense –1, Damage N/A Fist: Init: –1, Attack –1, Defense –1, Damage –2 Bludgeon: Init: –2, Attack +1, Defense –1, Damage +0"
            ^"Soak" STRING "–1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Arabic 5 (Qadis), Art of Memory 2 (academic texts), Artes Liberales 5 (astronomy), Awareness 2 (searching), Cadis Lore 3 (geography), Concentration 3 (reading), Dominion Lore 1 (auras), Faerie Lore 2 (auras), Folk Ken 2 (townsfolk), Greek 3 (ancient texts), Infernal Lore 2 (auras), Islamic Law 4 (Ijma’), Latin 3 (academic usage), Magic Lore 2 (auras), Philosophiae 5 (metaphysics), Scribe 3 (copying), Teaching 4 (Artes Liberales), Theology: Islam 4 (Sunni)"
            ^"Equipment" STRING "The Fourfold Lens (see later), slates and chalk, quill, ink, and parchment."
            ^"Appearance" STRING "A small wiry man with gray hair and beard. He has a large nose and a brow furrowed by both concentration and worry. He has a disheveled appearance and his clothes are noticeably worn and threadbare, a result of spending what little money he does have on his studies."
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "Realms of Power: The Divine, page 114\n\nHabib is a scholar, cleric, astronomer, translator, and teacher. In fact, given his perpetually poor finances, he takes on any job that is asked of him so that he can maintain a roof over his head, food in his belly, and parchment for his studies – but not always in that order. He has an inquisitive mind and is fascinated by the sights he has recently seen. He may be tempted to part with the magical device in his custody, but only if his study of supernatural Qadis can be supported in other ways."
    }

}
