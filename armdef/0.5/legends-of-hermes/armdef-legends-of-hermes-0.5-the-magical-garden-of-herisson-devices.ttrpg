EXTENSION "ARMDef_Legends_of_Hermes_TheMagicalGardenOfHerisson_Devices" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Four: The Magical Garden of Hérisson devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t779bf920ca571819c6361f ^"Bloodthorn" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +3 Moon)"
            ^"Printed Effect Line" STRING "Creo Corpus 15 Pen 0, charged item R: Touch, D: Moon, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "Each sloe (that is, fruit) of this blackthorn bush provides a +6 to Wound Recovery Rolls for Duration Moon. This is a Charged Item with an unusual method of delivery, and 4 charges remain on the plant.\n\n(Base 3, +1 Touch, +3 Moon)"
    }

    #tcb4aafd8456c74f81b96d3 ^"Fruitful Medlar" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 1, +2 Sun, +1 Part, +1 size; +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "Creo Herbam 9 Pen 0, constant R: Per, D: Sun, T: Part"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This small tree produces ten times as much fruit as a normal example of its kind, in the proper season. It was created as a Lesser Enchantment.\n\n(Base 1, +2 Sun, +1 Part, +1 size; +1 2/day, +3 environmental trigger)"
    }

    #t7e468a4890617dc945106b ^"False Mandrake" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 5, +2 Voice, +2 Group; +2 3/day)"
            ^"Printed Effect Line" STRING "Perdo Corpus 25 Pen 0, 3/day R: Voice, D: Mom, T: Group"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "Anyone touching the False Mandrake causes it to issue an ear-splitting scream that deafens those who hear it. This damage heals as a Light Wound.\n\n(Base 5, +2 Voice, +2 Group; +2 3/day)"
    }

    #tf9e35eeebb22b59b9fc24e ^"Traveling Thistle" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +2 Sun, +1 to allow property to be inherited; +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "Creo Vim 14 Pen 0, constant R: Per, D: Mom, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This thistle has a faint taint of magic, and the plants that grow from its seed have the same property as the parent (although they themselves do not pass the taint to their offspring). This is an apparently minor effect, but is the key to Hérisson’s self-replicating vis.\n\n(Base 3, +2 Sun, +1 to allow property to be inherited; +1 2/day, +3 environmental trigger)"
    }

    #t40ec73482131fe2ed76849 ^"Creeping Buttercup" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 10, +1 Part, +1 special effect)"
            ^"Printed Effect Line" STRING "Rego Vim 20 Pen 0, 1/day R: Per, D: Mom, T: Part"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "A yellow-flowered plant that grows close to the ground. This plant contains a single pawn of Herbam vis, and once in its life it can be triggered to transfer this pawn into one of its seeds. The plant that grows from the seed likewise inherits the same power.\n\n(Base 10, +1 Part, +1 special effect)"
    }

    #t39bf115120882447482e80 ^"Ever-Flowering Bramble" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +2 Sun, +1 special effect; +3 environmental trigger)"
            ^"Printed Effect Line" STRING "Creo Herbam 33 Pen 0, 1/day R: Per, D: Sun, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 88
        }
        DESCRIPTION "This blackberry seed grows into a plant, flowers, produces fruit, sets seed and dies back over the course of a day. In the following day, the seed set by the previous day’s plant repeats the cycle. The fruit produced (about a handful) is pleasant to eat and nutritious, but unless at least one is left on the bush, the regeneration cannot continue.\n\n(Base 15, +2 Sun, +1 special effect; +3 environmental trigger)"
    }

    #tb67f406ac8c8c001782e49 ^"Hazel of Many Tools" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5 — see Covenants, page 51)"
            ^"Printed Effect Line" STRING "Rego Herbam 5 Pen 0, charged item R: Per, D: Mom, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "The straight branches growing from this hazel stump are suggestive of all sorts of wooden and metal tools. A character who names a tool next to the plant causes one of the twigs to form itself into the exact shape of that tool, which can then be broken off and used. The character must succeed in an Intelligence + Finesse simple roll of 9 or more to make a tool of standard quality. This is a Charged Item employing craft magic that has an unusual method of delivery, and 10 charges remain on the plant.\n\n(Base 5 — see Covenants, page 51)"
    }

    #t7605c034e2bca2670c5916 ^"Daisy of Intellego Vis" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "16"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +1 Conc; +5 maintains concentration, +2 3/day, +8 Penetration 16)"
            ^"Printed Effect Line" STRING "Intellego Herbam 40 Pen 16, 3/day R: Touch, D: Conc, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "Anyone touching a plant with this large white and yellow flower can converse with plants as per Converse with Plant and Tree (InHe 25, ArM5 page 136). It must Penetrate any Magic Resistance of the target plant to have its effect.\n\n(Base 15, +1 Touch, +1 Conc; +5 maintains concentration, +2 3/day, +8 Penetration 16)"
    }

    #tb6ccd87b0033c06f6aebde ^"Stinking Hellebore of Rego Vis" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses /day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5,+1 Touch, +1 Diam; +10 unlimited uses)"
            ^"Printed Effect Line" STRING "Rego Corpus 25 Pen 0, unlimited uses /day R: Touch, D: Diam, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "Anyone who touches the fleshy green flowers of this stinking hellebore is paralyzed, and unable to move for two minutes.\n\n(Base 5,+1 Touch, +1 Diam; +10 unlimited uses)"
    }

    #t77b4cc265d373bd78cdd1d ^"Honeysuckle of Mentem Vis" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Scent"
            ^"Printed Effect Line" STRING "Rego Mentem 24 Pen 0, constant effect R: Per, D: Sun, T: Scent"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A vine covered in hooked yellow flowers with a strong scent. This plant’s fragrance affects everyone who smells it with an effect identical to Confusion of the Numbed Will. The perfume extends about 6 paces from the blossoms of the vine. (Base 4, +2 Sun, +2 Scent; +1 2/day, +3 environmental trigger)"
    }

    #tdd038b09d2b1b26fb10da3 ^"Fennel of Herbam Vis" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Ignem"
            ^"Requisite" STRING "Creo, Herbam"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +2 Sun, +2 requisites; +1 2/ day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "Rego (Creo) Ignem (Herbam) 24 Pen 0, constant effect R: Per, D: Sun, T: Ind"
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A tall spike rising from a fleshy bulb, bearing a cloud of tiny yellow flowers. This plant is protected from being burnt, providing +5 Soak against fire-related damage. Any damage done by fire is immediately repaired. It is host to the Ever-Burning Fire (see Stirpes, earlier).\n\n(Base 4, +2 Sun, +2 requisites; +1 2/ day, +3 environmental trigger)"
    }

}
