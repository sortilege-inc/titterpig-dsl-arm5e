EXTENSION "ARMDef_Legends_of_Hermes_TheMagicalGardenOfHerisson_VisSources" {
    NAME "Ars Magica Fifth Edition, Legends of Hermes - Chapter Four: The Magical Garden of Hérisson vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Legends_of_Hermes_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t1b4a1c4da5146f1ea37551 ^"Adder’s Tongue" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Perdo"
            ^"Yield" LIST OF STRING ["The curled leaf at the center of this wavy-leafed fern contains a pawn of Perdo vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "The curled leaf at the center of this wavy-leafed fern contains a pawn of Perdo vis."
    }

    #tfd5c9d422286bb97a23a40 ^"Alexanders" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Herbam"
            ^"Yield" LIST OF STRING ["The fleshy stems of this tall, pungent herb contains a pawn of Herbam vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "The fleshy stems of this tall, pungent herb contains a pawn of Herbam vis."
    }

    #t609fc6e0bd11c4d2c8f6f2 ^"Ever-Burning Fire" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Ignem"
            ^"Yield" LIST OF STRING ["Flames blossoming within the Fennel of Herbam Vis (see Lesser Enchantment Vis, later) contain a pawn of Ignem vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "Flames blossoming within the Fennel of Herbam Vis (see Lesser Enchantment Vis, later) contain a pawn of Ignem vis. This Stirps derives from a fire elemental."
    }

    #t922f07ac9bdd5bf58d93af ^"Harebell" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Animal"
            ^"Yield" LIST OF STRING ["The delicate flower has downy blue fur reminiscent of a hare’s, and has a pawn of Animal vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "The delicate flower has downy blue fur reminiscent of a hare’s, and has a pawn of Animal vis."
    }

    #t3e11f094f72a8011214f53 ^"Pasternack (carrot)" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Aquam"
            ^"Yield" LIST OF STRING ["A common garden vegetable, the sweet purple roots of this plant contain a pawn of Aquam vis (orange varieties of carrots are rare in Mythic Europe)."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A common garden vegetable, the sweet purple roots of this plant contain a pawn of Aquam vis (orange varieties of carrots are rare in Mythic Europe). **Selfheal: **This tiny plant with minute violet flowers contains a pawn of Creo vis."
    }

    #t9a61552771d8d3b79e5676 ^"Silverweed" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Terram"
            ^"Yield" LIST OF STRING ["This creeping buttercup-like plant has leaves made of real silver, which contain a pawn of Terram vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "This creeping buttercup-like plant has leaves made of real silver, which contain a pawn of Terram vis."
    }

    #t3cb59fe675cc36d5981fb5 ^"Henbane of Virtue" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Perdo"
            ^"Yield" LIST OF STRING ["A tall herb with sticky hairy leaves and a fetid odor, Henbane is extremely poisonous, and contains a pawn of Perdo vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A tall herb with sticky hairy leaves and a fetid odor, Henbane is extremely poisonous, and contains a pawn of Perdo vis. It is Enriched by taking a single seed capsule and seeping it in the venom of a scorpion and the crushed skulls of three owls, exposing the mixture to the night sky whenever Saturn is in ascendance. After a season, the seedpod must be swallowed. This grants the Lesser Immunity to Poison Virtue, but also strikes a random sense organ or limb completely numb, inflicting one of the following Flaws (roll a simple die): (1–2)\n\nAfflicted Tongue; (3–4) Poor Eyesight; (5–6) Poor Hearing; (7–8) Missing Hand; (9–10) Lame. The effects of the Virtue and Flaw wear off after a year. Three Enriched capsules can be found nestled next to the stem of a Henbane of Virtue."
    }

    #t090dd62888d9718fd0bf6b ^"Wild Teasel of Virtue" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Corpus"
            ^"Yield" LIST OF STRING ["The sticky juice of this plant contains two pawns of Corpus vis, but if it is instead fed to a pregnant dog, and the milk-teeth of her litter are ground up and added to wine, the drinker becomes especially war-like; gaining the Puissant Brawl, Tough, and Berserk Virtues, but also the Minor Personality Flaw of Wrathful."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "The wild teasel has a tall stem with a distinctive burr the size of an egg.\n\nThe sticky juice of this plant contains two pawns of Corpus vis, but if it is instead fed to a pregnant dog, and the milk-teeth of her litter are ground up and added to wine, the drinker becomes especially war-like; gaining the Puissant Brawl, Tough, and Berserk Virtues, but also the Minor Personality Flaw of Wrathful. These Virtues and Flaw last for one year, or until the affected character tastes the juice of the valerian plant."
    }

    #t7c86d85beb6c47692ee10c ^"Valerian of Virtue" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Creo"
            ^"Yield" LIST OF STRING ["The greenish juice extracted from the root is a powerful medicine, and in the Valerian of Virtue the root has two pawns of Creo vis."]
            ^"Location" LIST [#t88f662629bf343de9473c4 ^"Hérisson’s Garden"]
            ^"Source" STRING "Legends of Hermes"
            ^"Page" INTEGER 89
        }
        DESCRIPTION "A low-growing herb with paired lance-head shaped leaves and clusters of pale pink flowers on a stem. The greenish juice extracted from the root is a powerful medicine, and in the Valerian of Virtue the root has two pawns of Creo vis. The root can be Enriched by being sliced with a silver knife on a night when Venus is in the sky, bathed in horse urine every Friday, then ground between two pieces of amber. Enriched Valerian Juice grants Rapid Convalescence, Enduring Constitution, and Reserves of Strength Virtues, but also the Code of Honor Flaw. These Virtues and Flaw last for one year, or until the affected character tastes the milk of the teasel."
    }

}
