EXTENSION "ARMDef_Lords_Of_Men_ArmsAndArmor_Glossary" {
    NAME "Ars Magica Fifth Edition, Lords of Men - Supplement: Arms & Armor glossary"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Lords_Of_Men_Core_Ext"

    # The chapter's glossary, structured; each DESCRIPTION the source's text, verbatim.

    #tb8f681670fa67358f36a3d ^"Ailettes" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Flat plates of boiled leather worn to protect the collarbone and shoulder."
    }

    #tc0f0a5c291ae7f3ce1254d ^"Aketon" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "The padded jacket worn under a mail hauberk; see also gambeson."
    }

    #t790455dd34dfc40b00cfa4 ^"Bascinet" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A late medieval helmet that fits the contours of the head and neck. Usually equipped with a movable visor."
    }

    #t5dce033fc5a0b077069379 ^"Brigandine" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Late medieval armor made of small, overlapping metal plates riveted to an outer layer of canvas or leather. It is rather like an inside-out version of scale armor."
    }

    #t46d432544fe2bf9b499266 ^"Cap-a-pie" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Literally “head to foot,” the term characters would use for full armor."
    }

    #t307fd7657e6da2441ef7ee ^"Cap, Iron" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A helmet that protects mainly the crown of the head, leaving the face exposed."
    }

    #t21ffb7e5177c06f600954d ^"Camail" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A mail hood that covers the head, forehead, and lower face."
    }

    #te51f4b34d40887c9678f5a ^"Chapel de fer" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "French term for a kettle hat."
    }

    #t4afc3471806782997ecc93 ^"Chausses" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Leggings made of mail."
    }

    #t39292a194999004f88de81 ^"Coat of Plates" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A lamellar cuirass, historically worn over mail between about 1250 and 1300 AD. Use the statistics for a metal scale cuirass."
    }

    #t02f31a6f62cc12244231f0 ^"Coif" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "An open-faced mail hood."
    }

    #t0c4ba1a4a59df082d133c5 ^"Cuirass" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A breastplate and backplate; the most basic sort of rigid body armor."
    }

    #te047e9f9f7c077208a4292 ^"Cuirboulli" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A form of boiled leather made by boiling in oil rather than water."
    }

    #tfdc468c7c3654a84cec962 ^"Fauld" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Lamellar hip protection, worn with late-medieval plate armor."
    }

    #t7ac702f1a24b671a99e2d8 ^"Gambeson" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A garment made of padded material. It could be a short tunic, a sleeveless surcoat, or a long-sleeved hauberk which could be worn over, under, or instead of another armor. Indeed, it’s not uncommon for knights to wear a light gambeson (also called an aketon or arming jacket) under their mail, and a heavier one over it."
    }

    #td25c4eccffbcbb6d7d43f1 ^"Gauntlet (Lords of Men)" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Printed Name" STRING "Gauntlet"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Armor for the hands."
    }

    #tf5d0a88d9b77342ad8fab6 ^"Gorget" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A stiff collar of boiled leather (or, in the late Middle Ages, iron) that protects the throat and neck."
    }

    #t5b6d040e324383ee8770cd ^"Greaves" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Plate or boiled-leather armor for the lower legs."
    }

    #t9bb2d915e9fa5679f55de3 ^"Hauberk" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A knee-length, long-sleeved coat of flexible armor. It protects the body, arms, and upper legs."
    }

    #t95f285ed726a26d0a067b6 ^"Haubergeon" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A short-sleeved armored tunic, covering the torso and shoulders only."
    }

    #t87103de5584951e50c4d4a ^"Helmet, Open" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A helmet protects the sides and rear of the head, but leaves the face at least half exposed."
    }

    #t3c3fb07a82a91146f1af3b ^"Helm" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A high-medieval piece of headgear that completely encases the head and neck in plates of iron."
    }

    #t5a5cb03121c0856962e03b ^"Jack" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A brigandine jerkin, common in the late medieval period. Also leather jack."
    }

    #tc5a03020ece877009a47ee ^"Jambes" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Plate armor covering the legs."
    }

    #td1c588344e1cbbfea6a7f3 ^"Jerkin" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A short, sleeveless jacket."
    }

    #t1d746a91176307bfa1acd3 ^"Kettle Hat" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A bowl-shaped iron cap with a wide metal brim. Popular with the common soldiers of the high and late Middle Ages."
    }

    #t470bc6850058d60e47f655 ^"Lamellar" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Overlapping plates fastened to each other rather than to a piece of backing material. The plates can be small, similar to those in scale armor, or larger, as in a lorica segmentata."
    }

    #t5d697b85093f8891a95d88 ^"Lorica Hamata" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Roman name for a mail haubergeon."
    }

    #tfa0034c9cd115c917f38fd ^"Lorica Segmentata" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A lamellar cuirass used in Imperial Rome, with horizontal strips of metal encircling the torso, overlapping like the plates of a lobster’s tail."
    }

    #ta747b60fc6fdf3a57c5bb7 ^"Poleyns" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Knee protectors made of iron or boiled leather."
    }

    #t319b45f5fa57f7351657c1 ^"Ring Armor" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Early medieval armor of leather reinforced by non-overlapping metal rings."
    }

    #t4b63b009da06c9c252310e ^"Sabaton" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Armor for the feet."
    }

    #t41e4abe367af50c8d5b205 ^"Sallet" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "A late medieval, rounded helmet with a visor."
    }

    #te45647caf38ff7fec3beae ^"Scale Armor" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Small plates fastened to a layer of backing material. The plates overlap vertically, like the scales of a fish."
    }

    #t62c2af4b6fafb980bf9641 ^"Vambraces" DEF {
        EXTENDS #ted45fb602406678bb67615 ^"Armor Term"
        PROPERTIES {
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 141
        }
        DESCRIPTION "Armor for the arms."
    }

}
