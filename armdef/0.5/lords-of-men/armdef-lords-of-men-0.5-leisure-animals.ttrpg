EXTENSION "ARMDef_Lords_Of_Men_Leisure_Animals" {
    NAME "Ars Magica Fifth Edition, Lords of Men - Chapter Five: Leisure animals"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Lords_Of_Men_Core_Ext"

    # The chapter's animals, structured; each DESCRIPTION the source's text, verbatim.

    #tbafe2c208dea0259d21fbc ^"Magpie" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Characteristics" DEF {
                ^"Cunning" INTEGER 0
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -2
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER -8
                ^"Stamina" INTEGER 0
                ^"Dexterity" INTEGER 3
                ^"Quickness" INTEGER 5
            }
            ^"Size" INTEGER -4
            ^"Qualities" STRING "Crafty, Mimicry, Timid, Vocal"
            ^"Soak" INTEGER 0
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1), –3 (2), –5 (3), Incapacitated (4), Dead (5+)"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 45
        }
        PERSONALITY_TRAITS {
            "Mischievous" +2
        }
        COMBAT {
            "Bite" INIT 4 ATTACK 9 DEFENSE 9 DAMAGE -7
            " Dodge" INIT 4 DEFENSE 9
        }
        ABILITIES {
            "Athletics" SCORE 3 SPECIALTY "flying"
            "Awareness" SCORE 4 SPECIALTY "predators"
            "Brawl" SCORE 4 SPECIALTY "dodge"
            "Music" SCORE 3 SPECIALTY "mimicry"
            "Stealth" SCORE 4 SPECIALTY "hiding"
            "Survival" SCORE 3 SPECIALTY "foraging"
        }
    }

