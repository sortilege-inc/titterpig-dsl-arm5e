EXTENSION "ARMDef_Lords_Of_Men_Leisure_Rules" {
    NAME "Ars Magica Fifth Edition, Lords of Men - Chapter Five: Leisure rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Lords_Of_Men_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #ta8cc38a99fb9a776bd7477 ^"Pursuit Total" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "The Chase"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 52
        }
        FORMULAS {
            "Pursuit Total" "Hound’s Perception + hound’s Hunt + stress die – lowest Fatigue penalty among the hounds vs. Evasion Total: Prey’s Dexterity + Athletics + Terrain Bonus (starts at 6) + stress die – Fatigue penalty"
        }
    }

}
