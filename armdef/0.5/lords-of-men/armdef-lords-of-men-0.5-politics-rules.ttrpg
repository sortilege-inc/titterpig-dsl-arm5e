EXTENSION "ARMDef_Lords_Of_Men_Politics_Rules" {
    NAME "Ars Magica Fifth Edition, Lords of Men - Chapter Two: Politics rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_Lords_Of_Men_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #tc2349c958c99f14b26e4d7 ^"Agents Formula" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Formula Name Source" STRING "editorial: the book prints no label for this formula; named for the section it stands in"
            ^"Rules Section" STRING "Agents"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 22
        }
        FORMULAS {
            "Formula" "2 x (Presence + Intrigue or Leadership – social penalty for the Gift) or 1, whichever is larger."
        }
    }

    #t00e6fb8835846a974dc090 ^"Acquiring Agents Formula" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Formula Name Source" STRING "editorial: the book prints no label for this formula; named for the section it stands in"
            ^"Rules Section" STRING "Acquiring Agents"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 23
        }
        FORMULAS {
            "Formula" "a stress die + Presence + Leadership – social penalty for the Gift against an Ease Factor of 6."
        }
    }

    #t74196aeb6e888a7ead3164 ^"Using Agents Formula" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Formula Name Source" STRING "editorial: the book prints no label for this formula; named for the section it stands in"
            ^"Rules Section" STRING "Using Agents"
            ^"Source" STRING "Lords of Men"
            ^"Page" INTEGER 24
        }
        FORMULAS {
            "Formula" "stress die + Communication + (Charm, Intrigue, or Leadership as situationally appropriate) + Bond Strength – social penalty of the Gift vs. an Ease factor on the Tasks for Agents table"
        }
    }

}
