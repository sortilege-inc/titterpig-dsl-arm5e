EXTENSION "ARMDef_Magi_of_Hermes_AurulentusOfJerbiton_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Two: Aurulentus of Jerbiton spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t95c8f924c639a0ac8bf5c9 ^"Widening the River Styx" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrCo 20, Ritual R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "Resolves a minor crisis caused by aging (see ArM5, page 170). The target still requires rest for the remainder of the season to recover fully.\n\nAurulentus successfully used this spell to probe the exact effects Hermetic magic can have during an Aging Crisis for his research.\n\n(Base 15, +1 Touch)"
    }

    #te0301ec7a22184ff6db18a ^"Blissful Sensations" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrCo 30 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "The spell removes all pain not exceeding the pain of a light wound from the target. As soon as the spell duration ends, the pain will return if the source still exists.\n\nAurulentus uses this spell to ease the pains of his wife. His version is specifically designed for his wife, such that she does not gain Warping from this spell (see **ArM5**, page 168). Frequent use of this spell often leads to an addiction, as the return of all the minor pains a human tends to ignore after the effect expires is overwhelming. The spell is not powerful enough to remove the pains of childbirth, Aurulentus uses the spell *Ease the Suffering of Childbirth *for this measure.\n\n(Base 15, +1 Touch, +2 Sun)"
    }

    #tfd5014b73effea69396513 ^"Artemis’ Fertility" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20 (heal any debilitating effects of poison, disease, or injury preventing conception), +1 Touch, +3 Moon)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrCo 40 R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "Increases the fertility of the target, thus improving the chances of conception. The spell does not guarantee conception, not even during the usual fertile phases of a woman, as Hermetic magic is unable to create life. All other magi Aurulentus has talked to do not believe that this spell works, but this does not deter him.\n\n(Base 20 (heal any debilitating effects of poison, disease, or injury preventing conception), +1 Touch, +3 Moon)"
    }

    #ta481f336154120db8ea09e ^"Bestow the Blessing of Apollon" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, +4 Year, +2 Room)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Room"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 50 R: Touch, D: Year, T: Room, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "All targets within the room gain a +18 bonus to Recovery rolls to recover from injuries or diseases, as long as they have been under the influence of this spell for the whole of the recovery interval. The recovery interval is counted from the time that the spell is cast or from the time the subject enters the room — whichever is later. Any previous time is ignored.\n\nThis spell was invented by Aurulentus as a proof of concept. It is no longer used, as it is too expensive in terms of vis and causes Warping. Instead, an Enchanted Item has been made with similar effects (see New Items: Bed of Rapid Convalescence).\n\n(Base 15, +1 Touch, +4 Year, +2 Room)"
    }

    #t4151319474f8cd782bbe85 ^"Incantation of the Warriors Made Whole" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 35, +1 Touch, +2 Room)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 50 R: Touch, D: Mom, T: Room, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Heals all damage to all human bodies in the room at the conclusion of the ritual. The targets must have been present in the room for the entire length of the ritual to benefit from the spell. The spell can only heal wounds, not such damage as missing limbs, or diseases and damage from poisons.\n\nThis improved version of the *Incantation of the Body Made Whole* was commissioned by a Tremere magus who wanted to save vis while healing a large group of wounded people. To use this during (or better, after) a battle, a tent may be used instead of a room. Using Target: Room rather than Group means that this spell can heal more wounded, if one can get all of them into a single room.\n\n(Base 35, +1 Touch, +2 Room)"
    }

    #tcc4ab18e6d942656e3f1c5 ^"Blessing of Artemis’ Fertility" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 20, +1 Touch, +4 Year, +4 Boundary)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 65
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Boundary"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "CrCo 65 R: Touch, D: Year, T: Boundary, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Increases the fertility of all within the boundary, even if they were not present at the completion of the ritual. As with the spell Artemis’ Fertility, no other magus believes that this spell works as anything other than a giant waste of precious Creo and Corpus vis.\n\nAurulentus points out that at his Covenant a higher than average rate of births is apparent, but most magi believe this to be merely a fluke. Other magi theorise that the mundanes are influenced by the fact that the magi have many children, and thus also act in a promiscuous way. So far, no-one has been able to replicate the spell, although Aurulentus gives copies of the Lab Texts of the spell freely to anyone asking for them.\n\n(Base 20, +1 Touch, +4 Year, +4 Boundary)"
    }

    #td255dd973dc34a21074cf7 ^"Pose Clotho‘s Question" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InCo 5 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Determines if the target is pregnant. The spell will fail if cast on a man. Clotho is the youngest of the three Fates.\n\n(Base 4, +1 Touch)"
    }

    #t0482c537129a085c9ddf7e ^"Parental Inquisitiveness" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +1 Part)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "InCo 10 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Determines the sex of an unborn child. Hermetic magic can only distinguish the unborn child as a Part of the mother from the second trimester of pregnancy onwards (see Ancient Magic, page 55), so this spell will fail if cast in the first trimester of pregnancy.\n\n(Base 4, +1 Touch, +1 Part)"
    }

    #t864d1e77114cc0b05c61e7 ^"Pose Nona’s Question" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Touch)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InCo 10 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Determines if the target is pregnant and how many months are left until birth, barring unforeseen circumstances. The spell will fail if cast on a man. If the target is not pregnant, the exact date of the menstrual cycle will be revealed. Nona is the Roman version of Clotho and goddess of pregnancy. She was often called upon by women in their ninth month of pregnancy to ensure a smooth birth.\n\n(Base 5, +1 Touch)"
    }

    #tba5ae364fa9386eed0c559 ^"The Maculate Noblewoman" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InCo 15 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Accurately determines the underlying reason for the infertility of the target.\n\nAurulentus successfully used this spell to compare two groups: those infertile from natural causes and those rendered infertile by a Longevity Ritual. Exploring the fundamental differences between these two groups, he was able to gather further insights for his breakthrough.\n\n(Base 10, +1 Touch)"
    }

    #t3627ac8b4b72cc21f7d691 ^"Verifying the Presence of Artemis’ Blessing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InCo 15 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "The caster is immediately aware of a conception in the target during the spell duration. Aurulentus observed grogs with and without Longevity Rituals during intercourse with this spell to explore the differences between the two groups. His research was unsuccessful, as he was not able to witness the actual creation of life with this spell.\n\n(Base 4, +1 Touch, +2 Sun)"
    }

    #t03ddbe6d013d7cfb11e2e4 ^"Ease the Suffering of Childbirth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun, +1 Part)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "MuCo 15 R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Widens the pelvis of the target, making delivery of the child straightforward. See Art and Academe, page 62, for rules regarding childbirth; this spell gives a +1 bonus to childbirth rolls.\n\nAurulentus invented this spell after realizing that his spell *Blissful Sensations* had too many undesirable side effects and was not powerful enough to help his wife during childbirth.\n\n(Base 3, +1 Touch, +2 Sun, +1 Part)"
    }

    #t429c402f5ea270c9d17a97 ^"Hold Chur" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +2 Sun, +1 close eyes)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 30 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Holds the target completely motionless for the duration of the spell. In addition, the spell closes the eyes of the target and keeps them firmly shut, so that he is unable to see for the duration of the spell.\n\nChur is a troublesome grog of the covenant. A lesser version of this spell was used to stop him when he was doing mischief. Aurulentus soon realized that a more-powerful version would have many uses: as a combat spell, as a spell to act without witnesses, and as a spell to stop nosy mundanes. It was once used on a friendly grog who came under the influence of a mind control spell to stop him from attacking his group without harming him.\n\n(Base 5, +2 Voice, +2 Sun, +1 close eyes)"
    }

    #t0a7aaacecad49a8be09c4c ^"House Arrest of the Unruly Child" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReCo 30 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Creates a circle which (if the spell penetrates) no human being may pass. Aurulentus uses this spell to either keep children away from important rooms such as his lab or his bedroom, or to keep children inside a room.\n\n(Base 15, +1 Touch, +2 Ring)"
    }

    #t1e733d8b4c00b16c44b707 ^"It’s Raining Men" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReCo 30 R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Instantly transports the targets five paces upwards into the air, after which they drop to the ground. This breaks up any military formation and inflicts damage as per the rules in ArM5, page 181. This spell was commissioned by a Tytalus magus who commanded a cavalry group and used the spell to break up spearmen lines just before charging into them. The Group target only allows for ten men to be thrust upwards, but this is usually enough to form a small breakthrough that a cavalry charge can exploit.\n\n(Base 10, +2 Voice, +2 Group)"
    }

    #tde5e9bc346fd69a6c8a2f6 ^"Seven Leagues Travel" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 30, +1 Touch)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 35 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Transports the target to any place within seven leagues either that the caster can see or that the caster has an Arcane Connection to. If the caster fails an Intelligence + Finesse stress roll against an Ease Factor of 9, the arrival goes slightly awry.\n\nThis is an improved version of the *SevenLeague Stride*, sometimes used by Aurulentus to travel with his wife. The spell is specifically designed for Semira, so as to not cause Warping if cast on her. After Aurulentus created Enchanted Items that allow for instant travel, this spell is only seldom used. It was once used to teleport a group into safety from a sinking ship.\n\n(Base 30, +1 Touch)"
    }

    #t4c4a80e8e69ea9c2b74733 ^"Comeliness of the Crone" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 10 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "The target appears less likeable, cute, and attractive. Numerous subtle changes in appearance bring about this change, including a shriller, higher pitched voice, a more crooked posture, and a slightly more bloated and unclean face and figure. The character gets a –3 modifier on all rolls to influence, seduce, or please others.\n\nAurulentus used this spell on his daughters to test whether their suitors were really more interested in personality than looks as they usually proclaimed. He stopped using it after his wife found out and forbade it. He now uses the *Bachelor’s Door* (see Enchanted Items) to test suitors of his daughters — without the knowledge of his wife.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #t381f9e809bb37aeff1b670 ^"Ears of a Grateful Father" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Conc, +2 Group, +1 changing images)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeIm 20 R: Touch, D: Conc, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "All voices emitted by a group of individuals will be decreased in volume to that of a normal conversation. Aurulentus invented this spell after he had to babysit ten screaming infants.\n\n(Base 3, +1 Touch, +1 Conc, +2 Group, +1 changing images)"
    }

    #tcf10b7f6b6b8b44aed1b72 ^"Phantasmal Troupe" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +2 Voice, +1 Conc, +2 change at command, +1 intricacy)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrIm 15 R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "Creates illusionary music from a direction that the caster specifies. A full troupe of musicians can be simulated in this way, with a finesse roll determining the quality of the music. Aurulentus uses this spell to amuse his wife and children. It was originally invented by his parens, Altus, with the same motivation.\n\n(Base 1, +2 Voice, +1 Conc, +2 change at command, +1 intricacy)"
    }

}
