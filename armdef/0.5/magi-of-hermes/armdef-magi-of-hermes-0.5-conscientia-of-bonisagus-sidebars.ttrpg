EXTENSION "ARMDef_Magi_of_Hermes_ConscientiaOfBonisagus_Sidebars" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Three: Conscientia of Bonisagus sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"New Flaw: Exciting Experimentation" #td3bc6899ed98d8f99ff3d4 {
            TEXT "New Flaw: Exciting Experimentation\n\n*Minor, Hermetic* Your character’s experiments tend to have a flair for the … dramatic. When rolling on the experiment table, roll two dice instead of the normal one. The Storyguide then chooses and applies the more amusing of your two results."
        }
    }

}
