EXTENSION "ARMDef_Magi_of_Hermes_ConscientiaOfBonisagus_Tables" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Three: Conscientia of Bonisagus tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t3239fac10e3b85008a7a70 ^"Apollo’s Fearful Gaze (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Light Source", "Penalty"]
            ^"Printed Name" STRING "Apollo’s Fearful Gaze"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 30
        }
        TABLE {
            "Moonlight or Candlelight" "–1"
            "Torchlight" "–3"
            "Bonfire" "–5"
            "Daylight" "Incapacitated"
        }
    }

}
