EXTENSION "ARMDef_Magi_of_Hermes_GwidionOfVerditius_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Four: Gwidion of Verditius spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tad9b76289aa26931e25b6e ^"Voice of the King" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +2 Voice, +1 Diameter, +1 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReAn 40 R: Voice, D: Diameter, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This spell works much as Commanding the Harnessed Beast (ArM5, page 120), with the exception that it is designed exclusively to work on whole swarms of bees (a swarm of bees weighs less than a pig, so no size adjustment is necessary). Bees are fairly intelligent as insects go, but they’re still just insects, so vague or overly complex commands are not likely to be very effective. The bees will probably still attempt the task even if they don’t understand it. Note that usurping the king bee’s authority can anger the hive once the spell wears off.\n\n(Base 15, +2 Voice, +1 Diameter, +1 Group)"
    }

    #t1ec96d23d8593749cc4af1 ^"Circle of Eternal Spring" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "CrHe 4 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This spell ensures that all plants within the circle grow well. It has the same effect as The Bountiful Feast (ArM5, page 135), but is based on Ring Duration and Circle Target.\n\n(Base 1, +1 Touch, +2 Ring)"
    }

    #t05cbc60fff771658f3d7d7 ^"Ladder Of Ivy" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrHe 15 R: Voice, D:Sun, T:Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "This spell creates a sturdy ladder of ivy that the magus or others can use to scale any wall or (low) cliff. The ivy withers at sunrise or sunset, and can reach up about twenty paces.\n\n(Base 3, +2 Voice, +2 Sun)"
    }

    #t16344211ac1a876262cb06 ^"Fast Grow" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrHe 30 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell brings a plant to full maturity in a single day or night. Note that the spell must be cast soon after sunrise or sunset for the duration to be long enough for its effect.\n\n(Base 15, +1 Touch, +2 Sun)"
    }

    #tb1cd693d0c856c515d332f ^"Fortress of Oak" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +3 Size, +3 Elaborate, +1 Terram Requisite, +1 Muto Requisite)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Muto, Terram"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "Cr(Mu)He(Te) 40 R: Touch, D: Mom, T: Individual, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This ritual is normally cast on an acorn from an oak tree and it works like the spell Conjuring the Mystic Tower (ArM5, page 153) with the exception that it utilizes a tree rather than stone. The tree springs from the ground in moments, towering to its full height of around eighty feet. The tree is still alive, but it has chambers within, complete with earthen floors and earthen hearths for fires. The magus decides the shape and design of the chambers when casting the spell. If the tree dies, the tower remains, now being a dead tree.\n\n(Base 3, +1 Touch, +3 Size, +3 Elaborate, +1 Terram Requisite, +1 Muto Requisite)"
    }

    #t56dbb8874f781021e5537f ^"Gigantic Growth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun, +1 Unnatural, +2 Size)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuHe 25 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell instantly increases the size of any plant by a factor of 100, turning bushes into barriers and saplings into mighty oaks. The plants instantly return to normal size at the end of the spell’s duration. Larger plants only grow to 100 times the size of a base Individual, but they can be affected.\n\n(Base 3, +1 Touch, +2 Sun, +1 Unnatural, +2 Size)"
    }

    #t8e4fd475aa7f8bdc36738a ^"Razor Thorns" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Voice, +1 Diameter, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Terram"
            ^"Printed Stat Line" STRING "MuHe(Te) 25 R: Voice, D: Diameter, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell causes razor-sharp thorns to spring out of every plant or plant-made product in an area within the range of the caster’s voice. These thorns deal +10 damage to up to a standard group of people (up to ten). The thorns eventually retreat, but they remain for roughly two minutes and can still act as a viable deterrent as the thorns are still just as sharp as a knife.\n\n(Base 4, +2 Voice, +1 Diameter, +2 Group)"
    }

    #tfac92a8003f264cd8fa412 ^"Blades of Grass, Leaves of Cutting" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Voice, +2 Sun, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuHe 30 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell makes all the grass and leaves of a group of plants as sharp as a sword’s blade; this can make an area utterly impassable for even the most armored of individuals.\n\n(Base 4, +2 Voice, +2 Sun, +2 Group)"
    }

    #t6629259b3877e8db8239b6 ^"Awaken Consciousness of Plant" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Voice, +4 Year, +2 Group, +2 Size)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 55
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Mentem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuHe(Me) 55 R: Voice, D: Year, T: Group, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell works exactly as the spell, Stir the Slumbering Tree (ArM5, page 137), only it is used to awaken multiple plants at once rather than one or two at a time. Once raised, the plants have a state of consciousness that resembles that of a human. The plants can see and hear what’s going on around them and at a normal human level of perception. Such plants tend to share some mental attributes or personality traits with the caster. The plants can rearrange their leaves, stems, or branches over the course of several hours, though too slowly for people to observe the movement from second to second. The size bonus enables the spell to awaken an entire forest grove in one go.\n\n(Base 4, +2 Voice, +4 Year, +2 Group, +2 Size)"
    }

    #tcbf75fe74660b6d2642846 ^"Prune Plant" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +1 size, +1 Rego Requisite)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Rego"
            ^"Printed Stat Line" STRING "Pe(Re)He 20 R: Voice, D: Momentary, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "The magus can instantly trim various parts of a plant into any shape that he wishes. The magi must specify the shape of the plant when he casts the spell. The magus cannot increase the size of the plant, nor kill a plant by over-pruning it with this spell, but he can remove or rearrange the branches and leaves in any way that he likes, just as if he where pruning it normally.\n\n(Base 3, +2 Voice, +1 size, +1 Rego Requisite)"
    }

    #tea231266c8e95507540081 ^"Wilt" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +1 Part, +3 size)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeHe 35 R: Voice, D: Momentary, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell causes a plant to wilt and die instantly, though it does not affect any enchantments or spells currently on the plant. Larger plants are still affected, but only parts of them at a time when the spell is cast.\n\n(Base 5, +2 Voice, +1 Part, +3 size)"
    }

    #t0a5e5e44763eaf40c38806 ^"Ring of Ever Bloom" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReHe 15 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell forces the plant or flower to continue to bloom even out of season.\n\n(Base 4, +1 Touch, +2 Ring)"
    }

    #ta5cc37a1c0c29efdd88903 ^"Controlled Growth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +4 Year)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Individual"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReHe 25 R: Touch, D: Year, T: Individual, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "Using this spell, the magus can shape the growth of a plant over the course of the next year, as if he were properly pruning it, caring for it, and so on. The eventual shape of the plant is determined when the spell is cast and it can be as simple or as complex as the magus desires, although truly complicated designs, such as making a bush grow in the shape of someone’s face, may require a Finesse check. Once the plant reaches the shape and dimensions that the magus wishes, it stops growing until the spell ends or a new spell is cast upon it. Once the spell ends, the plant will then grow normally, but it still retains its magically ‘pruned’ shape, until it grows naturally out of it. Fast grow spells, or other methods used to accelerate the growth of plants, will still work, but until this spell ends the plant will not grow past the design limits originally set. This spell does not change the essential nature of the plant nor give it anything that an exceptionally good gardener couldn’t.\n\n(Base 4, +1 Touch, +4 Year)"
    }

    #t7e6db5845825655974ac36 ^"Tree Top Walk" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Voice, +1 Concentration, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReHe 25 R: Voice, D: Concentration, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 39
        }
        DESCRIPTION "This spell moves the branches of nearby trees so that the magus can literally walk from one tree to the next without ever touching the ground. The trees do not uproot themselves, but they do bend in unnatural ways to help the magus reach them and walk unhindered from branch to branch. Of course, the trees’ branches still need to be strong enough to support the magus’ weight.\n\n(Base 4, +2 Voice, +1 Concentration, +2 Group)"
    }

    #td6a798cfd3eaae751134f7 ^"Prison Floral" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch, +2 Ring)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReHe 30 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "In an effort to protect his grogs, Gwidion developed this spell after discovering that many of his enchanted plants were starting to Warp under his magical effects. A circle is drawn around many of the aggressively Warped plants to help contain them and protect others from their more-bizarre effects. The spell imprisons the plant within the circle.\n\n(Base 15, +1 Touch, +2 Ring)"
    }

    #te391c0662096a9e7f0a919 ^"Command of the Forest" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +2 Sun, +2 Group, +3 size)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 55
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Mentem"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReHe(Me) 55 R: Touch, D: Sun, T: Group, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "The magus can make a whole wood of plants (up to 10,000 individuals in mass) move with purpose and intelligence to obey the magus’ commands, even if those commands are to uproot and run directly into a bonfire or to hit someone with its branches. The plants continue to obey the command until either the task is complete or the spell expires.\n\n(Base 10, +2 Voice, +2 Sun, +2 Group, +3 size)"
    }

    #t06e704e031ca48a32b7a33 ^"Warmth of the Wood" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun, +1 Part)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "CrIg 10 R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This spell heats the bark of a tree, the wood of a cart, or even the planks of a house so that it is warm to the touch. This a good effect to help dispel the chill of the night and keep the magus warm without having to build a fire.\n\n(Base 2, +1 Touch, +2 Sun, +1 Part)"
    }

    #t830e872868731a49e60767 ^"Frosted Timber" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Sun, +1 Part)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeIg 20 R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This spell cools the bark of a tree, the wood of a cart, or even the planks of a house so that it is cool to the touch. This a good effect to help dispel the heat of the night and keep the magus cool during the hotter seasons.\n\n(Base 4, +1 Touch, +2 Sun, +1 Part)"
    }

    #t439c1b292c3474b04c76f9 ^"Sight of the Blossom, Ears of the Oak" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +4 Arcane Connection, +2 Sun, +2 Group)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "InIm 30 R: Arcane Connection, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "While using this spell, the magus can see and hear what’s happening in a distant place if he possesses some sort of Arcane Connection to either the location or the person he’s scrying upon. Gwidion normally uses leaves or flower buds from trees and bushes all around his forest to help keep an eye on what’s going on when he’s not there.\n\n(Base 2, +4 Arcane Connection, +2 Sun, +2 Group)"
    }

    #tb94dd1e680b2538649db3d ^"Tilled Soil" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +1 Part, +2 Size)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 15 R: Voice, D: Momentary, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "This spell instantly tills an amount of soil equal to that of 1000 cubic paces, making it perfect for planting crops or just soft enough to lie down upon comfortably.\n\n(Base 2, +2 Voice, +1 Part, +2 Size)"
    }

    #t9a29e3b1123624d352de35 ^"Mold the Earth within Sight" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +3 Sight, +1 Part, +1 Size, +1 Elaborate, +2 stone)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReTe 30 R: Sight, D: Momentary, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 40
        }
        DESCRIPTION "Using this spell, the magus can shape an amount of earth equal to the mass of a hundred men into any form that he likes, although truly complicated forms may require a Finesse check. This spell was originally invented to help build quick walls or boundaries (even hasty circles), but its applications could be broader. This spell only works on dirt, rock, and stone; other more-exotic forms of Terram (metal, diamonds, gemstones, etc.) are unaffected.\n\n(Base 2, +3 Sight, +1 Part, +1 Size, +1 Elaborate, +2 stone)"
    }

}
