EXTENSION "ARMDef_Magi_of_Hermes_HughOfFlambeau_Guidelines" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Five: Hugh of Flambeau guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #tecdf5c574f5d0e621ad2f7 ^"Muto Corpus Guidelines (Magi of Hermes, New Guideline: MuCo 5)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Muto" FIXED
            ^"Form" STRING "Corpus" FIXED
            ^"Printed Name" STRING "New Guideline: MuCo 5"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 49
        }
        GUIDELINES {
            "Level 5" "Add or remove human body parts from the target in such a way that he no longer looks human. These parts are normally functional, although a spell may be deliberately designed so that they are not. The Target is Part, not Individual (although Group and higher Targets work as normal)."
        }
    }

}
