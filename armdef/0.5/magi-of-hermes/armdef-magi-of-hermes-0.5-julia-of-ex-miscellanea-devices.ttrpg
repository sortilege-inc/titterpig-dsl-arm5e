EXTENSION "ARMDef_Magi_of_Hermes_JuliaOfExMiscellanea_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Six: Julia of Ex Miscellanea devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tc3fce23fd401824412ab70 ^"Loom of Elfin Proportions" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Loom of the Kabouters"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 23
            ^"Penetration" STRING "0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuHe 23 Pen 0, 6/day R: Per, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "The loom can be shrunk to a tenth of its former size in each dimension, entailing a thousand-fold reduction in weight. Whereas it once stood six feet high, it is now only seven inches tall and can be easily carried in a backpack. Julia has a special box in which she keeps the shrunken loom so that none of the components will be lost or damaged in transit.\n\nThis spell is designed based on the *Object of Increased Size* spell (**ArM5**, page 154), but has an extra magnitude of complexity to make the loom shrink to a smaller size than allowed by that spell.\n\n(base 4, +1 Conc, +1 size, +1 complexity; +5 item maintains concentration, +3 6 per day)"
    }

    #t9442e9f01ef92a15d9f2fa ^"Panorama of the Heinzelmännchen" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Loom of the Kabouters"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "ReAn 10 Pen 0, 1/day R: Touch, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "The loom weaves wool into an intricate tapestry described when the effect is triggered. The operator’s skill at describing the effect in magical terms determines the quality of the tapestry; a Finesse roll of Ease Factor 12 is the minimum for a simple scene of standard quality. More-complex designs require higher Ease Factors. The finished tapestry can be any size up to one hundred square paces, and is woven exceptionally quickly rather than literally in a moment. The Heinzelmännchen are German brownies who are skilled at making clothes and weaving cloth.\n\n(base 1, +1 Touch, +2 Group, +1 size, +1 intricacy)"
    }

    #te2661ae3a9ed72f079b4a6 ^"The Everchanging Garments" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Fruit of the Loom"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Requisite" STRING "Herbam"
            ^"Level" INTEGER 28
            ^"Penetration" STRING "0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "MuAn(He) 28 Pen 0, 6/day R: Touch, D: Conc, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "The clothes to which the brooch is pinned can be utterly changed in their style and components, although animal products must remain animal products and plant-based fabrics must remain plant-based. However, a woolen cyclas could be turned into a silk bliaut, and a cotton gown could become a linen scarf. Dyed materials retain their color, but possibly alter shade according to the natural color of the base material. The wielder of the item must briefly describe the clothing she desires, then make a Finesse roll to determine how exactly her instructions are carried out; an Ease Factor of 6 is needed to successfully emulate a simple change, but if the current clothes require dramatic improvement then the Ease Factor is higher. The clothes remain changed until the wielder desires to cancel the effect, but she must briefly concentrate to maintain it at sunrise or sunset.\n\n(base 3, +1 Touch, +1 Conc, +2 Group, +1 requisite; +5 item maintains concentration, +3 6/day)"
    }

    #tc0ce364ef8b0e7392c88d9 ^"Iridescence of the Mallard’s Head" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 4
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +3 Month)"
            ^"Printed Effect Line" STRING "MuIm 4 Pen 0, charged item R: Per, D: Month, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "When triggered, this effect causes the dull green of the cloth to adopt an iridescent color not dissimilar to that found on the feathers of certain birds. When the effect fades the cloth reverts to its former color.\n\n(Base 1, +3 Month)"
    }

    #te5d356f192b2bd5b39824d ^"Staunch the Bloody Wound" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +3 Month)"
            ^"Printed Effect Line" STRING "CrCo 10 Pen 0, charged item R: Touch, D: Month, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "When triggered, bandages made from this cloth give a +3 to Wound Recovery rolls.\n\n(Base 2, +1 Touch, +3 Month)"
    }

    #te5dcb7064868f47acfb3a9 ^"Scintillation of the Phoenix" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +3 Month)"
            ^"Printed Effect Line" STRING "CrIg 10 Pen 0, charged item R: Per, D: Month, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "When triggered, this orange-yellow cloth glows with a light equivalent to torchlight and flickers like a living flame. This cloth is particularly popular among members of House Flambeau, who in the past have commissioned Julia to make ceremonial robes for attending the tribunal.\n\n(Base 3, +3 Month)"
    }

    #t682fe69eb72b36352ba880 ^"Constrain the Shrewish Wife" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +3 Moon)"
            ^"Printed Effect Line" STRING "MuMe 15 Pen 0, charged item R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "When triggered, clothes made from this cloth cause the wearer to become more considerate towards his or her loved ones. Julia occasionally hears of clients who are having trouble at home and make them clothes from this cloth to encourage better behavior.\n\n(Base 3, +1 Touch, +3 Moon)"
    }

    #t2cef84b097e497751f4319 ^"Curb the Straying Husband" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +3 Moon)"
            ^"Printed Effect Line" STRING "MuMe 15 Pen 0, charged item R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "When triggered, clothes made from this cloth cause the wearer to become temperate, eschewing drink, violent behavior, and philandering. Julia makes clothing of this fabric for clients who have troublesome husbands.\n\n(Base 3, +1 Touch, +3 Moon)"
    }

    #t35773e001178519720d463 ^"Cloth of Unicorn Hair" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Magical Cloth"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun)"
            ^"Printed Effect Line" STRING "Level 20 Pen 0, charged item R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Not actually formed from the hair of a unicorn (despite what she tells clients!), clothes made from this cloth grant the wearer immunity to poison. This effect is a product of Julia’s Craft Magic rather than Hermetic Magic, and her “Casting Total” is equal to a Dexterity + Craft (Linen or Wool, as appropriate) roll instead. See Houses of Hermes: Societates, page 131 for more details. The name is appropriate since she makes this cloth so rarely due to its difficulty.\n\n(Base 5, +1 Touch, +2 Sun)"
    }

    #tfcbafaf342deb060f5c069 ^"Snip the Thread of a Faerie’s Might" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Forfex Princeps"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "20"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 0, +2 Voice; +10 Pen 30, +5 24/day)"
            ^"Printed Effect Line" STRING "PeVi 25 Pen 20, 24/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Weakens a faerie. If the effect penetrates the Faerie’s Might then it loses 10 points of Might.\n\n(Base 0, +2 Voice; +10 Pen 30, +5 24/day)"
    }

    #tb71471621480ceb2ff916f ^"Sever Wood and Bone" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Forfex Princeps"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Requisite" STRING "Herbam"
            ^"Level" INTEGER 12
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 requisite; +2 3/day)"
            ^"Printed Effect Line" STRING "PeAn(He) 12 Pen 0, 3/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The shears can cut through any animal or plant substance that they can close around. This effect is rarely used for mundane tasks, since Julia is sufficiently skilled. Instead, she uses it where shears would not normally cut, like through bone or wood.\n\n(Base 4, +1 Touch, +1 requisite; +2 3/day)"
    }

    #t7552ca137965363fcf484b ^"Gather the Connection" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Forfex Princeps"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Requisite" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "10"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +2 Voice; +5 Pen 10)"
            ^"Printed Effect Line" STRING "ReCo(An) 30 Pen 10, 1/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "When triggered, this effect snips a lock of hair from the target (either human or animal) and delivers it to the wielder’s hand. If done in a surreptitious fashion, the target must make a Perception + Awareness roll against an Ease Factor of 9 to realize that some of his hair has been stolen. Naturally Julia uses this effect to gain Arcane Connections, but uses it with caution for there is the real risk she could take hair from a magus unknowingly. This spell duplicates the mundane action of cutting hair, and does not need a Perdo requisite.\n\n(Base 15, +2 Voice; +5 Pen 10)"
    }

    #t6ccd97adc353b46c8125a8 ^"Sunder Stone" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Forfex Princeps"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 12
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 affect metal; +2 3/day)"
            ^"Printed Effect Line" STRING "PeTe 12 Pen 0, 3/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The shears can cut through any mineral substance that they can close around — metal, glass, or stone.\n\n(Base 3, +1 Touch, +2 affect metal; +2 3/day)"
    }

    #t69f2941d3178946ff44bdd ^"Snap of Awakening (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Snap of Awakening"
            ^"Part Of" STRING "Familiar bond: Tetrix the Blackcock"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 7
            ^"Penetration" STRING "0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch; +2 3/day)"
            ^"Printed Effect Line" STRING "ReMe 7 Pen 0, 3/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "Tetrix can instantly awaken Julia with this power. Since he never sleeps himself, he is always on watch when she is resting.\n\n(Base 4, +1 Touch; +2 3/day)"
    }

    #t7a09d1a7787f1c5b612120 ^"Silent Speech" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Familiar bond: Tetrix the Blackcock"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch; +10 unlimited uses)"
            ^"Printed Effect Line" STRING "CrMe 15 Pen 0, unlimited/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This is actually two effects, one to allow Julia to share words, images, and emotions with her familiar, and one to allow Tetrix to do the same with his maga.\n\n(Base 4, +1 Touch; +10 unlimited uses)"
    }

}
