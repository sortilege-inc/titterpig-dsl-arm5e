EXTENSION "ARMDef_Magi_of_Hermes_JuliaOfExMiscellanea_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Six: Julia of Ex Miscellanea spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t9a17ae59b6ac5c3996df30 ^"Shearing the Unseen Sheep" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrAn 20 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Creates a sheep’s fleece. Wool is the most common material for making clothing, but creating ready-made woolen garments is difficult with Hermetic Magic. As a consequence, Julia uses this spell to create the raw materials, and then rearranges them into clothing using Rego Craft Magic, such as Woolen Garments for the Human Form, below.\n\n(Base 5, +1 Touch, +2 Sun)"
    }

    #ta2f5d0f340877432af1b6b ^"Sturdy Mantle of the Traveler" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 treated and processed)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrAn 30 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "Creates a gardcorps — a calf-length traveling robe with voluminous sleeves. The garment is formed of supple leather oiled to proof it against rain. A Finesse roll determines the quality of the gardcorps; an Ease Factor of 6 results in a waterproof robe of standard quality. If an Ease Factor of 9 is achieved the caster can determine the color of the leather and a specific regional style.\n\n(Base 5, +1 Touch, +2 Sun, +2 treated and processed)"
    }

    #tdaff007842e59095c35baa ^"Madder, Woad, and Weld" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +3 Month, +2 Group, +1 requisite)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Month"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Herbam"
            ^"Printed Stat Line" STRING "MuAn(He) 20 R: Touch, D: Month, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "The touched cloth — which can be wool, cotton, or linen — takes on a vivid hue as if dyed. Up to ten skeins of wool or 5 bolts of cloth can be dyed a single color chosen by the caster at the time of casting. When the spell’s duration expires, the cloth reverts to its natural undyed color. The spell is named after the three principle dyes employed in the thirteenth century — madder produces red, brown, and pink, woad makes blue, and weld results in yellow. By dyeing and then over-dyeing with a different color, a whole range of russets, maroons, greens, and oranges can be produced through mundane craft. However, a single casting of this spell can produce any possible hue.\n\n(Base 1, +1 Touch, +3 Month, +2 Group, +1 requisite)"
    }

    #t03bb02a23bea30a991060f ^"Cloak of Nessus" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +1 Diam, +1 Part, +2 poison effect)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "MuAn 35 R: Voice, D: Diam, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "The targeted item of clothing partially converts into poison. The wearer suffers terrible agony as the poison touches his skin, and must make a Stamina roll against an Ease Factor of 9 to avoid taking a Light Wound. This Stamina roll must be repeated every round that the wearer is in contact with the robe, or until the Duration ends. The spell is named after the cloak dipped in the blood of the centaur Nessus in Greek myth.\n\nSince creating a poison of this strength has a base level of 15 (if it were an Aquam effect), two magnitudes are added for this effect, although since the poison is of Animal origin an Aquam requisite is not needed.\n\n(Base 5, +2 Voice, +1 Diam, +1 Part, +2 poison effect)"
    }

    #td6b562e1c66a3eaf84c63a ^"The Unraveled Seam" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Herbam"
            ^"Printed Stat Line" STRING "PeAn(He) 5 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "The touch of the caster causes a thread of animal or plant origin to decay, making the cloth it is holding together to come apart. The pieces of cloth can be sewn together again, so this is counted as damaging the garment rather than destroying it.\n\n(base 2, +1 Touch, +1 Part, +1 requisite)"
    }

    #t37e4b64967699a37cb5f0c ^"The Unraveled Clothes" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +2 Group, +1 requisite)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Herbam"
            ^"Printed Stat Line" STRING "PeAn(He) 15 R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 56
        }
        DESCRIPTION "The targeted clothing falls apart as all the stitches — both thread and leather — simultaneously unravel. The victim of this spell is left naked. If the victim is wearing leather armor (including metal-reinforced leather armor) then the armor falls into pieces. If the victim is wearing metal armor, the padding beneath the armor is affected. A character in this position suffers a –3 to all physical actions due to the shifting of his armor, and it grants only half of its Protection until the padding can be replaced. The clothes are capable of being repaired, so this is counted as damaging the garment rather than destroying it.\n\n(Base 2, +2 Voice, +2 Group, +1 requisite)"
    }

    #t466fbd5aecd1777ea4a489 ^"The Wizard’s Spindle" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReAn 4 R: Touch, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "The caster converts up to 10 fleeces into wool. The wool is cleaned, carded, and spun in a single round. This requires a Finesse roll against an Ease Factor of 12, since it replicates more than a week’s work completed in an instant. Failure to achieve this Ease Factor leaves the wool hopelessly tangled and useless.\n\n(Base 1, +1 Touch, +2 Group)"
    }

    #tc95e11bc65cb902bc90d76 ^"Dressing the Human Form in Wool" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +1 complexity)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReAn 5 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "This spell crafts a single woolen garment from either raw fleeces or from spun wool. This spell is suitable for producing a cotte, cyclas, ganache, bliaut, cappa, or chausses (see the Clothing of the Thirteenth Century insert). A Finesse roll is necessary to determine the success of the craft magic; the Ease Factor is 12 if raw fleece is employed, or 9 if the base material is spun wool. The clothes produced are of standard quality; increase the Ease Factor for particularly fine or complex craft. If the Finesse roll fails, the caster is left with a useless mess of wool. Creating a fabric of a different color than the raw material requires a supply of appropriate dye, but does not change the Ease Factor. Julia typically uses this spell to manufacture clothes out of the magical cloth that she makes (see Enchanted Items, later). She does not have a spell that directly creates mundane clothing of wool due to the difficulty (it would be a similar spell to Sturdy Mantle of the Traveler, earlier). Instead, it is much easier to simply create fleeces (see Shearing the Unseen Flock, later) and then craft them into clothing with this spell.\n\nThis spell employs the Level 3 Rego Animal guideline on page 50 of *Covenants*: “treat and process items made of animal products.”\n\n(Base 2, +1 Touch, +1 complexity)"
    }

    #t3916d5d236bd4e9daa7e91 ^"Ward Against Faeries Which Creep and Crawl" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(As ward guideline)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReAn 20 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "No faerie animal whose Faerie Might is equal or less to the level of the spell can affect the targeted Group as long as they remain within the ring. Julia commonly employs this spell every night along with a Circle of Beast Warding — after carefully sweeping the area to ensure that no spiders become trapped in the ring with her.\n\n(As ward guideline)"
    }

    #tafcd086403c58e926421ce ^"Constraint of the Strangling Vestments" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +1 Diam, +2 Group)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReAn 35 R: Voice, D: Diam, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "The target’s clothes develop a life of their own, and tighten around their owner’s limbs rendering him unable to move. This spell only affects clothes of wool, leather, and fur. The constricting clothing makes it very hard for the wearer to breathe, and he risks strangulation; causing him to make a Deprivation roll (ArM5, pages 180–181) every 30 seconds (or 5 combat rounds). Since Rego Animal lacks a guideline for making an animal product move with a purpose, the Rego Herbam guidelines have been used as an analogy.\n\n(Base 10, +2 Voice, +1 Diam, +2 Group)"
    }

    #ta5ba50991505b18ac2a16b ^"Sealing the Lips" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 10 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "The target is rendered unable to speak. It appears that his lips have been stitched together; this is a cosmetic effect.\n\n(Base 2, +2 Voice, +2 Sun)"
    }

    #tf666011910d9cd2006d664 ^"Clothe the Naked Form" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Sun, +2 treated and processed)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrHe 10 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "Creates an individual garment made of linen or cotton, most commonly undergarments such as the chainse or braies (see the Clothing of the Thirteenth Century insert). A Finesse roll determines the quality of the clothes; an Ease Factor of 6 results in a garment of standard quality. If an Ease Factor of 9 is achieved then the caster can specify the brightness of the dye and any regional variations in style. Julia uses this spell rather than The Tailor’s Craft Done in an Instant when she has no cloth at hand.\n\n(Base 1, +1 Touch, +2 Sun, +2 treated and processed)"
    }

    #t1f581cdc1c45e4b20a384e ^"The Travelers’ Fortress of Cloth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Sun, +2 Group, +2 treated and finished product)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrHe 20 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "This spell creates a tent of waterproof canvas and wooden poles that is large enough to sleep 10 people. The canvas sides appear to grow out of surrounding vegetation, and erect and fasten themselves together. A Finesse roll determines the complexity and comfort of the tent; if the basic Ease Factor of 6 cannot be achieved then the tent leaks and has a musty smell, whereas an Ease Factor of 9 results in a pavilion of superior quality.\n\n(Base 1, +1 Touch, +2 Sun, +2 Group, +2 treated and finished product)"
    }

    #t23cfda5422e560f9646ef7 ^"Weaver’s Trap of Threads" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +2 Sun, +2 Group)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrHe 20 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "A huge net of thick threads grows in the indicated area, filling a space 5 paces by 5 paces by 6 feet high. With supports the nets can hang vertically, forming a wall, otherwise they act just like a fishing net. Everyone caught in the area is captured within the nets. Getting free requires a Strength stress roll against an Ease Factor of 9; or else someone who is not trapped may use an edged weapon to free a victim, which takes three rounds. Fire is exceptionally effective against the nets, but risks burning anyone caught within. The nets are not sticky, and cannot trap anyone who stumbles into them.\n\nThis spell is a deliberate reference to the better-known spell *Weaver’s Trap of Webs*, but the thought of emulating a spider is abhorrent to the arachnophobic Julia. Consequently, her version of this spell is less potent, as linen threads are less strong than spider’s silk.\n\n(Base 2, +2 Voice, +2 Sun, +2 Group)"
    }

    #t6f103ac58ac0f5f245cee1 ^"The Clothier’s Craft Done in an Instant" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 4 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "Given an amount of linen or cotton cloth, the caster forms it into a garment according to her specifications. Typical garments made with this spell are the chainse or braies (see the Clothing of the Thirteenth Century insert) which are traditionally made of linen. A Finesse roll is necessary to determine the success of the craft magic; the Ease Factor is 9 for clothes of standard quality since it represents a day’s work done in an instant. If the Finesse roll fails the caster is left with a useless pile of scraps of cloth. Creating a fabric of a different color than the raw material requires a supply of appropriate dye, but does not change the Ease Factor. Julia typically uses this spell to manufacture clothes out of the magical cloth that she makes (see Enchanted Items).\n\nIf starting with raw flax or cotton fibers, this spell would have needed to use the level 5 Rego Herbam guideline “treat and process items made of plant products” given in *Covenants*, page 51. Julia has no need for this version, since her Faerie Blood allows her to effect the transformation from fiber to cloth anyway.\n\n(Base 3, +1 Touch)"
    }

    #td48456e7c3ce4c78590e07 ^"The Mended Tear" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Part)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "ReHe 5 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "The caster lays a piece of linen or cotton thread over a rent in any fabric and runs her finger over it; the cloth or leather is immediately repaired with a neat stitch. This Craft Magic spell requires successful Finesse roll against an Ease Factor of 6.\n\n(Base 3, +1 Touch, +1 Part)"
    }

    #tdb210802379748af1b623d ^"The Animate Attire" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +1 Conc)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 20 R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "One item of clothing starts to writhe and thrash under the direction of the caster. The clothing causes a major distraction to its wearer and can trip him up; he suffers a –3 to all actions, and rolls 3 extra botch dice while under the effect of this spell. While thirteenth century clothes are predominantly made of wool, underclothes are made of linen and this spell produces the best effect when cast on the victim’s chainse or braies.\n\n(Base 5, +2 Voice, +1 Conc)"
    }

    #t8e633d93c3da20d56a2a92 ^"Embroidering the Wizard’s Robes" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Touch)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 20 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 58
        }
        DESCRIPTION "The caster traces out a design on a piece of cloth, and a piece of thread follows her finger and is embroidered into the cloth. A Finesse roll of Ease Factor 9 is required for simple designs, but a 12 is needed for intricate embroidery. Failure to achieve this Ease Factor results in a tangled mess that needs to be unpicked by hand. Julia often “signs” any cloth or clothes she makes using this spell.\n\n(Base 15, +1 Touch)"
    }

}
