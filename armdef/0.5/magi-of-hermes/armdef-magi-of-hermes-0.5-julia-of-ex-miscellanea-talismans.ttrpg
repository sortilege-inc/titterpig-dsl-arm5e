EXTENSION "ARMDef_Magi_of_Hermes_JuliaOfExMiscellanea_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Six: Julia of Ex Miscellanea talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t95982f6296b4a0802b420b ^"Forfex Princeps" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Forfex Princeps"
            ^"Owner" STRING "Julia of Ex Miscellanea"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 60
        }
        TABLE {
            "+2" "Shaping Fabric" "cloth shears" "Attunements"
            "+7" "Harm/Repel Faeries" "iron" "Attunements"
            "+4" "Deftness" "copper" "Attunements"
            "+4" "Wards" "lead" "Attunements"
        }
        DESCRIPTION "The “Prince of Shears” is Julia’s talisman. These clothier’s shears are two feet long and constructed from iron. Inlaid onto the blades are intricate filigrees of gold, copper, and lead. The invested item was initially prepared with ten pawns of Vim vis and currently has no enchantment space remaining."
    }

}
