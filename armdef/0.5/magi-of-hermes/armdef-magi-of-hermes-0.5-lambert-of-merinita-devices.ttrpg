EXTENSION "ARMDef_Magi_of_Hermes_LambertOfMerinita_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Seven: Lambert of Merinita devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t97ffd8a91b7731affa2784 ^"Blessing of Enthusiastic Patrons" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Coins of Loose-Tongued Patrons"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch +2 Room)"
            ^"Printed Effect Line" STRING "ReMe Level 25 Pen +0, 1/day R: Touch D: Sun, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "When the coin enchanted with Blessing of Enthusiastic Patrons is touched to the wall of a room, the coin enchants the room to alter the proclivities of people within it. People within the enchanted room are compelled to dwell on and talk about the positive and desirable qualities of any merchandise that is shown or discussed. Use of this effect adds a modifier of −6 to any Bargain rolls made by purchasers affected by the spell.\n\n(Effect: Base 10, +1 Touch +2 Room)"
    }

    #t59b0b03776f9f00e54ea4f ^"Curse of Petulant Customers" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Coins of Loose-Tongued Patrons"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch +2 Room)"
            ^"Printed Effect Line" STRING "ReMe Level 25 Pen +0, 1/day R: Touch D: Sun, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "When the coin enchanted with Curse of Petulant Customers is touched to the wall of a room, the coin enchants the room to alter the proclivities of people within it. People within the enchanted room are compelled to dwell on and speak about any negative aspects and flaws that they perceive with any merchandise that is shown or spoken about. Use of this effect adds a modifier of +6 to any Bargain rolls made by purchasers affected by the spell.\n\n(Effect: Base 10, +1 Touch +2 Room)"
    }

    #t3ce701b23e8d07b2220e0b ^"Doorframe of the Wary Steward" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Doorframe of the Wary Steward"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "0"
            ^"Range" STRING "Special"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Range Touch equivalent, +1 non-standard range, +10 levels unlimited uses per day)"
            ^"Printed Effect Line" STRING "InMe 35, 0 penetration R: Special, D: Momentary, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 68
        }
        DESCRIPTION "When any creature passes through this doorframe, the enchantment determines whether or not that creature believes that they intend any harm towards the people who dwell within the covenant. If the creature does so believe, then the door frame shakes, causing the bell affixed to the doorframe to ring. As a Mentem effect this power will not function on animals, and also as a Hermetic effect it is restrained by the Limit of the Infernal.\n\n(Effect: Base 15, +1 Range Touch equivalent, +1 non-standard range, +10 levels unlimited uses per day)"
    }

    #te9d4c49fd240ccae7a36c7 ^"Convenient Warehouse" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Granary Chest"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Day (constant)"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 3, +2 Day, +2 Room, +1 excessive size change; Modifications +1 activation twice per day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "MuHe 24 Pen +0, constant effect R: Personal, D: Day (constant), T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "Any item consisting entirely of plant material that is placed completely within the chest is shrunken to the size of a grain of wheat until it is removed from the chest. Linen bags filled with grain, vegetables, or fruit are the items most commonly stored within the chest by Lambert’s family. Shrunken materials that are kept within the chest for long periods of time can Warp, often becoming unnaturally shaped. Lambert’s family has found it often difficult to find a particular grain-sized item within the chest. They have taken to only placing items stored in colored linen bags into the chest, assigning certain bag colors to particular contents. This has helped to reduce difficulties, but has not completely eliminated them.\n\n(Effect: Base 3, +2 Day, +2 Room, +1 excessive size change; Modifications +1 activation twice per day, +3 environmental trigger)"
    }

    #t1ae6f39499994c8d7a3944 ^"Carpentry of Brass" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Granary Chest"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Requisite" STRING "Terram"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Sun)"
            ^"Printed Effect Line" STRING "MuHe(Te) 10 Pen +0 1/day R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "This power transforms the wood of the chest into brass matching the fittings on it. It is triggered by rapping on the chest seven times in rapid succession.\n\n(Effect: Base 4, +2 Sun)"
    }

    #tdd18aa436d816b95443d32 ^"Charm Versus Dampness" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Granary Chest"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun (constant)"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 1, +2 Sun, +2 Room; Modifications +1 level 2 activations per day, +3 levels environmental trigger)"
            ^"Printed Effect Line" STRING "ReAq 9 Pen +0, constant effect R: Personal, D: Sun (constant), T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "This power slowly moves any liquids out of the chest over a period of minutes and prevents any liquids from slowly seeping or dripping into the chest (although the power is not strong enough to prevent liquids from being poured into the chest).\n\n(Effect: Base 1, +2 Sun, +2 Room; Modifications +1 level 2 activations per day, +3 levels environmental trigger)"
    }

    #t5e39acb35571951bed2260 ^"Freshness of the Harvest Evening" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Token of the Harvest Evening"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Day (constant)"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 1, +1 Touch, +2 Sun, +2 Room; Modifications +1 two activations per day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "CrHe 14 Pen +0, constant effect R: Touch, D: Day (constant), T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 69
        }
        DESCRIPTION "All plant material kept in the same room as the Token of the Harvest Evening is preserved from decay and rot until either the plant material or the token is removed from the room. Materials kept within the same room as the token for long periods of time will undergo Warping from the continuous magical effect. Lambert’s family most frequently keeps the Token of the Harvest Evening inside the Granary Chest.\n\n(Effect: Base 1, +1 Touch, +2 Sun, +2 Room; Modifications +1 two activations per day, +3 environmental trigger)"
    }

}
