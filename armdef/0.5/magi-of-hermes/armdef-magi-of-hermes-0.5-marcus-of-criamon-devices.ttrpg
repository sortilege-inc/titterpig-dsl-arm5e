EXTENSION "ARMDef_Magi_of_Hermes_MarcusOfCriamon_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Nine: Marcus of Criamon devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t0d62d8cccbdf82ed9c7796 ^"Path to Serendipitous Discovery" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Labyrinth of the Open Mind"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "CrVi 24 R: Touch, D: Sun, T: Room Pen 0, constant effect"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "Everything in Marcus’ sanctum is tainted slightly with magic. This gives him a +2 laboratory specialization in Experimentation, but unfortunately has the unintended side effect of increasing its Warping Score by 1.\n\n(base 3, +1 Touch, +2 Sun, +2 Room; +1 2/day, +3 environmental trigger)"
    }

    #t3cbbd6ebbabfc9cc25be5f ^"Path to Enlightened Operations" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Labyrinth of the Open Mind"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "ReAn 20 R: Touch, D: Conc, T: Room Pen 0"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 85
        }
        DESCRIPTION ", unlimited uses per day Items made of animal products — like most of Marcus’ custom-built laboratory equipment — are supported in the air wherever they are released, and maintained there until plucked free. If left floating, Marcus’ tools slowly move, aligning themselves into propitious arrangements that actually enhance the activity in question. This enchantment gives Marcus’s laboratory a +1 General Quality.\n\n(base 1, +1 Touch, +1 Conc, +2 Room; +10 unlimited/day, +5 item maintains concentration)"
    }

    #t9f328398201dcc35341e47 ^"Path of Shadows Beneath the Skin" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Labyrinth of the Open Mind"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Requisite" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Vision"
            ^"Printed Effect Line" STRING "InCo(An) 40 R: Touch, D: Conc, T: Vision Pen 0, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 85
        }
        DESCRIPTION "This effect grants the target the ability to see the internal organs of humans or animals as a magical sense. This greatly enhances laboratory operations employing Corpus or Animal (or, indeed, both), granting a +2 laboratory specialization in both Arts.\n\n(base 5, +1 Conc, +4 Vision, +1 Animal requisite; +5 item maintains concentration)"
    }

    #tbe255d73c5e6ea26944a2b ^"Halt Corruption’s Work" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Canopic Jar"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "CrCo 9 R: Touch, D: Sun, T: Ind Pen 0, constant effect"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "Any bodily organ placed inside is protected from putrefaction while it remains within the jar.\n\n(base 2, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger)"
    }

    #tab7218b5d2dbc5eb62b973 ^"Resilience of Theseus" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Mark of Protection"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 39
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuCo 39 R: Touch, D: Sun, T: Ind Pen 0, constant effect"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "Marcus has a +4 to all Soak rolls. However, due to the experimentation used to create the effect it has a minor flaw — the tattoo must be exposed to grant the bonus, rather than being covered by clothing.\n\n(base 20, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger)"
    }

    #t498bb508c74a9c55b3b910 ^"Ariadne’s Thread" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Mark of Protection"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "InCo 20 R: Arc, D: Mom, T: Ind Pen 0, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The target always knows exactly where he is in relation to one or more Arcane Connections he has in distant locations. The more Arcane Connections to himself he has, the more accurate his estimation of position; he can feel the tug of each one as he turns in a full circle, and the relative strength tells him the distance. Consequently, the caster is never lost. Marcus invented this effect after one of his ordeals on the Path of Seeming left him hundreds of miles from home in a land where no-one spoke his language.\n\n(base 3, +4 Arc, +1 complexity)"
    }

    #t1b0d6c083808a88a65d304 ^"Mastering the Unruly Beast (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Mastering the Unruly Beast"
            ^"Part Of" STRING "Bucephalos"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "16"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReAn 33 R: Touch, D: Conc, T: Ind Pen 16, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "As the spell of the same name. The effect is triggered by pointing the bull-head at the creature and slowly lowering it.\n\n(base 15, +1 Touch, +1 Sun; +8 Penetration)"
    }

    #tdc0b1bcae044f6d3a01498 ^"Punishment of Midas" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Bucephalos"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Requisite" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "MuCo(An) 40 R: Voice, D: Sun, T: Group Pen 0, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "One limb of each target turns into that of a random animal. Roll two simple dice: one for the limb, and one for the animal.\n\n**Limb: **1 to 2 – Head; 3 to 6 – Arm (odd: left, even: right); 7 to 10 – Leg (odd: left, even: right)\n\n**Animal: **1 – goat; 2 – pig; 3 – hare; 4 – chicken; 4 – donkey; 5 – dog; 6 – lizard; 7 – toad; 8 – cow; 9 – rat; 10 – beetle.\n\nAll limbs are re-scaled in size to match that of the replaced limb. Anything held in a transformed hand is dropped, and a transformed leg becomes inappropriate to the current footwear and may trip up the wearer. If the head is transformed, the target cannot speak but retains his intelligence. Up to 10 people can be simultaneously affected; if there are fewer than 10 individuals, then some targets may experience a change in more than one limb. The effect is triggered by pointing the bull-head at a group and making a circling gesture while speaking the command word. Marcus had only intended to cause changes in land animals, but his experimentation caused the anomalous result of a chicken.\n\n(base 10, +2 Voice, +2 Sun, +2 Group)"
    }

    #t6bba73ae160a79bcc3bad2 ^"Return to the Earth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Bucephalos"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "10"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuTe 20 R: Voice, D: Mom, T: Ind Pen 10, 24/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "A metal or stone object targeted by this effect is momentarily transformed into sand. This is sufficient to destroy most handheld weapons, as they become metal grains around the feet of the wielder. But if the object remains undisturbed, it is unaffected when it becomes metal again moments later. The effect can target any single object that can be carried in one hand, such as a sword. The effect is triggered by pointing the butt of the staff at the target in a short jabbing motion while speaking the command word.\n\n(base 2, +2 Voice, +2 affect metal; +5 Penetration, +5 24/day)"
    }

}
