EXTENSION "ARMDef_Magi_of_Hermes_MarcusOfCriamon_Sidebars" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Nine: Marcus of Criamon sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Disembodied Leg" #t521206f6079d35a8ba6a21 {
            TEXT "Disembodied Leg\n\n**Size** –3 **Combat**: *Kick:* Init –1, Attack +0, Defense –1, Damage +3 **Soak** +0\n\n**Wound Penalties**: –1 (1–2), –3 (3–4), –5 (5–6), Incapacitated (7–8), Dead (9+)"
        }
    }

}
