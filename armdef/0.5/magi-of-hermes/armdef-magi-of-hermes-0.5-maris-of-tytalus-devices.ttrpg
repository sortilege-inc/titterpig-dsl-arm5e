            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Aquam Req; +10 unlimited uses)"
            ^"Printed Effect Line" STRING "PeCo(Aq) 20 Pen +0, unlimited uses R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "All human waste, and all associated unpleasantness, vanishes upon entering the chamber pot.\n\n(Base 4, +1 Touch, +1 Aquam Req; +10 unlimited uses)"
    }

    #t1e9ee82343ecda5ef3e9b5 ^"Guide the Seeker" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Neptune’s Anchors"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 16
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3; +3 linked trigger, +10 unlimited uses/day)"
            ^"Printed Effect Line" STRING "ReHe 16 Pen +0, Constant Effect R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "This effect pulls the rope towards the sensed vis, much like a magnet. The taut guide rope may be then followed to the source of the vis.\n\n(Base 3; +3 linked trigger, +10 unlimited uses/day)"
    }

    #t4f264496567da02d7d9d77 ^"Seek the Enchanted Waters" DEF {
