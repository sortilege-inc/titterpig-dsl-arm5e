EXTENSION "ARMDef_Magi_of_Hermes_MarisOfTytalus_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Eight: Maris of Tytalus devices"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t4e2600dbbc80a44d22bda6 ^"Sight of Wounded Prey" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Ever-Tempting Trap"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "CrIm 9 Pen +0, Constant Effect R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "This effect creates the illusion of a certain bait inside the trap, allowing it to be used continually without needing to restock or bait going bad. The bait both appears real and puts out the proper scent. Any predator looking to feed will be almost assuredly be attracted to this item. The scent must be of a particular bait, and will only attract prey normally attracted to that scent.\n\n(Base 3, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t00cc4b96b62f29250a811c ^"True Sight of the Air (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "True Sight of the Air"
            ^"Part Of" STRING "Eyeglass of Nereus"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Vision"
            ^"Effect Design" STRING "(Effect: Base 1, +1 Touch, +1 Conc, +4 Vision; +5 24/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "InAu 25 Pen +0, 24/day R: Touch, D: Conc, T: Vision"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "As True Sight of the Air (ArM5, page 127).\n\n(Effect: Base 1, +1 Touch, +1 Conc, +4 Vision; +5 24/day, +5 item maintains concentration)"
    }

