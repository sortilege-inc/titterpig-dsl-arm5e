            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "CrIg 9 Pen +0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "Warms the wearer, shielding him from winter’s harshest weather.\n\nBase 2, +2 Sun, +1 Touch; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t095a61121ec8dac043d090 ^"Lungs of the Fish (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Lungs of the Fish"
            ^"Part Of" STRING "Gorget of Salty Breath"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Requisite" STRING "Auram"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +1 Part; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "MuAq(Au) 24 Pen +0, Constant Effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "As Lungs of the Fish (ArM5, page 122). However, this still does not allow you enough air to fully vocalize the required words to cast spells underwater. See Voices in the Ocean side bar.\n\n(Base 4, +1 Touch, +2 Sun, +1 Part; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t5c96f1e331392cb4466266 ^"Surviving the Deep" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Gorget of Salty Breath"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +2 Sun)"
            ^"Printed Effect Line" STRING "MuCo 30 Pen +0, 1/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "This effect strengthens the body, increasing its mass and allowing it to resist the great pressures of the deep ocean, as well as providing a +3 to soak. See the Voices in the Ocean sidebar.\n\n(Base 15, +1 Touch, +2 Sun)"
    }

    #t9c694aaa637a6f4faff856 ^"The Kraken’s Song" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Gorget of Salty Breath"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "MuIm 8 Pen +0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 76
        }
        DESCRIPTION "This simple effect changes any vocalizations made by the caster into a loud high-pitched click, which allows the vocalizations of his Voice-Ranged spells to carry through the water. See Voices in the Ocean side bar.\n\n(Base 1, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t5be5d624a4d77e66c2db94 ^"Remove the Unsightly Mess" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
