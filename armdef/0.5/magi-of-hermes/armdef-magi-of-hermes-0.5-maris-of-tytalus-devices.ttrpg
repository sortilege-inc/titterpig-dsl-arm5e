    }

    #tebeb957f60a6bb39fdefed ^"Hospitaller’s Vigil" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Shroud of the Healed Body"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "CrCo 24 Pen +0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "If the Shroud of the Healed Body is worn for the duration of a wound or sickness, the wearer adds +12 to his recovery checks.\n\n(Base 5, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #td40fa1715d92db8adfcce8 ^"Reveal the Ocean’s Secrets" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Tryggvason’s Chart"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +2 Sun, +1 Part, +2 Size, +1 Complexity; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "InAq 19 Pen +0, Constant Effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "Reveal the Ocean’s Secrets senses the motion, speed, and boundaries of the ocean up to 1500 feet in all directions. Tides, currents, obstacles, depth, and other such information are constantly gathered by this spell.\n\n(Base 3, +1 Touch, +2 Sun, +1 Part, +2 Size, +1 Complexity; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t1c3e5ebda3925edd030d84 ^"Visualize the Water’s Flow" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Tryggvason’s Chart"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 11
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set, +3 linked trigger)"
            ^"Printed Effect Line" STRING "CrIm 11 Pen +0, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "This effect produces an image of the information gathered by Reveal the Ocean’s Secrets in the form of a constantly updating, highly detailed map. The map uses a form of notation developed by Maris, and is not easily understood by those who are not taught their meanings.\n\n(Base 1, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set, +3 linked trigger)"
    }

    #t21dd3d481ed4a320ae6b80 ^"Save Our Ship" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 27
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Room; +2 3/day)"
            ^"Printed Effect Line" STRING "PeAq 27 Pen +0, 3/day R: Touch, D: Mom, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "When Save Our Ship takes effect, all water in the hold of the ship is destroyed. This leaves everything in the hold slightly dehydrated, and destroys any drinking water, wine, or other liquids stored within.\n\n(Base 10, +1 Touch, +2 Room; +2 3/day)"
    }

    #t693648727273a6f8b32579 ^"Eye of the Storm" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 8
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 2, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "ReAq 8 Pen +0, Constant Effect R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "All waves, crests, or other masses of water (mundane or otherwise) break and part around the Paregro Mare. While sailing the Paregro Mare, the Ease Factor for sailing rolls will not be increased due to rough seas or stormy weather. However, sailing through strong winds will increase the Ease Factor as normal. This effect also makes it extremely difficult to swamp the boat.\n\n(Base 2, +2 Sun; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #t6c43fb80e491bdffab7df2 ^"Ward the Drowning Waves" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 5, +1 Touch. +1 Conc, +2 Room; +3 6/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "ReAq 33 Pen +0, 6/day R: Touch, D: Conc, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Upon activation, Ward the Drowning Waves expels all water from the lower hold of the ship and keeps it out. This serves as a temporary fix long enough to conduct some quick repairs.\n\n(Base 5, +1 Touch. +1 Conc, +2 Room; +3 6/day, +5 item maintains concentration)"
    }

    #t10bb3934b57dcd3746a3ec ^"Control the Reckless Vessel" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Aquam"
            ^"Requisite" STRING "Auram"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReAq(Au) 35 Pen +0, 24/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "This effect fills the Paregro Mare’s sails with a stiff breeze, as well as controlling the currents around the hull of the boat to drive the Paregro Mare with a speed and agility unknown to other boats of this type. This effect can be maintained while Maris is elsewhere, although it will only keep its last heading and speed. Controlling the winds and the seas allows the Paregro Mare to accomplish feats most other sailors can only dream of. The Paregro Mare can even maintain course without Maris needing to work the deck, allowing him to attend to other matters. If the rudder is pulled out of the water, the ship maintains its position, allowing it to “anchor” even in waters that are too deep for conventional equipment. Control the Reckless Vessel gives a bonus of +7 to any sailing checks made on the Paregro Mare.\n\nBase 4, +1 Touch, +1 Conc, +2 Size, + 1 Req.; +5 24/day, +5 item maintains concentration)"
    }

    #t2e5c1a963f727dc1cdc65a ^"Hull of Unbreakable Iron" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Requisite" STRING "Terram"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +2 Sun, +2 Size; +1 2/day, +3 environmental trigger: sunrise/set)"
            ^"Printed Effect Line" STRING "MuHe (Te) 24 Pen +0, Constant Effect R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "The Paregro Mare’s hull has been enchanted to be as hard as metal. The thick timbers of the hull provide protection from accidental collisions, punctures, and damage of all types. The Paregro Mare’s hull is immune to ramming, and if another captain is foolish enough to try, he will successfully wreck his own ship if he fails the contested Int + Profession roll by more than his own Profession skill.\n\n(Base 4, +2 Sun, +2 Size; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

    #tfc7500a679bad701acadf8 ^"Helios’ Companionship" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Paregro Mare"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "CrIg 24 Pen +0, Constant Effect R: Per, D: Sun, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "The lower deck of the Paregro Mare has been enchanted to produce enough light to brighten the hold to the equivalent of torchlight, and to heat it to be as warm as a pleasant summer’s eve. Not only is this extremely convenient as well as comfortable, if you are using the optional rules from Covenants this grants the laboratory the Free Supernatural Virtue: Magical Lighting (Superior) and the Free Supernatural Virtue: Magical Heating (Superior) (pages 118-119).\n\nBase 3, +2 Sun; +2 Room, +1 Heat; +1 2/day, +3 environmental trigger: sunrise/set)"
    }

}
