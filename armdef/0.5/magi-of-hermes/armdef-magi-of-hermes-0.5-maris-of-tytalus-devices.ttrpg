            ^"Printed Effect Line" STRING "PeTe(Aq) 20 Pen +0, 24/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "All salt within the container is destroyed, even if in solution, leaving drinkable fresh water. Any other impurities will remain.\n\n(Base 3, +1 Touch, +2 Mineral, +1 Complex; +5 24/day)"
    }

    #t2e9f062d7127029e0f4c0f ^"Concoct Cordage" DEF {
