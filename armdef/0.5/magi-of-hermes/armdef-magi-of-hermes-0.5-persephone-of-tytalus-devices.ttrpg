EXTENSION "ARMDef_Magi_of_Hermes_PersephoneOfTytalus_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Ten: Persephone of Tytalus devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t1f91f08707dc048bab1ad2 ^"Touch of Hilarity" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Coin of Mirth"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +1 Diam)"
            ^"Printed Effect Line" STRING "CrMe 10 Pen 0, charged item R: Touch, D: Diam, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "When activated, this coin causes the person who it is touching to burst into uncontrollable laughter. The target hoots, howls, chortles, guffaws, or otherwise expresses loud hilarity. The trigger for this effect is typically a chuckling sound.\n\n(Base 4, +1 Touch, +1 Diam)"
    }

    #t8007426801f917a0c44e05 ^"Hiding in Plain Sight" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Bracelet of Clandestine Insignificance"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuIm 14 Pen 0, 24/day R: Touch, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "The visual and auditory species shed by the target acquire an anamorphic nature, tricking the viewer’s mind into misinterpreting what he is seeing. As long as the wearer of the bracelet acts in a non-threatening manner and draws no attention to herself, no-one will pay her the slightest notice. Their attention simply glides off her as being mundane and insignificant. For example, she can walk through a crowded room and no-one will notice her passing. But should she stop to talk to anyone, the illusion is lost for that individual. For the illusion to work, the victim must fail a Perception roll with a –3 penalty (since the illusion involves two senses). The Ease Factor for this roll is equal to the sum of a die roll, the victim’s Inattentive (or similar) Personality Trait, the wielder’s Perception, and the wielder’s Finesse score. The victim’s total must exceed the Ease Factor by 3 or more to reveal the illusion as false. See Houses of Hermes: Societates, pages 65–66 for more details of anamorphic illusions.\n\nPersephone is careful not to wear the bracelet wherever she may be in the company of magi, since she could be accused of scrying if they perceive the illusion.\n\n(base 2, +1 Touch, +1 Conc; +5 item maintains concentration, +5 24/day)"
    }

    #td6c5be8c818dcb46d27d63 ^"Face of Lord Richard of Hallam" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Signet of Hallam"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 16
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Conc, +1 Part; +1 2/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "MuCo 16 R: Touch, D: Conc, T: Part Pen 0, 2/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell works just like Disguise of the New Visage, except that the effect can only duplicate the face of a single person — that of Lord Richard of Hallam. He has black hair and green eyes, and is clean shaven. The effect can be canceled at will, but can only be activated twice per day.\n\nThis effect is triggered when the wearer of the ring rubs it and says either trigger word “vir Hallamus” or “mulier Hallamae.”\n\n(Base 3, +1 Touch, +1 Conc, +1 Part; +1 2/day, +5 item maintains concentration)"
    }

    #tc44e7bf83d6c862d80e932 ^"Voice of Lord Richard of Hallam" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Signet of Hallam"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 9
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +1 Conc; +1 2/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "MuIm 9 R: Touch, D: Conc, T: Ind Pen 0, 2/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell works just like Voice of the Leucrota, except that the effect can only duplicate the voice of a single person — that of Lord Richard of Hallam. He has a deep voice with a distinctive Norman accent. The effect can be canceled at will, but can only be activated twice per day.\n\nThis effect is triggered when the wearer of the ring rubs it and says either trigger word “vir Hallamus” or “mulier Hallamae.”\n\n(Base 1, +1 Touch, +1 Conc; +1 2/day, +5 item maintains concentration)"
    }

    #t266cbb11bb0bb18f57cbd9 ^"Clothes of Lord Richard of Hallam" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Signet of Hallam"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Requisite" STRING "Herbam"
            ^"Level" INTEGER 16
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +1 Conc, +2 Group; +1 2/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "MuAn(He) 16 R: Touch, D: Conc, T: Group Pen 0, 2/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell works just like Remake the Tailor’s Craft, except that the effect can only change the target’s clothes into those of a specific description: woolen doublet and hose of black with red ornamentation, a white linen shirt, leather riding boots and a riding cape. The outfit comes with a stylish felt hat bearing a red feather, and gloves.\n\nThe effect can be canceled at will, but can only be activated twice per day. This effect is triggered when the wearer of the ring rubs it and says either trigger word “vir Hallamus” or “mulier Hallamae.”\n\n(Base 2, +1 Touch, +1 Conc, +2 Group; +1 2/day, +5 item maintains concentration)"
    }

    #t41a0017adec7414b75bd51 ^"Body of the Virile Male" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Signet of Hallam"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 11
            ^"Penetration" STRING "0"
            ^"Uses" STRING "2/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Conc; +1 2/day, +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "MuCo 11 R: Touch, D: Conc, T: Ind Pen 0, 2/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "The target’s body assumes male physical characteristics without altering other aspects of appearance. The effect can be canceled at will, but can only be activated twice per day. This effect is triggered when the wearer of the ring rubs it and says the trigger word “mulier Hallamae.”\n\n(Base 3, +1 Touch, +1 Conc; +1 2/day, +5 item maintains concentration)"
    }

    #t93db342aa342a8082e1e52 ^"Masking the Odor of Magic (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Masking the Odor of Magic"
            ^"Part Of" STRING "Signet of Hallam"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base effect (5), +1 Touch, +2 Sun, +2 Group; +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "PeVi 34 R: Touch, D: Sun, T: Group Pen 0, constant effect"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "Prevents the detection of any of the effects in this item by magic, unless the Intellego Vim spell is greater than 30th level. A character with the Magic Sensitivity Supernatural Ability must have a score of 6 or greater to detect the magic of this item.\n\n(Base effect (5), +1 Touch, +2 Sun, +2 Group; +1 2/day, +3 environmental trigger)"
    }

    #tecbb5da79e3b74b7772493 ^"Take Me Home" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Pigeon Amulet"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "charged item"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +3 Moon)"
            ^"Printed Effect Line" STRING "ReMe 25 Pen 0, charged item R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "When activated, this amulet causes the person who it is touching to have a nagging desire to travel to a place that is designated when the item is made. The sensation persists throughout the effect’s duration, and a week of this is usually sufficient to prompt the target to manufacture a reason to make the journey. The trigger for this effect is typically the buzz of a bee, which can be caused remotely using Persephone’s Triggering the Distant Power spell.\n\n(Base 5, +1 Touch, +3 Moon)"
    }

    #ta274d581b16a3ce216eecb ^"Repulse the Unwanted Attention (Fides Sororis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Repulse the Unwanted Attention"
            ^"Part Of" STRING "Fides Sororis"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +1 Conc; +5 maintains concentration, +5 24/day)"
            ^"Printed Effect Line" STRING "ReCo 35 R: Touch, D: Conc, T: Ind Pen 0, 24/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This spell is identical to the effect in Persephone’s talisman, except that it was invented at Range Touch since this item is not a talisman.\n\n(Base 15, +1 Touch, +1 Conc; +5 maintains concentration, +5 24/day)"
    }

    #t15d3f3a060c1191125364a ^"Adopt the Sister’s Face" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Fides Sororis"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Requisite" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Conc, +1 Part, +1 requisite; +5 item maintains concentration, +5 24/day)"
            ^"Printed Effect Line" STRING "MuCo(Vi) 25 R: Touch, D: Conc, T: Part Pen 0, 24/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The target’s face is changed to be that of Persephone of Tytalus. The face is always that of Persephone’s current appearance due to the presence of the indefinite Arcane Connection wrapped around the ring. The Vim requisite in this effect taints the target with magic, so that she also appears to have The Gift by those who investigate her magically, although the wearer temporarily gains the Magical Air Flaw. The effect is triggered by kissing the ring.\n\n(Base 3, +1 Touch, +1 Conc, +1 Part, +1 requisite; +5 item maintains concentration, +5 24/day)"
    }

    #tcb9ca0af5471aa2be81d60 ^"Repulse the Unwanted Attention (Amor Sororis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Repulse the Unwanted Attention"
            ^"Part Of" STRING "Talisman: Amor Sororis"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +1 Conc; +5 item maintains concentration, +5 24/day)"
            ^"Printed Effect Line" STRING "ReCo 30 R: Per, D: Conc, T: Ind Pen 0, 24/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The ring confers a personal ward against people on the wearer of the ring. Only those without Magic Resistance are affected. If she is simply walking through a crowd the people are nudged aside to allow her to pass. Warded individuals cannot act across a ward in any manner, therefore if she is attacked, her opponents’ blows always go wide, causing them to miss. She is not protected from thrown weapons or missiles, though. The effect is triggered by holding the hand wearing the ring in front of the body, palm facing outward.\n\n(Base 15, +1 Conc; +5 item maintains concentration, +5 24/day)"
    }

    #t708866d6a53c4f4d2ea039 ^"Watchful Eye of the Caring Sister" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Talisman: Amor Sororis"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4, +4 Arc; +10 unlimited uses)"
            ^"Printed Effect Line" STRING "InCo 25 R: Arc, D: Mom, T: Ind Pen 0"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 95
        }
        DESCRIPTION ", unlimited uses Reveals the general state of health of anyone to whom the item’s user has an Arcane Connection. Naturally, Persephone uses this effect to check on the status of her sister when the two are apart. The effect is triggered by turning the ring three times clockwise on the finger.\n\n(Base 4, +4 Arc; +10 unlimited uses)"
    }

    #tc5c6c5cb90744a82c3153b ^"Opening the Intangible Tunnel (Magi of Hermes)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Opening the Intangible Tunnel"
            ^"Part Of" STRING "Talisman: Amor Sororis"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base effect, +4 Arc, +1 Conc; +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "ReVi 25 R: Arc, D: Conc, T: Ind Pen 0, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "As the spell of the same name, except that the talisman takes the strain of concentrating on the Intangible Tunnel. Spells up to 20th level can be carried to the target of the Arcane Connection, which is commonly Kore. The effect is triggered by moving the ring from its customary position on the ring finger of the left hand, over to the middle finger.\n\n(Base effect, +4 Arc, +1 Conc; +5 item maintains concentration)"
    }

}
