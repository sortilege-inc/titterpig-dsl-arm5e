            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "1 (4)"
            ^"Virtues and Flaws" STRING "Add Compulsion – hand washing (from Warping)"
            ^"Abilities" STRING "Artes Liberales 2 (grammar), Awareness 2 (people hiding), Brawl 4 (knife), Chirurgy 2 (on sister), Entrancement 5 (men), Folk Ken 2 (magi), French 5 (Norman), Guile 3 (to magi), Hex 5 (sudden fires), Infernal Lore 4 (curses), Intrigue 2 (magi), Latin 3 (10) (Hermetic), Leadership 3 (agents), Magic Lore 4 (fire spirits), Magic Theory 3 (spells), Order of Hermes Lore 2 (local tribunal), Penetration 3 (Hex), Profession: Apothecary 4 (poisons), Stealth 3 (avoiding attention)"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 90
        }
    }

