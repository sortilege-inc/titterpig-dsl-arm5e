EXTENSION "ARMDef_Magi_of_Hermes_PersephoneOfTytalus_Kore" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Kore"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # Kore (Chapter Ten: Persephone of Tytalus, p90): 4 stat blocks, one DEF each, as printed at each age, its printed stat lines verbatim fields.

    #t82449dceff4187da5d5550 ^"Kore" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Kore"
            ^"Role" STRING "Companion"
            ^"Characteristics" STRING "Int +3, Per 0, Pre +3, Com –3, Str +1, Sta +1, Dex –1, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "24 (24)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Wise One; Entrancement, Hex (see Realms of Power: The Infernal, page 85); Arcane Lore, Strong Willed, True Love (sister); Enemy, Hatred; Disfigured, Offensive to Animals, Palsied Hands, Reclusive"
            ^"Personality Trait" STRING "Wrathful +3, Ruthless +3, Devoted to Sister +2, Secretive +1"
            ^"Reputations" STRING "none"
            ^"Combat" STRING "Knife: Init 0, Attack +4, Defense +4, Damage +3"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 2 (grammar), Brawl 3 (knife), Chirurgy 2 (on sister), Entrancement 4 (men), Folk Ken 2 (magi), French 5 (Norman), Guile 2 (to magi), Hex 4 (sudden fires), Infernal Lore 3 (curses), Latin 3 (Hermetic), Leadership 2 (agents), Magic Lore 3 (fire spirits), Magic Theory 3 (spells), Order of Hermes Lore 2 (local tribunal), Penetration 2 (Hex), Profession: Apothecary 3 (poisons), Stealth 1 (avoiding attention)"
            ^"Equipment" STRING "none"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "A scant inch taller than her sister and with the same luxurious russet hair, it would be easy to mistake Kore for her sister were it not for the hideous burn scar on the left side of her body. The puckered flesh distorts her face into a permanent sneer. Her hands constantly shake — another symptom of her wounds — and she usually steadies them by crossing them tightly across her chest. She habitually wears a hooded cloak of dark-colored wool so as to hide her face as best she can."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 90
        }
    }

    #tb0e62ef907d2257f098ef2 ^"Kore +15 Years" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Kore"
            ^"Role" STRING "Companion"
