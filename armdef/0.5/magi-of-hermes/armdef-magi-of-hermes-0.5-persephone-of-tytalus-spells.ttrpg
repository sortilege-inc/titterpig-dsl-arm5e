EXTENSION "ARMDef_Magi_of_Hermes_PersephoneOfTytalus_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Ten: Persephone of Tytalus spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t10ecbdbe62ce56e2ceb089 ^"Remake the Tailor’s Craft" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun, +2 Group)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuAn 15 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "Transforms a set of clothing into different clothes. The substance and color must be preserved, but the shape and number of the garments can be altered. Thus a peasant’s woolen smock can become a woolen dress, wimple, and cloak. An Intelligence + Finesse roll determines the quality of the new set of clothes; an Ease Factor of 6 is sufficient for a simple change, although the Ease Factor is 3 points higher if the new clothes are dramatically different from the old. The spell assumes that the clothing is in the main of animal origin — wool, felt, fur, leather, and silk — which is usually the case. A casting requisite of Herbam is needed to transform garments that are partly of plant origin, but items made solely of plant matter cannot be affected. Accouterments like wooden or metal fastenings remain unchanged.\n\n(Base 2, +1 Touch, +2 Sun, +2 Group)"
    }

    #t015115fd51ac882f9ea05c ^"Trigger the Distant Power" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +4 Arc)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrIm 5 R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The caster specifies a particular noise that then momentarily sounds in the vicinity of an object, place, or person to which the caster has an Arcane Connection. The spell cannot duplicate a voice or say words.\n\nPersephone uses this simple spell to trigger a number of different effects in the charged items she makes and distributes to her agents. Each item is keyed to trigger its effect upon hearing a commonplace noise, like a whine, a buzz, or a chirrup easily attributable to an insect.\n\n(Base 1, +4 Arc)"
    }

    #tc623cce50cb2482cad0bc9 ^"Voice of the Leucrota" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 4 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "The target’s voice is changed so that it is wholly different. This can duplicate the voice of a specific person known to the caster, or a particular accent he has heard before, or simply change the voice to be different than the target’s own. This spell does not allow the target to speak a language that she does not know. An Intelligence + Finesse roll against an Ease Factor of 6 can accurately replicate an accent, and a 9 is needed to duplicate a specific voice. Someone more familiar with the person mimicked may still perpetrate the falsehood. This is also Persephone’s favored spell used to humiliate an opponent she has bested in certamen — she often gives them an unnaturally squeaky or basso profundo voice. A leucrota is a mythical beast that can mimic the voices of men to lure them as prey.\n\n(Base 1, +1 Touch, +2 Sun)"
    }

    #tbe707765ac8eb7c5a53400 ^"Aura of Childlike Innocence (Magi of Hermes)" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Aura of Childlike Innocence"
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuIm 10 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 91
        }
        DESCRIPTION "This spell is a variant of Aura of Ennobled Presence, except that it causes the target to appear more guileless, gullible, and naïve. The character gets a +3 to rolls to deflect suspicion or convince others of his innocence. To those affected by the caster’s Gift, his apparent innocence and unblemished honor appears sanctimonious and self-righteous (originally in Houses of Hermes: Societates, page 96).\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #tdc24d9af9fa7388c147561 ^"Catching the Eye" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +3 Sight)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrMe 15 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The caster momentarily attracts the target’s attention, sufficiently to make eye contact to follow up with a spell of Range: Eye. This spell is normally redundant given the spectacle of spell casting; however Persephone has both Quiet and Subtle Magic, and a spell at Range: Eye is far more subtle than one of Range: Voice.\n\n(Base 4, +3 Sight)"
    }

    #t98e9f04b73e280ba619960 ^"The Factor’s Roll Call" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +1 Eye)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InMe 20 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "This spell probes the mind of the target to reveal if he has ever heard a specific word. Persephone uses this spell to determine whether a given person is one of her agents — since she operates her agents remotely she instructs her factors to say an obscure word to all recruited agents. This spell therefore tells her if a person is in her employ. She has on occasion used it to discover whether her identity has been leaked. The word she most commonly uses is “shibboleth,” although theologians may have heard this word before.\n\n(Base 15, +1 Eye)"
    }

    #t3958c889cfcb2cca23f405 ^"Music of the Unwanted Attention" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Hearing"
            ^"Printed Stat Line" STRING "InMe 25 R: Per, D: Mom, T: Hearing"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The caster is able to sense anyone who is currently aware of her. A person’s attention, regardless how fleeting, is heard as a musical chime, and each individual is represented by a different tone. She doesn’t detect any information about them other than they are aware of her existence. The information gained from this spell is only relevant for the moment that the spell is cast, and is only applicable to those who have an active interest in the caster’s presence. This spell operates by interrogating the common sense (see Art & Academe, page 33) for images of the caster. (Base 10, +3 Hearing)"
    }

    #tea75a1c81f49eb7b267173 ^"Funding the Blackmailer’s Purse" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 25, +1 Eye)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InMe 30 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The caster reveals a deep-seated secret in the mind of the target. The caster must have some idea about the subject of the secret; this spell cannot be used to “fish” the mind for a random secret. Instead, based on a piece of scant information, the spell reveals all the sordid details of a shameful deed, embarrassing moment, or concealed history. For example, Persephone notices that Credo the grog flinches every time the word “chalice” is mentioned. This spell will reveal that in her youth Credo stole the sacramental chalice from her local church, that she dared not fence it after committing the deed, and that it lies buried in the packed earth beneath her sleeping pallet.\n\n(Base 25, +1 Eye)"
    }

    #tbfe13b288f433e13cb6dae ^"My Old and Dear Friend" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Eye, +2 Sun, +1 complexity)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "MuMe 20 R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 92
        }
        DESCRIPTION "The target’s memory is altered so that the caster is “remembered” to have performed a major favor for him in the recent past. The caster gets to choose in what manner she appears in the altered memory. The target cannot be convinced of the falsity of this memory until the duration of the spell expires, at which point he realizes the deception.\n\n(Base 4, +1 Eye, +2 Sun, +1 complexity)"
    }

    #t22fc7a75dd71e76f6d29bb ^"I Was Never Here" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Eye)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeMe 5 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "The target forgets meeting the caster. Prior contact between the caster and the target must be limited to a brief and relatively insignificant event occurring within the last day, and includes the casting of this spell. This spell is perfect for making a target forget seeing the maga overtly cast a spell, or causing a sentry to forget letting her through a gate. However, a person cannot be made to forget who stabbed him.\n\n(Base 4, +1 Eye)"
    }

    #tdfb52cc289db073d377b64 ^"Short Step of the Ghost" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +1 Part, +1 affect stone)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Auram"
            ^"Printed Stat Line" STRING "MuTe(Au) 25 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "The stone in a section of wall momentarily becomes as permeable as mist, allowing the caster to step through. The wall solidifies behind her. It affects an area as large as a door, but the wall cannot be more than one foot thick. The highly unnatural substance that the section of wall briefly becomes does not affect its structural integrity.\n\n(Base 10, +1 Touch, +1 Part, +1 affect stone)"
    }

    #t8d38e24e95817059830472 ^"Invisible Hand of the Thief" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReTe 20 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "Instantly transports any single object to the hand of the caster. The object must be within range and be visible to the caster. Objects that are being held or worn can be affected by this spell, and may need casting requisites for material other than that covered by the Form of Terram — for example, Animal for wool, leather, bone, or ivory; and Herbam for wood, rope, or linen. If the target object is protected by Magic Resistance (such as an item worn by a magus), then the spell must have sufficient Penetration.\n\nThe base level for this effect is that for a very unnatural motion. However, for instant transportation the Rego Corpus guidelines are consulted, which adds one magnitude for instant transportation over 5 paces, two magnitudes over 50 paces, and so forth.\n\n(base 4, +2 Voice, +1 affect restrained objects, +1 for 50 paces transportation)"
    }

}
