    # Petalichus of Verditus (Chapter Eleven: Petalichus of Verditus, p96): 4 stat blocks, one DEF each, as printed at each age, its printed stat lines verbatim fields.

    #tc7794524465fdf6bca2ff8 ^"Petalichus at Gauntlet" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Character" STRING "Petalichus of Verditus"
            ^"Role" STRING "Magus"
            ^"Characteristics" STRING "Int +2, Per +2, Pre 0, Com 0, Str –1, Sta 0, Dex +2, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "2 (5)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Major Magical Focus (cloth); Inventive Genius, Puissant Artes Liberales, Planetary Magic, Puissant Finesse, Puissant Magic Theory, Self-Confident, Verditius Magic; Enemies (Solar Magnus), Weak Spontaneous Magic; Slow Caster, Driven (find the lost works), Infamous"
            ^"Personality Trait" STRING "Acquisitive +1, Decisive +1, Hungry for Knowledge +2"
            ^"Reputations" STRING "Ill-tempered 4 (Magi of Thebes)"
            ^"Combat" STRING "Dodge: Init –1, Attack N/A, Defense +0, Damage N/A Fist: Init –1, Attack +3, Defense +0, Damage –1 Knife: Init –1, Attack +5, Defense +1, Damage +1"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 3+2 (astronomy), Awareness 1 (searching), Bargain 1 (enchantments), Brawl 1 (Knife), Clothiery 1 (shirts), Code of Hermes 1 (political intrigue), Constantinople Lore 3 (geography), Finesse 1+2 (precision), Greek 5 (magical terms), Guile 1 (lying to authority), Intrigue 1 (alliances), Latin 3 (Hermetic usage), Leadership 1 (magi), Magic Lore 2 (magical traditions), Magic Theory 4+2 (enchanting items), Verditius Cult Lore 1 (initiations), Parma Magica 1 (Ignem), Penetration 1 (Ignem), Philosophiae 2 (ceremonial magic), Weaver 3 (linen)"
            ^"Arts" STRING "Cr 0, In 5, Mu 0, Pe 0, Re 7, An 3, Aq 0, Au 0, Co 6, He 3, Ig 5, Im 0, Me 3, Te 0, Vi 2"
            ^"Twilight Scars" STRING "None"
            ^"Equipment" STRING "Good-quality clothes, wizardly robes, workman’s clothes, loom"
            ^"Encumbrance" STRING "0 (0)"
            ^"Spells Known" STRING "Unmake This Cloth (PeAn 10/+3) A Day’s Worth of Spinning (ReAn 10/+13) A Day’s Worth of Weaving (ReAn 10/+13) The Even Hand of The Determined Weaver (Re(Cr)An 5/+3) The Weaver’s Subtle Art (ReAn 5/+13) Arachne’s Tuition (ReCo 20/+13) Spasms of the Uncontrolled Hand (ReCo 5/+13) Lamp without Flame (CrIg 10/+5) Tales of the Ashes (InIg 5/+10) Prying Eyes (InIm 5/+5) Sight of the Transparent Motive (InMe 10/+8) Aura of Rightful Authority (ReMe 20/+10) Scales of the Magical Weight (InVi 5/+7) includes Magical Focus"
            ^"Vis" STRING "Petalichus rarely carries vis himself unless he is sure of needing it."
            ^"Appearance" STRING "Petalichus is a good-looking young man, though somewhat pale and intense behind his slick dark hair. His bearing has suffered from long years spent learning his crafts, but he dresses himself in elegant finery. He is precise and the decoration on his clothes matches this, tending toward geometric, clean, and even shapes."
            ^"Sigil" STRING "Petalichus’s magic manifests as threads that weave an effect, and traces of magic feel like frayed edges. He votes with a silver wand in the shape of a large needle."
            ^"Casting Tools" STRING "Petalichus uses a number of oversized needles pinned into his cuffs, each corresponding to a different spell. Each needle carries a different thread, and as the spell is cast the needle is pulled from his cuff and pierced through a cloth held in the other hand."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 96
        }
    }

