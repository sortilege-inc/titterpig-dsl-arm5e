EXTENSION "ARMDef_Magi_of_Hermes_PetalichusOfVerditius_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Eleven: Petalichus of Verditus talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #tcee6b4eff97e82d644581a ^"Distaff of Petalichus" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Distaff of Petalichus"
            ^"Owner" STRING "Petalichus of Verditus"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 105
        }
        TABLE {
            "+4" "control things at a distance" "staff" "Attunements"
            "+4" "destroy things at a distance" "staff" "Attunements"
        }
        DESCRIPTION "Petalichus took a greatstaff in the shape of a distaff as his talisman, to represent his heritage. But the staff is full of mathematical resonances, from being carved and shaped with four sides rather than rounded smooth, to the complex ratios between the positioning of symbols and inscriptions up its shaft. These symbols are picked out in white against the deep black polish of the staff."
    }

}
