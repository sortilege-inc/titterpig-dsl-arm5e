EXTENSION "ARMDef_Magi_of_Hermes_RanulfOfFlambeau_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Twelve: Ranulf of Flambeau talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t04ae7ac078ef566411b953 ^"Staff of Ranulf" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Staff of Ranulf"
            ^"Owner" STRING "Ranulf of Flambeau"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 114
        }
        TABLE {
            "+6" "to fire related effects" "" "Attunements"
            "+4" "to control things at a distance" "" "Attunements"
            "+2" "repel things" "" "Attunements"
            "+3" "to divination" "" "Attunements"
            "+4" "destroy things at a distance" "" "Additional Attunements"
            "+4" "affect dead wood" "" "Additional Attunements"
        }
        DESCRIPTION "Ranulf enchanted a staff for his talisman. The staff is made of coiled lengths of ash, hazel, and oak, and it is bound with iron, inset with leaden and silver traceries, and has a tiny ruby mounted in a silver ring just above where it is held. It was originally opened with 15 pawns of vis to fill the ruby.\n\nAt age 54, Ranulf has the first four effects given below instilled into the item, filling all fifteen pawns of the item’s opened capacity."
    }

}
