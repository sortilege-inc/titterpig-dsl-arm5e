EXTENSION "ARMDef_Magi_of_Hermes_ScipioOfMerinita_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Thirteen: Scipio of Merinita devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #taa2d121abe67198ee676e7 ^"Bag without Bottom" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Bottomless Bag"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+9"
            ^"Uses" STRING "+2/day, constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 10, +2 Sun, +2 Room; +1 2/day, +3 environmental trigger for total of 34 levels)"
            ^"Printed Effect Line" STRING "MuIm 30 Pen +9, +2/day, constant effect R: Personal D: Sun T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "The Glamour enchantment (see page 101 in Houses of Hermes: Mystery Cults) inside this bag makes the space inside it far bigger than it should be. More than 200 liters would fit into it, but because the weight isn’t reduced there is still a limit on the wielder. You could put a whole human body inside this bag, if you could bear its weight. If you’re searching for something inside it, you could be forced to crawl into it.\n\n(Base 10, +2 Sun, +2 Room; +1 2/day, +3 environmental trigger for total of 34 levels)"
    }

    #tb3bf2920232e5da006617d ^"Invisible Musician" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Eternally Changing Lyre"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 5
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day, item maintains concentration"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 1, +1 Concentration, +1 complexity; +4 12/day, +5 maintains concentration for a total of 12 levels)"
            ^"Printed Effect Line" STRING "ReAn 5 Pen +0, 12/day, item maintains concentration R: Personal, D: Concentration, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "Makes the lyre play music that the user can change by concentrating.\n\n(Effect: Base 1, +1 Concentration, +1 complexity; +4 12/day, +5 maintains concentration for a total of 12 levels)"
    }

    #t134c7bef60e4ad7b86d07d ^"Unaging Wood" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Eternally Changing Lyre"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "2/day constant effect"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 4, +2 Sun; +3 levels environmental trigger, +1 level 2/day, for a total of 14 levels)"
            ^"Printed Effect Line" STRING "MuHe 5 Pen +0, 2/day constant effect R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "Makes the lyre hard and flexible like good sheet metal. This gives a small penalty of –1 to music rolls.\n\n(Effect: Base 4, +2 Sun; +3 levels environmental trigger, +1 level 2/day, for a total of 14 levels)"
    }

    #t0d541d98144ba56522c89a ^"Dance Horror" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Eternally Changing Lyre"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Effect: Base 15, +2 Voice, +2 Sun; +4 12/day, for a total of 39 levels)"
            ^"Printed Effect Line" STRING "ReMe 35 Pen +0, 12/day R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "Makes the target dance until he has no Fatigue levels or the duration ends. Every round he has to make an Stamina roll against an Ease Factor of 6, or lose a Fatigue level.\n\n(Effect: Base 15, +2 Voice, +2 Sun; +4 12/day, for a total of 39 levels)"
    }

}
