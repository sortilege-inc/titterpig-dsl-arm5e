            "Folk Ken" SCORE 3 SPECIALTY "peasants"
            "Guile" SCORE 6 BONUS 2 SPECIALTY "fast talking"
            "High French" SCORE 5 SPECIALTY "peasants"
            "Hunt" SCORE 3 SPECIALTY "birds"
            "Latin" SCORE 4 SPECIALTY "magi"
            "Legerdemain" SCORE 3 SPECIALTY "picking pockets"
            "Magical Lore" SCORE 3 SPECIALTY "forest"
            "Magic Theory" SCORE 5 SPECIALTY "Imaginem"
            "Music" SCORE 3 SPECIALTY "singing"
            "Stealth" SCORE 3 SPECIALTY "hiding"
