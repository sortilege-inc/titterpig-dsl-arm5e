            ^"Age" STRING "25 (20)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Gentle Gift, Strong Faerie Blood (Sidhe); Affinity with Imaginem, Enchanting Music, Faerie Magic (free), Free Expression, Performance Magic (Music); Plagued by Supernatural Entity, True Love (NPC); Careless Sorcerer, Faerie Upbringing, Lesser Malediction (Iron burns like fire), Meddler"
            ^"Personality Trait" STRING "Meddler +3, Wanderlust +3, Carefree +2, Brave +1"
            ^"Reputations" STRING "Trouvere 0 (Artist)"
            ^"Combat" STRING "Dodging: Int 0, Attack n/a, Defense +2, Damage n/a"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Artes Liberales 1 (ceremonial magic), Athletics 1 (running), Awareness 1 (spotting), Bargain 1 (music payment), Brawl 1 (dodging), Carouse 1 (drinking songs), Charm 1 (first impressions), Concentration 1 (spell concentration), Enchanting Music 2 (friendship), Etiquette 1 (faeries), Faerie Lore 1 (faerie forests), Faerie Magic 1 (spells), Finesse 1 (Imaginem), Folk Ken 1 (faeries), Guile 1 (fast talk), High French 5 (music), French Kingdom Lore 1 (towns), House Merinita Lore 1 (Initiations), Intrigue 1 (rumormongering), Latin 4 (texts), Legerdemain 1 (“magic” tricks), Magic Lore 1 (forests), Magic Theory 3 (spells), Music 2 (lyre), Order of Hermes Lore 1 (magi), Parma Magica 1 (Vim), Penetration 1 (Imaginem), Philosophiae 1 (ceremonial magic), Profession: Trouvere 1 (5) (love songs), Second Sight 1 (faeries), Stealth 1 (sneak), Survival 1 (finding routes), Swim 1 (rivers)"
            ^"Arts" STRING "Cr 5, In 2, Mu 3, Pe 2, Re 6; An 0, Aq 0, Au 0, Co 6, He 1, Ig 0, Im 11, Me 0, Te 1, Vi 0"
            ^"Twilight Scars" STRING "None."
            ^"Equipment" STRING "Bard’s outfit, lyre, flute, bag of “magic” tricks."
            ^"Encumbrance" STRING "0 (0)"
            ^"Spells Known" STRING "Eyes of the Cat (MuCo(An) 5/+3) Curse of the Unruly Tongue (ReCo 5/+12) Jump of the Lynx (ReCo 20/+12) Told Story (CrIm 20/+16) Aura of the Simple Bard (MuIm 15/+14) Faerie Flute (MuIm 5/+14) Rainbow Fire (MuIm 15/+14) Image Phantom (MuIm 20/+14) Hiding the Ill-Bred Bard (PeIm 15/+13)"
            ^"Appearance" STRING "An ever-smiling bard with red hair, pointy ears, and strange-looking amber-colored eyes. His angular face may look like a fox from time to time. He wears multi-colored bard’s clothes, and some musical instruments hang from his belt. His hat is decorated with many multi-colored feathers from strange faerie birds."
            ^"Sigil" STRING "His casting sigil is a red fox that manifests and even acts in his spells. His voting sigil is a red wand with the wooden head of a fox."
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 116
        }
    }

