EXTENSION "ARMDef_Magi_of_Hermes_ScipioOfMerinita_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Thirteen: Scipio of Merinita spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t62bf380ebd87bed007765a ^"Bridge of Gnomes" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun, +2 very unnatural fashion)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrAu 15 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This spell creates a rainbow up to seven miles long. It only works outdoors.\n\n(Base 2, +1 Touch, +2 Sun, +2 very unnatural fashion)"
    }

    #t0a278f568416c3c23fc1d6 ^"Rainbow Bridge" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +3 Sight, +2 Sun, –1 for only one property change)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuAu 30 R:Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "This spell gives an existing rainbow the hardness of good stone or iron. It is still colorful and you can see through it; only the hardness is changed. With rainbows like these you can build bridges into the sky that can be used by creatures other than gnomes.\n\n(Base 10, +3 Sight, +2 Sun, –1 for only one property change)"
    }

    #te439d11a10894be6ccc861 ^"High Tree or Small Boulder" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Sun, +1 because this spell allows growth and shrinking)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuCo 20 R: Voice, D:Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "The spell’s target either grows to three paces tall or shrinks to only a half pace in height, but his mass isn’t affected. As a result, the target is either a thin giant who cannot control his body parts normally, or he is a tiny, fat dwarf who rather rolls than walks.\n\n(Base 3, +2 Voice, +2 Sun, +1 because this spell allows growth and shrinking)"
    }

    #t7ccd3206075231d79322a4 ^"Follower’s Bane" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Road, +2 Sun)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Road"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 10 R: Road, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 122
        }
        DESCRIPTION "The magus can hex someone he senses via normal or magical senses who stands on the same road. The target’s legs starts to spasm in a way that makes it impossible to walk, let alone chase someone.\n\n(Base 2, +2 Road, +2 Sun)"
    }

    #t1097229aa4ced9961d7cfb ^"Jump of the Lynx" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Diameter, +1 for no falling damage)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 20 R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Like Gift of the Frog’s Legs, but with an additional magnitude to avoid the risk of falling. While the spell is working, the caster can make multiple jumps because of its Diameter Duration. Scipio has used this spell to escape when an angry mob was after him.\n\n(Base 10, +1 Diameter, +1 for no falling damage)"
    }

    #t95a59e26963cb302e43926 ^"How God Created Them" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Group, +1 Animal requisite)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuHe(An) 25 R: Voice, D: Momentary, T:Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "All the clothes worn by one person that are made out of animal or plant products become larger and slippery, and slide down to the ground leaving the victim of the spell naked.\n\n(Base 3, +2 Voice, +2 Group, +1 Animal requisite)"
    }

    #tc96e107d9823df4afed475 ^"Everlasting Music" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 While, +1 Animal requisite, +1 complexity)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "While (being carried)"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "ReHe(An) 20 R: Touch, D: While (being carried), T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This spell makes a stringed, wooden instrument play music. The spell lasts until the instrument is put down, which, if it is tied to someone’s belt, might not be for a very long time. The Animal requisite is for the strings of such an instrument.\n\n(Base 3, +1 Touch, +1 While, +1 Animal requisite, +1 complexity)"
    }

    #te395d5420355e89b5c4093 ^"Summer’s Blessing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +2 Sun, requisite is free, +1 constantly releasing heat)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Terram"
            ^"Printed Stat Line" STRING "MuIg(Te) 30 R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This spell turns the heat and flames of a large campfire into a small, very hard object, such as a gem or a piece of metal. If the object is broken the flame returns, but it dies if there is nothing to burn. While the spell lasts, the object is constantly emitting heat equal to a warm summer’s day; this heat warms everything within a few paces.\n\n(Base 5, +2 Voice, +2 Sun, requisite is free, +1 constantly releasing heat)"
    }

    #t58f562cbe1eb979caf4f09 ^"Smoke of Escaping" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +1 Diameter, +1 size, +1 impenetrable to sight)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIm 5 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Creates the illusion of a thick cloud of red smoke in the caster’s vicinity.\n\n(Base 1, +1 Touch, +1 Diameter, +1 size, +1 impenetrable to sight)"
    }

    #ta4acde50f6b2910b8c3c97 ^"Book of Images" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Ring, +1 moving images, +1 intricacy)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIm 15 R: Touch, D: Ring, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This spell creates moving sounds and images that are stored in a circle (such as a drawn circle on paper) as long as it is intact. With this spell it is possible to create a whole book or gallery of fantastic images and talking pictures, but only if proper Finesse rolls are made.\n\n(Base 2, +1 Touch, +2 Ring, +1 moving images, +1 intricacy)"
    }

    #t3e303b164eb933a6f5a972 ^"Told Story" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +1 Performance +2 changing images, +1 intricacy)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIm 20 R: Voice, D: Performance, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Creates the images and sounds of a story sung by the bard, which change along with the story. This spell only creates a small three-dimensional stage on which the story is told, but no true persons. Scipio can sing the story displayed on the stage without losing concentration, because of his Performance Magic (Music) Virtue.\n\n(Base 2, +2 Voice, +1 Performance +2 changing images, +1 intricacy)"
    }

    #t240c0c55669192713ca582 ^"Cage of Bronze" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIm 30 R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This Glamour spell (see page 101 in Houses of Hermes: Mystery Cults) creates a big bronze cage around the target, capturing it (if a targeting Finesse roll succeeds).\n\n(Base 10, +2 Voice, +2 Sun)"
    }

    #t393ab182f4618c91f37be9 ^"Phantasmal Horse" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +2 Sun, +1 moving parts)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrIm 30 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This Glamour spell (see page 101 in Houses of Hermes: Mystery Cults) creates a magical and beautiful riding horse. Due to their faerie nature, such horses are always strangely colored or behave in some other ridiculous way. Scipio’s horses are always red and curious.\n\n(Base 10, +1 Touch, +2 Sun, +1 moving parts)"
    }

    #t8ecf5e614f24b483b8a6c7 ^"Story of Legend" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Voice, +1 Performance, +2 Group, +1 size, +2 changing images, +1 intricacy)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrIm 35 R: Voice, D: Performance, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This spell is similar to Told Story, but instead of creating a small stage as an Individual, this spell can create up to 100 persons or things like clouds, small dragons, and so on.\n\n(Base 2, +2 Voice, +1 Performance, +2 Group, +1 size, +2 changing images, +1 intricacy)"
    }

    #tdbe9440eefb6f9ad7f65da ^"Doppelganger" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +1 Touch, +2 Sun, +1 Mentem requisite, +1 copy of someone, +1 moving parts)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Mentem"
            ^"Printed Stat Line" STRING "CrIm(Me) 40 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "This Glamour spell (see page 101 in Houses of Hermes: Mystery Cults) creates a person’s doppelganger, with some limited freedom and simulated intellect. It may act independently but is under the caster’s control. Like all Glamour spells, the doppelganger has substance and can act as something that really exists.\n\n(Base 10, +1 Touch, +2 Sun, +1 Mentem requisite, +1 copy of someone, +1 moving parts)"
    }

    #td79b38ee4f10cbf32c6f7d ^"Image of the Lady" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +2 Sun, +1 intricacy, +6 Mentem requisite, for a very elaborate effect)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Requisite" STRING "Mentem"
            ^"Printed Stat Line" STRING "CrIm(Me) 40 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 124
        }
        DESCRIPTION "Similar to Book of Images and the spell The Shadow of Human Life (ArM5, page 144) this spell creates an image of a person, which can also make sounds, within a ring that serves as a frame. This image has limited freedom and a simulated intellect. He or she cannot learn Abilities, but can remember a story told while casting the spell. Such an image can also work as a guard or similar. In Scipio’s home covenant these pictures hang on almost every wall, working as advisors for slow grogs, as monitors in the kitchens, or as sentries.\n\nDue to experimentation, Scipio’s version of this spell creates images that need to sleep and eat illusionary meals.\n\n(Base 2, +1 Touch, +2 Sun, +1 intricacy, +6 Mentem requisite, for a very elaborate effect)"
    }

    #t9f2b7b7683ac88bfebbc91 ^"Garden of Eden" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +1 Concentration, +1 Part, +1 size, +2 extremely beautiful and detailed surroundings)"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "CrIm 45 R: Voice, D: Concentration, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This Glamour spell (see page 101 in Houses of Hermes: Mystery Cults) creates a nearly perfect world around the caster, in which everything is so beautiful that it almost hurts the eye. Most human beings, many animals, and even some faeries lose any desire to fight or argue. While casting, the magus makes a Finesse roll, the result of which is the Ease Factor of a Personality Trait roll to resist this effect. Appropriate Personality Traits would be anger, hatred, violent, and so on. This spell needs to Penetrate to work.\n\n(Base 10, +2 Voice, +1 Concentration, +1 Part, +1 size, +2 extremely beautiful and detailed surroundings)"
    }

    #t71701557e65e97236c6a42 ^"Traveler’s Foresight" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Road, +1 Concentration)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Road"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InIm 5 R: Road, D: Concentration, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "The magus can see and hear the nearest person on the road he is traveling.\n\n(Base 2, +2 Road, +1 Concentration)"
    }

    #te7492443325a212ba6e2e7 ^"Faerie Flute" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 4
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuIm 4 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Enchants a person or a music instrument to make clearer, sharper, and more-melodious sounds. A bard using this instrument often lures faeries to him.\n\n(Base 1, +1 Touch, +2 Sun)"
    }

    #t58824de87f1d5f538b363d ^"Aura of the Simple Bard" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuIm 15 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Alters the appearance of a person to make him look more innocent and trustworthy. His facial features become softer and more childish. The character receives a +3 on appropriate rolls. This doesn’t undo the effects of The Gift (see page 75 of ArM5), but works well for magi who have the Gentle Gift.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #ta2602e45f0fb93d6916488 ^"Living Fire" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +3 Fire, +1 moving images)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Fire"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuIm 25 R: Voice, D: Fire, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell alters the image, sound, and smell of campfire or bonfire to something the caster chooses, such as a dancing woman or a dragon’s head. The real flame is not changed, so you won’t be burned by the parts of the image that extend outside of it, like the flaming breath of the dragon’s head.\n\n(Base 3, +2 Voice, +3 Fire, +1 moving images)"
    }

    #ta5b1c883bc8d6e36733b8e ^"Safe Haven" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +1 Touch, +3 Moon, +3 Structure)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Structure"
            ^"Printed Stat Line" STRING "MuIm 20 R: Touch, D: Moon, T: Structure"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Changes the image of a building, even one quite extravagant like a small wizard’s tower, to a that of a poor and small hut.\n\n(Base 1, +1 Touch, +3 Moon, +3 Structure)"
    }

    #t073f65f31147854166d098 ^"Ogre’s Stench" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +2 Voice, +2 Sun, +2 Group, +1 size, +2 very “detailed” smell)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuIm 30 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "You change the targets’ smell (up to 100 people) in such a disgusting and awful way that they and every person near them must make Stamina rolls against an Ease Factor of 6 or act with a –3 penalty to all rolls. If they botch, they throw up.\n\n(Base 1, +2 Voice, +2 Sun, +2 Group, +1 size, +2 very “detailed” smell)"
    }

    #t3709333ba8793943341ec0 ^"Blessing the Merchant’s Lineage" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +4 Until, +3 Bloodline)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Until (Baptism)"
            ^"Target" STRING "Bloodline"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "MuIm35 R: Touch, D: Until (Baptism), T: Bloodline, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This spell changes all members of a bloodline so that they look more trustworthy, their voices are softer if needed, and they seem to be smiling whenever appropriate. This gives the whole bloodline a +3 on rolls that involve gaining trust or convincing others. But if anyone in the bloodline gets baptized the duration ends, so this spell is usually only used by pagans. It uses the Spell Timing mystery (see page 100 in *Houses of Hermes: Mystery Cults*).\n\n(Base 3, +1 Touch, +4 Until, +3 Bloodline)"
    }

    #t00511ab4706bbbb2d09aad ^"Servant of Fire" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 10, +2 Voice, +3 Fire, +1 Mentem requisite, +1 moving parts)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Fire"
            ^"Target" STRING "Individual"
            ^"Requisite" STRING "Ignem, Mentem"
            ^"Printed Stat Line" STRING "MuIm(Ig,Me) 45 R: Voice, D: Fire, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "This Glamour spell (see page 101 in Houses of Hermes: Mystery Cults) turns a normal fire into a human servant. He has a simple intellect and is good for only simple tasks, but has no possibility of learning or free will. The servant must eat a lot of wood or other flammable materials, otherwise the fire will burn out, ending the spell. As long as the servant eats enough, however, the spell continues.\n\nThis spell has a minor side effect from experimentation that makes the servant sing instead of speaking normally.\n\n(Base 10, +2 Voice, +3 Fire, +1 Mentem requisite, +1 moving parts)"
    }

    #t4815070bdea6b3373172ee ^"Hiding the Ill-Bred Bard" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Sun, +1 changing image)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeIm 15 R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "Destroys the magus’ image species and makes him invisible except for his shadow.\n\n(Base 4, +2 Sun, +1 changing image)"
    }

    #t82fd3b00b08c0d92747278 ^"Invisible Arms" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Sun, +1 Part, +1 changing image, +1 Creo requisite)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Requisite" STRING "Creo"
            ^"Printed Stat Line" STRING "Pe(Cr)Im 25 R: Personal, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "The caster’s original arms are made invisible, but the illusion of another pair of arms is created to replace them. If he wishes, the magus may use these fake arms in a normal way while his invisible arms pick pockets or cast a spell. This may require a Concentration roll depending on the fake actions; anything much more complex than swinging them while walking requires a roll.\n\n(Base 4, +2 Sun, +1 Part, +1 changing image, +1 Creo requisite)"
    }

    #t8ca8db8de82fc55f2f856e ^"Color Explosion" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 1, +2 Voice, +1 Diameter, +2 fast moving image, +1 change with movements)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReIm 15 R: Voice, D: Diameter, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 125
        }
        DESCRIPTION "The image of the spell’s target seems to explode in a great whirlwind of colors and fragments of the original image. The explosion has a radius of two paces for a human with Size 0, changing appropriately for targets of different Sizes. This makes the target effectively invisible as far as combat is concerned, and no visual clues to his precise location can be picked out of the chaos. For rules for fighting an invisible enemy see Houses of Hermes: Societates, pages 32-33. This spell is best used with Discern Own Illusions.\n\n(Base 1, +2 Voice, +1 Diameter, +2 fast moving image, +1 change with movements)"
    }

    #tc3e5ba0d19706ef35e12fc ^"The Generous Patron" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +2 Sun)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "MuMe 15 R: Voice, D: Sun, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "This spell changes the common sense (see Art and Academe, page 33) of the target. He cannot estimate the true worth of his belongings and is likely to give more of them for less.\n\n(Base 3, +2 Voice, +2 Sun)"
    }

    #t0208ae7de28a1e2f08c202 ^"Stolen Moments" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 25, +1 Eye, +1 Concentration)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 35
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeMe 35 R: Eye, D: Concentration, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "This spell removes all active thoughts, memories, and emotions from a person’s mind for as long as the spell lasts, so he cannot think or perceive. During this time the person becomes motionless, and cannot resist if he is moved or attacked; he does not notice anything and cannot remember anything that happens while he is under influence of this spell.\n\n(Base 25, +1 Eye, +1 Concentration)"
    }

    #tb47391c713bc23454b8e98 ^"Sinister Road" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Road, +3 Moon)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Road"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReMe 20 R: Road, D: Moon, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "Someone walking on the road whom the caster can sense is imbued with a bad feeling about what lies before him; he usually turns away from the road and walks back. This spell works similarly to The Shrouded Glen.\n\n(Base 3, +2 Road, +3 Moon)"
    }

    #t249a5965975db2dd381904 ^"Dancing Mania" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +2 Voice, +1 Concentration)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReMe 30 R: Voice, D: Concentration, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "The target of the spell dances in a wild and ecstatic way for as long as the caster concentrates. The target dances so fast and wildly that he must make a Stamina roll against an Ease Factor of 6 every round to avoid losing a Fatigue level.\n\n(Base 15, +2 Voice, +1 Concentration)"
    }

    #t891dace59e757517448ee6 ^"Endless Laughter" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15, +2 Voice, +1 Concentration)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReMe 30 R: Voice, D: Concentration, T: Individual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "The target’s body is shaken by loud, uncontrollable laughter that makes normal breathing or acting nearly impossible. Every round the target must make a Stamina roll against an Ease Factor of 6, or lose a Fatigue level. If this spell lasts longer than one hour, the target may suffer from an imbalance of his sanguine humor, causing the symptoms of a disease.\n\n(Base 15, +2 Voice, +1 Concentration)"
    }

}
