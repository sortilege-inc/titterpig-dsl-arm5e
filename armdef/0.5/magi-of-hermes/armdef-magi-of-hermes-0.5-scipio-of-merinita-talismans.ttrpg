EXTENSION "ARMDef_Magi_of_Hermes_ScipioOfMerinita_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Thirteen: Scipio of Merinita talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #t2a88a96563049f372eaa4f ^"The Eternally Changing Lyre" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: The Eternally Changing Lyre"
            ^"Owner" STRING "Scipio of Merinita"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 126
        }
        TABLE {
            "+4" "Imaginem" "" "Attunements"
            "+5" "Muto" "" "Attunements"
            "+2" "Rego" "" "Attunements"
        }
        DESCRIPTION "A lyre made from a cinnamon tree, with a magnet and mercury inside a glass stone on the front. 16 pawns were used to open it, 7 for instilling effects. The original lyre was a great work from one of the finest instrument makers in France. It gives the user a +3 on all Music rolls (see *City & Guild,* page 69)."
    }

}
