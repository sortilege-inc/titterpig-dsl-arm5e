EXTENSION "ARMDef_Magi_of_Hermes_TolidesOfFlambeau_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fourteen: Tolides of Flambeau devices"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t19a91d1669b838575bbc0e ^"Gaping Maw of the Bottomless Pit" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Arrows of Defeat"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Part, +1 size, free cosmetic effect)"
            ^"Printed Effect Line" STRING "PeTe 10 R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "The magical effect of the enchanted arrows is equivalent to the spell Pit of Gaping Earth (ArM5, page 155), but operates at Range Touch instead of Voice. Consequently, each arrow, being a carrier for the spell, must be aimed and fired to reach its target, because the arrows themselves do not have any supernatural flight qualities. After leaving the string of the bow used to propel it forward, and upon touching solid, earthen ground, each of the enchanted arrows destroys earth as described for Pit of Gaping Earth.\n\nAs a typical trait of one of Tolides’ creations, black vapor eerily emerges from the bottom of the created pit and dissolves harmlessly into the surrounding environment.\n\n(Base 3, +1 Touch, +1 Part, +1 size, free cosmetic effect)"
    }

    #tf613cc644f427a2dc551e3 ^"Quench the Open Fire" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Torus of Fire Protection"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch; +10 unlimited uses)"
            ^"Printed Effect Line" STRING "PeIg 15 Pen +0, unlimited uses R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "Small mundane fires that come into contact with the item are extinguished, as are magical flames that do not exceed +5 damage. Because it is the enchanted item that must be bathed in flames to extinguish a fire, and not the person who wears it, the pendant should be worn on top of the user’s clothes, and not underneath.\n\n(Effect: Base 4, +1 Touch; +10 unlimited uses)"
    }

    #tfc5fca415cbc72e7a9cb6c ^"Appliance of Wrath" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Poniard of Deliverance"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Touch; +5 penetration, +5 24/day)"
            ^"Printed Effect Line" STRING "PeCo 20 Pen +10, 24/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "When activated by quickly flicking it in the wielder’s wrist, this dagger works as a medium for the embedded spell of destruction. Upon touching its target, the narrow blade deals a Light Wound in addition to any damage that is caused by the physical aspect of the weapon.\n\n(Effect: Base 5, +1 Touch; +5 penetration, +5 24/day)"
    }

    #t72fcf32752a4b93fc824b1 ^"The Fool’s Fate" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Sting of the Viper"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "3/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 10, +1 Touch, free cosmetic effect; +3 effect use, +2 3/day)"
            ^"Printed Effect Line" STRING "PeCo 20 Pen +0, 3/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "When the pin is driven into the flesh of the target, black ripples spread from the puncture and run along the victim’s body, thereby causing a Medium Wound. The artifact does not include any Penetration, and is thus not of much use against targets with Magic Resistance.\n\n(Effect: Base 10, +1 Touch, free cosmetic effect; +3 effect use, +2 3/day)"
    }

    #t29269c335161d4b9766cd2 ^"Chamber of Void" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Source of Tranquillity"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 24
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Constant"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch, +2 Sun; +2 Room; +1 2/day, +3 environmental trigger)"
            ^"Printed Effect Line" STRING "PeIg 24 Pen +0, constant effect R: Touch, D: Constant, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "This enchantment is instilled in a tiny, obsidian figurine that resembles an ugly humanoid with folded wings. The effect of the enchantment completely and entirely extinguishes all light in the Room it is placed into for as long as the item remains in it. All perception based on vision is effectively impossible, unless the occupant is able to see in complete darkness. If the item is moved to a new room, the effect is transferred to that room. If the figurine is not in a room, or is in a room too large for it to affect, the effect is temporarily suppressed.\n\n(Effect: Base 3, +1 Touch, +2 Sun; +2 Room; +1 2/day, +3 environmental trigger)"
    }

    #t9edeed52b8b733daa3a61e ^"Crush the Adversary’s Limb" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Rod of Mutilation"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 33
            ^"Penetration" STRING "+10"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch, +1 Part, free cosmetic effect; +5 penetration, +3 6/day)"
            ^"Printed Effect Line" STRING "PeCo 33 Pen +10, 6/day R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "This item can be used six times per day, for seven years after the first use.\n\nAfter activating the item by bouncing it longitudinally and successfully hitting a human target, the rod cripples the touched limb of that target. The affected limb appears as if crushed by black patches of darkness that ripple along it, and that dissipate as soon as the body part is broken and rendered useless.\n\nThe victim of a broken leg is considered to suffer from the Lame Flaw (**ArM5**, page 55), while two broken legs effectively Cripple (**ArM5**, page 52) a person. One or two broken hands are equivalent to Missing Hand (**ArM5**, page 56), or No Hands (**ArM5**, page 56), respectively. Limbs damaged by the rod heal as a Medium Wound.\n\n(Effect: Base 15, +1 Touch, +1 Part, free cosmetic effect; +5 penetration, +3 6/day)"
    }

    #t08ebfe49153502eeca0a08 ^"Soothing Shadows" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Orb of Immanent Darkness"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 14
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 2, +1 Touch, +2 Sun, +1 Part; +3 environmental trigger, +1 2/day)"
            ^"Printed Effect Line" STRING "PeIg 14 Pen +0, constant effect R: Touch, D: Sun, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "This item provides a constant effect. The intensity of light close to the head and upper part of the body of the person who carries the enchanted item is greatly reduced. It appears as if deep shadows are cast upon the bearer. A closer look will reveal an unnatural lack of light.\n\n(Effect: Base 2, +1 Touch, +2 Sun, +1 Part; +3 environmental trigger, +1 2/day)"
    }

}
