EXTENSION "ARMDef_Magi_of_Hermes_TolidesOfFlambeau_Spells" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fourteen: Tolides of Flambeau spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #tdc3778567ccf3c0294480a ^"Track By Scent" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +2 Sun, requisite free)"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 4
            ^"Range" STRING "Per"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Requisite" STRING "Animal"
            ^"Printed Stat Line" STRING "MuCo(An) 4 R: Per, D: Sun, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "For the duration of the spell, the caster’s sense of smell is as sensitive as a staghound’s.\n\nBeing a hunter through-and-through, Tolides frequently employs this spell to track down those who try to escape the punishment he has decided to deal them.\n\n(Base 2, +2 Sun, requisite free)"
    }

    #t700984049c704a6c907100 ^"Evaluate the Facing Opponent" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +1 Eye)"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "InCo 10 R: Eye, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "Looking the target in the eye, the caster is able to sense any corporal affliction or ailment that might hamper the target’s physical movement. This includes, for example, injuries, fractures, and crippled limbs covered by clothes or armor. Note that the caster must face the target directly to scrutinize his or her physical condition.\n\nWhen Tolides developed this spell he did not own a mirror, but seriously considered acquiring one to extend the utility of the spell to diagnosing himself.\n\n(Base 5, +1 Eye)"
    }

    #tde1900dcb51623fdc17ec2 ^"Chastise the Unruly Antagonist" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Eye, +1 Conc)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeCo 10 R: Eye, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "The target is overcome by intense pain. If the target tries to engage in activities that require concentration while under the effect of this spell, a successful Concentration roll against an Ease Factor of 9 is required (ArM5, page 82). The dreadful effect of punishment lasts as long as the caster concentrates.\n\nIn Tolides’ version of this spell, it appears as if the victim is wrapped in bands of darkness that tear at his flesh.\n\n(Base 4, +1 Eye, +1 Conc)"
    }

    #t61108b7ae4689351e74d92 ^"Retreat Into the Shell of Shadow" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 15)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 15 R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 131
        }
        DESCRIPTION "The caster instantly transports himself to any location he can see, not more than 50 paces distant. A puff of black, quickly dissolving vapor is all that is left behind once the caster vanishes and reappears at the destination. If the initial point or endpoint of the leap is Warded, or if the caster’s magic is resisted, that resistance must be overcome much the same as when targeting a Warded area (see Aegis of the Hearth, ArM5, page 161).\n\nTolides developed this spell to retreat into the shadow of a dark corner. If the endpoint of the transportation is exposed to unclouded daylight, Tolides must make a Concentration roll against an Ease Factor of 9 to gracefully reach his destination. A failure usually means that he tumbles and falls, is disorientated, or is enfeebled, whereas a botch calls for more-dramatic results to reflect his malediction. Note that this quirk is not a flaw of the spell, but an effect of Tolides’ Susceptibility to Sunlight.\n\n(Base 15)"
    }

    #t3e3ce54a0511dfb4677cbc ^"Inner Darkness Unleashed" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +3 Sight, free cosmetic effect)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeCo 20 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "The effect of this spell is similar to The Wound That Weeps (ArM5, page 133), though its cosmetic component and modified Range make it appear somewhat differently.\n\nA wound opens on the body of the affected target, releasing black, oozing liquid similar to oil or tar. As it flows, the black substance is gradually replaced by the victim’s normal blood flow, effectively creating a Light Wound.\n\n(Base 5, +3 Sight, free cosmetic effect)"
    }

    #tc4642fc534ca57166546ed ^"The Protesting Adversary Held Still" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +1 Conc)"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 20 R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "The affected target is held fast and still for as long as the caster concentrates. Being held means that the target is unable to move his body, including his limbs, fingers, eyes, and lips. A magus who tries to cast spells while under the effect of this spell is likely to be subject to a penalty to his casting total, unless the intended magical effect does not require words and gestures (ArM5, page 83).\n\nIn Tolides’ version of this spell, small ripples of darkness quiver over the body of the target that seem to function as ropes, holding his victim in place.\n\n(Base 5, +2 Voice, +1 Conc)"
    }

    #ta9fd1279a93ed2298143cb ^"Blind the Insurgent Pack" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 5, +2 Voice, +2 Group, free cosmetic effect)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeCo 25 R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "Black, oily tears appear in the eyes of all individuals of the affected Group, burning and blurring their vision. With their eyesight blurred, and all sources of light reduced to unrecognizable sparkles, affected targets are considerably hindered while performing actions that depend on eyesight. They are subject to a –3 penalty to all rolls that involve sight (see Poor Eyesight Flaw, ArM5, page 58). If left to themselves, the victims’ blurred vision heals as a Light Wound.\n\n(Base 5, +2 Voice, +2 Group, free cosmetic effect)"
    }

    #t1dfddb8d2b99a81fbfe8bf ^"Banishment of Warmth" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +1 Touch, +2 Ring, free cosmetic effect)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "PeIg 15 R: Touch, D: Ring, T: Circle"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "This practical spell expels the warmth from all items that have been set up inside the affected Circle. Lowering the temperature of the Circle to slightly above freezing, Banishment of Warmth can be used to prevent goods related to Animal, Herbam, or Corpus from decaying naturally for a couple of days. The spell is not designed as an offensive weapon, but living creatures that remain in the Circle for an extended period of time do start losing Fatigue due to the cold. Note that the spell must be cast after the targets have been set up inside the Circle; it does not affect items that are placed into the Circle once the spell has been cast. A closer look at the enchanted Circle reveals a translucent waft of vapor over the affected area.\n\n(Base 4, +1 Touch, +2 Ring, free cosmetic effect)"
    }

    #t40630fdfeb90b70b00d66b ^"Extinguish the Abhorrent Flame" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +3 Sight)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeIg 15 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 132
        }
        DESCRIPTION "This spell instantly extinguishes any individual fire up to the size of a campfire. The extinguished fire can be relit by mundane or magical means, but does not relight by itself.\n\nTo feel comfortable, Tolides shuns the heat and light of fires almost as much as he avoids sunlight, and he uses this spell to extinguish flames even from afar. It also comes in handy for affecting the sources of light of those who depend on flames to see in the dark.\n\n(Base 4, +3 Sight)"
    }

    #t156f2596f4db41f8c0fd92 ^"Cloak of Darkness" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +3 Sight, +1 Diam, +1 Part, free cosmetic effect)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeIg 20 R: Sight, D: Diam, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "All light around the head of the target is completely extinguished, leaving the victim mobile and unhampered, but engulfed in a tight-fitting cloak of darkness — an aurora of opaque, black flame that moves with the target for the duration of the spell. The target is blind, unless affected by a spell that permits the caster to see in complete darkness, such as Eyes of the Bat.\n\n(Base 3, +3 Sight, +1 Diam, +1 Part, free cosmetic effect)"
    }

    #tca46341171092d17c1bb76 ^"Orb of Darkness" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +2 Voice, +1 Diam, +1 Part, +1 Size)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Part"
            ^"Printed Stat Line" STRING "PeIg 20 R: Voice, D: Diam, T: Part"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "This spell represents a larger variant of the Cloak of Darkness, and removes all light from the designated target area. The effect manifests in the form of a irregular sphere of writhing darkness that contains everything within three paces of the affected target. Anyone inside the affected space is effectively blind. To see through the area from either side, a spell that permits the target to see in complete darkness, like Eyes of the Bat, is required.\n\nThe spell must be targeted at an object, individual, or other specific point in space. This location functions as a focus for the effect only, as the spell targets the light within the Part of space surrounding the focus, rather than the focus itself. Thus, the spell does not have to penetrate the Magic Resistance of anyone inside the target area, but only the resistance of the focus. If it fails to penetrate, the spell fails. If the focus is an individual or object that moves, the created darkness moves along with it. For example, if the spell is cast on a pebble, and that pebble is thrown into a lake, the blob of darkness will sink to the bottom.\n\n(Base 3, +2 Voice, +1 Diam, +1 Part, +1 Size)"
    }

    #t11f7acd0a1a345b605d35b ^"Abyssal Touch" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 4, +2 Voice, +1 Diam, +2 Group)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeIg 25 R: Voice, D: Diam, T: Group"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "For two minutes, all members of the affected Group are thoroughly chilled. Living targets lose one Fatigue level per round until they fall unconscious, while objects are considered frozen. The chill does not persist long enough to actually damage living targets.\n\nIn Tolides’ version of this spell, dark vapor emerges from the ground near the designated Group and engulfs the affected targets. The apparition does not physically constrict the victims, and does not block their senses, but keeps chilling them for the duration of the spell.\n\n(Base 4, +2 Voice, +1 Diam, +2 Group)"
    }

    #tfb8629c1cd804d680b5b7d ^"Domain of Darkness" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 2, +1 Touch, +4 Year, +4 Boundary, +2 Size)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Bound"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "PeIg 45 R: Touch, D: Year, T: Bound, Ritual"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "This ritual creates a domain of darkness in the designated Boundary, which can cover an area with a diameter of nearly 1000 paces. No natural light that is brighter than a soft evening glow is ever shed within its Boundary, regardless of the season or time of day. Due to the continuous lack of sun, the whole area becomes cold and uncomfortable for living beings. Warm air from outside is not actively resisted, but almost never reaches the center of the domain. Even fires created by mundane or magical means appear weak, and only dimly lit. Plants within the Boundary turn to leafless caricatures of life sooner or later. Note that a Boundary requires a well-defined border, such as the tree line of a grove, the cliffs of a steep valley, or the shore of an island.\n\nA brief note on the specific use of this spell that should not to be mistaken for traits or side-effects of the spell itself: The area affected by *Domain of Darkness* provides a haven for all creatures that shun the light. It represents Tolides’ latest attempt to establish some sort of abode in a domain of his own. Because the affected Boundary is inhabited by a practicing diabolist, and the ritual needed to cast the spell is often powered by Infernal vis, the aura of the Boundary slowly but steadily accumulates more and more traits of Infernal Warping. For example, animals that stay inside the domain for an extended period of time are likely to turn into Corrupted Beasts — repellent aberrations of nature (*Realms of Power: The Infernal*, page 77). One day, the affected Boundary might even become a regio of its own, which is exactly what Tolides has planned.\n\n(Base 2, +1 Touch, +4 Year, +4 Boundary, +2 Size)"
    }

    #t894e43393ddb278a520b63 ^"Chamber of Muffled Passing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base 3, +1 Touch, +1 Diam, +2 Room)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Room"
            ^"Printed Stat Line" STRING "PeIm 15 R: Touch, D: Diam, T: Room"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "For the duration of two minutes, all sound inside the affected Room, regardless of its origin and volume, is completely muted. The spell affects mundane actions, such as creaking floor boards or shouting, in much the same way as spell casting that requires a voice.\n\nDue to his Quiet Magic, this limitation doesn’t impair Tolides much, unless he wants to cast an additional spell with Range Voice while inside the Room, or to affect a target across the threshold. In Tolides’ version of the spell, the affected Room is slightly tainted by darkness. Semi-translucent patches of murk slowly crawl along the walls of the Room, greedily devouring all sound from within or outside. Tolides is not very creative when it comes to finding names for his creations, and doesn’t care much about the ambiguous name of this spell that also describes the silenced deaths of those in the chamber whom Tolides decides to kill.\n\n(Base 3, +1 Touch, +1 Diam, +2 Room)"
    }

    #tf281f93443ba7a62a95718 ^"Chastise the Unruly Fiend" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base effect, +2 Voice, free cosmetic effect)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 10
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi 10 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 133
        }
        DESCRIPTION "The effect of this reinvented spell is practically equivalent to The Demon’s Eternal Oblivion, though its cosmetic component makes it appear somewhat differently.\n\nA black tentacle, similar to a writhing whip, lashes out from the caster’s palm to hit the targeted Infernal creature, reducing its Infernal Might score by 10 points. Brought close to destruction, a demon can be punished, and forced to obey, or at least to take the caster seriously. Note that the caster must be able to perceive or sense a demon to target it, and the spell must penetrate its Magic Resistance to take effect.\n\n(Base effect, +2 Voice, free cosmetic effect)"
    }

    #tca3a806ad449552bcc3c36 ^"Belittle the Ferocious Warlock" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Spell Design" STRING "(Base effect (4), +3 Sight, +1 Diam)"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "PeVi 20 R: Sight, D: Diam, T: Ind"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "Upon penetrating the Magic Resistance of the target, the spell reduces the casting total of the affected victim by 5 levels. The evocation does not hinder the movement or senses of the target in any way, but merely affects all magic that is cast. Note that this spell must be fast cast if it is supposed to take effect before the opponent can act in the first round. (See ArM5, pages 83 and 87.)\n\nIn Tolides’ version of the spell, it appears as if the target is trapped in a dark cocoon of semi-transparent, wildly writhing vapor.\n\n(Base effect (4), +3 Sight, +1 Diam)"
    }

}
