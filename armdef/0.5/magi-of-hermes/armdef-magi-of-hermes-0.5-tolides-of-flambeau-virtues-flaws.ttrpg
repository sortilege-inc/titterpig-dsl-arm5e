EXTENSION "ARMDef_Magi_of_Hermes_TolidesOfFlambeau_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fourteen: Tolides of Flambeau virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t340fd571c6e0a0f2f11a3e ^"See In Darkness" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Supernatural"
            ^"Printed Name" STRING "New Virtue: See In Darkness"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "You can see in complete darkness much the same as those with Strong Faerie Blood. Other than that, your eyesight is not more acute than ordinary people’s, and you do not see farther than normal people would see in daylight."
    }

    #t521c08143fbcd75b958d2c ^"Immunity To Cold" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Supernatural"
            ^"Printed Name" STRING "New Virtue: Immunity To Cold"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "Normal cold does not harm you, nor does it make you feel uncomfortable. You don’t need warm environments to remain healthy (see Aging in **ArM5**, page 170).\n\nExtreme, magically created cold, such as the effect of *Wizard’s Icy Grip* (**ArM5**, page 142), still affects you normally."
    }

    #t4213e34d95141379aa7433 ^"Susceptibility To Sunlight" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Kind" STRING "Minor, Supernatural"
            ^"Printed Name" STRING "New Flaw: Susceptibility To Sunlight"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "Direct, bright sunlight causes you noticeable pain and exhausts you. Attuned to darkness, your eyes are very sensitive, and you suffer from a –2 penalty to all rolls involving sight in bright environments such as a cloudless day. Due to your malediction, you lose one Fatigue level per Diameter if outdoors at noon on a hot summer day, and lose levels more slowly in less-intense light and warmth from the sun."
    }

}
