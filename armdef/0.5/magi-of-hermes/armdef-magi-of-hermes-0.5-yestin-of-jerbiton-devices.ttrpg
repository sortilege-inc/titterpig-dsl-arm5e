EXTENSION "ARMDef_Magi_of_Hermes_YestinOfJerbiton_Devices" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fifteen: Yestin of Jerbiton devices"
    VERSION "0.5.3"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t9c59b0f0642117cb00c939 ^"An Instant Roof" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Cloak of Wilderness Refuge"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 5, +1 Conc; +5 item maintains concentration)"
            ^"Printed Effect Line" STRING "MuAn 15 R: Per, D: Conc, T: Ind Pen +0, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        DESCRIPTION "When triggered, the cloak expands and reforms into a large tent complete with tent-poles (formed from the polished bone toggle used to fasten the cloak) to keep it rigid. The tent is large enough to allow three to camp inside in relative comfort. The effect is triggered and canceled by a train of tongue-twisting words in Welsh.\n\n(Base 5, +1 Conc; +5 item maintains concentration)"
    }

    #taed8d6a06a6e19b52b98b9 ^"Store the Song in Stone" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Song Stones"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 3
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Charged Item, 1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Diameter, +1 intelligible speech)"
            ^"Printed Effect Line" STRING "CrIm 3 R: Per, D: Diameter, T: Ind Charged Item, 0 Penetration, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        DESCRIPTION "This spell captures a song or other music sung while a small stone is enchanted, and imprisons it within. The song is of a quality equal to the creator’s Communication + Music total, and is always of a tone and content chosen by the creator. The creator can freely change the “voice” that sings with each stone, but must make a Finesse roll as described in ArM5, page 143, to determine how accurately he can mimic a known voice other than his own.\n\nWhen the stone is asked to sing or to speak its message, the song is freed and its music can be heard. Once the song is released, it becomes ephemeral and cannot be recaptured unless by some other magic. The stone becomes just another stone.\n\n(Base 1, +1 Diameter, +1 intelligible speech)"
    }

    #t510c16769e0936477c8964 ^"Neither Rock nor Steel" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Spear of Lleu"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 26
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Part, +2 Base Metal; +11 Penetration)"
            ^"Printed Effect Line" STRING "PeTe 26 R: Touch, D: Mom, T: Part Pen +22, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        DESCRIPTION "This Perdo Terram effect is able to destroy rock or metal on contact, and is what gives the weapon its name. According to legend, Lleu Llaw Gyffes, seeking revenge on Gronw Pebr for attempting to kill him with a spear, allowed Gronw to hold a great rock between him and Lleu’s spear. But so hard did Lleu throw his spear that it tore through the rock and killed Gronw where he stood.\n\nThe effect is triggered by being plunged into metal armor. The target armor is instantly weakened, rusting and fracturing in the blink of an eye, and the spear pierces the armor and ignores its contribution to Soak. Against subsequent attacks, the armor has its Soak bonus reduced to half.\n\nThe Target for this spell is Part, allowing it to affect a quantity of material equivalent to Individual, even where the whole is larger than a standard Individual — a great giant’s stone armor for instance.\n\n(Base 3, +1 Touch, +1 Part, +2 Base Metal; +11 Penetration)"
    }

    #tee88aa94de55b569bca1fb ^"The Telling Blow" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Spear of Lleu"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "PeCo 34 R: Touch, D: Mom, T: Ind Pen +22, 6/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        DESCRIPTION "Also enchanted into the Spear of Lleu, this effect inflicts a Heavy Wound on a human or humanoid target of up to Size +1. It is triggered when the blade comes into contact with a target and the haft is twisted in the wielder’s hands. The blade does not have to draw blood, meaning that great care must be taken when carrying this weapon.\n\n(base 15, +1 Touch; +3 6/day, +11 Penetration)"
    }

    #tdabd73d2add034fa236d1c ^"A Song to Banish the Darkness" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Crwth of Yestin"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 41
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 20, –1 Conc, +2 Room; +5 item maintains concentration, +11 Penetration)"
            ^"Printed Effect Line" STRING "ReVi 41 R: Touch, D: Conc, T: Room Pen +22, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        DESCRIPTION "When so instructed, the crwth plays a warding melody that fills the room and prevents creatures of the Infernal from entering. The effective level of the ward is 20, and it uses a Penetration of 22. Creatures within the room when the melody plays are not expelled from the room, but nor can they willingly leave.\n\nThe song is incidental to the effect, and Yestin is able to quiet the song by concentrating. This does not end the effect, and the music can be restarted again by concentrating. The crwth maintains concentration on the effect, and “sings the song” independently of any other music it produces.\n\n(Base 20, –1 Conc, +2 Room; +5 item maintains concentration, +11 Penetration)"
    }

    #tcda0bb569ce68cfc9dbe87 ^"A Song to Banish the Impish" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Crwth of Yestin"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 41
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 20, –1 Conc, +2 Room; +5 levels item maintains concentration, +11 Penetration)"
            ^"Printed Effect Line" STRING "ReVi 41 R: Touch, D: Conc, T: Room Pen +22, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 144
        }
        DESCRIPTION "As A Song to Banish the Darkness, but works on creatures aligned to the Faerie Realm.\n\n(Base 20, –1 Conc, +2 Room; +5 levels item maintains concentration, +11 Penetration)"
    }

    #t63fa5eb497394e8a7f0d81 ^"A Song to Banish the Mystical" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Crwth of Yestin"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 41
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 20, –1 Conc, +2 Room; +5 item maintains concentration, +11 penetration)"
            ^"Printed Effect Line" STRING "ReVi 41 R: Touch, D: Conc, T: Room Pen +22, 1/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 144
        }
        DESCRIPTION "As A Song to Banish the Darkness, but works on creatures aligned to the Magic Realm.\n\n(Base 20, –1 Conc, +2 Room; +5 item maintains concentration, +11 penetration)"
    }

    #t325073fe7551828de0a4dc ^"Your Voice and Mine" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Crwth of Yestin"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 1, +1 Conc, +1 intelligible speech; +4 12/day, +5 item maintains concentration, +3 effect restricted to Yestin)"
            ^"Printed Effect Line" STRING "CrIm 15 R: Per, D: Conc, T: Ind Pen +0, 12/day"
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 144
        }
        DESCRIPTION "This effect is restricted such that only Yestin is able to trigger it.\n\nThis effect allows the crwth to join its voice with Yestin’s. The crwth sings in harmony with Yestin, as Yestin himself plays and sings. The effect is designed to produce intelligible words. These usually follow Yestin’s own words but on some occasions, and for reasons Yestin does not know, the crwth changes words and tone and emphasis. These changes are always in keeping with the song, and serve to enhance the performance rather than detract from it.\n\nThe best explanation Yestin has heard for this phenomenon is that perhaps a Twilight experience also affected the crwth. Any magus able to explain why the crwth sings so independently would have Yestin’s thanks, and may perhaps gain a deeper insight into the nature of enchanted devices.\n\nAdelbert the Tyrolean, a Bonisagus of some standing at Yestin’s covenant, suggested that a supernatural agent may have been present in Yestin’s laboratory when the effect was instilled, and that perhaps this caused the Warped effect. Yestin is unsure how much the Tyrolean suspects about Taliesin, but is disinclined to have others disturb his laboratory in search of evidence of faerie involvement.\n\n(Base 1, +1 Conc, +1 intelligible speech; +4 12/day, +5 item maintains concentration, +3 effect restricted to Yestin)"
    }

}
