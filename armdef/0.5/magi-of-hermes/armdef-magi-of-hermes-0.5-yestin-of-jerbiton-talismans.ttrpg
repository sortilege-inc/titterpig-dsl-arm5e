EXTENSION "ARMDef_Magi_of_Hermes_YestinOfJerbiton_Talismans" {
    NAME "Ars Magica Fifth Edition, Magi of Hermes - Chapter Fifteen: Yestin of Jerbiton talismans"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-08"
    DEPENDS_ON "ARMDef_Magi_of_Hermes_Core_Ext"

    # The chapter's talismans, structured; each DESCRIPTION the source's text, verbatim.

    #te7fcb5b2f44ab936aa6c16 ^"Crwth of Yestin" DEF {
        EXTENDS #td7ced4f60ac4664256d622 ^"Talisman"
        PROPERTIES {
            ^"Printed Name" STRING "Talisman: Crwth of Yestin"
            ^"Owner" STRING "Yestin of Jerbiton"
            ^"Table Columns" LIST ["Bonus", "Attunement", "Shape or Material", "Heading"]
            ^"Source" STRING "Magi of Hermes"
            ^"Page" INTEGER 143
        }
        TABLE {
            "+3" "create sounds" "" "Attunements"
            "+5" "affect music" "" "Attunements"
            "+4" "protection against malicious magic" "" "Attunements"
            "+1" "Vim" "" "Attunements"
        }
        DESCRIPTION "Yestin’s talisman is his crwth and bow, a form of welsh harp played either with a bow or by plucking the strings. It was inevitable that his treasured crwth would become his talisman. A gift from his mater, the crwth has been with him since before his Gauntlet and its music has been a constant companion.\n\nIts attunements are as per the lyre and rowan wood. These are all Yestin currently knows of, but he is keen to find out whether the crwth contains more magical sympathies that are currently hidden from him. He may one day seek out a specialist in the field so he can further attune his talisman."
    }

}
