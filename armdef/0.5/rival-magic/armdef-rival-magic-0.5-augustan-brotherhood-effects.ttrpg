EXTENSION "ARMDef_Rival_Magic_AugustanBrotherhood_Effects" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Three: Augustan Brotherhood effects"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Rival_Magic_Core_Ext"

    # The chapter's effects, structured; each DESCRIPTION the source's text, verbatim.

    #t153f9c79ff18b658d8fd91 ^"“So he speaks, and swifter than his words, he calms the swollen sea”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Boreas"
            ^"Ease Factor" INTEGER 24
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Effect Design" STRING "(Base 9, Sun +6, Boundary +9)"
            ^"Printed Stat Line" STRING "School of Boreas, Ease Factor 24, ritual R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "Designed by Tomas of Sicily, this rite wards a bay against the wind, and activates when invaders threaten. So for example it might be cast to trigger when “Genoan warships enter the bay,” leaving them becalmed and allowing defenses to be prepared.\n\n(Base 9, Sun +6, Boundary +9)"
    }

    #t619d3816b27d43ce4b2fa9 ^"“Then a dark-blue rain cloud settled overhead”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Boreas"
            ^"Ease Factor" INTEGER 24
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "City"
            ^"Effect Design" STRING "(Base 9, Sun +6, City +9)"
            ^"Printed Stat Line" STRING "School of Boreas, Ease Factor 24, ritual R: Touch, D: Sun, T: City"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "When a fire breaks out and consumes a house, extremely heavy rain begins to fall, extinguishing the blaze before catastrophe engulfs the city. Fire is a very real danger in medieval cities, so this rite is extremely useful to any ruler. Like all city rites, it must be designed for a specific city.\n\n(Base 9, Sun +6, City +9)"
    }

    #t136fe82ff215998de53627 ^"“We wandered uncertainly, in a dark fog”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Boreas"
            ^"Ease Factor" INTEGER 24
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "City"
            ^"Effect Design" STRING "(Base 9 , Sun +6, City +9)"
            ^"Printed Stat Line" STRING "School of Boreas, Ease Factor 24, ritual R: Touch, D: Sun, T: City"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "Another of Tomas’ rites, this was designed to deal with urban unrest in Palermo. When triggered by rioting in the city, it causes an impenetrable fog to spring up within the walls, ending the violence in the ensuing confusion. Like all city rites it must be designed for a specific city.\n\n(Base 9 , Sun +6, City +9)"
    }

    #t10c0e4c2fb9f79336d2a18 ^"“We’ve confidence in the waves, and the winds grant us calm seas”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Boreas"
            ^"Ease Factor" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 18, Sun +6, Structure +6)"
            ^"Printed Stat Line" STRING "School of Boreas, Ease Factor 30 R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 57
        }
        DESCRIPTION "Wards a ship against gale-force winds, triggered when the ship first encounters them. If the storm lasts beyond sunrise or sunset the ship may still be lost, and the rite does not prevent loss of the ship to wave action, but this rite is still very potent and is cast upon important vessels before they leave harbor. The ship must use a sea anchor, be grounded, or be otherwise immobile for the duration of the rite — if the ship moves significantly from its position, the rite ends. It is often employed with a casting of the rite *Break the Stormy Sea*.\n\n(Base 18, Sun +6, Structure +6)"
    }

    #t541f6ef65aa4adfc4b60f1 ^"Pentagram of Warding Against Water" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Naiads"
            ^"Ease Factor" INTEGER 18
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base 12 , Ring +6)"
            ^"Printed Stat Line" STRING "School of the Naiads, Ease Factor 18 R: Touch, D: Ring, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Wards all within the pentagram against mundane water.\n\n(Base 12 , Ring +6)"
    }

    #tc6bdebd3190c6196b2b108 ^"“It is best now to calm the raging waves”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Naiads"
            ^"Ease Factor" INTEGER 24
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 12, Sun +6, Structure +6)"
            ^"Printed Stat Line" STRING "School of the Naiads, Ease Factor 24 R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Wards a ship against wave action, triggered when the ship first encounters a severe storm. If the storm lasts beyond sunrise or sunset the ship may still be lost, and the rite does not prevent loss of the ship to gales, but this rite is still very potent and is cast upon important vessels before they leave harbor. Importantly, the ship remains stationary unless driven by the wind, and if the ship moves the rite ends. It is often employed with a casting of the rite *“We’ve confidence in the waves, and the winds grant us calm seas”* for this reason.\n\n(Base 12, Sun +6, Structure +6)"
    }

    #t7c415c29c42c5805961ef5 ^"“We had set our course there when stormy Orion, rising with the tide, carried us onto hidden shoals”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Naiads"
            ^"Ease Factor" INTEGER 24
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Effect Design" STRING "(Base 9 , Sun +6, Boundary +9)"
            ^"Printed Stat Line" STRING "School of the Naiads, Ease Factor 24, ritual R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "When an enemy fleet enters the harbor, a fast-running current springs up expelling the ships from the bay.\n\n(Base 9 , Sun +6, Boundary +9)"
    }

    #tcb3144f16efc102b77edf5 ^"“I am him whom you see scouring the banks, with my full stream”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Naiads"
            ^"Ease Factor" INTEGER 27
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Effect Design" STRING "(Base Ease Factor 15, Sun+6, Boundary +9)"
            ^"Printed Stat Line" STRING "School of the Naiads, Ease Factor 27, ritual R: Touch, D: Sun, T: Boundary"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "This rite is cast upon river banks where they pass through a city, and activates as the river rises to a certain point, when it wards against water and prevents the river from overflowing its banks.\n\n(Base Ease Factor 15, Sun+6, Boundary +9)"
    }

    #t27f3a3bc7e2c8676524e4b ^"““Then in truth all Ilium seemed to collapse in flames”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Prometheus"
            ^"Ease Factor" INTEGER 12
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 6, Diameter +3, Room +3)"
            ^"Printed Stat Line" STRING "School of Prometheus, Ease Factor 12 R: Touch, D: Diam, T: Room"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "This protective rite requires a large hearth fire, and is placed upon a room. If someone enters without giving the correct password, the fire immediately rushes across the room at him, hopefully igniting his clothes and doing normal damage.\n\n(Base 6, Diameter +3, Room +3)"
    }

    #t45f9553696ec3080994fda ^"He enters among them, veiled in shadows”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Prometheus"
            ^"Ease Factor" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 6, Diameter +3, Structure +6)"
            ^"Printed Stat Line" STRING "School of Prometheus, Ease Factor 15 R: Touch, D: Diam, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Taking an idea from *The Aeneid* where Aeneas, wrapped in shadows, moves through Carthage to his first fateful meeting with Dido, this rite greatly but subtly dims all light within a building, adding +3 to Stealth rolls. The triggering action is usually when the intruder wraps his cloak around himself.\n\n(Base 6, Diameter +3, Structure +6)"
    }

    #tb70efbbf86821037cfa5ec ^"Virgil’s Vengeance" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of Prometheus"
            ^"Ease Factor" INTEGER 36
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "City"
            ^"Effect Design" STRING "(Base 21, Sun +6, City +9)"
            ^"Printed Stat Line" STRING "School of Prometheus, Ease Factor 36, ritual R: Touch, D: Sun: T: City"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 59
        }
        DESCRIPTION "Mimicking one of Virgil’s best known magical feats, this rite extinguishes all fires in a city when triggered, until sunset or sunrise. It can be used to fight the fires that endanger medieval cities, or to plunge an entire city into darkness. Like all City rites it must be designed for a specific city.\n\n(Base 21, Sun +6, City +9)"
    }

    #tb100c069715ccdc56738db ^"Pentagram Against Swords" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Stones"
            ^"Ease Factor" INTEGER 24
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base 12, Ring +6, metal +6)"
            ^"Printed Stat Line" STRING "School of the Stones, Ease Factor 24 R: Touch, D: Ring, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Wards everyone in the Pentagram against swords. This rite is triggered when someone attempts to strike someone in the Pentagram with a sword.\n\n(Base 12, Ring +6, metal +6)"
    }

    #tc8f61fe2d17fda62a3c840 ^"“And snatched his gleaming sword from the sheath”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Stones"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 12, Diameter +3, Structure +6, metal +6)"
            ^"Printed Stat Line" STRING "School of the Stones, Ease Factor 27 R: Touch, D: Diam, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Wards everyone in the structure against daggers. This rite is triggered when someone attempts to strike someone else in the building with a knife or dagger.\n\n(Base 12, Diameter +3, Structure +6, metal +6)"
    }

    #t8f1a44592d030b6a384093 ^"“Trojan walls, famous in war!”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Stones"
            ^"Ease Factor" INTEGER 30
            ^"Ritual" BOOLEAN true
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "City"
            ^"Effect Design" STRING "(Base 12, Sun+6, City+9, stone +3)"
            ^"Printed Stat Line" STRING "School of the Stones, Ease Factor 30, ritual R: Touch, D: Sun, T: City"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Causes besieger’s rock projectiles to drop short of the city walls by warding the city against mundane stone. Activates when a stone missile strikes the warded area, the city. One shot is rarely enough to do serious damage.\n\n(Base 12, Sun+6, City+9, stone +3)"
    }

    #ta2c686aa20103018dcd224 ^"Pentagram to Ward the Woodland Dryads" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Sylvan Dryads"
            ^"Ease Factor" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base 15)"
            ^"Printed Stat Line" STRING "School of the Sylvan Dryads, Ease Factor 15 R: Touch, D: Ring, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The Pentagram prevents any action against those inside from faeries of Might 15 or less. (Base 15)"
    }

    #t93b50c109a144b0a785a46 ^"Bici’s Secured Dwelling" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Sylvan Dryads"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 15, Sun +6, Structure +6)"
            ^"Printed Stat Line" STRING "School of the Sylvan Dryads, Ease Factor 27 R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "If a certain phrase is shouted, the building’s doors and shutters all slam shut, with a Strength equal to the caster’s score in School of the Sylvan Dryads. They open only for those who know the correct password, for the duration of the rite.\n\n(Base 15, Sun +6, Structure +6)"
    }

    #ta9c57732870ed73e7b7d10 ^"Pentagram Against Corrupted Beasts" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Vigilant Bees"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base General)"
            ^"Printed Stat Line" STRING "School of the Vigilant Bees, General R: Touch, D: Ring, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The pentagram wards against all animals with an Infernal Might that is less than the rite’s Ease Factor. It activates when such an animal tries to cross the boundary of the pentagram, and it prevents any action by the beast affecting those within, including spell effects and ranged attacks.\n\n(Base General)"
    }

    #t77109aef6f3116e0696852 ^"Pentagram Against Wolves" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Vigilant Bees"
            ^"Ease Factor" INTEGER 3
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base 3)"
            ^"Printed Stat Line" STRING "School of the Vigilant Bees, Ease Factor 3 R: Touch, D: Ring, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Wards all within against mundane wolves. Note this is far more specific than the Hermetic equivalent, *Circle of Beast Warding*, but it is a trivially easy rite for anyone with School of the Vigilant Bees. Of course you have to have learned the correct rite for the animal currently troubling you!\n\n(Base 3)"
    }

    #t8e2c2842ce5d7b890487e3 ^"Pentagram to Terrify the Enemy’s Horse" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Vigilant Bees"
            ^"Ease Factor" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Pentagram"
            ^"Effect Design" STRING "(Base 12,: Diameter+3)"
            ^"Printed Stat Line" STRING "School of the Vigilant Bees, Ease Factor 15 R: Touch, D: Diam, T: Pentagram"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "The pentagram has no effect until crossed by a horse, at which point the horse is overcome with utter terror and bolts, unless a Ride roll against an Ease Factor of 12 is made each round, possibly throwing the rider. This rite illustrates the ability to activate a magical effect by breaking a ward, and to use pentagrams with Durations other than Ring.\n\n(Base 12,: Diameter+3)"
    }

    #t38899ad97f7268ad996ca5 ^"“Even the air is unkind to the birds, and they plunge headlong”" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Augustan Brotherhood"
            ^"Spell Type" STRING "Vigilo Rite"
            ^"Arts" STRING "School of the Vigilant Bees"
            ^"Ease Factor" INTEGER 24
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 3, Arcane Connection+9, Sun+6, Structure +6)"
            ^"Printed Stat Line" STRING "School of the Vigilant Bees, Ease Factor 24 R: Arc, D: Sun, T: Structure"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Tomas invented this rite after Frederick’s favorite falcon flew off during hawking. The triggering condition is “if the hawk is not in the head falconer’s house at midnight.” The hawk then develops a strong desire to return home (bringing something to the warded area), a mental suggestion that remains until sunrise.\n\n(Base 3, Arcane Connection+9, Sun+6, Structure +6)"
    }

}
