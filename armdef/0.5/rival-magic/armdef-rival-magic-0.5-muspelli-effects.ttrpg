EXTENSION "ARMDef_Rival_Magic_Muspelli_Effects" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Four: Muspelli effects"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Rival_Magic_Core_Ext"

    # The chapter's effects, structured; each DESCRIPTION the source's text, verbatim.

    #t5ac86b0136145d21456084 ^"The Witch’s Thrall" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Entrancement"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Decade"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(base 15, +12 Decade)"
            ^"Printed Stat Line" STRING "Entrancement Ease Factor 27 R: Eye, D: Decade, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The designated target becomes the servant of the Muspelli for ten years. The Muspelli can make any innocuous, questionable, or dangerous request of the target during this period, but any heinous or suicidal request ends the enslavement. Note that the intent need not be heinous, just the request; a warrior thrall who is commanded to kill an enemy who happens to be his brother throws off the effect even if the Muspelli is unaware of their relationship.\n\n(base 15, +12 Decade)"
    }

    #t9034fb20bbaae9c5d08f91 ^"An Axe Age, a Sword Age" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Entrancement"
            ^"Ease Factor" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Until (death occurs)"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 18, +3 Voice, +9 Until, +6 Group, +9 size)"
            ^"Printed Stat Line" STRING "Entrancement Ease Factor 45 R: Voice, D: Until (death occurs), T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "A whole city of people, up to a thousand people, are turned to murder. Each person turns upon the nearest person and attempts to kill him; but if the nearest person is a loved one, then that target is immediately freed from the compulsion.\n\nOtherwise, the effect ends only when the person has killed at least one other.\n\n(Base 18, +3 Voice, +9 Until, +6 Group, +9 size)"
    }

    #tf5ee8bb3cbe49ee22fb277 ^"Grettir’s Death Curse" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Hex"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 24, +3 week delay)"
            ^"Printed Stat Line" STRING "Hex Ease Factor 27 R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 95
        }
        DESCRIPTION "The mighty hero Grettir was slain by this foul curse, cast by his enemy’s motherin-law through driftwood carved with evil runes. Within a week the victim contracts a dreadful case of gangrene from an apparently minor scratch. The festering ulcer starts small, but it relentlessly worsens until it is an Incapacitating illness. The character thus cursed must recover from Incapacitation (**ArM5**, page 179), and then recover from the illness normally.\n\n(Base 24, +3 week delay)"
    }

    #t33771c143cfaa5400c1cde ^"Scion of Fafnir" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Shapeshifter"
            ^"Ease Factor" INTEGER 33
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 27, +6 Size)"
            ^"Printed Stat Line" STRING "Shapeshifter Ease Factor 33 R: Per, D: Conc, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "The Muspelli turns into a dragon that is 6 Size points larger than the biggest animal form he can adopt as part of the Shapeshifter Ability. He has the same game statistics as that animal form, except it has a +12 to Strength, a –6 to Quickness, and has the wound increments appropriate to a creature of his new Size. He can choose up to three points of powers, and can exchange 1 point of powers for 2 qualities.\n\n(Base 27, +6 Size)"
    }

    #t85eb69bd7815d6d165f524 ^"Vision of Glaesisvellir" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Sjonhverfing"
            ^"Ease Factor" INTEGER 42
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Boundary"
            ^"Effect Design" STRING "(Base 24, +6 Boundary, +12 to affect four extra senses)"
            ^"Printed Stat Line" STRING "Sjonhverfing Ease Factor 42 R: Voice, D: Sun, T: Boundary"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 96
        }
        DESCRIPTION "Alters the appearance of an entire valley to make it a place of bliss and tranquility. The dale is filled with flower-strewn meadows and fields filled with golden grain, and warm sunshine appears to replace whatever weather was present before (although characters still suffer the ill effects of the real weather, they don’t notice it). Birds sing exultant songs, and everything seems at peace. Glaesisvellir is a paradise in the underworld, where the truly blessed dwell after death.\n\n(Base 24, +6 Boundary, +12 to affect four extra senses)"
    }

    #t7fd93b9b23566d0958e6cd ^"Uncover the Witch" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Spadomur"
            ^"Ease Factor" INTEGER 21
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 9, +9 Moon, +3 proper noun)"
            ^"Printed Stat Line" STRING "Spadomur Ease Factor 21 R: Arc, D: Moon, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "The visions induced by this *utiseta* pertain to the identity of the individual who laid a curse on another within the last month. A distinctive feature of the malefactor (such as a single eye, or a certain color) appears in the vision, allowing the character to recognize him when they meet.\n\n(Base 9, +9 Moon, +3 proper noun)"
    }

    #t9b7217eeb34b12c871bd6d ^"Voluspa" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Spadomur"
            ^"Ease Factor" INTEGER 33
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Lifetime"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 9, +18 Lifetime, +6 lengthy explanation)"
            ^"Printed Stat Line" STRING "Spadomur Ease Factor 33 R: Arc, D: Lifetime, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "The “Volva’s Prophecy” reveals a vision of Ragnarok to the character. From this vision, she may determine whether, at this point in time, her actions have brought the world closer to its fiery end or not. Casting the *Voluspa* allows the character to see the likely outcome of events she herself has set in motion. This is as close to delving into the future as a mortal Muspelli can achieve.\n\n(Base 9, +18 Lifetime, +6 lengthy explanation)"
    }

    #t75880fc24438e192ac9e35 ^"Theft of Thor’s Thunder" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Storm’s Eye"
            ^"Ease Factor" INTEGER 21
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 9, +6 Sight, +6 for thunder and lightning)"
            ^"Printed Stat Line" STRING "Storm’s Eye Ease Factor 21 R: Sight, D: Sun, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "The principal purpose of this *utiseta* is to put the reins of the lightning into the hands of the Muspelli. For every 3 points of his Storm’s Eye Ability, he can direct one bolt of lightning against any target he can see; requires the Dexterity + Finesse roll described earlier. Each does +30 damage should it hit.\n\n(Base 9, +6 Sight, +6 for thunder and lightning)"
    }

    #td9947cf20c8cd0b3fdf7a7 ^"Beating of Hraesvelg’s Wings" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Storm’s Eye"
            ^"Ease Factor" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 15, +6 Sight, +3 Moon, +6 size)"
            ^"Printed Stat Line" STRING "Storm’s Eye Ease Factor 30 R: Sight, D: Moon, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 98
        }
        DESCRIPTION "A whole region is laid waste in a month-long gale. This can be devastating to the prosperity of a coastal town; a month of trade is lost, along with a good proportion of their ships. Hraesvelg is a name given to the jotun Gymir in his eagle form.\n\n(Base 15, +6 Sight, +3 Moon, +6 size)"
    }

    #t21c39ce9f7bf7b46096b30 ^"The Corpse-Plague" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Summon Animals"
            ^"Ease Factor" INTEGER 15
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 9, +6 Sun)"
            ^"Printed Stat Line" STRING "Summon Animals Ease Factor 15 R: Sight, D: Sun, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 99
        }
        DESCRIPTION "Creates millions of maggots from a patch of soil. So many vermin are created that the Muspelli’s score in Summon Animals makes little impact; maggots are Size –15. The maggots expand in all directions from their point of origin at three paces per hour, so at the end of the Duration they could cover an area nearly 80 paces across with a solid carpet of writhing, corpse-white worms. Once the Duration expires no new maggots will appear, but the existing ones continue to wriggle away from their point of origin. Any edible material within the infested area will be consumed.\n\n(Base 9, +6 Sun)"
    }

    #t3c0f90bd6c40623546770f ^"Spawn of Jormungand" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Summon Animals"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 27)"
            ^"Printed Stat Line" STRING "Summon Animals Ease Factor 27 R: Sight, D: Mom, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 99
        }
        DESCRIPTION "Summons a Lindwurm (see *Realms of Power: Magic*, page 78) from a river, the sea, or a burial mound. The Lindwurm is a legless dragon with a Magic Might of 13 and Size +5; the Muspelli must therefore have a Summon Animals score of at least 8 to attempt this *utiseta*.\n\n(Base 27)"
    }

    #t6bdf3115c7ff4bc7b5d885 ^"Empty the Ironwood" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Summon Animals"
            ^"Ease Factor" INTEGER 33
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 24, +3 Arc, +6 size)"
            ^"Printed Stat Line" STRING "Summon Animals Ease Factor 33 R: Arc, D: Mom, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 99
        }
        DESCRIPTION "Summons werewolves with a Magic Might of 10 and Size 0. The caster must have a Summon Animals of at least 3 to employ this *utiseta*; his Summon Animals score should be treated as 2 higher when determining the number arriving, and they may arrive in human or wolf form. The Ironwood is a mythical location where werewolves are amassing numbers in preparation for Ragnarok.\n\n(Base 24, +3 Arc, +6 size)"
    }

    #tfd38853446da84e6819368 ^"Blink of Fate" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Threads of Fate"
            ^"Ease Factor" INTEGER 21
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 12, +9 Sight)"
            ^"Printed Stat Line" STRING "Threads of Fate Ease Factor 21 R: Sight, D: Moon, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "The caster imposes the Spindle’s Wobble on his target, who must be within Range: Sight. It is often used to affect a battle between the caster and his foe. With a suitable vantage point, this relatively easy *utiseta* can often be completed as an enemy approaches.\n\n(Base 12, +9 Sight)"
    }

    #t4ce1d8764179c23691cfdd ^"Calamitous Fortune" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Threads of Fate"
            ^"Ease Factor" INTEGER 30
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 18, +12 Arc)"
            ^"Printed Stat Line" STRING "Threads of Fate Ease Factor 30 R: Arc, D: Moon, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "The caster curses the target with a Warped Fortune. She can affect anyone to whom she has an Arcane Connection, but must specify the event as usual. She can predetermine the types of action affected by each use of this thread; or else, if she can see the target, she can choose it at any time.\n\n(Base 18, +12 Arc)"
    }

    #t446e21cfd201201940ffb1 ^"An Army of the Dead" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Valgaldrar"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 15, +3 Sun, +6 Group, +3 size)"
            ^"Printed Stat Line" STRING "Valgaldrar Ease Factor 27 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "In *Gongu-Hrolfs Saga*, the wizard Grimur raises the dead soldiers of his employer every night so that they can wage war against his foe every day. He is eventually prevented by the dwarf Mondull, who protects them from being affected by valgaldrar. This *utiseta* effect duplicates Grimur’s power by raising up to 100 slain soldiers.\n\n(Base 15, +3 Sun, +6 Group, +3 size)"
    }

    #tf82075ce61b05c10b72adc ^"Death Begets Death" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Valgaldrar"
            ^"Ease Factor" INTEGER 33
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 24, +6 Moon, +3 for a total of nine Virtue points)"
            ^"Printed Stat Line" STRING "Valgaldrar Ease Factor 33 R: Touch, D: Moon, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 102
        }
        DESCRIPTION "Raises a dauding with a Magic Might of 18 and the following Virtues: Greater Immunity to Edged Weapons, Shapeshifter; Arcane Lore (used to gain a Shapeshifter score of 4), Tough, Reserves of Strength. It was designed by a Muspelli for the purpose of killing a rival.\n\n(Base 24, +6 Moon, +3 for a total of nine Virtue points)"
    }

    #tf967275288c1117248c82c ^"Surtlogi" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Wildfire"
            ^"Ease Factor" INTEGER 24
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 15, +3 Conc, +6 Group)"
            ^"Printed Stat Line" STRING "Wildfire Ease Factor 24 R: Voice, D: Conc, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "The caster trails a fire behind him, spreading it to anything within Voice Range. While he maintains concentration, he moves like a living firebrand and can set a whole forest (or town) alight simply by walking through it. He has no control of the fires he sets, and if he is not careful he can easily block off his own route of escape. The *surtlogi* is the fiery brand that Surtur will carry at Ragnarok, which will consume the world in its purifying flame.\n\n(Base 15, +3 Conc, +6 Group)"
    }

    #tc6deea9e4ae519d7b129c8 ^"Fetid Breath of the Earth-Fires" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Wildfire"
            ^"Ease Factor" INTEGER 39
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Bound"
            ^"Effect Design" STRING "(Base 21, +6 Sun, +12 Boundary)"
            ^"Printed Stat Line" STRING "Wildfire Ease Factor 39 R: Voice, D: Sun, T: Bound"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Causes a crack in the earth to let forth smoke poisoned by the earth-fires. Everyone within the target area suffers a Medium wound if they fail a Stamina roll of Ease Factor 9. Furthermore, everybody within the target — even those who succeed in their Stamina roll — is nauseated and suffers a –3 penalty to all actions. The vapors linger for a day before they disperse.\n\n(Base 21, +6 Sun, +12 Boundary)"
    }

    #t5990244bb6853b9dcdbf5c ^"Surtur’s Mighty Exhalation" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Wildfire"
            ^"Ease Factor" INTEGER 51
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Bound"
            ^"Effect Design" STRING "(Base 30, +3 Sight, +12 Boundary, +6 size)"
            ^"Printed Stat Line" STRING "Wildfire Ease Factor 51 R: Sight, D: Mom, T: Bound"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Causes a volcano to erupt. Everyone within Sight Range of the fire mountain (including the caster) must make a Stamina stress roll of 9+ or be deafened by the resounding crack of the exploding mountain. If deafened, a character can make a Stamina simple roll every minute against the same Ease Factor to recover his hearing. The explosion hurls boulders several miles; the chances of an individual character being hit by a boulder is small, but larger structures and settlements are in immediate peril of being destroyed. A cloud of poisonous smoke is the next emission from the volcano; anyone downwind of the mountain within Sight Range can be swallowed by the superheated vapors, which inflict +15 fire damage as well as the same effects as *Fetid Breath of the Earth-Fires*, above. As if these effects were not bad enough, mighty rivers of molten rock spill from all sides of the volcanic crater to envelope anything remaining on the mountain’s sides.\n\n(Base 30, +3 Sight, +12 Boundary, +6 size)"
    }

    #tfa102f703f6087f04ec271 ^"The Fimbulwinter" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Winter’s Breath"
            ^"Ease Factor" INTEGER 27
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 12, +9 Year, +6 size)"
            ^"Printed Stat Line" STRING "Winter’s Breath Ease Factor 27 R: Voice, D: Year, T: Ind"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "A region the size of a small town is trapped in perpetual snow. In places this will drift into snow banks about four feet high, but the level of exposure is mild. If cast during the winter, this effect lasts for a full year. Crops automatically fail if agricultural land is affected; livestock produce just one quarter of their usual productivity. The fimbulwinter (“mighty winter”) is one of the first heralds of Ragnarok.\n\n(Base 12, +9 Year, +6 size)"
    }

    #tcb6c2774332f7792bc1b32 ^"Sea-borne Castles of Ice" DEF {
        EXTENDS #td931d483daa342b4ebd03c ^"Rival Magic Effect"
        PROPERTIES {
            ^"Tradition" STRING "Muspelli"
            ^"Spell Type" STRING "Utiseta Effect"
            ^"Arts" STRING "Winter’s Breath"
            ^"Ease Factor" INTEGER 36
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 21, +6 Moon, +9 Group)"
            ^"Printed Stat Line" STRING "Winter’s Breath Ease Factor 36 R: Voice, D: Moon, T: Group"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 104
        }
        DESCRIPTION "Creates icebergs that float according to the local currents. This Ease Factor creates one iceberg at Size +15, ten at Size +12, a hundred at Size +9, and so forth. A small ship is typically Size +9, the same as Target: Structure. The icebergs cause a major hazard to shipping, and double the journey times of all sea-borne travel through the region. Incautious captains who stray too close are in danger of losing their ships, and on average two ships will be lost every month that the icebergs remain around a moderately busy port.\n\n(Base 21, +6 Moon, +9 Group)"
    }

}
