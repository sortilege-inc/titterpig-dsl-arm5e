EXTENSION "ARMDef_Rival_Magic_Muspelli_Qualities" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Four: Muspelli qualities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Rival_Magic_Core_Ext"

    # The chapter's qualities, structured; each DESCRIPTION the source's text, verbatim.

    #t0493fce4d4a2e7fc8bdf13 ^"Aquatic (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Aquatic"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character can breathe water."
    }

    #t5b52de87cc59431b5b18a5 ^"Camouflage (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Camouflage"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+3 to all rolls to hide whenever the character is not moving."
    }

    #tb9cb1d70bac8d827170bcc ^"Claws (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Claws"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character has huge talons that she can use in combat. These are Brawl weapons that have the following statistics: Init +0, Atk +4, Dfn +3, Dam +4"
    }

    #tc1b06ffa9c79280fd77c83 ^"Constriction (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Constriction"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character has a long sinuous body or muscular tail, and can constrict an opponent whose Size is less than her own. Constriction is based on the grappling rules (**ArM5**, page 174). The Attack Total is computed using the Brawl skill, and a constriction attack has the following weapon statistics: Init 0, Atk +3, Dfn 0, Dam n/a. As long as the character maintains the grapple, her opponent is considered deprived of air (see **ArM5**, page 180). The victim must make a Stamina check every 30 seconds (that is, every five rounds), or suffer the normal effects of deprivation. Once the character has successfully grappled an opponent (and begun constricting), on subsequent rounds she can continue constricting and still attack with other weapons. These attacks may be directed at the grappled victim, or at another opponent. **Fast Runner:** +3 to all rolls involving running."
    }

    #t4429810f0b587fb62ec208 ^"Fins (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Fins"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "No penalties to actions taken underwater"
    }

    #t76377dde5050bf4e41c0ee ^"Good Jumper (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Good Jumper"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+3 to all rolls involving jumping."
    }

    #t21aad141fa27e84aba86f9 ^"Keen Sense of Smell (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Keen Sense of Smell"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+3 to all rolls using the sense of smell, +2 to all Hunt rolls."
    }

    #tbfde55f1885fb04a6f9d57 ^"Horns/Antlers (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Horns/Antlers"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character has either a set of antlers or a pair of horns (such as those of a ram or a bull) that she can use in combat. These are Brawl weapons that have the following statistics: Init +2, Atk +3, Dfn +2, Dam +3"
    }

    #t8bdbda8d982318d0ee9fc5 ^"Shell (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Shell"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character is encased in a protective shell. This grants a +6 to Protection, but the character suffers a –3 to all rolls involving fast or nimble movement. This does not stack with any other Qualities that provide Protection, and the character cannot wear armor."
    }

    #t6001e73c61823ff0912ea2 ^"Skilled Climber (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Skilled Climber"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+3 to all rolls involving climbing."
    }

    #ta0fa5b46441772b2876c63 ^"Slippery (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Slippery"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character has a +6 to Defense rolls against Grapple attacks. This Quality may be taken more than once, and the bonus rises by +3 each additional time it is taken."
    }

    #t300b587a624d5c115f8651 ^"Spiny (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Spiny"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character is covered in spines; these grant a +1 bonus to Protection. If any opponent strikes at a Spiny character with a bite, claw, or fist attack, he inflicts damage as normal, but suffers +5 damage in return. Some characters may poison their spines (see Venomous, later); in which case the attacker’s own Attack Advantage is used against him to determine the success of the Venom attack only."
    }

    #t167e25407a70eed5a0ba30 ^"Teeth (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Teeth"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character has huge fangs or tusks that she can use in combat. These are Brawl weapons that have the following statistics: Init +0, Atk +4, Dfn +2, Dam +5"
    }

    #t425bfd97d9a3f9f65315bb ^"Tireless (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Tireless"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "The character gains two extra Fatigue levels."
    }

    #tc0ba9e88713e82c73a6667 ^"Thick Fur/Thick Scales (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Thick Fur/Thick Scales"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+1 to Protection; this Quality stacks with the Tough Virtue and the Tough Hide Quality."
    }

    #tebe23eddba084e02fbb48a ^"Tough Hide (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Tough Hide"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "+2 to Protection; this Quality stacks with the Tough Virtue and the Thick Fur Quality."
    }

    #tdfc5b0ae2b45fda805c3aa ^"Venomous (Quality)" DEF {
        EXTENDS #t2ac5f4ca4cbe2a528fb261 ^"Animal Quality"
        PROPERTIES {
            ^"Printed Name" STRING "Venomous"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 84
        }
        DESCRIPTION "One of the character’s attacks (usually the bite) also delivers venom into the wound. Compare the Attack Advantage to the victim’s Protection (not Soak). If the character’s advantage is higher, then the victim suffers the effect of the venom, regardless of whether the bite inflicts an actual wound. The venom can be of one of two strengths (chosen when Quality is taken) — the character can chose from either: a venom that inflicts a Light Wound if a Stamina roll with an Ease Factor of 12 is failed; or one that inflicts a Medium Wound but has an Ease Factor of 9 to avoid the effects. This Quality may be taken more than once: each additional time increases the severity of the wound inflicted or adds three to the Ease Factor to avoid the effects."
    }

}
