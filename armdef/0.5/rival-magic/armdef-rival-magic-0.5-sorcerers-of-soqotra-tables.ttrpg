EXTENSION "ARMDef_Rival_Magic_SorcerersOfSoqotra_Tables" {
    NAME "Ars Magica Fifth Edition, Rival Magic - Chapter Five: Sorcerers of Soqotra tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Rival_Magic_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t3af857379cee375c03197b ^"A Table of Comparisons (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Range, Duration, or Target", "Hermetic Equivalent for Level Calculation", "How Far? How Long? Who or What?"]
            ^"Printed Name" STRING "A Table of Comparisons"
            ^"Source" STRING "Rival Magic"
            ^"Page" INTEGER 125
        }
        TABLE {
            "Scent" "Voice" "As far as the smell of burning incense travels."
            "Censer" "Diameter" "As long as the censer burns."
            "Regrowth" "Diameter" "Permanent after an extended delay."
            "Perpetual" "Year" "Until destroyed"
            "Incense" "One below Individual" "Incense and tools for incense harvesting."
            "Incensed" "Group" "Stuff touched by the smoke of the sorcerer’s incense."
        }
    }

}
