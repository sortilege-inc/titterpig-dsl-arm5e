EXTENSION "ARMDef_RoP_Divine_BlessedByGod_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Three: Blessed By God virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Divine_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #tbdc16066a6eb00f4905c31 ^"Adjuration" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "ADJURATION"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This Virtue allows you to command and control supernatural beings; you begin with the Supernatural Ability Adjuration 1."
    }

    #tbb3b704fa7b8df9b6f0efc ^"Blessing (Realms of Power: The Divine)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "BLESSING"
            ^"Printed Name" STRING "Blessing"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "Through Blessing, you can invoke the protective and inspirational aspects of the Divine. Taking this Virtue grants you the Supernatural Ability Blessing 1."
    }

    #tb338fb6e27b6cc05476c1e ^"Ceremony (Realms of Power: The Divine)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "CEREMONY"
            ^"Printed Name" STRING "Ceremony"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural Ability"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This Ability allows you to focus a group of people on holy prayer, concentrating their efforts and thus making it possible for them to bring about greater holy effects together. This gives you the Supernatural Ability Ceremony 1."
    }

    #t792c7478c83097641e0a13 ^"Cursing (Realms of Power: The Divine)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "CURSING"
            ^"Printed Name" STRING "Cursing"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "With this Virtue, you can curse those who oppose the Divine Will, giving you the Supernatural Ability Cursing 1."
    }

    #t3c009bcd14bff055a5c4ae ^"Holy Magic" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "HOLY MAGIC"
            ^"Size" STRING "Major"
            ^"Category" STRING "Hermetic Supernatural Ability"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This Virtue is only available to characters with The Gift. You did not learn Magic Theory; instead, you begin with the Supernatural Ability Holy Magic 1, and all of your spells are specially adapted to your divine focus. You also have a poor reputation within the Order of Hermes at level 3 as a hedge wizard.\n\nSee Holy Magic, later in this chapter, for other restrictions and benefits of this sort of magic."
    }

    #tfd6e6e4e47be7b11a1864b ^"Intervention" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "INTERVENTION"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "God occasionally gives guidance to the world through signs and wonders and the power of divine intervention. Taking this Virtue grants you the Supernatural Ability Intervention 1, which allows you to bring about similar effects."
    }

    #t5898be3bd2acb4a6b62b84 ^"Invocation" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "INVOCATION"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Method"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This Virtue gives you Invocation 1, a Supernatural Ability that allows you use the Holy Method of Invocation and roll a stress die for miraculous effects."
    }

    #t0585032fa92301acd5bc0c ^"Meditation" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "MEDITATION"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Method"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "This gives you the Supernatural Ability Meditation 1, which you may use with your holy powers to gain insight into the Divine through the Holy Method of Meditation."
    }

    #t9e4188a4456d540a6cf61c ^"Blood of the Nephilim" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "BLOOD OF THE NEPHILIM"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 34
        }
        DESCRIPTION "You have the blood of angels in your veins and descend from the great heroes of the Antediluvian Age, the Nephilim. Unless you take the Mythic Companion\n\nvirtue, your heritage is somewhat diluted, although still significant.\n\nYour size is increased to +1, and this increases by +1 for every century you are alive.\n\nYou may learn Dominion Lore during character creation without needing to take the Arcane Lore Minor Virtue.\n\nYou age incredibly slowly, and may live for thousands of years. You need make an aging roll only once every ten years after the age of 150, and receive a –5\n\nto Aging Rolls. You gain no benefit from Longevity Potions or any magic or supernatural power that slows or relieves Aging or Decrepitude. Once you gain your first Decrepitude Point, it becomes increasingly difficult for you to learn new things: subtract your age ÷ 10 from all Advancement Totals , although the Advancement Total for a season cannot drop below 1.\n\nDue to your great size, you must eat vast amounts of food (equal to what three normal people would eat in a day), and have the Minor Personality Flaw Greedy. If you go without food for even a single day you fall into a deep slumber, a kind of supernatural hibernation. You will starve to death in (2 + your Divine Might) days unless you are fed your own body-weight in food. (Note that this Virtue does not itself grant Divine Might; see Strong Angelic Heritage, below.) After awakening, you suffer a number of lost Long Term Fatigue Levels equal to the number of days you went without food.\n\nYou may not take The Gift or True Faith, Hermetic Virtues or Flaws, Methods or Powers, Virtues such as Giant, Mythic, or Faerie Blood, Flaws such as Age Quickly or Lycanthrope, or Virtues or Flaws that affect your size. Magi and Grogs may not take this virtue."
    }

    #t7728034e9f62efb624bd91 ^"Powerful Relic" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "POWERFUL RELIC"
            ^"Size" STRING "Major"
            ^"Category" STRING "General"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "You own an unusually powerful relic with a Faith score of 3. The relic also has one power, which should be agreed upon with the storyguide (see Relics, below). As with the Minor General Virtue Relic, the item may be built into any other item that you possess, like a sword or a pendant.\n\nOwning such a powerful relic is a great responsibility, and your character should behave in an appropriate manner. If you ever behave impiously (as judged by the storyguide) your relic will cease to function until suitable penance is made."
    }

    #tb37720fe6f458ddde9847d ^"Purity" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "PURITY"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Method"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "Taking this Virtue gives you Purity 1. This Supernatural Ability allows you to use the Holy Method of Purity with your holy powers to bring about miraculous effects."
    }

    #t36ec25f78206e9a3f433c6 ^"Strong Angelic Heritage" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "STRONG ANGELIC HERITAGE"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 35
        }
        DESCRIPTION "Your angelic heritage is purer, granting you a Divine Might score and supernatural powers. This virtue may only be taken if you have the Greater Virtue Blood of the Nephilim.\n\nYou are a divine being and possess a Divine Might (Corpus) score equal to your age divided by 20, which increases as you grow older. This grants you a Magic Resistance score. You contain a number of pawns of Corpus vis equal to your Divine Might divided by 10 (but always at least one pawn) that can only be extracted if you are dead. You are also immune to Warping of any sort.\n\nYou have up to thirty levels of holy powers that may be invoked by spending\n\nMight points. Design the powers’ effects using the Holy Powers or Hermetic spell guidelines. The Might cost for each power is equal to its magnitude divided by two (but always at least one point). The initiative score of the power is your Quickness.\n\nYou may take this virtue multiple times. Each additional time you take it increases by thirty the number of levels of holy powers you may invoke, but has no other effect; in particular, it does not increase your Divine Might."
    }

    #t6bc42b7fa65d54021c4fa6 ^"Transcendence" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "TRANSCENDENCE"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "This power allows you to overcome the limitations of the physical world, improving your body and mind through miraculous effects. Taking this Virtue gives you the Supernatural Ability Transcendence 1."
    }

    #t7a8356a707ca7502485005 ^"Understanding" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "UNDERSTANDING"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You can glean understanding of the Divine plan through this power, which gives you the Supernatural Ability Understanding 1."
    }

    #ta3858e1be3cefbdc70b3ca ^"Wonders" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "WONDERS"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural Power"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You begin with the Supernatural Ability Wonders 1, which allows you to conjure holy items, creatures, and the elements at God’s Will."
    }

    #tb6170a593fae8dec043eca ^"Apostate" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "APOSTATE"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You have converted from one faith to another or from one set of beliefs to another. You have a bad reputation at 4 among members of your previous faith, and you may receive some slight distrust from your new faith as well, depending upon how sincere your conversion seems."
    }

    #t46aa3faf7714e23d293718 ^"Eremite" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "EREMITE"
            ^"Size" STRING "Major"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You do not belong to a holy tradition, as you prefer to explore the mysteries of the divine on your own. You cannot learn Supernatural Abilities from any tradition, favored or not, as you already have your own ideas about influencing the supernatural fixed in your philosophy. You must have True Faith to take this Flaw."
    }

    #te9e7d35e32bf760f84d5c0 ^"Non-Traditional" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "NON-TRADITIONAL"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You do not belong to a holy tradition, as your practices and beliefs are too unusual to be classified by an overarching philosophy. You may still learn Supernatural Abilities from other holy characters who are willing to teach you, though always with a penalty to your Advancement Total — you do not have any favored Abilities. You must have True Faith to take this Flaw."
    }

    #td52817842200d817ede4cf ^"Raised from the Dead" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "RAISED FROM THE DEAD"
            ^"Size" STRING "Major"
            ^"Category" STRING "Story Supernatural"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 36
        }
        DESCRIPTION "You died, and were brought back to life through a holy miracle. You begin with at least three Warping points, plus one Warping point for every year that has passed since you were resurrected, and you automatically receive another Warping point every year you continue living. You also have a level 4 reputation in the area where the miracle occurred. You do not remember what happened to you while you were dead, although you may have virtuous impulses that you cannot explain."
    }

}
