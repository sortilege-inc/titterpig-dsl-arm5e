            ^"Personality Trait" STRING "Greedy +2, Ruthless +1, Fair –1"
            ^"Reputations" STRING "Jew 3 (Christians), Protected by Muqta’ of Baghdad 3 (Merchants)"
            ^"Combat" STRING "Dodge: Init +0, Attack N/A, Defense +0, Damage N/A Fist: Init +0, Attack +0, Defense +0, Damage +0 Knife: Init +0, Attack +1, Defense +0, Damage +2"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
