            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Sofer; Educated (Hebrew), Gossip, Puissant Scribe; Gabai; The Evil Eye, Outsider (Minor, Jew),"
            ^"Personality Trait" STRING "Inquisitive +2, Dedicated +1"
            ^"Reputations" STRING "Jew 2 (Christians), Tax Collector 2 (York Jews), Gossip 1 (York Jews)"
            ^"Combat" STRING "Dodge: Init +0, Attack N/A, Defense +1, Damage N/A Fist: Init +0, Attack +4, Defense +2, Damage +0 Bludgeon: Init –1, Attack +5, Defense +1, Damage +2"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Aramaic 3 (written), Area Lore 2 (collecting taxes), Art of Memory 3 (Torah), Artes Liberales 3 (grammar), Awareness 2 (in his workshop), Bookbinding 2 (preparing Torah scrolls), Brawl 1 (fist), Carouse 1 (games of chance), Charm 2 (apologizing), Concentration 3 (scribing), Local Language 5 (storytelling), Hebrew 4 (written), Illumination 3 (Sefer Torah), Judaic Lore 3 (poetry), Percamenarius 3 (Sefer Torah), Scribe 4 (Sefer Torah), Theology: Judaism 2 (scripture)"
            ^"Equipment" STRING "Scribe’s tools, tax ledgers and accounts"
            ^"Notes" STRING "Unfortunately, this sofer’s ability as a scribe is often overlooked in favor of his roles as community tax collector and local gossip. And because of this, most people think, correctly, that he must bear the evil eye. So if anything goes wrong, he’s bound to get the blame. The Sofer’s multiple Social Statuses are compatible."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 139
        }
    }

    #t8752258b2ba0491c03e417 ^"Ba’al Shem (template)" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Printed Name" STRING "BA’AL SHEM"
            ^"Characteristics" STRING "Int 0, Per 0, Pre +1, Com +2, Str 0, Sta 0, Dex +2, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "26 (26)"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Ba’al Shem;Adjuration, Blessing, Invocation; Craft Amulets; Magical Air, Outsider (Major, Jew), Supernatural Nuisance (faeries of the road); Carefree"
            ^"Personality Trait" STRING "Cheerful +3, Helpful +1, Honest +1"
            ^"Reputations" STRING "Jew 2 (Christians)"
            ^"Combat" STRING "Dodge: Init +0, Attack N/A, Defense +1, Damage N/A Fist: Init +0, Attack +3, Defense +1, Damage +0 Bludgeon: Init –1, Attack +6, Defense +2, Damage +2"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Adjuration 3 (assisting Jews), Area Lore: Home County 2 (roads), Athletics 1 (running), Blessing 3 (houses), Brawl 1 (bludgeon), Carouse 2 (games of chance), Charm 2 (first impressions), Chirurgy 3 (setting bones), Craft Amulets 4 (Adjuration), Folk Ken 3 (townsfolk), Local Language 5 (storytelling), Hebrew 4 (talking with rabbis), Invocation 3 (Blessing), Judaic Lore 2 (folklore), Penetration 1 (Adjuration), Theology: Judaism 1 (folklore), Tinker 4 (pans)"
            ^"Equipment" STRING "Tinker’s tools, handcart, Jewish hat, weather-beaten traveling cloak with a Jewish symbol emblazoned upon it."
            ^"Notes" STRING "This Ba’al Shem travels from community to community around Bremen working his wonders for pay and the benefit of his people. He is frequently on the road and tries not to look too harshly on those gentiles who mock him as he passes. The faeries, on the other hand, are a trial that he just can’t stand."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 140
        }
    }

