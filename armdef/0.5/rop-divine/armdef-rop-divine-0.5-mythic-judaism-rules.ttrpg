EXTENSION "ARMDef_RoP_Divine_MythicJudaism_Rules" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Six: Mythic Judaism rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Divine_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t2e55374dcbe199f24aa84f ^"Craft Minor Amulet Total" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "CRAFT MINOR AMULET TOTAL"
            ^"Rules Section" STRING "CRAFT AMULETS"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 137
        }
        FORMULAS {
            "CRAFT MINOR AMULET TOTAL" "Dexterity + Craft Amulets + Shape and Material Bonus + Dominion Aura Bonus"
        }
    }

    #t987e391266afd57b90a67e ^"Craft Major Amulet Total" DEF {
