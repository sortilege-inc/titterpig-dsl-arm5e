EXTENSION "ARMDef_RoP_Divine_MythicJudaism_SacredTexts" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Divine - Chapter Six: Mythic Judaism sacred texts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Divine_Core_Ext"

    # The chapter's sacred texts, structured; each DESCRIPTION the source's text, verbatim.

    #t7826cb239e8edc8d0576ca ^"The Torah" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE TORAH"
            ^"Book" STRING "Summa Theology: Judaism (Level 6, Quality 8), Summa Judaic Lore (Level 4, Quality 8), Summa Rabbinic Law (Level 4, Quality 8)"
            ^"Author" STRING "Dictated by God to Moses on Mount Sinai."
            ^"Availability" STRING "Any synagogue or yeshivah."
            ^"Special Rule" STRING "The *Sefer Torah* is the complete work in its original scroll form. The sefer, created according to ritual and custom, is treated as a relic with one Faith Point."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The *Torah* is the first section of the collected *Tanakh*, or Hebrew Bible. It contains Genesis, the account of creation; Exodus, the escape of the Jewish people; and Leviticus, Numbers, and Deuteronomy, which tell more of the Jews in the wilderness, and of the law."
    }

    #t8cd931a5a42c51328ad29c ^"The Talmud" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE TALMUD"
            ^"Book" STRING "Summa Judaic Lore (Level 6, Quality 8), Summa Theology: Judaism (Level 6, Quality 8), Summa Rabbinic Law (Level 6, Quality 8), Tractatus Canaan Lore (Quality 5)"
            ^"Author" STRING "Compiled from various sources from the 2nd through 6th centuries, but originating with the oral *Mishnah* given to Moses on Mount Sinai."
            ^"Availability" STRING "Any synagogue or yeshivah."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This work consists of 63 “tractates” containing 613 Mitzvot and is the codification of Rabbinic Law, applying the Biblical commandments and teachings to everyday life.\n\nThe *Talmud* also contains folklore and culturally important material: stories, medicinal remedies, myths, and legends. Collectively, these non-religious tracts are termed *aggadah*.\n\nThe *Talmud* is originally an Aramaic work but is most commonly translated into Hebrew."
    }

    #t9fb89578166a5a0880b909 ^"The Nevi’im" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE NEVI’IM"
            ^"Book" STRING "Tractatus Theology: Judaism (Quality 8), Tractatus Dream Interpretation (Quality 8)"
            ^"Author" STRING "Compiled from various sources from the 6th through 2nd centuries BC."
            ^"Availability" STRING "Any synagogue or yeshivah."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The *Nevi’im,* or *Prophets*, is divided into two sections covering the early prophets and the later prophets. The first section describes the history of the Jewish people from the time of Joshua to the Babylonian Exile. The second section is devoted to prophecies, some of which may have come to pass and others that might yet.\n\nThe *Nevi’im* is the second section of the collected *Tanakh*, or Hebrew Bible."
    }

    #t1f6f10cf0fcd0133123bd0 ^"The Ketuvim" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE KETUVIM"
            ^"Book" STRING "Tractatus Dream Interpretation (Quality 8), Tractatus Judaic Lore (Quality 8), Tractatus Rabbinic Law (Quality 8)"
            ^"Author" STRING "Compiled from various sources by the 2nd century AD."
            ^"Availability" STRING "Any synagogue or yeshivah."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "The *Ketuvim*, or *Writings*, is a disparate work of wisdom, poetry, prophecies, and history and as such is treated as a collection of tractatus.\n\nThe *Ketuvim* is the final section of the collected *Tanakh*, or Hebrew Bible."
    }

    #tcbaefe9f923ff39b741540 ^"The Mishneh Torah" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE MISHNEH TORAH"
            ^"Book" STRING "Summa Rabbinic Law (Level 4, Quality 9)"
            ^"Author" STRING "Rabbi Moses Ben Maimon (Maimonides)"
            ^"Availability" STRING "This work is spreading to synagogues and yeshivot across Mythic Europe, originating in Iberia."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This is the foremost authority on Rabbinic Law, providing the most complete interpretation on the laws by which the Jewish people should govern all aspects of life. These laws are divided into the mishpatim, or judgments, and the huqqim, or statutes, which includes instructions and provisions for ritual purity."
    }

    #ta18cf0e72dc537bcfba373 ^"Guide to the Perplexed" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "GUIDE TO THE PERPLEXED"
            ^"Book" STRING "Summa Philosophiae (Level 4, Quality 9), Summa Theology: Judaism (Level 6, Quality 9)"
            ^"Author" STRING "Rabbi Moses Ben Maimon (Maimonides)"
            ^"Availability" STRING "The private libraries of many Rabbis and philosophers, particularly around the Mediterranean."
            ^"Special Rule" STRING "Students with scores of 3 or more in Gematria may study this book as a Tractatus of Quality 8 on Gematria."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "This complex work presents a philosophical view of the Jewish faith, examining the mundane world through the tenets of faith. Maimonides purposefully obscured the text, inserting ambiguities and contradictions that distract the uneducated student. But these ambiguities find use when applied to the study of Gematria, and many truths are revealed to those who seek them."
    }

    #t692b4439fb1d3c71ab8b79 ^"Sefer Yetzirah" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "SEFER YETZIRAH"
            ^"Book" STRING "Summa Kabbalah (Level 4, Quality 6)"
            ^"Author" STRING "The Biblical Abraham"
            ^"Availability" STRING "The private libraries of those who practice Kabbalah."
            ^"Special Rule" STRING "Only once a kabbalist has studied the *Sefer Yetzirah* can he undertake to create a golem."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This *Book of Creation* is a key text for those studying Kabbalah and is the principle text of the Ma’asei-Bereshit school of philosophy, which seeks knowledge of the foundations of all creation. It is the source for the ten Sefirot and the 22 pathways that connect them, and it shows how the world is created from the 22 characters of the Hebrew alphabet. It also draws parallels between the Sefirot and the human form, representing it as a divine microcosm, which in turn reveals the mystery of the golem.\n\nThere have been innumerable commentaries written on the *Sefer Yetzirah*, mostly in Hebrew but increasingly in Arabic as the practice of Kabbalah grows in Muslim-ruled Iberia."
    }

    #tdabe36c873fa179d31f2e4 ^"Sefer Ha-Bahir" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "SEFER HA-BAHIR"
            ^"Book" STRING "Tractatus Kabbalah (Quality 8), Tractatus Ceremony (Quality 5)"
            ^"Author" STRING "Despite its antiquated style, this is the work of Provencal kabbalists practicing post-600."
            ^"Availability" STRING "The private libraries of those who practice Kabbalah."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This *Book of Illumination* expands upon the *Sefer Yetzirah*, taking the abstract kabbalistic principles and codifying them into practical knowledge. It is essentially the first true kabbalistic work outside the *Sefer Yetzirah*."
    }

    #t0730e1a031de078d11cdcf ^"Sefer Ha-Razim" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "SEFER HA-RAZIM"
            ^"Book" STRING "Tractatus Craft Amulets (Quality 8), Tractatus Merkavah (Quality 8), Tractatus Ceremony (Quality 5), Tractatus Dominion Lore (Quality 12)"
            ^"Author" STRING "Revealed to Noah by the angel Raziel."
            ^"Availability" STRING "The private libraries of those who practice Merkavah."
            ^"Special Rule" STRING "Hermetic magi who read this book for its knowledge on Craft Amulets gain access to the shape and material bonuses normally open to practitioners of this Jewish mystical practice (see later). Studying from an incomplete volume imposes a penalty of –1 to the reader’s Study Total."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This *Book of Amulets* concerns angels, angelic powers, and the astral forces that they control. But there is also a list of incantations and enchantments of value to those who craft amulets and charms. The book exhorts the reader to perform all acts of magic in a state of the utmost ritual purity, and describes the correct preparation and treatment of ritual implements, such as knives, lamps, incense, etc, and this provides insight into the Ceremony Ability.\n\nComplete copies of this book are rarely found, sections having been copied and obtained separately. The sections on Ceremony and Dominion Lore are often found translated from the original Hebrew."
    }

    #t60909b10b25d0a1a4e975e ^"Sefer Raziel" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "SEFER RAZIEL"
            ^"Book" STRING "Summa Gematria (Level 4, Quality 8), Summa Merkavah (Level 4, Quality 8), Summa Intervention (Level 4, Quality 8), Summa Transcendence (Level 4, Quality 8)"
            ^"Author" STRING "Revealed in its original form to Adam by the angel Raziel."
            ^"Availability" STRING "The private libraries of those who practice Gematria and Merkavah."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "This potent book of sorcery is principally concerned with astral forces, originating from the zodiac and the enumerated names of God. The *Sefer Raziel* in its current form is actually a collection of the tractates revealed to Adam by the angel Raziel and has been compiled in Provencal over the last two hundred years. Those reading this work may notice that there are abundant references to the practice of Craft Amulets, but it does not provide enough insight to work from. This suggests that the current work is incomplete."
    }

    #t62bc7326b6f29381604efa ^"The Hechalot Texts" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "THE HECHALOT TEXTS"
            ^"Book" STRING "Tractatus Merkavah or Summoning (Quality 8)"
            ^"Author" STRING "Various mystics from the age of the First Temple onwards."
            ^"Availability" STRING "Translations of these works can be found in mystical libraries across Europe and the East."
            ^"Special Rule" STRING "Studying the *Hechalot Texts* is a dangerous pursuit. Due to the frequent allusions and references to demons and demonic powers, any who study the *Hechalot Texts* alone gain a “Curious about the Infernal” Personality trait at +1."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "The *Hechalot Texts *are a collection of scrolls and books that together detail the art of *Ma’aseh Merkavah*, the ancient mystical tradition from which both Merkavah and the Goetic art of Summoning derive. There is no definitive list of works that make up the *Hechalot Texts* and more may yet be discovered in forgotten and abandoned libraries across Mythic Europe and the East."
    }

    #t321330c29150a942c2050e ^"Sword of Moses" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Printed Name" STRING "SWORD OF MOSES"
            ^"Book" STRING "Summa Infernal Lore (Level 5, Quality 8)"
            ^"Author" STRING "Anonymous Jewish magicians."
            ^"Availability" STRING "The private libraries of *Ba’al Shem*, Kabbalists, and the *Ba’al Ov*."
            ^"Special Rule" STRING "Studying the *Sword of Moses* for a season can be treated as a source of insight for researching and integrating the extinct magical form of Canaanite Necromancy (*Ancient Magic*, page 30)."
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 128
        }
        DESCRIPTION "A book of theurgistic magic that purports to list the names of angels, demons, and other spirits. This is an unusual work in that it eschews the expected ritual purity for witchcraft-like practices."
    }

    #te9a10bbf5383803e5cd97a ^"Sefer ha-Masa’ot" DEF {
        EXTENDS #t3e0e47fb287b14be04f6f3 ^"Sacred Text"
        PROPERTIES {
            ^"Book" STRING "Summa Mediterranean Lore (Level 4, Quality 8)"
            ^"Source" STRING "Realms of Power: The Divine"
            ^"Page" INTEGER 129
        }
        DESCRIPTION "Benjamin of Tudela wrote the *Sefer ha-Masa’ot* (*The Book of Travels*) to chronicle his journeys from Navarre to Jerusalem. Anyone studying this book may gain the specialty “Jewish communities” in this Area Lore, which helps to locate Jewish communities across the Mediterranean and the Levant. Written in Hebrew, copies can be found in larger Jewish communities."
    }

}
