                        "Lesser Power" -> #trycp5AY4LCEmvmCP10xvgWb ^"Lesser Power"
                        "Greater Power" -> #tO5XFGkxH39d8IsuOBi2cXBp ^"Greater Power"
                        "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                    }
                }
                ^"Glide" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "A renaming of the Flight power, this allows Sir Excelsis to move through the waters of the subaquatic kingdom as a flier would through air. This enables him to swim and fight at the same time, for example. It does, technically, still allow him to fly."
                }
                ^"Shift Human Shapes" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "Allows the champion to don or remove armor simply by willing it. (1 intricacy point to reduce cost)"
                }
            }
            DESCRIPTION "* Various weapons have been described here to speed customization. Unusual weapons that suit the motif or the court may use the scores above, with slicing weapons in lieu of swords and bashing weapons in lieu of maces. These statistics do not include the +5 Damage bonus the champion gains when using the Damaging Effect power, or the bonus of +3 to Attack and Defense gained when fighting mounted, or the +1 for fighting on the tourney field. They do include the effect of the Puissant Pretense Virtue in all cases, so if the champion is forced to swap away from his preferred weapon, he suffers a –2 penalty on the Attack and Defense scores listed above. ** Also includes +5 for Improved Damage. Equipment: Armor of magical scales of faerie iron. Lance with pennant and other weapons. Attendant as squire. Trappings marked with the burning fern motif. The champion’s glamor produces a faerie horse for him, which has the statistics given below for faerie horses, except that it shares his vis, Might, and Magic Resistance. As it is an extension of his glamor, the champion’s mount flies when he does. Sir Excelsis is the most powerful faerie knight in the White Lady’s kingdom. He is treated as a noble by the other faeries, despite his lack of Might. He is less physically imposing than her gigantic guards, due to his human appearance, but he has greater magical resistance, better equipment, and more Intelligence than they do."
            REFERENCES {
                "Damaging Effect" -> #t885Vlj2jC9rqq8xEP0AI5tP ^"Damaging Effect"
                "Puissant Pretense" -> #tJSsV9IueYlOnEBhX5Hga7R7 ^"Puissant Pretense"
                "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
            }
        }

        #tS6UU2fIOUfOeleanexEVpzX ^"Sprites" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Corpus"
                ^"Size" INTEGER -10
                ^"Characteristics" DEF {
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER -20
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 3
                    ^"Quickness" INTEGER 10
                }
                ^"Soak" INTEGER 6
                ^"Wound Penalties" STRING "Dead (1+)"
                ^"Vis" STRING "1 pawn Ignem, dead bug. In many other courts this would be Corpus."
                ^"Appearance" STRING "These faeries are tiny humanoid figures that can fly, a power they use to perform interesting feasts of gymnastics for their lords. They are armed with tiny bows, and prefer to attack in confusing swarms."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Power"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie"
                ^"Personal Power" OF "Flight" NOTE "or Faerie Ally"
            }
            FLAWS {
                ^"Narrowly Cognizant"
                ^"Little" TIMES 2
                ^"Oath of Fealty"
                ^"Traditional Ward" OF "smoke, in this case, or as per court"
            }
            PERSONALITY_TRAITS {
                "Loyal" +3
            }
            COMBAT {
                "Bow" INIT 8 ATTACK 12 DEFENSE 15 DAMAGE -12
            }
            ABILITIES {
                "Area Lore (court)" SCORE 5 SPECIALTY "intruders"
                "Athletics" SCORE 3 SPECIALTY "flight"
                "Awareness" SCORE 5 SPECIALTY "intruders"
                "Bow" SCORE 5 SPECIALTY "intruders"
                "Carouse" SCORE 1 SPECIALTY "feasts"
                "Charm" SCORE 1 SPECIALTY "as ambassadors"
                "Etiquette" SCORE 2 SPECIALTY "faerie"
                "Faerie Speech" SCORE 5
                "Hunt" SCORE 1 SPECIALTY "humans"
            }
            POWERS {
                ^"Cause Sickness" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "+9"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "(3 intricacy points spent on cost, 2 on initiative): This power usually causes strokes when used by sprites, but in this court, fevers are caused instead. The strike of a messenger’s arrow can cause this effect. Strokes have an Ease Factor of 6, but cause a Heavy wound. The fevers caused by these sprites have an Ease Factor of 9 and cause a Light wound."
                }
                ^"Flight" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                    }
                    DESCRIPTION "2 intricacy points reducing Might cost. (See Sir Excelsis for modifications to this power for the White Lady’s court.)"
                }
                ^"Damaging Effect Lesser Power" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "+4"
                    }
                    DESCRIPTION "(2 intricacy points on cost), Provides a mystical effect based on the court’s motif, that increases the damage of the messenger’s arrows by +5 for 2 minutes. Optional selection for a faerie that wishes to use magical arrows often, traded for its Greater Power (also Improved Damage Virtue +5 Damage and Improved Soak Virtue +2 Soak, retaining Personal Power (Flight))."
                    REFERENCES {
                        "Greater Power" -> #tO5XFGkxH39d8IsuOBi2cXBp ^"Greater Power"
                        "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                        "Improved Soak" -> #tH0x5tzyFFTxltyTlq6NrgCR ^"Improved Soak"
                        "Personal Power" -> #twVnpmKsGJtg08QxdZoxyf5O ^"Personal Power"
                    }
                }
            }
            DESCRIPTION "* Often used in conjunction with Grant Flaw, some other power, or poison. Equipment: Bow, jerkin with the mark of the burning fern. Some faeries of this type fly using mounts, purchased as the Faerie Ally Virtue, in lieu of the Fly power. They have Pretenses of 2 in Ride and 1 in Animal Handling, and lower their Athletics to 2 and their Etiquette to 1. The nobles of the court use these tiny faeries as envoys and saboteurs. Sprites also pose a danger when they attack in swarms."
            REFERENCES {
                "Animal Handling" -> #teWrQcCWtN9DNBmHrm2qAE9c ^"Animal Handling"
            }
        }

    #tE9tvZCsLwNtcYpFFe5Gj8Fr ^"Cailleach Bheur (Cally Berry)" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 40
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Auram"
                ^"Size" INTEGER 3
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 3
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER -3
                    ^"Communication" INTEGER 2
                    ^"Strength" INTEGER 5
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER -1
                }
                ^"Soak" INTEGER 1
                ^"Wound Penalties" STRING "–1 (1-8), –3 (9-16), –5 (17-24), Incapacitated (25-32), Dead (33+)"
                ^"Vis" STRING "8 or 10 Auram, a rotten plaid"
                ^"Appearance" STRING "The Cailleach Bheur has blueblack skin, like a corpse, and is hideously ugly. In some areas she turns to stone during the summer months."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Focus Power" TIMES 3
                ^"Greater Faerie Powers"
                ^"Increased Faerie Might" TIMES 7
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Form"
                ^"Large"
                ^"Time of Power" OF "winter"
            }
            FLAWS {
                ^"Restricted Might" OF "summer" SIZE "Major"
                ^"Improved Powers"
                ^"Incognizant"
                ^"Sovereign Ward" NOTE "summer turns her to stone"
            }
            PERSONALITY_TRAITS {
                "Cruel" +2
            }
            COMBAT {
                "Brawl (razor sharp fingernails)" INIT -1 ATTACK 7 DEFENSE 7 DAMAGE 7
            }
            ABILITIES {
                "Scotland Under The Snows Lore" SCORE 9 SPECIALTY "faerie auras"
                "Awareness" SCORE 6 SPECIALTY "distant events"
                "Bargain" SCORE 5 SPECIALTY "with questioners"
                "Brawl" SCORE 5 SPECIALTY "when ambushed"
                "Charm" SCORE 3 SPECIALTY "those who come with questions"
                "Faerie Speech" SCORE 5 SPECIALTY "gullible people"
                "Guile" SCORE 3 SPECIALTY "answering questions"
                "Penetration" SCORE 2 SPECIALTY "Focus Power (Ice)"
            }
            POWERS {
                #t7122890525a87b968f208f ^"Extend Glamour" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "the Cailleach Bheur's glamour is unusual in that it covers far more than a Boundary."
                }
                ^"Focus Power (Ice)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "up to 5 points"
                        ^"Initiative" STRING "–6"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "(3 points on Penetration)"
                }
                ^"Focus Power (Storms)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "up to 10 points"
                        ^"Initiative" STRING "–11"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION ""
                }
                ^"Spreading a Mantle of Snow" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–4"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "(2 intricacy points spent on cost). The hag pounds her staff — or mallet, in some areas — onto the ground so that it becomes hard and coated in ice."
                }
                ^"Conjuration of the Indubitable Cold" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–4"
                        ^"Form" STRING "Ignem"
                    }
                    DESCRIPTION "(3 intricacy points spent on cost). As the spell of the same name on ArM5 page 142."
                }
            }
            DESCRIPTION "In some areas, single creatures represent summer and winter. In many parts of Ireland and Scotland, for example, the winter is represented by the blue hag, the Cailleach Bheur. The blue hag is the guardian of the streams and wells, and the protectress of wolves, goats, deer, cattle, and many other animals. She washes her plaid at a particular spot until it is pure white, then spreads it over the land until summer, when her power passes to a rival. In ancient times this was often the goddess Brigid, but in other areas she keeps the summer as her prisoner. The Cailleach Bheur's glamour extends to much of the land, so she is aware of many important things happening in distant places. This ability makes her unsuitable as a player character in most sagas, but makes her a valuable ally to magi. Her equipment: Her plaid, which covers the land."
        }

        #titM71wWXUWegpn1bsbZydXy ^"Południca" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 10
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Auram"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 3
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 0
                ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+)"
                ^"Vis" STRING "2 pawns (scythe, Ignem)"
                ^"Appearance" STRING "This faerie may appear as a beautiful maiden, a crone, or an adolescent girl. She wears a white dress and carries a scythe or shears. She may travel as a dust devil, and is used as a nursery terror to frighten children so that they do not harm crops."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Powers"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie"
                ^"Increased Faerie Might"
                ^"Personal Faerie Powers" TIMES 2
            }
            FLAWS {
                ^"Incognizant"
                ^"Restricted Might" OF "winter" SIZE "Major"
                ^"Sovereign Ward" OF "running water"
                ^"Traditional Wards" OF "questions"
            }
            PERSONALITY_TRAITS {
                "Curious" +3
            }
            COMBAT {
                "Scythe" INIT 5 ATTACK 6 DEFENSE 6 DAMAGE 5
            }
            ABILITIES {
                "Awareness" SCORE 3 SPECIALTY "laziness"
                "Charm" SCORE 2 SPECIALTY "rural people"
                "Faerie Speech" SCORE 5 SPECIALTY "rural people"
                "Local Farms Lore" SCORE 6 SPECIALTY "stewardship"
                "Profession: Farmer" SCORE 6 SPECIALTY "stewardship"
                "Single Weapon" SCORE 3 SPECIALTY "rural people"
            }
            POWERS {
                ^"Cause Fatigue" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Ignem"
                    }
                    DESCRIPTION "(2 points each on cost and Initiative) Causes the loss of a long-term fatigue level via heatstroke."
                }
                ^"Shift Human Shapes" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "(beautiful to hideous within a range of +3/–3 Presence)"
                }
                ^"Transform into Whirlwind" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "+2"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "(1 intricacy point on cost, 2 on Initiative)"
                }
            }
            DESCRIPTION "Presence is +3/–3. Południca usually appears around noon on hot days, and asks farmhands difficult questions, or engages them in conversation. If the farmhand tries to change the topic of their conversation, or cannot answer one of the faerie's questions, she gives him heatstroke. If particularly annoyed at this farmhand, she might instead drive him insane, or cause his death from hyperthermia."
        }

        #tnKTYEt8HL1jQmXICUrbVysI ^"Kallikantzaro" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Corpus"
                ^"Size" INTEGER -3
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER -1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER -2
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER -6
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 3
                    ^"Quickness" INTEGER 3
                }
                ^"Soak" INTEGER 3
                ^"Wound Penalties" STRING "–1 (1-2), –3 (3-4), –5 (5-6), Incapacitated (7-8), Dead (9+)"
                ^"Vis" STRING "1 pawn (Animal)"
                ^"Appearance" STRING "Kallikantzaroi have different appearances in different areas, but they are generally small faeries that have mixed human and animal characteristics. They are usually black and furred, with glowing red eyes and extended tongues. They often have the ears of donkeys or goats, and many have animal feet. They may have tusks and have sharp, curved claws."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Feast of the Fae"
                ^"Hybrid Form"
                ^"Personal Faerie Powers" TIMES 2
            }
            FLAWS {
                ^"Little"
                ^"Sovereign Ward" OF "Religion"
                ^"Incognizant"
                ^"Traditional Wards" NOTE "fire, counting games, burning shoes in some places"
            }
            PERSONALITY_TRAITS {
                "Destructive" +3
            }
            COMBAT {
                "Brawl (bite)" INIT 3 ATTACK 10 DEFENSE 9 DAMAGE -1
                "Brawl (talons)" INIT 2 ATTACK 11 DEFENSE 9 DAMAGE -2
            }
            ABILITIES {
                "Athletics" SCORE 1 SPECIALTY "climbing"
                "Awareness" SCORE 1 SPECIALTY "shiny things"
                "Brawl" SCORE 3 SPECIALTY "each other"
                "Faerie Speech" SCORE 5
            }
            POWERS {
                ^"Silent Motion" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION "These faeries are capable of silent motion, but make noise by damaging things in the excitement of their revels."
                }
                ^"Supernatural Agility" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION "(3 intricacy points spent on cost)."
                }
            }
            DESCRIPTION "* (Athletics) Has virtue allowing supernatural athletics. Kallikantzaroi are faeries that live under the Earth, where they saw away at the World Tree. Each year, as their labor is nearly complete, Christmas arrives and they are allowed onto the surface of the Earth until the Epiphany, and the Blessing of the Waters, which occurs on January 6. When they return home, they find that the tree has regenerated and begin their labor again. In some areas it is believed that children born in the period when the Kallikantzaroi are active become kallikantzaroi themselves during the festive season, their spirits straying from their bodies to raise havoc. This can be prevented with folk charms, like binding the child in special herbs, or singeing its toenails. Kallikantzaroi often prefer to break into a house by crawling down the chimney, so it is traditional to leave the fire burning for the whole of the Yule period, and sometimes to hang sausages or sweetmeats in the chimney, as a bribe to encourage them to go away. A person being chased by a kallikantzaro can divert it by dropping a colander or spilling grain, because it is forced to stop and count the holes in the colander, or the number of grains."
        }

        #tcWAeP9ikGkmEUfYPfHkLtUf ^"Faerie Hounds" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Animal"
                ^"Size" INTEGER 1
                ^"Characteristics" DEF {
                    ^"Cunning" INTEGER 0
                    ^"Perception" INTEGER 2
                    ^"Presence" INTEGER -4
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 2
                }
                ^"Soak" INTEGER 2
                ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24), Dead (25+)"
                ^"Vis" STRING "1 pawn Animal, dog corpse"
                ^"Appearance" STRING "Faerie hounds are usually of chunky hunting breeds. Many have shining eyes, and almost all have black, white, or green fur. These statistics also suit the hunting hounds of the courtly fae. This type of faerie hound often has a white coat, red ears, and blue eyes."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Power" OF "varies"
                ^"Faerie Beast"
                ^"Faerie Sight"
                ^"Improved Characteristics"
                ^"Sharp Ears"
                ^"Large"
            }
            FLAWS {
                ^"Incognizant"
                ^"Reckless"
                ^"Traditional Wards" OF "varies"
            }
            PERSONALITY_TRAITS {
                "Loyal" +3
                "Reckless" +3
                "Brave" +2
            }
            COMBAT {
                "Bite (small teeth)" INIT 2 ATTACK 10 DEFENSE 9 DAMAGE 1
            }
            ABILITIES {
                "Athletics" SCORE 5 SPECIALTY "distance running"
                "Awareness" SCORE 6 SPECIALTY "keeping watch"
                "Brawl" SCORE 5 SPECIALTY "bite"
                "Hunt" SCORE 6 SPECIALTY "track by scent"
            }
            POWERS {
                ^"Damaging Effect" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Varies"
                    }
                    DESCRIPTION ""
                }
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "Used to cause terror and panic with its howl."
                }
                ^"Enthrallment" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "4 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION ""
                }
                ^"Fearful Flaming Eyes" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION ""
                }
                ^"Hound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION ""
                }
                ^"Flight" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant +2"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION "(2 intricacy points on cost) Many also have the Personal Faerie Power of Flight. For this, add the Personal Faerie Powers Virtue."
                    REFERENCES {
                        "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
                    }
                }
            }
            DESCRIPTION "* In some cases, faerie hounds have the Lesser or Greater Faerie Power Damaging Effect, which adds +5 to the damage score of their bite. This is usually visually obvious, for example as their spittle ignites tiny flames on the ground, or their breath puffs like smoke because their teeth freeze like ice. For rapid character generation, select from the following Greater Powers. Many others are known, but these are the most common. Take a total of 50 spell levels of powers. Trading 5 full levels allows the character to spend an intricacy point to reduce the cost of each use of a power, or the Initiative penalty for the power, by 1. Huge faerie dogs haunt the roads of much of Mythic Europe. They terrify, and sometimes kill, travelers. Some can run rapidly, while others run upon their hindlimbs when chasing humans, so as to have their teeth closer to the victim's throat."
            REFERENCES {
                "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
                "Damaging Effect" -> #t885Vlj2jC9rqq8xEP0AI5tP ^"Damaging Effect"
                "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
            }
        }

