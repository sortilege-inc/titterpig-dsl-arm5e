                }
            }
            DESCRIPTION "Size +1, in this case, although some are full-sized horses (Size +3, add +4 Str, subtract –2 Qik, adjust combat statistics and body levels). Kelpies are pony-like faeries that encourage people to mount them. The rider is held to the back of the water horse, which plunges into the nearest lake. Usually this drowns the human and provides the kelpie with a meal, but some kelpies instead take their vitality from the wounded emotions of pompous, rich people that they dump in marshes in order to destroy their fine clothes. Some kelpies take the form of young men, and seduce girls into climbing on their backs: use the Galconer statistics for the character's human form, and add the Transform into Human Personal Power to the statistics."
            REFERENCES {
                "Transform into Human" -> #tmqHc9LM5Z9UhKNqDO3ybfTk ^"Transform into Human"
                "Personal Power" -> #twVnpmKsGJtg08QxdZoxyf5O ^"Personal Power"
            }
        }

        #toF7jkchc1Gnw3XnT5orYM3x ^"Licho" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Mentem"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER -3
                    ^"Communication" INTEGER 2
                    ^"Strength" INTEGER 3
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 1
                }
                ^"Soak" INTEGER 0
                ^"Wound Penalties" STRING "OK, 0, –1, –3, –5, Unconscious."
                ^"Vis" STRING "1 pawn Corpus, a skeletal hand."
                ^"Appearance" STRING "The licho looks like an old, skinny woman dressed in black, with a single great eye in the middle of her forehead."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Powers"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Form"
            }
            FLAWS {
                ^"Missing Eye"
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Enjoys inflicting misery" +3
            }
            COMBAT {
                "Claws" INIT 2 ATTACK 9 DEFENSE 9 DAMAGE 5
            }
            ABILITIES {
                "Area Lore" SCORE 3 SPECIALTY "lonely roads"
                "Awareness" SCORE 3 SPECIALTY "gifts"
                "Brawl" SCORE 6 SPECIALTY "wrestling"
                "Faerie Speech" SCORE 5 SPECIALTY "threats"
                "Folk Ken" SCORE 5 SPECIALTY "gift giving"
                "Stealth" SCORE 4 SPECIALTY "stalking prey"
            }
            POWERS {
                ^"Adhere" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "Licho uses the adhere power to cling to the neck of her victims, or to make them unable to drop an item created from her glamor. Penetration +8 due to spent intricacy points."
                }
            }
            DESCRIPTION "Licho personifies ill-fortune, and either eats her victims or tricks them into grievous self-harm. She might, for example, ride on the neck of a victim, and convince him that he should jump into a lake to drown her. She is a faerie, and needs not breathe, so her victim drowns instead. Sometimes she pursues a victim, who grabs an item that seems likely to aid against her, and then cannot put the item down. She convinces the victim she will hunt him until he gives the item away, so he cuts off his own hand. The licho can be given away: a character who presents a large, undeserved gift to another person can pass the licho to him, as well. The licho can occasionally be tricked, much as the cyclops in the Odyssey was."
        }

        #tX6j0J09hdjJwW3iavK7mdjB ^"Tritons" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Corpus or Animal depending on type of merfolk"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 2
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 1
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 1
                }
                ^"Soak" INTEGER 3
                ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16–20), Dead (21+)"
                ^"Vis" STRING "1 pawn, rusty fish-hooks (or, suiting the External vis virtue, a red hat.)"
                ^"Appearance" STRING "Merfolk are generally human from the waist up, although some of the fairies in the Mediterranean tell of an ancient epoch when they were the other way around. They have fishlike scales, but these provide no defensive advantage. Merfolk men are handsome in Scandinavia, but hideous in Britain."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Powers" TIMES 2
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Hybrid Form"
                ^"Personal Faerie Power"
            }
            FLAWS {
                ^"Sovereign Ward" OF "folk charms"
                ^"Restricted Might" OF "on land"
                ^"Aloof"
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Greedy" +1
            }
            COMBAT {
                "Brawl" INIT 3 ATTACK 3 DEFENSE 1 DAMAGE 5
                "Trident and Net" INIT 3 ATTACK 3 DEFENSE 1 DAMAGE 5
                "Trident (thrown)" INIT 1 ATTACK 5 DEFENSE 3 DAMAGE 5
            }
            ABILITIES {
                "Area Lore: Fishing Grounds" SCORE 2 SPECIALTY "productive spots"
                "Awareness" SCORE 2 SPECIALTY "fish"
                "Bargain" SCORE 2 SPECIALTY "for catches"
                "Brawl" SCORE 1 SPECIALTY "underwater"
                "Charm" SCORE 2 SPECIALTY "fisherfolk"
                "Faerie Speech" SCORE 5
                "Folk Ken" SCORE 2 SPECIALTY "fisherfolk"
                "Guile" SCORE 2 SPECIALTY "about origin"
                "Music" SCORE 2 SPECIALTY "singing"
                "Profession: (fisher)" SCORE 3
                "Single Weapon" SCORE 1 SPECIALTY "spear"
                "Swim" SCORE 3 SPECIALTY "endurance"
                "Thrown Weapon" SCORE 3 SPECIALTY "spear"
            }
            POWERS {
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "Merfolk, mermaids in particular, can cause fascination in sailors who hear them sing. They usually allow the men to return to shore, with instructions to purchase them beautiful things that cannot be made in the sea, like glass mirrors. Cannibalistic mermaids lure ships onto rocks."
                }
                ^"Kiss of the Mermaid" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION ""
                }
                ^"Push of the Gentle Wave" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "Similar to the spell of the same name, but has a longer effect, allowing the faerie to appear to tow small boats or swim assisted by a magical current. Costs 15 spell levels (Base 4, +1 Touch, +2 Sun)"
                }
                ^"Conversing with the Sea" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "Allows the faerie to ask questions of its local part of the ocean. Similar to Voice of the Lake, ArM5 page 122, except that faeries can converse with portions of genuine lakes and seas. Costs 25 spell levels (Base 15 +1 Touch +1 Concentration)"
                }
                ^"Transform into Human" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "This has been treated as a level 25 effect, slightly easier than a complete transformation into a fish (level 30). Some faeries have this power due to an External Vis Source. Humans finding this source, which is often a red hat, can turn into merfolk. If designing one of these faeries, add the External Vis Source Virtue, then add a power worth 25 spell levels to replace this."
                    REFERENCES {
                        "External Vis" -> #tWtTlKRyGAohorFjb8CWnHqC ^"External Vis"
                        "External Vis" -> #tWtTlKRyGAohorFjb8CWnHqC ^"External Vis"
                    }
                }
            }
            DESCRIPTION "* Cannibalistic merfolk often have Feast of the Dead. When one of the merfolk uses a net, it reduces its rival's Attack score by half the net wielder's Thrown Weapon Pretense. Nets do not work the same way for humans. Soak +3 due to leather clothes. Tritons, more usually called merfolk in English, seem to live in clans beneath the waters in areas where fishing is good. They resent humans who treat their fishing grounds poorly. Triton fishers sometimes trade on shore for human baubles. They also trade for alcohol, which makes them surprisingly drunk. In trade, they offer fish or cargoes salvaged from wrecks. A few merfolk are man-eaters that deliberately cause shipwrecks or pretend to be drowning to lure rescuers into the water. They are believed to be more active just before storms, or perhaps cause them. A few live as humans, and gain their fish tail by placing magical red caps upon their heads when traveling through the waters. Theft of this cap allows them to be captured as spouses. Selkies and merfolk seem to live amicably: some stories indicate that they form alliances against mutual enemies. Equipment: Fishing gear (trident, net, bag over shoulder, personal trinkets)."
            REFERENCES {
                "Feast of the Dead" -> #tsFtG3mTEPyHxXhTXtLQD1wv ^"Feast of the Dead"
                "Thrown Weapon" -> #tpmPLk2mRewnvENg2qT8c9uC ^"Thrown Weapon"
            }
        }

        #tAM6uxW5f5uk6js6t6RBu8fE ^"Selkie King" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 15
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Animal"
                ^"Size" INTEGER 1
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 2
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER 1
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 1
                }
                ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-25), Dead (26+)"
                ^"Vis" STRING "3 pawns, skin of a seal"
                ^"Appearance" STRING "Selkies are human-shaped faeries who live beneath the waters, or on distant islands, and change into seal shape to travel through the sea. They take the form of any large seal, avoiding only the shape of common seals. If their seal skins are stolen they may be forced to become spouses, as detailed in the Spouses Captured by Trinkets section earlier. Male selkies, particularly their king, come ashore intermittently to seek brides. It is unclear if their brides live in happiness with them in the depths, or if the blonde hair of the brides is used to thatch the roofs of the selkie king's palace. Women may conjure up selkie lovers by crying seven tears into the ocean."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Power"
                ^"Increased Faerie Might" TIMES 2
                ^"External Vis" SIZE "Minor"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie/Faerie Beast"
                ^"Improved Characteristics"
                ^"Large"
                ^"Skinchanger"
                ^"Place of Power" OF "behind low tide mark"
                ^"Residual Power" OF "Spill Blood"
            }
            FLAWS {
                ^"Narrowly Cognizant"
                ^"Restricted Might" OF "above high tide line"
                ^"Sovereign Ward" OF "folk charms"
                ^"Dark Secret" OF "selkie king" NOTE "When on shore"
                ^"Infiltrator" OF "itinerant laborer" NOTE "When on shore"
            }
            PERSONALITY_TRAITS {
                "Self-centered" +3
                "Romantic" +2
            }
            COMBAT {
                "Brawl (bite – seal form)" INIT 3 ATTACK 9 DEFENSE 6 DAMAGE 8
                "Brawl (bludgeon – human form)" INIT 2 ATTACK 6 DEFENSE 4 DAMAGE 3
            }
            ABILITIES {
                "Brawl" SCORE 3 SPECIALTY "bite"
                "Athletics" SCORE 3 SPECIALTY "acrobatic turns"
                "Awareness" SCORE 3 SPECIALTY "fisherfolk"
                "Faerie Speech" SCORE 5
                "Hunt" SCORE 3 SPECIALTY "fish"
                "Swim" SCORE 5 SPECIALTY "pursuit"
            }
            POWERS {
                ^"Always Hear the Waves" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–1 or 0"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "The faerie always knows the direction and distance to the Palace of the Selkie King. 15 spell levels (Base 2 +4 Arcane +1 Concentration)"
                    REFERENCES {
                        "Selkie King" -> #tAM6uxW5f5uk6js6t6RBu8fE ^"Selkie King"
                    }
                }
                ^"Steal Judgment" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–1 or 0"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "The target believes almost any lie that the faerie tells, although an Intelligence roll against an Ease Factor of 6 is permitted to resist, with easier rolls for truly incredible lies."
                }
                ^"Spill Blood" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–1 or 0"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "When a selkie's blood is spilled on the ocean, it creates an effect similar to Clouds of Rain and Thunder, but with a longer duration. When acting in concert a group of selkies shedding blood on the waters can cause tremendous storms like Wrath of Whirling Winds and Water, ArM5 page 126. This is used to avenge mass slaughters of seals, or the death of other selkies. 20 spell levels (Base 3 +1 Touch +2 Sun +2 Group)"
                }
            }
            DESCRIPTION "Soak: +1 or +6. Seal Form Characteristics: Int +1, Per +1, Pre 0, Com –4, Str +4, Sta +4, Dex +2, Qik +2 (higher than usual for a seal due to the Improved Characteristics Virtue). Equipment: Seal skin."
            REFERENCES {
                "Improved Characteristics" -> #tSpKzbGl9Y5lZje4gBoiEZM8 ^"Improved Characteristics"
            }
        }

        #tGlnBY9jhOiSx0U1SnoFkyp1 ^"Fool’s Fire" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Imaginem"
                ^"Size" INTEGER -10
                ^"Characteristics" DEF {
                    ^"Cunning" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 0
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 10
                }
                ^"Soak" INTEGER 0
                ^"Wound Penalties" STRING "Immaterial, but any damage to immaterial things snuffs the fire out (Dead (1+))"
                ^"Vis" STRING "1 pawn, rapidly dissipating gas, Mentem"
                ^"Appearance" STRING "This faerie looks like a distant, flickering flame. It dances away from those who seek it, drawing them further and further from aid."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Greater Faerie Powers"
                ^"Feast of the Dead"
                ^"Place of Power" OF "swamp"
            }
            FLAWS {
                ^"Glamorous Flesh"
                ^"Little" TIMES 2
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
