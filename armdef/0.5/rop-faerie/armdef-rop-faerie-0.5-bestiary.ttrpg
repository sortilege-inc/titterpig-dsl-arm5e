        #tPp1g3LTn0UJgQe9T1MkQcFI ^"Glanconer" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 10
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 3
                    ^"Communication" INTEGER 3
                    ^"Strength" INTEGER 1
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 1
                ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20) Dead (21+)"
                ^"Vis" STRING "2 pawns, usually kept in the trinket given as a favor."
                ^"Appearance" STRING "A handsome man, generally said to be tall and dark, who is only seen at night. He hunts girls who go places they should not go, and so in some sense is a nursery terror for teenage girls. If unable to find sufficient victims in lonely places, he may try to lure girls from their bedrooms, although he prefers not to."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers" TIMES 2
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Human Form"
                ^"Improved Characteristic" TIMES 3
                ^"Increased Faerie Might"
            }
            FLAWS {
                ^"External Vis" SIZE "Minor"
                ^"Sovereign Ward" OF "sunlight"
                ^"Incognizant"
                ^"Non-combatant"
                ^"Traditional Ward" OF "folk charms, religious charms"
            }
            PERSONALITY_TRAITS {
                "Predatory" +4
            }
            ABILITIES {
                "Athletics" SCORE 3 SPECIALTY "climbing walls"
                "Awareness" SCORE 3 SPECIALTY "at night"
                "Bargain" SCORE 5 SPECIALTY "for lover's favor"
                "Carouse" SCORE 2 SPECIALTY "alone with young woman"
                "Charm" SCORE 3 SPECIALTY "young women"
                "Folk Ken" SCORE 2 SPECIALTY "courtship"
                "Guile" SCORE 5 SPECIALTY "women"
                "Faerie Speech" SCORE 5 SPECIALTY "flattery"
                "Stealth" SCORE 2 SPECIALTY "stalking"
            }
            POWERS {
                ^"Allure" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(1 intricacy point on cost)"
                }
                ^"Pine Away" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–3"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "The glanconer version of this power has Arcane Connection range, and causes only a Light wound, but is used repeatedly over successive days. Part of the glanconer's glamour is that the Arcane Connection must come from an item that was knowingly given as a love token — it cannot be stolen or an arcane connection to an enemy. This reduces the spell's effective level and cost."
                }
                ^"Guide" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–3"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(3 intricacy points on cost): A limited form of this power, which works at Voice Range and only on an individual who has given the glanconer a love gift."
                }
                ^"Steal Judgment" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(2 intricacy point on cost)."
                }
            }
            DESCRIPTION "Equipment: Garments that give the impression that the glanconer is a prosperous man, but not one of such high class as to be unattainable by his victim."
        }

