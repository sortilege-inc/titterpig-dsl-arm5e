                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 3
                    ^"Quickness" INTEGER 1
                }
                ^"Soak" INTEGER 9
                ^"Wound Penalties" STRING "–1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+)"
                ^"Vis" STRING "4 Corpus, a dead vulture"
                ^"Appearance" STRING "Shield maidens or crones that ride wolves above battlefields, and select the worthy dead. They have excellent equipment and extraordinary training."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Increased Faerie Might" TIMES 3
                ^"Faerie Sight"
