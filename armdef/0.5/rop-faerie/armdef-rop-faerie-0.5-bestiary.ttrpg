                ^"Focus Power (Water within her realm)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "up to 10 points"
                        ^"Initiative" STRING "–9"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "Some of the Ladies have other focuses. This is the most common. They have been known to kill with versions of Ice of Drowning, Mighty Torrent of Water, Pull of the Watery Grave, and Tower of Whirling Water using this power. Note that in character creation, the same focus power has been selected twice to gain this higher level."
                }
                ^"Touch of the Mermaid" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "Kiss of the Mermaid, for characters too regal to kiss a magus for ease of transport."
                    REFERENCES {
                        "Kiss of the Mermaid" -> #tG7vzPI3lGkclU3bN3tu6psY ^"Kiss of the Mermaid"
                    }
                }
                ^"Torrent from the Lungs" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "The Ladies often live in kingdoms of salt water, where this spell and a skin of potable water can be used as negotiating tools."
                }
                ^"Transform into (one of Current/Wave)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "–4"
                        ^"Form" STRING "Aquam"
                    }
                    DESCRIPTION "(Until Duration) (3 intricacy points to reduce cost)"
                }
                ^"Transform Victim into (one of Seagull/Crab/Salmon)" DEF {
