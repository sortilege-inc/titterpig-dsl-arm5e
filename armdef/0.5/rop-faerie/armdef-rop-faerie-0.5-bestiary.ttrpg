            POWERS {
                ^"Guide" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "+6"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "4 intricacy points spent on cost, added magnitudes for Sight Range and Sun Duration."
                }
            }
            DESCRIPTION "Str n/a, Sta n/a. Equipment: One large swamp. Fool's fires are tiny lights, also called will o' the wisps, that guide lost travelers into dangerous terrain. Some fool's fires act as lure on behalf of more powerful faeries. In some German areas they are thought to be the ghosts of people who have moved border marking stones."
        }

    #tSf4S0d29cgXdPGUoGkU8rVB ^"Great Lezi" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 40
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Herbam"
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 3
                    ^"Perception" INTEGER 3
                    ^"Presence" INTEGER -2
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 6
                    ^"Stamina" INTEGER 3
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 15
                ^"Wound Penalties" STRING "For Size –10: Dead (1+); For Size –5: –3 (1), –5 (2), Incapacitated (3), Dead (4+); For Size –3: –1 (1-2), –3 (3-4), –5 (5-6), Incapacitated (7-8), Dead (9+); For Size 0: –1 (1-4), –3 (5-8), –5 (9-12), Incapacitated (13-16), Dead (17+); For Size +1: –1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-25), Dead (26+); For Size +3: –1 (1-8), –3 (9-16), –5 (17-24), Incapacitated (25-32), Dead (33+); For Size +7: –1 (1-12), –3 (13-24), –5 (25-36), Incapacitated (37-48), Dead (49+)"
                ^"Vis" STRING "8 pawns, External vis, club"
                ^"Appearance" STRING "The Forest Lord, or great lezi is found in Slavic lands. He usually appears as a tall, pale, bearded man with emerald eyes, but can take the shape of any plant or animal. He may change his size from that of a blade of grass to that of a tall tree. Many lezi have feet that face backward, and many are faunlike. Great lezi command woodland animals, particularly wolves. The term “great” is used to compare this creature to the more-common lezi, which is a form of faun."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Focus Power" TIMES 3
                ^"Great Characteristic" TIMES 3
                ^"Increased Faerie Might" TIMES 7
                ^"Huge" TIMES 7
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Highly Cognizant"
                ^"Improved Characteristics" TIMES 6
                ^"Humanoid Faerie"
                ^"Personal Faerie Powers" TIMES 6
            }
            FLAWS {
                ^"Sovereign Ward" OF "may not leave forest" NOTE "Some Lezis, particularly those with backward feet, are unable to harm humans who have turned all of their clothes backwards."
            }
            PERSONALITY_TRAITS {
                "Loves Forest" +5
            }
            COMBAT {
                "2 x Brawl (club): Init 1+(Size x –1), Attack 8, Defense 7+(Size x –1), Damage +9+(Size x 2)" ATTACK 8
            }
            ABILITIES {
                "Animal Handling" SCORE 9 SPECIALTY "woodland creatures"
                "Athletics" SCORE 3 SPECIALTY "striding"
                "Awareness" SCORE 9 SPECIALTY "damage to forest"
                "Bargain" SCORE 3 SPECIALTY "from position of strength"
                "Brawl" SCORE 6 SPECIALTY "human interlopers"
                "Carouse" SCORE 3 SPECIALTY "wine"
                "Charm" SCORE 2 SPECIALTY "forest folk"
                "Faerie Speech" SCORE 5
                "Folk Ken" SCORE 3 SPECIALTY "forest folk"
                "Forest Lore" SCORE 9 SPECIALTY "locations"
                "Guile" SCORE 2 SPECIALTY "about woodland dangers"
                "Leadership" SCORE 9 SPECIALTY "woodland creatures"
                "Swim" SCORE 3 SPECIALTY "streams"
            }
            POWERS {
                ^"Extended Glamour" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "Constantly in touch with the forest."
                }
                ^"Focus Power (Manifestation)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "5 points"
                        ^"Initiative" STRING "–5*"
                        ^"Form" STRING "Animal or Herbam"
                    }
                    DESCRIPTION ""
                }
                ^"Focus Power (Woodland Change)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "5 points"
                        ^"Initiative" STRING "–5*"
                        ^"Form" STRING "Herbam"
                    }
                    DESCRIPTION "Muto and Intellego effects only in Herbam and Animal."
                }
                ^"Focus Power (Size Reduction)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "5 points"
                        ^"Initiative" STRING "–5"
                        ^"Form" STRING "Corpus or Animal"
                    }
                    DESCRIPTION "Are considered to naturally be Size +7, and use powers to live at a smaller Size."
                }
                ^"Transform into Animal" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–3*"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION ""
                }
                ^"Transform into Bird or Fish" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–3*"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION ""
                }
                ^"Transform into Human" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "varies"
                        ^"Initiative" STRING "varies"
                    }
                    DESCRIPTION "This power costs the Lezi whatever it cost to transform away from the human shape. For character creation purposes, its cost and Initiative must be equal to the most expensive the character will use it to reverse, in this case Transform into Object (Plant)."
                    REFERENCES {
                        "Transform into Object (Plant)" -> #t2dd0f4e8465184904466db ^"Transform into Object (Plant)"
                    }
                }
                #t2dd0f4e8465184904466db ^"Transform into Object (Plant)" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "4 points"
                        ^"Initiative" STRING "–4*"
                        ^"Form" STRING "Herbam"
                    }
                    DESCRIPTION ""
                }
            }
            DESCRIPTION "** The lezi’s arms are made of solid wood, and do damage like a club. They are wielded with the Brawl Pretense, even if the lezi generates clubs to use in battle. * Add appropriate Quickness modifier, based on Size. ** Lezi are extraordinary in that they can change into any animal or plant from their woodland: they do not specify alternative forms as other creatures do. Equipment: Can fabricate an endless variety of material from the woodland. Size varies from –10 to +7. A Lezi may change size in increments of fractions of an inch, if it wishes."
        }

        #t51uVdb4YJ8bPZzRLjcDZpuI ^"Fauns" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Size" INTEGER 1
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER -1
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 2
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER 2
                    ^"Stamina" INTEGER 3
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 2
                }
                ^"Soak" INTEGER 3
                ^"Wound Penalties" STRING "–1 (1-6), –3 (7-12), –5 (13-18), Incapacitated (19-24), Dead (25+)"
                ^"Vis" STRING "1 pawn Animal, goat horn"
                ^"Appearance" STRING "Fauns are rugged, wild men with two sharp horns and goat’s legs and hooves. They have the ears and tails of horses. They are very hairy, their whole bodies covered in short, dark fur, and they often sport scraggly beards. They are also a little larger than normal men. In spite of all this, they are still very attractive in a wild, virile way, for they embody pure masculinity in everything they do."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers"
                ^"Faerie Speech"
                ^"Faerie Sight"
                ^"Improved Characteristics" TIMES 3
                ^"Hybrid Form"
                ^"Large"
            }
            FLAWS {
                ^"Lecherous" SIZE "Major" NOTE "or Greedy (wine - major)"
                ^"Aloof"
                ^"Incognizant"
                ^"Weakness" OF "music or sex or wine"
                ^"Traditional Ward" OF "religious"
            }
            PERSONALITY_TRAITS {
                "Lusty" +5
                "Hasty" +2
            }
            COMBAT {
                "Kick (brawl)" INIT 4 ATTACK 8 DEFENSE 9 DAMAGE 5
                "Horns (brawl)" INIT 3 ATTACK 9 DEFENSE 6 DAMAGE 6
                "Spear" INIT 4 ATTACK 7 DEFENSE 6 DAMAGE 7
                "Spear (thrown)" INIT 2 ATTACK 7 DEFENSE 6 DAMAGE 7
            }
            ABILITIES {
                "Athletics" SCORE 2 SPECIALTY "dancing"
                "Awareness" SCORE 2
                "Brawl" SCORE 5 SPECIALTY "wrestling"
                "Carouse" SCORE 6
                "Charm" SCORE 2 SPECIALTY "taking liberties"
                "Guile" SCORE 2 SPECIALTY "women"
                "Local Language" SCORE 3
                "Music" SCORE 3 SPECIALTY "flute"
                "Single Weapon" SCORE 3 SPECIALTY "spear"
                "Thrown Weapon" SCORE 3 SPECIALTY "spear"
            }
            POWERS {
                ^"Grant Puissance in Combat" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "Fauns can play wild, violent music, giving those who hear it +3 on Weapon Skills (affecting Attack and Damage rolls) and Brave totals for the rest of the scene."
                }
                #t9718bc3d1ffc19b25ceff2 ^"Endless Wine" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Herbam"
                    }
                    DESCRIPTION "(1 intricacy point spent on cost). Any vessel the faun touches fills with wine, if the faun so wishes. Note that fauns prefer human wine, because it has vitality. Fauns give this wine to humans so that they act in vital, uninhibited ways. This effect also makes vines laden with grapes spring up in places where fauns dwell, in some cases. (Base 2, +1 Touch, +2 Sun, +1 constant.* ) * This power lasts for the length of the party. These usually break up at dawn, so it has been given Sun Duration. Note that harm caused to people by effects that vanish does not, itself, vanish, so phantom wine can create real hangovers."
                }
                ^"Steal Judgment" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "OR Endless Wine: 0 points, constant, Herbam."
                    REFERENCES {
                        "Endless Wine" -> #t9718bc3d1ffc19b25ceff2 ^"Endless Wine"
                    }
                }
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(3 intricacy points spent on cost) Faun dancing music makes listeners more riotous and merry, increasing Personality traits like Reckless, Lustful, and Impulsive for the rest of the scene."
                }
            }
            DESCRIPTION "Fauns represent the freedom granted by the secrecy that the forest provides. Fauns are braver than satyrs, described later, and represent what people can get away with in the woods, while satyrs represent what petty people wish they could get away with. Both are dangerous, particularly to women, but satyrs more so when in groups."
        }

        #tHkqcbNGBHuYRF56J9KKR2FJ ^"Satyrs" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Size" INTEGER -1
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 2
                    ^"Communication" INTEGER 2
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 1
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 4
                }
                ^"Soak" INTEGER 4
                ^"Wound Penalties" STRING "–1 (1-4), –3 (5-8), –5 (9-12), Incapacitated (13-16), Dead (17+)"
                ^"Vis" STRING "1 pawn in a phallic-looking reed"
                ^"Appearance" STRING "Satyrs have human bodies, including the legs, but have but have the ears of donkeys and the tails of horses."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Great Characteristic"
                ^"Greater Faerie Powers"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Improved Characteristics" TIMES 2
                ^"Hybrid Form"
                ^"Observant"
            }
            FLAWS {
                ^"Lecherous" SIZE "Major" NOTE "or Greedy (wine – major)"
                ^"Aloof"
                ^"Incognizant"
                ^"Small Frame"
                ^"Traditional Ward" OF "folk charms"
                ^"Weakness" OF "music or sex or wine"
            }
            PERSONALITY_TRAITS {
                "Proud" +3
                "Lusty" +2
                "Brave" -2
            }
            COMBAT {
                "Kick (brawl)" INIT 4 ATTACK 6 DEFENSE 6 DAMAGE 2
                "Horns" INIT 5 ATTACK 3 DEFENSE -1 DAMAGE 2
                "Spear (thrown)" INIT 4 ATTACK 7 DEFENSE 9 DAMAGE 5
            }
            ABILITIES {
                "Athletics" SCORE 2 SPECIALTY "dancing"
                "Awareness" SCORE 2 SPECIALTY "humans"
                "Brawl" SCORE 1 SPECIALTY "escaping"
                "Carouse" SCORE 6 SPECIALTY "party games"
                "Charm" SCORE 2 SPECIALTY "taking liberties"
                "Guile" SCORE 2 SPECIALTY "women"
                "Local Language" SCORE 3
                "Music" SCORE 3 SPECIALTY "flute"
                "Thrown Weapon" SCORE 5 SPECIALTY "spear"
            }
            POWERS {
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 point"
                        ^"Initiative" STRING "+2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(3 intricacy points spent on cost, 1 on Initiative) Satyr dancing music makes listeners more riotous and merry, increasing Personality traits like Reckless, Lustful, and Impulsive for the rest of the scene."
                }
            }
            DESCRIPTION "* Satyrs are less timid when in groups, or by driven by their compulsions. Satyrs embody the cowardice of the common man, in heroic stories. They appear in many Greek plays, and their role is to promise to support the hero, and offer to do great deeds, but to fail because they are stupid and cowardly. This re-enforces the belief that heroes are a separate and better class of human, which was important to Greek audiences. Satyrs are similar to fauns, and most Mythic Europeans use the word interchangeably for what this chapter calls a faun, but satyrs are far smaller, and their machismo is mere bravado. Both fauns and satyrs are notorious for sexual violence, but satyrs tend to be violent more often, and also attack children more frequently."
        }

        #tpILJlgVA9oQ3TqODmX4qv9f ^"Koerakoonlane" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER -3
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 2
                    ^"Stamina" INTEGER 3
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 2
                }
                ^"Soak" INTEGER 6
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
                ^"Vis" STRING "1 pawn, the frozen corpse of a dog."
                ^"Appearance" STRING "A hybrid of both dog and human features."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Observant"
            }
            FLAWS {
                ^"Hybrid Form"
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Brave" +2
                "Cruel" +2
            }
            COMBAT {
                "Bite (Vertically Divided)" INIT 2 ATTACK 6 DEFENSE 6 DAMAGE 3
                "Club (Vertically Divided)" INIT 3 ATTACK 7 DEFENSE 8 DAMAGE 5
                "Javelin (Vertically Divided)*" INIT 2 ATTACK 7 DEFENSE 7 DAMAGE 7
                "Bite (Cynocephalus)" INIT 0 ATTACK 7 DEFENSE 4 DAMAGE 1
                "Club (Cynocephalus)" INIT 1 ATTACK 8 DEFENSE 6 DAMAGE 3
                "Javelin (Cynocephalus)" INIT 0 ATTACK 8 DEFENSE 5 DAMAGE 5
            }
            ABILITIES {
                "Animal Handling" SCORE 3 SPECIALTY "dogs"
                "Awareness" SCORE 2 SPECIALTY "slaves"
                "Brawl" SCORE 2 SPECIALTY "bite"
                "Carouse" SCORE 1 SPECIALTY "on spoils of raid"
                "Faerie Speech" SCORE 4 SPECIALTY "making demands"
                "Hunt" SCORE 3 SPECIALTY "humans"
                "Ride" SCORE 5 SPECIALTY "sled"
                "Single Weapon" SCORE 4 SPECIALTY "club"
                "Survival" SCORE 3 SPECIALTY "icy conditions"
                "Thrown Weapon" SCORE 4 SPECIALTY "javelin"
            }
            DESCRIPTION "Cynocephalus characteristics: Int 0, Per +2, Pre –2, Com 0, Str 0, Sta +3, Dex +1, Qik 0. For the leader of a raiding party, add +3 to all Attack and Defense bonuses to represent superior Pretenses. * Missing eye not included. Equipment: Sled, team of dogs, furs, club, javelins. These faeries eat, although they do not die of starvation, and carry rations made by, or from, humans. The koerakoonlased are faeries of the frozen north, who sweep out of the storms into isolated human settlements to take prisoners. They march their captives north to their distant home, where the humans serve as slaves and as cattle. Individuals sometimes attack isolated farms, but raiding parties, usually made of up 12 koerakoonlased, more frequently attack settlements cut off from outside aid. Migrations involving clans with 40 warriors and their dependents have been reported. A koerakoonlane warrior usually fights with a club and javelins, and wears thick furs that provide limited protection. Most do not use shields. Many ride in sleds pulled by five dogs. When engaging in combat they may swiftly unharness their teams to allow them to attack a foe. This tactic is, however, rare. The warriors prefer to pursue and kill their own prey, and only unleash their dogs if they face skilled opposition, or if they need their dogs to chase down fleeing potential slaves. More-powerful koerakoonlased have been observed. Some act as war leaders, and these have the Spreading a Mantle of Snow Power. Unnatural snow is often the first warning that a raid is imminent. It allows the faeries to prepare the ground for their sleds, which they use as mounts for warfare, and to carry away booty. Others are able to apply the Kiss of Frost power with their whips. This allows the slaves of the koerakoonlased to survive their march into the northern wastes."
            REFERENCES {
                "Spreading a Mantle of Snow" -> #tuNP1YRuzjEbdtKfdjEA4sma ^"Spreading a Mantle of Snow"
                "Kiss of Frost" -> #tNRJ8EXo4F6Z0BrLjUKrYbGD ^"Kiss of Frost"
            }
        }

        #tsPR5eaY7MFtcd11YVmwoXxP ^"Dwarfs, Gnomes, & Goblins" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Terram"
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 2
                    ^"Presence" INTEGER -3
                    ^"Communication" INTEGER -2
                    ^"Strength" INTEGER -1
                    ^"Stamina" INTEGER 3
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 4
                }
                ^"Soak" INTEGER 6
                ^"Wound Penalties" STRING "For Size –2: –1 (1-3), –3 (4-6), –5 (7-9), Incapacitated (10–12), Dead (13+); For Size –3: –1 (1-2), –3 (3-4), –5 (5-6), Incapacitated (7-8), Dead (9+); For Size –4: –1 (1), –3 (2), –5 (3), Incapacitated (4), Dead (5+); For Size –5: –3 (1), –5 (2), Incapacitated (3), Dead (4+)"
                ^"Vis" STRING "1 pawn, in main tool or body residue."
                ^"Appearance" STRING "In many areas, dwarfs are small bearded men. Dwarfish women may be hideous or beautiful, by region."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Immunity from Terram"
                ^"Great Characteristic" TIMES 2
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie"
                ^"Improved Characteristic" TIMES 2
                ^"Observant"
            }
            FLAWS {
                ^"Little" NOTE "once or twice"
                ^"Traditional Ward" OF "offerings"
            }
            PERSONALITY_TRAITS {
                "Vengeful" +3
            }
            COMBAT {
                "Brawl (fist)" INIT 4 ATTACK 9 DEFENSE 11 DAMAGE 3
                "Pick/Tool (two handed)" INIT 7 ATTACK 8 DEFENSE 11 DAMAGE 11
            }
            ABILITIES {
                "Athletics" SCORE 2 SPECIALTY "digging"
                "Awareness" SCORE 2 SPECIALTY "hazards underground"
                "Bargain" SCORE 5 SPECIALTY "with mortals"
                "Brawl" SCORE 6 SPECIALTY "fist"
                "Craft (smith)" SCORE 5 SPECIALTY "weapons"
                "Great Weapon" SCORE 5 SPECIALTY "pick, as pole arm"
            }
            DESCRIPTION "Characteristics for Size –2: Str –1, Qik +4. For Size –3: Str –3, Qik +5. For Size –4: Str –5, Qik +6. For Size –5: Str –7, Qik +7. For every Size less than –2, subtract –2 Damage and add +1 Initiative and Defense. * Includes +1 for pretense specialization. Soak +6, Immunity from Terram. Powers: Many cause rock falls, but this may be through physically damaging the mine’s supports, rather than with a power. Some faeries seem to have the power to make people tiny, so that they can enter the faeries’ miniature subterranean kingdoms. Equipment: Professional gear. Dwarfs, gnomes, and goblins are subterranean versions of the small faeries described in other sections of this chapter. In many countries, the equivalent of a brownie is merely an antisocial dwarf who lives alone in a human homestead. The dwarfs in this section are those that live in communities that guard the entrances to the earth. They are found in caves, barrows (ancient tombs), and in mines. They also dwell in Arcadia. There are many legends of the gnomes, but they all seem to center on two facts: they are cunning smiths, and they have access to the treasures of the Earth. Dwarfs, like most faeries, lack the capacity to innovate. They can, however, make excellent versions of currently known things, remake items so that they appear magical, and create objects that express the inner natures of their owners. They are able to grant the External Vis Virtue to other faeries. The little folk known in many tales as having a pot of gold that they must surrender if caught are a type of dwarf. In Mythic Europe these creatures tend to dress in red, and sometimes have the habit of sending dreams that are addictive. They make their victim dig for treasure at a certain spot until they lose their profession, then their health, then their life. Some gnomes live just beneath the Earth, and are able to affect the fertility of plants, through their roots, leading to conventional affluence."
            REFERENCES {
                "External Vis" -> #tWtTlKRyGAohorFjb8CWnHqC ^"External Vis"
                "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
            }
        }

    #tZPU90FusND4MfmLoe0dibws ^"Giants and Other Gigantic Humans" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Corpus"
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 3
                    ^"Dexterity" INTEGER 1
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 3
                ^"Wound Penalties" STRING "Size +3: –1 (1-8), –3 (7-16), –5 (8-24), Incapacitated (25-32), Dead (33+); Size +5: –1 (1-10), –3 (11-20), –5 (21-30), Incapacitated (31–40), Dead (41+); Size +7: –1 (1-12), –3 (13-24), –5 (25-36), Incapacitated (37-48), Dead (49+)"
                ^"Vis" STRING "1/5th Might in human bones, Corpus"
                ^"Appearance" STRING "Huge men, usually uncivilized and bestial looking. There are female giants, but they tend to be beautiful and smaller than the males."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Huge" SIZE "Major" TIMES 2 NOTE "at least twice"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Human Form"
                ^"Increased Might" NOTE "for a raider"
                ^"Place of Power" NOTE "for a giant the characters seek out in its lair"
            }
            FLAWS {
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Destructive" +3
            }
            COMBAT {
                "Brawl (fist), Size 3" INIT -3 ATTACK 7 DEFENSE 3 DAMAGE 6
                "Club, Size 3" INIT -2 ATTACK 10 DEFENSE 5 DAMAGE 9
                "Thrown Rocks, Size 3" INIT -3 ATTACK 6 DEFENSE 1 DAMAGE 8
                "Brawl (kick), Size 5" INIT -6 ATTACK 7 DEFENSE 0 DAMAGE 13
                "Club, Size 5" INIT -4 ATTACK 10 DEFENSE 3 DAMAGE 13
                "Thrown Rocks, Size 5" INIT -5 ATTACK 6 DEFENSE -1 DAMAGE 12
                "Brawl (kick), Size 7" INIT -8 ATTACK 7 DEFENSE -2 DAMAGE 17
                "Club, Size 7" INIT -6 ATTACK 10 DEFENSE 1 DAMAGE 17
                "Thrown Rocks, Size 7" INIT -6 ATTACK 6 DEFENSE -3 DAMAGE 16
            }
            ABILITIES {
                "Awareness" SCORE 3 SPECIALTY "small moving things"
                "Brawl" SCORE 5 SPECIALTY "fist for Size +2 or +3, kick for larger"
                "Carouse" SCORE 2 SPECIALTY "drinking"
                "Faerie Speech" SCORE 5
                "Folk Ken" SCORE 3 SPECIALTY "threats"
                "Single Weapon" SCORE 6 SPECIALTY "club"
                "Thrown Weapon" SCORE 3 SPECIALTY "rocks"
            }
            DESCRIPTION "Huge humans — giants, ogres, trolls, and many others going by less-modern names — are a typical guard for any space in faerie stories. All of these huge humanoids use the statistics here, but are differentiated with powers and through superficial appearance. Faerie giants differ from Magical giants in several ways. Faerie giants are drawn to humans, despite the known danger from magi. They tend to cause terror and pain, so that they can harvest vitality. This makes them far more destructive than their Magical counterparts. Faerie giants also tend to recur: they regenerate unless their vis is used, so they plague regions periodically. Faerie giants often have daughters who are beautiful and human-sized, since this facilitates their role as love interest for heroes who come to slay the giant."
        }

        #tPJV6JDnKWAHzZ2v8GYm0qnD ^"Orms and Other Dragons" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 0
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Animal"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER -2
                    ^"Presence" INTEGER -6
                    ^"Communication" INTEGER -6
                    ^"Strength" INTEGER 1
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 6
                ^"Wound Penalties" STRING "Size –4: –1 (1), –3 (2), –5 (3), Incapacitated (4), Dead (5+); Size –2: –1 (1-3), –3 (4-6), –5 (7-9), Incapacitated (10–12), Dead (13+); Size 0: –1 (1-5), –3 (6-10), –5 (11-15), Incapacitated (16-20), Dead (21+); Size +2: –1 (1-7), –3 (8-14), –5 (15-21), Incapacitated (22-28), Dead (29+); Size +4: –1 (1-9), –3 (10-18), –5 (19-27), Incapacitated (28–36), Dead (37+); Size +6: –1 (1-11), –3 (12-22), –5 (23-33), Incapacitated (34-44), Dead (45+); Size +8: –1 (1-13), –3 (14-26), –5 (27-39), Incapacitated (37-52) Dead (53+)"
                ^"Vis" STRING "Might/5 pawns, in a snakeskin or a piece of lost string"
                ^"Appearance" STRING "Orms are vast snakes, normally smeared in toxic mucus."
                ^"Source" STRING "Realms of Power: Faerie Bestiary"
            }
            VIRTUES {
                ^"Huge or Little" NOTE "as suits size"
                ^"Faerie Beast"
                ^"Faerie Sight"
                ^"Faerie Speech" NOTE "If Intelligent. Cunning orms are Incognizant and lack Faerie Speech."
                ^"Highly Cognizant"
                ^"Increased Characteristics"
                ^"Increased Might" TIMES 3 NOTE "adjusted with size increase or decrease"
                ^"Personal Faerie Power" OF "Constant Damaging Effect"
            }
            PERSONALITY_TRAITS {
                "Inquisitive" +3
                "Hungry" +2
            }
            COMBAT {
                "Fangs, Size 0 (Init 0–Size, Defense +5–Size, Damage (2 x Size)+2)" ATTACK 14
                "Constriction, Size 0" INIT 0 ATTACK 9 DEFENSE 5 DAMAGE 8
                "Claws (if appropriate), Size 0" INIT -1 ATTACK 11 DEFENSE 10 DAMAGE 3
            }
            ABILITIES {
                "Area Lore" SCORE 3 SPECIALTY "watering points for prey"
                "Awareness" SCORE 3 SPECIALTY "prey"
                "Brawl" SCORE 7 SPECIALTY "crushing"
                "Hunt" SCORE 4 SPECIALTY "rodents"
                "Faerie Speech" SCORE 5 SPECIALTY "threats"
                "Folk Ken" SCORE 1 SPECIALTY "human prey"
                "Stealth" SCORE 3 SPECIALTY "stalking prey"
            }
            POWERS {
                ^"Constrict" DEF {
                    PROPERTIES {
                        ^"Cost" STRING ""
                        ^"Initiative" STRING ""
                    }
                    DESCRIPTION "When successfully struck with a constrict attack, the character is encoiled and unable to use mêlée weapons. The orm automatically does damage in each subsequent round, without requiring an Attack roll. The victim may still Soak damage. At the end of each round, including the round in which the constriction attack succeeds, the character may attempt to break free by an opposed Strength roll. To do this, he rolls Strength + a stress die, and compares it to the orm’s Strength + a stress die. Success indicates he is free, and may attack normally in the following round. For each character assisting him to break free, he may add +1 to the Strength roll, but an assistant is unable to attack the orm in that round. A character unable to break free for 30 seconds (6 combat rounds) needs to make deprivation rolls, as described on page 179 of ArM5."
                }
                ^"Constant Damaging Effect" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "Many orms emit a noxious slime or have toxic breath, and poison their surroundings, but many other damaging effects are known. This effect does +5 Damage, but is always active. 25 spell levels (Base 5 +1 Part, +2 Sun, +1 Constant)"
                }
                ^"Venomous Bite" DEF {
                    PROPERTIES {
                        ^"Cost" STRING ""
                        ^"Initiative" STRING ""
                    }
                    DESCRIPTION "When the orm attacks, compare its Attack Advantage to the victim’s armor Protection (not his Soak). If the orm’s advantage is higher, the victim suffers the effects of adder venom as listed in the Poison Table on page 180 of ArM5, regardless of whether the bite inflicts an actual wound. The storyguide may adjust the required Attack Advantage for special circumstances."
                    REFERENCES {
                        "Poison Table" -> #tx5an6Dnupl80vEvCJHbjINO ^"Poison Table"
                    }
                }
                ^"Flight" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "Qik+3"
                        ^"Form" STRING "Auram"
                    }
                    DESCRIPTION "Gwibers and other flying orms also have a Personal Faerie Power: Flight, 0 points, Init Qik+3, Auram"
                    REFERENCES {
                        "Faerie Power" -> #t84d15c61569668f6f97c5a ^"Faerie Power"
                    }
                }
            }
            DESCRIPTION "Most of the dragons of Mythic Europe are Magical or Infernal creatures, but one class of dragons, termed orms, are predominantly faeries. Orms, which means “worms,” are usually faeries that take the role in the expectation that they will be destroyed. Orms can be distinguished from quite similar Magical dragons through their desire to eat vital things. Orms usually love cows’ milk, and some demand that peasants leave out great pails of it in tribute, much as brownies expect a dish of milk. Others simply suckle directly from cows. Some orms eat only virgins. Some orms drain the vitality out of their surroundings so severely that they seem to be poisoning the landscape. Many take residence around wells or springs."
            REFERENCES {
                "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
            }
        }}
