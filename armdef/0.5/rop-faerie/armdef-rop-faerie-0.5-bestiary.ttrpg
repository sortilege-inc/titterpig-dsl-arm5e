EXTENSION "ARMDef_RoP_Faerie_Bestiary" {
    NAME "Ars Magica Fifth Edition, Realms of Power: Faerie - Faerie Bestiary"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ARMDef_Core_Creature"

    #t5Oacke9vPeF8I7l9qvcFCRY ^"Lamashtu" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 45
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Animal"
                ^"Size" INTEGER 2
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 3
                    ^"Communication" INTEGER -3
                    ^"Strength" INTEGER 6
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER -1
                    ^"Quickness" INTEGER -2
                }
                ^"Soak" INTEGER 4
                ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28), Dead (29+)"
                ^"Vis" STRING "9, a dead owl"
                ^"Appearance" STRING "Lamashtu is a tall woman with the head of a lion, the teeth and ears of a donkey, and the feet of an enormous owl. She has leathery, tanned skin that is sometimes furred. She does not require wings to fly.\n* Lamashtu causes stillbirth by touching the belly of a pregnant woman seven times. She also feasts on the flesh of young men, and rips babies from the womb with her talons to consume, although this most often occurs to travelers. She prefers to kill slowly with repeated touches, or by suckling babies to death.\n** Lamashtu fears and flees images of the Babylonian disease spirit Pazuzu.\n*** Lamashtu's breasts ooze a poison that does +10 Damage. She smears this on her claws and talons if she anticipates battle."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers" TIMES 2
                ^"Huge"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Feast of the Dead"
                ^"Increased Faerie Might" TIMES 8
                ^"Improved Initiative" OF "clawed hands"
                ^"Improved Powers"
                ^"Lesser Faerie Power"
                ^"Personal Faerie Powers" TIMES 2
            }
            FLAWS {
                ^"Incognizant"
                ^"Traditional Ward" OF "Pazuzu" SIZE "Minor"
            }
            PERSONALITY_TRAITS {
                "Vindictive" +3
                "Hungry" +1
            }
            COMBAT {
                "Clawed Hands" INIT 0 ATTACK 10 DEFENSE 10 DAMAGE 8
                "Donkey Bite" INIT -2 ATTACK 11 DEFENSE 8 DAMAGE 7
                "Owl Talons" INIT 1 ATTACK 13 DEFENSE 11 DAMAGE 10
            }
            ABILITIES {
                "Athletics" SCORE 5 SPECIALTY "flight"
                "Brawl" SCORE 9 SPECIALTY "while airborne"
                "Faerie Speech" SCORE 5 SPECIALTY "potential victims"
            }
            POWERS {
                ^"Fatal Menses" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                    }
                    DESCRIPTION "(5 intricacy points on cost) A poison, like that of scorpions, drips continually from Lamashtu. This creates a fine mist as she flies. Lamashtu poisons wells as she flies over them, so that all who drink of them for the next week fall terribly ill. Her venom can also cause personal illness of sufficient virulence to kill the infirm, or fetuses in utero. Crops and animals die as she flies over them, if she wishes. (This has been treated as a level 50 effect, based on Treading the Ashen Path, which is PeHe 30, +10 (added requisites for humans and animals) +10 change Mom duration to Sun, +5 constant, -5 no longer a fancy effect. Treat this power as a magical force, rather than a poison.)"
                }
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–4"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(3 intricacy points on cost, 1 on Initiative) Her terrible roar arouses fear."
                }
                ^"Flight" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "(2 intricacy points on cost)"
                }
                ^"Invisibility" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 point"
                        ^"Initiative" STRING "–4"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION "(2 intricacy points on cost)."
                }
                ^"Loosely Material" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–5"
                        ^"Form" STRING "Corpus (Animal)"
                    }
                    DESCRIPTION ""
                }
            }
            DESCRIPTION "Lamashtu is not designed as a player character. She is an ancient Babylonian goddess of stillbirth. Equipment: Often depicted carrying snakes, or suckling a dog and a pig."
        }

        #tcYqD1DfiZW2rkeQPwdaTIOD ^"Lamia" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 35
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Corpus"
                ^"Size" INTEGER 1
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 3
                    ^"Communication" INTEGER -1
                    ^"Strength" INTEGER 2
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 2
                }
                ^"Soak" INTEGER 6
                ^"Wound Penalties" STRING "–1 (1–8), –3 (9–16), –5 (17–24), Incapacitated (25–32), Dead (33+)"
                ^"Vis" STRING "7 Intellego in two bleeding eyeballs (3 in the right, 4 in the left)."
                ^"Appearance" STRING "Lamia has sharp fingernails that act as claws. Her form is serpentine from the waist down, and may attack by constriction. She has the ability to move silently and slip through walls. She uses these powers to see when mothers leave their babies unattended. Her eyes are usually bloodshot."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers" TIMES 2
                ^"Improved Characteristics" TIMES 2
                ^"Increased Faerie Might" TIMES 6
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Hybrid Form"
                ^"Large"
                ^"Lesser Faerie Powers"
                ^"Personal Faerie Powers" TIMES 3
            }
            FLAWS {
                ^"Narrowly Cognizant"
            }
            PERSONALITY_TRAITS {
                "Befuddled" +2
            }
            COMBAT {
                "Claws" INIT 1 ATTACK 8 DEFENSE 8 DAMAGE 4
            }
            ABILITIES {
                "Awareness" SCORE 9 SPECIALTY "faeries"
                "Brawl" SCORE 6 SPECIALTY "humans"
                "Faerie Speech" SCORE 5 SPECIALTY "those expecting prophecy"
                "Folk Lore" SCORE 9 SPECIALTY "aspirations"
            }
            POWERS {
                ^"Enthrallment" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(1 intricacy point on cost)"
                }
                ^"Extended Glamour" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION ""
                }
                ^"Hound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "2 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "Lamia's power allows her to detect the direction and distance of unattended babies, even if she lacks an Arcane Connection to them. It also connects her to humanoid creatures using her story, like lesser lamiae and Lamashtu. This is the remnant of Lamia's power to scry the future."
                }
                ^"Immateriality" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Corpus/Animal"
                    }
                    DESCRIPTION "(2 intricacy points on cost)"
                }
                ^"Invisibility" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION "(1 intricacy point on cost)"
                }
                ^"Silent Motion" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 point"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION "(1 intricacy point on cost)."
                }
                ^"Steal Eyes" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "4 points"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "This power removes the eyes of the victim, and places them in Lamia's head. It has Touch range. (PeCo(Re) base 20, +1 Part, +1 Touch, +1 Rego requisite, +1 Finesse)"
                }
            }
            DESCRIPTION "Lamia is not designed for use as a player character. If Lamia grapples successfully, she can wrap her body around a target and do constriction damage of +6 per round, while she retains her Grappling Advantage.\n\nLong ago a queen of Libya was a lover of Zeus. She became repeatedly pregnant, but had each of her babies save one, Scylla, die in accidents arranged by the goddess Hera. Then Hera went further: she cursed the queen with eternal insomnia. Driven mad with exhaustion and grief, the queen died and became a faerie. Lamia's lower body now appears to be that of a great serpent. She took her current name \"Lamia\" when she transformed. It means \"gullet,\" as her only food is other people's children.\n\nZeus took pity on Lamia, but was unable to undo Hera's harm. Instead he gave her a power: whenever her unsleeping eyes become so red and painful that it hurt less to rip them out than continue with them, she could steal a fresh set of eyes from a human. Lamia still haunts the world, stealing children and eating them. She is still mad with sleeplessness, and when her eyes become too red for her to bear, she steals fresh ones from her sleeping victims. In ancient times there was a shrine to Lamia in Corinth, and characters facing her may find valuable information there.\n\nLamia was able to predict the future in ancient times. A strange supernatural event, called the Silencing of the Oracles, destroyed the capacity of faeries to predict the future. Learned magi suggest this was an act of God, to prepare the world for a new age with the coming of his Son."
        }

        #thnUaGjuYmBqFnijbAlksyfd ^"Kubu" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 1
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Mentem"
                ^"Size" INTEGER -2
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 0
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 3
                }
                ^"Vis" STRING "1 Mentem, The skull of a tiny baby"
                ^"Appearance" STRING "A small child, dressed well, and with a surprising number of toys in a bag."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Faerie Speech"
                ^"Faerie Sight"
            }
            FLAWS {
                ^"Restricted Might" OF "sunlight" SIZE "Major"
                ^"Decreased Might"
                ^"Intangible Flesh"
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Playful" +3
                "Lonely" +1
            }
            ABILITIES {
                "Charm" SCORE 6 SPECIALTY "children"
                "Guile" SCORE 6 SPECIALTY "children"
                "Faerie Speech" SCORE 5 SPECIALTY "children"
            }
            DESCRIPTION "Kubu is an infant-sized faerie that is believed to have been a child who died without being named in ancient times. He often kills other children before they reach confirmation, by calling them to play in the middle of the night. Kubu may visit a child repeatedly, to gain its confidence to wander further and further from home. He leads them off into the wilderness, there deserting them to die of exposure. He cannot stand the light of the sun. Kubu is not designed as a player character, but may be modified to become one easily. His Flaws need balancing, possibly with powers. He needs extra Pretenses, and a motivation that is more useful for troupe stories than loneliness. Equipment: Phantasmal toys."
        }

        #tXs3m7uBh4hw2JwfRENBGYoo ^"The Man in Black with a Sack on His Back" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 10
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Herbam"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 3
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER -2
                    ^"Stamina" INTEGER 2
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 1
                }
                ^"Soak" INTEGER 2
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
                ^"Vis" STRING "2 Herbam in a tattered old sack."
                ^"Appearance" STRING "The Man in Black with a Sack on His Back always appears foreign, and seems to be able to blend into darkness. He often takes the form of a scarecrow. He carries a sack, or sometimes a backpack, and he puts naughty boys and girls in it, and carries them away. People are not entirely sure what he does with them, but eating is a distinct possibility.\n* Hands do damage as gauntlets because they are made of wood. When not pretending to be human, the man uses his forearms as if they were wooden clubs, using his Brawl skill."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers"
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie"
                ^"Increased Faerie Might"
                ^"Immune to Bashing Weapons"
                ^"Personal Faerie Powers"
            }
            FLAWS {
                ^"Incognizant"
                ^"Restricted Might" OF "direct firelight" SIZE "Minor"
            }
            PERSONALITY_TRAITS {
                "Gregarious" +3
                "Likes stealing things" +1
            }
            COMBAT {
                "Brawl (hands)" INIT 1 ATTACK 2 DEFENSE 2 DAMAGE 0
                "Brawl (2 x Bludgeon)" INIT 2 ATTACK 4 DEFENSE 2 DAMAGE 1
            }
            ABILITIES {
                "Brawl" SCORE 2 SPECIALTY "children"
                "Carouse" SCORE 3 SPECIALTY "suspicious adults"
                "Faerie Speech" SCORE 5 SPECIALTY "suspicious adults"
            }
            POWERS {
                ^"Appear Human" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION ""
                }
                ^"Immure to Bashing Weapons" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Herbam"
                    }
                    DESCRIPTION "This faerie has the body of a scarecrow, and is undamaged by weapons that cause harm through crushing force."
                }
                ^"Invisibility" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Imaginem"
                    }
                    DESCRIPTION "(1 intricacy point on cost)"
                }
                ^"Squirming Sack" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Corpus"
                    }
                    DESCRIPTION "Moves a child up to 50 paces away who has made eye contact with the man into his sack. (Base 15 + 1 Eye, 1 intricacy point spent on cost)"
                }
                ^"Still Sack" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "–1"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "(2 intricacy point on cost): A powerful version of the Cause Drowsiness Power that keeps children unconscious until they are removed from the sack. (Or Sun, whichever comes first)"
                    REFERENCES {
                        "Cause Drowsiness" -> #tWGTBB3wBCGUvErgEwWRaOuF ^"Cause Drowsiness"
                    }
                }
            }
            DESCRIPTION "The Man in Black with a Sack on His Back is not designed as a player character. Soak: +2 against slashing weapons. Immune to bashing weapons. Equipment: Clothing, large sack, an endless supply of straw. The Man in Black with a Sack on His Back is found in a surprisingly large area of Mythic Europe. In most areas he is a nursery terror, but in others he steals children. He is a dark mirror image of the pleasanter Yuletide faeries, who carry presents for good children."
            REFERENCES {
                "The Man in Black with a Sack on His Back" -> #tXs3m7uBh4hw2JwfRENBGYoo ^"The Man in Black with a Sack on His Back"
                "The Man in Black with a Sack on His Back" -> #tXs3m7uBh4hw2JwfRENBGYoo ^"The Man in Black with a Sack on His Back"
                "Mythic Europe" -> #tARMDefConceptMythicEurope ^"Mythic Europe"
            }
        }

        #tO2gXgx0C4Ox9oxQ1jbf7GCS ^"Gorgon" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 25
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Mentem"
                ^"Size" INTEGER -1
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 6
                    ^"Presence" INTEGER -3
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 3
                }
                ^"Soak" INTEGER 0
                ^"Wound Penalties" STRING "–1 (1–4), –3 (5–8), –5 (9–12), Incapacitated (13–16) Dead (17+)."
                ^"Vis" STRING "5 Mentem, a mask"
                ^"Appearance" STRING "A woman of slight build, with a hideously deformed face, tusks, and brass claws. Snakes replace her hair. Some gorgons are stunningly beautiful (Per 0, Pre +6, lose the omnidirectional vision or spend an extra Major Virtue), and some can fly on bat–like wings.\n* Due to Dozens of Eyes power.\n* Gorgons have mid-back-length hair, so they may only use their hair snakes to engage targets close together. Theoretically, she has 18 snakes able to strike at any time on her head, although usually she only uses three at a time. See also the venomous bite power.\n*** This is a power of the gorgon's Hybrid Form, and does not need to be paid for with the Personal Faerie Power Virtue."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Greater Faerie Powers" TIMES 2
                ^"Increased Faerie Might" TIMES 4
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Hybrid Form"
            }
            FLAWS {
                ^"Incognizant"
                ^"Small Frame"
            }
            PERSONALITY_TRAITS {
                "Vain" +3
                "Iconoclastic" +1
            }
            COMBAT {
                "Brass Claws" INIT 2 ATTACK 5 DEFENSE 7 DAMAGE 2
                "Tusks" INIT 3 ATTACK 7 DEFENSE 6 DAMAGE 5
                "Serpent Hair" INIT 2 ATTACK 8 DEFENSE 5 DAMAGE 1
            }
            ABILITIES {
                "Brawl" SCORE 3 SPECIALTY "humans"
            }
            POWERS {
                ^"Enthralling Sound" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "3 points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "A gorgon can utter the scream of the dead, creating terror in those who hear it. The low hissing of her snakes can create the same effect."
                }
                ^"Deadly Gaze" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 point"
                        ^"Initiative" STRING "–2"
                        ^"Form" STRING "Terram"
                    }
                    DESCRIPTION "(4 intricacy points on cost) The gorgon can transform into stone any person or animal with which she makes eye contact. Creatures so changed revert to life if the gorgon dies or is stripped of its Might. (Base 25, +1 Eye, +4 Until)"
                }
                ^"Dozens of Eyes" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 points"
                        ^"Initiative" STRING "constant"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION "The gorgon has dozens of pairs of eyes, which scan her surroundings, in all directions, constantly. This grants her extraordinary Perception."
                }
                ^"Venomous Bite" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "0 Points"
                        ^"Initiative" STRING "0"
                        ^"Form" STRING "Animal"
                    }
                    DESCRIPTION "When the gorgon's hair attacks, compare its Attack Advantage to the victim's armor Protection (not his Soak). If the gorgon's advantage is higher, the victim suffers the effects of adder venom as listed in the Poison Table on page 180 of ArM5, regardless of whether the bite inflicts an actual wound. The storyguide may adjust the required Attack Advantage for special circumstances."
                    REFERENCES {
                        "Poison Table" -> #tx5an6Dnupl80vEvCJHbjINO ^"Poison Table"
                    }
                }
            }
            DESCRIPTION "Gorgons are not designed as player characters. In ancient Greece, the gorgons were nursery terrors. The name gorgon means terrible, and terror is something a young boy would need to overcome to be a man. A true Greek warrior would learn to seize control of fear, and use it against his enemies, much as Perseus used the head of the gorgon. After achieving this, the head of the gorgon becomes a traditional symbol that wards off evil, called the gorgoneion. She is the faerie that humans use as a folk charm to scare away lesser faeries. Thus, the name Medusa means \"protector.\""
        }

        #thT80IM66w8fHhMGdXwawqj7 ^"Mormo" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 15
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Mentem"
                ^"Size" INTEGER 0
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 1
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 1
                    ^"Strength" INTEGER 0
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 0
                    ^"Quickness" INTEGER 0
                }
                ^"Soak" INTEGER 0
                ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
                ^"Vis" STRING "3 Mentem, in the saliva of the possessed victim."
                ^"Appearance" STRING "Mormo does not have a material body, but if seen with Faerie Sight, or Second Sight outside a body, she seems to have a horse's head. This is incongruous with her lupine name, indicating that this was possibly changed at some time by a human. It may be, in some way, symbolic of her changed personality."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Focus Faerie Powers" OF "Possession, see below"
                ^"Increased Might" TIMES 2
                ^"Loosely Material" NOTE "Modified to a minor Virtue: may only take forms using possession power."
            }
            FLAWS {
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Playful" +3
                "Thinks children are scrumptious" +3
            }
            COMBAT {
                "Bite" INIT 0 ATTACK 8 DEFENSE 6 DAMAGE 1
            }
            ABILITIES {
                "Brawl" SCORE 5 SPECIALTY "infants"
            }
            POWERS {
                ^"Possession" DEF {
                    PROPERTIES {
                        ^"Cost" STRING "1 or more points"
                        ^"Initiative" STRING "+2"
                        ^"Form" STRING "Mentem"
                    }
                    DESCRIPTION "If this power penetrates, the victim is possessed by Mormo and is under her direct control. Any attempt to force the victim to act contrary to her nature, or to use any of the host's own magical powers requires that Mormo spends Might. A supernatural power (including spell-casting) requires 1 Might point per magnitude to produce. A questionable action that is contrary to the nature of the host requires Mormo to exceed the possessed being's Personality Trait roll on a stress die + Might points spent. The storyguide may give a modifier to the Personality Trait roll based on the nature of the command (see the Entrancement power, ArM5 page 65, for suggestions). Both Might costs must be met if the use of a supernatural power is also contrary to the victim's nature. If Mormo is in direct control of its host's actions, the host acquires Mormo's Magic Resistance, but is also affected by wards that would normally exclude her. If the host is acting under her own free will, then she does not benefit from Mormo's Magic Resistance, but may also walk through wards with impunity. This power's costs are not based on the Hermetic system of magic. It is instead based on material in Realms of Power: Magic."
                    REFERENCES {
                        "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
                        "Personality Trait" -> #tcBZnRedWJ5vEcmMkio8kULU ^"Personality Trait"
                        "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
                        "Magic Resistance" -> #tmM1uJVBdvXpEsg4iImNPyjr ^"Magic Resistance"
                    }
                }
            }
            DESCRIPTION "Mormo is not suited for player characters. These statistics are provided by Mormo's host. The bite marks Mormo's hosts leave are like those of horses. Brawl 5 (infants), but may use the Pretenses or abilities of the host. Equipment: Someone else's body, all of their material goods.\n\nMormo is a faerie who bites children and babies who are being naughty. A mother, on the faerie's behalf, often playfully delivers Mormo's bites. Mormo was initially a mother who lost her children, and became a werewolf (mormu-lukeion) to seek revenge. Somehow she lost her body, and became a possessing spirit, like the faerie that causes the tortoise game described in the nearby insert. In time, she became less dangerous and more playful. This may be the result of a human reworking her role with creativity, turning her attacks into a game like peek-a-boo between a mother and child. Mormo still possesses mothers and encourages them to playfully nibble at their children. Mormo's presence, like that of the Tortoise, causes the mother to continually refer to her child as if it were food, with names like \"honey,\" \"sweetie,\" \"dumpling,\" and \"apple.\" Mormo's statistics may be used for the Tortoise, her more-dangerous role mate. Mormo sometimes uses weapons, and at other times seems incapable of it. This may indicate there are several faeries that take the role of Mormo, but that makes her change from devouring mother to nursery terror more difficult to explain."
        }

        #tEtTvfWpW8XwKwPkilJTlnaj ^"Toy Soldier" DEF {
            EXTENDS ^"Creature"
            PROPERTIES {
                ^"Might" INTEGER 5
                ^"Might Realm" STRING "Faerie" FIXED
                ^"Form" STRING "Herbam"
                ^"Size" INTEGER -6
                ^"Characteristics" DEF {
                    ^"Intelligence" INTEGER 0
                    ^"Perception" INTEGER 1
                    ^"Presence" INTEGER 0
                    ^"Communication" INTEGER 0
                    ^"Strength" INTEGER -9
                    ^"Stamina" INTEGER 0
                    ^"Dexterity" INTEGER 2
                    ^"Quickness" INTEGER 8
                }
                ^"Soak" INTEGER 4
                ^"Wound Penalties" STRING "–5 (1), Incapacitated (2), Broken (3+)"
                ^"Vis" STRING "1 pawn Herbam, tiny wooden sword"
                ^"Appearance" STRING "This foot-tall wooden soldier is the veteran of many imaginary campaigns, and stands guard over his lord while he sleeps. He has the good fortune to be a Traditional Ward against certain nursery terrors, but he puts the retreat of such monsters down to their fear of his prowess."
                ^"Source" STRING "Realms of Power: Faerie"
            }
            VIRTUES {
                ^"Faerie Sight"
                ^"Faerie Speech"
                ^"Humanoid Faerie"
                ^"Improved Characteristics" TIMES 2
                ^"Observant"
            }
            FLAWS {
                ^"Little" TIMES 2
                ^"Dependant" OF "child"
                ^"Incognizant"
            }
            PERSONALITY_TRAITS {
                "Brave" +3
                "Loyal" +3
                "Proud" +1
            }
            COMBAT {
                "Tiny Wooden Sword" INIT 9 ATTACK 10 DEFENSE 15 DAMAGE -6
            }
            ABILITIES {
                "Athletics" SCORE 3 SPECIALTY "running"
                "Awareness" SCORE 6 SPECIALTY "night terrors"
                "Faerie Speech" SCORE 5
                "Single Weapon" SCORE 6 SPECIALTY "tiny wooden sword"
            }
            DESCRIPTION "The toy solider could replace a beginning companion with alteration. It requires a Social Interaction Virtue or Flaw, and needs to balance its Virtues and Flaws. The soldier requires another 90 points of Pretenses. The Improved Damage Virtue or Damaging Effect power would raise the toy soldier's damage to +1. Although it could not afford to enter combat, it could act effectively as an assassin sent to kill sleeping humans, or guard animals that use smell to detect threats, like dogs. A horde of enhanced toy soldiers could overcome human foes. Removing one of the Little Flaws, and raising the character's Size to –2, would make the character far more durable and allow it to inflict heavier damage. Equipment: Painted uniform, tiny wooden sword."
            REFERENCES {
                "Virtues and Flaws" -> ^"Virtues and Flaws"
                "Improved Damage" -> #thH1bCzoiitnhPpJ0mq02EIG ^"Improved Damage"
                "Damaging Effect" -> #t885Vlj2jC9rqq8xEP0AI5tP ^"Damaging Effect"
            }
        }

