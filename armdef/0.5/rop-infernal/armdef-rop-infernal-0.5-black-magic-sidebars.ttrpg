EXTENSION "ARMDef_RoP_Infernal_BlackMagic_Sidebars" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Twelve: Black Magic sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Story Hook: A Dish Served Very Cold" #t6ed638fdbadf575e3575ee {
            TEXT "Story Hook: A Dish Served Very Cold\n\nThe characters come across an ancient circle created by *Circular Ward Against Demons*, perhaps in a long-abandoned covenant. The circle seems to be empty, and it is possible that the characters do not even see it inscribed on the floor. The circle contains a demon, who is currently in spiritual form, and thus invisible to mortal sight. The demon has been here for a long time, and is eager for escape and revenge."
        }
    }

}
