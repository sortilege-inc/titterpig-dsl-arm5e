            "Guile" SCORE 5 SPECIALTY "own self-importance"
            "Infernal Lore" SCORE 6 SPECIALTY "superiors"
            "Intrigue" SCORE 5 SPECIALTY "demonic plots"
        }
        POWERS {
            #t37cfa25ab52a637e372280 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
