EXTENSION "ARMDef_RoP_Infernal_Corrupters_Demons" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Five: Demons as Corrupters demons"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's demons, structured; each DESCRIPTION the source's text, verbatim.

    #t187d89acfedc11a54c4815 ^"Adramelech, King of Fire" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Prince of the False Gods"
            ^"Might" INTEGER 50
            ^"Form" STRING "Ignem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 3
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 5
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 4
            }
            ^"Printed Size" STRING "0 (human), +2 (peacock)"
            ^"Confidence Score" STRING "3 (9 points)"
            ^"Virtues and Flaws" STRING "Greater Immunity to Flame and Heat, Puissant Leadership, Piercing Gaze"
            ^"Reputations" LIST ["King of Hell 8 (Infernal)", "Kindler of the Hell Fires 5 (Infernal)"]
            ^"Hierarchy" INTEGER 9
            ^"Soak" INTEGER 9
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Protected Group (Infants)"
            ^"Vis" STRING "10 pawns of Ignem, in feathers of the peacock"
            ^"Appearance" STRING "As a king, crowned in gold and robed in scarlet. His hair is made of living flames, his beard is made of smoke, and his eyes are glowing coals. He carries an immense sword. His constant companion and mount is a huge peacock, whose tail eyespots are glowing eyes of fire."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 50
        }
        PERSONALITY_TRAITS {
            "Proud" +6
            "Regal" +6
            "Condescending" +3
        }
        COMBAT {
            "Great sword" INIT 6 ATTACK 18 DEFENSE 15 DAMAGE 14
        }
        ABILITIES {
            "Artes Liberales" SCORE 7 SPECIALTY "geometry"
            "Awareness" SCORE 4 SPECIALTY "sinners"
            "Bargain" SCORE 8 SPECIALTY "pacts"
            "Brawl" SCORE 4 SPECIALTY "kick"
            "Charm" SCORE 5 SPECIALTY "innocent"
            "Folk Ken" SCORE 7 SPECIALTY "diabolists"
            "Great Weapon" SCORE 8 SPECIALTY "great sword"
            "Guile" SCORE 10 SPECIALTY "the proud"
            "Infernal Lore" SCORE 8 SPECIALTY "fire demons"
            "Intrigue" SCORE 8 SPECIALTY "the Pit"
            "Leadership" SCORE 12 BONUS 2 SPECIALTY "humans"
            "Philosophiae" SCORE 7 SPECIALTY "metaphysics"
            "Teaching" SCORE 6 SPECIALTY "academic abilities"
            "Theology" SCORE 8 SPECIALTY "nature of evil"
        }
        POWERS {
            #te40a2611516544b0965ac8 ^"King of Fire" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Ignem"
                }
                DESCRIPTION "Adramelech can create any Ignem-based effect, at a cost of 1 Might per two magnitudes. Ritual effects cost him twice as much, and an hour to summon up."
            }
            #t69b4dd6a26b998805089be ^"Regal Countenance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "When Adramelech issues an order, those succumbing to this Power are forced to obey it. The order must be terse, unambiguous, and involve a single, immediate action. For every additional point of Might expended on this Power, the demon can affect two more targets with the same order."
            }
            #tb934d2991c679e9492375f ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t68d52a127ceff3b308b2c0 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Pride, Envy, Cruelty. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t3a96a55645c2f03be52087 ^"Shroud the Stench of the Pit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #td875763a42478e6d58c5f3 ^"The Wealth of Nations" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #tb80c4c464a7a3665f5bf29 ^"His Master’s Voice" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
        }
        DESCRIPTION "Adramelech is a mighty demon, one of the most powerful in Hell. He is of ancient origin; he was among those who fell with Satan, and first lit the fires of Hell in an attempt to mimic the glorious light of Heaven. In olden times he was worshiped by the men of Tyre and Carthage as a god called Moloch. His devout worshipers sacrificed babies to him, for he has a special hatred of children. The infants were killed by placing them on the outstretched hands of Adramelech’s immense bronze idols, so that they fell into the fire which was lit below the statues. In modern times, he is seen on earth only upon the instigation of some diabolist. If anyone has the temerity to attack him physically, he can produce fire hot enough to melt steel and scorch flesh. He is not a particularly subtle demon, but he is not to be taken lightly."
    }

    #t4b13c39cf1eefec3bfeb51 ^"Baal-Peor, Lord of Filth" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "False Gods"
            ^"Might" INTEGER 30
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER -5
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 5
                ^"Dexterity" INTEGER 1
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "3 (9 points)"
            ^"Virtues and Flaws" STRING "Oversensitive (coitus), Obese"
            ^"Reputations" LIST ["Treasurer of Hell 6 (Infernal)", "Demon of Filth 5 (Infernal)"]
            ^"Hierarchy" INTEGER 6
            ^"Combat" STRING "Noxious Vomit: Init +9, Attack +12, Defense n/a, Damage +12 Claws: Init +4, Attack +5, Defense +6, Damage +6 See Power description Claws are coated in excrement. Unless injuries are cleaned carefully, they fester and never heal. A roll on the Recovery Table that results in an Improvement indicates stability, while a Stable result indicates that the wound worsens. Once the infection has set in, only Divine aid in healing cleanses the wounds."
            ^"Soak" INTEGER 8
            ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Running water"
            ^"Vis" STRING "6 pawns of Perdo, in tongue"
            ^"Appearance" STRING "Baal-Peor appears as an immensely fat naked man, with rolls of flab cascading down his body. He is completely hairless, and has a repulsive, snake-like tongue. He wears a serpent wrapped around his girth like a belt, and its head is usually draped over his shoulder."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 50
        }
        PERSONALITY_TRAITS {
            "Proud" +6
            "Hungry" +3
            "Shame" -3
        }
        ABILITIES {
            "Artes Liberales" SCORE 4 SPECIALTY "arithmetic"
            "Brawl" SCORE 4 SPECIALTY "claws"
            "Civil and Canon Law" SCORE 4 SPECIALTY "trade"
            "Folk Ken" SCORE 6 SPECIALTY "fornication"
            "Infernal Lore" SCORE 5 SPECIALTY "wealth"
            "Intrigue" SCORE 7 SPECIALTY "envy"
            "Medicine" SCORE 4 SPECIALTY "poisons"
            "Profession: Merchant" SCORE 7 SPECIALTY "unfair deals"
        }
        POWERS {
            #tc49962d4fbd5f324a847cb ^"Form of Woman" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "Baal-Peor can take the form of a woman, although he cannot use this Power to mimic a specific woman. He always chooses a form that will be considered beautiful by the target audience of his schemes."
            }
            #tab56d7973d85131d2d7666 ^"Noxious Vomit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "+9"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "This Power allows Baal-Peor to spray vast amounts of vomit (or, facing the other way, even less pleasant substances) through an area. His vomit is an expression of his spiritual vileness, and does the damage indicated in his combat statistic through corrosion, except to characters with True Faith, whom it cannot touch. The target must make a Strength + Size stress roll against an Ease Factor of 9 or be sent flying backwards. Anyone successfully struck by this vileness continues to suffer +3 damage in each round until it is washed off. This damage does not stack for multiple successful attacks."
            }
            #tb982219288861ea9a59453 ^"Swallow Assault" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "Baal-Peor may avoid injury from mundane objects by opening his maw so wide that the attack slides harmlessly down his throat."
            }
            #t09af1abc6de60fdb0c58fb ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t62d0f20be9935a4fd40f3a ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Shamelessness, Gluttony. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t3180028219dfff5c7143c1 ^"Shroud the Stench of the Pit" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #t74f83a6adce40664a180ba ^"The Wealth of Nations" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Terram"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
            #t65a7c74877aba6e2a027c8 ^"His Master’s Voice" DEF {
                PROPERTIES {
                    ^"Cost" STRING "variable points"
                    ^"Initiative" STRING "+1"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
        }
        DESCRIPTION "Baal-Peor (or Belphegor) is a demon of wealth. He creates discord by moving mortal riches in disruptive ways (using the Wealth of Nations Power). He gives money to the vulnerable, so that the strong are tempted to take it. He gives the possessions of the powerful to others. This tempts the recipients to keep their stolen treasures, and rouses the powerful to recover them by force.\n\nBaal-Peor was worshipped, in ancient times, less as a wealth-god than as an embodiment of the desire to consume everything and transform it into vileness. His title, “Lord of the Openings” describes him: an unfillable mouth leading to a ceaseless defecation. Priests and pilgrims used the space before his statue as a latrine, as a form of worship. Baal-Peor, it is said, was sent by his masters to seek the truth of rumors that humans lived in marital bliss. He tried to live as a woman, but was so disgusted by marital relations that he fled back to Hell."
    }

    #t04effd5d55b9c2a5831fe2 ^"Bomburkhan" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters (Ruchin)"
            ^"Might" INTEGER 5
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -2
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER 0
                ^"Strength" INTEGER -9
                ^"Stamina" INTEGER 1
                ^"Dexterity" INTEGER 6
                ^"Quickness" INTEGER 7
            }
            ^"Size" INTEGER -9
            ^"Virtues and Flaws" STRING "Weak-Willed, Short Attention Span"
            ^"Reputations" LIST ["None"]
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 1
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1), –3 (2), –5 (3), Incapacitated (4)"
            ^"Weakness" STRING "Vulnerability (salt)"
            ^"Vis" STRING "1 pawn of Vim, in wings"
            ^"Appearance" STRING "Bomburkhan appears as a jet–black bat, no bigger than a person’s hand, but with a pinched and twisted human face protruding from the black fur."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 51
        }
        PERSONALITY_TRAITS {
            "Resentment of Being Controlled" +5
            "Selfish" +5
            "Brave" -6
        }
        COMBAT {
            "Dodge" INIT 7 DEFENSE 14
        }
        ABILITIES {
            "Athletics" SCORE 5 SPECIALTY "flying"
            "Brawl" SCORE 6 SPECIALTY "dodge"
            "Guile" SCORE 6 SPECIALTY "boasts"
        }
        POWERS {
            #t10870eb223d13f4e17bc26 ^"Make a Liar of the Boastful" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "If this imp hears a boast and expends all of his Might Points, he can immediately grant someone nearby an Ability or Power that contradicts that boast, and cause them to use it immediately. Thus, if someone proclaims that she is the most beautiful woman in France, Bomburkhan can immediately make someone more beautiful than the boaster. This Power must penetrate Magic Resistance to grant the Ability or Power to the person, and that talent lasts for 1–10 rounds only (roll a simple die). A physical change, such as the example given above, lasts until the boaster and the target can no longer see each other."
            }
            #tf2e4b5a6479df5a7cab448 ^"Insignificance" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "No Magic, Infernal or Faerie Power can force Bomburkhan to use any of his Powers."
            }
            #t84a1c81f91f707bdb5416a ^"Misfortune" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "See Ruchin."
            }
            #t142131f8eaf9fc6c020fe2 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t44785abc0a83ffe9866162 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Boastful. See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "Bomburkhan was released from Hell after the false bravado of a crusader led to the capture of Jerusalem. Since then he has taken great delight in puncturing the over-inflated egos of the prideful. This ruach has an ability that could be exceedingly powerful, depending upon the magnitude of a speaker’s self-importance. For example, should a magus declaim “no one can breach my Parma Magica!”, a nearby grog might suddenly hurl a *Pilum of Fire* which slices straight through it! Fortunately for all concerned, this Power uses all of Bomburkhan’s Might Pool, and he grows bored very easily, wandering off once his mischief is done."
    }

