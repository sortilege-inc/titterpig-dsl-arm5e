            }
            #t8bb5a248325e457eab9006 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Rape. See Chapter 4: Infernal Legions, Demonic Powers."
