            }
            #tf0eebbcd060bc1d65633fe ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Overconfidence. See Chapter 4: Infernal Legions, Demonic Powers."
