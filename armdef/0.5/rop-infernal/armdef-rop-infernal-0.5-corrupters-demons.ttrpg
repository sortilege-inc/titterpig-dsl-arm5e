                }
                DESCRIPTION "See Chapter 4: Infernal Legions, False Gods."
            }
        }
        DESCRIPTION "Lickspitten is a typical famulus in service to a witch. He demands to be fed blood from the witch’s own body, and in return performs minor chores such as hiding the taint of her unclean Powers, and allowing her to eavesdrop on the plans of her rivals."
    }

    #tec06385fe07b298eb23cdd ^"Metathiax, Decanus of Kidney Diseases" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Master of the Avengers of Evil (Decani)"
            ^"Might" INTEGER 30
            ^"Form" STRING "Corpus"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 3
                ^"Perception" INTEGER 1
                ^"Presence" INTEGER 0
                ^"Communication" INTEGER -3
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 4
                ^"Dexterity" INTEGER 4
                ^"Quickness" INTEGER 4
            }
            ^"Size" INTEGER 2
            ^"Confidence Score" STRING "2 (6 points)"
            ^"Virtues and Flaws" STRING "Greater Immunity (disease), Lesser Purifying Touch (kidney diseases), Puissant Medicine"
            ^"Reputations" LIST ["Master of the Choir of Archangels 3 (Infernal)"]
            ^"Hierarchy" INTEGER 3
            ^"Soak" INTEGER 5
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Weakness" STRING "Abhorrent Material (amulet inscribed with the sigil of Adonael)"
            ^"Vis" STRING "8 pawns of Corpus, in water jug"
            ^"Appearance" STRING "Metathiax appears as an emaciated angelic figure composed of black fire and clothed in a robe of red with a blue hood. He carries a jug of water. Like all Avengers of Evil, his face is expressionless. He rarely assumes a gross physical form, instead attacking his chosen victim using his Powers."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 55
        }
        PERSONALITY_TRAITS {
            "Relentless" +5
            "Passionless" +4
            "Merciful" -3
        }
        COMBAT {
            "Bludgeon" INIT 4 ATTACK 9 DEFENSE 7 DAMAGE 6
        }
        ABILITIES {
            "Awareness" SCORE 4 SPECIALTY "sinners"
            "Brawl" SCORE 2 SPECIALTY "bludgeon"
            "Chirurgy" SCORE 6 SPECIALTY "infection"
            "Medicine" SCORE 10 BONUS 2 SPECIALTY "kidney diseases"
        }
        POWERS {
            #t507178fa15b6cc08f14d23 ^"Ride the Diseased Body" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Decani."
            }
            #t5d1ea7d9dc6688296fa727 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t2076ed92cc9792520f6cac ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Repentance. See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #t4137a3b2c6ac919976c39c ^"Punish the Sinner" DEF {
                PROPERTIES {
                    ^"Cost" STRING "5 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Avengers of Evil."
            }
        }
        DESCRIPTION "Metathiax is the decanus who inflicts diseases of the kidneys. When he uses his Punish the Sinner Power, stabbing abdominal pains are inflicted on the victim. The diseases he inflicts rot the kidneys and the bladder, causing extreme pain when urinating and the passing of blood. He rules the first third of Cancer’s reign, and always commences his attacks during the full moon. A knowledgeable exorcist knows that the attacks of Metathiax may be calmed by the reading of poetry, and those who attempt such therapy may gain a bonus to recovery rolls equal to one=half of the poet’s Ability score. Metathiax is thwarted by the angel Adonael."
    }

    #td4be043615f17234c83de4 ^"Nitibus, a Personal Corrupter" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempter (Shedim)"
            ^"Might" INTEGER 20
            ^"Form" STRING "Vim"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 3
                ^"Strength" INTEGER 3
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 2
            }
            ^"Size" INTEGER 0
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Weak–Willed"
            ^"Hierarchy" INTEGER 0
            ^"Soak" INTEGER 4
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unc."
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Weakness" STRING "Protected Group (victims who willingly and totally reject him, fueling such rejection with a Confidence or Faith Point)"
            ^"Vis" STRING "2 pawns of Vim, in each of his two tongues"
            ^"Appearance" STRING "His true appearance is as a pointy-nosed man with a face on both sides of his head. One face flatters his victim, the other criticizes others. He wears the same clothes as his victim, but does not look quite as good in them. When clothed in his Apparition Power, only one of his faces can be seen at a time, but his neck spins to interchange between the two."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 56
        }
        PERSONALITY_TRAITS {
            "Selfish" +5
            "Obsequious" +4
            "Scathing" +2
        }
        COMBAT {
            "Claws" INIT 3 ATTACK 7 DEFENSE 6 DAMAGE 5
        }
        ABILITIES {
            "Brawl" SCORE 3 SPECIALTY "claws"
            "Charm" SCORE 4 SPECIALTY "chosen victim"
            "Folk Ken" SCORE 6 SPECIALTY "character faults"
            "Guile" SCORE 6 SPECIALTY "imaginary faults"
        }
        POWERS {
            #t7ab4c6f86fce96ddba90f8 ^"Apparition" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 point"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Imaginem"
                }
                DESCRIPTION "See Shedim."
            }
            #t02e6c323e39ced4196bb0c ^"Protection of the Close Friend" DEF {
                PROPERTIES {
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "+3"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "See Shedim."
            }
            #tfd8019a0687fbafa81c430 ^"Coagulation" DEF {
                PROPERTIES {
                    ^"Cost" STRING "2 points"
                    ^"Initiative" STRING "–1"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "See Chapter 4: Infernal Legions, Demonic Powers."
            }
            #tc42ce34514f84cb3b7bd99 ^"Obsession" DEF {
                PROPERTIES {
                    ^"Cost" STRING "1 to 3 points"
                    ^"Initiative" STRING "–5"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "Overconfident. See Chapter 4: Infernal Legions, Demonic Powers."
            }
        }
        DESCRIPTION "Nitibus attaches himself to those who have a natural inclination towards criticism. He then encourages this vice at every opportunity, whispering into the ear of his victim to indicate any opportunities that he might have otherwise missed to put others down and belittle their efforts. Nitibus panders to the vanity of his chosen victim (who suffers from the Story Flaw Plagued by a Demon), always pointing out how much better he is than his peers."
    }

    #t7bca74d57769c4b05a6521 ^"Valefar, the Thief’s Demon" DEF {
        EXTENDS #t167900677b9e928b0cb39f ^"Demon"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Tempters"
            ^"Might" INTEGER 15
            ^"Form" STRING "Animal"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER 2
                ^"Presence" INTEGER 1
                ^"Communication" INTEGER 1
                ^"Strength" INTEGER 4
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER 1
            }
            ^"Size" INTEGER 3
            ^"Confidence Score" STRING "1 (3 points)"
            ^"Virtues and Flaws" STRING "Improved characteristics (x2), Piercing Gaze, Puissant Brawl, Tough, Weak-willed"
            ^"Reputations" LIST ["Master Thief 3 (Infernal)"]
            ^"Hierarchy" INTEGER 3
            ^"Soak" INTEGER 11
            ^"Fatigue Levels" STRING "OK, 0/0, –1/–1, –3/–3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–14), –5 (15–21), Incapacitated (22–28)"
            ^"Powers" STRING "Honor Among Thieves, 3 point, Init 0, Corpus: Each use of this Power prevents a single thief from revealing a specified secret. If the thief tries to speak the secret, his tongue does not move, and he attracts Valefar’s attention. Valefar then typically ensures that he dies, preferably by being hanged for a theft he did not commit. Itching Thumbs, 1 point, Init +5, Corpus: Each use of this Power grants a thief a +3 bonus on a single roll that allows him to steal. It only aids actual theft, so it aids a pickpocket or window fisherman, but not a housebreaker climbing a wall or a lock picker opening a chest. The Sleep of the Hand of the Thief, 5 points, Init 0, Mentem: This Power makes all people within a building who are asleep unwakable until dawn. Coagulation, 2 points, Init –1, Corpus: See Chapter 4: Infernal Legions, Demonic Powers. Obsession, 1 to 3 points, Init –5, Vim: Larceny. See Chapter 4: Infernal Legions, Demonic Powers."
            ^"Weakness" STRING "Protected Group (those who venerate thieves)"
            ^"Vis" STRING "3 pawns of Corpus, in his left thumb"
            ^"Appearance" STRING "Valefar appears as a large hairless lion with the head of a man."
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 56
        }
        PERSONALITY_TRAITS {
            "Gloating" +3
        }
        COMBAT {
            "Claws" INIT 1 ATTACK 15 DEFENSE 13 DAMAGE 8
        }
        ABILITIES {
            "Awareness" SCORE 3 SPECIALTY "legal authorities"
            "Brawl" SCORE 5 BONUS 2 SPECIALTY "claws"
            "Folk Ken" SCORE 5 SPECIALTY "thieves"
            "Infernal Lore" SCORE 3 SPECIALTY "necromantic objects"
            "Intrigue" SCORE 3 SPECIALTY "Hell’s politics"
            "Legerdemain" SCORE 5 SPECIALTY "filching"
            "Stealth" SCORE 5 SPECIALTY "night"
        }
        DESCRIPTION "Diabolists have many uses for Valefar. His Powers assist conspiracy, and he is one of the demons that teaches how to manufacture magical items out of the remains of hanged criminals. Valefar can also find mandrakes for his masters. His imposing physical presence and knowledge of thievery make him a skilled guard. Because he is of relatively low intelligence, he is easily dominated by a quick-witted master. However, Valefar is not as dim-witted as one might think. He always leads his masters to the gallows before they can repent. He is aware that he is not a skilled schemer, but he knows many demons that are, and he is willing to work under their direction, so long as it always appears that he works alone. His limitation includes members of the Order of Hermes, who venerate Hermes. He therefore hates Hermetic magi and sets his people against them."
    }

}
