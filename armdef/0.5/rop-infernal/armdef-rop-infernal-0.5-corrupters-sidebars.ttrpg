EXTENSION "ARMDef_RoP_Infernal_Corrupters_Sidebars" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Five: Demons as Corrupters sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Story Seed: Lickspitten" #t2fdbcdd627a2b957faa70a {
            TEXT "Story Seed: Lickspitten\n\nThe player magi slay an infernalist, and discover amongst his belongings a “magical” talking cat, trapped in a cage for some nefarious purpose. Lickspitten actually climbed into the cage when it became obvious that his former master would meet his end. He would love to become the familiar of a magus of the Order...."
        }
    }

    GUIDANCE {
        ENTRY ^"The Hand of Glory" #t1fcd1cacaca7de34fc5158 {
            TEXT "The Hand of Glory\n\nValefar can teach any individual, whether Gifted or not, to make a hand of glory by taking the hand of a hanged murderer and dipping it in specially prepared wax. Those Valefar has aided in thievery are particularly suitable donors. The hand is fitted with candles made from a noxious wax, with wicks made from the hair of a dead man, so that each finger can be lit like a candle. A hand of glory has five charges, once per finger. Each has the effect described below, which can also be created by Hermetic magic, as the spell *Infernal Sleep of the Damned*. (Since this Power is identical to a possible Hermetic spell, some magi make Hermetic hands of glory, which need not even be hands; Valefar loathes magi who do this.) The Infernal item has Penetration 0, but does not suffer from Valefar’s weakness unless the demon made it personally.\n\n**Infernal Sleep of the Damned** Re(In)Me 25 Pen +0 R: Touch, D: Sun, T: Structure A hand of glory renders most people within a building, other than its holder, unconscious until sunrise or the hand is extinguished, whichever comes first. The hand does not affect brave or pious people (with appropriate Personality Traits at +3 or more), or those possessing relics. Those rendered unconscious cannot be awakened by natural means, which allows them to be bound or murdered while they sleep. The hand may not be doused with water, but can be extinguished with milk or the breath of whoever lit it. The hand will not light if there is anyone awake in the building. Failure to light the hand does not use a charge.\n\n(Effect: Base 4, +1 Touch, +3 Structure, +1 In requisite)"
        }
    }

}
