EXTENSION "ARMDef_RoP_Infernal_InfernalCharacters_Blessings" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Nine: Infernal Characters blessings"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's blessings, structured; each DESCRIPTION the source's text, verbatim.

    #tbcf6d2952a238a47c23f3d ^"Infernal Ability" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Phantasm"
            ^"Level" INTEGER 20
            ^"Printed Stat Line" STRING "Infernal Ability (Debauchery, Phantasm, Level 20)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character’s body is changed to give her an unnatural ability (such as wings, an additional limb, retracting fangs, or eyes that can see in the dark), though this does not function in the Dominion or when she is subjected to an uncommon circumstance such as salt, running water, or iron."
    }

    #t43326c09d893ea0b21f199 ^"Infernal Confidence" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Psychomachia"
            ^"Level" INTEGER 20
            ^"Printed Stat Line" STRING "Infernal Confidence (Debauchery, Psychomachia, Level 20)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character gains an additional Confidence Point."
    }

    #t832d5dae9bffac7bd3f195 ^"Infernal Device" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 40
            ^"Printed Stat Line" STRING "Infernal Device (Incantation, Effusion, Level 40)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character has a device enchanted to produce an unholy effect of up to level 15."
    }

    #tc8547c7f1af80a1e1a232b ^"Infernal Greatness" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 60
            ^"Printed Stat Line" STRING "Infernal Greatness (Incantation, Diablerie, Level 60)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character receives the effects of an appropriate Major Virtue, such as Greater Immunity, Ways of the (Land), or Wealthy."
    }

    #t051a7f4231ca5ed99a845c ^"Infernal Health" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 40
            ^"Printed Stat Line" STRING "Infernal Health (Incantation, Consumption, Level 40)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character gains a +3 bonus to all Aging rolls at the expense of another, who receives a –3 penalty. If this victim dies, her blessing ceases to be effective."
    }

    #t328adfe87b16f5a5009fed ^"Infernal Powers" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 40
            ^"Printed Stat Line" STRING "Infernal Powers (Incantation, Diablerie, Level 40)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character receives the effects of an appropriate Minor Virtue, such as Affinity with (Ability), Increased Characteristics, Puissant (Ability), or Self-Confident."
    }

    #t3374ddf23020465e9adf1a ^"Infernal Protection" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 40
            ^"Printed Stat Line" STRING "Infernal Protection (Incantation, Diablerie, Level 40)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character has a Magic Resistance score of 15."
    }

    #t37cec12bf2d16cd02288b6 ^"Infernal Prowess" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Infernal Blessing"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 40
            ^"Printed Stat Line" STRING "Infernal Prowess (Debauchery, Consumption, Level 40)"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 86
        }
        DESCRIPTION "The character has enhanced the effectiveness of her body, giving her a +3 bonus to either Soak or Damage, but adding 3 to her Load; or increasing her Initiative, Attack, or Defense by 3, but penalizing her Fatigue rolls by the same amount."
    }

}
