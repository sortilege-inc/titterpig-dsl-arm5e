EXTENSION "ARMDef_RoP_Infernal_InfernalLegions_Weaknesses" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Four: The Infernal Legions weaknesses"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's weaknesses, structured; each DESCRIPTION the source's text, verbatim.

    #t18b41c29018d5b8c1ab087 ^"Abhorrent Material/Circumstance" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The demon cannot abide a particular type of object or substance, or a particular circumstance. This may be a common material such as light, salt, or garlic (for weak demons); or a reasonably uncommon, such as iron horseshoes, objects that have been given names, or charms made of rowan wood, for the more powerful demons. The material or circumstance inflicts no actual damage, but should such a thing come into the demon’s presence, the demon must flee, or else spend a Confidence Point to remain for two minutes. If it is unable to do either, then a brave or foolhardy soul may be able to strike a bargain with the demon using the advantage he has gained. A demon in the presence of its Abhorrent Material or Circumstance cannot regain spent Might Points. This weakness affects demons in both spiritual and physical form, but demons possessing a human are more resistant to their weaknesses, and may make a Stamina roll against an Ease Factor of 6 to remain in the presence of the abhorred material. If the roll is failed, the demon must either make its host flee, or if this is not possible, end the possession and flee itself."
    }

    #tcfa1a30b90b0d37069f911 ^"Compulsiveness" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The demon is compelled to enumerate randomly scattered objects; if, for example, a jar of beans is strewn in the path of this demon, it must count every one before it can proceed. The objects must be purposefully scattered in sight of the demon to hinder it."
    }

    #t9e651c6f92ba3cdad8335b ^"Ordering" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The demon has no power over anything that is sealed, counted, measured, or tied up. It cannot open sealed vessels, steal grain from a bushel (although it can falsify the weighing in the first place), and so forth. Many demons in Jewish lore have this limitation."
    }

    #tc86d71afc39b5c401bc887 ^"Protected Group" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The demon cannot act directly against a particular, reasonably common, group of people. It may not be able to affect children, or men with beards, or female Muslims. None of its Supernatural Powers work on this group, and if they face it in combat, it can only defend itself. A person who is not a member of the protected group is safe from the demon if he remains within a defined group of at least nine others who *are* protected from the demon. Likewise, two vulnerable people can hide within a group with a total size of twenty, and so forth."
    }

    #te0a70de7ed7f91ef0558ab ^"Running Water" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "The demon cannot cross running water. This must be fresh water deriving directly from within the earth — spilled water from a jar will not hinder it."
    }

    #t170b6701cf169ee1f3d395 ^"Vulnerability" DEF {
        EXTENDS #t0fa5697338cf5051460713 ^"Demon Weakness"
        PROPERTIES {
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "A certain substance (see Abhorrent Material for appropriate examples) causes a Light Wound to the demon merely by touch. The more powerful the demon, the rarer this substance should be. Any weapons made of the material to which the demon is vulnerable inflict a Light Wound to the demon on a successful attack in addition to any damage inflicted as a result of the attack, even if the demon’s soak absorbs all the other damage. Light is a common Vulnerability of weak demons."
    }

}
