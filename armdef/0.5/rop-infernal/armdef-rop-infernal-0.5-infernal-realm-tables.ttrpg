EXTENSION "ARMDef_RoP_Infernal_InfernalRealm_Tables" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter One: The Infernal Realm tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t570a70a39081b15e2b65fa ^"Infernal Aura Examples" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Example", "Rating"]
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 11
        }
        TABLE {
            "A den of iniquity" "1"
            "The site of a grisly murder" "2"
            "A crossroads where suicides are buried" "3"
            "A plague pit" "4"
            "An underground temple established by a diabolic cult" "5"
            "The sanctum of a powerful infernalist" "6"
            "A site where 1,000 innocents were murdered" "7"
            "Aceldama, where Judas committed suicide" "8"
            "The Gates of Hell" "9"
        }
    }

}
