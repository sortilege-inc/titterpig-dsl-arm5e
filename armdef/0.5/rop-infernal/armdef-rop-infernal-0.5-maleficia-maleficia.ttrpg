EXTENSION "ARMDef_RoP_Infernal_Maleficia_Maleficia" {
    NAME "Ars Magica Fifth Edition, Realms of Power: The Infernal - Chapter Ten: The Maleficia maleficia"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-04"
    DEPENDS_ON "ARMDef_RoP_Infernal_Core_Ext"

    # The chapter's maleficia, structured; each DESCRIPTION the source's text, verbatim.

    #t695b9b0eddd06daa2376db ^"These shall give their power and strength unto the beast" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery, Consumption, Level 20 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 105
        }
        DESCRIPTION "The infernalist performs a ritual of corrupting the body, involving at least one other person, that permanently increases the target’s Strength score by 1, though to no more than 0, and also permanently decreases the victim’s Strength score by 1, to no less than –1.\n\n(Base 5: +1 Touch, +2 victim)"
    }

    #tcba424c4446935473e1e7b ^"A golden cup, full of abominations" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery, Consumption, Level 25 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "Through this insidious effect, often involving a lewd song or dance, the infernalist impregnates a woman with material taken from a man, both of whom must be within range. Whether this seed bears fruit depends on the normal circumstances.\n\n(Base 15: +2 Voice)"
    }

    #tf8e625c735dd2dfd364de0 ^"Break the body, bend the will / One can injure, one can kill" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 30
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation, Consumption, Level 30 R: Sight, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "This maleficium instantly heals a Light Wound of any living thing within range, cursing a person within sight with the same sort of injury. It essentially steals the health of the victim to restore the target. If the victim or target has any sort of Magic Resistance, the infernalist must penetrate its defenses for this to have any effect.\n\n(Base 15: +3 Sight)"
    }

    #t8ebca30e93878642b0229d ^"Cast away your mortal soul / And keep it safe in mortal bowl" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Consumption"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation, Consumption, Level 50 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 106
        }
        DESCRIPTION "To cast this maleficium, the character must perform an Infernal ritual that corrupts a vessel — an object that contains infernal vis, which must be within range of his voice — and permanently transfers his soul into the object. This causes it to become a fixed Arcane Connection to him, and for as long as it remains whole and undamaged, he cannot die. Any time he would suffer a fatal wound or fail to survive an aging crisis, he gains a Warping Point and automatically experiences Vituperation instead. Afterward, his spirit returns to his body, unless the body has been completely destroyed, in which case he probably becomes a ghost. If the object that hides his soul is ever broken or used for vis, he dies immediately.\n\n(Base 40: +2 Voice)"
    }

    #t4f33db3384b2b201ae8800 ^"And he causeth all to receive a mark" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 25
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Diablerie, Level 25 R: Sight, D: Sun, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "The character causes an object to become a temporary Arcane Connection to any supernatural creature she can see for the duration of this effect. This also taints the object slightly, making it feel unholy to people who can sense the Infernal realm.\n\n(Base 4: +3 Sight, +2 Sun)"
    }

    #t5b5f0adf18052f6f82a9ba ^"The image of the beast should speak" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 35
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Diablerie, Level 35 R: Arc, D: Conc, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "During the maleficium casting, the character must draw a circle upon the ground and stand outside of it. When it is finished, she can summon the image of a demon to which she has an Arcane Connection, which can also see, hear, and speak to her if it chooses. This creates a mystic conduit between the two of them that lasts for as long as she concentrates, so that the demon can affect her with its Powers as if it were touching her. If the demon does not wish to be disturbed, the character might anger it with this effect, and possibly suffer its wrath.\n\n(Base 10: +4 Arc, +1 Conc)"
    }

    #ta97ebf5fda60a3d03e6636 ^"And the dragon gave him his power" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Forsaken"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Diablerie, Level 40 R: Touch, D: Forsaken, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "This maleficium allows the character to draw upon the powers of the Infernal to allow someone she is touching to receive the effects of a Minor Virtue, one with which she is familiar enough that she can describe what it does. This Infernal blessing can potentially last forever, so long as the target does not seek absolution, but only appropriate General or Supernatural Virtues may be given in this way, and then only if they do not somehow depend upon the character’s background. Virtues like Educated or Privileged Upbringing are not acceptable. Furthermore, if the Virtue is supernatural, it is an Infernal Power.\n\n(Base 15, +1 Touch, +4 Forsaken)"
    }

    #t5edacba8b26389bac04665 ^"The cage of every unclean and hateful bird" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Diablerie"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Forsaken"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Diablerie, Level 50 R: Voice, D: Forsaken, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "The character commands a supernatural creature within the sound of her voice to serve her completely and obey her every command, which it must do for as long as the effect lasts, assuming she overcomes its Magic Resistance. If it ever receives absolution, it is free from her control.\n\n(Base 20, +2 Voice, +4 Forsaken)"
    }

    #t1bcd7f820e02af5fe7164c ^"The stone prepared, his gift to grant With foulest craft he does enchant" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Effusion"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Year"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Effusion, General R: Touch, D: Year, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "The character casts this spell upon an object or substance, essentially opening it for a form of Infernal enchantment. During this process, he casts a second maleficium, of less than or equal level to this effect, which is absorbed by the object and held for the duration of the effect. If the object is broken or consumed during that year, any maleficia that have been imbued into it are released as if they had been cast by the person who activated it.\n\nThis maleficium can be performed multiple times, allowing the character to enchant a target with several different “charges,” and each time he does this it refreshes the duration of the enchantment.\n\n(Base effect: +1 Touch, +4 Year)"
    }

    #t3e6e74b5a122ac3a189995 ^"Darkness has power over all things general / Weather and wind and all courses variable" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 20
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 20 R: Sight, D: Conc, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "This effect gathers severe winds, powerful enough to lift a person through the air and carry him through the sky at high speed. The character must concentrate upon these winds in order to control them, and she cannot do this if they fly out of her sight. Most infernalists cast this effect on themselves, winging through the night to reach their evil gatherings, though it is said that they must not speak the name of Christ while aloft, or they will lose their support and immediately fall to the ground.\n\n(Base 4: +3 Sight, +1 Conc)"
    }

    #td3f7f7f1516adb7d36ba1e ^"Roll, you clouds, and thunder cry And strike with flames from empty sky" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 25
            ^"Printed Stat Line" STRING "Debauchery/Effusion, Level 25"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The character summons a powerful thunderstorm from a clear sky, with gale-force winds and lightning strikes. It takes only a few minutes to gather while she concentrates. She has no control over the storm, though when she stops concentrating it begins to dissipate, and a few minutes later the weather displays no sign that there ever was a storm.\n\n(Base 3: +3 Sight, +1 Conc, +2 Group)"
    }

    #t33c44c16dcd597aac5890c ^"I conjure this, by foul decree In its same likeness unto me" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Effusion"
            ^"Level" INTEGER 25
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Effusion, Level 25 R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The character stretches out his hand and summons to it any object he can see or to which he has an Arcane Connection. The item appears instantly in his grasp, so that if it is a weapon or tool, he can immediately put it to use.\n\n(Base 5: +4 Arc)"
    }

    #taf30b537cf9e5684f41eb9 ^"As the vessels of a potter shall they be broken to shivers" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Malediction"
            ^"Level" INTEGER 15
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Malediction, Level 15 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The caster concentrates his power upon a target, and causes it a Medium Wound, severe enough to cripple a limb until it is healed.\n\n(Base 5, +2 Voice)"
    }

    #t0ebc13590138f41f067ce7 ^"The student must be forced to learn / and thus the worm begins to turn" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Malediction"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Malediction, Level 20 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "For the duration of this effect, the target suffers a –1 penalty to all die rolls, and an additional botch die whenever a zero is rolled.\n\n(Base effect: +1 Touch, +2 Sun)"
    }

    #tfa679f4a5fa721a3bb5ed8 ^"Therefore shall all her plagues come in one day" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Malediction"
            ^"Level" INTEGER 30
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Cursed/Momentary"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Malediction, Level 30 R: Voice, D: Cursed/Momentary, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The infernalist focuses her will upon a living person and warns him that he will die if he does a specific uncommon thing, such as “if you come within ten feet of me” or “if you eat a pear.” If the effect penetrates his Magic Resistance, he is affected by the malediction and if he should ever disobey her instruction he instantly falls over dead.\n\nThe infernalist may also cast the effect so that it targets another person within range, perhaps someone very close to the person she is cursing. There can be no doubt in the mind of any witnesses that she is casting an evil curse, and whether it comes to pass or not it clearly identifies her as a witch.\n\n(Base 20: +2 Voice, +2 Cursed)"
    }

    #t3c8a9c94b92578e656773b ^"By evening ash and morning dew I send your charms away from you" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Malediction"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Malediction, Level 50 R: Voice, D: Sun, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The infernalist utters a terrible curse at a victim, and causes him to lose the benefits of one of his Major Virtues for the duration. You can specify the type of Virtue (Hermetic, Supernatural, General) you wish for to affect, otherwise the storyguide chooses an appropriate Virtue. If it is a Supernatural Ability, it is as if the victim has no score in it. If it is another Virtue, it is simply as if the victim does not have it. This curse can even target The Gift, making it impossible for a magus to work magic, but only if he has no other Supernatural Virtues for the curse to affect.\n\n(Base 30: +2 Voice, +2 Sun)"
    }

    #t915f0980a13a2af6a0bddd ^"For they are the spirits of devils, working miracles" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Phantasm"
            ^"Level" INTEGER 10
            ^"Range" STRING "Per"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Phantasm, Level 10 R: Per, D: Conc, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "The character can see through Infernal deception for the duration, seeing evil creatures as they truly are in much the same way that characters with Second Sight can see through magical and faerie illusions. This does not protect him from phantasms, though he can recognize them as such. When this effect is cast, note its Penetration, as demons and other creatures with a false appearance may be able to resist it.\n\n(Base 5, +1 Conc)"
    }

    #t582d8dea64a99920ca0cb5 ^"Summon shapes of lustful need And swiftly form a ghostly steed" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Phantasm"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Phantasm, Level 20 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "This simple maleficium conjures a phantasmal horse, complete with tack and harness if you wish, which lasts until sunrise or sunset. It can carry the character’s weight and run as quickly as a real horse, though it cannot enter the Dominion, and is similarly limited in another way, depending upon the infernalist’s weakness. For example, perhaps it cannot cross running water, or cannot touch an innocent.\n\n(Base 5: +1 Touch, +2 Sun)"
    }

    #t24eea614080bcb2d5e8bb4 ^"I saw three unclean spirits, like frogs, out of the mouth of the dragon" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Phantasm"
            ^"Level" INTEGER 20
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Phantasm, Level 20 R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 110
        }
        DESCRIPTION "The character sits in a meditative state and concentrates his thoughts upon the demonic spirits that watch over the different hours. He should have a question in mind that applies to events of the last or next day (such as “How did this sword get bloodied?” or “What does the weather bode for tomorrow?”). He then receives a vision that cryptically answers the question through dark imagery and malice, in which he might be abused or mocked by spirits that delight in seeing him suffer for the knowledge he seeks.\n\nThese demons cannot actually see the future, but they do perceive most of what goes on in the world, and can often make very shrewd guesses about events that have not yet happened. If they cannot answer a question, they probably fabricate something and take great pleasure in watching the character try to make sense of their deceit. Thus, very specific questions tend to produce more accurate results than vague ones.\n\n(Base 20)"
    }

    #t5254aa85019a1eb174bbe6 ^"To stir the spirit, heart and fear A shadow phantom hunts in here" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Level" INTEGER 40
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Incantation, Level 40 R: Arc, D: Conc, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "The infernalist sends a phantasmal creature into the thoughts of a person to whom she has an Arcane Connection. The creature is usually a wild beast or a hobgoblin. The phantasm can behave as she directs, distracting the target’s concentration by making imaginary sounds and so on. The target can see and hear the phantasm inside his mind, or feel it poking his side or sitting on him, and he can interact with it directly by focusing his thoughts upon it. Infernalists often use this effect to send the semblance of a demon into a sleeping person’s dreams.\n\nThe phantasm is a being of nightmare and imagination, but it has its own identity outside of the person and can leave his mind, though it has no substance. It can take the person with it if he chooses to go, leaving his body behind and traveling with the phantasm in spirit form, usually riding on its back. In this ghostly state, the target can see and hear what goes on around him in the physical world, but cannot interact with it in any way. When the effect ends, he returns immediately to his body, waking as if from a nightmare.\n\n(Base 5: +4 Arc, +1 Sun, +2 unusual effect)"
    }

    #ta8923bca0290133a791a65 ^"Babylon the great is fallen, and is become the habitation of devils" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Psychomachia"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Debauchery/Psychomachia, Level 15 R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "The caster tarnishes an Infernal aura with a trait of your choice at +3.\n\n(Base effect: +1 Touch, +2 Sun)"
    }

    #t9f4e754b4391c3923ba9dc ^"And the men had repented not of their deeds" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Psychomachia"
            ^"Level" INTEGER 10
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "Incantation/Psychomachia, Level 10 R: Eye, D: Conc, T: Ind"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "The caster can recognize whether a person is more evil or good by sensing his most powerful emotion. He looks him in the eye as he casts the maleficium, and becomes aware of his dominant Personality Trait, or another emotion by which he is currently influenced.\n\n(Base 4, +1 Eye, +1 Conc)"
    }

    #t061eb4637cf213fd7b87b2 ^"They shall make the whore desolate and naked, and shall eat her flesh" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Debauchery"
            ^"Power" STRING "Psychomachia"
            ^"Level" INTEGER 45
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "Debauchery/Psychomachia, Level 45 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 111
        }
        DESCRIPTION "Everyone in a group of people is seized with a powerful emotion, specified as part of the spell, which is usually sinful in nature. They each gain an appropriate Personality Trait at +3 for the duration of the effect. Until it wears off, these people become much more receptive to sins associated with the trait, and may in fact behave completely out of character in pursuit of their desires.\n\n(Base 15: +2 Voice, +2 Sun, +2 Sin)"
    }

    #t8a9efe691a455b9a086105 ^"I will make them of the synagogue of Satan; I will make them worship before thy feet" DEF {
        EXTENDS #t3bb049d785ee4bab039575 ^"Unholy Effect"
        PROPERTIES {
            ^"Kind" STRING "Maleficium"
            ^"Method" STRING "Incantation"
            ^"Power" STRING "Psychomachia"
            ^"Level" INTEGER 50
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "Incantation/Psychomachia, Level 50 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Realms of Power: The Infernal"
            ^"Page" INTEGER 112
        }
        DESCRIPTION "The caster speaks a simple command to a group of people, which they must obey for the duration of the effect. Examples: “Attack anyone who comes through here,” “Journey to the covenant of Semita Errabunda and capture the woman Isabelle who lives there,” or “Bow down and worship this idol until the legate arrives.”\n\n(Base 20: +2 Voice, +2 Sun, +2 Group)"
    }

}
