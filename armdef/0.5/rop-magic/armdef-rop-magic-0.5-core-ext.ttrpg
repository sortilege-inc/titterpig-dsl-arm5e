EXTENSION "ARMDef_RoP_Magic_Core_Ext" {
    NAME "Ars Magica Fifth Edition - Realms of Power: Magic: core type extensions"
    VERSION "0.5.2"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-07-26"
    DEPENDS_ON "ARMDef_Core_Ability"

    # Realms of Power: Magic introduces the mechanical vocabulary of the Magic
    # Realm. New first-class types are declared here (spec S13 composition); the
    # supplement is loaded alongside the arm5e core rulebook.
    #
    # Magic Qualities and Inferiorities are the Magic Realm's analogue of the
    # core rulebook's character Virtues and Flaws, but for MAGIC THINGS (magic
    # animals, humans, spirits, things). A Quality is the boon, an Inferiority
    # the drawback; each has a Minor/Major Magnitude, exactly as a Virtue/Flaw
    # has a size. Counts from ground-truth.json: 49 total — 29 Qualities, 20
    # Inferiorities; 30 Minor, 19 Major.

    #t0S20p4ukYprl7T0PeIGzgKj ^"Magic Quality" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Magnitude" ENUM ["Minor", "Major"] REQUIRED
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A Magic Quality: the Magic Realm's analogue of a character Virtue, taken by magic things instead of Virtues."
    }

    #toHIbgCNPxhRNaJMPess8K6n ^"Magic Inferiority" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Magnitude" ENUM ["Minor", "Major"] REQUIRED
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A Magic Inferiority: the Magic Realm's analogue of a character Flaw."
    }

    # The pp.38-39 insert rosters the Powers that magic creatures commonly share.
    # The insert is the only roster of them; several are named again by a stat
    # block. Cost / initiative / Form are soft ("Variable points", "Init equal
    # to (Qik - 5)"), so the write-up text is kept verbatim in the description
    # rather than forced into numeric fields.
    #tbQ683ClGPQQ2UpLbIXsx7h3 ^"Common Magic Power" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Page" INTEGER
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A Power commonly available to magic creatures, from the pp.38-39 insert."
    }

    # Chapter Eight's Things of Virtue: herbs, objects, formed stones and trees
    # that carry raw magic. 25 total (6 herb, 9 object, 6 formed stone, 4 tree).
    # 13 of them carry a Shape and Material Bonus, kept verbatim from the book's
    # own bonus inserts.
    #tnp9TrC5RiJqUQ7DdDtkCBul ^"Thing of Virtue" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Group" ENUM ["herb", "object", "formed stone", "tree"] REQUIRED
            ^"Shape and Material Bonus" STRING
            ^"Page" INTEGER
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A Thing of Virtue: a herb, object, formed stone or tree that carries raw vis and confers a Virtue when Enriched."
    }

    # Magic characters (character guides, templates, and type summaries) and the
    # Appendix's mundane beasts are SOFT stat blocks: this book prints ranges and
    # descriptive values ("Magic Might: 0-10 (Animal)"), so every field is kept
    # as a verbatim STRING — no number is invented. Each printed field label is
    # its own typed, queryable property. The label set is the full universe from
    # the verified ground truth.
    #tkHQwIw27s2JEQNqDUseWeLJ ^"Magic Character" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Shape" ENUM ["character", "template", "type summary"]
            ^"Insert Title" STRING
            ^"Page" INTEGER
            ^"Magic Might" STRING
            ^"Characteristics" STRING
            ^"Characteristics and Size" STRING
            ^"Abilities and Combat Scores" STRING
            ^"Size" STRING
            ^"Virtues and Flaws" STRING
            ^"Personality Trait" STRING
            ^"Abilities" STRING
            ^"Vis" STRING
            ^"Powers" STRING
            ^"Combat" STRING
            ^"Soak" STRING
            ^"Wound Penalties" STRING
            ^"Season" STRING
            ^"Appearance" STRING
            ^"Fatigue Levels" STRING
            ^"Confidence Score" STRING
            ^"Reputations" STRING
            ^"Magic Qualities and Inferiorities" STRING
            ^"Magical Qualities and Inferiorities" STRING
            ^"Qualities and Inferiorities" STRING
            ^"Inherited Virtues" STRING
            ^"Typical Powers" STRING
            ^"Natural Weapons" STRING
            ^"Equipment" STRING
            ^"Common Flaws" STRING
            ^"Inherited Flaws" STRING
            ^"Encumbrance" STRING
            ^"Warping Score" STRING
            ^"Common Virtues (or Qualities)" STRING
            ^"Common Flaws (or Inferiorities)" STRING
            ^"Common Magical Powers" STRING
            ^"Notes" STRING
            ^"Age" STRING
            ^"Qualities" STRING
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A magic character stat block (character guide, template, or type summary) with soft, verbatim stats."
    }

    #tBFLKJ1X1J5nclbjYP1CLu9B ^"Mundane Beast" DEF {
        APPLIES TO [#tUdLc53gmrQsHS7jftR3biiN ^"Entity"]
        PROPERTIES {
            ^"Page" INTEGER
            ^"Magic Might" STRING
            ^"Characteristics" STRING
            ^"Characteristics and Size" STRING
            ^"Abilities and Combat Scores" STRING
            ^"Size" STRING
            ^"Virtues and Flaws" STRING
            ^"Personality Trait" STRING
            ^"Abilities" STRING
            ^"Vis" STRING
            ^"Powers" STRING
            ^"Combat" STRING
            ^"Soak" STRING
            ^"Wound Penalties" STRING
            ^"Season" STRING
            ^"Appearance" STRING
            ^"Fatigue Levels" STRING
            ^"Confidence Score" STRING
            ^"Reputations" STRING
            ^"Magic Qualities and Inferiorities" STRING
            ^"Magical Qualities and Inferiorities" STRING
            ^"Qualities and Inferiorities" STRING
            ^"Inherited Virtues" STRING
            ^"Typical Powers" STRING
            ^"Natural Weapons" STRING
            ^"Equipment" STRING
            ^"Common Flaws" STRING
            ^"Inherited Flaws" STRING
            ^"Encumbrance" STRING
            ^"Warping Score" STRING
            ^"Common Virtues (or Qualities)" STRING
            ^"Common Flaws (or Inferiorities)" STRING
            ^"Common Magical Powers" STRING
            ^"Notes" STRING
            ^"Age" STRING
            ^"Qualities" STRING
            ^"Source" STRING DEFAULT "Realms of Power: Magic"
        }
        DESCRIPTION "A mundane beast stat block from the Appendix (no Magic Might); soft, verbatim stats."
        REFERENCES {
            "Magic Might" -> #trg0A2ZR9HigaSPcNrgeDYXp ^"Magic Might"
        }
    }

    #tRoPMagCharCreateBudget01aa ^"Magic Character Creation" DEF {
        APPLIES TO [#taDz3ITq9fRoE374AgiL8VE4 ^"Creature"]
        PROPERTIES {
            ^"Characteristic Points" INTEGER 7 FIXED
            ^"Characteristic Max" INTEGER 3 FIXED
            ^"Spring Experience" INTEGER 120 FIXED
            ^"Summer Experience" INTEGER 360 FIXED
            ^"Autumn Experience" INTEGER 720 FIXED
            ^"Winter Experience" INTEGER 1200 FIXED
            ^"Quality Points" STRING "equal to Might Score"
            ^"Minor Quality Points" INTEGER 1 FIXED
            ^"Major Quality Points" INTEGER 3 FIXED
            ^"Grog Majors Allowed" STRING "No"
            ^"Source" STRING "Realms of Power: Magic"
            ^"Page" INTEGER 30
        }
        DESCRIPTION "Characteristics: 7 points assigned as in standard Detailed Character Creation (see ArM5 page 29), no Characteristic more than +3 or less than -3. Virtues and Flaws: Assign the character's Virtues and Flaws as in standard Detailed Character Creation, including a Social Status Virtue or Flaw. Size: Assign Size, with 0 indicating an average adult human. Add twice this value to the character's Strength, and subtract it from Quickness. Season determines the magic character's starting experience points, which are used to assign it scores in any Abilities the character can learn, based on its Virtues and Flaws. A spring character receives 120 experience points, a summer character receives 360, an autumn character receives 720, and a winter character receives 1200. Magic Might Score depends upon the power level of the saga and the character's role within it. Then choose Magic Qualities, magical powers, and other advantages, taking a number of Quality points equal to the character's Might Score. Magic Inferiorities give the character additional points to spend on Magic Qualities; like Virtues and Flaws, Minor Qualities and Inferiorities are worth 1 point, Major Qualities and Inferiorities are worth 3 points. Grog characters cannot take Major Inferiorities or Qualities."
    }
    #tRoPMagMinSizeTable01bbccdd ^"Magic Might Minimum Size Table" DEF {
        APPLIES TO [#taDz3ITq9fRoE374AgiL8VE4 ^"Creature"]
        PROPERTIES {
            ^"Table Columns" LIST ["Might Score", "Minimum Size"]
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "There are some magic characters made up of otherwise stationary matter from any Form made animate by the raw power of nature and the influence of the Magic Realm. This can include living things such as a magical tree or a statue of an animal made flesh, or nonliving things made up of nothing but raw material held together by magic. In either case, it is dependent upon its Size for its Magic Might — to gain more Might, its true form must somehow become larger. The following chart shows the minimum Size required for each level of Might Score."
        TABLE {
            "0" "–21"
            "1" "–18"
            "2" "–15"
            "3" "–12"
            "4" "–9"
            "5" "–6"
            "10" "–3"
            "15" "0"
            "(+5)" "(+3)"
        }
    }
    #tRoPMagAuraRecoverTable01ee ^"Aura Might Recovery Table" DEF {
        APPLIES TO [#taDz3ITq9fRoE374AgiL8VE4 ^"Creature"]
        PROPERTIES {
            ^"Table Columns" LIST ["Subtotal", "Recovery Time"]
            ^"Source" STRING "Realms of Power: Magic"
        }
        DESCRIPTION "Magic characters can recover Might Points more quickly when they rest in a Magic aura, though like mundane characters recovering Fatigue, the magic character cannot engage in strenuous activity while resting. The time in which the character's entire Might Pool replenishes depends on the strength of the aura modified by the magnitude of the character's Might Score, as shown below. Entire Recovery Time: Subtotal = Aura - (Might Score / 5), then refer to chart."
        TABLE {
            "0" "24 hours"
            "1" "12 hours"
            "2" "6 hours"
            "3" "3 hours"
            "4" "90 minutes"
            "5" "45 minutes"
            "6" "22 minutes"
            "7" "10 minutes"
            "8" "5 minutes"
            "9" "2 minutes"
        }
    }
}
