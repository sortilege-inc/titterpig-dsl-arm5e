            "1 – 3" "" "+1"
            "4 – 6" "" "+2"
            "7 – 10" "" "+3"
        }
        DESCRIPTION "The Aura Effect Table table from Realms of Power: Magic (page 15); rows reproduced verbatim from the source."
    }

    #tKtFrEzplRT5rLePq15ftySV ^"Magical Travel" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Page" INTEGER 23
            ^"Source" STRING "Realms of Power: Magic"
        }
        TABLE {
            "Familiarity" "Familiarity Modifier" ""
            "Enigmatic Wisdom" "" "score"
            "Magic Lore" "" "score"
            "Area Lore (Magic Realm)" "" "(score x 3)"
            "Knows name or description" "" ""
            "of the destination" "" "1"
            "Has seen the destination before" "" "3"
            "Visited the destination before" "" "6"
            "Arcane Connection to" "" ""
            "the destination" "" "15"
            "Speed Level" "Length of journey"
            "–1 or lower" "permanent"
            "0" "seven plus a stress die"
            "" "(no botch) years"
            "3" "seven years"
            "6" "Year"
            "9" "one season"
            "12" "Moon"
            "15" "day (24 hours)"
            "18" "Sun"
            "21" "two hours"
            "24" "Diameter (2 minutes)"
            "27" "one minute"
            "30+" "Momentary"
        }
        DESCRIPTION "The Magical Travel table from Realms of Power: Magic (page 23); rows reproduced verbatim from the source."
    }

