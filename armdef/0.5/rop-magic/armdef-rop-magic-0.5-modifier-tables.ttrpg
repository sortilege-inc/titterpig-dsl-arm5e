    #tmpX8A2p8d65kL0zdzZlNC3b ^"How Big is a Giant?" DEF {
        APPLIES TO [^"Entity"]
        PROPERTIES {
            ^"Page" INTEGER 84
            ^"Source" STRING "Realms of Power: Magic"
        }
        TABLE {
            "Size" "Height" "Weight"
            "-2" "2’9” - 3’9”" "22 - 46 lbs"
            "-1" "3’9” - 4’9”" "46 - 100 lbs"
            "0" "4’9” - 6’2”" "100 - 215 lbs"
            "+1" "6’2” - 8’" "215 - 465 lbs"
            "+2" "8’ - 10’" "465 - 1000 lbs"
            "+3" "10’ - 13’" "1000 - 2150 lbs"
            "+4" "13’ - 17’" "2150 - 4600 lbs"
            "+5" "17’ - 22’" "2 1/2 - 5 tons"
            "+6" "22’ - 28’" "5 - 10 tons"
            "+7" "28’ - 37’" "10 - 23 tons"
            "+8" "37’ - 47’" "23 - 50 tons"
            "+9" "47’ - 61’" "50 - 107 tons"
            "+10" "61’ - 79’" "107 - 230 tons"
            "+15" "220’ - 280’" "5,000 - 10,800 tons"
            "+20" "800’ - 1000’" "230,000 - 500,000 tons"
        }
        DESCRIPTION "The How Big is a Giant? table from Realms of Power: Magic (page 84); rows reproduced verbatim from the source."
    }}
