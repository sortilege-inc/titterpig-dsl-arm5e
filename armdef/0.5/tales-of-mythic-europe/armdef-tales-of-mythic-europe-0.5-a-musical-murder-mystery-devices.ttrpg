EXTENSION "ARMDef_Tales_of_Mythic_Europe_AMusicalMurderMystery_Devices" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Seven: A Musical Murder Mystery devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t85e0b579ea780f9a17c9c5 ^"Cacophonic Armor" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 58
            ^"Penetration" STRING "+5"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "PeVi 58 Pen +5, Unlimited R: Touch, D: Performance, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "Due to the distorting effects of the flute’s music, any person who plays the flute is granted a limited form of Magic Resistance. This effect is similar to the Hermetic spell Unravelling the Fabric of (Form) (ArM5, page 161), except that it affects all forms, and will cancel spells of level 20 or less. This power will only protect the flutist from one spell per round.\n\n(Effect: Non-Hermetic, base 40, +1 Performance)"
    }

    #te81df3094533f26873c172 ^"Disharmony" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 78
            ^"Penetration" STRING "+35"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "CrVi 78 Pen +35, Unlimited R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 108
        }
        DESCRIPTION "The music created by the flute causes mystical disruptions in its targets by inflicting Warping. For beings with Magic Resistance, this power must first Penetrate. If it does, it inflicts one Warping Point per ten rounds that the target is exposed to the flute’s music. This power also affects the player of the flute; the Flaws inflicted by the Warping relate to the flute’s Madness power.\n\n(Effect: Non-Hermetic, base 20, +3 Voice, + 3 Group)"
    }

    #ta74cbf923f656f59e166c1 ^"Frenzied Fortitude (optional)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReCo 25 Pen 0, Unlimited R: Touch, D: Performance, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "This optional power causes the flute player to gain an unnatural resistance to pain and injury. The flute player suffers no penalties from Wounds or lost Fatigue levels, meaning that the player can physically exert himself for extended periods, such as when running or fighting. The flutist is still wounded however, and can be incapacitated or killed by damage inflicted in a battle.\n\n(Effect: Non-Hermetic, base 10, +1 Touch, +1 Performance)"
    }

    #taf5c606adb0fa7c983cb08 ^"Madness" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 73
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "+35"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "PeMe(An) 73 Pen +35, Unlimited R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "This power causes all who hear the music to be driven irrevocably mad. The madness caused by this power is cumulative, and it takes a short time of listening for the full effects to manifest. Hearing the flute’s music for only a moment causes dread. Listening for longer than ten rounds creates a morbid fascination with the music, creating a permanent Personality Trait of “Obsessed with the flute’s music” +1. Every ten rounds thereafter, the Obsessed Personality Trait increases by 1. After a minute, the listener becomes repulsed and terrified by the music, as though he were permanently affected by the spell Black Whisper (ArM5, page 150). This power affects both animals and people. Deaf targets are completely unaffected by this power.\n\nThe player of the flute suffers from the obsessions created by this power and is also driven insane. The flutist, however, is not driven suicidally insane, but rather develops a pathological hatred of all music other than that of the flute (this effect becomes a part of the flutist’s essential nature through the Warping effects of the Disharmony power).\n\n(Effect: Non-Hermetic, base 15, +3 Voice, +3 Group)"
    }

    #t1a963a8af7772ecbc21b97 ^"Obsession (Tales of Mythic Europe)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Obsession"
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 48
            ^"Penetration" STRING "+5"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuMe 48 Pen +5, Unlimited R: Sight, D: Moon, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "This power creates an overwhelming obsession in the mind of anyone with a musical aptitude who sees the flute. If affected by this power, a person with an experience point in Music Ability, or Virtue such as Free Expression, Enchanting Music, or a similar characteristic, becomes obsessed with possessing and playing the flute. This obsession is not permanent, and gradually subsides over the course of a month or so if the target does not see the flute for that time. This power only comes into effect if the flute is not in the possession of someone with a musical ability, Virtue, or Flaw, and when in effect is constant. (For example, if separated from Bartholomew, this power will activate; in his possession the power is dormant.)\n\n(Effect: Non-Hermetic, base 4, +4 Sight, +2 Moon)"
    }

    #t5b7a27b5c2e15fdd746f46 ^"Strength of the Insane (optional)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "MuCo 45 Pen 0, Unlimited R: Touch, D: Performance, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "This optional power grants the flutist supernatural strength, granting a +5 bonus to Strength- and Stamina-related totals. It further allows the flute player to act as if he had the Reserves of Strength Virtue (ArM5, page 48).\n\n(Effect: Non-Hermetic, base 25, +1 Touch, +1 Performance)"
    }

    #t701764aba1432c78353779 ^"Summon Music Spirit" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 75
            ^"Penetration" STRING "+30"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Arc"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Effect Line" STRING "ReVi 75 Pen +30, Unlimited R: Arc, D: Mom, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "Using this power is only possible once all other sources of music are silent for many leagues surrounding the flute. It requires that the flutist play a unique song on the flute, after which the Music Spirit is summoned (see Music Spirit insert near the end of this chapter).\n\n(Effect: Non-Hermetic, base 30, +4 Arcane Connection)"
    }

    #t67dbfd7b8ab85221447cbe ^"Undulation" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Flute"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 58
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "+5"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Effect Line" STRING "PeCo(An) 58 Pen +5, Unlimited R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "The music of the flute causes unnatural sounds that react violently with the bodies and humors of living creatures. After 3 rounds of being exposed to the music, the targets begin to be physically harmed by the magical sounds, suffering a Light Wound, as their internal organs begin to rupture. For every 5 rounds, this damage increases one category — rising up to a Medium Wound, then a Heavy Wound, and so on. This power affects all those in earshot, animal and human alike, but does not affect the player of the flute.\n\n(Effect: Non-Hermetic, base 15, +3 Voice, +3 Group)"
    }

}
