EXTENSION "ARMDef_Tales_of_Mythic_Europe_FallAndRise_Devices" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Four: Fall and Rise devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t76807bfc8654e56465b471 ^"Leap of Homecoming (Severin’s Talisman)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Leap of Homecoming"
            ^"Part Of" STRING "Severin’s Talisman"
            ^"Owner" STRING "Severin of Tytalus"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Uses" STRING "1 use per day"
            ^"Printed Effect Line" STRING "(ReCo 35, 1 use per day)"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 54
        }
        DESCRIPTION "triggered if the holder collapses while touching the staff. This is meant to trigger if Severin is overcome by his enemies, but he can also trigger it consciously, by going limp and falling over."
    }

    #tf677c8daca2c669fa8ada7 ^"Endurance of the Berserkers (Severin’s Talisman)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Endurance of the Berserkers"
            ^"Part Of" STRING "Severin’s Talisman"
            ^"Owner" STRING "Severin of Tytalus"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Uses" STRING "1 use per day"
            ^"Printed Effect Line" STRING "(ReCo15, 1 use per day)"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 54
        }
        DESCRIPTION "triggered by the holder biting his tongue. This is meant to give Severin the energy to flee if seriously harmed."
    }

}
