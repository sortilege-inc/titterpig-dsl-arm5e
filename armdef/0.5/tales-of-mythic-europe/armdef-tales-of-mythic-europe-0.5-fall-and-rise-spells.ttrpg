EXTENSION "ARMDef_Tales_of_Mythic_Europe_FallAndRise_Spells" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Four: Fall and Rise spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t9be367de21281144328c34 ^"Acorns For Amusement" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 5 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This spell, taught to apprentices initially as an amusing game that allows them to vandalize their immediate environment with acorns, becomes a surprisingly effective spell in adult combat. It allows the magus to fling at a target any single piece of wood that is within Voice range and that is smaller than a pace long, wide, and deep. The damage a piece wood does when it strikes a target ranges from +1, for small, blunt piece, right up to +10 for logs a yard across. Severin usually carries a special hip quiver of sharpened, unfletched arrow shafts, although he has lost this in faerie. An individual shaft does +4 Damage.\n\n(Base 3, +2 Voice)"
    }

    #t90638a0d24b0ea66d26b3b ^"Carnivorous House" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Printed Stat Line" STRING "ReHe 35 R: Touch, D: Sun T: Structure"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This spell, designed to torment Severin’s beloved rival and then discovered to be effective in combat, allows him to animate wooden buildings. The building can accept simple commands, and follow them with some intelligence, without the oversight of the magus. Animate houses can appear to be haunted, because they creak and shift, while doors slam and furniture moves around of its own volition. In battle, a building moves at half the walking pace of a human, but can absorb a great deal of damage if constructed properly. Severin often prepares the house by packing it with statues, using the Rough-Hewn Servant spell, also given here.\n\nThis spell also allows Severin to animate other large wooden objects, like carriages, huge statues, and ships.\n\n(Base 10, +2 Sun, +3 Structure)"
    }

    #t1ae7cc09f1c60c63941a88 ^"Carved Assassin" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 20 R: Touch, D: Sun T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This highly useful spell animates a wooden object so that it follows simple commands, and solves simple problems, without the direct oversight of the magus. The object must be wooden, and no larger than a pace square. Severin often makes statues that suit his needs with the RoughHewn Servant spell, also given here.\n\n(Base 10, +2 Sun)"
    }

    #td55eecfcf3a3b42bc99db4 ^"Enemies All Aquiver" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReHe 10 R: Touch, D: Mom, T: Group"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This spell flings the wooden contents of a container into a group of enemies. So that this spell does not require requisites, Severin usually carries a special hip quiver of sharpened, unfletched arrow shafts, although he has lost this in Faerie. A quiver-full of arrows does +8 Damage.\n\n(Base 3, +1 Touch, +2 Group)"
    }

    #tc11c9bb8c3a841a58f56dd ^"Rickety Stack" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 5
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 5 R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This is a very simple spell, designed to teach apprentices Finesse. It allows magi to toss about small pieces of wood, and when played as a game, the idea is to make the pieces land on their ends (to practice Finesse) or form rickety piles, with the loser being the apprentice whose added stick makes the pile collapse. After apprenticeship is over, magi can use it to move wooden objects up to a pace across, at walking speed.\n\n(Base 3, +2 Voice)"
    }

    #t63a48b0a0b35e76ecfa11b ^"Rough-Hewn Servant" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReHe 10 R: Touch, D: Mom, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This is a spell for carving a statue from a single block of wood. The piece of wood can be no larger than one cubic pace. This spell requires a Perception + Finesse roll. If this is botched the statue is ruined. If the roll exceeds the Ease Factor of 6, then the statue is serviceable, if not particularly pretty, and can be animated with the Carved Assassin spell. If the roll is not successful, then a statue is created, but it is too fragile or too blockish to use effectively with the Carved Assassin spell.\n\n(Base 5 (see *Covenants*, page 50), +1 Touch)"
    }

    #tbccafa1a04b770c068a886 ^"Tomb of Kaineus" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReHe 20 R: Voice, D: Mom, T: Group"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 55
        }
        DESCRIPTION "This spell collects a tremendous weight of wood, grass, straw, and other plant material and dumps it on the target, burying that target completely. This spell needs to be aimed, but has a +12 bonus on the Aiming roll because of the sheer quantity of material involved, at slightly over one hundred cubic paces. It is designed to immobilize enemies who cannot be hurt directly because of their Magic Resistance. The name of the spell refers to the death of an ancient Greek hero with unbreakable skin. His enemies defeated him by piling tree trunks upon him until he could not move, and he suffocated.\n\n(Base 3, +2 Voice, +2 Group, +1 size of group)"
    }

}
