EXTENSION "ARMDef_Tales_of_Mythic_Europe_TheChampionsPortion_VisSources" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Two: The Champion’s Portion vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #t59ededd25cabf20a00f406 ^"Dún Rudraige (vis source)" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Terram"
            ^"Yield" LIST OF STRING ["six pawns"]
            ^"Location" LIST [#tbc894bf81198bb4f722d04 ^"Dún Rudraige"]
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 31
        }
        DESCRIPTION "Bricriu anticipates that many challenges will happen before the champion’s portion is awarded. He gives a gold or silver armband to the winner of every contest, removing one from his muscular arm and awarding it to the winner. The Heroes already have many armbands, and sometimes give them to the judge of the event they just won. The first six of these contain a pawn of raw Terram vis. Over the course of a year, the regio produces six pawns in this form. These armbands are the annual vis that Muirgen has collected in the past, using her Embitterment power to threatened holders into giving them to her. Bricriu recognizes that her power is close to his own, and does not allow his Heroes to hurt the maga."
    }

}
