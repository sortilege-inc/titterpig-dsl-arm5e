EXTENSION "ARMDef_Tales_of_Mythic_Europe_TheHospitalsDue_Devices" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Five: The Hospital’s Due devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tf4a31eea0f2ebca1e1e773 ^"Ring of Highland Ken" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Owner" STRING "Eleanor of Mercere"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Vision"
            ^"Printed Effect Line" STRING "InTe 25 Pen 0, constant effect R: Touch, D: Sun, T: Vision"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "This ring, when worn, works as the Hermetic spell Eyes of the Treacherous Terrain, ArM5 page 153. This ring was a gift from her parens when she completed her Gauntlet."
    }

    #t8472ba943110359a55c1bf ^"St. Peter’s Rhombus" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Owner" STRING "Eleanor of Mercere"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "PeVi 35 Pen 0, 1/day R: Voice, D: Mom, T: Room"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "As per Wind of Mundane Silence, ArM5 page 161, with a level 15 effect. This magical device was named for St. Peter, who according to legend dispelled the magic of Simon Magus. The rhombus must be whirled or spun in the air to activate the device. It was given to Eleanor by a grateful arch-magus several months before she became ill."
    }

}
