EXTENSION "ARMDef_Tales_of_Mythic_Europe_TheHospitalsDue_Relics" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Five: The Hospital’s Due relics"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's relics, structured; each DESCRIPTION the source's text, verbatim.

    #t58a2cbc32cac815261cfa4 ^"The Finger Bone of St. Ubaldesca" DEF {
        EXTENDS #t65b2b61b9cea3054a893d1 ^"Holy Relic"
        PROPERTIES {
            ^"Owner" STRING "Priory Constable Hermann of Cologne"
            ^"True Faith" INTEGER 3
            ^"Divine Might" INTEGER 30
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 74
        }
        DESCRIPTION "The relic carried by Hermann of Cologne is a finger bone of St. Ubaldesca from the hand that first miraculously turned water into wine. As a major relic, it has a power that it can regularly bestow upon its owner. It has a True Faith score of 3 and a Divine Might of 30, which grants Hermann a Magic Resistance score of 30 when he carries the relic. It also possesses the *Mass Healing* power of St. Ubaldesca. Like all relics, the finger bone radiates an aura that is anathema to infernal beings with a radius of 30 feet. Infernal creatures with an Infernal Might of less than 30 are unable to enter the radius, and infernal creatures that can approach the relic take +30 damage each round that they remain close to the relic."
    }

}
