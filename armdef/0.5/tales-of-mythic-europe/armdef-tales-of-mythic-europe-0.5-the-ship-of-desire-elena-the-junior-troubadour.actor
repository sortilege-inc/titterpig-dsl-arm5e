EXTENSION "ARMDef_Tales_of_Mythic_Europe_TheShipOfDesire_ElenaTheJuniorTroubadour" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Elena the Junior Troubadour"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # Elena the Junior Troubadour (Chapter Three: The Ship of Desire, p42): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t5f04105ef847654e0fb473 ^"Elena the Junior Troubadour" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –2, Per –1, Pre +3, Com +3, Str –1, Sta 0, Dex +1, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "22 (22)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Wanderer; Affinity with Enchanting Music, Enchanting Music; Fear (of forests), Lame"
            ^"Personality Trait" STRING "Loyal (to getting home) +3, Shy +3, Inquisitive +2"
            ^"Reputations" STRING "Musician 3"
            ^"Combat" STRING "Dodge: Init –2, Attack n/a, Defense –4, Damage n/a Kick: Init –3, Attack +0, Defense –3, Damage +2"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Awareness 2 (searching), Charm 1 (men), Concentration 2 (playing music), Enchanting Music 7 (making audiences sad), English 2 (curses), French 2 (dining), Music 4 (psaltery), Occitan 5 (poetry)"
            ^"Equipment" STRING "Elena’s sole possession of worth is her psaltery, a stringed instrument with a sounding board, like a small zither. It is easily portable and fits in her lap."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Elena wears a dark green dress under a gray traveling cloak. She has dark hair, worn in a single long braid down her back, and dark eyes. She wears a small cloth hat to cover her head, but her braid is visible, in defiance of convention. Her right leg is shorter than her left, making her limp when she moves."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "Elena is young, twenty or so, and scared. Her love is music, which is also her protector, succor, and savior. She has seen terrible things already in her young life, and has been frightened like none other she knows. Carelia is her protector, but is often too stern to provide comfort or emotional support. That she finds in music. Where Carelia has built stone walls around her heart, Elena’s is untried. She has not loved, and the stirrings in her heart will be too much for her to handle. She has no experience with romance, having been shielded from its snares by Carelia."
    }

}
