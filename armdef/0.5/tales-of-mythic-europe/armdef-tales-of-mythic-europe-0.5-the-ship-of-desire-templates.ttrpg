EXTENSION "ARMDef_Tales_of_Mythic_Europe_TheShipOfDesire_Templates" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Three: The Ship of Desire templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #tbc8fd6ef0a899531860415 TEMPLATE "The Sailors" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int –1, Per 0, Pre –1, Com –1, Str +1, Sta +2, Dex +2, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Virtues and Flaws" STRING "Wanderer; Tough; Compulsion (various dockside vices)"
            ^"Personality Trait" STRING "Vulgar +2, Brave +1, Loyal (to Folbert) +1"
            ^"Combat" STRING "Bludgeon: Init +1, Attack +8, Defense +5, Damage +3 Fist: Init +1, Attack +7, Defense +6, Damage +1 Dagger: Init +1, Attack +8, Defense +5, Damage +4"
            ^"Soak" STRING "+5"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Athletics 2 (aboard ship), Awareness 3 (at sea), Brawl 4 (fists), Carouse 3 (getting drunk), English 3 (tavern talk), Flemish 5 (songs), Flemish Coast Lore 3 (coves), Folk Ken 2 (prostitutes), French 4 (tavern talk), Guile 2 (accountability), Profession: Sailing 4 (rough weather), Swim 3 (calm waters)"
            ^"Equipment" STRING "Sailing clothes"
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "The sailors all look like sailors: sunburned arms and faces, calloused hands, and weathered clothing."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 46
        }
        DESCRIPTION "*La main blanche* has four sailors, although one is actually Cupid in disguise. They are named Colbert, Emont (Cupid), Gerland, and Norbert. They have known each other for four or five months, as Folbert hires new crew-members and fires troublesome ones. The sailors are grog-level NPCs.\n\nColbert, Gerland, and Norbert will certainly notice that Emont is not pulling his weight. Rather than suspect that Emont is really Cupid, they will merely think him lazy, and will complain to their captain. PCs could easily overhear such complaints."
    }

}
