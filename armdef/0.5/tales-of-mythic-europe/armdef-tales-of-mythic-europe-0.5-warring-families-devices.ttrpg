EXTENSION "ARMDef_Tales_of_Mythic_Europe_WarringFamilies_Devices" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Nine: Warring Families devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t6815b114405d2ecd79ebff ^"Ensorcell the Luciferian Spirit" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Reliquary"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 45
            ^"Penetration" STRING "+42"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Special"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4 (by analogy with ReCo), +2 Special (based on Touch), +2 Sun; +1 2/day, +3 environmental trigger, +21 Penetration)"
            ^"Printed Effect Line" STRING "ReVi 45 Pen +42, Constant Effect R: Special, D: Sun, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 149
        }
        DESCRIPTION "This magical device traps any one Infernal spirit within the reliquary, making it unable to move beyond the boundaries of the box. The effect is activated when the door is closed, and ended if the door is reopened. This effect cannot draw a spirit into the reliquary; the item’s creator used a spell for that. The effect must Penetrate, and thus can, normally, affect a creature with an Infernal Might of 41 or lower. However, both Magic Resistance and Penetration are affected by the local aura (ArM5, page 183); in a Divine or Magic aura, the affected Might is effectively increased by twice the aura, while in an Infernal aura it is decreased by twice the aura. The demon currently held is weak enough to be restrained in any Infernal aura, but the crafter was not sure of that."
    }

    #t7631d8165ac4c08fcebacf ^"Pious Veil of Hermetic Might" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Reliquary"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 60
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "Constant Effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 30, +1 Touch, +2 Sun; +1 2/day, +3 environmental trigger, +11 Penetration)"
            ^"Printed Effect Line" STRING "PeVi 60 Pen +22, Constant Effect R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 149
        }
        DESCRIPTION "This enchanted gem suppresses the supernatural powers of a single infernal creature touching it, up to level 20 (or powers from creatures with a Might score of 20 or less; see **ArM5**, page 191). The gem actually reaches the inside of the reliquary, through a tiny hole, thus touching the demon within."
    }

    #ta375176e2e5978eea986a7 ^"Seal Evil Within" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "The Reliquary"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 4
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Base 4)"
            ^"Printed Effect Line" STRING "ReTe 4 Pen 0, 1/day R: Per, D: Mom, T: Ind"
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 149
        }
        DESCRIPTION "This effect moves the metal of the reliquary, as if worked by a metalsmith, to seal the door shut. A Perception + Finesse roll by the person using the reliquary determines how elegant the seal appears. Although the magic is momentary, the metal remains sealed after it ends. The seal must be broken by mundane means, but the magic can seal it again. It is activated by closing the reliquary’s door and closing the latch."
    }

}
