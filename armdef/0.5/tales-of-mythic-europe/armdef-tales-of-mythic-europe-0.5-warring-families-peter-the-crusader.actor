EXTENSION "ARMDef_Tales_of_Mythic_Europe_WarringFamilies_PeterTheCrusader" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Peter the Crusader"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # Peter the Crusader (Chapter Nine: Warring Families, p138): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tebac14ae1de2a5da53dd78 ^"Peter the Crusader" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int 0, Per 0, Pre 0, Com –1, Str +1, Sta +1, Dex +1, Qik +2 (2)"
            ^"Size" STRING "0"
            ^"Age" STRING "41 (41)"
            ^"Decrepitude" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Peasant; Warrior, Well-traveled; Close Family Ties, Meddler (Minor), Proud (Minor)"
            ^"Personality Trait" STRING "Brave +3, Honest +3, Loyal +2"
            ^"Reputations" STRING "Honorable Crusader +3 (local), Influential Villager +3 (local)"
            ^"Combat" STRING "Axe: Init +3, Attack +11, Defense +7, Damage +7"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Animal Handling 5 (horses), Area Lore: Local 3 (farms), Area Lore: Crusader Routes 2 (Fourth Crusade), Athletics 3 (climbing), Awareness 3 (dinner table), Bargain 4 (sheep), Bows 2 (sieges), Brawl 3 (multiple opponents), Carouse 4 (speedy eating), Charm 4 (family), Etiquette 2 (armies), Folk Ken 4 (family), Great Weapon 3 (pole-arm), Greek 3 (ordering food), Music 2 (food hall songs), Native Language 5 (compliments), Profession: Farming 5 (large farms), Single Weapon 5 (axe), Survival 2 (armies), Swim 1 (rivers)"
            ^"Equipment" STRING "Axe, farming tools, leather armor."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Peter is a middle-aged, balding man, his once-dark brown hair now mostly grey. His face is deeply lined and tanned. Peter covers his head in a leather cap, and wears well-crafted but simple clothes — a tunic and leggings."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 138
        }
        DESCRIPTION "Peter is a bastard son of a local noble, has never been acknowledged, and lives as an influential peasant. Two decades ago, at the age of twenty, Peter decided to leave his home to join the Fourth Crusade. In the course of his expedition, he came into possession of a powerful Hermetic device. Mistaking it for the container of a magnificent relic, Peter returned to his home village with the pillaged device. Once home, Peter gifted the reliquary to the village’s church, where it was ceremonially placed in a position of great honor.\n\nPeter’s prestige was greatly increased by this gift, and by the other riches he returned with from the crusade. He is now a middle-aged man, with a wife and several children, and occupies an influential position in the village. His chief rival in the village is the Baldwin, a proud elder whose family was traditionally the most important and authoritative.\n\nAlthough Peter was once quite wealthy, most of the treasure he brought back from the Holy Land is now gone. He now has little free time, although he does control more land than the other families in the village."
    }

}
