EXTENSION "ARMDef_Tales_of_Mythic_Europe_WarringFamilies_TheDemon" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - The Demon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The Demon (Chapter Nine: Warring Families, p150): one being, its printed stat lines verbatim fields.

    #ta84b8c094832474dce9fad ^"The Demon" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Might Realm" STRING "Infernal" FIXED
            ^"Order" STRING "Vessel of Iniquity"
            ^"Might" INTEGER 20
            ^"Form" STRING "Mentem"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER 1
                ^"Perception" INTEGER -1
                ^"Presence" INTEGER -3
                ^"Communication" INTEGER -2
                ^"Strength" INTEGER 2
                ^"Stamina" INTEGER 2
                ^"Dexterity" INTEGER 0
                ^"Quickness" INTEGER 0
            }
            ^"Size" INTEGER 1
            ^"Confidence Score" STRING "3 (15)"
            ^"Virtues and Flaws" STRING "Puissant Guile; Hatred (Minor, Hermetic magi)"
            ^"Reputations" LIST ["Tainter of Fields +1 (Infernal)"]
            ^"Hierarchy" INTEGER 1
            ^"Soak" INTEGER 2
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Weakness" STRING "Ordering (the demon has no power over anything that is sealed or tied up, although it must be tightly and deliberately sealed)."
            ^"Vis" STRING "4 pawns Mentem vis that coagulates as an oily, fatty lump about the size of a fist."
            ^"Appearance" STRING "If it appears in its physical form, the demon appears as pure lies and deceit. This is simply a morass of matter and emotion (see Form of Wickedness power). The demon can also take the form of any person it desires (see Form of Man power)."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 150
        }
        PERSONALITY_TRAITS {
            "Hateful" +6
            "Depraved" +6
            "Treacherous" +5
            "Deceptive" +4
        }
        COMBAT {
            "Fist" INIT 0 ATTACK 0 DEFENSE 0 DAMAGE 2
        }
        ABILITIES {
            "Awareness" SCORE 6 SPECIALTY "spirits"
            "Guile" SCORE 8 BONUS 2 SPECIALTY "betrayal"
        }
        POWERS {
            #t4c98885c4b1899a05982ee ^"Form of Man (Tales of Mythic Europe)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Form of Man"
                    ^"Cost" STRING "0 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Corpus"
                }
                DESCRIPTION "The demon may shapeshift into any human form it desires, and may even mimic people."
            }
            #tb7b613b454814a8ecd189e ^"Form of Wickedness (Tales of Mythic Europe)" DEF {
                PROPERTIES {
                    ^"Printed Name" STRING "Form of Wickedness"
                    ^"Cost" STRING "3 points"
                    ^"Initiative" STRING "0"
                    ^"Form" STRING "Mentem"
                }
                DESCRIPTION "This power allows the demon to materially embody lies and betrayal, causing the nearest 10 people to immediately succumb to the sin of Avarice. The affected people must make a Stamina roll against an Ease Factor of 6 to end the power’s hold (they may make one roll each hour). This form can only be maintained for 1 round (although the power lasts beyond that time)."
            }
            #ted17ae74f6d73f9a973ad2 ^"Taint the Lands of Adam" DEF {
                PROPERTIES {
                    ^"Cost" STRING "10 points"
                    ^"Initiative" STRING "+10"
                    ^"Form" STRING "Vim"
                }
                DESCRIPTION "This power allows the demon to create Infernal auras around itself, and slowly spread that aura to the surrounding lands. The taint spreads five miles every month, and stops after two years. It cannot cross major landmarks, such as rivers, forests, mountains, or city walls (although streams and woods pose no hindrance). The Infernal aura also increases its rating slowly, starting at its center and increasing by 1 each month to a maximum of 4. Unlike most Infernal auras, the aura created by the demon is a Perfidious aura, even in low rating areas. In other respects the aura acts as a normal Infernal aura, and can be increased (or decreased) through human agency; it increases at night, and decreases during religious events."
            }
        }
        DESCRIPTION "These traits are included in the event that the characters release the demon from the reliquary. See *Realms of Power: The Infernal* for more information on the demon’s other powers."
    }

}
