EXTENSION "ARMDef_Tales_of_Mythic_Europe_WhatLiesBeneath_Books" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Chapter Ten: What Lies Beneath books"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # The chapter's books, structured; each DESCRIPTION the source's text, verbatim.

    #tfdbd2874f246fa40140a43 ^"De Operatione Daemonum" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "De Operatione Daemonum"
            ^"Kind" STRING "Tractatus"
            ^"Subject" STRING "Infernal Lore"
            ^"Quality" INTEGER 7
            ^"Section" STRING "Infernal Texts"
            ^"Printed Entry" STRING "Tractatus on Infernal Lore with a Source Quality of 7."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 163
        }
        DESCRIPTION "This tractatus by the Byzantine Michael Psellus purports to be a classification of demons, but Psellus’ hand was guided by the very demons he writes of, so few of the details may be relied upon with any certainty.\n\nThis copy is a somewhat small book, clearly very old, and apparently written by many different hands (a strange affliction that affects any copy made of this book)."
    }

    #t5d4155239b46174ebbaca4 ^"Liber Apologeticus" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Liber Apologeticus"
            ^"Kind" STRING "Tractatus"
            ^"Subject" STRING "Infernal Lore"
            ^"Quality" INTEGER 8
            ^"Section" STRING "Infernal Texts"
            ^"Printed Entry" STRING "Tractatus on Infernal Lore with a Source Quality of 8."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 163
        }
        DESCRIPTION "On casual inspection, this tractatus by the Manichaean preacher Priscillian of Ávila appears to be a book on Christian Theology. The orthodox content has been corrupted, however, and the many allusions to magic and misleading theological ideas it actually contains may be studied towards understanding of the Infernal.\n\nSome pages appear to have been cut from the book. None of the Infernal content is missing, so this does not impair study, but it does plant the seed of curiosity in the mind of the reader. Treat a season studying the Apologeticus as a season of personal influence (*Realms of Power: The Infernal*, page 23) with a total of 8 + the characters worst “negative” personality trait. For Daniel, this is his “Resentful +2” for a total of 10. This provides a further “Curious about the Infernal” personality trait."
    }

}
