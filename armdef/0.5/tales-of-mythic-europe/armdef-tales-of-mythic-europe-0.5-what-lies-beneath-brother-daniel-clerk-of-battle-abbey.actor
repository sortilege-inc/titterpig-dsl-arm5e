EXTENSION "ARMDef_Tales_of_Mythic_Europe_WhatLiesBeneath_BrotherDanielClerkOfBattleAbbey" {
    NAME "Ars Magica Fifth Edition, Tales of Mythic Europe - Brother Daniel, Clerk of Battle Abbey"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_Tales_of_Mythic_Europe_Core_Ext"

    # Brother Daniel, Clerk of Battle Abbey (Chapter Ten: What Lies Beneath, p156): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t217a1e65034a10bd6da21a ^"Brother Daniel, Clerk of Battle Abbey" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Characteristics" STRING "Int +1, Per 0, Pre –1, Com +2, Str 0, Sta +1, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "30 (30)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Educated, Clerk, Student of Infernal, Sense Holiness and Unholiness, Dark Secret (Infernally corrupted), Judged Unfairly, Monastic Vows, Weak Characteristics"
            ^"Personality Trait" STRING "Nervous +1, Resentful +2, Self-Critical +2, Curious about the Infernal +1"
            ^"Reputations" STRING "Easily Corrupted (Infernal) 1"
            ^"Combat" STRING "Dodge: Init +0, Attack N/A, Defense +1, Damage N/A Fist: Init +0, Attack +1, Defense +1, Damage 0"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Romney Marsh Lore 3 (geography), Artes Liberales 4 (arithmetic), Awareness 2 (noticing people talking about him), Brawl 1 (bludgeon), Church Lore 3 (abbeys), Civil and Canon Law 3 (Lex Marisci), Concentration 1 (rituals), English 5 (Sussex dialect), Etiquette 2 (the church), Folk Ken 3 (clergy), Guile 3 (elaborate lies), Infernal Lore 2+2 (demons), Latin 4 (church ceremonies), Medicine 2 (apothecary), Norman French 2 (expansive vocabulary), Philosophiae 2 (natural philosophy), Profession: Clerk 3 (finances), Profession: Scribe 3 (copying), Sense Holiness and Unholiness 2 (auras), Theology 4 (heresy)"
            ^"Equipment" STRING "Rosary beads and crucifix, and a black Benedictine habit."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Daniel is taller than his cowed posture suggests, with an apologetic face beneath his dark tonsure. He has recently taken to wearing a short beard, much to his abbot’s irritation, but Daniel feels secure behind it, believing that it hides his shame."
            ^"Source" STRING "Tales of Mythic Europe"
            ^"Page" INTEGER 156
        }
        DESCRIPTION "Brother Daniel is a quiet man with a nervous disposition. He is self-critical, brooding, and resentful of others. It was this resentment that the demon Gabrimael, Servant of the Weak, seized upon, offering Daniel the chance to be heard. And the demon seemed as good as his word, as Daniel has been given more responsibility and his station has risen.\n\nDaniel is wracked with regret about poisoning Michael, but believes it to have been necessary. His demonic patron reassures him that it was courage, not cowardice, that gave him the strength to kill.\n\nDespite his years of servitude to the demon, Daniel does not see himself as truly sinful, but rather as taking what should rightfully have been his from the start. Even when Daniel poisoned Michael he sat with him while he died, taking his last confession so that his soul at least would be received by God.\n\nDaniel has taken to using a rosary, something novel in 1220. Some of the other monks may be suspicious of this device and Daniel’s overt piety."
    }

}
