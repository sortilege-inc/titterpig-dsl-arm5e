EXTENSION "ARMDef_The_Church_TheTemplars_Characters" {
    NAME "Ars Magica Fifth Edition, The Church - Chapter Seven: The Knights Templar named characters"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-05"
    DEPENDS_ON "ARMDef_The_Church_Core_Ext"

    # Statted characters, one DEF each. Every stat line is a verbatim typed field off the
    # source's **Label:** markers; text after Appearance is the character's narrative -> DESCRIPTION.

    #teb7ecad1b32f5695e8fc79 ^"Brother-Knight (template)" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Printed Name" STRING "Brother-Knight"
            ^"Characteristics" STRING "Int +1, Per –1, Pre 0, Com 0, Str +1 (1), Sta +2, Dex +1, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "44 (44)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Brother-Knight; Commander, Wealthy; Temporal Influence; Difficult Underlings, Greedy Free with Commander"
            ^"Personality Trait" STRING "Wrathful +3, Envious +2, Gluttonous +2"
            ^"Reputations" STRING "Influential +4 (Templars), Veteran +3 (Church and Military Orders)"
            ^"Combat" STRING "Mace and Shield: Init +2, Attack +11, Defense +8, Damage +9 Dagger: Init +1, Attack +7, Defense +5, Damage +4"
            ^"Soak" STRING "+2 (+11 when armored)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Local 5 (politics), Area Lore: Holy Land 3 (Crusader holdings), Animal Handling 3 (horses), Athletics 3 (running), Awareness 3 (hills), Brawl 4 (with shield), Concentration 3 (sentry), Latin 2 (Church administration), Etiquette 3 (the Church), Folk Ken 3 (Templars), Intrigue 3 (military), Leadership 5 (Templars), (Living) Language 5 (during battle), Native Language 5 (large organizations), Organization Lore: Knights Templar 5 (tactics), Ride 6 (charging), Single Weapon 6 (mace and shield), Survival 3 (hills), Teaching 3 (riding)"
            ^"Equipment" STRING "“Turkish” mace and round-shield, dagger, Templar mantle, robes of office, ornate golden crucifix necklace, commander’s seal."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "Once a handsome man, this brother-knight is now aging, with a large bald, domed head, jutting broken nose, and craggy brows. He is still well built and muscular, which shows through his white Templar robes. He rarely wears a sword these days, but still cuts an imposing figure when fully armed. He has several horses stabled in the chapterhouse."
            ^"Source" STRING "The Church"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "This character is a former Templar brother-knight veteran from the Holy Land, who has climbed the ranks of the Templar hierarchy to become commander over an influential chapterhouse in Mythic Europe. In addition to governing the order’s holdings, he advises powerful nobles. His difficult underlings are ambitious Templars who seek their own aggrandizement."
    }

    #te78c980a526cd36eed3a5b ^"Brother-Sergeant (template)" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Printed Name" STRING "Brother-Sergeant"
            ^"Characteristics" STRING "Int +1, Per –1, Pre 0, Com +1, Str +1, Sta +2, Dex +1, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "19"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Brother-Sergeant; Templar Prestige, Warrior; Fear (of fire, minor), Mentor"
            ^"Personality Trait" STRING "Honest +3, Honorable +2, Brave +1"
            ^"Reputations" STRING "Heroic (Templars) +3"
            ^"Combat" STRING "Long Sword and Shield: Init +3, Attack +10, Defense +8, Damage +7 Dagger: Init +1, Attack +7, Defense +5, Damage +4"
            ^"Soak" STRING "+2 (+6 with armor)"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Local 3 (farming), Animal Handling 2 (horses), Athletics 3 (in armor), Awareness 1 (battles), Bargain 2 (merchants), Brawl 4 (fists), Carouse 3 (villages), Concentration 1 (while traveling), Etiquette 1 (Templars), Folk Ken 2 (Templars), Great Weapon 3 (spear), (Native) Language 5 (compliments), Organization Lore: Knights Templar 2 (hierarchy), Ride 1 (long distance), Single Weapon 4 (long sword and shield), Stealth 1 (urban areas)"
            ^"Equipment" STRING "Black mantle, sword and round shield, dagger, reinforced leather armor."
            ^"Encumbrance" STRING "0 (0)"
            ^"Appearance" STRING "A young man who cuts a dashing figure in the black mantle and red cross of the brother-sergeants. He carries a sword, shield, and dagger."
            ^"Source" STRING "The Church"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "These are the traits of a young Templar brother-sergeant who has gained significant notoriety within the order after performing a heroic deed in battle. Although he has seen combat, he is still fairly “green” and inexperienced. His Mentor is probably an older Templar, who has been impressed by his actions."
    }

    #tf12237dd3b96fcf2e313c7 ^"Brother-Priest (template)" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Printed Name" STRING "Brother-Priest"
            ^"Characteristics" STRING "Int +2, Per –2, Pre +2, Com +2, Str 0, Sta 0, Dex 0, Qik +1"
            ^"Size" STRING "0"
            ^"Age" STRING "30 (30)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (4)"
            ^"Confidence Score" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Brother-Priest; Magic Sensitivity, Student of the Divine; Proud, Raised from the Dead; Lecherous (minor) From Realms of Power: The Divine, page 36."
            ^"Personality Trait" STRING "Loyal +3, Proud +3"
            ^"Reputations" STRING "None"
            ^"Combat" STRING "Fist: Init +1, Attack +1, Defense 0, Damage +1"
            ^"Soak" STRING "+0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious Wound Penalties: –1 (1–5), –3 (6–10), -5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Local 4 (Templar holdings), Artes Liberales 2 (rhetoric), Awareness 2 (noticing disorder), Brawl 2 (escape), Charm 3 (nuns), Church Lore 3 (local diocese), Concentration 3 (prayer), Dominion Lore 2 (miracles), Etiquette 3 (Templar officials), Folk Ken 3 (Templars), Latin 3 (reading), Leadership 4 (religious), Magic Sensitivity 3 (auras), Ride 4 (long distance), Native Language 5 (reading aloud), Theology 2 (the Gospels)"
            ^"Equipment" STRING "Copy of the Book of Matthew, black robes."
            ^"Appearance" STRING "Prematurely greying, with aristocratic features and piercing blue eyes, this brother-priest has a birthmark on his jaw shaped like a Greek cross."
            ^"Source" STRING "The Church"
            ^"Page" INTEGER 127
        }
        DESCRIPTION "Raised from the dead by the grace of a saint, this brother-priest joined the Templars after this miracle (which is the source of his Warping)."
    }

}
