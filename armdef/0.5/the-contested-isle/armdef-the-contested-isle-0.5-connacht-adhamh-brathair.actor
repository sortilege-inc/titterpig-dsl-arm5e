EXTENSION "ARMDef_The_Contested_Isle_Connacht_AdhamhBrathair" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Ádhamh Brathair"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Ádhamh Brathair (Chapter Five: The Province of Connacht, p44): one character, its stat lines verbatim fields.

    #t9ddc545dd0853a253b9568 ^"Ádhamh Brathair" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#t499c3f5f9cf0817c593568 ^"The Pact of Oireadh"]
            ^"Age" STRING "55 (Apparent Age: 55)"
            ^"Personality Trait" STRING "Charismatic +3, Determined +2, Cautious +1"
            ^"Tradition" STRING "Learned Magician Ádhamh is a master of experimental philosophy and a Gifted Learned Magician, tracing his magic ultimately back to Bologna in Italy. It was Ádhamh who conceived the Pact of Oireadh and he is also the principle researcher working toward unifying the druidic gifts."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "He sees his work as being for the greater good. While he would prefer to take the glory he is aware that it is the work of more than a single lifetime. He is cautious about revealing too much to the Coill Trí as he knows of their connection to the Ordo Hiberniae and is concerned as to their potential reaction. This is especially resonant as the Coill Trí recently took a Gifted child from him in order to provide tribute to the Hermetic magi across the border.\n\nÁdhamh is ordained in minor orders but is supported by a wealthy nobleman of Cong, where he turns his powers to helping the noble and his family."
    }

}
