EXTENSION "ARMDef_The_Contested_Isle_Connacht_CachtCultasCriamoine" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Cacht cultas Críamoine"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Cacht cultas Críamoine (Chapter Five: The Province of Connacht, p48): one character, its stat lines verbatim fields.

    #t70c52e191609578103fb2b ^"Cacht cultas Críamoine" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#td108e5b25b535ed37699ad ^"The Covenant of Praesis"]
            ^"Age" STRING "50 (Apparent Age: 40)"
            ^"Personality Trait" STRING "Remote +3, Cold +2, Precise +1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Brought up in the covenant of Qui Sonant, Cacht is a Hibernian native, a maga of House Criamon chosen by the Path of Strife (Houses of Hermes: Mystery Cults, page 67). Her rejection of Criamon’s traditional morality drew her to conflict and the Siege of Praesis offered a unique challenge: the destruction of the status quo.\n\nHaving killed in Ballack’s name, she subsequently lost interest in his aims. She has no particular cause and resides at Praesis only until one is brought to her, but she listens intently to Guillaume’s reports on Connacht sensing a new conflict in the making."
    }

}
