EXTENSION "ARMDef_The_Contested_Isle_Connacht_GuillaumeFlambeauOfNormandy" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Guillaume Flambeau of Normandy"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Guillaume Flambeau of Normandy (Chapter Five: The Province of Connacht, p48): one character, its stat lines verbatim fields.

    #t7f1eb7a07bc1d1b10b0664 ^"Guillaume Flambeau of Normandy" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#td108e5b25b535ed37699ad ^"The Covenant of Praesis"]
            ^"Age" STRING "65 (Apparent Age: 52)"
            ^"Personality Trait" STRING "Bombastic +3, Aggressive +2, Patient –1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 48
        }
        DESCRIPTION "Unable to step out of the shadow of Montverte, the covenant of his apprenticeship, Guillaume sought another Tribunal on which to make his mark. He was attracted to Hibernia ten years ago by the tales that he had heard during his apprenticeship. He is dangerously proficient with Ignem magic and has already taken the cathach of one independent magus, claiming both his covenant resources and his apprentice, who he is now training in his own image.\n\nGuillaume is currently undertaking actions against locations in Connacht using the Breifne mercenaries in his employ. He hasn’t set foot into Connacht himself yet, but he is using his men to identify and raid vis sources.\n\nHe has an ongoing rivalry with the maga Gráinne inghean Uaitéar of the covenant of Vigil and would like nothing more than the chance to see the witch humbled before him."
    }

}
