EXTENSION "ARMDef_The_Contested_Isle_Connacht_MorGreannach" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Mór Greannach"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Mór Greannach (Chapter Five: The Province of Connacht, p45): one character, its stat lines verbatim fields.

    #t72e9a651a6575cccfcee6a ^"Mór Greannach" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#t499c3f5f9cf0817c593568 ^"The Pact of Oireadh"]
            ^"Age" STRING "75 (Apparent Age: 75)"
            ^"Personality Trait" STRING "Mischievous +3, Meddling +2, Trustworthy –1"
            ^"Tradition" STRING "Folk Witch Mór Greannach (MORE GRENnukh), meaning “grey-beard,” gains her name from the thin grey beard that hangs from her aged chin. She is well into her seventies, and all those years have been put to the pursuit of her arts for the benefit of her community. She is feared and distrusted every bit as much as she is revered and consulted."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Mór Greannach is hugely knowledgeable on the workings of the magical world around her and she frequently collects herbs and objects of virtue from the rolling hills and woodlands around her village, magically enriching them to add to her own powers.\n\nOf the Pact of Oireadh, Mór Greannach is the one with the widest contacts among other druids and hedge wizards. Aside from her coven, she is on friendly terms with scores of nightwalkers, faerie-touched craftsmen, Ollamhain (Realms of Power: Faerie, page 135), and the Kilkenny coven across the border in Leinster.\n\nMór Greannach is also the closest to Oireadh as she lives in nearby Carrowmore."
    }

}
