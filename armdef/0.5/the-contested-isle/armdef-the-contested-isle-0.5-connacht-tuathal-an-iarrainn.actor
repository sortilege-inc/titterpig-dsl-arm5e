EXTENSION "ARMDef_The_Contested_Isle_Connacht_TuathalAnIarrainn" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Tuathal an Iarrainn"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Tuathal an Iarrainn (Chapter Five: The Province of Connacht, p46): one character, its stat lines verbatim fields.

    #t79ef374dcf34b2ea6dc6e4 ^"Tuathal an Iarrainn" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#t499c3f5f9cf0817c593568 ^"The Pact of Oireadh"]
            ^"Age" STRING "40 (Apparent Age: 40)"
            ^"Personality Trait" STRING "Honest +3, Disciplined +2"
            ^"Tradition" STRING "Goetic Sorcerer"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 46
        }
        DESCRIPTION "Tuathal an Iarrainn (TUH-ah-hal AN IR-ran) is a master of the Ars Goetica, which give him the means to summon, bind, and command spirits. There are some who distrust both the means and the source of his magic, but Tuathal seeks never to hide his nature.\n\nHe is a master smith by trade; he can use his magic to bind spirits to the items and weapons he makes. However, he has been using his Commanding art more recently under Ádhamh’s request as he seeks out more resources that could help with the research.\n\nTuathal maintains a well-equipped workshop in the coastal village of Rosbeg to the west of Oireadh and has two mundane apprentices, neither of whom is suited to the Goetic Arts.\n\nSee Realms of Power: The Infernal (pages 114–119) for more information on the Goetic Arts."
    }

}
