EXTENSION "ARMDef_The_Contested_Isle_Connacht_UmorArdMacAdar" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Umor Ard Mac Adar"
    VERSION "0.5.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Umor Ard Mac Adar (Chapter Five: The Province of Connacht, p45): one character, its stat lines verbatim fields.

    #t4675267fd47449f103e695 ^"Umor Ard Mac Adar" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#t499c3f5f9cf0817c593568 ^"The Pact of Oireadh"]
            ^"Season" STRING "Autumn (Apparent Age: 50)"
            ^"Magic Might" STRING "25"
            ^"Personality Trait" STRING "Gentle +3, Independent +2, Idealistic +1"
            ^"Tradition" STRING "Transformed Fir Domhnann"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Umor Mac Adar is one of the few Fir Domhnann to leave Árainn Meáin, but while he has left his home behind he brings his faith in Domnu with him. Larger than any mortal man, Umor carries the deformity of his ancestral Fomórach blood, and he has an extra pair of arms that extend from his sides. Otherwise, he looks broadly human and his mature face is almost handsome. His magical blood gives him a Might score and healing powers.\n\nResentful of his people’s exile, he agreed to help Ádhamh as an opportunity to gain favor among the humans so that one day his people might come back to the mainland. His desertion of his homeland is seen as a betrayal by some of his kind and his three cousins have sworn to kill him.\n\nGenerally fearful of humans, he has chosen to place his trust in Ádhamh and frequently acts as arbitrator when tempers flare between those Gifted sworn to the Pact. He lives in the hills above Lough Conn where all manner of spell-like vis can be found. Those who seek him must do so at night, for he sleeps within a hidden regio by day."
    }

}
