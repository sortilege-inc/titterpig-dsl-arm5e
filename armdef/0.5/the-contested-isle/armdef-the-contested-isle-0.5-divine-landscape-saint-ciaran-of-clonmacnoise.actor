EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintCiaranOfClonmacnoise" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Ciarán of Clonmacnoise"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Saint Ciarán of Clonmacnoise (Chapter Twelve: The Divine Landscape, p135): one saint, its stat lines verbatim fields.

    #tb8e2867b843b6f7e9083dd ^"Saint Ciarán of Clonmacnoise" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Herdsmen, Cattle"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Meath, Clonmacnoise"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Bless the Book", "Resist Temptation", "Tame the Wild Beast", "The Faithful Made Whole"]
            ^"Feast" STRING "9th September"
            ^"Personality Trait" STRING "Pious+3, Scholarly+2, Rustic+2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "One of the twelve apostles of Ireland, Saint Ciarán the Younger was an Irish bishop, but his youth was spent as a herdsman in Connacht, and he is particularly associated with cattle. He founded many monasteries, inspired by his love of learning, and he provided the cow for the vellum that the Book of the Dun Cow is written upon. His greatest foundation is Clonmacnoise, where he died of the yellow plague of Justinian in the early sixth century."
    }

}
