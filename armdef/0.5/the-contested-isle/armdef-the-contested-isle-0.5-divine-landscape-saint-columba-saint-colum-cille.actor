EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintColumbaSaintColumCille" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Columba (Saint Colum Cille)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Saint Columba (Saint Colum Cille) (Chapter Twelve: The Divine Landscape, p135): one saint, its stat lines verbatim fields.

    #t82a0e766c0ee5ee92175d4 ^"Saint Columba (Saint Colum Cille)" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Ireland (along with St. Patrick and St. Brigid), Derry, Warriors, Exiles, Scotland and Iona."
            ^"Divine Might" INTEGER 50
            ^"Area of Veneration" STRING "Throughout Ireland, Kells, Derry; also Scotland, especially Iona."
            ^"Saint Powers" LIST OF STRING ["Acknowledgment of Evil", "Apparition", "Banish Magical Monster", "Borne up by Angels", "Dysentric Infliction", "Expel Demons", "Multitude of Fish", "Raise the Dead", "Resist Temptation", "The Dutiful Shepherd", "Walk Upon the Waters"]
            ^"Feast" STRING "9th June"
            ^"Personality Trait" STRING "Pious+3, Cheerful +2, Aggressive +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 135
        }
        DESCRIPTION "One of the twelve apostles of Ireland, St. Columba founded a number of monasteries before a quarrel with St. Finian of Movilla. St. Columba had copied a book in St. Finian’s scriptorium, and intended to keep the copy; St. Finian refused, claiming he had not given permission and the copy was now his. The argument escalated, and led to the Battle of Cúl Dreimhne, where many were slain. As a result St. Columba was exiled, and chose to go to Scotland and evangelize the Picts, eventually founding the monastery at Iona and banishing the Loch Ness monster, among many other miraculous exploits. He founded a community of great austerity, and converted many among the Picts and the Gaels who had settled the west coast of what is today Scotland. Despite his exile from his homeland he is greatly revered as one of the three great patron saints of Ireland."
    }

}
