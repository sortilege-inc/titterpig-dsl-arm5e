EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintGrellan" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Grellan"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Saint Grellan (Chapter Twelve: The Divine Landscape, p136): one saint, its stat lines verbatim fields.

    #td8e59e48346f6dc05b8b99 ^"Saint Grellan" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "The Betrayed, those menaced by the Fir Bolg, Ballinasloe."
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Connacht, especially Ballinasloe."
            ^"Saint Powers" LIST OF STRING ["Apparition", "Raise the Dead", "Swallowed Alive and Sent to Hell", "Protect the Wild Prey", "Grant of Serenity"]
            ^"Feast" STRING "29th September"
            ^"Personality Trait" STRING "Pious +3, Peacemaker +2, Brave +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 136
        }
        DESCRIPTION "Saint Grellan lived at a time when the Fir Bolgs were fighting the tribe of Colla da Chrioch. The Fir Bolgs organized a truce, but instead took the king’s son hostage, then murdered him when the Fir Bolg queen fell for his charms. A second truce was arranged, but the Fir Bolg planned treachery, and as they drew their weapons St. Grellan, who was in his church saw the betrayal again of the peace he had worked for. The saint prayed to God and the Fir Bolgs sank into the ground, some say trapped to this day under the bog of Magh Liach, others say sent straight to Hell."
    }

}
