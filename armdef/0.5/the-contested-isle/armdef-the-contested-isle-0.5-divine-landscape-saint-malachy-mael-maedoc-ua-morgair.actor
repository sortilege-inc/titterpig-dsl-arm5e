EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintMalachyMaelMaedocUaMorgair" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Malachy (Máel Máedóc Ua Morgair)"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Saint Malachy (Máel Máedóc Ua Morgair) (Chapter Twelve: The Divine Landscape, p136): one saint, its stat lines verbatim fields.

    #teaa64be16fed35156c8f2f ^"Saint Malachy (Máel Máedóc Ua Morgair)" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Patronage" STRING "Armagh, Visionaries, Fisherfolk"
            ^"Divine Might" INTEGER 25
            ^"Area of Veneration" STRING "Ulster, esp. Armagh"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Expel Demons", "Multitude of Fish", "The Faithful Made Whole", "Rebuke the Unfaithful"]
            ^"Feast" STRING "3rd November"
            ^"Personality Trait" STRING "Pious+3, Insightful+2, Persevering+2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 136
        }
        DESCRIPTION "Archbishop of Armagh from 1132 until his death in 1148, St. Malachy lived during a troubled period in the history of the Irish church. Despite many intrigues against him, he rose through a series of ecclesiastical positions, not least because of the many miracles God wrought at his behest. Particularly skilled as an exorcist, he also brought fish to rivers and bays where they had become scarce, and healed the sick. He is known as a great visionary, though the Prophecy of the Popes attributed to him is still lost in the Vatican archives at this time, and will not be rediscovered for centuries to come."
    }

}
