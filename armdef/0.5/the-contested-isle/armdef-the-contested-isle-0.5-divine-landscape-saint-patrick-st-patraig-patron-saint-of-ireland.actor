EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintPatrickStPatraigPatronSaintOfIreland" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Saint Patrick (St. Pátraig), Patron Saint of Ireland"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Saint Patrick (St. Pátraig), Patron Saint of Ireland (Chapter Twelve: The Divine Landscape, p134): one saint, its stat lines verbatim fields.

    #t22a5fd7b0077f9e44a6850 ^"Saint Patrick (St. Pátraig), Patron Saint of Ireland" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Divine Might" INTEGER 50
            ^"Area of Veneration" STRING "Throughout Ireland"
            ^"Saint Powers" LIST OF STRING ["Apparition", "Expel Demons", "Resist Temptation (St. Patrick’s Breastplate)", "Scourging of Snakes", "Shatter Idol", "The Faithful Made Whole", "The Captive Made Free", "The Unquenchable Fire", "The Sky Made Light"]
            ^"Feast" STRING "17th March"
            ^"Personality Trait" STRING "Pious +3, Vigorous +2, Benevolent +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 134
        }
        DESCRIPTION "British-born but responsible for the conversion of Ireland, his life and works are discussed in Chapter 2. Saint Patrick’s most famous miracle was driving all snakes and venomous things from the shores of Ireland forever. One of the three patron saints of Ireland, any character of Irish birth may call upon him."
    }

}
