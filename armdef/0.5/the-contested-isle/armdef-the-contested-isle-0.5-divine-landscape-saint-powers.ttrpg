EXTENSION "ARMDef_The_Contested_Isle_DivineLandscape_SaintPowers" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Twelve: The Divine Landscape saint powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # The chapter's saint powers, structured; each DESCRIPTION the source's text, verbatim.

    #t0ed60490dc0853e0896485 ^"Banish Magical Monster" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "0 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Vim"
            ^"Printed Stat Line" STRING "Banish Magical Monster, 0 points, Init +5, Vim."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "As Demon’s Eternal Oblivion, but effects Magical Animals. The monster’s Might score is permanently reduced by points equal to the Saint’s Might score if the effect Penetrates."
    }

    #td4f51ed897893f81484452 ^"Bless the Book" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+2"
            ^"Form" STRING "Aquam"
            ^"Printed Stat Line" STRING "Bless the Book, 2 points, Init +2, Aquam."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "The saint blesses a book; thereafter it is totally impervious to water, and can be read clearly even if were to rest on the bottom of a lough for centuries."
    }

    #t9414cf6f011e42e5a80691 ^"Borne up by Angels" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+20"
            ^"Form" STRING "Corpus"
            ^"Printed Stat Line" STRING "Borne up by Angels, 2 points, Init +20, Corpus."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "If someone is falling to their death they may call upon the saint, and if the petition is accepted this Power causes the saint to send (Divine Might 15) angels to slow their fall and set them lightly down upon the ground."
    }

    #t494998fb59ed500282e960 ^"Call Forth the Waters" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+1"
            ^"Form" STRING "Aquam"
            ^"Printed Stat Line" STRING "Call Forth the Waters, 4 points, Init +1, Aquam."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "Brings forth a tidal wave fifty paces across and ten paces high, that crashes upon the shore and can sweep across a small island destroying all in its path. More benignly, the same power can create a spring of fresh water."
    }

    #t5c0e02e51848f227311201 ^"Counting Sheep" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Animal"
            ^"Printed Stat Line" STRING "Counting Sheep, 3 points, Init +5, Animal."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "When sheep or cattle are lost or have been given to the poor, this power miraculously restores the flock to the proper number when counted."
    }

    #tf470ae7e8d04903f22024e ^"Cure Madness" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "4 points"
            ^"Initiative" STRING "+0"
            ^"Form" STRING "Mentem"
            ^"Printed Stat Line" STRING "Cure Madness, 4 points, Init +0, Mentem."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "Heals the recipient (who not need be the petitioner) of insanity, restoring peace to the troubled soul."
    }

    #td52f9ba2dd554435e13abe ^"Hide Fugitive" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "1 point"
            ^"Initiative" STRING "+13"
            ^"Form" STRING "Imaginem"
            ^"Printed Stat Line" STRING "Hide Fugitive, 1 point, Init + 13, Imaginem."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "The power causes the petitioner to appear as a natural feature, hiding her from her enemies, and is a tactile and auditory illusion as well as visual."
    }

    #tc161c8101a0c3e15e02acf ^"Multitude of Fish" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Aquam"
            ^"Printed Stat Line" STRING "Multitude of Fish, 2 points, Init +9, Aquam."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This power causes a bay or river or area of sea where the fish stocks have dwindled or died out to change becoming an attractive habitat to the fish, who flock their in great numbers, bringing prosperity to the region’s fisherfolk."
    }

    #t212d195b6337286f05df9f ^"Protect the Wild Prey" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+3"
            ^"Form" STRING "Animal"
            ^"Printed Stat Line" STRING "Protect the Wild Prey, 5 points, Init +3, Animal."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This power bestows the saint’s blessing on a wild animal, frightening away hounds and making it impervious to weapons until sunset."
    }

    #t238c4c4b1bb26454145035 ^"Shatter Idol" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Terram"
            ^"Printed Stat Line" STRING "Shatter Idol, 2 points, Init + 9, Terram."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This curse immediately shatters a false stone idol to which worship has been recently idolatrously offered, causing it to crumble to rubble."
    }

    #tc49ab0d40940bd0fd29e0b ^"Still the Waves" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+4"
            ^"Form" STRING "Aquam"
            ^"Printed Stat Line" STRING "Still the Waves, 5 points, Init +4, Aquam."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This power makes the waters stop moving as if frozen, becalming a ship, and preventing waves from rushing forth, or a river from running, until the curse is lifted. Alternatively a ship may be blessed with a single calm voyage, free from the fury of the elements."
    }

    #t950070cfd9d5b7917919d8 ^"Strange Fruit" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Herbam"
            ^"Printed Stat Line" STRING "Strange Fruit, 2 points, Init +5, Herbam."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This unusual power causes a tree to sprout edible fruit, regardless of species, and even in the first instance out of season. The miraculous tree breeds true, and creates more trees that bring forth fruit in the normal season thereafter, and that are edible and nourishing."
    }

    #t4c3fa600c1347bdefc515f ^"Tame the Wild Beast" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+5"
            ^"Form" STRING "Animal"
            ^"Printed Stat Line" STRING "Tame the Wild Beast, 3 points, Init +5, Animal."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This power grants a divine Animal Companion which does not age until the petitioner dies. Only one animal companion can be possessed at any time. The wild animal treats the recipient of this blessing as if a friend, and does it all it can to assist them. If the animal’s trust is betrayed or is harmed the saint is furious with the petitioner, and curses her."
    }

    #t440564fb2c60a5ee95f1d9 ^"The Captive Made Free" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "5 points"
            ^"Initiative" STRING "+4"
            ^"Form" STRING "Terram"
            ^"Printed Stat Line" STRING "The Captive Made Free, 5 points, Init +4, Terram."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "The ground shakes and prison walls are broken, the door springing unlocked, and the chains falling from the prisoners. Guards tend to flee in terror, but that is a mundane effect not part of the power. It can also release chained slaves, even if they are not held in a dungeon."
    }

    #tbbb9ff5cdcfe4158ed94a7 ^"The Unquenchable Fire" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+6"
            ^"Form" STRING "Ignem"
            ^"Printed Stat Line" STRING "The Unquenchable Fire, 2 point, Init +6, Ignem."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "A hearth fire blessed this way cannot be extinguished, and even if the fuel is consumed continues to burn forever. However other fires lit from this fire are mundane fires, and it is only the original hearth-sized fire that has this property."
    }

    #t07aea4e65d0e890c34b06b ^"The Sky Made Light" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Auram"
            ^"Printed Stat Line" STRING "The Sky Made Light, 2 points, Init +9, Auram."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "Dispels any storm, clouds, or supernaturally created bad weather during the day, allowing the brilliant rays of the sun to burst through. The effect persists until sunset."
    }

    #t9c513b308da8addbec69b5 ^"Test of Truth" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Curse" FIXED
            ^"Cost" STRING "2 points"
            ^"Initiative" STRING "+9"
            ^"Form" STRING "Mentem"
            ^"Printed Stat Line" STRING "Test of Truth, 2 points, Init +9, Mentem."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "This curse forces the victim to speak only the truth until the petitioner finishes questioning him; attempts to lie cause him to convulse and fall down paralyzed. They may choose to remain silent, of course, but even demons can not tell a lie under the influence of this effect, despite their essential natures."
    }

    #tb9f00141e70824110390ef ^"Walk Upon the Waters" DEF {
        EXTENDS #tbd7845fd113e739a3e5a63 ^"Saint Power"
        PROPERTIES {
            ^"Kind" STRING "Power" FIXED
            ^"Cost" STRING "3 points"
            ^"Initiative" STRING "+7"
            ^"Form" STRING "Corpus"
            ^"Printed Stat Line" STRING "Walk Upon the Waters, 3 points, Init + 7, Corpus."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "One blessed by this power can walk upon the waves as if they were made of stone, and tread lightly over rivers or even the sea to a boat off shore, and back to the beach."
    }

}
