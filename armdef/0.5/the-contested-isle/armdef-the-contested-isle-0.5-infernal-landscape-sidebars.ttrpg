EXTENSION "ARMDef_The_Contested_Isle_InfernalLandscape_Sidebars" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Thirteen: The Infernal Landscape sidebars"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # The chapter's non-record boxes as GUIDANCE with verbatim TEXT (story seeds, rules
    # notes, background boxes; list and sub-heading units included).

    GUIDANCE {
        ENTRY ^"Infernal Relic: The Cup of Partholon" #t05ff4c2f1cb427e2fe2cda {
            TEXT "Infernal Relic: The Cup of Partholon\n\nThe cup of Partholon, an exquisite horn of red gold, embossed and engraved with the telling of Partholon’s voyage to Ireland, is buried somewhere in Inis Saimera. The unwary magus in search of a cathach may go searching for Partholon’s cup as a powerful symbol associated with Ireland’s earliest years. But the horn is an Infernal relic with power over betrayal. Those who look upon it gain an Envious +3 Personality Trait, with a Penetration of +15, and a temptation to betray its owner and take the cup."
        }
    }

    GUIDANCE {
        ENTRY ^"The Library of Vigil" #tdc1cde375c40107adf90c4 {
            TEXT "The Library of Vigil\n\nThe covenant of Vigil has a substantial library of casting tablets and laboratory texts concerned with combating Infernal illness and harsh weather. In years gone by, the magi of Vigil watched for signs of Infernal hardship sweeping from the north and helped the people of Ireland by combating the demons responsible. But the Infernal has lain low of late, long enough for Vigil to succumb to its own sins of indolence, and the library now sits dark and untouched in the waterlogged vaults beneath the lost fortress. References may be found to this knowledge in annals of Hermetic history, and those covenants affected by Infernal winters and plague may want to approach Vigil for access to this lost library."
        }
    }

}
