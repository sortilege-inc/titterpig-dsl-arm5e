    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #t3813ffb2bc5cd7aecb8b5f ^"Topographia Hibernica" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Topographia Hibernica"
            ^"Author" STRING "Gerald of Wales"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 8
            ^"Section" STRING "An Outsider’s View"
            ^"Printed Entry" STRING "Topographia Hibernica (“The Topography of Ireland”)"
            ^"Printed Figures" STRING "Both of his books are tractatus on Area Lore (Ireland) 8."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 20
        }
    }

    #tb979e28a4cb5ca31607eaf ^"Expugnatio Hibernica" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Expugnatio Hibernica"
            ^"Author" STRING "Gerald of Wales"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 8
            ^"Section" STRING "An Outsider’s View"
            ^"Printed Entry" STRING "Expugnatio Hibernica (“The Conquest of Ireland”)"
            ^"Printed Figures" STRING "Both of his books are tractatus on Area Lore (Ireland) 8."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 20
        }
    }

}
