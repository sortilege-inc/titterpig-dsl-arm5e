EXTENSION "ARMDef_The_Contested_Isle_Leinster_BoinnTheGreatWhiteCowTuathaDeDanannRiverGoddess" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Bóinn, the Great White Cow, Tuatha Dé Danann River Goddess"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Bóinn, the Great White Cow, Tuatha Dé Danann River Goddess (Chapter Six: The Province of Leinster, p56): one being, its stat lines verbatim fields.

    #t68f234dcdf062dbd0fe855 ^"Bóinn, the Great White Cow, Tuatha Dé Danann River Goddess" DEF {
        EXTENDS #taDz3ITq9fRoE374AgiL8VE4 ^"Creature"
        PROPERTIES {
            ^"Location" LIST [#t598e717ca3105cc10358de ^"The Province of Leinster"]
            ^"Might Realm" STRING "Faerie" FIXED
            ^"Might" INTEGER 35
            ^"Form" STRING "Aquam"
            ^"Characteristics" DEF {
                ^"Intelligence" INTEGER -1
                ^"Perception" INTEGER 0
                ^"Presence" INTEGER 2
                ^"Communication" INTEGER -1
                ^"Strength" INTEGER 7
                ^"Stamina" INTEGER 3
                ^"Dexterity" INTEGER 2
                ^"Quickness" INTEGER -2
            }
            ^"Size" INTEGER 2
            ^"Confidence" STRING "3 (1)"
            ^"Virtues and Flaws" STRING "Narrowly Cognizant; Animal Ken, Faerie Beast, Faerie Speech, Improved Characteristics (3), Greater Power (2), Lesser Power (2), Pretentious (Rulers of Meath), Reputation As Confidence, Ways of the River; Busybody, Vulnerable to Salt Water; Poor Combatant, Reduced Damage."
            ^"Qualities" STRING "Tough Hide"
            ^"Reputations" LIST ["River Goddess (Meath) 3", "Wife of Nuadha (Laighin) 3."]
            ^"Combat" STRING "Hooves: Initiative: 0 Attack: +3 Defense: –2 Damage: +6"
            ^"Soak" INTEGER 6
            ^"Wound Penalties" STRING "–1 (1–7), –3 (8–13), –5 (14–21), Incapacitated (21–28), Dead (29+)"
            ^"Pretenses" STRING "Animal Ken 6 (cattle), Area Lore: Ireland 7 (Leinster), Awareness 1 (in water), Charm 3 (men apart from her husband), Guile 3 (about infidelity), Swim 10 (in rivers)."
            ^"Powers" STRING "Spirit Away, variable, Init –2, Vim. Can add Threshold points to the total accumulated by a mortal or group. See Realms of Power: Faerie, page 23. Allure, 1 point, Init –3, Mentem. Grants +3 to communication rolls involving seduction. Appear Human, 1 point, Imaginem, constant.. Allows Bóinn to appear as a beautiful noble lady, but wounded in the eye, arm and foot, injuries she sustained when she looked in to the Well of Wisdom and which can not be healed. Deluge of Rushing and Dashing, 8 points, Init –10, Aquam. As the Hermetic spell of the same name, though Bóinn’s power works only on the River Boyne. She uses the power to drown those who betray her as they cross her river. Drowned Standing, 3 points, Init –5, Aquam. The target’s lungs fill with river water, as if he were submerged in the River Boyne, for +15 damage that armor does not soak against. Guide, 3 points, Init –5, Mentem. Bóinn uses this power to subtly influence a group of people toward actions that aid Meath at the expense of Leinster, particularly actions that transfer wealth, power, or authority to Meath. The storyguide should advise as if the characters had the virtue Common Sense, but in line with Bóinn’s agenda. See Realm of Power: Faeries page 59 for more on this power."
            ^"Equipment" STRING "None."
            ^"Vis" STRING "7 pawns of Aquam vis, in her tail."
            ^"Appearance" STRING "Bóinn (BONE) appears as a great white shining cow of obviously supernatural power."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 56
        }
        PERSONALITY_TRAITS {
            "Inquisitive" +3
            "Vengeful" +2
            "Unfaithful to Husbands" +1
        }
    }

}
