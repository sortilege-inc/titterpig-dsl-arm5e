EXTENSION "ARMDef_The_Contested_Isle_Leinster_BrianChilldaraAnFlambo" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Brian Chilldara an Flámbó"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Brian Chilldara an Flámbó (Chapter Six: The Province of Leinster, p63): one character, its stat lines verbatim fields.

    #t81e9ca1b58e2bfd4206dc9 ^"Brian Chilldara an Flámbó" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tf0607d1129f9ef1f6f16ca ^"Lámbaird"]
            ^"Age" STRING "62 (apparent age 57)"
            ^"Personality Trait" STRING "Hatred of Normans +3, Changeable +2, Abstemious +1, Dependable –1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 63
        }
        DESCRIPTION "Brian of Cilldara is a small, thin man whose body is completely hairless. He is a skinchanger who takes the form of a salmon, and he spends a good proportion of his time in the rivers and lakes of Wicklow, studying the ebb and flow of the watery element he favors. Brian once had a familiar — a salmon, like his alternate form — but the fish was killed and eaten by a group of Norman soldiers. He has not yet recovered from the loss, and may never bind another familiar; meanwhile he is determined to destroy every last Norman on Irish soil."
    }

}
