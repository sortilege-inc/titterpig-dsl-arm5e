EXTENSION "ARMDef_The_Contested_Isle_Leinster_CliodnaAnFlamboIngheanHiolair" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Cliodna an Flámbó inghean hIolair"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Cliodna an Flámbó inghean hIolair (Chapter Six: The Province of Leinster, p63): one character, its stat lines verbatim fields.

    #tce12e6226ca66576ff450b ^"Cliodna an Flámbó inghean hIolair" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tf0607d1129f9ef1f6f16ca ^"Lámbaird"]
            ^"Age" STRING "43 (apparent age 35)"
            ^"Personality Trait" STRING "Self-Reliant +4, Hot- Tempered +3, Idealistic +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 63
        }
        DESCRIPTION "Cliodna (CLEE-na) is the youngest of Lámbaird’s magi, and has modeled herself on one of the warrior-queens of legend. She is as adept with a sword as she is with a spell, and is a superb equestrian and athlete. Cliodna has taken the epithet inghean hIolair (“daughter of the Eagle”) since being adopted into a clan of magical birds of prey who lives in the mountains. Her familiar Artt is the son of the King of the Eagles."
    }

}
