EXTENSION "ARMDef_The_Contested_Isle_Leinster_CoemgenAnTEigseMeasceal" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Cóemgen an t-Éigse Measceal"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Cóemgen an t-Éigse Measceal (Chapter Six: The Province of Leinster, p66): one character, its stat lines verbatim fields.

    #tc259229be14a2ddad2c025 ^"Cóemgen an t-Éigse Measceal" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#tbe17e73554f25eda95be4f ^"The Paruchia of Nerius"]
            ^"Age" STRING "22 (apparent age 22)"
            ^"Personality Trait" STRING "Gentle +3, Shy +2, Romantic +1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 66
        }
        DESCRIPTION "Newly gauntleted, Cóemgen (COE-muh-gen) is a manaim, a man who observes the liturgical hours, but has not taken the full vows of a monk. He can marry, and indeed hopes to do so and to raise a family on Great Saltee, crossing back and forth to the covenant. Unfortunately there are no suitable single women on that island, and his Gift and excruciating shyness interfere with his romantic plans. Perhaps one day he will cross to Wexford and abduct a wife in his coracle, or perhaps he will form a romantic attachment to a female player character, and pursue her assiduously if awkwardly. Gentle and likeable, only his lack of experience with women and the negative effects of The Gift prevent this charming young man achieving his goal."
    }

}
