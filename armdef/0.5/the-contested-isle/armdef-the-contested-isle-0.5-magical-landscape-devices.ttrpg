EXTENSION "ARMDef_The_Contested_Isle_MagicalLandscape_Devices" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Ten: The Magical Landscape devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t5254370da64c90200e6df1 ^"The Youthful Exploits of Cú Chulainn" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Ease Factor" INTEGER 18
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Sound"
            ^"Effect Design" STRING "(Base 10, +1 Performance, +3 Sound)"
            ^"Printed Effect Line" STRING "ReCo 30 / Ease Factor 18 Pen 0, 1/day R: Per, D: Performance, T: Sound"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Upon hearing the stories of Cú Chulainn’s battle frenzy, those affected no longer feel fatigue and shrug off Wound Penalties. This has the same effect as Endurance of the Berserkers (ArM5, page 134)"
    }

    #tf58e297c119ba862ee4d26 ^"Fear Diadh’s Last Stand" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Ease Factor" INTEGER 16
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Sound"
            ^"Effect Design" STRING "(Base 4, +1 Performance, +3 Sound)"
            ^"Printed Effect Line" STRING "CrMe 20 / Ease Factor 16 Pen 0, 1/day R: Per, D: Performance, T: Sound"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Anyone hearing the stirring words of this epic tale is driven to greater acts of heroism. They receive a +3 to all rolls to resist fear or to maintain morale, and can momentarily resist the effect of magically-induced fear if they can succeed in a Brave stress roll against an Ease Factor of 9."
    }

    #t3b7a4aa6a892717ebe6309 ^"The Daghdha’s Escape from Indech’s Ráth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 20
            ^"Ease Factor" INTEGER 16
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Sound"
            ^"Effect Design" STRING "(Base 4, +1 Performance, +3 Sound)"
            ^"Printed Effect Line" STRING "ReMe 20 / Ease Factor 16 Pen 0, 1/day R: Per, D: Performance, T: Sound"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "This story, recited in quiet tones and soothing cadence, binds those who hear it into sleep, and they cannot be woken for the duration of its effect."
    }

    #t4c597afcd28ef326257478 ^"The Chariot of Manannán mac Lir" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 30
            ^"Requisite" STRING "Terram"
            ^"Ease Factor" INTEGER 18
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Sound"
            ^"Effect Design" STRING "(Base 5, +1 Performance, +3 Sound, +1 requisite)"
            ^"Printed Effect Line" STRING "MuAq(Te) 30 / Ease Factor 18 Pen 0, 1/day R: Per, D: Performance, T: Sound"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "While this story is being recited, any water beneath the feet of the speaker momentarily becomes solid, allowing him to walk on the surface. Walking on waves is like traversing broken terrain."
    }

    #tc3a8b79726f0e86452c910 ^"Blrrmm, Blrrmm" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Requisite" STRING "Rego"
            ^"Ease Factor" INTEGER 14
            ^"Penetration" STRING "0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Per"
            ^"Duration" STRING "Performance"
            ^"Target" STRING "Sound"
            ^"Effect Design" STRING "(Base 1, +1 Performance, +3 Sound, +1 requisite)"
            ^"Printed Effect Line" STRING "Mu(Re)Im 10 / Ease Factor 14 Pen 0, 1/day R: Per, D: Performance, T: Sound"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 117
        }
        DESCRIPTION "Those targeted by this story cannot make intelligible sounds; any words issuing from their mouths is turned into the burbling of a baby. The caster is unaffected thanks to the requisite."
    }

}
