EXTENSION "ARMDef_The_Contested_Isle_Munster_DiarmaitMacFergaile" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Diarmait mac Fergaile"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Diarmait mac Fergaile (Chapter Eight: The Province of Munster, p87): one character, its stat lines verbatim fields.

    #t55feafeab6d2d284507287 ^"Diarmait mac Fergaile" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t173016c69a7530b39055be ^"The Mercer House of Leth Moga"]
            ^"Age" STRING "121 (apparent age: 75)"
            ^"Personality Trait" STRING "Selfish +3, Worried +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 87
        }
        DESCRIPTION "Diarmait mac Fergaile (JAW-motch moc FER-gal-yuh) assumed leadership after his parens, Fergal, died. Unlike his parens, Diarmait thinks sharing The Red Book would increase its appeal. He understands that the book isn’t to be copied, but does believe it should be viewed. The other redcaps think Diarmait’s choice of successor is a more pressing matter. The choice lies between Gopstan and Luathan."
    }

}
