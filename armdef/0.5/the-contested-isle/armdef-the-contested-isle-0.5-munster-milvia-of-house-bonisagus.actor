EXTENSION "ARMDef_The_Contested_Isle_Munster_MilviaOfHouseBonisagus" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Milvia of House Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Milvia of House Bonisagus (Chapter Eight: The Province of Munster, p82): one character, its stat lines verbatim fields.

    #t5a62a4b7215dd18c508f69 ^"Milvia of House Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t6b0913f4c2435356e3903b ^"Circulus Ruber"]
            ^"Age" STRING "164 (apparent age 68)"
            ^"Personality Trait" STRING "Obsessed with details +3, Overly focused +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 82
        }
        DESCRIPTION "Milvia is the praeco of the Hibernia Tribunal. While not the eldest Hibernian magus, the senior magus Conán Derg has abdicated the position. Her passion is political unity, and despite the Tribunal’s turbulent nature, Milvia has deftly steered Hibernia through most of the troubles. Milvia has served as praeco for the last four Tribunal meetings and led the Hibernian delegation at the Grand Tribunal of 1195.\n\nAs a Bonisagus maga, Milvia respects the original research being done at Cliffheart, despite feeling that its completion is dangerous to Hibernia’s sense of unity. She remains neutral in the Irish-English magi debates."
    }

}
