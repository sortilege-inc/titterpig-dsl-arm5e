EXTENSION "ARMDef_The_Contested_Isle_Munster_StyrbjornOfHouseVerditius" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Styrbjórn of House Verditius"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Styrbjórn of House Verditius (Chapter Eight: The Province of Munster, p83): one character, its stat lines verbatim fields.

    #t1df7c85d0944561fd1a47c ^"Styrbjórn of House Verditius" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t55cd843a02fffe7ec1423f ^"Cliffheart"]
            ^"Age" STRING "109 (apparent age: 55)"
            ^"Personality Trait" STRING "Content when left alone +3, Suspicious of others +2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "The Scandinavian Styrbjórn was born in Dublin and trained at Verdi. He returned home to protect his birth-family after hearing about the English invasion. He need not have worried; his family was in no immediate danger. Realizing that he loved his homeland, Styrbjórn petitioned Cliffheart for membership and was accepted. Living at the back of the ráth, Styrbjórn makes magical items for his sodales. He readily accepts commissions from other Irish magi."
    }

}
