EXTENSION "ARMDef_The_Contested_Isle_Ulster_DaireAnChogaidhMacDaireCuUaMearcaire" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Dáire an Chogaidh mac Dáire Cú Ua Mearcaire"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Dáire an Chogaidh mac Dáire Cú Ua Mearcaire (Chapter Nine: The Province of Ulster, p100): one character, its stat lines verbatim fields.

    #ta6838d106fa59211d18945 ^"Dáire an Chogaidh mac Dáire Cú Ua Mearcaire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t2eb485a33b2f4a189906a3 ^"Mercere House of Leth Cuinn"]
            ^"Age" STRING "65 (apparent age 48)"
            ^"Personality Trait" STRING "Aggressive +3, Hatred of the English +3, Humble –2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "During his macgnímurtha Dáire an Chogaidh (DAWR-yuh an KHOG-aj) fought de Courcey’s English as part of the Ulster army, from whence he gets his epithet (“of the wars”). Needless to say, Dáire opposes all things English, and has even been moved to vote at Tribunal despite the traditional neutrality of his house. This has made him a bit of a celebrity, and there are rumors that the primus of House Mercere is preparing a response to his actions.\n\nDáire an Chogaidh spends more time drilling warriors on the training field than he does on the roads of Ireland. This is exactly where his father wants him; the elder Dáire is only too aware of his son’s hot-headed nature and tries to keep him out of trouble."
    }

}
