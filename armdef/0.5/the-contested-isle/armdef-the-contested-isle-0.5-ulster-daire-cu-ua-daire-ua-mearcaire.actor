EXTENSION "ARMDef_The_Contested_Isle_Ulster_DaireCuUaDaireUaMearcaire" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Dáire Cú Ua Dáire Ua Mearcaire"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Dáire Cú Ua Dáire Ua Mearcaire (Chapter Nine: The Province of Ulster, p100): one character, its stat lines verbatim fields.

    #t86767b3798636a35e2af92 ^"Dáire Cú Ua Dáire Ua Mearcaire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t2eb485a33b2f4a189906a3 ^"Mercere House of Leth Cuinn"]
            ^"Age" STRING "82 (apparent age 63)"
            ^"Personality Trait" STRING "Loyal to Family +3, Uncompromising +2, Loyal to Order +1 Dáire Cú (DAWR-yuh KOO) is the leader of Leth Cuinn, having inherited that role from his father Dáire Direach, and he is grooming his eldest son Dáire an Chogaidh to take over after him. He is ritually married to Úathach, and since his mortal wife died this arrangement has been more than just a symbolic union."
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "Dáire Cú has nothing but contempt for the Redcaps of Leth Moga (Chapter 8: Munster), and believes that their leader is too doddering and bookish to lead the Tribunal’s Redcaps."
    }

}
