EXTENSION "ARMDef_The_Contested_Isle_Ulster_ElenBhodharIngheanDaireCuUaMearcaire" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Elen Bhodhar inghean Dáire Cú Ua Mearcaire"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Elen Bhodhar inghean Dáire Cú Ua Mearcaire (Chapter Nine: The Province of Ulster, p100): one character, its stat lines verbatim fields.

    #teb37a80ee22bf171b5cda3 ^"Elen Bhodhar inghean Dáire Cú Ua Mearcaire" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t2eb485a33b2f4a189906a3 ^"Mercere House of Leth Cuinn"]
            ^"Age" STRING "19 (apparent age 19)"
            ^"Personality Trait" STRING "Eager +3, Self-Reliant +1, Brave –2"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 100
        }
        DESCRIPTION "Elen Bhodhar (EL-en WOH-yar) or Elen the Deaf, is the youngest of Dáire Cú’s five children; her mother died giving birth to her. Elen survived, but was born without hearing. She can lip-read perfectly, and has become proficient at expressing herself through mime and a crude sign language. She has just completed her Redcap training, and has begun treading the roads of Ireland."
    }

}
