EXTENSION "ARMDef_The_Contested_Isle_Ulster_FinnMacCantarusAnTIarbiteon" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Finn Mac Cantarus an t-Iarbiteon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Finn Mac Cantarus an t-Iarbiteon (Chapter Nine: The Province of Ulster, p107): one character, its stat lines verbatim fields.

    #t003b3e25fd1b6008c4c17a ^"Finn Mac Cantarus an t-Iarbiteon" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t9201fbe38e61bd3ba6975d ^"Qui Sonant Pro Quieto"]
            ^"Age" STRING "55 (apparent age: 35)"
            ^"Personality Trait" STRING "Impatient +3, Arrogant +2, Scheming +1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "Finn has a flair for Vitae Magorum written in the Irish vernacular and his works on Hermetic history are widely read throughout Hibernia. He is also passionate about his covenant and the model of peace and cooperation that it represents.\n\nHowever, Finn assumes that being Cantarus’ only filius at the covenant puts him next in line for the Master of the Songs position. He takes this for granted, ignorant of Cantarus’ misgivings. As a result, he makes no effort to learn from any mistakes of leadership and he is quite vocal about his future status, willing to earn friends by making long-term promises based on his position to come."
    }

}
