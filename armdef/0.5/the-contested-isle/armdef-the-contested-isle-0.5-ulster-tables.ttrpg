EXTENSION "ARMDef_The_Contested_Isle_Ulster_Tables" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Chapter Nine: The Province of Ulster tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tdd09e944c4f03fba2c3b93 ^"Situation Mod Example" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Situation", "Mod", "Example"]
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 102
        }
        TABLE {
            "Unstable" "+3" "a rope slung between two poles"
            "Moving" "+3" "a horse’s back"
            "Sloped up to 45 degrees from horizontal" "+3" "banisters of a staircase"
            "Sloped more than 45 degrees from horizontal" "+6" "taut rope attached to grapple on castle wall."
        }
    }

}
