EXTENSION "ARMDef_The_Contested_Isle_Ulster_TurloughCultasCriothamon" {
    NAME "Ars Magica Fifth Edition, The Contested Isle - Turlough cultas Críothamon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Contested_Isle_Core_Ext"

    # Turlough cultas Críothamon (Chapter Nine: The Province of Ulster, p107): one character, its stat lines verbatim fields.

    #te9a8023a3d8af2ae7caf5c ^"Turlough cultas Críothamon" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t9201fbe38e61bd3ba6975d ^"Qui Sonant Pro Quieto"]
            ^"Age" STRING "80 (apparent age 55)"
            ^"Personality Trait" STRING "Secretive +3, Affable +2, Disciplined +1"
            ^"Source" STRING "The Contested Isle"
            ^"Page" INTEGER 107
        }
        DESCRIPTION "Turlough of Criamon is tasked with governing the cemetery, funeral rites, and the protection of the spirits entrusted to the covenant. He is well-regarded within the covenant and beyond.\n\nHis own magical proficiencies concern the summoning of spirits, but he feels that there is more that he could gain from them if he could do more than just summon them. He is fearful of those within the covenant discovering his growing interest so any assistance he does gain will need to be from outside.\n\nHe has trained one apprentice already and gained a new apprentice at the last Tribunal, thanks to the cordial relations he maintains with the Coill Trí. This influence is something he would be happy to bargain with in order to further his magical aims."
    }

}
