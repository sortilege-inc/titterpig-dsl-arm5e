EXTENSION "ARMDef_The_Cradle_and_The_Crescent_Core_Ext" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - core type extensions"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_Core_Base"

    # The Cradle & The Crescent is an EXTENSION on the arm5e edition (spec S13 composition). The types below are
    # the ones the book adds: the Solomonic spell (a naranj -- an art, a level, the art's one parameter) and an art's
    # guidelines (Chapter Three).

    #ta40ba3ced267390ff3c319 ^"Solomonic Spell" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Art" STRING REQUIRED
            ^"Level" INTEGER
            ^"General Level" BOOLEAN
            ^"Parameter" STRING REQUIRED
            ^"Alteration" STRING
            ^"Detail" STRING
            ^"Potency" STRING
            ^"Allure" STRING
            ^"Delay" STRING
            ^"Ritual" BOOLEAN
            ^"Effect Design" STRING
            ^"Printed Stat Line" STRING
            ^"Source" STRING DEFAULT "The Cradle & The Crescent"
            ^"Page" INTEGER
        }
        DESCRIPTION "Sahirs learn their spells using the same mechanics as magi. They can invent a number of formulaic or ritual spells with total level equal to their teacher’s highest applicable lab total, substituting the teacher’s score in Teaching for the associated Ability; or by the sahir collecting enough points above the spell level in the associated art + Ability lab total over the course of one or more seasons to equal it. Sahirs often make use of laboratory texts to speed this process."
    }

    #tad715571a62d5d21d926ff ^"Solomonic Guidelines" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Art" STRING REQUIRED
            ^"Source" STRING DEFAULT "The Cradle & The Crescent"
            ^"Page" INTEGER
        }
        DESCRIPTION "The Art of Solomon, through its component arts, has a wide range of effects described by the guidelines in this section, with sample spells to demonstrate how these effects might be used. Players may safely assume that every listed guideline has been developed into a naranj at one time or another."
    }

}
