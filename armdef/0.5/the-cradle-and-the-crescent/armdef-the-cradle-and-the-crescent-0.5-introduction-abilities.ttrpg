EXTENSION "ARMDef_The_Cradle_and_The_Crescent_Introduction_Abilities" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter One: Introduction & Sagas abilities"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's abilities, structured; each DESCRIPTION the source's text, verbatim.

    #ta2d15eaa08e919e846a7df ^"Islamic Law (The Cradle & The Crescent)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Islamic Law"
            ^"Ability Type" STRING "Academic" FIXED
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This is the Muslim version of Civil & Canon Law. The major sources of Islamic Law are the *Qur’an* and the *Sunna*. **Specialties:** any one of the sources of Islamic Law, particular topics, customs of a particular area.\n\n**Theology: Islam***\n\n*Academic* This is the Islamic equivalent of Christian Theology. The major sources for Islamic theology are the *Qur’an* and the *Sunna*. **Specialties:** the *Qur’an*, debates, history, prophets."
    }

    #td4bde31891703a32a9e361 ^"Theology: Islam (The Cradle & The Crescent)" DEF {
        EXTENDS #tLzvYKtdVMBerES3oaOuTyEy ^"Ability"
        PROPERTIES {
            ^"Printed Name" STRING "Theology: Islam"
            ^"Ability Type" STRING "Academic" FIXED
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 15
        }
        DESCRIPTION "This is the Islamic equivalent of Christian Theology. The major sources for Islamic theology are the *Qur’an* and the *Sunna*. **Specialties:** the *Qur’an*, debates, history, prophets."
    }

}
