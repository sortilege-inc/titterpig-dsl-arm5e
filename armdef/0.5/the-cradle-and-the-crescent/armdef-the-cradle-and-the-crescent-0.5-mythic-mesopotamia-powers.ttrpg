EXTENSION "ARMDef_The_Cradle_and_The_Crescent_MythicMesopotamia_Powers" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter Seven: Mythic Mesopotamia powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's powers, structured; each DESCRIPTION the source's text, verbatim.

    #t8dad365c4806e939e417ef ^"Crafter of Brass (Arzanjani brass-smith power)" DEF {
        EXTENDS #tL4MotIBVF5lx9HoVrT1yDlM ^"Power"
        PROPERTIES {
            ^"Printed Name" STRING "Crafter of Brass"
            ^"Creature" STRING "Arzanjani brass-smith"
            ^"Group" STRING "Lesser Power"
            ^"Might Cost" STRING "1 Fatigue level"
            ^"Initiative" STRING "Init equal to (Qik – 6)"
            ^"Form" STRING "Terram"
            ^"Range, Duration, Target" STRING "R: Touch, D: Conc, T: Ind"
            ^"Printed Stat Line" STRING "ReTe 15 (base 4, +1 Touch, +1 Conc, +1 for intricacy): Lesser Power (15 levels, –2 Might cost)"
            ^"Technique and Form" STRING "ReTe"
            ^"Level" INTEGER 15
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 136
        }
        DESCRIPTION "A piece of brass touched by the user of this power becomes supple to the touch, so that it can be reshaped into a different form. This does not enable the smith to fuse pieces together, so she must still carefully cut out the basic shapes of the objects to be made. However, it does enable an imaginative smith to create pieces of great intricacy and beauty."
    }

}
