EXTENSION "ARMDef_The_Cradle_and_The_Crescent_MythicMesopotamia_Tables" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter Seven: Mythic Mesopotamia tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #te5235f1f046e4f542aacfa ^"The Starving Gods (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Term", "Text"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 121
        }
        TABLE {
            "Ereshkigal" "Weeping queen of the Underworld; wife of Nergal; cult center at Kutha."
            "Sin" "Moon god; god of wisdom; cult centers at Ur and Harran."
            "Shamash" "Sun god; god of justice; cult centers at Sippar and Larsa."
            "Marduk" "Patron deity of Babylonia; king of the gods; cult center at Babylon"
            "Ashshur" "Patron deity of Assyria; king of the gods; cult center at Ashshur."
        }
    }

}
