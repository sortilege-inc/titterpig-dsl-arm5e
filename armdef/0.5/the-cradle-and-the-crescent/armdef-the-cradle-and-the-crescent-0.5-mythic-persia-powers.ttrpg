EXTENSION "ARMDef_The_Cradle_and_The_Crescent_MythicPersia_Powers" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - Chapter Eight: Mythic Persia powers"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"
    DEPENDS_ON "ARMDef_The_Cradle_and_The_Crescent_Core_Ext"

    # The chapter's powers, structured; each DESCRIPTION the source's text, verbatim.

    #ta3470d69fc62799174aed0 ^"Command the Masses (Ghuzz power)" DEF {
        EXTENDS #tL4MotIBVF5lx9HoVrT1yDlM ^"Power"
        PROPERTIES {
            ^"Printed Name" STRING "Command the Masses"
            ^"Creature" STRING "Ghuzz"
            ^"Group" STRING "Greater Power"
            ^"Might Cost" STRING "no cost"
            ^"Initiative" STRING "Init Qik – 2"
            ^"Form" STRING "Mentem"
            ^"Source" STRING "The Cradle & The Crescent"
            ^"Page" INTEGER 144
        }
        DESCRIPTION "The Ghuzz can issue an order, and a standard Group of men are strongly inclined to obey this order. In battle, this secures total leadership, and the Ghuzz need not spend his turn forming a trained group or changing their actions. ReMe 30 (Base 5, +2 Voice, +1 Diam, +2 Group) Greater Power (30 levels, –3 Might/Fatigue cost, +1 Init)"
    }

}
