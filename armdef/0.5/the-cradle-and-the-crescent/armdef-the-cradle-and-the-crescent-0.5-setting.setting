SETTING "ARMDef_The_Cradle_and_The_Crescent_Setting" {
    NAME "Ars Magica Fifth Edition, The Cradle & The Crescent - the Mythic Middle East: places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-07"

    # The Mythic Middle East as The Cradle & The Crescent prints it. HISTORY: Appendix B's timeline (pp.188-189),
    # each entry as printed, its date the PERIOD. LOCATION: the Mythic Middle East, its regions (Chapters Six to Nine:
    # Arabia, Mesopotamia, Persia, Transoxiana and the East, as the book's maps title them), each place those
    # chapters print as a heading, and the Lands of the Jinn (Chapter Four). TAGS: root, region or place. A place's
    # text is in its chapter's .lore, under its heading.

    HISTORY {
        ENTRY ^"c. 950 BC" #t9a6c1a9f24f2926924e0d3 {
            PERIOD "c. 950 BC"
            DESCRIPTION "Suleiman first practices his Art in the Middle East."
        }
        ENTRY ^"650" #te34ec15f9d28e5bffef1b3 {
            PERIOD "650"
            DESCRIPTION "Birth of Zoroaster."
        }
        ENTRY ^"550–330" #t56ffaf6f1e3b76c0d8c4ad {
            PERIOD "550–330"
            DESCRIPTION "The Achaemenid Empire, founded by Cyrus The Great and ended by Alexander the Great; at its height, it encompasses Anatolia, Mythic Persia, the Levant, as well as Transoxiana and Egypt, and also engages in significant territorial disputes with the Greek city-states. Zoroastrianism established by Cyrus as the official state religion. Fire temples are built across the empire under Antaxerxes II. Zoroastrian calendar is formalized. Zurvan heresy emerges."
        }
        ENTRY ^"539" #tb25f24b688b6fd4715f06a {
            PERIOD "539"
            DESCRIPTION "Destruction of Babylon by Persians under Cyrus the Great."
        }
        ENTRY ^"334–326" #t0bc7b44e26cae0f187d61b {
            PERIOD "334–326"
            DESCRIPTION "Conquest of Persia by Alexander the Great. Slaughter of Mazdean priests, destruction of literature. Fire temples are destroyed."
        }
        ENTRY ^"323" #t4b31ce67f69f4ba6ba99e3 {
            PERIOD "323"
            DESCRIPTION "Death of Alexander the Great."
        }
        ENTRY ^"312–61" #tcd2083f9b14d910d43cff5 {
            PERIOD "312–61"
            DESCRIPTION "BC The Seleucid Empire of Persia, one of the successor states of the empire established by Alexander the Great."
        }
        ENTRY ^"141 BC–224" #t1c1bbd585208adeeaed4a1 {
            PERIOD "141 BC–224"
            DESCRIPTION "AD Empire of the Parthians in Persia. Revival of Mazdean faith, rediscovery of many lost traditions and scriptures."
        }
        ENTRY ^"224 AD" #t6a035859b79c22bc73ac69 {
            PERIOD "224 AD"
            DESCRIPTION "Ardeshir I defeats the Parthian king and becomes the first ruler of the Sasanid dynasty of Persia. High priest Tansar fixes the Mazdean canon. His successor Kirder reorganizes the priesthood. Many fire temples refounded. Oral tradition is recorded."
        }
        ENTRY ^"412" #ta7d8adb4fe8116c68aeb17 {
            PERIOD "412"
            DESCRIPTION "Cult of Mercury disbanded."
        }
        ENTRY ^"c. 570" #t8efb66e8bfaa74a14e08bc {
            PERIOD "c. 570"
            DESCRIPTION "Birth of Muhammad."
        }
        ENTRY ^"610" #t2d4c88d13e16a75e50fd62 {
            PERIOD "610"
            DESCRIPTION "Muhammad receives first revelation."
        }
        ENTRY ^"622" #te005017d9cb96efc3249f8 {
            PERIOD "622"
            DESCRIPTION "Muhammad emigrates from Mecca to Medina. Date of start of Muslim calendar."
        }
        ENTRY ^"630" #t5ba11d21e8d058865dfcbb {
            PERIOD "630"
            DESCRIPTION "Muhammad takes Mecca."
        }
        ENTRY ^"632" #t22e5654e41c3a269af7be1 {
            PERIOD "632"
            DESCRIPTION "Death of Muhammad. Abu Bakr caliph."
        }
        ENTRY ^"632–644" #tfffa7060a1a03486135865 {
            PERIOD "632–644"
            DESCRIPTION "Muslims take Syria, the Holy Land and Egypt."
        }
        ENTRY ^"634" #t090dc03297985c020d30bd {
            PERIOD "634"
            DESCRIPTION "Death of Abu Bakr. ‘Umar caliph."
        }
        ENTRY ^"637–651" #te45f86905abe7f10620fd0 {
            PERIOD "637–651"
            DESCRIPTION "The Islamic Conquest of Persia, leading to the end of both Sasanid rule and Zoroastrian dominance. Much slaughter of Mazdean priests and forced conversions."
        }
        ENTRY ^"644" #t5b209762def9bf84abdcd8 {
            PERIOD "644"
            DESCRIPTION "Death of ‘Umar. ‘Uthman caliph."
        }
        ENTRY ^"644–671" #tb28c6dde8a12c2244142d8 {
            PERIOD "644–671"
            DESCRIPTION "Muslims take Khurasan."
        }
        ENTRY ^"656" #tcccc6cb4ced4dd9eac6bea {
            PERIOD "656"
            DESCRIPTION "Death of ‘Uthman. ‘Ali caliph."
        }
        ENTRY ^"661" #tb1328f2b083deaf931df78 {
            PERIOD "661"
            DESCRIPTION "Death of ‘Ali. Mu’awiya first caliph of Umayyad dynasty. Jizya imposed on non-Muslims. Conversion of Mazdeans is sporadic. Most Persians still Mazdean."
        }
        ENTRY ^"680" #td4c33657836449efad8df5 {
            PERIOD "680"
            DESCRIPTION "Battle of Karbala’, death of al-Husayn."
        }
        ENTRY ^"c. 700" #tf27c79122495eb49a3fba5 {
            PERIOD "c. 700"
            DESCRIPTION "The first Solomonic summoners swear service to the Umayyad caliphs."
        }
        ENTRY ^"707" #tba709d9fc39a7dc2afb99e {
            PERIOD "707"
            DESCRIPTION "Muslims take North Africa."
        }
        ENTRY ^"712" #t83008d9ba99c385c7a47ea {
            PERIOD "712"
            DESCRIPTION "Muslims invade Spain."
        }
        ENTRY ^"717" #t5aae7b6bf3f4c56ec7565b {
            PERIOD "717"
            DESCRIPTION "Muslims cross Pyrenees into France."
        }
        ENTRY ^"c. 720" #t004ad2d8fec2f6277fd6c9 {
            PERIOD "c. 720"
            DESCRIPTION "Umayyad summoners and jinn at war"
        }
        ENTRY ^"732" #t723b92267af322c9884ae8 {
            PERIOD "732"
            DESCRIPTION "Muslims defeated by Franks under Charles Martel at Poitiers."
        }
        ENTRY ^"746" #tff3d82c9c7b349eb407fb5 {
            PERIOD "746"
            DESCRIPTION "Jinn lay siege to Damascus."
        }
        ENTRY ^"750" #tb4b754167b344287b5cd8a {
            PERIOD "750"
            DESCRIPTION "Fall of Umayyad caliphate. Al-Saffah first ‘Abbasid caliph."
        }
        ENTRY ^"762" #t0f8a695426e79511cc35c8 {
            PERIOD "762"
            DESCRIPTION "Foundation of Baghdad."
        }
        ENTRY ^"767" #ta4629f2dbb4d6bd7eb0c70 {
            PERIOD "767"
            DESCRIPTION "Order of Hermes founded."
        }
        ENTRY ^"786–809" #t298d9f0292b156f1d634d0 {
            PERIOD "786–809"
            DESCRIPTION "Reign of Harun al-Rashid."
        }
        ENTRY ^"786" #tc73e9a7c0bb8e5654a22db {
            PERIOD "786"
            DESCRIPTION "Harun al-Rashid becomes caliph, invites scholars to serve as viziers on his “Solomonic” council."
        }
        ENTRY ^"787" #t154cdd5d386e80d146f9df {
            PERIOD "787"
            DESCRIPTION "First Council of Harun al-Rashid established."
        }
        ENTRY ^"789" #ta533869e40527eb29c5a27 {
            PERIOD "789"
            DESCRIPTION "Grand vizier Al-Khayzuran dies. Yahya ibn Khalid retires, Ja’far ibn Yahya becomes grand vizier."
        }
        ENTRY ^"803" #t097373a41e144d0867656a {
            PERIOD "803"
            DESCRIPTION "Grand Vizier Ja’far beheaded, Yahya imprisoned."
        }
        ENTRY ^"848" #tebec32e924992b8f50ee9b {
            PERIOD "848"
            DESCRIPTION "Sundering of House Tremere."
        }
        ENTRY ^"805" #tea6d84921747aa216444c1 {
            PERIOD "805"
            DESCRIPTION "The Suhhar Sulayman established in Baghdad with the first meeting of the Majlis al-Sulayman."
        }
        ENTRY ^"869 – 917" #t4b35808682b9ac248d51bc {
            PERIOD "869 – 917"
            DESCRIPTION "Persian Muslim dynasties gain power under ‘Abbasid caliphate. Persecution of Mazdeans intensifies to 917. Leaders of Persian Mazdeans sail from Persian Gulf to a fabled Eastern land."
        }
        ENTRY ^"925" #tc25cb52381122f17fe21eb {
            PERIOD "925"
            DESCRIPTION "Iberian sahirs split from the Suhhar Sulayman."
        }
        ENTRY ^"945" #t01577eb99daffaffc3e412 {
            PERIOD "945"
            DESCRIPTION "Persian Buyids take control of Baghdad and the caliphate."
        }
        ENTRY ^"961" #tcd6033f48d7a6a1c5550a6 {
            PERIOD "961"
            DESCRIPTION "Execution of Tasgillia."
        }
        ENTRY ^"1003–1012" #ta0bd84a49c80a80f6b32a6 {
            PERIOD "1003–1012"
            DESCRIPTION "Schism War."
        }
        ENTRY ^"1009" #t82847d69778de850ba5f5d {
            PERIOD "1009"
            DESCRIPTION "Ferdowsi finishes the *Shahnameh*, the Persian “Book of Kings.”"
        }
        ENTRY ^"1037" #t4f3a57b07cec4b78cd8ae1 {
            PERIOD "1037"
            DESCRIPTION "The Seljuk Togril Beg unites the Turkomen tribes of the Great Steppe and invades Persia. In 1055 he takes Baghdad, and assumes control over the caliph and the armies of the ‘Abbasid caliphate. His successor Alp Arslan extends the sultanate to Anatolia, Armenia, and Georgia. Increased persecution of Mazdeans."
        }
        ENTRY ^"1090" #t1213e862845f7d8ed68d88 {
            PERIOD "1090"
            DESCRIPTION "Hasan-i Sabbah takes Alamut."
        }
        ENTRY ^"1092" #t295ea67b35ab0c9592332b {
            PERIOD "1092"
            DESCRIPTION "Death of Malik Shah and partial fragmentation of the Seljuk Sultanate between his sons."
        }
        ENTRY ^"1095–1109" #tecca68ff0ec54328eb7b24 {
            PERIOD "1095–1109"
            DESCRIPTION "First Crusade. Soldiers from Europe take much of Levantine coast and establish states at Antioch, Edessa, Tripoli, and Jerusalem."
        }
        ENTRY ^"1131" #tf79728d48547c4f09bb940 {
            PERIOD "1131"
            DESCRIPTION "Ahmed Sanjar, son of Malik Shah, consolidates control over the western Seljuk Empire."
        }
        ENTRY ^"1144" #ta66479c00daeaf25ff8343 {
            PERIOD "1144"
            DESCRIPTION "Zangi takes Edessa."
        }
        ENTRY ^"1147–1148" #tac4334faec959ee0c5eade {
            PERIOD "1147–1148"
            DESCRIPTION "Second Crusade fails to take Damascus."
        }
        ENTRY ^"1149" #td3945ab6b0f320a013be29 {
            PERIOD "1149"
            DESCRIPTION "Shansabani coup in Khurasan, lead by Ala’uddin Hussain, also called Jahansoz — “World Burner.”"
        }
        ENTRY ^"1151" #t8f792e49aa5deb2b2bb5a8 {
            PERIOD "1151"
            DESCRIPTION "Ghuzz invade southeastern Persia, capture Sultan Ahmed Sanjar and hold him captive for three years."
        }
        ENTRY ^"1157" #tace7f9a30336b418077758 {
            PERIOD "1157"
            DESCRIPTION "‘Abbasid caliph al-Muqtafi (r. 1136– 1160) successfully defends Baghdad from Seljuks, securing independence of the caliphate."
        }
        ENTRY ^"1174–1187" #t16b8b1fc67e7e83f2580ac {
            PERIOD "1174–1187"
            DESCRIPTION "Saladin unites Muslim Levant, takes Jerusalem and much of coast from crusaders."
        }
        ENTRY ^"1180–1225" #t53304dcc37695e561a4c48 {
            PERIOD "1180–1225"
            DESCRIPTION "Reign of the ‘Abbasid caliph al-Nasir."
        }
        ENTRY ^"1189–1192" #tc22333df1c78e2c933be49 {
            PERIOD "1189–1192"
            DESCRIPTION "Third Crusade secures territory on coast but fails to take Jerusalem."
        }
        ENTRY ^"1194" #t6310d72330b286833ea1fe {
            PERIOD "1194"
            DESCRIPTION "Tekish, the ruler of Khwarazm, defeats Togril III, ending Seljuk rule of Persia."
        }
        ENTRY ^"1195" #t194b74a43fabb5201edb52 {
            PERIOD "1195"
            DESCRIPTION "Most recent Grand Tribunal held."
        }
        ENTRY ^"1202–1204" #t8691d62accff5877157e60 {
            PERIOD "1202–1204"
            DESCRIPTION "Fourth Crusade takes Constantinople."
        }
        ENTRY ^"1205" #tf20acb2b07519bb8e02052 {
            PERIOD "1205"
            DESCRIPTION "Ala al-Din (son of Tekish) conquers Persia and proclaims himself *shah* (emperor)."
        }
        ENTRY ^"1206" #tb93b4c80b7481293164575 {
            PERIOD "1206"
            DESCRIPTION "Shansabani Sultan Mohammed al-Ghuri assassinated on the banks of the River Sind by a Nizari; the Khwarazmshah forces the Shansabani to concede control of Khurasan."
        }
        ENTRY ^"1212" #t3fb55007ff72935f9aa397 {
            PERIOD "1212"
            DESCRIPTION "Ala al-Din adds Transoxanian territories to his empire and now rules all the land from the Jaxartes to the Tigris."
        }
        ENTRY ^"1218–1221" #t7d07545234c057a2ebae9d {
            PERIOD "1218–1221"
            DESCRIPTION "Crusaders temporarily hold territory in Egypt."
        }
        ENTRY ^"1219–1227" #t2eccd3657a6f054c85dfb9 {
            PERIOD "1219–1227"
            DESCRIPTION "Mongols under Genghis Khan take eastern Persia."
        }
        ENTRY ^"1230–1240" #te2e206e743e9ee5cd2d49b {
            PERIOD "1230–1240"
            DESCRIPTION "Mongols take western Persia, Georgia, Armenia, and northern Iraq."
        }
        ENTRY ^"1243" #td85464573904cab2450b44 {
            PERIOD "1243"
            DESCRIPTION "Mongols overwhelm Seljuk sultan of Asia Minor."
        }
        ENTRY ^"1248–1250" #t5b198f6a28f72bf154b181 {
            PERIOD "1248–1250"
            DESCRIPTION "Crusaders under St Louis temporarily hold territory in Egypt."
        }
        ENTRY ^"1256" #t535c483dbcaf582ad5de73 {
            PERIOD "1256"
            DESCRIPTION "Mongols destroy strongholds of Persian Assassins."
        }
        ENTRY ^"1258" #te3f58f1df2a7cc2080d74a {
            PERIOD "1258"
            DESCRIPTION "Mongols take Baghdad, put caliph to death."
        }
        ENTRY ^"1260" #t03c2e4380919272e81a36b {
            PERIOD "1260"
            DESCRIPTION "Mamluks halt Mongol advance in Syria."
        }
        ENTRY ^"1261" #t4a95d39b5921ba285c358d {
            PERIOD "1261"
            DESCRIPTION "Byzantines retake Constantinople. ‘Abbasid caliphate re-established in Cairo."
        }
        ENTRY ^"1265" #t4a79e2272c198b4e503ba1 {
            PERIOD "1265"
            DESCRIPTION "Mongols establish protectorate over Seljuk Asia Minor."
        }
        ENTRY ^"1268–1291" #t46586e48a5742793d4b16f {
            PERIOD "1268–1291"
            DESCRIPTION "Mamluks gradually re-conquer coast from crusaders."
        }
        ENTRY ^"1273" #t6cbb5d69e200a33c99ebee {
            PERIOD "1273"
            DESCRIPTION "Mamluks destroy last of Assassins’ strongholds in Syria."
        }
        ENTRY ^"1281" #td2662ee126d0b46c2cf8e4 {
            PERIOD "1281"
            DESCRIPTION "Mamluks defeat renewed Mongol invasion in Syria."
        }
        ENTRY ^"1295" #t45b4858c72858f275a3eda {
            PERIOD "1295"
            DESCRIPTION "Mongol khan of Persia becomes Muslim."
        }
    }

