EXTENSION "ARMDef_The_Fallen_Fane_Introduction_Tables" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Part One: Introduction tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_The_Fallen_Fane_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tec481fcfc1cca6ff65c4c6 ^"Character Priority (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Priority", "Character"]
            ^"Printed Name" STRING "Character Priority"
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 5
        }
        TABLE {
            "1" "Quirinus, the Praeco."
            "2" "Richildis, the Presiding Quaesitor."
            "3" "Necopinus"
            "4" "Bertoldus"
            "5" "Gunhilda"
            "6" "Orderic"
            "7" "Westamia"
            "8" "Viridia"
            "9" "Xavier"
            "10" "Saphronia"
            "11" "Umaldi"
            "12" "Ptolemaeus"
            "13" "Coriolanus"
            "14" "Hostiensis"
            "15" "Doraldus"
            "16" "Arviragus"
            "17" "Lalith"
            "18" "Theudar"
            "19" "Iacopo"
            "20" "Maximus"
            "21" "Kakondera"
            "22" "Junius"
            "23" "Flavius"
            "24" "Estella"
        }
    }

}
