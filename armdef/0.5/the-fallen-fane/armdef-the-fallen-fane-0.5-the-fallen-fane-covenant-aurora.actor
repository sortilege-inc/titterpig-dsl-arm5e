EXTENSION "ARMDef_The_Fallen_Fane_TheFallenFane_CovenantAurora" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Aurora"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_The_Fallen_Fane_Core_Ext"

    # Aurora: a covenant of the Rhine Tribunal (Part Two: The Fallen Fane, p14); its section the DESCRIPTION.

    #t11833067b62da688138b14 ^"Aurora" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Members" INTEGER 5
            ^"Present at the Tribunal" INTEGER 2
            ^"Magi" LIST [#tbaf2a195409a7fe2489e1e ^"Coriolanus", #tfa69b647d59d95eeb9170a ^"Junius"]
            ^"Printed Attendance" STRING "Aurora: Five members, two present. Coriolanus of Flambeau, Junius of Tremere."
            ^"Attendance Page" INTEGER 7
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Aurora is a very new covenant, having been officially recognised at the last tribunal. They are very poor in resources of all kinds, and are still struggling to ensure their survival. They have sent two representatives to the tribunal, Coriolanus of Flambeau, with two votes, and Junius of Tremere, with three."
    }

}
