EXTENSION "ARMDef_The_Fallen_Fane_TheFallenFane_CovenantFanum" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Fanum"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_The_Fallen_Fane_Core_Ext"

    # Fanum: a covenant of the Rhine Tribunal (Part Two: The Fallen Fane, p13); its section the DESCRIPTION.

    #tedcb04666f2ea458a379ff ^"Fanum" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Members" INTEGER 6
            ^"Present at the Tribunal" INTEGER 6
            ^"Magi" LIST [#tac7d3edb3f702d39188491 ^"Arviragus", #t4c56ac113e4c52cfb199c3 ^"Doraldus", #tfcbbbdfed86a146044b27a ^"Lalith", #td2b27a119f5f8474b0a51b ^"Necopinus", #t3d04538f16dc06164af311 ^"Ptolemaeus", #td06b0c7d5d364f3257c0a7 ^"Saphronia"]
            ^"Printed Attendance" STRING "Fanum: Six members, all present. Arviragus of Bjornaer, Doraldus of Verditius, Lalith of Bjornaer, Necopinus of Tremere, Ptolemaeus of Verditius, Saphronia of Flambeau."
            ^"Attendance Page" INTEGER 7
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 13
        }
        DESCRIPTION "Fanum does have supplies of vis and a reasonable library. Its recent actions are described above. Doraldus of Verditius, a member of Fanum, sent a letter to the other covenants of the Tribunal several seasons before the recent troubles started. In this letter he expressed concern about the activities of the other members, and asked any covenant that would consider offering him membership to respond. Your covenant did not, having other things to think about.\n\nPtolemaeus of Verditius came to Schola’s aid when it was attacked. The covenant is led by Archmage Necopinus of Tremere, and its other members are Arviragus and Lalith of Bjornaer and Saphronia of Flambeau. All its members are attending the tribunal, as failure to do so would almost certainly have resulted in a Wizards’ March being declared in absence, so they have one vote each."
    }

}
