EXTENSION "ARMDef_The_Fallen_Fane_TheFallenFane_CovenantSagitta" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Sagitta"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_The_Fallen_Fane_Core_Ext"

    # Sagitta: a covenant of the Rhine Tribunal (Part Two: The Fallen Fane, p14); its section the DESCRIPTION.

    #t6dfb1c84bc5f1e81b891ae ^"Sagitta" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Members" INTEGER 5
            ^"Present at the Tribunal" INTEGER 1
            ^"Magi" LIST [#t8b010c2c0d6570390c2f6f ^"Orderic"]
            ^"Printed Attendance" STRING "Sagitta: Five members, one present. Orderic of Jerbiton."
            ^"Attendance Page" INTEGER 7
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Sagitta is an old covenant, and known for being very conservative, and having a rigid internal hierarchy. The library is fairly average for its age (and thus good by the standards of many younger covenants), and it has never complained about a lack of vis. It has, unsurprisingly, sent a single representative to the tribunal, Archmage Orderic of Jerbiton, who controls five votes."
    }

}
