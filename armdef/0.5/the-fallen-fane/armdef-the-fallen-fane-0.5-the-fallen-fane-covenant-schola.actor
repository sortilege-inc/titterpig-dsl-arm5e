EXTENSION "ARMDef_The_Fallen_Fane_TheFallenFane_CovenantSchola" {
    NAME "Ars Magica Fifth Edition, The Fallen Fane - Schola"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-09"
    DEPENDS_ON "ARMDef_The_Fallen_Fane_Core_Ext"

    # Schola: a covenant of the Rhine Tribunal (Part Two: The Fallen Fane, p14); its section the DESCRIPTION.

    #t794ce3bd887e717c8e144b ^"Schola" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Members" INTEGER 4
            ^"Present at the Tribunal" INTEGER 2
            ^"Magi" LIST [#tc335d81e46e55e1062f873 ^"Bertoldus", #t60c19d9a772232ed66e312 ^"Theudar"]
            ^"Printed Attendance" STRING "Schola: Four members, two present. Bertoldus of Verditius, Theudar of Bjornaer."
            ^"Attendance Page" INTEGER 7
            ^"Source" STRING "The Fallen Fane"
            ^"Page" INTEGER 14
        }
        DESCRIPTION "Schola was a powerful covenant, until the recent events surrounding Fanum. It is now much weaker, and presumably trying to rebuild its power. It has sent two representatives to the tribunal, Bertoldus of Verditius and Theudar of Bjornaer, each of whom controls two votes."
    }

}
