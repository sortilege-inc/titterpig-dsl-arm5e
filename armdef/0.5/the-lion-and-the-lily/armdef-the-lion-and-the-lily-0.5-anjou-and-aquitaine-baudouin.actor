EXTENSION "ARMDef_The_Lion_and_the_Lily_AnjouAndAquitaine_Baudouin" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Baudouin"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Baudouin (Chapter Six: Anjou and Aquitaine, p78): one character, its stat lines verbatim fields.

    #tfd2ca3ca7cde54566033fd ^"Baudouin" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Covenant" LIST [#tcaa75e7a95b2746189b6d1 ^"Atsingani"]
            ^"Characteristics" STRING "Int –2, Per 0, Pre 0, Com –1, Str +1, Sta +1, Dex +3, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "32 (32)"
            ^"Decrepitude" STRING "0"
            ^"Virtues and Flaws" STRING "Branded Criminal; Puissant Bows, Tough; Weakness (loose women), Depressed"
            ^"Personality Trait" STRING "Surly +2, Brave +1, Bored +1"
            ^"Combat" STRING "Dagger: Init 0, Attack +9, Defense +6, Damage +4 Axe and round shield (mounted): Init +1, Attack +17, Defense +14, Damage +7 Axe and round shield (on foot): Init +1, Attack +14, Defense +11, Damage +7 Crossbow: Init +5, Attack +16, Defense +10, Damage +8"
            ^"Soak" STRING "+7"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20)"
            ^"Abilities" STRING "Animal Handling 3 (horses), Aquitaine Lore 2 (wilderness), Athletics 2 (running), Awareness 3 (keeping watch), Brawl 3 (dagger), Bows 5+2 (crossbow), Carouse 1 (dice), Concentration 1 (ambush), French 5 (Walloon), Hunt 3 (rabbits), Profession: Carpenter 2 (wagons), Ride 4 (long distance), Single Weapon 6 (axe), Stealth 3 (ambush), Survival 2 (forest)"
            ^"Equipment" STRING "Partial leather scale armor, axe, round shield, crossbow, grog pack containing carpenters’ tools and his lucky dice."
            ^"Encumbrance" STRING "2 (3)"
            ^"Appearance" STRING "A shifty-looking man with an unkempt beard and fierce blue eyes, whose face is somewhat marred by his criminal brand. He carries his weapons expertly."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Baudouin\n\nBaudouin is one of the more experienced Brabanters and has been in the service of Atsingani since his youth, when he received his criminal brand for thievery. Banditry has become second nature to him, although he is not particularly satisfied with the wandering life of the covenant, intermittent poverty, and lack of available womenfolk. He is usually selected for the vanguard whenever a raiding party is assembled, since he is reliably violent although not a natural leader."
    }

}
