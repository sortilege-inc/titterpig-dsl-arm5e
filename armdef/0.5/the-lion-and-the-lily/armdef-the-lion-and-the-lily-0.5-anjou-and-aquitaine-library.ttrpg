EXTENSION "ARMDef_The_Lion_and_the_Lily_AnjouAndAquitaine_Library" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Six: Anjou and Aquitaine library"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #t1e14e9a76b408dba5cb817 ^"Decem Libri Historiarum" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Decem Libri Historiarum"
            ^"Section" STRING "Famous Men of Tours"
            ^"Printed Entry" STRING "Decem Libri Historiarum (History of the Franks, in ten volumes): Summa, Organization Lore: Frankish Royalty (Level 4, Quality 14); Summa, Area Lore: France (Level 3, Quality 14); Summa, Magic Lore (Level 3, Quality 12); Summa, Divine Lore (Level 2, Quality 14); Summa, Intrigue (Level 2, Quality 10). Contains details of the Merovingian rulers, who were known to have supernatural powers."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 64
        }
    }

    #t0b67ad708e8cd780d0aa30 ^"Lives of the Fathers" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Lives of the Fathers"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 10
            ^"Section" STRING "Famous Men of Tours"
            ^"Printed Entry" STRING "Lives of the Fathers: Tractatus, Church Lore (Quality 10)"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 64
        }
    }

    #tf6fa58e23ba443b828de56 ^"Books on the Miracles of St. Martin" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Books on the Miracles of St. Martin"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 8
            ^"Section" STRING "Famous Men of Tours"
            ^"Printed Entry" STRING "Books on the Miracles of St. Martin (in four volumes, the last incomplete): Tractatus, Dominion Lore (Quality 8)."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 64
        }
    }

    #t0cea66de113bce02f17e41 ^"On the Courses of the Stars" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "On the Courses of the Stars"
            ^"Section" STRING "Famous Men of Tours"
            ^"Printed Entry" STRING "On the Courses of the Stars: Tractatus, Artes Liberales (Astronomy) (Quality 6); Tractatus, Church Lore (Quality 12). A commentary on the psalms with details of how to use the position of the stars to determine the time when the night office should be sung."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 64
        }
    }

}
