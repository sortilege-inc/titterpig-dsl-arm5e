EXTENSION "ARMDef_The_Lion_and_the_Lily_ChampagneAndBurgundy_Library" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Nine: Champagne and Burgundy library"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #t2fa1c6141717b513885f49 ^"Legends of Brittany" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Legends of Brittany"
            ^"Author" STRING "Breton conteurs"
            ^"Kind" STRING "Summa"
            ^"Level" INTEGER 3
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Legends of Brittany Summa, Faerie Lore (Level 3, Quality 5) Author: Celeres of Bonisagus Description: A collection of stories told by Breton conteurs, transcribed by Celeres of Bonisagus. This large volume describes numerous locations in Brittany that are tied to Arthur, and usually to faeries as well. Arthur’s battle with a giant atop Mont St. Michael and Merlin’s disappearance into the Forest of Broceliande feature prominently."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #t2e9635179822b2715727f1 ^"Arthur Among the Britons" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Arthur Among the Britons"
            ^"Author" STRING "Celeres of Bonisagus"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Arthur Among the Britons Tractatus, Area Lore: Britain (Quality 5) Author: Celeres of Bonisagus Description: Numerous Welsh tales tied in some way to King Arthur. These include the story of Culwych and Olwen, in which Arthur and his knights must recover numerous treasures so that Olwen’s father will allow the knight Culwych to marry her, and the Welsh Triads, short tales told in threes, like The Three Fortunate Concealments and The Three Great Queens of Arthur. Excerpts from the works of the sixth-century bard Taliesin are also included."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #ted1487f0583ea55805b1ac ^"The Llancarfan Saints’ Lives" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Llancarfan Saints’ Lives"
            ^"Author" STRING "Various monks at the monastery of Llancarfan in the twelfth century"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 6
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "The Llancarfan Saints’ Lives Tractatus, Dominion Lore (Quality 6) Authors: Various monks at the monastery of Llancarfan in the twelfth century. Description: A collection of hagiographic texts containing numerous references to Arthur. The Life of St. Cadoc mentions him twice, the Life of St. Padarn once, the Life of St. Carannog once, and the Life of Gildas numerous times. These works bridge the gap between the stories and tales of the first group and the histories of this one."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #t5590fb703219de3b9134d4 ^"History of the Britons" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "History of the Britons"
            ^"Author" STRING "Nennius, eighth-century British monk"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "History of the Britons Tractatus, Area Lore: Britain (Quality 5) Author: Nennius, eighth-century British monk Description: The author of this work begins by stating “I have made a heap of all that I have found” concerning the history of Britain, beginning with its founding by Brutus, the great-grandson of Aeneas. This is the earliest book to give an account of the life of Arthur."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #td0aa17aa6d908139a8b1aa ^"History of the Kings of Britain" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "History of the Kings of Britain"
            ^"Author" STRING "Geoffrey of Monmoth, a twelfth century Oxford cleric"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 9
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "History of the Kings of Britain Tractatus, Area Lore: Britain (Quality 9) Author: Geoffrey of Monmoth, a twelfth century Oxford cleric Description: This book greatly expands upon the work of Nennius, focusing on Arthur’s adventures. It also includes the Prophecies of Merlin, a series of prophetic utterances from the legendary wizard. The section on Arthur ends with the king being wounded grievously wounded by his traitorous nephew Mordred and leaving for the Isle of Avalon to treat his wounds."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #tacf8bceffcd8b651fb5448 ^"The Lais of Marie de France" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Lais of Marie de France"
            ^"Author" STRING "Marie de France"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "The Lais of Marie de France Tractatus, Charm (Quality 5) Author, Marie de France Description: Marie de France was a fixture at the court of Marie of Champagne, daughter of Eleanor of Aquitaine. This widely popular collection of her “lais” (poems set to music) honored love and chivalry. The original sources for many of these were Breton tales, and their wide dissemination laid the groundwork for the romance form."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #tf14b5aa8268f833194fddc ^"Arthurian Romances" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Arthurian Romances"
            ^"Author" STRING "Chretien de Troyes"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 6
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Arthurian Romances Tractatus, Etiquette (Quality 6) Author: Chretien de Troyes Description: A collection of Chretien’s four major Arthurian poems, Erec et Enide, Cliges, Yvain, and Lancelot. These deal primarily with the nature of courtly love and the ideals of chivalry."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #tbfb7a5435509d9e574cdaa ^"Perceval" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Perceval"
            ^"Author" STRING "Chretien de Troyes"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 6
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Perceval Tractatus, Dominion Lore (Quality 6) Author: Chretien de Troyes Description: An unfinished story about naive boy who became a knight through a series of misadventures, this is the first work to mention the Grail. His life is changed when he visits a mysterious castle and encounters the equally mysterious Grail. Discovering that his failure to ask about the Grail’s true nature has prevent his host, the Fisher King, from being healed of his grievous wound, Perceval sets out to rectify his error. While both Perceval and his fellow knight Gawain triumph in a series of adventures, the secret of the Grail is never revealed, as Chretien died before completing the poem. No fewer than four later authors published their own “continuations,” each bringing the story to a close in their own ways."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #t07d1ff4c610b8efb73b434 ^"Joseph d’Arimethie" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Joseph d’Arimethie"
            ^"Author" STRING "Robert de Boron"
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Joseph d’Arimethie Tractus, Dominion Lore (Quality 5) Author: Robert de Boron Description: Also called The Romance of the Grail, this book expands upon the mystery of the Grail, explaining that it was the vessel in which Jesus had broken the bread at the Last Supper and that Joseph of Arimethea used to collect Jesus’ blood at the Crucifixion. Following the Resurrection, Joseph and his family took the Holy Grail (as Robert calls it) to England, where they and their descendants, including Perceval, guarded it."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #tac7f1c6624d10fc459ed2d ^"Parsifal" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "Parsifal"
            ^"Author" STRING "Wolfram von Eschenbach"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 5
            ^"Held By" LIST [#tdc4bd16737c7f4eef04a98 ^"Cunfin"]
            ^"Section" STRING "Folk Tales"
            ^"Printed Entry" STRING "Parsifal Tractatus, Magic Lore (Quality 5) Author: Wolfram von Eschenbach Description: Written in German, rather than the French of the other major romances, this story is a greatly expanded version of Chretien’s masterpiece that differs significantly from the French retellings and continuations. Wolfram is writing about a very different type of Grail from his predecessors, and this book is rich with alchemical and astrological imagery and shows abundant Arabic influence. The story describes the resting place of the Grail as a castle called Munsalvaesche, where is guarded by an order of Templars."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 108
        }
    }

    #t9bc1854e162ed7be9a7477 ^"Rashi’s two great commentaries" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "two great commentaries"
            ^"Author" STRING "Rashi"
            ^"Kind" STRING "Tractatus"
            ^"Quality" INTEGER 13
            ^"Section" STRING "Rashi"
            ^"Printed Entry" STRING "the two great commentaries are both tractatus in Theology (Judaism) with a Quality of 13."
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 106
        }
    }

}
