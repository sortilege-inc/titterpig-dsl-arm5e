EXTENSION "ARMDef_The_Lion_and_the_Lily_FlandersAndPicardy_EulogiusOfHouseExMiscellanea" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Eulogius of House Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Eulogius of House Ex Miscellanea (Chapter Eight: Flanders and Picardy, p103): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #tb7be72a8700ec7e331df34 ^"Eulogius of House Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#taa797ab6547d4d156c4d96 ^"Requies Aeterna"]
            ^"Age" STRING "130? (Apparent age 104)"
            ^"Personality Trait" STRING "Addled +3, Forgetful +1, Sinister +1"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 103
        }
        DESCRIPTION "Eulogius is perhaps the only remaining founder of the Donatores, but his years of fame and active search for the restless dead are many decades behind him. Now an elderly man, he is likely not far from Final Twilight. One of his most crippling Twilight scars is that his body is slowly becoming cadaverous; he is now almost impossibly gaunt and his skin is withered and lifeless. Another is that he is pained by sunlight, therefore he mostly remains in his subterranean sanctum. Despite these handicaps, Eulogius is a peerless banisher, and he has become a master in the Arts of Perdo, Corpus, and Mentem in the long years since his induction into the Order."
    }

}
