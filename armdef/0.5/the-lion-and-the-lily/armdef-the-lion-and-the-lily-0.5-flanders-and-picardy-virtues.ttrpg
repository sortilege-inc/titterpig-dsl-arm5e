EXTENSION "ARMDef_The_Lion_and_the_Lily_FlandersAndPicardy_Virtues" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Eight: Flanders and Picardy virtues"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's virtues, structured; each DESCRIPTION the source's text, verbatim.

    #tbb1cbd98e79d37c0e4f900 ^"Faerie Blood (Spinnen)" DEF {
        EXTENDS #t1nZXXugNY4VguZEkVj0BTj7 ^"Faerie Blood"
        PROPERTIES {
            ^"Printed Name" STRING "New Minor Virtue: Faerie Blood (Spinnen)"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 97
        }
        DESCRIPTION "A character who has Spinnen Blood can convert his or her own body weight of fiber into cloth per day, simply by touching it. Old cloth, or products made of cloth fibers, can be unwoven using the same ability, but this counts toward the maximum weight of cloth a character can alter per day. Some Spinnen, particularly those who have served as companions to magi, create other useful objects, like tents, ropes, or sails in lieu of the same weight of cloth."
    }

}
