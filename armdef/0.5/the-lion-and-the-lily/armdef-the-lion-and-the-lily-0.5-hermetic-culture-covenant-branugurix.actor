EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_CovenantBranugurix" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Branugurix"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Branugurix (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p28): a covenant of the Tribunal’s past, from its register entry.

    #t4c5cfade6ecf08fadc1b28 ^"Branugurix" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "791 – 1012"
            ^"Vassals" LIST [#tc29e9f869622a90fb12d21 ^"Baiocassium", #t6780e1590a51aed35f78da ^"Kerguntuil", #te8026fb44a90a687c07c2f ^"Caput Capra"]
            ^"Location" LIST [#t3f37602f5cbfea2d0288d7 ^"County of Rennes"]
            ^"Register Entry" STRING "Branugurix (791 – 1012): Domus magna of House Diedne, located in a regio close to Mount Dol (see Brittany: County of Rennes). Its name was actually Bren Gwrac’h, but the Order adopted a Gallic version of the name for ease of use in Latin. The entrances to the regio were somehow closed by the Primus of the house during the climactic battle of the Schism War, and some Flambeau and Tremere magi were lost, trapped inside. The exact location and the former method of entering the regio is detailed in the records of House Guernicus (and perhaps elsewhere), but is not widely known. There are rumors that some members of House Diedne survived within the regio, and that there are some who are working to free them from their centuries-long imprisonment. House Guernicus takes a great interest in those who spend a lot of time in the area around Mount Dol."
            ^"Register Page" INTEGER 28
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 28
        }
    }

}
