EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_CovenantInfelicitas" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Infelicitas"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Infelicitas (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #t112f54b5f32996e8ee330f ^"Infelicitas" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1099 – 1158"
            ^"Liege" LIST [#td930f6dae8abded92ad0b4 ^"Fudarus"]
            ^"Register Entry" STRING "Infelicitas (1099 – 1158): Vassal of Fudarus, founded when Rancrax of Tytalus lost a wager with his rival, and was forced to leave Fudarus as per the terms of the bet. The covenant foundered when Rancrax was slain in Wizard’s War by a member of Moles Magna, and the remaining two magi were not interested in continuing at the site."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
