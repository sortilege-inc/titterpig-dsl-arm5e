EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_CovenantKerguntuil" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Kerguntuil"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Kerguntuil (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p28): a covenant of the Tribunal’s past, from its register entry.

    #t6780e1590a51aed35f78da ^"Kerguntuil" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "920 – 1007"
            ^"Liege" LIST [#t4c5cfade6ecf08fadc1b28 ^"Branugurix"]
            ^"Location" LIST [#t17d001ca8d8f5f55eb7d07 ^"Mainland Armor and Argoat"]
            ^"Register Entry" STRING "Kerguntuil (920 – 1007): Vassal of Branugurix. A coastal covenant situated on the Rose Coast (see Brittany: Mainland Armor and Argoat). The members of Kerguntuil were particularly interested in the many Breton tales regarding giants, and many of their covenfolk were larger than average humans. It is rumored that a Quaesitor suggested to the Templars that they built their chapel at Lanleff to cleanse the region from the diabolic taint of the Diedne."
            ^"Register Page" INTEGER 28
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 28
        }
    }

}
