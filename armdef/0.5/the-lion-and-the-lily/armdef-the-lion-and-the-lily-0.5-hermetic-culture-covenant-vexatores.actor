EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_CovenantVexatores" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Vexatores"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # Vexatores (Chapter Three: Hermetic History and Culture, Past and Present Covenants, p29): a covenant of the Tribunal’s past, from its register entry.

    #t56d03bc757ce4b34ba103c ^"Vexatores" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1048 – 1064"
            ^"Liege" LIST [#td930f6dae8abded92ad0b4 ^"Fudarus"]
            ^"Register Entry" STRING "Vexatores (1048 – 1064): Vassal of Fudarus. Founded specifically to provoke Sinapis during the conflict between Houses Flambeau and Tytalus, Vexatores was founded 21 miles north of the Flambeau covenant (the minimum legal distance), at the site of one of the vis sources claimed from House Diedne. Vexatores was not intended to be a long-term prospect, and it was abandoned when the conflict between the Houses ended."
            ^"Register Page" INTEGER 29
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 29
        }
    }

}
