EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_Hooks" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Three: Hermetic History and Culture hooks"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's hooks, structured; each DESCRIPTION the source's text, verbatim.

    #t5f8f6c6a53a6d9927823f7 ^"Vis Lease" DEF {
        EXTENDS #tARMDefCompatCovenantHook ^"Covenant Hook"
        PROPERTIES {
            ^"Printed Name" STRING "Minor Resources Hook: Vis Lease"
            ^"Magnitude" STRING "Minor"
            ^"Category" STRING "Resources"
            ^"Kind" STRING "Hook"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 22
        }
        DESCRIPTION "One of the covenant’s vis sources is a legacy or a tropaeum rather than a seisin. When the lease expires, the covenant must campaign at the Tribunal to retain the lease on a legacy; or else compete in the Tourney to win the right to harvest a tropaeum. If taken for a legacy, this Hook presupposes that there is a reason why the vis source is not a tropaeum (for example, it might be newly discovered). This Hook can be taken more than once, affecting a different vis source each time."
    }

}
