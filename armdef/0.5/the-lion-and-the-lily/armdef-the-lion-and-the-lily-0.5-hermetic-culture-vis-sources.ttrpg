EXTENSION "ARMDef_The_Lion_and_the_Lily_HermeticCulture_VisSources" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Three: Hermetic History and Culture vis sources"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's vis sources, structured; each DESCRIPTION the source's text, verbatim.

    #tdad32c79eee0c97da8fc6f ^"Example Tropaea: Aquam" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Aquam"
            ^"List" STRING "Example Tropaea"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "On St. Martin’s day, Aquam vis in the form of sea foam is cast up onto a secluded beach."
    }

    #tb6e2c413436fccb5e97fe5 ^"Example Tropaea: Intellego" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Intellego"
            ^"List" STRING "Example Tropaea"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "Water from a secluded pool is worth Intellego vis if collected when the image of the second full moon in a month is reflected in it (this occurs about once every 3 years)."
    }

    #t9d3081a356990dfef9be45 ^"Example Tropaea: Auram" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Auram"
            ^"List" STRING "Example Tropaea"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "If the weather atop a particular hill can be captured in a bottle of blue glass on midwinter’s day, it becomes Auram vis."
    }

    #ta7544199b0825c59438580 ^"Example Tropaea: Corpus" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Corpus"
            ^"List" STRING "Example Tropaea"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "The discarded bandages of a certain leper colony are Corpus vis."
    }

    #tdf01bc02a20902fdc4b13b ^"Example Luctationes: Perdo" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Perdo"
            ^"List" STRING "Example Luctationes"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "A tree in a forest has a basilisk family nesting in its roots; the fruit of the tree, if the basilisks permit collection, is Perdo vis."
    }

    #t6e888cc92f4ef810d4d877 ^"Example Luctationes: Mentem" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Mentem"
            ^"List" STRING "Example Luctationes"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "The mournful song of a ghostly maiden is Mentem vis; first she must be enticed to sing her lament, then the magus must capture the song in physical form."
    }

    #tb336322f0d083093ef4324 ^"Example Luctationes: Animal" DEF {
        EXTENDS #tOyKnFGWkxgPeCHccUaG06R3 ^"Vis Source"
        PROPERTIES {
            ^"Art" STRING "Animal"
            ^"List" STRING "Example Luctationes"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 21
        }
        DESCRIPTION "There is a cliff ledge upon which a falcon nests every year. On the same day every year, a serpent tries to steal an egg; if prevented, the egg contains Animal vis. If successful, the serpent contains Vim vis (if it can be caught)."
    }

}
