EXTENSION "ARMDef_The_Lion_and_the_Lily_Normandy_Spells" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - Chapter Five: Normandy spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Lion_and_the_Lily_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t9ca04b7c7377b903da91fa ^"Piercing Lance of Bone" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "CrAn 20, R: Touch, D: Diam, T: Ind"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Creates a sharpened lance of hardened animal bone in the caster’s hand; this weapon has the same statistics as a normal lance. (Base 10, +1 Touch, +1 Diam)"
    }

    #tb498e032884c55fe4b7a27 ^"Stance of the Firm-Buttocked Knight" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReCo 20, R: Personal, D: Sun, T: Ind"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Prevents the caster from falling off a seat or saddle, even when vigorously disturbed. (Base 10, +2 Sun)"
    }

    #t963b9f39c6c0976ecb8e64 ^"The Unerring Lance" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diam"
            ^"Target" STRING "Ind"
            ^"Printed Stat Line" STRING "ReTe 20, R: Touch, D: Diam, T: Ind"
            ^"Source" STRING "The Lion and the Lily"
            ^"Page" INTEGER 60
        }
        DESCRIPTION "Cast upon a thrusting weapon such as a lance or spear, this spell will allow it to move in precisely one direction only, directly forward, without any perpendicular deviation. A Rego Terram spell of higher level is needed to deflect it, otherwise it can only be dodged, not parried. (Base 5, +1 Touch, +1 Diam, +1 complexity)"
    }

}
