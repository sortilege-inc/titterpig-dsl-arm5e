SETTING "ARMDef_The_Lion_and_the_Lily_Setting" {
    NAME "Ars Magica Fifth Edition, The Lion and the Lily - the Normandy Tribunal: places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"

    # The Normandy Tribunal as The Lion and the Lily prints it. HISTORY: Appendix A's timeline (pp.141-143), each
    # entry as printed, its date the PERIOD. LOCATION: the Tribunal, its regions (Chapters Four to Nine), each place
    # those chapters print as a heading, and each covenant's site (Chapter Eleven's Confluensis and its buildings,
    # and Dragon's Rest, under the Tribunal). TAGS: tribunal, region, covenant (a covenant's site; the covenant
    # itself is an .actor that points here) or place. A place's text is in its chapter's .lore, under its heading.

    HISTORY {
        ENTRY ^"51 BC" #te541fc09dd54fc2bbb39cd {
            PERIOD "51 BC"
            DESCRIPTION "Julius Caesar successfully concludes his campaign in Gaul; he writes the *Commentarii de Bello Gallico* (Commentaries on the Gallic Wars)."
        }
        ENTRY ^"250 AD" #t0afa4ee5689e2474e94972 {
            PERIOD "250 AD"
            DESCRIPTION "St. Denis and his companions begin to evangelize in Paris. He is imprisoned by the Governor."
        }
        ENTRY ^"275" #t84aa0c20b8253be7bcee3c {
            PERIOD "275"
            DESCRIPTION "St. Denis is martyred at Montmartre near Paris."
        }
        ENTRY ^"337" #ta4953b3c020bb30b3acbae {
            PERIOD "337"
            DESCRIPTION "St. Martin of Tours gives half his cloak to a freezing beggar."
        }
        ENTRY ^"371" #t0e366b73dd733579771f5b {
            PERIOD "371"
            DESCRIPTION "St. Martin becomes bishop of Tours."
        }
        ENTRY ^"397" #t92ba0f98f19032536d3eed {
            PERIOD "397"
            DESCRIPTION "St. Martin dies and St. Perpetuus becomes bishop of Tours."
        }
        ENTRY ^"4th century" #ta0524f8a84a011c016c114 {
            PERIOD "4th century"
            DESCRIPTION "The Huns begin invading Europe."
        }
        ENTRY ^"445" #t81dd65e0127eaa7d7669af {
            PERIOD "445"
            DESCRIPTION "Attila murders his brother and becomes undisputed leader of the Huns."
        }
        ENTRY ^"447" #tcda8412839c79a6ad1faa8 {
            PERIOD "447"
            DESCRIPTION "Merovech becomes king of the Salian Franks and rules until 458."
        }
        ENTRY ^"450" #t9240c14f889109a4c55b1a {
            PERIOD "450"
            DESCRIPTION "St. Geneviève prays for the Huns to avoid Paris, and they ignore the city."
        }
        ENTRY ^"451" #t2d461553e83244bf2b6e4e {
            PERIOD "451"
            DESCRIPTION "The Battle of Châlons — an alliance of Romans, Franks, and Visigoths lead by the legendary Merovech defeat the Huns and Ostrogoths in Gaul, ending Attila’s westward conquests."
        }
        ENTRY ^"458" #ta86cbf2c38d8e33d3a29fd {
            PERIOD "458"
            DESCRIPTION "Childeric inherits his father’s position as king of the Salian Franks."
        }
        ENTRY ^"464" #t4b1800a73aee6eed2f82bf {
            PERIOD "464"
            DESCRIPTION "Childeric besieges Paris, but the citizens are saved by St. Geneviève, who leads a party down the Seine at night to bring in food. 470 – 485 Successful campaigns of the Visigoth King Euric across Western Europe. 476 Fall of the Western Roman Empire as Italy is conquered by the Gothic king Odovacar; the beginning of the Dark Ages. 481 Clovis, a descendant of Merovech, rises to become King of the Franks; the start of the Merovingian dynasty. 496 Clovis is baptized and becomes the first Christian Frankish king. His people follow suit, although paganism takes centuries to fade among the Franks. 507 Clovis has by now defeated the Romans, the Burgundians, and the Visigoths, united the Franks, and established a capital in Paris. 511 Death of Clovis, though his magical lineage endures. One of his four sons succeeds him as Childebert I."
        }
        ENTRY ^"558" #t1ce4cf36d1f36fd65c421a {
            PERIOD "558"
            DESCRIPTION "Childebert dies childless; the kingship passes to his brother Chlotar. Under him, the Frankish kingdom has grown to include all of Provence, Burgundy, and Swabia."
        }
        ENTRY ^"567" #t8fa819e0728014b36c9b65 {
            PERIOD "567"
            DESCRIPTION "Sigebert wars on Chilperic, son of Chlotar; the Frankish kingdom fractures and becomes corrupted."
        }
        ENTRY ^"573" #t0eb7078bf79a44fc1cf623 {
            PERIOD "573"
            DESCRIPTION "Gregory appointed bishop of Tours."
        }
        ENTRY ^"584" #t94f366d98b6de5f0c0681c {
            PERIOD "584"
            DESCRIPTION "King Chilperic I dies leaving his wife, Fredegund, as regent for his unborn son, Chlotar II."
        }
        ENTRY ^"594" #t90b97f025a439a25ce2fed {
            PERIOD "594"
            DESCRIPTION "St. Gregory of Tours writes the *Historia Francorum* (History of the Franks)."
        }
        ENTRY ^"613" #t4542da372de130252243f6 {
            PERIOD "613"
            DESCRIPTION "Chlotar II “the Grand” reunites the Frankish kingdom and rules until 628."
        }
        ENTRY ^"628" #t76a86f5a3f65f0e01c342e {
            PERIOD "628"
            DESCRIPTION "Dagobert, king of Austrasia and son of Chlotar, becomes Fing of the Franks, ruling Austrasia, Neustria, Burgundy, and Aquitaine."
        }
        ENTRY ^"637" #t0a0b0963a5897db701b28e {
            PERIOD "637"
            DESCRIPTION "Dagobert I dies and the kingdom fragments again."
        }
        ENTRY ^"679" #t65292516b08c786432ba97 {
            PERIOD "679"
            DESCRIPTION "The kingdom of the Franks is again united, now under Theoderic III, but the monarchy is subservient to the Mayor of the Palace, Ebroin."
        }
        ENTRY ^"687" #t6afa59b79705f28e576bd4 {
            PERIOD "687"
            DESCRIPTION "Pepin “the Large,” of the Frankish mayoral dynasty, gives himself the title *Dux et Princeps Francorum*, and rules most of the Frankish empire. The power of the Merovingian kings is by now insignificant — they are little more than puppets. 731 – 767 Trianoma travels widely and contacts numerous wizards who visit with Bonisagus — many of these become Founders. 732 The Battle of Tours — Charles, illegitimate son and successor of Pepin II, wins a great victory over an Islamic army lead by Abd er Rahman, thereby halting the northward advance of Islam from Iberia. As a result of his tactical brilliance, he is hereafter known by the moniker Martel, meaning “hammer.” 738 Charles Martel campaigns successfully against the barbarian tribes. 742 Birth of Charles (later Charlemagne), son of Pepin III. 751 Pepin III “the Short” becomes king proper, crowned by St. Boniface; the start of the Carolingian dynasty, as the last of the Merovingians, Childeric III, is shorn and retired to a monastery. Pepin III is the first king to seek the pope’s anointment."
        }
        ENTRY ^"767" #td4085e4f1d6814eb179567 {
            PERIOD "767"
            DESCRIPTION "Foundation of the Order of Hermes. Bonisagus and the other Founders swear the Oath of Hermes. The first Tribunal gathering takes place at Durenmar."
        }
        ENTRY ^"768" #te8993a81a4b0c29261ebe4 {
            PERIOD "768"
            DESCRIPTION "Charlemagne becomes king of the Franks."
        }
        ENTRY ^"773" #t4915e3f18ab68b5a459d22 {
            PERIOD "773"
            DESCRIPTION "Second Grand Tribunal of the Order of Hermes. Procedures for lesser Tribunals are established: a Tribunal shall consist of at least twelve magi from at least four covenants."
        }
        ENTRY ^"774" #t91f04a6fba6b112323b8a2 {
            PERIOD "774"
            DESCRIPTION "Charlemagne defeats Desiderius and becomes King of Lombardy. He confirms the “donation” of these lands to the pope, and becomes protector of the Church."
        }
        ENTRY ^"778" #te804a5944a7e18dc4d01c8 {
            PERIOD "778"
            DESCRIPTION "The kingdom of Aquitaine is founded by Charlemagne."
        }
        ENTRY ^"782" #t0c0979c8ad8a72127452cb {
            PERIOD "782"
            DESCRIPTION "Charlemagne initiates schooling in the Frankish kingdom, and promotes literacy and education."
        }
        ENTRY ^"789" #t0c41bda867278712e94365 {
            PERIOD "789"
            DESCRIPTION "The Founder Jerbiton meets with Charlemagne, after having adopted a number of apprentices of the emperor’s mage-smith, Carolinus. Charlemagne issues a decree outlawing sorcery and paganism, but permits “benevolent magic” such as that practiced by Jerbiton."
        }
        ENTRY ^"791" #ta70e2421dccdb7dd2925b6 {
            PERIOD "791"
            DESCRIPTION "Branugurix, the domus magna of House Diedne, is founded in Brittany."
        }
        ENTRY ^"798" #t5b58153d6dcb4b55065f6b {
            PERIOD "798"
            DESCRIPTION "Tytalus steals the apprentice Hariste from Pralix, and founds Fudarus to provide a defensible place to train her. Pralix becomes the acting leader of House Tytalus. 799 Third Grand Tribunal of the Order of Hermes. 800 Charlemagne is crowned emperor in Rome; re-establishment of the western (Holy) Roman Empire. 807 Tytalus leaves Fudarus dressed only in a leper’s robe and veil, and carrying a staff. After visiting his followers, he enters the Maddenhofen Woods in Bohemia, and is never seen again. Hariste becomes the first Primus of Tytalus. 810 Covenant of Confluensis is founded. 814 Death of Charlemagne; he is succeeded by his remaining son Louis “the Pious.” 817 Fourth Grand Tribunal of the Order of Hermes. 822 Covenant of Bibracte is founded. 832 Fifth Grand Tribunal of the Order of Hermes. From henceforth, Grand Tribunals will meet every 33 years, regional Tribunals every 7 years from 836 AD."
        }
        ENTRY ^"840 – 855" #t88154ee18663912600f56b {
            PERIOD "840 – 855"
            DESCRIPTION "Reign of Lothar I. Covenant of Pagus is founded."
        }
        ENTRY ^"843" #tb7c68e1b48b680f113c62e {
            PERIOD "843"
            DESCRIPTION "The Treaty of Verdun ends four years of civil war among the grandsons of Charlemagne — his empire is divided between them."
        }
        ENTRY ^"845" #ta4323d5a80ab15738d6b0d {
            PERIOD "845"
            DESCRIPTION "Paris is sacked by Viking raiders."
        }
        ENTRY ^"851" #tbeefec0c7e0a1b6a701511 {
            PERIOD "851"
            DESCRIPTION "Covenant of Baiocassium is founded."
        }
        ENTRY ^"855 – 875" #td010c28aef02c8d374365c {
            PERIOD "855 – 875"
            DESCRIPTION "Reign of Louis II. Covenant of Sinapis is founded."
        }
        ENTRY ^"865" #t022c7828703b7fe29e3f38 {
            PERIOD "865"
            DESCRIPTION "Sixth Grand Tribunal of the Order of Hermes. The boundaries of the Tribunals are formally set according to the break-up of the Frankish Empire, and they are also named as the Rhine, West Franks, Lotharingian, Britannian, Roman, Theban, Eastern, and Greater Alps Tribunals."
        }
        ENTRY ^"871" #t1434f341c97af9e5f4a564 {
            PERIOD "871"
            DESCRIPTION "Inaugural meeting of the Tribunal of the West Franks."
        }
        ENTRY ^"875 – 877" #t9551418341a0192e66f414 {
            PERIOD "875 – 877"
            DESCRIPTION "Reign of Charles II “the Bald.” Covenant of Rotomagus is founded."
        }
        ENTRY ^"881" #tafbba73523240e09d4770c {
            PERIOD "881"
            DESCRIPTION "Charles “the Fat” reunites Charlemagne’s empire, becoming emperor. By now his realm is beset by attacks from Norsemen."
        }
        ENTRY ^"885" #te0341356c71411393abde8 {
            PERIOD "885"
            DESCRIPTION "Paris is besieged by Viking raiders."
        }
        ENTRY ^"887" #t9c8be9b0592fecdbeb8e15 {
            PERIOD "887"
            DESCRIPTION "Charles “the Fat” is deposed and the Frankish empire is split into half a dozen kingdoms, most of which are ruled by Norse kings."
        }
        ENTRY ^"888" #t62ac9053f370361f4c2fe1 {
            PERIOD "888"
            DESCRIPTION "Odo, Count of Paris, is chosen as king of the Franks on account of his brave and skillful resistance of the Norse invaders."
        }
        ENTRY ^"892" #t85f76b351de3c68425c38b {
            PERIOD "892"
            DESCRIPTION "Covenant of Rotomagus is destroyed as Vikings sack Rouen."
        }
        ENTRY ^"898" #tca43578c7d0c7b871076b0 {
            PERIOD "898"
            DESCRIPTION "Seventh Grand Tribunal of the Order of Hermes. Charles “the Simple,” son of Louis II “the Stammerer” and nephew of Charles “the Fat,” succeeds as king of the Franks on the death of Odo."
        }
        ENTRY ^"907" #t470efba4561cfcb9c4e6fd {
            PERIOD "907"
            DESCRIPTION "Covenant of Florum is founded."
        }
        ENTRY ^"910" #t350d69397ba5d23425d07e {
            PERIOD "910"
            DESCRIPTION "The monastery of Cluny is founded."
        }
        ENTRY ^"913" #t219d2f191001e1bb512a38 {
            PERIOD "913"
            DESCRIPTION "Covenant of Ligurio is founded."
        }
        ENTRY ^"920" #t4f71b1f64ac0aee04572f3 {
            PERIOD "920"
            DESCRIPTION "Covenant of Kerguntuil is founded."
        }
        ENTRY ^"922" #t1ddcec4bedb1f207fbadb7 {
            PERIOD "922"
            DESCRIPTION "Odo’s brother, Robert, drives out the discredited Charles “the Simple” and is crowned king."
        }
        ENTRY ^"923" #t73ef3a200c919b5af023d0 {
            PERIOD "923"
            DESCRIPTION "Robert I dies in single combat with Charles “the Simple” and Rudolph, Duke of Burgundy, takes the throne."
        }
        ENTRY ^"931" #t11c7f5061bcf7dc78094d1 {
            PERIOD "931"
            DESCRIPTION "Eighth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"936" #t279474ff34f7e15a0d91bb {
            PERIOD "936"
            DESCRIPTION "Louis IV, son of Charles “the Simple,” is recalled from refuge in England and crowned Fing of the Franks, but he has scarcely any influence over the feuding nobility. Covenant of Baiocassium Minor is founded."
        }
        ENTRY ^"941" #tfb43ffa12de020bcea055c {
            PERIOD "941"
            DESCRIPTION "Covenant of Montverte is founded."
        }
        ENTRY ^"954" #t8591bd2b2800b4c0909738 {
            PERIOD "954"
            DESCRIPTION "Lothair inherits his father’s crown; conflict with neighboring states and within the kingdom continues throughout his reign."
        }
        ENTRY ^"961" #t8d5a90f0a17d32e99bf37b {
            PERIOD "961"
            DESCRIPTION "The Betrayal of House Tytalus occurs at Fudarus. Tasgillia, the Prima of that House, is executed for diabolism, and replaced by her filia, Kalliste."
        }
        ENTRY ^"964" #td3d32b36de0341601ecd83 {
            PERIOD "964"
            DESCRIPTION "Ninth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"969" #t43629858c172b84db9424e {
            PERIOD "969"
            DESCRIPTION "Covenant of Bibracte is sacked by magi from Montverte."
        }
        ENTRY ^"983" #t0430514b76a55302e0602c {
            PERIOD "983"
            DESCRIPTION "The 17th meeting of the Tribunal of the West Franks decides to rename the Tribunal as the Normandy Tribunal."
        }
        ENTRY ^"986" #ta0efd1629e0ddf1ac138b9 {
            PERIOD "986"
            DESCRIPTION "Louis V “the Indolent,” Lothair’s son, becomes king, only to die the following year as a result of rivalries among the senior clergy and nobility."
        }
        ENTRY ^"987" #t5f9774fca95926cc2030f7 {
            PERIOD "987"
            DESCRIPTION "Hugh Capet becomes King of France with the support of the Holy Roman Emperor, Otto III, and Archbishop Adalberon of Reims. He makes Paris his capital."
        }
        ENTRY ^"996" #td60e13a595ac261b2b012f {
            PERIOD "996"
            DESCRIPTION "Robert II “the Pious” is crowned by his father Hugh in 987 and takes the throne on Hugh’s death."
        }
        ENTRY ^"997" #t8d684bfbc7d63b64d67af4 {
            PERIOD "997"
            DESCRIPTION "10th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"998" #te710a70697b8e1efced13f {
            PERIOD "998"
            DESCRIPTION "Covenant of Aedes Salii founded."
        }
        ENTRY ^"1004" #tf6cbf4fd9e30ab1766a3d9 {
            PERIOD "1004"
            DESCRIPTION "The Schism War is declared against members of House Diedne."
        }
        ENTRY ^"1005" #tb282e2d9d633e0a0781d22 {
            PERIOD "1005"
            DESCRIPTION "Covenants of Baiocassium Minor and Caput Capra destroyed."
        }
        ENTRY ^"1007" #t08dd10ca29af26b582b8a2 {
            PERIOD "1007"
            DESCRIPTION "Covenant of Kerguntuil is destroyed."
        }
        ENTRY ^"1008" #t73494b1f232876baf7c893 {
            PERIOD "1008"
            DESCRIPTION "Covenant of Pagus destroyed."
        }
        ENTRY ^"1011" #tb12b8512495861e8e99620 {
            PERIOD "1011"
            DESCRIPTION "Covenants of Baiocassium and Ligurio destroyed."
        }
        ENTRY ^"1012" #tb9584fe5208fe54b1744b0 {
            PERIOD "1012"
            DESCRIPTION "Branugurix is destroyed in the final battle of the Schism War, called the Tempest."
        }
        ENTRY ^"1018" #tb2e4d95d380bd120662d1e {
            PERIOD "1018"
            DESCRIPTION "The Schism War has ended. The Quaesitores present the Tribunal with a list of magical resources seized from magi and covenants destroyed during the conflict. Fudarus attends the Normandy Tribunal meeting, adding Brittany to the Tribunal’s territories. Pertheus of House Tytalus successfully proposes that the aggressors have the right of conquest over these vis sources and books, but that in seven years’ time, a tournament should be held to redistribute them."
        }
        ENTRY ^"1020" #t5cae08dacdce1fd49a3923 {
            PERIOD "1020"
            DESCRIPTION "Covenant of Orchard of Sour Apples is founded."
        }
        ENTRY ^"1021" #t04bde6a8f844d4f7128b9c {
            PERIOD "1021"
            DESCRIPTION "Covenant of Lixivia is founded."
        }
        ENTRY ^"1025" #tf9decf2f7e743652f3b22a {
            PERIOD "1025"
            DESCRIPTION "The 23rd meeting of the Normandy Tribunal adopts several statutes proposed by Pertheus, which later become known collectively as “The Perthean Compact.” This compact sets out the rights magi have over vis sources close to their covenant, but also allows for the possibility of covenants acquiring more vis as they grow in power. The compact is refined over successive meetings of the Tribunal."
        }
        ENTRY ^"1028" #t1df33c4c512327e4172ff8 {
            PERIOD "1028"
            DESCRIPTION "Covenant of Oleron is founded."
        }
        ENTRY ^"1030" #taefeb4595f93581a2e9613 {
            PERIOD "1030"
            DESCRIPTION "11th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1031" #t40e8bf75002402e57786a5 {
            PERIOD "1031"
            DESCRIPTION "Henry I, having been crowned in 1027, succeeds on the death of his father."
        }
        ENTRY ^"1037" #t04e140640cd79d847b3c24 {
            PERIOD "1037"
            DESCRIPTION "Conrad II, the German emperor, defeats Odo of Champagne in a massive battle at Bar in Upper Lorraine."
        }
        ENTRY ^"1048" #t606f26d6c42b9a790b7bb1 {
            PERIOD "1048"
            DESCRIPTION "Covenant of Vexatores is founded."
        }
        ENTRY ^"1051" #tdc914d7ee0d9640fc8194c {
            PERIOD "1051"
            DESCRIPTION "Confluensis moves to Orchard of Sour Apples; the latter covenant is taken over and disbanded, and the covenant of Dragon’s Rest is established at the former site of Confluensis."
        }
        ENTRY ^"1061" #t51f9567243cc594d74dfe3 {
            PERIOD "1061"
            DESCRIPTION "Philip I “the Fair” succeeds his father at the age of 7. His mother, Anne, acts as regent with Baldwin V of Flanders until 1066."
        }
        ENTRY ^"1063" #tddae88e3ad1eaae883bb31 {
            PERIOD "1063"
            DESCRIPTION "12th Grand Tribunal of the Order of Hermes. The conflict between Houses Tytalus and Flambeau is formally ended by the latter withdrawing from all hostilities. As a consequence, the Flambeau covenants of Sinapis and Aedes Salii are abandoned, and Lapis Crudus is founded as a joint covenant between the two Houses."
        }
        ENTRY ^"1064" #tb4a0629f09e629ae185155 {
            PERIOD "1064"
            DESCRIPTION "Covenant of Vexatores is abandoned."
        }
        ENTRY ^"1066" #t11ee5e6541507bed682c83 {
            PERIOD "1066"
            DESCRIPTION "The Battle of Hastings — William of Normandy defeats Harold Godwinson, the Anglo-Saxon King of England, near Hastings in southern England. This leads rapidly to the Norman conquest of England."
        }
        ENTRY ^"1072" #t3cb63f42fafaa195c1b08c {
            PERIOD "1072"
            DESCRIPTION "Covenant of Nauche-Fleur is founded."
        }
        ENTRY ^"1079" #t6ccc7eb07afcdfae33bb94 {
            PERIOD "1079"
            DESCRIPTION "Philip I defeats William of Normandy and supports the claims of his son, Robert."
        }
        ENTRY ^"1081" #t4f73b6c6825da547cb1da6 {
            PERIOD "1081"
            DESCRIPTION "Perpauca’s books are declared the first tomes of the Library of the Normandy Tribunal. Access to these books is made into prizes in the Hermetic Tourney."
        }
        ENTRY ^"1096" #tcec8e3b21863db919d8b7d {
            PERIOD "1096"
            DESCRIPTION "The First Crusade."
        }
        ENTRY ^"1096 (2)" #tfc360be55a3d1d04544520 {
            PERIOD "1096"
            DESCRIPTION "13th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1098" #t773a6af2e3a4f785af4a30 {
            PERIOD "1098"
            DESCRIPTION "The monastery of Cîteaux, later to become the mother house of the Cistercian Order, is founded."
        }
        ENTRY ^"1099" #t184c98d33a8920f1121145 {
            PERIOD "1099"
            DESCRIPTION "Covenant of Infelicitas is founded."
        }
        ENTRY ^"1100" #t6ed37e93f4807e9022941d {
            PERIOD "1100"
            DESCRIPTION "Covenant of Nidi is founded."
        }
        ENTRY ^"1102" #t8e0fd64c0b209114009e31 {
            PERIOD "1102"
            DESCRIPTION "The 34th meeting of the Normandy Tribunal determines the border with the Provençal Tribunal on linguistic grounds."
        }
        ENTRY ^"1108" #t7f57d0160e3800a34bd693 {
            PERIOD "1108"
            DESCRIPTION "Louis VI “the Fat,” Philip’s son, is crowned king in Orléans because his half-brother, Louis, prevents him reaching Reims. Ralph, archbishop of Reims, challenges the validity of the coronation and anointing."
        }
        ENTRY ^"1109" #t54ed18c9af40fb67584a7a {
            PERIOD "1109"
            DESCRIPTION "A plague of restless dead stirs in Picardy; they are banished by a group of hedge wizards who join the Order of Hermes, founding the Donatores lineage within House Ex Miscellanea."
        }
        ENTRY ^"1115" #tb511fae2e35ec8b359fcbb {
            PERIOD "1115"
            DESCRIPTION "St. Bernard founds Clairvaux Abbey."
        }
        ENTRY ^"1116" #t0b12ae005bdf89d9b59969 {
            PERIOD "1116"
            DESCRIPTION "The 36th meeting of the Normandy Tribunal makes a landmark ruling on mundane resources, implicitly permitting mundane raiding."
        }
        ENTRY ^"1117" #tfe60af2909de4ae557ff91 {
            PERIOD "1117"
            DESCRIPTION "The covenant of Florum moves; Spider’s Palace is founded at its former site."
        }
        ENTRY ^"1118" #tc6b352719e234b2eef023c {
            PERIOD "1118"
            DESCRIPTION "Peter Abélard comes to Paris. Lapis Crudus becomes trapped in its regio and is considered lost."
        }
        ENTRY ^"1123" #t3ab80b4a4f280444dc9a50 {
            PERIOD "1123"
            DESCRIPTION "Covenant of Requies Aeterna founded by Donatores magi."
        }
        ENTRY ^"1124" #tc251751e82d8c4ead807c0 {
            PERIOD "1124"
            DESCRIPTION "Covenant of Lixivia disbanded. Covenant of Alcuin’s Auberge founded."
        }
        ENTRY ^"1127" #t59e78d5cf41a049f97c979 {
            PERIOD "1127"
            DESCRIPTION "Geoffrey V of Anjou marries Matilda, daughter of Henry I of England."
        }
        ENTRY ^"1129" #t16b424c2367f42c95902e5 {
            PERIOD "1129"
            DESCRIPTION "14th Grand Tribunal of the Order of Hermes. Normandy’s ruling on the border between itself and the Provençal Tribunal is upheld."
        }
        ENTRY ^"1130" #td9d494f07f4b0a1e6fed3a {
            PERIOD "1130"
            DESCRIPTION "Pope Innocent II takes refuge in France."
        }
        ENTRY ^"1134" #t6f207cbb87693a96280858 {
            PERIOD "1134"
            DESCRIPTION "A huge tidal wave strikes and reshapes the coast of Flanders; Bruges regains access to the North Sea."
        }
        ENTRY ^"1136" #te5f7c39a4fc2d41465fbad {
            PERIOD "1136"
            DESCRIPTION "Covenant of Moles Magna is founded."
        }
        ENTRY ^"1137" #t132f25b40bebf370b5ff7c {
            PERIOD "1137"
            DESCRIPTION "Louis VII “the Young,” the second son of Louis VI, is crowned king and marries Eleanor of Aquitaine."
        }
        ENTRY ^"1144" #t26e4b6b06fcb7a978354dc {
            PERIOD "1144"
            DESCRIPTION "Geoffrey V of Anjou conquers Normandy and becomes its duke."
        }
        ENTRY ^"1146 – 1147" #ta9e5d62709d6d7c2579d72 {
            PERIOD "1146 – 1147"
            DESCRIPTION "The Second Crusade, preached by St. Bernard of Clairvaux."
        }
        ENTRY ^"1151" #tea837da3423b726a9f5a02 {
            PERIOD "1151"
            DESCRIPTION "Henry Plantagenet, son of Geoffrey V of Anjou, inherits Normandy."
        }
        ENTRY ^"1152" #tffc352e56d461d09a4c829 {
            PERIOD "1152"
            DESCRIPTION "Henry marries Eleanor of Aquitaine."
        }
        ENTRY ^"1154" #t24cdba729608d3a0808913 {
            PERIOD "1154"
            DESCRIPTION "Henry becomes Henry II, King of England; beginning of the Angevin Dynasty."
        }
        ENTRY ^"1158" #t4e7b752e6e788eb54549c0 {
            PERIOD "1158"
            DESCRIPTION "Covenant of Infelicitas is abandoned."
        }
        ENTRY ^"1162" #t311509d484b1efcd2805f4 {
            PERIOD "1162"
            DESCRIPTION "15th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1163" #te275d3016fa5240adc8e2a {
            PERIOD "1163"
            DESCRIPTION "Construction on the Cathedral of Notre-Dame in Paris begins."
        }
        ENTRY ^"1166" #tbe335d5edf53222610ffa2 {
            PERIOD "1166"
            DESCRIPTION "Covenant of Nauche-Fleur is abandoned."
        }
        ENTRY ^"1180" #t518f24e5bd9e17943ecf03 {
            PERIOD "1180"
            DESCRIPTION "Philip II “Augustus” is crowned king."
        }
        ENTRY ^"1182" #t8e26d11c72149548a7fb1a {
            PERIOD "1182"
            DESCRIPTION "Covenant of Moles Magna is destroyed."
        }
        ENTRY ^"1187" #tb8416eac2c287ce216dbc3 {
            PERIOD "1187"
            DESCRIPTION "Covenant of Atsingani is founded."
        }
        ENTRY ^"1189" #t24519a0abf35133ea71465 {
            PERIOD "1189"
            DESCRIPTION "Richard, later known as “the Lionheart,” with the connivance of Philip II, defeats his father Henry II of England at Ballans and succeeds him as King of England, Duke of Normandy, and Count of Anjou."
        }
        ENTRY ^"1189 – 1192" #tbb2e67263c2eb036b85453 {
            PERIOD "1189 – 1192"
            DESCRIPTION "The Third Crusade."
        }
        ENTRY ^"1190" #t7228bdcae48e8c80abc4b3 {
            PERIOD "1190"
            DESCRIPTION "Philip II erects his huge fortress, the Louvre, in Paris."
        }
        ENTRY ^"1192" #t04918e73a6f2896223c343 {
            PERIOD "1192"
            DESCRIPTION "Richard is imprisoned by the Holy Roman Emperor; Philip II and John, Richard’s brother, offer him 80,000 marks to keep him hostage, but are refused. Covenant of Cunfin is founded."
        }
        ENTRY ^"1194" #tc01185e6a0c2724afbcf3c {
            PERIOD "1194"
            DESCRIPTION "Eleanor of Aquitaine pays a ransom of 150,000 marks and Richard is released. He wins a victory over Philip II at Freteval. The Great Fire of Chartres; much of the city and the cathedral is destroyed."
        }
        ENTRY ^"1195" #t6b130a6f6bd6817b814751 {
            PERIOD "1195"
            DESCRIPTION "16th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1197" #tc21c067a2be398a281c084 {
            PERIOD "1197"
            DESCRIPTION "Covenant of Alcuin’s Auberge destroyed."
        }
        ENTRY ^"1198" #t6a8a2453213678cff938ea {
            PERIOD "1198"
            DESCRIPTION "Richard again defeats Philip II at the Battle of Gisors; Philip flees with his troops and is rescued from a river."
        }
        ENTRY ^"1199" #t5841693308a7e65591fa01 {
            PERIOD "1199"
            DESCRIPTION "King Richard of England is slain by a stray arrow during a siege in Limousin; he is succeeded by John."
        }
        ENTRY ^"1200" #t30d2437673fae6ab9d8d9a {
            PERIOD "1200"
            DESCRIPTION "Philip II charters the University of Paris. Covenant of Atramentum is founded."
        }
        ENTRY ^"1201" #taeca911e04ffc71538f38c {
            PERIOD "1201"
            DESCRIPTION "Covenant of Exspectatio is founded on the site of Atramentum; the latter covenant is disbanded and reformed as Atramentum Renatus."
        }
        ENTRY ^"1202" #t006b7f45cb4b13fc10d164 {
            PERIOD "1202"
            DESCRIPTION "King John of England fails to respond to a summons to attend a French court; Philip II of France claims Anjou and invades Normandy, and supports the claims of Arthur of Brittany against John. This marks a turning point in the struggles between the Angevins and Capetians; thereafter, Philip II holds the upper hand in most of France."
        }
        ENTRY ^"1202 – 1204" #tc360ea9b5535fcc06b6e9c {
            PERIOD "1202 – 1204"
            DESCRIPTION "The Fourth Crusade."
        }
        ENTRY ^"1204" #tcd403241f13170424efbcc {
            PERIOD "1204"
            DESCRIPTION "Death of Eleanor of Aquitaine. The covenant of Eboris is founded in Paris."
        }
        ENTRY ^"1209" #t6a621fe1acbf882d4c3de5 {
            PERIOD "1209"
            DESCRIPTION "Beginning of the Albigensian Crusade; many nobles from France assemble at Lyon and proceed to Languedoc."
        }
        ENTRY ^"1212" #t9afaebb32232a1986b1f20 {
            PERIOD "1212"
            DESCRIPTION "The Children’s Crusade is started as a shepherd boy from Châteaudun works miracles at St. Denis."
        }
        ENTRY ^"1214" #t1c43d4f7202134d2fc1ad8 {
            PERIOD "1214"
            DESCRIPTION "The Battle of Bouvines — Philip II, supported by Frederick II, the presumptive German emperor, defeats the combined armies of the Saxons, the English, and the Flemish."
        }
        ENTRY ^"1215" #t30b8708e3ffbc6aa36b0a8 {
            PERIOD "1215"
            DESCRIPTION "Lapis Crudus re-enters the Hermetic scene having won freedom (of sorts) from their trap."
        }
        ENTRY ^"1217" #t0e8a8e49b479225a559e40 {
            PERIOD "1217"
            DESCRIPTION "The Fifth Crusade."
        }
        ENTRY ^"1219" #t71b8d00635ef342b2cb2d4 {
            PERIOD "1219"
            DESCRIPTION "Papal ban on the teaching of law in Paris."
        }
        ENTRY ^"1220" #tb295f204cf422603caf204 {
            PERIOD "1220"
            DESCRIPTION "Frederick II of Germany becomes Holy Roman Emperor."
        }
        ENTRY ^"1223" #t514092eb08cad13682bae2 {
            PERIOD "1223"
            DESCRIPTION "Louis VIII becomes King of France."
        }
        ENTRY ^"1226" #t8dc5bf40e51d71d337f1b3 {
            PERIOD "1226"
            DESCRIPTION "Louis IX (later St. Louis) becomes king."
        }
        ENTRY ^"1228" #tb662bbf1bd4c686f490adc {
            PERIOD "1228"
            DESCRIPTION "The Sixth Crusade. 17th Grand Tribunal of the Order of Hermes. Papal ban on teaching of Aristotle at the University of Paris."
        }
        ENTRY ^"1229" #td80aefa2bb625b70ca3de2 {
            PERIOD "1229"
            DESCRIPTION "End of the Albigensian Crusade."
        }
        ENTRY ^"1235" #t0086575cf629b7714dc34c {
            PERIOD "1235"
            DESCRIPTION "The pope grants the cathedral school of Orléans the status of university."
        }
        ENTRY ^"1248 – 1254" #tb1a7468aec5ce9d8d34026 {
            PERIOD "1248 – 1254"
            DESCRIPTION "The Seventh Crusade."
        }
        ENTRY ^"1250" #t3850b8215dcad946f4754b {
            PERIOD "1250"
            DESCRIPTION "The university of Angers is formed."
        }
        ENTRY ^"1258" #t4c18384af0408f83345b38 {
            PERIOD "1258"
            DESCRIPTION "The Treaty of Corbeil, settling territorial claims between France and Aragon."
        }
        ENTRY ^"1261" #t2c3cddea721ed8a518abac {
            PERIOD "1261"
            DESCRIPTION "18th Grand Tribunal of the Order of Hermes. Jacques Pantaléon, son of a cobbler from Troyes, becomes Pope Urban IV."
        }
        ENTRY ^"1263" #tb2da9f17f4c5abef5f973e {
            PERIOD "1263"
            DESCRIPTION "Single currency adopted by the kingdom of France."
        }
        ENTRY ^"1265" #tdf2eb4128d87fb6e3eb4b3 {
            PERIOD "1265"
            DESCRIPTION "Guido Le Gros from Saint-Gilles becomes Pope Clement IV."
        }
        ENTRY ^"1270" #t151fae5efc3f39c302b2f7 {
            PERIOD "1270"
            DESCRIPTION "The Eighth Crusade. Philip III becomes King of France."
        }
        ENTRY ^"1281" #tb3765ef957591b249c47d9 {
            PERIOD "1281"
            DESCRIPTION "Simon de Brie from Touraine becomes Pope Martin IV."
        }
        ENTRY ^"1285" #t3250e5e08ba38632d6580a {
            PERIOD "1285"
            DESCRIPTION "Philip IV “The Fair” becomes King of France."
        }
        ENTRY ^"1294" #tbf0cea120a369f104ffc06 {
            PERIOD "1294"
            DESCRIPTION "19th Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1297" #t503110b331fdab557df706 {
            PERIOD "1297"
            DESCRIPTION "King Louis IX canonized as St. Louis."
        }
    }

