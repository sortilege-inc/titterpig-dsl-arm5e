EXTENSION "ARMDef_The_Sundered_Eagle_Anatolia_CatellaOfHouseBonisagus" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Catella of House Bonisagus"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # Catella of House Bonisagus (Chapter Eight: Anatolia, p114): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t27f6908572d6eedfee8ca4 ^"Catella of House Bonisagus" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t9c43f37fc11892b46b5315 ^"Alexandria"]
            ^"Age" STRING "41 (Apparent Age: 39)"
            ^"Personality Trait" STRING "Patient +3, Cheerful +1, Determined +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 114
        }
        DESCRIPTION "Catella is the only Gifted member of Alexandria. She joined the covenant directly out of apprenticeship, two years before Constantinople fell, when the reputation of Alexandria was still good. Drawn by the artifacts of Alexander, she has been investigating them, but in twenty years she has made little headway. Because of this interest, Catella has been given the responsibility of loaning them out, which both excites and frustrates her. She likes being in charge of the artifacts, but dislikes that they are not always available for her investigations. In the spirit of cooperation, Alexandria has made borrowing the artifacts easy, and Catella complies with this decision even if it interrupts her personal plans."
    }

}
