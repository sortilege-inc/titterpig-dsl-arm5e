EXTENSION "ARMDef_The_Sundered_Eagle_Constantinople_Tables" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Seven: Constantinople tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tc0f4ee853044fc6f2ac0de ^"Porphyrogenitos (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Roll", "Virtue"]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 99
        }
        TABLE {
            "1" "Infernal Minor Supernatural"
            "2" "Magic Minor Supernatural"
            "3 – 4" "Faerie Minor Supernatural"
            "5 – 9" "Divine Minor Supernatural"
            "10" "The character receives a Major Supernatural Virtue instead of a Minor. Roll again for type, ignoring a second 10."
        }
    }

}
