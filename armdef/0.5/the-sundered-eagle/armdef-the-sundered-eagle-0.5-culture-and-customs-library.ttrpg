EXTENSION "ARMDef_The_Sundered_Eagle_CultureAndCustoms_Library" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Four: Culture & Customs library"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's library, structured; each DESCRIPTION the source's text, verbatim.

    #te9eac8dc82bf0619199cf0 ^"The Alexiad" DEF {
        EXTENDS #tb560f58a881643042a069b ^"Library Holding"
        PROPERTIES {
            ^"Title" STRING "The Alexiad"
            ^"Author" STRING "Anna Komnene"
            ^"Kind" STRING "Summa"
            ^"Subject" STRING "Byzantium Lore"
            ^"Level" INTEGER 5
            ^"Quality" INTEGER 10
            ^"Section" STRING "Anna Komnene"
            ^"Printed Entry" STRING "The Alexiad is a summa in Byzantium Lore with a level of 5 and Quality of 10. It may also be read (by focusing on particular volumes and chapters) as a Quality 10 tractatus in Divine Lore, Magic Lore, Leadership, Intrigue, or several different (Area) Lores."
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 39
        }
    }

}
