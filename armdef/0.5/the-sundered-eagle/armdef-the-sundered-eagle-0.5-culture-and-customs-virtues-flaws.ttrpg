EXTENSION "ARMDef_The_Sundered_Eagle_CultureAndCustoms_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Four: Culture & Customs virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #te9e662db8392d9241d4b76 ^"Archieunuch (The Sundered Eagle)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "Archieunuch"
            ^"Size" STRING "Major"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "You have risen to enjoy the status and privilege associated with the most important and talented eunuchs, the archieunuchs. Although you are not a ruler in your own right, a ruler likely depends on you to govern effectively and has thus granted you considerable authority to act in his stead. Due to this status and importance, you wield significant influence among the lesser nobility. You might serve either as a regional administrator, an important courtier, or a general, and there are numerous servants and possibly other subordinate eunuchs under your command. You have been granted a residence, either within a castle or palace, or elsewhere. Due to your education, you may take Academic Abilities during character creation. This Virtue is only available to male eunuch characters, either castrated or not, or (very rarely) a female character disguised as a male."
    }

    #t1ed08bf8e77fe12d692dcb ^"Eunuch (The Sundered Eagle)" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "Eunuch"
            ^"Size" STRING "Minor"
            ^"Category" STRING "Social Status"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "You have been educated and trained to serve the Byzantine nobility as a courtier, steward, chamberlain, scribe, lawyer, or accountant. You are likely employed by a court, a lesser noble, or a covenant. It is also possible for you to pursue a career in the Church, and some monasteries accept eunuchs. Due to your education, you may take Academic Abilities during character creation. This Virtue is only available to male eunuch characters, either castrated or not, or (very rarely) a female character disguised as a male."
    }

    #t735fa0a7d505a4a6bbf040 ^"Castratus (The Sundered Eagle)" DEF {
        EXTENDS #tgA0K9vGShU1WKTibhCc4jXz ^"Flaw"
        PROPERTIES {
            ^"Printed Name" STRING "Castratus"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 38
        }
        DESCRIPTION "You are a male that has been castrated before puberty, leaving you beardless and somewhat effeminate compared to most men. Social rolls involving characters from Latin culture suffer a –3 penalty. Under Byzantine law you may not marry, although you may adopt children."
    }

}
