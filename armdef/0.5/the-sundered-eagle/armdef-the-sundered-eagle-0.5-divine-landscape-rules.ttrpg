EXTENSION "ARMDef_The_Sundered_Eagle_DivineLandscape_Rules" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Eleven: The Divine Landscape rules"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's rules, structured; each DESCRIPTION the source's text, verbatim.

    #t20f90c796234e3b2905b7e ^"Aesthetic Quality" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Creating and Venerating Divine Icons"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 133
        }
        FORMULAS {
            "Aesthetic Quality" "Dexterity + Craft (Painting) + bonuses"
        }
    }

    #t992261df4cd34ef8addd30 ^"Emergency Veneration Roll" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Rules Section" STRING "Creating and Venerating Divine Icons"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 133
        }
        FORMULAS {
            "Emergency Veneration Roll" "Presence + Concentration vs Ease Factor 15"
        }
    }


    #t8b7639b4a0ed8e18ff0db6 ^"Invoking a Saint (The Sundered Eagle)" DEF {
        APPLIES TO [#tuEORFO4LOe9AEX2mqsQW26W ^"Character"]
        PROPERTIES {
            ^"Printed Name" STRING "Invoking a Saint"
            ^"Rules Section" STRING "Byzantine Saints"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 135
        }
        FORMULAS {
            "Invoking a Saint" "Communication + Charm + modifier + simple die vs. 15 + simple die"
        }
    }

}
