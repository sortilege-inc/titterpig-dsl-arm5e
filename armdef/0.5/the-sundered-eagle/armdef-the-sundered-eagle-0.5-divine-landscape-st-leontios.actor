EXTENSION "ARMDef_The_Sundered_Eagle_DivineLandscape_StLeontios" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - St. Leontios"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # St. Leontios (Chapter Eleven: The Divine Landscape, p137): one saint, its printed stat lines verbatim fields.

    #t9cca3b9aaa90378d0924a2 ^"St. Leontios" DEF {
        EXTENDS #t8d188b6ad592676406586c ^"Saint"
        PROPERTIES {
            ^"Saint Category" STRING "Local Saints"
            ^"Divine Might" INTEGER 25
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "St. Leontios, patron saint of the monastery of St. John the Evangelist on the island of Patmos. Leontios was a “holy fool,” meaning that he was not a monk or part of any institutional framework, and was made a saint based solely on his asceticism."
    }

}
