EXTENSION "ARMDef_The_Sundered_Eagle_FaerieLandscape_InitiationScripts" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Ten: The Faerie Landscape initiation scripts"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's initiation scripts, structured; each DESCRIPTION the source's text, verbatim.

    #t8b5cdc6c88dd734d2bf201 ^"Initiation of Elysian Ecstasy" DEF {
        EXTENDS #tMCInitiationScriptTypeAAAA ^"Initiation Script"
        PROPERTIES {
            ^"Ease Factor" STRING "18"
            ^"Script Bonus" STRING "+12"
            ^"Mystery" STRING "Elysian Ecstasy"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 126
        }
        DESCRIPTION "**Ease Factor**:18 **Script Bonus**: +12 **Script Details**: The initiate must visit 12\n\npowerful beings, each one chosen to represent one of the 12 Olympians, and receive a boon from each. These beings can be magical, faerie, or even magi or kings. They need not know why they are granting the boon, but each must possess strong resonances for the Olympian they represent (+6). In a shrine dedicated to one of the Olympians, the initiate must then perform a rite as Sirius rises (+3) that confers to him the power of the gods, but also inflicts the Susceptibility to Faerie Power Flaw (+3)."
    }

}
