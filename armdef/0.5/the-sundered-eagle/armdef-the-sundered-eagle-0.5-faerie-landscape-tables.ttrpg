EXTENSION "ARMDef_The_Sundered_Eagle_FaerieLandscape_Tables" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Ten: The Faerie Landscape tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #t810a40aa19ddfe2b30a5a4 ^"Channeling a Greek God (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Ease Factor", "Result"]
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 126
        }
        TABLE {
            "9" "(God’s) Personality Trait +2, 1 point of Sympathy Traits chosen from those appropriate to the god"
            "12" "(God’s) Personality Trait +3, 3 points of Sympathy Traits, (Olympian Pact: use of one of the god’s minor powers)"
            "15" "(God’s) Personality Trait +4, 6 points of Sympathy Traits, (Olympian Pact: use of two of the god’s minor powers)"
            "18" "(God’s) Personality Trait +5, 10 points of Sympathy Traits, (Olympian Pact: use of one of the god’s major powers or three of its minor powers)"
            "21+" "(God’s) Personality Trait +6, 15 points of Sympathy Traits, (Olympian Pact: use of two of the god’s major powers, six of its minor powers, or one major and three minor powers)"
        }
    }

}
