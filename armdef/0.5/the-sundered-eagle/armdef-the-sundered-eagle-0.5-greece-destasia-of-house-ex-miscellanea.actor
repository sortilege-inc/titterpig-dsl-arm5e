EXTENSION "ARMDef_The_Sundered_Eagle_Greece_DestasiaOfHouseExMiscellanea" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Destasia of House Ex Miscellanea"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # Destasia of House Ex Miscellanea (Chapter Five: Greece, p65): one character, its printed stat lines verbatim fields, its write-up the DESCRIPTION.

    #t7f7fac0b619e4bf7292257 ^"Destasia of House Ex Miscellanea" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#td9fcceed625a1e2f3d0631 ^"Erebos"]
            ^"Age" STRING "43 (Apparent Age: 37)"
            ^"Personality Trait" STRING "Overbearing +2, Vengeful +2, Moody +1"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 65
        }
        DESCRIPTION "A descendent of Cyra, Destasia has recently inherited the rulership of Erebos, despite her relatively young age. Her mater Megethia, the former leader, is still at the covenant, but is increasingly absent due to prolonged Twilight episodes. She is familiar with the magic of defixiones, capable of inflicting curses; correspondingly she specializes in Perdo and Corpus. An elegant and athletic black-haired woman, Destasia would be attractive, were it not for the ritual scars that have marred her face, believed to be due to an ordeal for a Mystery initiation."
    }

}
