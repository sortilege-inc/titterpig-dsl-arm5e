EXTENSION "ARMDef_The_Sundered_Eagle_MagicalLandscape_Tables" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Chapter Nine: The Magical Landscape tables"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The chapter's tables, structured; each DESCRIPTION the source's text, verbatim.

    #tc2bc9a910bba055c5d55ad ^"Modifiers to Diabolai (table)" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Modifier", "Bonus"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 122
        }
        TABLE {
            "Diabolai performed in public" "+2"
            "Requested power is apt (e.g. target worthy of punishment)" "+1 to +5, as determined by the storyguide"
            "Synthemata of being known (see The Mysteries Revised Edition, pages 86–88)" "+3"
            "True Name of being known (see Realms of Power: The Infernal, pages 34–35)" "+9"
            "Performed a diabolai in the last month" "–9"
            "Threatening an unfamiliar being" "–6"
        }
    }

}
