SETTING "ARMDef_The_Sundered_Eagle_Setting" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - the Theban Tribunal: places and timeline"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"

    # The Theban Tribunal as The Sundered Eagle prints it. HISTORY: the Past Events and Future Events of the Theban
    # Tribunal Timeline, Atlas Games' web supplement to the book by Chris Jensen-Romer (one of its authors), each
    # entry as printed, its date the PERIOD; its meetings of the Tribunal and Byzantine Emperors are TABLEs in
    # the timeline-tables.ttrpg. LOCATION: the Tribunal, its regions (Chapters Five to Eight), each place those
    # chapters print as a heading, and each covenant's site. TAGS: tribunal, region, covenant (a covenant's site; the
    # covenant itself is an .actor that points here) or place. A place's text is in its chapter's .lore.

    HISTORY {
        ENTRY ^"5201 BC" #t5c7305f3d8bbd1635e1ead {
            PERIOD "5201 BC"
            DESCRIPTION "Creation of the World and Adam"
        }
        ENTRY ^"1685 BC" #t5dc7bc966c3bfae1761c02 {
            PERIOD "1685 BC"
            DESCRIPTION "Prometheus steals fire from the Heavens"
        }
        ENTRY ^"1347 BC" #t49bb19de298e98a286f549 {
            PERIOD "1347 BC"
            DESCRIPTION "Perseus slays Medusa to rescue Andromeda"
        }
        ENTRY ^"1261 BC" #tad2c8443d9e8e8ddb77105 {
            PERIOD "1261 BC"
            DESCRIPTION "Jason and the Argonauts"
        }
        ENTRY ^"1191–1182 BC" #t32a0f34e8fc01a53230331 {
            PERIOD "1191–1182 BC"
            DESCRIPTION "The Trojan War"
        }
        ENTRY ^"683 BC" #td2ba56ebb991e7a6d598af {
            PERIOD "683 BC"
            DESCRIPTION "Beginning of Athenian democracy"
        }
        ENTRY ^"658 BC" #t84ca6d04a49a3692ad40da {
            PERIOD "658 BC"
            DESCRIPTION "Byzantium built."
        }
        ENTRY ^"513 BC" #t76a6680d010b584ce28664 {
            PERIOD "513 BC"
            DESCRIPTION "Darius of Persia takes Thrace"
        }
        ENTRY ^"490 BC" #t55fa6845fdf3a540d632a8 {
            PERIOD "490 BC"
            DESCRIPTION "Battle of Marathon"
        }
        ENTRY ^"480BC" #tf0e594c1495495302b07b5 {
            PERIOD "480BC"
            DESCRIPTION "Battle of Salamis"
        }
        ENTRY ^"431-404 BC" #t5ed3a89d6ecb03b4ef67a1 {
            PERIOD "431-404 BC"
            DESCRIPTION "Peloponnesian War fought between Sparta and Athens"
        }
        ENTRY ^"382-386 BC" #t999170d36442e997f8f77c {
            PERIOD "382-386 BC"
            DESCRIPTION "Phillip II of Macedon"
        }
        ENTRY ^"356-323 BC" #ta2d5b70410c6c8653c62a7 {
            PERIOD "356-323 BC"
            DESCRIPTION "Alexander the Great"
        }
        ENTRY ^"c. 300BC" #t9d8f6fcc25a29b58d9216b {
            PERIOD "c. 300BC"
            DESCRIPTION "Poet Moero lives"
        }
        ENTRY ^"300BC" #t83a2e49b2038fd9dc27ed2 {
            PERIOD "300BC"
            DESCRIPTION "Pharmakeutria of the Temple of Aaklepios at what is today Epidauros driven out by the Goths."
        }
        ENTRY ^"190BC" #t662350b8363deb57304a59 {
            PERIOD "190BC"
            DESCRIPTION "Astronomer Hipparchus of Nicea born"
        }
        ENTRY ^"325" #tf195a3f6d888597d934070 {
            PERIOD "325"
            DESCRIPTION "First Council of Nicea"
        }
        ENTRY ^"330" #tbbf8ce8f6e2b81639aa3bd {
            PERIOD "330"
            DESCRIPTION "Founding of Constantinople."
        }
        ENTRY ^"455" #tfaed1c3333e23b5bcae6e2 {
            PERIOD "455"
            DESCRIPTION "Vandals sack Rome"
        }
        ENTRY ^"476" #t2eb7474c19245f5151efaf {
            PERIOD "476"
            DESCRIPTION "Fall of the western Roman Empire as Italy is conquered by the Gothic king Odovacar; the beginning of the Dark Ages."
        }
        ENTRY ^"532" #t246f9e511e7ad4813f78aa {
            PERIOD "532"
            DESCRIPTION "Nika revolt and massacre."
        }
        ENTRY ^"615" #te1bf184e810cd6a3f95cb3 {
            PERIOD "615"
            DESCRIPTION "Earliest written record of magicians at site of what will become covenants of Hedyosmos."
        }
        ENTRY ^"617" #td876cf6b68a5dee78b9058 {
            PERIOD "617"
            DESCRIPTION "Prokopios has dream vision of Socrates, possibly while at site of what later becomes covenant of Hedyosmos. He begins his plan to form the Theban League, an assembly of magicians."
        }
        ENTRY ^"624" #t395a6eef71530cda1a0b13 {
            PERIOD "624"
            DESCRIPTION "First meeting of the Theban League on Delos brings twenty two magi together. Prokopios’ typikon is debated, but few convinced."
        }
        ENTRY ^"631" #t18e9b2318b81be2cb5adcb {
            PERIOD "631"
            DESCRIPTION "Second meeting of the Theban League on Delos. Fifty five magi gather, and most agree to join league and sign typikon."
        }
        ENTRY ^"638" #t3b904968b6c54a0fe0ccb1 {
            PERIOD "638"
            DESCRIPTION "Third meeting of the Theban League, some of whose members demand protection from the Witches of Thessaly."
        }
        ENTRY ^"645" #t4605050d030d142953c625 {
            PERIOD "645"
            DESCRIPTION "Fourth meeting at Delos of the Theban League report that the logothete was killed by the Witches of Thessaly."
        }
        ENTRY ^"652" #t309f6a456520c4a59d8164 {
            PERIOD "652"
            DESCRIPTION "Fifth meeting Theban League. A group of Dacian necromancers raid deep in to the Greek mainland, killing many magicians. Arguments over appropriate response lead to fighting between delegates, many killed. League in disarray."
        }
        ENTRY ^"659" #t676f2a30acf9f8370669c8 {
            PERIOD "659"
            DESCRIPTION "Prokopios slain by a trusted friend and archon at the sixth League gathering on Delos."
        }
        ENTRY ^"729" #t89dd7dfd9f7eb00015ff77 {
            PERIOD "729"
            DESCRIPTION "League of Iconophiles founded by Bernice. It is a loose alliance of magicians come together to sabotage the iconoclastic imperial armies and rescue icons from the persecution of Leo III."
        }
        ENTRY ^"730" #t7c237a1bcbfb8ab1e789a4 {
            PERIOD "730"
            DESCRIPTION "League founder Bernice takes Jerbiton to Thessalonika where his apprenticeship begins."
        }
        ENTRY ^"731" #t066aafde42df03e7761805 {
            PERIOD "731"
            DESCRIPTION "Trianoma meets Bonisagus in his Alpine cave, becomes his apprentice, and learns his great invention, the Parma Magica."
        }
        ENTRY ^"736" #tf63984384d3a5a487be9cb {
            PERIOD "736"
            DESCRIPTION "League of Iconophiles hold a meeting on Mount Athos. It is not a success, and from this point on they return to communicating by messenger."
        }
        ENTRY ^"745" #te1ae1a964644d633ad4815 {
            PERIOD "745"
            DESCRIPTION "Jerbiton completes his apprenticeship."
        }
        ENTRY ^"759" #t32ef01b95d702aa2ef35e1 {
            PERIOD "759"
            DESCRIPTION "Trianoma seeks out Bernice in Thessalonika, and enters lengthy period of negotiations. She is particularly fascinated by the young Jerbiton for reasons never made clear."
        }
        ENTRY ^"760" #t2f6ae16eb15d724ae17b61 {
            PERIOD "760"
            DESCRIPTION "Bernice of Thessalonika agrees to join in Bonisagus’ plans after discussions with Trianoma, realizing the Parma Magica may be the only way to overcome the problem of The Gift preventing magicians gathering together.."
        }
        ENTRY ^"753" #tc3d6d815fb929f9a28c77c {
            PERIOD "753"
            DESCRIPTION "Imperial armies systematically sack monasteries with icons. League groups set off with icons, eventually founding (758) what is today the covenant of Valnastium in the Alps."
        }
        ENTRY ^"754 - 767" #td9d542fa56f47775217eb6 {
            PERIOD "754 - 767"
            DESCRIPTION "Bonisagus travels to Durenmar in the Black Forest."
        }
        ENTRY ^"763" #tff3930419370eebac53819 {
            PERIOD "763"
            DESCRIPTION "Bernice of Thessalonika dies. Jerbiton sets off to seek Bonisagus in her stead."
        }
        ENTRY ^"767" #t6941c9a455c5aeca5de393 {
            PERIOD "767"
            DESCRIPTION "Foundation of the Order of Hermes at Durenmar. Bonisagus and the other Founders swear the Oath of Hermes. The first tribunal gathering takes place."
        }
        ENTRY ^"767 - 773" #t9caf68e405ea38d6506535 {
            PERIOD "767 - 773"
            DESCRIPTION "Flambeau departs Durenmar with a number of his apprentices to found the covenant of Val-Negra in the Pyrenees. Several other magi also depart after the Founding and establish other covenants, based on the Durenmar model."
        }
        ENTRY ^"771" #tdf17a770264c1d39d7496d {
            PERIOD "771"
            DESCRIPTION "Bjornaer and her followers travel to the island of Rügen and hold a council. Thereafter House Bjornaer holds a gathering there every twelve years."
        }
        ENTRY ^"773" #t4b3d270ceec8195696d385 {
            PERIOD "773"
            DESCRIPTION "Second Grand Tribunal of the Order of Hermes. Procedures for lesser tribunals are established: a tribunal shall consist of at least twelve magi from at least four covenants. Founding of the covenants of Crintera, domus magna of House Bjornaer, and Fenistal, domus magna of House Merinita."
        }
        ENTRY ^"775" #t98868a8aa521fafca4d2a7 {
            PERIOD "775"
            DESCRIPTION "House Tremere invades the area that today comprises the Thebes Tribunal, slaying many magi who had not joined the Order of Hermes. The Byzantine magi in the northern part of the region form the Theban League to resist the Tremere, and join the Order of Hermes under Jerbiton’s leadership."
        }
        ENTRY ^"776" #t9c5f0439f4e8697c9010d5 {
            PERIOD "776"
            DESCRIPTION "The Founders Tytalus and Jerbiton work together against the Tremere influenced rise of Bulgaria."
        }
        ENTRY ^"789" #t6ccf06c0178d7ab1da2566 {
            PERIOD "789"
            DESCRIPTION "The Founder Jerbiton meets with Charlemagne, after having adopted a number of apprentices of the emperor’s mage-smith, Carolinus. Charlemagne issues a decree outlawing sorcery and paganism, but permits “benevolent magic” such as that practiced by Jerbiton."
        }
        ENTRY ^"792" #t417d33c8c5b463fcf2275c {
            PERIOD "792"
            DESCRIPTION "The last recorded sighting of the Founder Merinita - she departs to places unknown to seek the spirit of the wilderness. The new primus Quendalon founds Irencillia."
        }
        ENTRY ^"799" #t42191fcdd4ee64caf55b21 {
            PERIOD "799"
            DESCRIPTION "Third Grand Tribunal of the Order of Hermes. Following this, Quendalon, the first primus of House Merinita, enters faerie woodlands in Bohemia, leaving Myanar in charge of the House."
        }
        ENTRY ^"800" #t514c4d3d74312d5cb9c762 {
            PERIOD "800"
            DESCRIPTION "Charlemagne is crowned emperor in Rome; re-establishment of the western (Holy) Roman Empire."
        }
        ENTRY ^"801 - 802" #tfa6f3408043ec15e5f9e75 {
            PERIOD "801 - 802"
            DESCRIPTION "Quendalon reappears, but Myanar refuses to recognize him as the true Quendalon. An internal struggle ensues in House Merinita, resulting in the death of Myanar and the loss of Fenistal. Irencillia becomes the new domus magna of House Merinita, which becomes dominated by faerie magic."
        }
        ENTRY ^"807" #t18cafd36e318e0f5986159 {
            PERIOD "807"
            DESCRIPTION "The Founder Tytalus enters the Maddenhofen Woods in Bohemia to challenge the Queen of Faerie, and is not seen thereafter."
        }
        ENTRY ^"815" #t2ccdfe02af1e99d5aa0dab {
            PERIOD "815"
            DESCRIPTION "Tremere covenant of Dostolon founded"
        }
        ENTRY ^"817" #t6b3e5ba594ce38cd503c80 {
            PERIOD "817"
            DESCRIPTION "Fourth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"825" #t078731318da8a9a7567c3e {
            PERIOD "825"
            DESCRIPTION "Death of Jerbiton."
        }
        ENTRY ^"831" #td186809c819f5fd81b7f5e {
            PERIOD "831"
            DESCRIPTION "Gathering of Twelve Years at Crintera: Bjornaer speaks her final words to the magi of her House and disappears into the forest in bear-form."
        }
        ENTRY ^"832" #t2a0bf05723de7f8b8d61d9 {
            PERIOD "832"
            DESCRIPTION "Fifth Grand Tribunal of the Order of Hermes. From henceforth, Grand Tribunals will meet every 33 years, regional tribunals every 7 years from 836 AD. The seven year cycle is taken from Prokopios’ idea and the Theban practice."
        }
        ENTRY ^"836" #t357b33351809fd015258df {
            PERIOD "836"
            DESCRIPTION "Local Tribunal meeting"
        }
        ENTRY ^"840" #t1f40e783463e03d2dc42dd {
            PERIOD "840"
            DESCRIPTION "Covenant of Miphoria founded. Tremere magi sieze Epidauros."
        }
        ENTRY ^"843" #t1154461e9137bb4100e0bd {
            PERIOD "843"
            DESCRIPTION "Local Tribunal Meeting - at which some believe The Sundering was planned."
        }
        ENTRY ^"848" #t087a80896d77ae234d0c3d {
            PERIOD "848"
            DESCRIPTION "Sundering of Tremere: covenant of Dostolon destroyed, the Tremere forced to relinquish Epidauros."
        }
        ENTRY ^"850" #t3d90c84d23eb06894cd34a {
            PERIOD "850"
            DESCRIPTION "local Tribunal meeting"
        }
        ENTRY ^"857" #te628f0ff6b409af97ef5bd {
            PERIOD "857"
            DESCRIPTION "local Tribunal meeting. Founding of covenant of Erebos, following a diplomatic initiative by Pralix."
        }
        ENTRY ^"864" #t803df2439d61a9ba78a344 {
            PERIOD "864"
            DESCRIPTION "local Tribunal meeting"
        }
        ENTRY ^"864 (2)" #t6b2b5a119a289073694a21 {
            PERIOD "864"
            DESCRIPTION "Bulgaria converted to Christianity"
        }
        ENTRY ^"865" #t09ce9d51c5ed752726d0fc {
            PERIOD "865"
            DESCRIPTION "Sixth Grand Tribunal of the Order of Hermes. The boundaries of the tribunals are formally set according to the break up of the Frankish Empire, they are also named as the Rhine, Normandy, Provencal, Britannian, Roman, Theban, Eastern, and Greater Alps Tribunals."
        }
        ENTRY ^"867" #tac7b71f3af255650a07406 {
            PERIOD "867"
            DESCRIPTION "Peasant revolt in Anatolia leads ot many cities being sacked, and widespread Paulician heresy among the rebels."
        }
        ENTRY ^"898" #t824619cbe20def92c25f94 {
            PERIOD "898"
            DESCRIPTION "Seventh Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"913" #td7e67c85f48b3b9129f35d {
            PERIOD "913"
            DESCRIPTION "local Tribunal meeting approves new Bjornaer covenant of Estropi"
        }
        ENTRY ^"914" #tcc710117246c18d074b6ad {
            PERIOD "914"
            DESCRIPTION "Estropi founded in Anatolia"
        }
        ENTRY ^"931" #t72af1a25d2b2df811bf4d2 {
            PERIOD "931"
            DESCRIPTION "Eighth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"955" #t82370b519c66394f6fcf61 {
            PERIOD "955"
            DESCRIPTION "Great Lavra founded on Mount Athos"
        }
        ENTRY ^"963" #t0b984b4b37ae9b85e27f8c {
            PERIOD "963"
            DESCRIPTION "Redcap Methodius rejuvenates covenant of Miphoria."
        }
        ENTRY ^"964" #tf1bd99d69f18e9e1992dc7 {
            PERIOD "964"
            DESCRIPTION "Ninth Grand Tribunal of the Order of Hermes. The “unwieldy” Theban Trbunal split in to two - the Tremere dominated north becomes the Transylvanian Tribunal, the southern part the Thebes Tribunal."
        }
        ENTRY ^"969" #t4432fd65d535d36a041dff {
            PERIOD "969"
            DESCRIPTION "15th Theban Tribunal"
        }
        ENTRY ^"970" #t12d24209331da80064cfc0 {
            PERIOD "970"
            DESCRIPTION "John Tzimices allows Paulician heretics to settle in city of Philippolis to help defend it."
        }
        ENTRY ^"971" #t4cde7d769b2c54cd80ca9b {
            PERIOD "971"
            DESCRIPTION "Kievan Rus invade Bulgaria and threaten Constantinople."
        }
        ENTRY ^"996" #tbbebd562cde4112bf55b9c {
            PERIOD "996"
            DESCRIPTION "19th Theban Tribunal, year early because of Grand Tribunal."
        }
        ENTRY ^"997" #t09cc721ad89cc4eb0317c0 {
            PERIOD "997"
            DESCRIPTION "Tenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1004" #t43f2bf9b1a9a019f90f126 {
            PERIOD "1004"
            DESCRIPTION "20th Theban Tribunal recognized the covenant of Diadelphia on the island of Kalymnos, founded by two brothers from House Verditius."
        }
        ENTRY ^"1013" #t9db3ab3b415a861987c732 {
            PERIOD "1013"
            DESCRIPTION "The covenant of Aegaea founded by Orithyia of Merinita."
        }
        ENTRY ^"1014" #t21184c971acdde26930ff2 {
            PERIOD "1014"
            DESCRIPTION "The Byzantines invade Bulgaria, and House Tremere accuse House Jerbiton and other Theban magi of magically supporting the attack."
        }
        ENTRY ^"1018" #tc745db41cbc8eafd62a283 {
            PERIOD "1018"
            DESCRIPTION "22nd Theban Tribunal. Aegaea recognized, discussion how Redcaps to visit."
        }
        ENTRY ^"1024" #t70860480ce81f8c5cee20c {
            PERIOD "1024"
            DESCRIPTION "Covenant of Miphoria changes name to Alexandria after moving across town to abandoned fortress."
        }
        ENTRY ^"1025" #t1e834df16af8fb400babf4 {
            PERIOD "1025"
            DESCRIPTION "23rd Theban Tribunal. Alexandria recognized as Miphoria renamed."
        }
        ENTRY ^"1030" #tfba0abdcb5cb5a928b37c8 {
            PERIOD "1030"
            DESCRIPTION "Eleventh Grand Tribunal of the Order of Hermes. The New Slavonic Tribunal is given formal authority over the settlement of new covenants in Slavic lands, despite protests from the Rhine Tribunal."
        }
        ENTRY ^"1039" #t1c58cba68550bf9eeb423e {
            PERIOD "1039"
            DESCRIPTION "25th Theban Tribunal recognizes the Flambeau covenant of Kyddopetre, founded south of the Tarsus Mountains in the Cilician Gates with the stated purpose of discovering and exploring eastern Anatolia"
        }
        ENTRY ^"1046" #t5499550f022115692fdf91 {
            PERIOD "1046"
            DESCRIPTION "26th Theban Tribunal gathering attacked by strangles .from Polyaigos"
        }
        ENTRY ^"1053" #t61e4be443cf497c08aa23b {
            PERIOD "1053"
            DESCRIPTION "27th Theban Tribunal again raided by strangles from island of Polyaigos."
        }
        ENTRY ^"1060" #tbea78fdf5eeb492c78ee65 {
            PERIOD "1060"
            DESCRIPTION "28th Theban Tribunal hears of the destruction of the strangles, and recognizes covenant founded on Polyaigos by those who destroyed the threat."
        }
        ENTRY ^"1063" #td70a5f44dd7b4770cba2df {
            PERIOD "1063"
            DESCRIPTION "Twelfth Grand Tribunal of the Order of Hermes. Wishing to rein in the power of the Rhine Tribunal, the Grand Tribunal rejects its claim over the Polish territory left by the fall of the Covenant of Grand Silesia. This land (along with all Slavic lands) is granted to the New Slavonic Tribunal."
        }
        ENTRY ^"1067" #t15d87c4b6275ab03dd9b63 {
            PERIOD "1067"
            DESCRIPTION "29th Theban Tribunal ostracized Cosmas, follower of Verditius, of the covenant Diadelphia. Cosmas’ brother follows him to the Roman Tribunal and Diadelphia was officially disbanded."
        }
        ENTRY ^"1069" #t16116003c2e8a40618b8eb {
            PERIOD "1069"
            DESCRIPTION "Bjornaer covenant Estropi destroyed by the invasion of the Seljuk Turks"
        }
        ENTRY ^"1071" #t52da2caec62b124c25c3f7 {
            PERIOD "1071"
            DESCRIPTION "Byzantine forces commanded by Emperor Romanos IV were routed and destroyed by Seljuk Turks at the Battle of Manzikert. Central Anatolia is lost, forever changing the Byzantine Empire."
        }
        ENTRY ^"1074" #ta86833234baad3639aa4d0 {
            PERIOD "1074"
            DESCRIPTION "30th Theban Tribunal recognizes new covenant of Xylinites in Constantinople."
        }
        ENTRY ^"1076" #t9fa829abd2ed7264ee2194 {
            PERIOD "1076"
            DESCRIPTION "The magi of Kyddopetre disbanded. With the loss of Cilicia to the Seljuk Turks, their site no longer fell within the Byzantine Empire. While not a legal problem, the magi felt too isolated from their fellow Greeks to remain and joined other covenants."
        }
        ENTRY ^"1082" #t97daeba8ed1f3fec4517da {
            PERIOD "1082"
            DESCRIPTION "Venice established naval base on Rodos."
        }
        ENTRY ^"1096" #tc748d46926f77077294f9e {
            PERIOD "1096"
            DESCRIPTION "The First Crusade"
        }
        ENTRY ^"1096 (2)" #t98a9c5140788dffd93eb4f {
            PERIOD "1096"
            DESCRIPTION "Thirteenth Grand Tribunal of the Order of Hermes"
        }
        ENTRY ^"1101" #tbcd73b72253b3ffbccf668 {
            PERIOD "1101"
            DESCRIPTION "Court of Fools founded, an itinerant Ex Miscellanea covenant."
        }
        ENTRY ^"1108" #t1812cf362a3670bf4c85da {
            PERIOD "1108"
            DESCRIPTION "35th Theban Tribunal. Petronas becomes logothete, and is to serve for almost a century."
        }
        ENTRY ^"1115" #tab07642a3e1c9620ee800a {
            PERIOD "1115"
            DESCRIPTION "36th Theban Tribuna Thermakopolis founded, a House Jerbiton covenant dedicated to the defence of the city of Constantinople."
        }
        ENTRY ^"1118" #td6b90ebf73aa01340ade99 {
            PERIOD "1118"
            DESCRIPTION "Bogomil leader Basil burnt for heresy in Hippodrome."
        }
        ENTRY ^"1123" #t44341f4d0bcc67479ef742 {
            PERIOD "1123"
            DESCRIPTION "Lamites founded An Anatolian covenant dedicated to prophecy."
        }
        ENTRY ^"1127" #t98ab4c03412b13f6b86a37 {
            PERIOD "1127"
            DESCRIPTION "Lamites destroyed"
        }
        ENTRY ^"1128" #tcf8b3d90becbedc3671a4c {
            PERIOD "1128"
            DESCRIPTION "38th Theban Tribunal held a year early because of Grand Tribunal."
        }
        ENTRY ^"1129" #tfc353fef475c1479088977 {
            PERIOD "1129"
            DESCRIPTION "Fourteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1136" #te11723c279a6504b49cba8 {
            PERIOD "1136"
            DESCRIPTION "39th Theban Tribunal"
        }
        ENTRY ^"1144" #ta62b586a115079048a59b9 {
            PERIOD "1144"
            DESCRIPTION "40th Theban Tribunal"
        }
        ENTRY ^"1146" #t9f6b4c6d0efd9253d02501 {
            PERIOD "1146"
            DESCRIPTION "The Second Crusade"
        }
        ENTRY ^"1151" #te0014ebd7959e2398f277e {
            PERIOD "1151"
            DESCRIPTION "41st Theban Tribunal recognized the covenant of Thumachia near Durazzo, founded to protect the western border of the Tribunal in response to the ravages of the Second Crusade."
        }
        ENTRY ^"1158" #t7f6b449704b48681a0c20a {
            PERIOD "1158"
            DESCRIPTION "42nd Theban Tribunal"
        }
        ENTRY ^"1162" #t2ef5162772164937cceac6 {
            PERIOD "1162"
            DESCRIPTION "Fifteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1163" #t7c0c0e282b1fdc2a0e7f56 {
            PERIOD "1163"
            DESCRIPTION "Moero’s Garden was founded in Constantinople."
        }
        ENTRY ^"1165" #t05a8fd0c671bdd4bf367ca {
            PERIOD "1165"
            DESCRIPTION "43rd Theban Tribunal recognizes covenant of Moero’s Garden."
        }
        ENTRY ^"1171" #t53cc870516363ff40b0793 {
            PERIOD "1171"
            DESCRIPTION "Genoan colony at Galata, Constantinople burned to the ground. Then thousands Venetians in Constantinople are imprisoned, their ships and property confiscated."
        }
        ENTRY ^"1171 (2)" #td1c29688095149f2b29415 {
            PERIOD "1171"
            DESCRIPTION "The Venetians raised a great fleet and sail to attack the Empire, but at Chios a terrible plague destroys the Venetian force."
        }
        ENTRY ^"1172" #t9e555e6f2ad0cdea4d935d {
            PERIOD "1172"
            DESCRIPTION "44th Theban Tribunal. Covenant of Favonius recognized, though at this stage still in construction stages."
        }
        ENTRY ^"1175" #t85f355086445f4d8178181 {
            PERIOD "1175"
            DESCRIPTION "The Philomela launched."
        }
        ENTRY ^"1176" #t5997641be3101b20fdb30d {
            PERIOD "1176"
            DESCRIPTION "Hoping to win back territory lost at Manzikert, Manuel Komnenos led a large army against Iconium, the capitol of the Seljuk Turks. With poor planning and a lack of foresight, Manuel decided to attack while in the mountain passes near the fortress of Myriokephalon, and was utterly defeated. He was forced to accept a truce with the Seljuk sultan, which resulted in the loss of more of Anatolia."
        }
        ENTRY ^"1179" #t1a5da6ba795575b4cb197f {
            PERIOD "1179"
            DESCRIPTION "45th Theban Tribunal. The covenant of Favonius docks in Philomela at Delos."
        }
        ENTRY ^"1182 - 1192" #t5dbbed4b4bd177bf804948 {
            PERIOD "1182 - 1192"
            DESCRIPTION "The Third Crusade."
        }
        ENTRY ^"1185" #t0ef1f594d5f7ee2346a6a8 {
            PERIOD "1185"
            DESCRIPTION "Sicilians attack Empire, taking Durazzo, and advancing down Via Egnatia. The covenant Thumachia was besieged and destroyed by Norman Sicilians led by William II, who terrorized the lands around Durazzo during their campaign. The surviving magi decided to join other covenants rather than rebuild Thumachia. In August Thessaloniki sacked, in an atrocity noted for sacrilege and horror. The covenant Oikos tou Eleous founded in response. House Tremere support openly a Bulgrain revolt, and in Thebes the League f Advisors is founded in response."
        }
        ENTRY ^"1186" #tf0a178eb602744f968c88a {
            PERIOD "1186"
            DESCRIPTION "46th Theban Tribunal recognizes covenant of Oikos tou Eleous. Logothete altered to a permanent position at this tribunal, after Petronas elected for his eleventh term."
        }
        ENTRY ^"1190" #t9537eaf4291c1da0acfdc1 {
            PERIOD "1190"
            DESCRIPTION "The Order of Teutonic Knights is founded in Acre, in Palestine. Frederick I dies on crusade - he is drowned whilst attempting to cross the river Seleph in Asia Minor on horseback."
        }
        ENTRY ^"1191" #td7806c9ed737a9c5a36ab3 {
            PERIOD "1191"
            DESCRIPTION "Rodos captured by Richard the Lionheart, who sells it on."
        }
        ENTRY ^"1193" #tc3d1caf7cf67f742ff2750 {
            PERIOD "1193"
            DESCRIPTION "47th Theban Tribunal"
        }
        ENTRY ^"1195" #t0f919cebf3cf1b4e0df365 {
            PERIOD "1195"
            DESCRIPTION "Sixteenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1200" #t0849cb75a11f4025d607ac {
            PERIOD "1200"
            DESCRIPTION "48th Theban Tribunal"
        }
        ENTRY ^"1202" #t5cb0eed2ff2bfb9cbccadf {
            PERIOD "1202"
            DESCRIPTION "Fourth Crusade preached; Crusaders fail to raise cash to pay for Venetian transport to Holy Land. Crusaders sack Zara on Adriatic coast for Venetians. Prince Alexius, Byzantine exile offers crusaders aid and wealth in exchange for his restoration to throne of Empire. Catella of Bonisagus joind the Covenant of Alexandria"
        }
        ENTRY ^"1203" #tc612581d9e11cf30a507b6 {
            PERIOD "1203"
            DESCRIPTION "Crusaders besiege Constantinople, Emperor Alexios III Angelos flees in to exile. Alexios IV Angelos and Isaac II Angelos proclaimed joint emperors, but fail to meet promises made to the crusaders camped outside the city. By August. tensions between Byzantines and crusaders have mounted to sporadic fighting, and a skirmish leads to the Great Fire of Constantinople."
        }
        ENTRY ^"1204" #td8a9a47f22ee8f488ad39d {
            PERIOD "1204"
            DESCRIPTION "Alexios and David Kommenos, long time exiles in Georgia, seize Trebizond, creating Kingdom of Trebizond. Constantinople is taken again, and the Latin Empire created. Moero’s Garden flees to Nicaea. Ex Miscellanea covenant the Court of Fools destroyed in the fighting. William de Champlitte founds Principality of Achaea following the great Battle of the Olive Grove. Latin Empire attacks exiles who have created a new capital at Nicea, smashing the Nicene forces at the Battle of Adramyttion. Venice claims the most strategically important ports: those of Candia, Rodos, Karpathos, and the Cyclades."
        }
        ENTRY ^"1205" #t6339481388ea5d298b153f {
            PERIOD "1205"
            DESCRIPTION "Sultanate besieges Trebizond but forced to withdraw. Greek nobles of Thrace rise in revolt, and Bulgarians under Tsar Kaloyan invade Latin Empire. Bulgarians capture and kill Emperor Baldwin I. Most members of covenant of Xylinites flee in to exile in Western Europe from Constantinople. Following death of Doge Dandolo, Doge Pietro Ziani becomes leader of Venetian Republic. Battle of the Olive Grove, and subsequent creation of the state of Epiros by defeated rebel Michael Kommenos Doukas"
        }
        ENTRY ^"1205-1207" #t3e05e7d2221252d6fec064 {
            PERIOD "1205-1207"
            DESCRIPTION "Construction of wall around Ventian Quarter of Constantinople, under Podesta Marino Zeno."
        }
        ENTRY ^"1206" #t602a5fa0667ec00eca4c47 {
            PERIOD "1206"
            DESCRIPTION "Pisans readmitted to Constantinople trade."
        }
        ENTRY ^"1207" #t0d0e9501e3a15309b8bfcd {
            PERIOD "1207"
            DESCRIPTION "49th Theban Tribunal. Redcap Cosmas ostracized, possibly for dynastic connections. Petronas abdicates as logothete. Boniface of Montferrat, ruler of Thessalonika, killed in battle by Bulgarians. Tsar Kaloyan killed by St. Demetrius outside walls of Thessaloniki. Tsar Boril succeeds him to Bulgarian throne. Podesta Zeno recalled, to Venice appointment by Venetian Council of new Podesta, Ottaviano Quirino. Marco Sanudo captures island of Naxos. Covenant of Novocastrum founded in Western Thessaloniki"
        }
        ENTRY ^"1208" #t8d1c9bcab514741a1a30b2 {
            PERIOD "1208"
            DESCRIPTION "Ruler of Nicea crowned as Emperor Theodore II Lascaris. Leo Sgouros, Greek rebel leader, commits suicide as defeated at the fortress of Acrocorinth"
        }
        ENTRY ^"1209" #t36ffe7372522fd9fe4a1f6 {
            PERIOD "1209"
            DESCRIPTION "Sultan Kaikosru I begins war on Empire of Nicea, who ally with the Bulgarians. William de Champlitte of Principality of Achaea dies travelling back to France, leaving Geoffrey de Villehardouin as regent, and then ruler."
        }
        ENTRY ^"1211" #t0217c5b51a32c09b768830 {
            PERIOD "1211"
            DESCRIPTION "Theodore Lascaris of Nicea defeats Sultanate in battle, killing Sultan Kaikosru I and capturing the exile Alexios III. Latin Patriarch Tomas Morasini dies; the post remains vacant till 1215."
        }
        ENTRY ^"1212" #tf5a994933a7723437ea5ad {
            PERIOD "1212"
            DESCRIPTION "Marco Sanudo completes conquest of Cyclades. Venetians defeat pirates on Candia, establishing Kingdom of Candia. Covenant of Novocastrum destroyed as Epiros attacks the Kingdom of Thesssaloniki"
        }
        ENTRY ^"1214" #tade6b43f51580dea90fc27 {
            PERIOD "1214"
            DESCRIPTION "50th Theban Tribunal. 1214 Nicea arrange truce with the Latin Emperor Henry at Peace of Nymphaeum. David Kommenos killed fighting Sultanate. Nicea takes Amatris, but is now isolated from Trebizond by Sultanate territory. Corfu cptured from the Venetains by Epiros."
        }
        ENTRY ^"1215" #t544ed003bd2d4c36c0e3c6 {
            PERIOD "1215"
            DESCRIPTION "Gervase appointed Latin Patriarch of Constantinople."
        }
        ENTRY ^"1217" #t9ab6e023d8c812b5ce0259 {
            PERIOD "1217"
            DESCRIPTION "The Fifth Crusade."
        }
        ENTRY ^"1218" #t9d060b7c800dd8390cc3d8 {
            PERIOD "1218"
            DESCRIPTION "Ivan Asen’s son returns from exile, and lead rebellion in Bulgaria. After a seven month siege Tsar Boril was captured, blinded and consigned to a monastery, and Tsar Ivan Asen II crowned. Geoffrey de Villehardouin II becomes Prince of Achaea following his father’s death. Genoese traders readmitted to Constantinople."
        }
        ENTRY ^"1219" #t11a0a03193fef92ab88a47 {
            PERIOD "1219"
            DESCRIPTION "Gervase, the Latin Patriarch of Constantinople dies. The post is still to be filled in 1220."
        }
        ENTRY ^"1220" #t70eb396902ca37f6321084 {
            PERIOD "1220"
            DESCRIPTION "War breaks out between Latin Empire and Nicea. 1220 In the summer Sultan Kaikawus I dies, succeeded by his son Kayqubad I who begins to fortify the Anatolian highlands."
        }
        ENTRY ^"1221" #tffa9fdb39c4de6b88bc01c {
            PERIOD "1221"
            DESCRIPTION "Port of Holkas captured by Nicea from Latin Empire. 51st Theban Tribunal"
        }
        ENTRY ^"1227" #tb41f607b23aa250ebd54a1 {
            PERIOD "1227"
            DESCRIPTION "52nd Theban Tribunal, year early because of Grand Tribunal."
        }
        ENTRY ^"1228" #t7d51b0d6addea999c36557 {
            PERIOD "1228"
            DESCRIPTION "The Sixth Crusade. Frederick’s lands in Italy are invaded by Pope Gregory IX. Seventeenth Grand Tribunal of the Order of Hermes."
        }
        ENTRY ^"1229" #t7137ddd24c7c180326cf43 {
            PERIOD "1229"
            DESCRIPTION "Frederick II crowned king of Jerusalem."
        }
        ENTRY ^"1234" #t45480404dabbf86c503349 {
            PERIOD "1234"
            DESCRIPTION "Verditius contest due."
        }
        ENTRY ^"1235" #teadf729626f2aff8794ea1 {
            PERIOD "1235"
            DESCRIPTION "52nd Theban Tribunal"
        }
        ENTRY ^"1239" #tb7999f5d04a226f659d773 {
