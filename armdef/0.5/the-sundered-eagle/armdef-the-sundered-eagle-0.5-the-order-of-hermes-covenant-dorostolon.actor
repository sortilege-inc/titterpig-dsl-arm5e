EXTENSION "ARMDef_The_Sundered_Eagle_TheOrderOfHermes_CovenantDorostolon" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Dorostolon"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # Dorostolon (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #tf36e0beff5a0f6adb50135 ^"Dorostolon" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Dorostolon (815 –848)"
            ^"Years" STRING "815 –848"
            ^"Register Entry" STRING "Dorostolon (815 –848) A covenant on the south bank of the Danube, and temporary home to several powerful Tremere magi who were orchestrating their Founder’s plan to dominate the Order. The fortress was ripped apart, allegedly by Typhon in its efforts to get to Tremere’s lieutenants during the Sundering of that house."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
