EXTENSION "ARMDef_The_Sundered_Eagle_TheOrderOfHermes_CovenantNovocastrum" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - Novocastrum"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # Novocastrum (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #t6a759e0799d1aa5e39d447 ^"Novocastrum" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Printed Name" STRING "Novocastrum (1207-1212)"
            ^"Years" STRING "1207-1212"
            ^"Register Entry" STRING "Novocastrum (1207-1212) A short-lived covenant of Frankish magi in the western borders of the Kingdom of Thessaloniki, land which has since been conquered by the Principality of Epiros. It had little time to prepare for the Greek attack, and was destroyed when its magi unsuccessfully resisted; few in the Tribunal mourned their loss."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
