EXTENSION "ARMDef_The_Sundered_Eagle_TheOrderOfHermes_CovenantTheCourtOfFools" {
    NAME "Ars Magica Fifth Edition, The Sundered Eagle - The Court of Fools"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_The_Sundered_Eagle_Core_Ext"

    # The Court of Fools (Chapter Three: The Order of Hermes, Former Covenants of the Theban Tribunal, p23): a former covenant, from its register entry.

    #t21771508e6b78433963ddc ^"The Court of Fools" DEF {
        EXTENDS #tqPOcmupI8sEPkY2NKMNZUVO ^"Covenant"
        PROPERTIES {
            ^"Years" STRING "1101 – 1204"
            ^"Register Entry" STRING "The Court of Fools (1101 – 1204) An itinerant Ex Miscellanea covenant full of mystics and soothsayers, which toured throughout mainland Greece. It was in Constantinople at the time of that city’s destruction, and was destroyed in the fires. Several of its magi have resurfaced in 1220."
            ^"Register Page" INTEGER 23
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 23
        }
    }

}
