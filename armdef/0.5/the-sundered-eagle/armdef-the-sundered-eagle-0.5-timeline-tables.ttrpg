    #t067b98f59ac04c797db1c4 ^"Byzantine Emperors" DEF {
        PROPERTIES {
            ^"Table Columns" LIST ["Dynasty", "Reign", "Emperor"]
            ^"Table Columns Source" STRING "editorial: the book prints no column heads for this table"
            ^"From" STRING "Theban Tribunal Timeline (Atlas Games web supplement, by Chris Jensen-Romer)"
            ^"Source" STRING "The Sundered Eagle"
            ^"Page" INTEGER 4
        }
        TABLE {
            "" "306-336" "Constantine I, Founder of Constantinople."
            "" "337-361" "Constantius II, Arian heretic."
            "" "361-363" "Julia the Apostate, last pagan Emperor"
            "" "363-364" "Jovian, chosen by an army in retreat."
            "" "[364-375" "Valentinian,violent persecuter of witches and magicians"
            "" "[364-378" "Valens, Valentinian’s brother and co-ruler."
            "" "378-379" "Gratian, appoints Theodosius to rule Eastern Empire."
            "" "379-395" "Theodosius I, suppresses paganism."
            "" "395-408" "Arcadius, Goths driven from Constantinople by mob"
            "" "408-450" "Theodosius II, the Codex Theodosianus written."
            "" "[450-453" "Empress Aelia Pulcheria, power behind throne, then on it"
            "" "[450-457" "Marcian, Council of Chalcedon."
            "Leonid Dynasty" "457-474" "Leo I, Leo the Butcher, who staved off the Huns and Goths"
            "Leonid Dynasty" "[474" "Leo II, poisoned by his mother in a family intrigue"
            "Leonid Dynasty" "[474-475" "Zeno, father of Leo, and co-Emperor till his wife poisons her son."
            "Leonid Dynasty" "476" "Anastasius I stages coup against Anatolian Zeno as a foreigner"
            "Leonid Dynasty" "476-491" "Zeno, regaining throne and attempting to resolve Monophysite controversy by “instrument of union”"
            "Leonid Dynasty" "491-518" "Anastasius I, Monophysite builder of the Anastasian wall agisnt the Slavs and Bulgars"
            "Justinian Dynasty" "518-527" "Justin I, a humble peasant who became a great Emperor"
            "Justinian Dynasty" "527-565" "Justinian I, closed the Neoplatonic academies, suppressed pagan thought"
            "Justinian Dynasty" "565 -578" "Justin II, lost his mind and ate his servants."
            "Justinian Dynasty" "578-582" "Tiberius II Constantinoplis, spendrift wastrel"
            "Justinian Dynasty" "582-602" "Maurice, military success followed by mutiny, coup and execution."
            "Justinian Dynasty" "602-610" "Phocas the Tyrant,under whom the empire begins to collapse"
            "Heraclian Dynasty" "610-641" "Herakleios, first faced the onslaught of Islam."
            "Heraclian Dynasty" "[641" "Constantine III"
            "Heraclian Dynasty" "[641" "Heraklonas"
            "Heraclian Dynasty" "641-668" "Constans II"
            "Heraclian Dynasty" "668" "Mezezius"
            "Heraclian Dynasty" "[668-685" "Constantine IV"
            "Heraclian Dynasty" "[681-695" "Justinian II"
            "Heraclian Dynasty" "695-698" "Leontios"
            "Heraclian Dynasty" "698-705" "Tiberios III"
            "Heraclian Dynasty" "705-711" "Justinian II"
            "Heraclian Dynasty" "711-713" "Philippikos, a Monothelite who outraged the church."
            "Heraclian Dynasty" "713-715" "Anastasios II, presided over Third Council of Constantinople."
            "Heraclian Dynasty" "715-717" "Theodosios III, tried to hide in forest to avoid becoming Emperor"
            "Isaurian dynasty" "[712-741" "Leo III, Constantinople besieged by Arab forces."
            "Isaurian dynasty" "[720-775" "Constantine V, a strong advocate of Iconoclasm"
            "Isaurian dynasty" "[751-780" "Leo IV the Khazar,overshadowed by his wife, the future saint and empress Irene."
            "Isaurian dynasty" "[776-797" "Constantine VI,a cruel man eventually blinded by his own mother’s orders."
            "Isaurian dynasty" "797-802" "St. Irene of Athens, restored veneration of icons with Second Ecumenical council in 787."
            "Nikephoros’ dynasty" "[802-811" "Nikephoros I Logothetes, the Bulgarian Tsar made a drinking goblet of his skull."
            "Nikephoros’ dynasty" "811" "Staurakios, paralysed by a wound from the battle of Pliska, a disabled Emperor."
            "Nikephoros’ dynasty" "811-813" "Michael I Rangabe, defeated by Bulgarians, he abdicated to become a monk."
            "Nikephoros’ dynasty" "813-820" "Leo V the Armenian, assassinated at Christmas Mass in Hagia Sophia."
            "Phyrgian Dynasty" "820-829" "Michael II the Stammerer, iconoclastic champion of the poor."
            "Phyrgian Dynasty" "829-842" "Theophilus"
            "Phyrgian Dynasty" "[842-855" "Theodora"
            "Phyrgian Dynasty" "[842-867" "Michael III the Drunkard"
            "Macedonian Dynasty" "867-886" "Basil I"
            "Macedonian Dynasty" "886-912" "Leo VI"
            "Angelid Dynasty" "1185-1195" "Isaac II Angelos, the Second Bulgarian Empire formed by rebellion"
            "Angelid Dynasty" "1195-1203" "Alexios III Angelos, usurping older brother overthrown by Fourth Crusade"
            "Angelid Dynasty" "[1203-1204" "Alexios IV Angelos, the prince who brings Fourth Crusade to the city"
            "Angelid Dynasty" "[1203-1204" "Isaac II Angelos, blinded but restored to the throne with his son."
            "Angelid Dynasty" "1204" "Nicolas Canabus elected emperor by people, and slain for it"
            "Angelid Dynasty" "1204" "Alexios V Doukas, Murzuphlus, last defender of Constantinople against the Franks."
        }
    }

}
