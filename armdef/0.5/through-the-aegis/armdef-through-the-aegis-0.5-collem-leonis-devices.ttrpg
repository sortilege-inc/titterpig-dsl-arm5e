EXTENSION "ARMDef_Through_the_Aegis_CollemLeonis_Devices" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Six: Collem Leonis devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #tbeb00ada4ed438161ddacf ^"Coerce the Spirits of the Night (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Coerce the Spirits of the Night"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 44
            ^"Penetration" STRING "30"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +2 Voice, +1 Conc; Modifications +4 uses/day +5 item maintains concentration; +15 Penetration)"
            ^"Printed Effect Line" STRING "ReMe 44 Pen 30, 12/day R: Voice, D: Conc, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 137
        }
        DESCRIPTION "Effect is that of the spell of the same name, found in ArM5, page 152. Activated by pointing at the intended target while twisting it clockwise and saying “I dominate”."
    }

    #td3e64e56fd992f487c9b27 ^"Aura of Beguiling Appearance (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Aura of Beguiling Appearance"
            ^"Part Of" STRING "Clasp of the Ambassador"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 3, +1 Touch, +2 Sun; Modifications +5 uses/day)"
            ^"Printed Effect Line" STRING "MuIm 15 Pen 0, 12/day R: Touch, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 151
        }
        DESCRIPTION "A variant of the spell Aura of Ennobled Presence, which causes the target to appear more friendly, conciliatory, and credible. The character gets +3 on rolls to win trust and make friends, but still suffers any effects of The Gift. This spell was first mentioned in Houses of Hermes: Societates, page 96. It is activated by turning the amethyst clockwise in the silver housing."
    }

    #taad1eacde317ae5dfdf8a8 ^"Aura of Equality" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Clasp of the Ambassador"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "32"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +1 Eye, +2 Sun; Modifications +4 uses/day; +16 Penetration)"
            ^"Printed Effect Line" STRING "ReMe 40 Pen 32, 12/day R: Eye, D: Sun, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 151
        }
        DESCRIPTION "A variant of the spell Aura of Rightful Authority (ArM5, page 151), causing the target to accept the caster as an equal. This defuses a situation where the target is of higher rank and makes him open to negotiation. Tacitus of Tremere preferred this version as it is less risky compared to forcing orders on high-standing mundanes. His notes on the item also remark that the Penetration is sufficient to affect an archbishop with his Commanding Presence power (Realms of Power: The Divine, page 42–43) while inside a cathedral, where the Dominion protects him even further. Activated by looking the target in the eye, bowing slightly and speaking the words “Greetings my equal”."
    }

    #teb05bad5ac051fb25a3c98 ^"Blunt the Viper’s Fangs (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Blunt the Viper’s Fangs"
            ^"Part Of" STRING "Spear of the Armiger"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "20"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 5, +2 Voice +2 Size; Modifications +5 uses/day; +10 Penetration)"
            ^"Printed Effect Line" STRING "PeAn 40 Pen 20, 24/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 151
        }
        DESCRIPTION "As the spell of the same name found in ArM5, page 119. The effect works on animals up to Size +7. Activated by making a swinging motion toward the target while saying the word “blunt”."
    }

    #t773ce0e1632757c5912466 ^"Invocation of Weariness (Spear of the Armiger)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Invocation of Weariness"
            ^"Part Of" STRING "Spear of the Armiger"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "20"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 10, +2 Voice, +1 Size; Modifications +5 uses/day; +10 Penetration)"
            ^"Printed Effect Line" STRING "PeCo 40 Pen 20, 24/day R: Voice, D: Mom, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 151
        }
        DESCRIPTION "As the spell of the same name found in ArM5, page 133. The effect works on humanoid bodies up to Size +4, as Pamprepius hated having his Corpus spells circumvented by giant-blooded enemies. Activated by making a stabbing motion toward the target while uttering the word “weariness”."
    }

    #tdc44b2c3c4c6e2f69297e6 ^"Immediate Sense of What Treads the Surface" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Mask of the Predator"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "0"
            ^"Uses" STRING "unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Mom"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch, +1 Part, +2 Size; Modifications +10 unlimited use)"
            ^"Printed Effect Line" STRING "InTe 30 Pen 0, unlimited uses R: Touch, D: Mom, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 152
        }
        DESCRIPTION "The user has an instant sense of all creatures touching the ground within 1000 paces, with no more detail than rough mass, speed, and direction. It is activated by closing one’s eyes and touching the ear of the mask to the ground."
    }

    #t94378e4f5b6676865db169 ^"Eyes of the Bat (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Eyes of the Bat"
            ^"Part Of" STRING "Mask of the Predator"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Auram"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "0"
            ^"Uses" STRING "12/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Effect: Base 4, +1 Touch +1 Conc +3 Hearing; Modifications +5 maintains concentration, +4 uses/day)"
            ^"Printed Effect Line" STRING "InAu 34 Pen 0, 12/day R: Touch, D: Sun, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 152
        }
        DESCRIPTION "As the spell of the same name found in ArM5, page 127. It is activated by closing one’s eyes and tilting one’s head rapidly once each to the left and to the right."
    }

    #tdc44440c72a206c5e2ad3d ^"Summoning the Distant Image (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Summoning the Distant Image"
            ^"Part Of" STRING "Circlet of the Governor"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 2, +4 Arc, +1 Conc, +2 Room; Modifications +5 uses/day)"
            ^"Printed Effect Line" STRING "InIm 30 Pen 0, 24/day R: Arcane, D: Concentration, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 152
        }
        DESCRIPTION "As the spell of the same name found in ArM5, page 145. It is activated by touching the circlet with both hands while crossing the arms. Amadeus noted that the use of this effect without the following one could constitute scrying if a magus is present."
    }

    #t43fed11ee70bf7af10c136 ^"Phantasm of the Talking Head (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Printed Name" STRING "Phantasm of the Talking Head"
            ^"Part Of" STRING "Circlet of the Governor"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Ind"
            ^"Effect Design" STRING "(Effect: Base 2, +4 Arc, +1 Diam, +1 intelligible speech; Modifications +5 uses/day)"
            ^"Printed Effect Line" STRING "CrIm 25 Pen 0, 24/day R: Arcane, D: Concentration, T: Ind"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 152
        }
        DESCRIPTION "As the spell of the same name found in ArM5, page 145. It is activated by touching the circlet with one hand at the forehead and one at the back."
    }

    #t0870435b074b66dace33d6 ^"Woodshed of Plenty" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Circlet of the Governor"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "0"
            ^"Uses" STRING "Unlimited use"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Effect: Base 2, +1 Touch, +3 Moon, +2 Group; Modifications +10 unlimited use)"
            ^"Printed Effect Line" STRING "CrHe 30 Pen 0, Unlimited use R: Touch, D: Moon, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 152
        }
        DESCRIPTION "During the first generation of Collem Leonis it saddened Adler of Bjornaer to use the covenant’s rights to logging, so she created this magical woodshed. Subsequent users have remarked upon its ridiculously overpowered production. Opening and closing the door fills the shed with ten cubic paces of wood in nice, fireplace sized logs. As a result there was little reason to touch the forest, as all the needs for wood for fuel could be met. The duration of Moon is even enough to barter the wood to the nearest villages for local food products; by trading frequently and only small amounts at a time the magi ensure that the wood is used before mystically disappearing. The forest stays as thick as ever. Adler wrote that anyone activating the shed before it was wholly emptied of the previous production of wood should be flogged with a whip made from their own skin. Records do not elaborate on whether this has ever actually happened. If using the economic system of Covenants, pages 56–71, this device results in cost savings equal to three laborers. Its cost is 12 Build Points."
    }

    #t662a77611d2d3bce8384c9 ^"Silverware of the Wastrel" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 53
            ^"Penetration" STRING "0"
            ^"Uses" STRING "6/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Effect: Base 15, +1 Touch, +2 Sun, +2 Group +1 Size +1 Intricacy; Modifications +3 uses per day)"
            ^"Printed Effect Line" STRING "CrTe 53 Pen 0, 6/day R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 157
        }
        DESCRIPTION "As an exercise in the form of Terram, the founding magus Amadeus of Bonisagus enchanted an invested device highly useful for generations to come. Unfortunately, during the autumn of his life he had a tendency toward excess. The armoire creates fine silverware for a banquet setting for 50 people, including plates, bowls, goblets, candlesticks, pitchers, and serving dishes. After the meal, servants simply empty the entire table onto the midden heap, and come sunset all the silverware disappears. The device is activated simply by twisting the handles of the double cabinet doors and opening them simultaneously. Many thieves have been sorely disappointed after stealing from the table. The use of this device has given rise to stories about the magi being so rich that they never ate off the same silver plate twice, which is sort of true. Amadeus notes with humor that he does not fear lycanthropes will infiltrate the covenant, at least not at mealtimes. If using the economic system of Covenants, page 56–71, this device results in cost savings equal to two laborers."
    }

}
