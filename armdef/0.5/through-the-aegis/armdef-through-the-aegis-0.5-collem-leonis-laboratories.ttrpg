EXTENSION "ARMDef_Through_the_Aegis_CollemLeonis_Laboratories" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Six: Collem Leonis laboratories"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's laboratories, structured; each DESCRIPTION the source's text, verbatim.

    #tb807951ba8ca379ca798c4 ^"Ferra’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 3
            ^"General Quality" INTEGER 2
            ^"Upkeep" INTEGER 4
            ^"Warping" INTEGER 0
            ^"Aesthetics" INTEGER 5
            ^"Characteristics" STRING "Size +0 (0), General Quality +2, Safety – 1, Health – 1, Refinement +3, Upkeep +4, Warping 0, Aesthetics +5"
            ^"Virtues and Flaws" STRING "Greater Feature (Summoning Circle), Greater Expansion, Living Quarters, Specimens (bound ghosts), Superior Construction, Superior Lighting, Highly Organized, Servant, (Otto, Int +2) Spotless; Greater Focus (summoning circle), Missing Equipment, No Stores, Undecorated"
            ^"Specializations" STRING "Texts +1; Creo+1, Rego +7; Imaginem +1, Mentem +6 Personality Traits: None"
            ^"Features" STRING "Summoning circle Magic Items: Dominator of Ghosts (see Ferra’s character statistics)"
            ^"Notes" STRING "The activities Binding Familiar and Experimentation are impossible due to Missing Equipment. Through the use of Terram magic Ferra has heavily modified the original structure, resulting in Superior Construction."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 146
        }
    }

    #tbee0bd6e4869aba1246a08 ^"Standard Laboratories (Collem Leonis)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "Standard Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER 0
            ^"Upkeep" INTEGER 0
            ^"Safety" INTEGER 0
            ^"Warping" INTEGER 0
            ^"Health" INTEGER 0
            ^"Aesthetics" INTEGER 0
            ^"Characteristics" STRING "Size +0 (0), General Quality 0, Safety 0, Health 0, Refinement 0, Upkeep 0, Warping 0, Aesthetics 0 Laboratory Virtues and Flaws: None"
            ^"Specializations" STRING "None Personality Traits: None"
            ^"Features" STRING "None Magic Items: None"
            ^"Notes" STRING "None"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 146
        }
    }

    #t652ba4dbfee7beadac3860 ^"Unmaintained Laboratories (Collem Leonis)" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Printed Name" STRING "Unmaintained Laboratories"
            ^"Size" INTEGER 0
            ^"Refinement" INTEGER 0
            ^"Warping" INTEGER 0
            ^"Characteristics" STRING "Size +0 (0), General Quality – 1, Safety – 2, Health– 3, Refinement 0, Upkeep – 5, Warping 0, Aesthetics – 5"
            ^"Virtues and Flaws" STRING "Hovel, Missing Equipment (x3), Missing Sanctum Marker"
            ^"Specializations" STRING "None Personality Traits: None"
            ^"Features" STRING "None Magic Items: None"
            ^"Notes" STRING "Due to the multiple Missing Equipment, Inventing Spells, Enchanting Devices, Binding Familiars, and Extracting Vis are currently impossible."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 146
        }
    }

    #tea872a62b89f236961076e ^"Holzstein’s Laboratory" DEF {
        EXTENDS #taKk3J80C97U9JM8e8grpEvf ^"Laboratory"
        PROPERTIES {
            ^"Size" INTEGER 3
            ^"Refinement" INTEGER 0
            ^"General Quality" INTEGER -3
            ^"Upkeep" INTEGER -1
            ^"Safety" INTEGER 1
            ^"Warping" INTEGER 1
            ^"Aesthetics" INTEGER 2
            ^"Characteristics" STRING "Size +3(2), General Quality –3, Safety +1, Health + 1, Refinement 0, Upkeep –1, Warping +1, Aesthetics +2"
            ^"Virtues and Flaws" STRING "Greater Feature (tree), Lesser Guardian (Agnes), Pot Plants, Spacious, Idyllic Surroundings, Dedicated Building, Regio; Greater Focus (tree), Decaying, Dirty, Infested, Missing Equipment (Texts), Missing Ingredients (Ignem, Terram)"
            ^"Specializations" STRING "Perdo +3, Rego +1; Herbam +11 Personality Traits: None"
            ^"Features" STRING "Magical oak Magic Items: None"
            ^"Notes" STRING "All Lab Totals using Ignem and Terram are currently halved due to lack of ingredients. All activities concerning Texts are impossible due to lack of equipment."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 156
        }
        DESCRIPTION "Holzstein’s laboratory is built inside a large oak tree, encompassing a small regio inside it for extra space. Agnes the forest spirit (see nearby) is bound to the laboratory. The laboratory is worth 110 Build Points.\n\n**Names added to Sanctum marker:** None"
    }

}
