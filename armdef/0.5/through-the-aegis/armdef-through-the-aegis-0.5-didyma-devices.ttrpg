EXTENSION "ARMDef_Through_the_Aegis_Didyma_Devices" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Four: The Oracles of Didyma devices"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's devices, structured; each DESCRIPTION the source's text, verbatim.

    #t8056f40669da59b3597bf0 ^"Tongue of Beasts" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Staff of Branchidae"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited uses"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +2 Voice, +1 Diameter; +10 Unlimited uses)"
            ^"Printed Effect Line" STRING "InAn 35 Pen: +0, Unlimited uses R: Voice, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "The caster can communicate fluently with any animal."
    }

    #tec4f61086402a88e9a99a9 ^"Sticks to Snakes" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Staff of Branchidae"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 30
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +1 Touch, +2 Sun; +5 24 uses per day)"
            ^"Printed Effect Line" STRING "MuHe(An) 30 Pen: +0, 24/day R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Transforms a stick into a writhing snake.\n\nThe snake is Size –4, has a Soak of +2, and attacks with fangs (Init +3, Attack +11, Defense +10, Damage –7). The snake is venomous so any wound it causes may be poisoned; Ease Factor 6, Light Wound (**ArM5**, page 180)."
    }

    #t1aa27e3eed2590ae1129d3 ^"Grasping the Snake" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Staff of Branchidae"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 25
            ^"Requisite" STRING "Animal"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +2 Sun; +5 24 uses per day)"
            ^"Printed Effect Line" STRING "MuHe(An) 25 Pen: +0, 24/day R: Personal, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "A version of Sticks to Snakes that transforms the talisman into a writhing snake. This snake has the same statistics as Sticks to Snakes, and (as it is the talisman) has Alexander’s Form Magic Resistance scores."
    }

    #t9bdee8db82609ba038f6a2 ^"Swarming Bolts of Earth" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Staff of Branchidae"
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 41
            ^"Requisite" STRING "Rego"
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 3, +3 Sight, +2 Group, +1 Rego Requisite; +5 24 uses per day +11 Penetration 22)"
            ^"Printed Effect Line" STRING "Mu(Re)Te 41 Pen: +22, 24/day R: Sight, D: Momentary, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "Ten large crystal spears rise from the ground, and speed toward and impale the target(s). Each spear does +10 damage."
    }

    #t404409be502f077ff03b83 ^"The Wound that Weeps" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Soteria’s Hand"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited uses"
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +2 Voice; +10 Unlimited)"
            ^"Printed Effect Line" STRING "PeCo 25 Pen: +0, Unlimited uses R: Voice, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "As the Hermetic spell (ArM5, page 133). Has no Penetration as the intention is to intimidate mundanes."
    }

    #t7cb9edc60b84ae178409c8 ^"Exorcise the Cursed Room" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Soteria’s Hand"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 26
            ^"Penetration" STRING "+22"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Room"
            ^"Printed Effect Line" STRING "PeVi 26 Pen: +22, 24/day R: Touch, D: Momentary, T: Room"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "Demons in the Room lose 5 Might. (Base effect, +1 Touch, +2 Room; +5 24 uses, +11 Penetration 22)"
    }

    #tc2b1ea47c057c10285fb4d ^"Ward Against Men" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Strategos’ Sword"
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 15, +1 Touch, +1 Diameter; +10 Unlimited)"
            ^"Printed Effect Line" STRING "ReCo 35 Pen: +0, Unlimited uses R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "Wards the target against people. Nikola must briefly lower her Parma Magica to use this effect upon herself."
    }

    #t4865958c132d31cd6d1e44 ^"Arms Multiplied" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Strategos’ Sword"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 38
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "6 uses per day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 5, +1 Touch, +2 Sun, +2 Group, +1 complex shape; +3 6 uses)"
            ^"Printed Effect Line" STRING "CrTe 38 Pen: +0, 6 uses per day R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "Creates 10 duplicates of the sword. The duplicates have no powers, but are effective for mundane use. As magic effects, and thus resisted by Magic Resistance, the swords are of little use against supernatural foes."
    }

    #tcae49a9bfd986fc0a399a8 ^"Demon Bane" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Strategos’ Sword"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Penetration" STRING "+40"
            ^"Uses" STRING "Unlimited uses"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "PeVi 40 Pen: +40, Unlimited uses R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 77
        }
        DESCRIPTION "Inflicts 15 Might damage on a demon. (Base 5, +1 Touch; +10 Unlimited, +20 Penetration 40)"
    }

    #t6e3459208030ea90e7edc5 ^"Morpheus Arrows" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "charged item (3 arrows)"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Group)"
            ^"Printed Effect Line" STRING "ReMe 15 Pen: +0, charged item (3 arrows) R: Touch, D: Momentary, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "These arrows are charged items, activated when a character is hit by the arrow. The character (and the group he is a part of) drop into a deep slumber."
    }

    #tb572fa49a127e4ccd7921c ^"Fire Arrows" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "charged item (5 arrows)"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 4, +1 Touch)"
            ^"Printed Effect Line" STRING "CrIg 5 Pen: +0, charged item (5 arrows) R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "These arrows are charged items, activated when a target is hit by the arrow. The arrow erupts into long tongues of flame upon impact (+5 damage; plus normal missile damage). The arrows also automatically ignite a flammable target that is hit (which takes +5 damage each round until extinguished)."
    }

    #t2360014e2d3919ae437840 ^"Bridging Arrows" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "charged item (2 arrows)"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Diameter, +2 size)"
            ^"Printed Effect Line" STRING "CrHe 15 Pen: +0, charged item (2 arrows) R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "These arrows are charged items, activated when the arrow is shot from a bow. A bridge made from twisted wood spans the distance between the bow and the arrowfall. The bridge is 1 pace wide, up to 100 paces long and can support creatures of up to Size +4 (although large creatures may find the bridge very narrow)."
    }

    #t116bcd554770851a2a5709 ^"The Light Pours Out of Me" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "William’s Crusade Armor"
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +1 Diameter; +5 24 uses)"
            ^"Printed Effect Line" STRING "CrIg 15 Pen: +0, 24/day R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "Brilliant, incandescent light streams out of the armor. The light only illuminates; it does not cause damage."
    }

    #tc8781412b081f31b6d20e3 ^"Iron Ward" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
