            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Hearing"
            ^"Printed Effect Line" STRING "InHe 20 Pen +0, 24/day R: Touch, D: Diameter, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "As the Hermetic spell (ArM5, page 136). (Base 2, +1 Touch, +1 Diameter, +3 Hearing; +5 24 uses)"
    }

    #t7800dc9265f7371a6ca924 ^"Vermin Ward" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 29
            ^"Requisite" STRING "Intellego"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, +3 Structure, +1 Requisite; +4 constant effect)"
            ^"Printed Effect Line" STRING "Re(In)An 29 Pen +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "These fist sized stones carved with images of rats prevent animals of less than Size\n\n–1 from entering a Structure. The wards are used at the Miletos warehouses to prevent vermin from destroying stored goods. The Intellego requisite is required to exclude animals based on Size."
    }

    #t2aec2da7b0f034191f07f2 ^"Ward Against Rot" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 34
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Structure"
            ^"Effect Design" STRING "(Base 4, +1 Touch, +2 Sun, +3 Structure; +4 constant effect)"
            ^"Printed Effect Line" STRING "PeAq 34 Pen +0, constant effect R: Touch, D: Sun, T: Structure"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "These wards (carved stone irises) are used at the Miletos warehouses to prevent stored goods from rotting."
    }

    #tc6c3de2c3f786569df7cfc ^"Warning Flame" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 10
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "1/day"
            ^"Range" STRING "Arcane"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +4 Arcane)"
            ^"Printed Effect Line" STRING "CrIg 10 Pen +0, 1/day R: Arcane, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This wand ignites a brazier at the end of the Sacred Way (just outside the Aegis of the Hearth). The wand is carried by Callista and she lights the brazier to signal to the covenant that there is an emergency in Miletos.\n\nWhen the brazier ignites, the covenfolk find a magus for assistance. Usually Ariane is the most useful as she can easily open an Intangible Tunnel to question Callista."
    }

    #t5dc23bed2eabc7c6e3ecfb ^"Bath Rock" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 19
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "constant effect"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Room"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +2 Sun, + 2 Room; +4 constant effect)"
            ^"Printed Effect Line" STRING "CrIg 19 Pen +0, constant effect R: Touch, D: Sun, T: Room"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This rock heats the waters of the baths at the covenant."
    }

    #ta572166c36a56aa0c75400 ^"The Oracle’s Dredge" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Part"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Part; +10 Unlimited)"
            ^"Printed Effect Line" STRING "PeTe 15 Pen +0, Unlimited R: Touch, D: Momentary, T: Part"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 93
        }
        DESCRIPTION "This is a long wooden pole (about 20 feet long) with a scoop attached to one end. When activated it destroys the mud that it touches (about 10 cubic paces).\n\nThe Dredge is used at Miletos to dredge the Lion Harbor, which otherwise fills with sediment from the Meander river. The covenfolk paddle around the Lion Harbor once every month to clear it, otherwise, the harbor will visibly silt up within a season and be unusable within a decade. The mundane authorities and merchants know that the covenant performs this service for Miletos (and has done so for more than two hundred years)."
    }

    #td5c65d0633f35bd1e7e5a6 ^"Porter’s Helpers" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 15
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 3, +1 Touch, +1 Concentration; +5 item maintains concentration, +5 24 uses per day)"
            ^"Printed Effect Line" STRING "ReTe 15 Pen +0, 24/day R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "These handles are activated when clamped to the side of a heavy object, and allow the user to easily move the object (as if he had Str + 5; similar to The Unseen Porter, **ArM5**, page 156) These assist moving loads at the Miletos warehouses."
    }

    #t8567c67b42be0a3ba0d636 ^"Defender Swords" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 2, +1 Touch, +1 Concentration, +2 Metal; +10 Unlimited Uses)"
            ^"Printed Effect Line" STRING "ReTe 20 Pen +0, Unlimited R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "An active Defender Sword allows the wielder to automatically “parry” incoming blows from metal weapons. The wielder must be aware of the incoming attack, so he can still be stabbed in the back. However, in normal melee he can automatically “parry” any number of blows in a round.\n\nThe wielder must maintain concentration to use the item, but maintaining his awareness of incoming melee blows does not require a Concentration roll (as that is how the item is designed to be used). On the other hand, if the wielder attempts to do something else in the round he must make a Concentration roll (see **ArM5**, page 82). Maintaining concentration while attacking in the same round requires a Concentration roll against an Ease Factor of 15.\n\nThe Didyma turb often fight in pairs, and one grog uses a Defender Sword to defend his partner (see **ArM5**, page 173). The defended grog can thus freely attack, while the defender “parries” all the blows aimed at the pair.\n\nThe covenant has ten of these swords. Five are usually carried by the warehouse garrison, while the others are kept at the covenant."
    }

    #t625dcd56af5c1e571404bf ^"Zeus’ Arm" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReTe 30 Pen +0, Unlimited R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This wooden crane is enchanted with an effect to easily allow bulky objects to be lifted in and out of the covenant-basin. The objects rest on a square platform with an area of about 50 square feet, and a weight of up to 100 tons can be lifted. (Base 3, +1 Touch, +1 Concentration, +2 Size; +5 item maintains concentration, +10 unlimited uses)"
    }

    #t2f2abfd320c6e97c180e08 ^"The Spice Wand" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 12
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 1, +1 Touch; +10 Unlimited Uses)"
            ^"Printed Effect Line" STRING "InVi 12 Pen +0, Unlimited R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This wand vibrates slightly if it touches vis. It is used to search the Arab spice market in Miletos for vis."
    }

    #t74a81743d8630ca1fbed50 ^"Vis Divining Rods" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Hearing"
            ^"Effect Design" STRING "(Base 1, +1 Touch, +3 Hearing; +10 Unlimited Uses)"
            ^"Printed Effect Line" STRING "InVi 20 Pen +0, Unlimited R: Touch, D: Concentration, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "This pair of silver rods is activated by being held outstretched, like divining rods, and allow the user to hear when he is within 30 paces of vis. A Perception + Finesse roll against an Ease Factor of 6 narrows down the location of the vis to about 1 foot."
    }

    #t3934fb0e15e57fbc485333 ^"Diamond of Hermes" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 25
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "Unlimited"
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +1 Touch; +10 Unlimited Uses)"
            ^"Printed Effect Line" STRING "InVi 25 Pen +0, Unlimited R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "When this diamond is touched by a Gifted person it glows brightly.\n\nNikola made this item to aid her duties as a tutor on the Tribunal’s Treasury Council, and it is also used to identify Gifted Branchidae. Nikola allows the Redcaps from the covenant of Alexandria to borrow the diamond to confirm rumors of Gifted children."
    }

    #ta102a4d9c25766e7b69c3f ^"The Vis Net" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
