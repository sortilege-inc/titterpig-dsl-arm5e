            ^"Printed Effect Line" STRING "ReVi 23 Pen: +16, Unlimited R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "Wards against faerie creatures of Might 15 or less. (Base effect, +1 Diameter; +10 unlimited uses, +8 Penetration)"
    }

    #t9097e2d4e0837d21402e38 ^"Endurance of the Berserkers (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
