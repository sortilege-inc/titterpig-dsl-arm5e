            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 10, +1 Touch; +5 24 uses)"
            ^"Printed Effect Line" STRING "ReVi 20 Pen +0, 24/day R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 94
        }
        DESCRIPTION "When this net is cast into water containing vis, the vis coalesces as pulsating, translucent crystals that can subsequently be untangled and removed from the net. Each slimy crystal is about fist-sized and contains 1 pawn of vis."
    }

    #t9a790dfc6cdcee7c9a56dd ^"Pestilence Ward" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
