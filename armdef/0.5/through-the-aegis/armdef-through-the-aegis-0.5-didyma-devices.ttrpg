            ^"Target" STRING "Individual"
            ^"Printed Effect Line" STRING "ReCo 25 Pen: +0, 24/day R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "As the Hermetic spell (ArM5, page 134), except with Diameter duration. (Base 10, +1 Touch, +1 Diameter; +5 24 uses)"
    }

    #t135efd5c43c9bddd0d819b ^"Death Speaker" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
        PROPERTIES {
            ^"Part Of" STRING "Helm of Zotikos"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Requisite" STRING "Mentem"
            ^"Penetration" STRING "+0"
            ^"Uses" STRING "24/day"
            ^"Range" STRING "Eye"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Effect Design" STRING "(Base 5, +1 Eye, +1 Concentration, free requisite; + 5 24 uses)"
            ^"Printed Effect Line" STRING "InCo(Me) 20 Pen +0, 24/day R: Eye, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 83
        }
        DESCRIPTION "By looking into the eyes of a corpse the wearer can speak to the deceased’s spirit (similar to Whispers Through the Black Gate; **ArM5**, page 130)."
    }

    #tb1172eaf79846fad938992 ^"Shriek of the Impending Shafts (Through the Aegis)" DEF {
        EXTENDS #tYiQyfVMioMALqPGoncvpTfY ^"Enchanted Device"
