    # Magarethe: Archon and Servant of Ariane (Chapter Four: The Oracles of Didyma, p84): one character, its stat lines verbatim fields.

    #t8004b1595617888c56b9e2 ^"Magarethe: Archon and Servant of Ariane" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Grog"
            ^"Covenant" LIST [#te665861b28dd8521c67fe4 ^"Didyma"]
            ^"Characteristics" STRING "Int +1, Per +1(1), Pre 0, Com +1, Str –2(2), Sta –1(1), Dex +1, Qik –1(1)"
            ^"Size" STRING "0"
            ^"Age" STRING "60 (60)"
            ^"Decrepitude" STRING "2 (0)"
            ^"Warping Score" STRING "4 (3)"
            ^"Virtues and Flaws" STRING "Custos; Common Sense, Premonitions; Blind, Incomprehensible, Offensive to Animals. Due to Warping"
            ^"Personality Trait" STRING "Loyal +3"
            ^"Reputations" STRING "Wise Custos 3 (local)"
            ^"Combat" STRING "Fist: Init –1, Attack +1, Defense –1, Damage –2"
            ^"Soak" STRING "–1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –2 (6–10), –3 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Constantinople 4 (secrets), Area Lore: Miletos 3 (Didyma), Awareness 6 (hearing), Charm 4 (men), Dead Language: Latin 2 (Hermetic usage), Etiquette 3 (Hermetic), Folk Ken 5 (magi), Guile 4 (magi), Intrigue 6 (covenant), Leadership 4 (covenfolk), Living Language: French 1 (Norman), Living Language: Romaic Greek 5 (cursing), Music 3 (singing), Organization Lore: Didyma 4 (relationships), Premonitions 7 (Ariane), Profession: Servant 5 (Ariane), Stealth 3 (urban), Teaching 2 (covenfolk)"
            ^"Equipment" STRING "simple tunic/robe."
            ^"Encumbrance" STRING "0 (0)"
            ^"Vis" STRING "None."
            ^"Appearance" STRING "Magarethe is an old but agile woman now bent by years, whose eyes were burnt out in Constantinople 35 years ago, in order to serve Ariane. Magarethe is very loyal to Ariane and also respected among the covenfolk. As a result, she is the current leader of the covenfolk. She has a lot of Warping due to the vicissitudes of a life-time of service to magi."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 84
        }
    }

