EXTENSION "ARMDef_Through_the_Aegis_Didyma_Spells" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Four: The Oracles of Didyma spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t3f3bde27d45edafdf90a80 ^"Numbness of The Gift" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Conc"
            ^"Target" STRING "Touch"
            ^"Printed Stat Line" STRING "InVi 20 R: Personal, D: Conc, T: Touch"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "When the caster places his hand on another character who has The Gift his hand feels numb. This effect must penetrate the magic resistance (if any) of the target, and if the target is a member of the Order of Hermes casting this spell normally counts as scrying (which is prohibited by the Code). This spell is based on the “detect the traces of powerful magic” guideline. If the target has the Blatant or Gentle Gift the spell still works.\n\n(Base 10, +1 Conc, +1 Touch)"
    }

    #t7184e479b2199972e01c72 ^"Wizard’s Vigil" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Vim"
            ^"Level" INTEGER 40
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuVi 40 R: Voice, D: Sun, T: Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 75
        }
        DESCRIPTION "When Wizard’s Communion (ArM5, page 160) is used to assist casting, the Wizard’s Communion effect must last for the whole casting time of the effected spell. Wizard’s Vigil is a version of Wizard’s Communion with Sun Duration for use with Ritual spells, as for rituals the casting time is 15 minutes per magnitude. For the purposes of calculating the effect Wizard’s Vigil is treated as a Wizard’s Communion two magnitudes lower. The version known by Alexander is therefore treated as a level 30 Wizard’s Communion. Some of the other magi know versions of a different level.\n\n(Base 30, +2 Sun)"
    }

    #t271b9baa6d8962550dc095 ^"Footsteps on the Sacred Way" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 10
            ^"Range" STRING "Road"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 10 R: Road, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Locates the position of the target, which the caster has an Arcane Connection to, along a road. Herakles uses this to detect a person walking along the Sacred Way, but it works on any road.\n\n(Base 3, +2 Road, +1 Concentration)"
    }

    #t01e4677670696a0fe8f4a8 ^"Traitor’s Coin" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Bargain/Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeCo 15 R: Touch, D: Bargain/Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "If the target breaks the bargain made when this spell is cast, then a hideous scar, a brand of an ancient Greek coin, appears on his forehead.\n\n(Base 3, +1 Touch, +3 Bargain)"
    }

    #t4770c2df2379769e6c2d53 ^"Broken Word Broken Sword" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Bargain/Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeTe 20 R: Touch, D: Bargain/Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "If the target breaks the bargain made when this spell is cast, then his sword (or other metal weapon) is catastrophically weakened, and when next the weapon strikes (or parries) a blow it shatters. The weapon must be named by the caster, and carried by the target, at the time that the bargain is made.\n\n(Base 2, +1 Touch, +3 Bargain, +2 affect Metal)"
    }

    #tb9a50328916627bfe9eea6 ^"Sword Ward" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 20
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReTe 20 R: Personal, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 78
        }
        DESCRIPTION "Wards the caster against metal weapons. (Base 5, +1 Diameter, +2 affect Metal)"
    }

    #te2b9746d8637da869c9fbe ^"Sense of the Lodestone (Through the Aegis)" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Sense of the Lodestone"
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 5 R: Touch, D: Concentration, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The caster senses the distance and direction to the target. The caster must have an Arcane Connection to the target. Ariane casts this spell through an Intangible Tunnel.\n\n(Base 3, +1 Touch, +1 Concentration)"
    }

    #t39c440a2c6f6ccf4442884 ^"Step Sideways" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 15
            ^"Range" STRING "Personal"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 15 R: Personal, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The caster instantly moves to a location she can see within 50 paces. If a Dexterity + Finesse roll against an Ease Factor of 6 is failed, then something goes slightly awry: she might be facing the wrong way, or appears a foot or two above the ground.\n\n(Base 15)"
    }

    #tb88791ea3e64463d75b895 ^"Seven League Travel Circle" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 35
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Circle"
            ^"Printed Stat Line" STRING "ReCo 35 R: Touch, D: Momentary, T: Circle"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "Everyone within the circle instantly moves to a location that the caster has an Arcane Connection to, within seven leagues (21 miles). This is sufficient to travel between Miletos and Didyma. If the caster fails an Intelligence + Finesse roll against an Ease Factor of 9, then something goes slightly awry: the travelers might be facing the wrong way, or appear a few feet above the ground.\n\nItems worn or carried by the travelers (armor, weapons, bags, clothes, etc) move too (which requires suitable casting requisites), but large items do not move. For example, a horse in the circle would not travel, nor would a tree, but a marble statuette carried by a traveler would travel (with a Terram requisite).\n\nThe caster does not need to be within the circle. Note the spell is powerful enough to cause Warping on the travelers.\n\n(Base 30, +1 Touch)"
    }

    #te1459a57b3ef800268d1ea ^"Chill Touch of Exposure (Through the Aegis)" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Printed Name" STRING "Chill Touch of Exposure"
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Ignem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeIg 5 R: Touch, D: Momentary, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The target shivers like an unwanted baby left alone in a cold and frosty dell. The target loses a Fatigue level. Repeated casting of this spell can cause the character to eventually become unconscious; this usually takes 5 castings (see ArM5, page 178). Ariane has learned this spell to cast down an Intangible Tunnel.\n\n(Base 4, +1 Touch)"
    }

    #t97fb5cae912091ab3297db ^"Palm of Hearing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Hearing"
            ^"Printed Stat Line" STRING "InIm 10 R: Touch, D: Diameter, T: Hearing"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The caster can hear from the perspective of the target. This spell must Penetrate in order to sense creatures with Magic Resistance. Ariane has learned this spell to cast down an Intangible Tunnel.\n\n(Base 1, +1 Touch, +1 Diameter, +3 Hearing)"
    }

    #t19ab3a30480fdf3c5b07c7 ^"Palm of Seeing" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 15
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Vision"
            ^"Printed Stat Line" STRING "InIm 15 R: Touch, D: Diameter, T: Vision"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The caster can see from the perspective of the target. This spell must Penetrate in order to sense creatures with Magic Resistance. Ariane has learned this spell to cast down an Intangible Tunnel.\n\n(Base 1, +1 Touch, +1 Diameter, +4 Vision)"
    }

    #t511ca422b332bb207d663d ^"Palm of Speaking" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Mentem"
            ^"Level" INTEGER 5
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Diameter"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "CrMe 5 R: Touch, D: Diameter, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 79
        }
        DESCRIPTION "The caster can form words directly in the mind of the target. The target can recognize the caster’s voice and is aware that the words are not being relayed via their normal senses. Ariane has learned this spell to cast down an Intangible Tunnel.\n\n(Base 3, +1 Touch, +1 Diameter)"
    }

    #t2a69d5357e2697ab28e442 ^"Quell the Scent" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Imaginem"
            ^"Level" INTEGER 10
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "PeIm 10 R: Touch, D: Sun, T: Individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 81
        }
        DESCRIPTION "Destroys the target’s scent. This is very useful for stalking animals (and other creatures) that rely on smell. Add +3 to Stealth rolls in such circumstances.\n\n(Base 3, +1 Touch, +2 Sun)"
    }

    #t3b0df081feff1f6dacddf7 ^"The Tessa and Damen Wards" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 60
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Fire"
            ^"Target" STRING "Boundary"
            ^"Requisite" STRING "Intellego"
            ^"Printed Stat Line" STRING "ReCo(In) 60 R: Touch, D: Fire, T: Boundary"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 97
        }
        DESCRIPTION ", ritual\n\nCast into a flame, this ward prevents a person of a bloodline from crossing the boundary. This requires an Arcane Connection to the primogenitor of the bloodline, like the faerie Target bloodline does. The ward’s duration lasts until the flame is extinguished, or until the Arcane Connection expires. If a fixed Arcane Connection is used, and the flame is tended, this ward can last indefinitely. Despite its high level, the effect will likely have a high Penetration due to the caster being able to also use the Arcane Connection for Penetration. Casting with Wizard’s Vigil will also greatly improve the spell’s Penetration. The Intellego requisite is required to detect the bloodline (a specific fact about a person).\n\n(Base 15, +1 Touch, +3 Fire, +4 Boundary, +1 Intellego Requisite)"
    }

}
