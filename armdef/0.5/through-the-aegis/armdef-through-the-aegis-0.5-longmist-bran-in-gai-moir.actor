EXTENSION "ARMDef_Through_the_Aegis_Longmist_BranInGaiMoir" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Bran in Gai Móir"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # Bran in Gai Móir (Chapter Five: The Covenant of Longmist, p111): one character, its stat lines verbatim fields.

    #t7bfceafb72cd80cab7e749 ^"Bran in Gai Móir" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Companion"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int 0, Per 0, Pre 0, Com 0, Str +1, Sta 0, Dex +2, Qik +2"
            ^"Size" STRING "+1"
            ^"Age" STRING "34 (34)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (4)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Knight; Faeborchless; Large, Reserves of Strength, Warrior; Difficult Underlings; Covenant Upbringing, Prohibition (Must not suffer a dog in his house) Described below"
            ^"Personality Trait" STRING "Daring +3, Conflicted Loyalties +2, Boastful +1 Combat: Dodge: Init –1, Attack n/a, Defense +6, Damage n/a Fist: Init –1, Attack +7, Defense +7, Damage +1 Dagger: Init –1, Attack +8, Defense +6, Damage +4 Sparra & Round Shield: Init +0, Attack +12, Defense +10, Damage +7 Long Spear (mounted): Init +1, Attack +14, Defense +10, Damage +6 Long Spear: Init +2, Attack +9, Defense +7, Damage +8"
            ^"Soak" STRING "+9"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–6), –3 (7–12), –5 (13–18), Incapacitated (19–24), Dead (25+)"
            ^"Abilities" STRING "Area Lore: Ulaid 4 (geography), Athletics 3 (running), Brawl 4 (fist), Carouse 2 (games of chance), Chirurgy 3 (setting bones), Etiquette 2 (faeries), Great Weapon 3 (long spear), Hunt 3 (tracking), Gaelic 5 (slang), Leadership 5 (in combat), Organization Lore: Covenant of Longmist 3 (politics), Organization Lore: Order of Hermes 2 (history), Ride 5 (battle), Single Weapon 5 (sparra), Survival 1 (peat bogs), Swim 1 (diving)"
            ^"Equipment" STRING "Round shield, full chain mail, horse"
            ^"Encumbrance" STRING "4 (4)"
            ^"Appearance" STRING "Bran is a tall man, longlimbed and standing a head taller than most of the grogs he leads."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 111
        }
        DESCRIPTION " His arms and armor have been handed down from prior generations and have been altered to fit him. If using the rules for damaged goods from City & Guild, the armor has just one Damage Level left. He wants new equipment for himself and his men. Use the prices listed in City & Guild, page 144 to help decide how the magi treat his requests."
    }

}
