    # Dara Connachtach (Chapter Five: The Covenant of Longmist, p109): one character, its stat lines verbatim fields.

    #t5a6e61787374f8cdf49b42 ^"Dara Connachtach" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#ta1a53a5b77da0fd4b2083d ^"Longmist"]
            ^"Characteristics" STRING "Int +1, Per 0, Pre +3, Com +2, Str –1, Sta 0, Dex –1, Qik –1"
            ^"Size" STRING "0"
            ^"Age" STRING "28 (28)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "1 (7)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "The Gift; Hermetic Magus; Elemental Magic, Sihr; Minor Magical Focus (elemental spirits), Puissant Sihr, Cautious with Sihr; Dark Secret (killed a druid while undertaking his macgnímartha), Twilight Prone; Fragile Constitution, Humble (Minor) Minor Focus applied"
            ^"Personality Trait" STRING "Humble +3, Questioning +3, Impulsive +2, Friendly +1"
            ^"Reputations" STRING "Inexperienced 2 (Spirits of Ulaid, druids of Connacht, and the Fir Bolg), Spent time in Connacht 1 (magi of Hibernia) Combat: Dodge: Init –1, Attack n/a, Defense –1, Damage n/a Fist: Init –1, Attack –1, Defense –1, Damage –1 Knife: Init –1, Attack +0, Defense –1, Damage +1 Bludgeon: Init –2, Attack +1, Defense –1, Damage +1"
            ^"Soak" STRING "0"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Connacht 2 (history), Artes Liberales 1 (Ritual magic), Athletics 2 (running), Bargain 4 (summoned spirits), Charm 2 (first impressions), Concentration 3 (spell concentration), Faerie Lore 2 (faerie spirits), Gaelic 5 (Storytelling), Latin 4 (Hermetic usage), Magic Lore 2 (magical spirits), Magic Theory 4 (Mentem), Organization Lore: Covenant of Longmist 2 (history), Organization Lore: Order of Hermes 1 (history), Parma Magica 2 (Vim), Penetration 2 (Rego), Philosophiae 2 (Ritual magic)"
            ^"Corrguineach Art" STRING "Sihr 8+2 (earth spirits)"
            ^"Arts" STRING "Cr 2, In 5, Mu 3, Pe 6, Re 6, An 0, Aq 0, Au 3, Co 5, He 0, Ig 0, Im 0, Me 7, Te 0, Vi 5"
            ^"Equipment" STRING "Satchel filled with vials and flasks, always ready to take samples."
            ^"Encumbrance" STRING "1 (1)"
            ^"Appearance" STRING "A handsome man, very slender and well-proportioned. He has thick chestnut hair and symmetrical features. The belt around his robe is strung with sticks, rabbit feet, herbs, and even old wooden spoons; the remnants of Arcane Connections to various spirits he has encountered."
            ^"Casting Sigil" STRING "A misty outline of the target is formed between caster and target, before dissipating."
            ^"Voting Sigil" STRING "An iron disk, thick and roughly beaten."
            ^"Spells Known" STRING "Charm Against Putrefaction (CrCo 10) +7 Whispers Through the Black Gate (InCo(Me) 15) +10 Words of the Unbroken Silence (CrMe 10) +9 Reveal the Lingering Spirit (InMe 20) +12 Lay to Rest the Haunting Spirit (PeMe 10) +13 Tip of the Tongue (PeMe 5) +13 Wizard’s Communion (MuVi 15) +8 Demon’s Eternal Oblivion (PeVi 10) +11 Dreadful Bane of the Fae (PeVi 10) +11 Lash the Wayward Spirit (PeVi 10) +16 Circular Ward Against Demons (ReVi 10) +11 Lash the Wayward Spirit PeVi 10 R: Voice, D: Momentary, T: Individual As per Demon’s Eternal Oblivion, described in ArM5, page 160, but for magical spirits."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 109
        }
        DESCRIPTION "(Base, +2 Voice)"
    }

