    #t4fd822fbaf21bc828d744f ^"Columba" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Magus"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int +1, Per 0, Pre +2, Com +3, Str –1, Sta 0, Dex –1, Qik –1"
