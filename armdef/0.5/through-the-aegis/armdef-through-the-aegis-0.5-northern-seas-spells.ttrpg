EXTENSION "ARMDef_Through_the_Aegis_NorthernSeas_Spells" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t907de32de5a536af7c5b9e ^"Neptune’s Imprisoning Arms" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Muto"
            ^"Form" STRING "Aquam"
            ^"Level" INTEGER 25
            ^"Range" STRING "Voice"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "MuAq 25 R:Voice, D:Sun, T:Group"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 11
        }
        DESCRIPTION "Operates like Trap of the Entwining Vines (ArM5, page 135), but the ‘vines’ are made from water, which takes on a semi-solid form for the duration of this spell. The ‘vines’ can hold still a small rowing boat, or up to 6 people.\n\n(First presented in *Guardians of the Forests*.) **(Base 4, +2 Voice, +2 Sun, +1 Group)**"
    }

}
