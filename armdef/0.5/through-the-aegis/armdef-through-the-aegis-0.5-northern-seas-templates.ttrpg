EXTENSION "ARMDef_Through_the_Aegis_NorthernSeas_Templates" {
    NAME "Ars Magica Fifth Edition, Through the Aegis - Chapter Two: The Northern Seas templates"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # The chapter's templates, structured; each DESCRIPTION the source's text, verbatim.

    #tfd1a0b206656a761737c6e TEMPLATE "Sailor of the Northern Seas" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Specialist"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int 0, Per +1, Pre 0, Com 0, Str +1, Sta +1, Dex +2, Qik +1"
            ^"Age" STRING "25 (25)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Covenfolk; Tough; Compulsion (Dockside Vices)"
            ^"Personality Trait" STRING "Vulgar +2, Brave +1, Loyal to their Captain +1"
            ^"Combat" STRING "Dodge: Init +1, Attack N/A, Defense +5, Damage N/A Fist: Init +1, Attack +7, Defense +6, Damage +1 Kick: Init +0, Attack +6, Defense +4, Damage +4 Bludgeon: Init +0, Attack +8, Defense +5, Damage +3 Dagger: Init +1, Attack +8, Defense +5, Damage +4 Knife: Init +1, Attack +7, Defense +5, Damage +3"
            ^"Soak" STRING "+5"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Coast 3 (coves), Athletics 2 (aboard ship), Awareness 3 (at sea), Brawl 4 (Fist), Carouse 3 (getting drunk), English 3 (tavern talk), Low German 4 (Flemish), Folk Ken 2 (prostitutes), Guile 2 (shifting blame), French 5 (Norman), Profession: Sailor 4 (rough weather), Swim 3 (calm waters)"
            ^"Equipment" STRING "Quilted Armor, knife, dagger"
            ^"Encumbrance" STRING "1 (2)"
            ^"Appearance" STRING "Sunburned arms and faces, calloused hands, and weathered clothing."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 23
        }
    }

    #t5c1b95c5d18014153434a7 TEMPLATE "Ship’s Captain" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Specialist"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int +1, Per 0, Pre +2, Com +2, Str 0, Sta 0, Dex 0, Qik 0"
            ^"Size" STRING "0"
            ^"Age" STRING "35 (35)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Confidence" STRING "1 (3)"
            ^"Virtues and Flaws" STRING "Merchant Adventurer; Ways of the Sea; Arcane Lore, Inspirational, Vernacular Education; (one of Favors, Feud, Fury, or Plagued by Supernatural Entity), Overconfident Virtue from City & Guild"
            ^"Personality Trait" STRING "As per the individual Combat: Dodge: Init –1, Attack N/A, Defense +3, Damage N/A Fist: Init –1, Attack +3, Defense +3, Damage +0 Kick: Init –2, Attack +3, Defense +2, Damage +3 Bludgeon: Init –2, Attack +6, Defense +4, Damage +2 Dagger: Init –1, Attack +5, Defense +3, Damage +3"
            ^"Soak" STRING "+1"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Normandy Coast 3 (coves), Artes Liberales 2 (astronomy), Athletics 2 (aboard ship), Awareness 3 (weather), Bargain 4 (grains), Brawl 3 (Bludgeon), Carouse 3 (drinking songs), Organization Lore: Covenant of the Northern Seas 1 (personalities), Dominion Lore 1 (saints), English 3 (naval terms), Faerie Lore 2 (sea faeries), Low German 4 (Flemish), Folk Ken 3 (port authorities), Guile 4 (lying about cargo), Latin 3 (hermetic usage), Leadership 3 (crewmen), Magic Lore 3 (sea monsters), French 5 (Norman), Order of Hermes Lore 2 (covenants), Profession: Sea Captain 5 (Normandy coast), Stealth 2 (hide), Swim 2 (oceans)"
            ^"Equipment" STRING "Quilted Armor, dagger"
            ^"Encumbrance" STRING "2 (2)"
            ^"Appearance" STRING "As per the individual"
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 23
        }
    }

}
