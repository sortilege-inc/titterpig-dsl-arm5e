    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Through_the_Aegis_Core_Ext"

    # Young Feeble (Chapter Two: The Northern Seas, p20): one character, its stat lines verbatim fields.

    #t47da219b59e13f38aaba95 ^"Young Feeble" DEF {
        EXTENDS #tHoHTL05ExampleCharacterAA ^"Example Character"
        PROPERTIES {
            ^"Role" STRING "Grog"
            ^"Covenant" LIST [#t2b859a5f0c51942368a661 ^"The Northern Seas"]
            ^"Characteristics" STRING "Int –1, Per 0, Pre 0, Com –1, Str 0, Sta 0, Dex +3, Qik +2"
            ^"Size" STRING "0"
            ^"Age" STRING "25 (25)"
            ^"Decrepitude" STRING "0"
            ^"Warping Score" STRING "0 (0)"
            ^"Virtues and Flaws" STRING "Covenfolk; Puissant Great Weapon, Warrior; Afflicted Tongue (stammer), Fear (dogs)"
            ^"Personality Trait" STRING "Brave +3, Bashful +2, Confused +1"
            ^"Combat" STRING "Dodge: Init –1, Attack n/a, Defense +6, Damage n/a Fist: Init –1, Attack +7, Defense +6, Damage +0 Kick: Init –1, Attack +7, Defense +5, Damage +3 Bludgeon: Init +0, Attack +10, Defense +7, Damage +2 Long spear: Init +2, Attack +14, Defense +11, Damage +7"
            ^"Soak" STRING "+4"
            ^"Fatigue Levels" STRING "OK, 0, –1, –3, –5, Unconscious"
            ^"Wound Penalties" STRING "–1 (1–5), –3 (6–10), –5 (11–15), Incapacitated (16–20), Dead (21+)"
            ^"Abilities" STRING "Area Lore: Hampshire 3 (taverns), Athletics 3 (running), Awareness 3 (in combat), Brawl 4 (Bludgeon), Carouse 3 (drinking), Organization Lore: Covenant of the Northern Seas 1 (personalities), English 5 (rude words), Etiquette 2 (magi), Fishing 3 (rod and line), Folk Ken 1 (peasants), Great Weapon 5+2 (longspear), Guile 2 (avoiding duties), French 4 (Norman), Survival 2 (for a short period), Swim 2 (long distances)"
            ^"Equipment" STRING "Pack; Partial Metal Scale Armor; Long spear, Fishing hooks and line."
            ^"Encumbrance" STRING "3 (3)"
            ^"Appearance" STRING "If there is a way to tie or buckle something wrong and still be wearing it, Feeble finds a way. He bears a look of surprised confusion whenever spoken to and his first instinct is to look for someone to answer for him. This is of course in part because of his bashfulness over his stammer."
            ^"Source" STRING "Through the Aegis"
            ^"Page" INTEGER 20
        }
        DESCRIPTION "Feeble is so called by the turb on account of his stammering and his morbid fear of dogs.\n\nFeeble by name, but not necessarily by capability. He is highly-proficient with the spear and his task is usually to close off an enemy’s lines of attack or retreat. He lacks imagination and so when given a task he is happy to continue in that task until told to stop, including during combat."
    }

}
