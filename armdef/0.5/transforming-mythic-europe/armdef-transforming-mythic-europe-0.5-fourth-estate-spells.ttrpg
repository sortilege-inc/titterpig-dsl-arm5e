EXTENSION "ARMDef_Transforming_Mythic_Europe_FourthEstate_Spells" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Two: The Fourth Estate spells"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's spells, structured; each DESCRIPTION the source's text, verbatim.

    #t63f08050ddf2f84a073b6e ^"The Unexpected Blossom" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 40
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "ReHe 40 R: Touch, D: Momentary, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "This spell instantly brings a small orchard to blossom regardless of the season or the conditions. This does not bring the fruit, and a further spell of the same design parameters is needed for this. If that spell is not cast, the elements take their natural toll on the blossom, which may mean that the trees bear no fruit at all.\n\nCrops grown from seed, such as roots like turnips and radishes, leafy crops such as cabbage or lettuce, and grains like wheat and barley, do not blossom in the same way as trees. and thus variants of this spell are of limited value.\n\nSuch spells are powerful and, unless they are designed with particular orchards or fields in mind, they give each plant within the target group one Warping Point with each casting.\n\nAn alternative approach is to put a similar effect into an enchanted device that works on a single tree at a time but with multiple uses per day. This allows a mundane farmer to walk the orchard and bring trees to blossom as he passes. This is another example of how magic can flow down to those who work the land.\n\n(Base 15, +1 Touch, +2 Group, +2 for size)"
    }

    #t2e408ed140ba1ae30e0928 ^"A Harvest By Morning" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 50
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrHe 50 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "Creo magic brings a thing closer to its ideal, and being a mature plant is more ideal than a sapling, so this spell brings a target group of plants to full maturity over the course of the spell’s duration, which must begin as soon as the sun goes down.\n\nWhile *The Unexpected Blossom* makes a group of trees blossom, it must have mature plants to work on, which this spell provides.\n\n(Base 15, +1 Touch, +2 Sun, +2 Group, +2 size)"
    }

    #t13c0fbdd921224a07c675a ^"A Herd By Morning" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Creo"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 45
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "CrAn 45 R: Touch, D: Sun, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 41
        }
        DESCRIPTION "This spell brings the target group of up to a hundred base individual animals to full maturity over the course of the spell’s duration, which must begin as soon as the sun goes down.\n\n(Base 15, +1 Touch, +2 Sun, +2 Group, +1 size)"
    }

    #ta7bb798bf73a0ecb39f866 ^"Sight of the Wolf" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Animal"
            ^"Level" INTEGER 33
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Sun"
            ^"Target" STRING "Special"
            ^"Printed Stat Line" STRING "InAn 33 R: Touch, D: Sun, T: Special"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 42
        }
        DESCRIPTION "This effect treats an enclosed paddock or sheepcote as the equivalent of a room and the size increase allows for an area ten times the size of a standard room. The effect detects the presence of wolves within this space, which may then trigger a number of secondary effects.\n\nThe Target is based on Room +1, as described in **ArM5**, page 114.\n\n(Base 3, +1 Touch, +2 Sun, +3 Special Target, +1 Size; +3 triggered at sunset)"
    }

    #ted0d10cd407b4eb0587c8a ^"From This Line Descended" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 30
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "InCo 30 R: Arcane Connection, D: Momentary, T: Individual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "This spell reveals whether the target represented by the Arcane Connection is descended from a particular bloodline also represented by either a further connection or a known member of that bloodline in the caster’s presence. The connection or member of the bloodline is treated as the root of the family tree and the caster gains knowledge of how strong that blood is within the veins of the target. This helps the caster to judge the validity of any claims to inheritance. What it can’t do is confirm a target’s right to inherit, as this is dependent on other factors, not least the existence of other claimants and the inheritance laws in question.\n\n(Base 5, +4 Arcane Connection, +1 complexity)"
    }

    #t10c2046b583f5862496805 ^"Divining the True Heir" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Intellego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 20
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "InCo 20 R: Touch, D: Momentary, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 44
        }
        DESCRIPTION "With the various claimants present the magus casts the spell upon the group and learns the relative relationships between the targets of the spell and the target bloodline as represented by an Arcane Connection or known member of the familial line.\n\nThe caster learns how many generations separate the individuals, who are cousins, and how much of the line’s blood runs in their veins.\n\nAgain, this spell is limited as it cannot differentiate between legitimate and illegitimate children, nor can it gain any information about those not present, a crucial part of inheritance law. So this spell is useful for assisting in determining a potential heir from within a group rather than identifying one outright.\n\n(Base 5, +1 Touch, +2 Group)"
    }

    #tfe39a05859bc22aae2d0e2 ^"Summoning the Ancestor Spirit" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 45
            ^"Range" STRING "Arcane Connection"
            ^"Duration" STRING "Ring"
            ^"Target" STRING "Individual"
            ^"Printed Stat Line" STRING "ReCo 45 R: Arcane Connection, D: Ring, T: Individual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 44
        }
        DESCRIPTION ", ritual\n\nOne way of determining the rightful heir to an inheritance is to defer to someone or something that already knows the answer. The magic realm is replete with spirits representing every aspect of God’s creation including, conceivably, spirits of a given bloodline.\n\nMagical spirits of blood can be summoned through the form of Corpus using a base 15 effect as explained in *The Mysteries Revised Edition*, page 28. This is something that all magi can do and is not reliant on any Mystery initiations.\n\nThe caster often prepares a warding circle and then summons the target spirit into that circle. The Arcane Connection used must intimately relate to the target bloodline; a crown for a royal line, a sword passed from father to son, earth from a family estate, and so on. Once summoned, the spirit can be questioned or commanded as normal and if it is powerful enough it should have knowledge of the true heir to the line.\n\nShould the magus wish it, he may also be able to command other information from the spirit concerning those who share its blood.\n\n(Base 15, +4 Arcane Connection, +2 Ring)"
    }

    #ta533591a1f0fc7431f0668 ^"The Impassable River" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Corpus"
            ^"Level" INTEGER 60
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Moon"
            ^"Target" STRING "Special"
            ^"Ritual" BOOLEAN true
            ^"Printed Stat Line" STRING "ReCo 60 R: Touch, D: Moon, T: Special, Ritual"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "This ritual turns a river into a magical boundary that cannot be crossed by man, woman, or child. It cannot be crossed from either side and those who try may reach midway before they are turned back. Neither bridges nor fords offer any opportunity to cross. They are, however, left unharmed by the magic and they may be used once the spell ends. Variants can be created with the Until (condition) duration or Year, though both of these increase the level by one magnitude.\n\nMagi can create spells with nonstandard Targets quite freely, though they are generally not as optimized as if they had first researched the required Target parameter. In this case, a river is a special form of boundary and the target is particular to this spell so the parameter is treated as Boundary +1, as described in **ArM5**, page 114.\n\nThis ritual is designed to protect lands from invasion or to place a barrier in war’s path by disrupting the ability of one side or the other to travel. Magi working with nobles involved in the dispute may cast such things, even uninvited, to prevent the loss of life and to give parties the opportunity to talk. The unscrupulous may use this to cut off lines of retreat, hemming enemies in and preventing their escape.\n\n(Base 15, +1 Touch, +3 Moon, +5 special based on Boundary)"
    }

    #tf151818729d5830f336e3c ^"Deny Them the Bridge" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Rego"
            ^"Form" STRING "Terram"
            ^"Level" INTEGER 30
            ^"Range" STRING "Touch"
            ^"Duration" STRING "Concentration"
            ^"Target" STRING "Structure"
            ^"Printed Stat Line" STRING "ReTe 30 R: Touch, D: Concentration, T: Structure"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "This spell lifts a stone bridge, including its foundations, clear of the river and places it in some spot that the magus can see.\n\nA Perception + Finesse Stress roll is required against a base Ease Factor of 9. Larger bridges, up to the maximum size manageable with this variant, increase the Ease Factor by +3. Failing the roll means one check for damage as per *City & Guild*, page 77, for each point by which the casting roll failed.\n\nUse of this spell allows the magus to withdraw major bridges from the enemy, controlling their ability to cross rivers in numbers.\n\n(Base 3, +1 Touch, +1 Concentration, +3 Structure, +1 Stone, +1 size)"
    }

    #tfe15c279d31866c7e93498 ^"The Wizard’s Chevauchee" DEF {
        EXTENDS #tM30boZOkiiaD5LRZZQQ1ymk ^"Formulaic Spell"
        PROPERTIES {
            ^"Technique" STRING "Perdo"
            ^"Form" STRING "Herbam"
            ^"Level" INTEGER 50
            ^"Range" STRING "Sight"
            ^"Duration" STRING "Momentary"
            ^"Target" STRING "Group"
            ^"Printed Stat Line" STRING "PeHe 50 R: Sight, D: Momentary, T: Group"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 45
        }
        DESCRIPTION "Wizards should not be angered. With this spell, the caster lays waste to any and all living plants that he can see, for around sixty acres. As a free cosmetic effect the plants are consumed by a magical fire that races across the ground as the caster shifts his gaze. The fire is selective and leaves dead plants, wood, and all other things untouched.\n\nThere can be little excuse for casting this spell and even less for enchanting it into a device and giving it to mundanes. However, the threat of it may be enough to keep covenant lands free from the interference of others.\n\n(Base 5, +3 Sight, +2 Group, +4 size)"
    }

}
