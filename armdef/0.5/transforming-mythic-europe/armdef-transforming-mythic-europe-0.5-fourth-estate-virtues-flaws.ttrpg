EXTENSION "ARMDef_Transforming_Mythic_Europe_FourthEstate_VirtuesFlaws" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Two: The Fourth Estate virtues flaws"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's virtues flaws, structured; each DESCRIPTION the source's text, verbatim.

    #t77ca9912df475a3b540fc8 ^"Reserves of Presence" DEF {
        EXTENDS #tT28cb9EpHcSa3Joedekm2A3 ^"Virtue"
        PROPERTIES {
            ^"Printed Name" STRING "New Virtue: Reserves of Presence"
            ^"Type Source" STRING "the book prints no type line; it defines the Virtue as the standard Reserves of Strength Minor Virtue (ArM5, page 48), whose Size and Category in the core are Minor, General"
            ^"Size" STRING "Minor"
            ^"Category" STRING "General"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 33
        }
        DESCRIPTION "As with the standard Reserves of Strength Minor Virtue (**ArM5**, page 48), once per day your character is able to draw on internal strength and add +3 to her Presence characteristic for the duration of a single scene. The effort is potentially tiring and your character must make two fatigue rolls at the end of the scene in addition to losing the +3 bonus."
    }

}
