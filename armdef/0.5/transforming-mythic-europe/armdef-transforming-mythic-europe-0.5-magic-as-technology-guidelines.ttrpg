EXTENSION "ARMDef_Transforming_Mythic_Europe_MagicAsTechnology_Guidelines" {
    NAME "Ars Magica Fifth Edition, Transforming Mythic Europe - Chapter Four: Magic as Technology guidelines"
    VERSION "0.5.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-10-06"
    DEPENDS_ON "ARMDef_Transforming_Mythic_Europe_Core_Ext"

    # The chapter's guidelines, structured; each DESCRIPTION the source's text, verbatim.

    #t23ece163b6805391fc6297 ^"Rego Animal Guidelines (Transforming Mythic Europe, New Guidelines for Instant Transportation)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Animal" FIXED
            ^"Printed Name" STRING "Rego Animal"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 10" "Transport an animal instantly up to 5 paces. Non-living animal products are transported with Rego Terram."
        }
    }

    #tf41b50f76f8da2248226b8 ^"Rego Aquam Guidelines (Transforming Mythic Europe, New Guidelines for Instant Transportation)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Aquam" FIXED
            ^"Printed Name" STRING "Rego Aquam"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 4" "Transport a liquid instantly up to 5 paces."
        }
    }

    #te6b8e02b2f97caac2627a9 ^"Rego Herbam Guidelines (Transforming Mythic Europe, New Guidelines for Instant Transportation)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Herbam" FIXED
            ^"Printed Name" STRING "Rego Herbam"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 10" "Transport a plant instantly up to 5 paces. Non-living plant products are transported with Rego Terram."
        }
    }

    #t7ead5f10f9845f4be9060a ^"Rego Ignem Guidelines (Transforming Mythic Europe, New Guidelines for Instant Transportation)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Ignem" FIXED
            ^"Printed Name" STRING "Rego Ignem"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 3" "Transport a fire instantly up to 5 paces."
        }
    }

    #t0e7584b9996fad9ff13c5f ^"Rego Terram Guidelines (Transforming Mythic Europe, New Guidelines for Instant Transportation)" DEF {
        EXTENDS #tARMDefCompatSpellGuideline ^"Spell Guideline"
        PROPERTIES {
            ^"Technique" STRING "Rego" FIXED
            ^"Form" STRING "Terram" FIXED
            ^"Printed Name" STRING "Rego Terram"
            ^"Source" STRING "Transforming Mythic Europe"
            ^"Page" INTEGER 107
        }
        GUIDELINES {
            "Level 4" "Transport a non-living object instantly up to 5 paces. For objects larger than something that can be comfortably held in two hands, size modifiers are necessary. Casting requisites may be needed if the item is primarily not under the Form of Terram."
        }
    }

}
